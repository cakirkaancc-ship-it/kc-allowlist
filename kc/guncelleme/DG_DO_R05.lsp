(defun DT--make-assoc-hatch-vla (boundary lay pattern color / app doc space bobj info pat hatch sa var ok ent tryTypes typ)
  (if (and boundary (entget boundary))
    (progn
      (setq app (vl-catch-all-apply 'vlax-get-acad-object '()))
      (if (not (vl-catch-all-error-p app))
        (progn
          (setq doc (vl-catch-all-apply 'vla-get-ActiveDocument (list app)))
          (if (not (vl-catch-all-error-p doc))
            (progn
              (setq space
                (vl-catch-all-apply
                  (if (= (getvar "CVPORT") 1) 'vla-get-PaperSpace 'vla-get-ModelSpace)
                  (list doc)
                )
              )
              (setq bobj (vl-catch-all-apply 'vlax-ename->vla-object (list boundary)))
              (if (and (not (vl-catch-all-error-p space))
                       (not (vl-catch-all-error-p bobj)))
                (progn
                  (setq info (DT--hatch-pattern-info pattern)
                        pat  (car info)
                        tryTypes (list 0 1 2))
                  (foreach typ tryTypes
                    (if (or (null hatch) (vl-catch-all-error-p hatch))
                      (setq hatch
                        (vl-catch-all-apply
                          'vla-AddHatch
                          (list space typ pat :vlax-true)
                        )
                      )
                    )
                  )
                  (if (and hatch (not (vl-catch-all-error-p hatch)))
                    (progn
                      (setq sa (vlax-make-safearray vlax-vbObject '(0 . 0)))
                      (vlax-safearray-put-element sa 0 bobj)
                      (setq var (vlax-make-variant sa))
                      (setq ok (vl-catch-all-apply 'vla-AppendOuterLoop (list hatch var)))
                      (if (vl-catch-all-error-p ok)
                        (progn
                          (vl-catch-all-apply 'vla-Delete (list hatch))
                          (setq hatch nil)
                        )
                        (progn
                          (vl-catch-all-apply 'vla-put-Layer (list hatch lay))
                          (vl-catch-all-apply 'vla-put-Color (list hatch 256))
                          (vl-catch-all-apply 'vla-put-PatternScale (list hatch (DT--hatch-scale)))
                          (if (vlax-property-available-p hatch 'Elevation T)
                            (vl-catch-all-apply 'vla-put-Elevation (list hatch (DT--active-elevation)))
                          )
                          (vl-catch-all-apply 'vla-Evaluate (list hatch))
                          (setq ent (vl-catch-all-apply 'vlax-vla-object->ename (list hatch)))
                          (if (vl-catch-all-error-p ent) nil ent)
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

(defun DT--make-assoc-hatch (boundary lay pts pattern color / hatch data)
  (setq hatch (DT--make-assoc-hatch-vla boundary lay pattern color))
  (if (and hatch (entget hatch))
    (DT--hatch-set-source hatch boundary)
    (progn
      (setq data (DT--hatch-data-assoc lay pts pattern color boundary))
      (if data
        (progn
          (setq hatch (entmakex data))
          (if hatch (DT--hatch-set-source hatch boundary))
        )
      )
    )
  )
)
(defun DT--hatch-drop-last (lst / out i n)
  (setq n (length lst)
        i 0)
  (while (< i (1- n))
    (setq out (append out (list (nth i lst))))
    (setq i (1+ i))
  )
  out
)

(defun DT--bulge-segment-points (a b bulge / theta chord halfSin halfCos mid u nrm dist center rad start steps i ang out)
  (if (or (null bulge) (< (abs bulge) 1e-10) (< (distance a b) 1e-9))
    (list b)
    (progn
      (setq theta   (* 4.0 (atan bulge))
            chord   (distance a b)
            halfSin (sin (/ theta 2.0))
            halfCos (cos (/ theta 2.0)))
      (if (< (abs halfSin) 1e-9)
        (list b)
        (progn
          (setq mid
            (list
              (/ (+ (car a) (car b)) 2.0)
              (/ (+ (cadr a) (cadr b)) 2.0)
              0.0
            )
          )
          (setq u      (DT--seg-unit a b)
                nrm    (DT--perp u)
                dist   (/ (* chord halfCos) (* 2.0 halfSin))
                center (DT--pt+ mid nrm dist)
                rad    (abs (/ chord (* 2.0 halfSin)))
                start  (atan (- (cadr a) (cadr center)) (- (car a) (car center)))
                steps  (max 4 (fix (+ 1.0 (/ (abs theta) (/ pi 24.0)))))
                i      1)
          (while (<= i steps)
            (if (= i steps)
              (setq out (append out (list b)))
              (progn
                (setq ang (+ start (* theta (/ (float i) (float steps)))))
                (setq out
                  (append out
                    (list
                      (list
                        (+ (car center) (* rad (cos ang)))
                        (+ (cadr center) (* rad (sin ang)))
                        0.0
                      )
                    )
                  )
                )
              )
            )
            (setq i (1+ i))
          )
          out
        )
      )
    )
  )
)

(defun DT--flatten-bulged-pts (pts bulges / out n i a b bulge seg p)
  (if (and pts (> (length pts) 1))
    (progn
      (setq out (list (car pts))
            n   (length pts)
            i   0)
      (while (< i n)
        (setq a     (nth i pts)
              b     (nth (rem (1+ i) n) pts)
              bulge (if bulges (nth i bulges) 0.0)
              seg   (DT--bulge-segment-points a b bulge))
        (foreach p seg
          (setq out (append out (list p)))
        )
        (setq i (1+ i))
      )
      (if (and (> (length out) 1) (< (distance (car out) (last out)) 1e-8))
        (setq out (DT--hatch-drop-last out))
      )
      out
    )
    pts
  )
)

(defun DT--fitting-open-original-edges (pts bulges / maxRadius p radius n i a b mid edgeUnit radialUnit bulge dotv out)
  (setq maxRadius 0.0)
  (foreach p pts
    (setq radius (sqrt (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))
    (if (> radius maxRadius) (setq maxRadius radius)))
  (setq n (length pts)
        i 0)
  (while (< i n)
    (setq a      (nth i pts)
          b      (nth (rem (1+ i) n) pts)
          bulge  (if bulges (nth i bulges) 0.0)
          mid    (list (/ (+ (car a) (car b)) 2.0)
                       (/ (+ (cadr a) (cadr b)) 2.0)
                       0.0)
          radius (sqrt (+ (* (car mid) (car mid)) (* (cadr mid) (cadr mid))))
          edgeUnit   (DT--seg-unit a b)
          radialUnit (if (> radius 1e-9)
                       (list (/ (car mid) radius) (/ (cadr mid) radius))
                       nil)
          dotv (if (and edgeUnit radialUnit)
                 (abs (g365_dot (car edgeUnit) (cadr edgeUnit)
                                (car radialUnit) (cadr radialUnit)))
                 1.0))
    (if (and (< (abs bulge) 1e-9)
             (> (distance a b) 1e-8)
             (> radius (* maxRadius 0.72))
             (< dotv 0.15))
      (setq out (append out (list i))))
    (setq i (1+ i)))
  out
)

(defun DT--fitting-flat-open-edges (pts bulges flat / original n i a b j found out)
  (setq original (DT--fitting-open-original-edges pts bulges)
        n        (length flat))
  (foreach i original
    (setq a     (nth i pts)
          b     (nth (rem (1+ i) (length pts)) pts)
          j     0
          found nil)
    (while (and (< j n) (null found))
      (if (and (equal a (nth j flat) 1e-6)
               (equal b (nth (rem (1+ j) n) flat) 1e-6))
        (setq found j)
        (setq j (1+ j))))
    (if found (setq out (append out (list found)))))
  out
)

(defun DT--nearest-flat-edge (flat target used / n i a b mid dist bestDist best)
  (setq n (length flat)
        i 0)
  (while (< i n)
    (if (not (member i used))
      (progn
        (setq a    (nth i flat)
              b    (nth (rem (1+ i) n) flat)
              mid  (list (/ (+ (car a) (car b)) 2.0)
                         (/ (+ (cadr a) (cadr b)) 2.0)
                         0.0)
              dist (distance mid target))
        (if (or (null bestDist) (< dist bestDist))
          (setq bestDist dist
                best i))))
    (setq i (1+ i)))
  best
)

(defun DT--fitting-port-open-edges (flat ports / used port idx)
  (foreach port ports
    (setq idx (DT--nearest-flat-edge flat port used))
    (if idx (setq used (append used (list idx)))))
  used
)

(defun DT--block-hatch-entmake (pts bulges boundary / data flatPts)
  (setq flatPts
    (if bulges
      (DT--flatten-bulged-pts pts bulges)
      pts
    )
  )
  (setq data
    (DT--hatch-data-assoc-at
      (DT--layer-fitting)
      flatPts
      (DT--mode-hatch-pattern *DT_ACTIVE_MODE*)
      (DT--mode-hatch-color *DT_ACTIVE_MODE*)
      0.0
      boundary
    )
  )
  (if data (entmake data))
)

(defun DT--block-local-2d-hatch-entmake (pts bulges / data flatPts)
  ;; 2D gorunum blocklarinda hatch siniri block-yerel koordinatlarla
  ;; sabittir. Associative obje referansi bazi CAD surumlerinde WCS'ye
  ;; kacabildigi icin burada hatch dongusunu bagimsiz olusturuyoruz.
  (setq flatPts
    (if bulges
      (DT--flatten-bulged-pts pts bulges)
      pts
    )
  )
  (setq data
    (DT--hatch-data
      (DT--layer-fitting)
      flatPts
      (DT--mode-hatch-pattern *DT_ACTIVE_MODE*)
      (DT--mode-hatch-color *DT_ACTIVE_MODE*)
      0.0
    )
  )
  (if data (entmake data))
)

(defun DT--boundary-add-hatch-reactor (boundary hatch / ed out item hasBlock inBlock found)
  (if (and boundary hatch (entget boundary) (entget hatch))
    (progn
      (setq ed (entget boundary))
      (foreach item ed
        (if (and (= (car item) 102) (= (cdr item) "{ACAD_REACTORS"))
          (setq hasBlock T)))
      (foreach item ed
        (cond
          ((and (= (car item) 102) (= (cdr item) "{ACAD_REACTORS"))
            (setq inBlock T)
            (setq out (append out (list item))))
          ((and inBlock (= (car item) 330) (= (cdr item) hatch))
            (setq found T)
            (setq out (append out (list item))))
          ((and inBlock (= (car item) 102) (= (cdr item) "}"))
            (if (not found) (setq out (append out (list (cons 330 hatch)))))
            (setq out (append out (list item))
                  inBlock nil))
          (T
            (setq out (append out (list item)))
            (if (and (not hasBlock) (= (car item) 5))
              (setq out
                (append out
                  (list '(102 . "{ACAD_REACTORS") (cons 330 hatch) '(102 . "}"))))))))
      (if (entmod out)
        (progn
          (entupd boundary)
          boundary)))
  )
)

(defun DT--hatch-set-source (hatch boundary / ed out item after97 linked)
  (if (and hatch boundary (entget hatch) (entget boundary))
    (progn
      (setq ed (entget hatch))
      (foreach item ed
        (cond
          ((= (car item) 71)
            (setq out (append out (list '(71 . 1)))))
          ((= (car item) 97)
            (setq out (append out (list '(97 . 1) (cons 330 boundary)))
                  after97 T))
          ((and after97 (= (car item) 330))
            (setq after97 nil))
          (T
            (setq out (append out (list item))))))
      (if (entmod out)
        (progn
          (entupd hatch)
          (setq linked (DT--boundary-add-hatch-reactor boundary hatch))
          (if linked hatch)))
    )
  )
)

(defun DT--block-next-boundary (ent used / cur typ found)
  (setq cur (entnext ent))
  (while (and cur
              (/= (cdr (assoc 0 (entget cur))) "ENDBLK")
              (null found))
    (setq typ (cdr (assoc 0 (entget cur))))
    (if (and (member typ '("LWPOLYLINE" "POLYLINE" "3DFACE" "REGION"))
             (not (member cur used)))
      (setq found cur))
    (setq cur (entnext cur)))
  found
)

(defun DT--block-associate-hatches (name / rec ent prev typ boundary used)
  (setq rec (if name (tblobjname "BLOCK" name)))
  (if rec
    (progn
      (setq ent (entnext rec))
      (while (and ent (/= (cdr (assoc 0 (entget ent))) "ENDBLK"))
        (setq typ (cdr (assoc 0 (entget ent))))
        (cond
          ((= typ "HATCH")
            (setq boundary
              (if (and prev (not (member prev used)))
                prev
                (DT--block-next-boundary ent used)))
            (if boundary
              (progn
                (DT--hatch-set-source ent boundary)
                (setq used (cons boundary used)))))
          ((member typ '("LWPOLYLINE" "POLYLINE" "3DFACE" "REGION"))
            (setq prev ent)))
        (setq ent (entnext ent)))
      T)
  )
)
(defun DT--pt+ (p u d)
  (list (+ (car p) (* (car u) d))
        (+ (cadr p) (* (cadr u) d))
        0.0)
)

(defun DT--perp (u) (list (- (cadr u)) (car u)))

(defun DT--seg-unit (a b)
  (g365_unit (- (car b) (car a)) (- (cadr b) (cadr a)))
)

(defun DT--draw-seam (pt dir half lay / n a b)
  (setq n (DT--perp dir))
  (setq a (DT--pt+ pt n half))
  (setq b (DT--pt+ pt n (- half)))
  (DT--make-poly lay (list a b) nil)
)

(defun DT--name-safe (s / bad i ch out)
  (setq bad "<>/\\\":;?*|,=`"
        i 1
        out "")
  (while (<= i (strlen s))
    (setq ch (substr s i 1))
    (setq out
      (strcat out
        (if (vl-string-search ch bad) "_" ch)
      )
    )
    (setq i (1+ i))
  )
  out
)

(defun DT--width-name (width / s)
  (setq s (rtos width 2 6))
  (while (and (vl-string-search "." s)
              (= (substr s (strlen s) 1) "0"))
    (setq s (substr s 1 (1- (strlen s))))
  )
  (if (= (substr s (strlen s) 1) ".")
    (setq s (substr s 1 (1- (strlen s))))
  )
  (vl-string-translate ".-" "_m" s)
)

