(defun deg-clear-deg-done-xdata ( / ss i e ed newed x3)
  (if (setq ss (ssget "X" '((0 . "LWPOLYLINE,POLYLINE"))))
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq e  (ssname ss i))
        (setq ed (entget e '("*")))
        (setq newed nil)
        (foreach x3 ed
          (if (and (= (car x3) -3)
                   (listp (cadr x3))
                   (= (car (cadr x3)) (DEG:VAL 'R1)))
            (setq newed newed) ; skip this xdata chunk
            (setq newed (append newed (list x3)))
          )
        )
        (if (and newed (/= (length newed) (length ed)))
          (progn (entmod newed) (entupd e))
        )
        (setq i (1+ i))
      )
    )
  )
  (princ)
)


(defun degk--as-ename (e)
  (cond
    ((= (type e) 'ENAME) e)
    ((= (type e) 'VLA-OBJECT) (vlax-vla-object->ename e))
    (T nil)
  )
)

(defun degk--nearest-vertex (plEnt pickPt / ed v best bestd p d)
  (setq plEnt (degk--as-ename plEnt))
  (if (null plEnt)
    pickPt
    (progn
      (setq best nil bestd 1e99)
      (setq ed (entget plEnt))
      (foreach v ed
        (if (= (car v) 10)
          (progn
            (setq p (list (car (cdr v)) (cadr (cdr v)) 0.0))
            (setq d (distance p pickPt))
            (if (< d bestd) (setq bestd d best p))
          )
        )
      )
      (if best best pickPt)
    )
  )
)

(defun degk--last-number-in-text (s / i len ch code cur lastNum)
  (setq s (if (= (type s) 'STR) s ""))
  (setq i 1 len (strlen s) cur nil lastNum nil)
  (while (<= i len)
    (setq ch (substr s i 1)
          code (ascii ch))
    (if (and (>= code 48) (<= code 57))
      (setq cur (+ (* (if cur cur 0) 10) (- code 48)))
      (if cur
        (setq lastNum cur cur nil)
      )
    )
    (setq i (1+ i))
  )
  (if cur cur lastNum)
)

(defun degk--sira-min-number (s / parts part n best)
  (setq parts (degk--split-commas (if (= (type s) 'STR) s "")))
  (foreach part parts
    (setq n (degk--last-number-in-text part))
    (if (and n (or (null best) (< n best)))
      (setq best n)
    )
  )
  best
)



