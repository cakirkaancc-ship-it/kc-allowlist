(defun DEGV:_touch-block-to-poly? (blkObj polyE tol / ip cp d)
  (setq ip (DEGV:_v2l (vla-get-InsertionPoint blkObj)))
  (if (and ip polyE)
    (progn
      (setq cp (vlax-curve-getclosestpointto polyE ip))
      (if cp
        (progn
          (setq d (DEGV:_dist2d ip cp))
          (if (<= d tol) T nil)
        )
        nil
      )
    )
    nil
  )
)


(defun DEGV:_blocks-touching-chain (chain tol / res src e lay blkObj polyE hit)
  (setq res (ssadd))
  (if DEGN-DEGA--SCOPE-ACTIVE
    (setq src DEGN-DEGA--SCOPE-BLOCKS)
    (setq src (DEGN-DEGA--scope-ss-to-list (ssget "X" '((0 . "INSERT")))))
  )
  (foreach e src
    (if (and e (= (type e) 'ENAME) (DEGN-DEGA--scope-block-p e))
      (progn
        (setq lay (cdr (assoc 8 (entget e))))
        (if (/= (strcase (if lay lay "")) (DEG:VAL 'O2))
          (progn
            (setq blkObj (vlax-ename->vla-object e))
            (setq hit nil)
            (foreach polyE chain
              (if (and (not hit)
                       polyE
                       (= (type polyE) 'ENAME)
                       (DEGN-DEGA--scope-poly-p polyE)
                       (DEGV:_touch-block-to-poly? blkObj polyE tol))
                (setq hit T)
              )
            )
            (if hit (ssadd e res))
          )
        )
      )
    )
  )
  res
)
