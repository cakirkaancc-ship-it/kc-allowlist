(defun DEGQ:_add-under-polyline-filleted (ms x y lyr vlen leadSign / sc r bulge sa pl d lx ly fy fyEnd)
  (setq sc (DEG:PLAN-UNIT-SCALE))
  (if (null vlen) (setq vlen (* 100.0 sc)))
  (setq r     (* 10.0 sc)
        bulge -0.41421356
        d     (* (/ 14.1421 1.41421356) sc)
        fy    (+ (- y vlen) r)
        fyEnd (- fy r)
  )

  (if leadSign
    (progn
      (setq lx (+ x (* leadSign d)))
      (setq ly (+ y d))
      (setq sa (vlax-make-safearray vlax-vbDouble '(0 . 7)))
      (mapcar 'vlax-safearray-put-element
              (list sa sa sa sa sa sa sa sa)
              '(0 1 2 3 4 5 6 7)
              (list
                lx ly
                x  y
                x  fy
                (- x r) fyEnd))
      (setq pl (vla-AddLightWeightPolyline ms (vlax-make-variant sa)))
      (vla-put-Layer pl lyr)
      (DEGQ:_mark-created (vlax-vla-object->ename pl))
      (vla-SetBulge pl 2 bulge)
    )
    (progn
      (setq sa (vlax-make-safearray vlax-vbDouble '(0 . 5)))
      (mapcar 'vlax-safearray-put-element
              (list sa sa sa sa sa sa)
              '(0 1 2 3 4 5)
              (list
                x y
                x fy
                (- x r) fyEnd))
      (setq pl (vla-AddLightWeightPolyline ms (vlax-make-variant sa)))
      (vla-put-Layer pl lyr)
      (DEGQ:_mark-created (vlax-vla-object->ename pl))
      (vla-SetBulge pl 1 bulge)
    )
  )
  pl
)


