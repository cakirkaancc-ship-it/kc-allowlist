                    (append data
                      (list
                        '(72 . 1)
                        (cons 10 (list (car a) (cadr a) 0.0))
                        (cons 11 (list (car b) (cadr b) 0.0)))))
            (setq i (1+ i))
          )
          (setq data
            (append data
              (list '(97 . 1) (cons 330 boundary) '(75 . 1) '(76 . 1))))
          (if (not solidp)
            (setq data
              (append data
                (list '(52 . 0.0) (cons 41 scale) '(77 . 0) (cons 78 (/ (length defs) 8)))
                defs))
          )
          (append data (list '(98 . 0)))
        )
      )
    )
