(defun degk--room-source-blocks (pickset / i ent ed obj powerEnt panelEnt)
  ;; Oda sembolleri yalniz kullanicinin alan secimine giren INSERT'lerden gelir.
  (setq i 0)
  (while (and pickset
              (< i (sslength pickset))
              (or (null powerEnt) (null panelEnt)))
    (setq ent (ssname pickset i)
          ed  (if ent (entget ent) nil)
          obj nil)
    (if (and ed (= (cdr (assoc 0 ed)) "INSERT"))
      (progn
        (setq obj (vl-catch-all-apply 'vlax-ename->vla-object (list ent)))
        (if (not (vl-catch-all-error-p obj))
          (cond
            ((and (null powerEnt) (degk--room-power-supply-p obj))
              (setq powerEnt ent))
            ((and (null panelEnt) (degk--room-fire-panel-p obj))
              (setq panelEnt ent))))))
    (setq i (1+ i)))
  (if (and powerEnt panelEnt)
    (list powerEnt panelEnt)
    nil)
)

(defun degk--flasher-terminal-module-p (blkObj / rec value key)
  (if (and (boundp '*degk-source-cache-active*) *degk-source-cache-active* blkObj)
    (setq key (vla-get-Name blkObj)))
  (if (and (boundp '*degk-source-cache-active*) *degk-source-cache-active*)
    (if (setq rec (assoc key *degk-terminal-type-cache*))
      (cdr rec)
      (progn
        (setq value (degk--flasher-terminal-module-uncached-p blkObj)
              *degk-terminal-type-cache* (cons (cons key value) *degk-terminal-type-cache*))
        value))
    (degk--flasher-terminal-module-uncached-p blkObj)))

(defun degk--source-block-eligible-p (blkObj / rec value key layer)
  (setq layer (strcase (vla-get-Layer blkObj)))
  (if (and (boundp '*degk-source-cache-active*) *degk-source-cache-active*)
    (setq key (list (vla-get-Name blkObj) layer)))
  (if (and (boundp '*degk-source-cache-active*) *degk-source-cache-active*
           (setq rec (assoc key *degk-source-eligible-cache*)))
    (cdr rec)
    (progn
      (setq value (and (/= layer "0")
                       (not (DEG:IGNORE-BLOCK-OBJ? blkObj))))
      (if (and (boundp '*degk-source-cache-active*) *degk-source-cache-active*)
        (setq *degk-source-eligible-cache* (cons (cons key value) *degk-source-eligible-cache*)))
      value)))

(defun degk--flasher-terminal-module-uncached-p (blkObj / names name hit)
  ;; Dinamik/anonim bloklarda yalniz EffectiveName yeterli olmayabilir.
  ;; Tum kullanilabilir adlari ve ad varyasyonlarini kontrol et.
  (setq names (if blkObj (DEG:BLOCK-NAMES blkObj) nil)
        hit nil)
  (foreach name names
    (if (or (deg-eq name "E_SOUNDER_MODULE_100")
            (deg-eq name "E_SIREN_KONTROL_MODÜL_100")
            (deg-eq name "E_SIREN_KONTROL_MODUL_100")
            (deg-wcmatch name "*SOUNDER*MODULE*")
            (deg-wcmatch name "*SIREN*KONTROL*MOD*"))
      (setq hit T))
  )
  hit
)

(defun degk--monitor-module-p (blkObj / names name hit)
  ;; Ingilizce ve Turkce monitor modul adlari; dinamik/anonim bloklarda
  ;; EffectiveName ile gercek block adi birlikte kontrol edilir.
  (setq names (if blkObj (DEG:BLOCK-NAMES blkObj) nil)
        hit nil)
  (foreach name names
    (if (or (deg-eq name "E_MONITOR_MODULE_100")
            (deg-eq name "E_MONÝTÖR_MODÜL_100")
            (deg-eq name "E_MONITOR_MODUL_100")
            (deg-wcmatch name "*MONITOR*MODULE*")
            (deg-wcmatch name "*MONÝTÖR*MODÜL*")
            (deg-wcmatch name "*MONITOR*MODUL*"))
      (setq hit T))
  )
  hit
)

(defun degk--column-anchor-module-p (blkObj)
  (or (degk--flasher-terminal-module-p blkObj)
      (degk--monitor-module-p blkObj))
)

(defun degk--point-in-bbox-tol-p (pt bb tol / mn mx)
  (if (not (numberp tol)) (setq tol 0.0))
  (setq tol (abs tol)
        mn  (if bb (car bb) nil)
        mx  (if bb (cadr bb) nil))
  (and (deg-pt3 pt)
       (deg-pt3 mn)
       (deg-pt3 mx)
       (>= (car pt) (- (car mn) tol))
       (<= (car pt) (+ (car mx) tol))
       (>= (cadr pt) (- (cadr mn) tol))
       (<= (cadr pt) (+ (cadr mx) tol)))
)

(defun degk--point-bbox-gap-2d (pt bb / mn mx x y cx cy)
  (setq mn (if bb (car bb) nil)
        mx (if bb (cadr bb) nil))
  (if (and (deg-pt3 pt) (deg-pt3 mn) (deg-pt3 mx))
    (progn
      (setq x  (car pt)
            y  (cadr pt)
            cx (max (car mn) (min x (car mx)))
            cy (max (cadr mn) (min y (cadr mx))))
      (distance (list x y 0.0) (list cx cy 0.0)))
    nil)
)

(defun degk--flasher-terminal-endpoint-score
  (plEnt blkObj tol / sharpTol bb sp ep gs ge endPt ins contact totalLen d)
  ;; Terminal seciminde ana olcut block base noktasi degil, hattin gercek
  ;; ucunun gorunen block alanina temasidir. Hat ortasindaki kesisim yalniz
  ;; daha dusuk oncelikli yedek olarak kabul edilir.
  (if (not (numberp tol)) (setq tol 0.0))
  (setq sharpTol
          (min (abs tol)
               (max 0.000001 (* 0.1 (DEG:PLAN-UNIT-SCALE))))
        bb (degk--get-bbox-visible-by-blockdef blkObj))
  (if (null bb) (setq bb (degk--ent-bbox blkObj)))
  (setq sp (vl-catch-all-apply 'vlax-curve-getStartPoint (list plEnt))
        ep (vl-catch-all-apply 'vlax-curve-getEndPoint (list plEnt)))
  (if (vl-catch-all-error-p sp) (setq sp nil))
  (if (vl-catch-all-error-p ep) (setq ep nil))
  (setq gs (if sp (degk--point-bbox-gap-2d sp bb) nil)
        ge (if ep (degk--point-bbox-gap-2d ep bb) nil))
  (cond
    ((and (numberp gs) (<= gs sharpTol)
          (or (not (numberp ge)) (<= gs ge)))
      (setq endPt sp))
    ((and (numberp ge) (<= ge sharpTol))
      (setq endPt ep)))
  (if endPt
    (progn
      ;; Birden fazla buyuk/ust uste bbox ayni ucu kapsarsa gercek INSERT'e
      ;; yakin olan kazanir; katsayi yalniz esitligi bozar.
      (setq ins (deg-get-inspt blkObj))
      (+ (min (if (numberp gs) gs 1.0e99)
              (if (numberp ge) ge 1.0e99))
         (if ins (* 1.0e-6 (distance endPt ins)) 0.0)))
    (progn
      (setq contact (degk--flasher-terminal-contact-point plEnt blkObj tol))
      (if contact
        (progn
          (setq totalLen
            (vl-catch-all-apply
              'vlax-curve-getDistAtParam
              (list plEnt (vlax-curve-getEndParam plEnt))))
          (if (vl-catch-all-error-p totalLen) (setq totalLen 0.0))
          (setq d (degk--dist-along plEnt contact))
          (if (not (numberp d)) (setq d 0.0))
          (+ 1.0e12 (min d (abs (- totalLen d)))))
        nil)))
)

(defun degk--flasher-terminal-contact-point
  (plEnt blkObj tol / plObj res lst handle bbRec bb sharpTol best sp ep)
  ;; Sounder/siren kontrol modullerinde base noktasi yerine planda gorunen
  ;; blok geometrisini kullan. Once gercek kesisim, sonra gorunen geometri
  ;; sinirinin toleransli temas kontrolu yapilir. Attribute/text extents'i
  ;; degk--get-bbox-visible-by-blockdef tarafindan hesaba katilmaz.
  (setq plObj
    (cond
      ((= (type plEnt) 'VLA-OBJECT) plEnt)
      ((= (type plEnt) 'ENAME)
        (setq res (vl-catch-all-apply 'vlax-ename->vla-object (list plEnt)))
        (if (vl-catch-all-error-p res) nil res))
      (T nil)))
  (if (not (numberp tol)) (setq tol 0.0))
  (setq tol (abs tol)
        ;; Yakin modullerin hattini karistirmamak icin bu ozel yedek
        ;; kontrolde fiziksel tolerans en fazla 1 mm'dir.
        sharpTol
          (min tol
               (max 0.000001 (* 0.1 (DEG:PLAN-UNIT-SCALE)))))

  ;; AutoCAD/GstarCAD destekliyorsa blok referansinin gercek cizgileriyle
  ;; dogrudan kesisim en kesin sonuc olur.
  (if (and plObj blkObj)
    (progn
      (setq res
        (vl-catch-all-apply
          'vlax-invoke
          (list plObj 'IntersectWith blkObj 0)))
      (if (not (vl-catch-all-error-p res))
        (progn
          (setq lst (vl-catch-all-apply 'DEG:PT->LIST (list res)))
          (if (and (not (vl-catch-all-error-p lst))
                   (listp lst)
                   (>= (length lst) 2))
            (setq best
              (list (nth 0 lst)
                    (nth 1 lst)
                    (if (and (>= (length lst) 3) (numberp (nth 2 lst)))
                      (nth 2 lst)
                      0.0)))))))
  )

  (if (and (null best) plObj blkObj)
    (progn
      (setq handle (degkk--object-handle blkObj)
            bbRec
              (if (and (/= handle "")
                       (boundp '*degk-flasher-contact-bbox-cache*))
                (assoc handle *degk-flasher-contact-bbox-cache*)
                nil)
            bb (if bbRec (cdr bbRec) nil))
      (if (null bb)
        (progn
          (setq bb (degk--get-bbox-visible-by-blockdef blkObj))
          (if (null bb) (setq bb (degk--ent-bbox blkObj)))
          (if (and bb (/= handle "")
                   (boundp '*degk-flasher-contact-bbox-cache*))
            (setq *degk-flasher-contact-bbox-cache*
              (cons (cons handle bb) *degk-flasher-contact-bbox-cache*)))))
      (if bb
        (progn
          ;; IntersectWith kullanilamiyorsa yalniz polyline'in gercek ucunu
          ;; kabul et. Hattin ortasinda kalan komsu modul artik temas sayilmaz.
          (setq sp (vl-catch-all-apply 'vlax-curve-getStartPoint (list plObj))
                ep (vl-catch-all-apply 'vlax-curve-getEndPoint (list plObj)))
          (cond
            ((and (not (vl-catch-all-error-p sp))
                  (degk--point-in-bbox-tol-p sp bb sharpTol))
              (setq best sp))
            ((and (not (vl-catch-all-error-p ep))
                  (degk--point-in-bbox-tol-p ep bb sharpTol))
              (setq best ep)))))))
  best
)

(defun degk--flasher-terminal-touches-loop-p (loopEnts blkObj tol / hit plEnt)
  ;; Genis blok-alani temasi yalniz flasor terminalini bulmak icindir.
  ;; Modulu genel loop cihaz listesine dahil etmez.
  (setq hit nil)
  (foreach plEnt loopEnts
    (if (and (not hit)
             plEnt
             (degk--curve-ok? plEnt)
             (degk--flasher-terminal-contact-point plEnt blkObj tol))
      (setq hit T))
  )
  hit
)

(defun degk--flasher-loop-layer-p (layer)
  (and layer
       (or (deg-eq layer "E_FLAÞÖR")
           (deg-eq layer "E_FLASOR")
           (deg-eq layer "E_FLASHER")
           (deg-eq layer "E_STROBE")
           (deg-eq layer "E_STROBE_LINE")
           (deg-wcmatch layer "*FLAÞ*")
           (deg-wcmatch layer "*FLAS*")
           (deg-wcmatch layer "*FLASH*")
           (deg-wcmatch layer "*STROBE*")))
 )

(defun degk--flasher-terminal-key (blkObj / names name key)
  ;; Anonymous/dynamic block adlarini ayni mantiksal modul anahtarinda topla.
  (setq names (if blkObj (DEG:BLOCK-NAMES blkObj) nil))
  (foreach name names
    (cond
      ((deg-wcmatch name "*SOUNDER*MODULE*")
        (setq key "SOUNDER_MODULE"))
      ((deg-wcmatch name "*SIREN*KONTROL*MOD*")
        (setq key "SIREN_KONTROL_MODULE")))
  )
  (if key key (degkk--symbol-key blkObj))
)

(defun degk--flasher-module-last (ordered / normal modules pair)
  ;; Kaynak hattin cizim yonu ne olursa olsun kontrol modulu loopun kapanan
  ;; ucunda kalir. Diger bloklarin kendi aralarindaki sirasi korunur.
  (foreach pair ordered
    (if (degk--flasher-terminal-module-p (cdr pair))
      (setq modules (cons pair modules))
      (setq normal (cons pair normal)))
  )
  (append (reverse normal) (reverse modules))
)

(defun degk--same-block-p (a b / ha hb)
  (setq ha (if a (degkk--object-handle a) "")
        hb (if b (degkk--object-handle b) ""))
  (and (/= ha "") (= ha hb))
)

(defun degk--column-terminal-copy-put
  (sourceObj copyObj anchorPt layoutRow layoutFloor / handle item itemObj itemHandle kept)
  ;; Kolon semasinda gercekten olusan terminal kopyalarini kaynak eslesmesinden
  ;; bagimsiz tut. Ayni INSERT farkli kaynaklara map edilse bile bir kez kaydolur.
  (if (and copyObj anchorPt (= (type copyObj) 'VLA-OBJECT))
    (progn
      (setq handle (strcase (degkk--object-handle copyObj)))
      (if (/= handle "")
        (progn
          (foreach item
            (if (boundp '*degk-column-terminal-copies*)
              *degk-column-terminal-copies*
              nil)
            (setq itemObj (car item)
                  itemHandle
                    (if (and itemObj (= (type itemObj) 'VLA-OBJECT))
                      (strcase (degkk--object-handle itemObj))
                      ""))
            (if (/= itemHandle handle)
              (setq kept (cons item kept))))
          (setq *degk-column-terminal-copies*
            (cons
              (list copyObj anchorPt layoutRow layoutFloor sourceObj)
              (reverse kept)))))))
  copyObj
)

(defun degk--area-module-copy-put (sourceObj copyObj anchorPt layoutRow layoutFloor / handle key sourceIns sourceSira)
  ;; Kaynak plandaki modul ile kolon semasindaki kopyasini eslestir.
  ;; DKK ayni sembolleri topladiginda sembol anahtari ikinci kaynak
  ;; modulun de ayni kopyaya baglanabilmesini saglar.
  (if (and sourceObj copyObj anchorPt
           (= (type copyObj) 'VLA-OBJECT))
    (progn
      (setq handle     (degkk--object-handle sourceObj)
            key        (degk--flasher-terminal-key sourceObj)
            sourceIns  (deg-get-inspt sourceObj)
            sourceSira (degk--clean-text (degk--get-att sourceObj "SIRA_NO")))
      (if (not (numberp layoutRow)) (setq layoutRow nil))
      (if (not (numberp layoutFloor)) (setq layoutFloor nil))
      ;; Monitor modulleri de kaynak-kopya haritasina girer; ancak flasor
      ;; looplarinin kullanabilecegi bos terminal havuzuna eklenmez.
      (if (or (degk--flasher-terminal-module-p sourceObj)
              (degk--flasher-terminal-module-p copyObj))
        (degk--column-terminal-copy-put
          sourceObj copyObj anchorPt layoutRow layoutFloor))
      (if (/= handle "")
        (setq *degk-area-module-copy-map*
          (cons (list handle copyObj anchorPt layoutRow layoutFloor)
                (if (boundp '*degk-area-module-copy-map*)
                  *degk-area-module-copy-map*
                  nil))))
      (if (/= key "")
        (setq *degk-area-module-symbol-map*
          (cons (list key copyObj anchorPt sourceIns sourceSira handle layoutRow layoutFloor)
                (if (boundp '*degk-area-module-symbol-map*)
                  *degk-area-module-symbol-map*
                  nil))))
    )
  )
  copyObj
)

(defun degk--area-module-copy-get (sourceObj wantedFloor / handle records item rec)
  ;; Ayni kaynak modul birden fazla katta kopyalanabilir. Kat biliniyorsa
  ;; baska kattaki en son kopyaya dusmek yerine yalniz ayni kati kabul et.
  (setq handle  (if sourceObj (degkk--object-handle sourceObj) "")
        records (if (boundp '*degk-area-module-copy-map*)
                  *degk-area-module-copy-map*
                  nil))
  (foreach item records
    (if (and (null rec)
             (= (car item) handle)
             (or (not (numberp wantedFloor))
                 (and (numberp (nth 4 item))
                      (= wantedFloor (nth 4 item)))))
       (setq rec item))
  )
  ;; Kat bilinmiyorsa fiziksel kaynak kimligiyle herhangi bir kopya yedek
  ;; olarak kullanilabilir. Kat biliniyorsa baska kattaki kopyaya gecme.
  (if (and (null rec) (not (numberp wantedFloor)))
    (foreach item records
      (if (and (null rec) (= (car item) handle))
        (setq rec item))))
  ;; Flasor loopu yalniz planda gercekten bagli oldugu kaynak modulun
  ;; kolon kopyasina gidebilir. Ayni tipteki baska bir module sembol/mesafe
  ;; ile dusmek iki farkli loopu tek kontrol modulunde birlestiriyordu.
  (if rec (cdr rec) nil)
)

(defun degk--area-module-symbol-get (sourceObj wantedFloor / key sourceIns sourceSira records rec candidateIns candidateSira candidateFloor score best bestScore)
  (setq key        (if sourceObj (degk--flasher-terminal-key sourceObj) "")
        sourceIns  (if sourceObj (deg-get-inspt sourceObj) nil)
        sourceSira (if sourceObj
                     (degk--clean-text (degk--get-att sourceObj "SIRA_NO"))
                     "")
        records    (if (boundp '*degk-area-module-symbol-map*)
                     *degk-area-module-symbol-map*
                     nil))
  (foreach rec records
    (setq candidateFloor (nth 7 rec))
    (if (and (= (car rec) key)
             (or (not (numberp wantedFloor))
                 (and (numberp candidateFloor)
                      (= wantedFloor candidateFloor))))
      (progn
        (setq candidateIns  (nth 3 rec)
              candidateSira (if (nth 4 rec) (nth 4 rec) "")
              score
                (cond
                  ((and (/= sourceSira "") (= sourceSira candidateSira)) 0.0)
                  ((and sourceIns candidateIns) (+ 1.0 (distance sourceIns candidateIns)))
                  (T 1.0e99)))
        (if (or (null bestScore) (< score bestScore))
          (setq best rec
                bestScore score))
      )
    )
  )
  (if best
    (list (nth 1 best) (nth 2 best) (nth 6 best) (nth 7 best))
    nil)
)

(defun degk--flasher-terminal-from-touched (plEnt touched tol / blkObj score best bestScore)
  ;; Birden fazla kontrol modulu varsa polyline ucuna gercekten temas edeni al.
  (foreach blkObj touched
    (if (degk--flasher-terminal-module-p blkObj)
      (progn
        (setq score
          (degk--flasher-terminal-endpoint-score plEnt blkObj tol))
        (if (and (numberp score)
                 (or (null bestScore) (< score bestScore)))
          (setq best blkObj
                bestScore score))
      )
    )
  )
  best
)

(defun degk--flasher-terminal-on-polyline (plEnt blockObjs tol / touched blkObj)
  ;; Yerlesim kati hesaplanmadan once flasor/strobe hattinin baglandigi
  ;; kontrol modulunu bul. DK:BASE ile ayni temas testini kullanir.
  (foreach blkObj blockObjs
    (if (and (degk--flasher-terminal-module-p blkObj)
             (degk--flasher-terminal-contact-point plEnt blkObj tol))
      (setq touched (cons blkObj touched))
    )
  )
  (if touched
    (degk--flasher-terminal-from-touched plEnt touched tol)
    nil
  )
)

(defun degk--block-first-layout-info (blkObj / siraList sira layout result)
  (setq siraList (degk--expand-sira-no (degk--get-att blkObj "SIRA_NO")))
  (if (null siraList)
    (setq siraList (list (degk--get-att blkObj "SIRA_NO"))))
  (while (and siraList (null result))
    (setq sira     (degk--clean-text (car siraList))
          siraList (cdr siraList)
          layout   (if (/= sira "") (degk--layout-key-from-sira sira) nil))
    (if layout (setq result (list sira layout)))
  )
  result
)

(defun degk--block-touches-selected-normal-p (blkObj polylines tol / i ent layer hit)
  ;; Yalniz secilen normal looplardan birinde kopyalanacak modul, flasor
  ;; yerlesimi icin gercek kolon hizasi ankraji olabilir.
  (setq i 0)
  (while (and polylines (< i (sslength polylines)) (not hit))
    (setq ent   (ssname polylines i)
          layer (if ent (cdr (assoc 8 (entget ent))) nil))
    (if (and ent
             layer
             (not (degk--flasher-loop-layer-p layer))
             ;; DK:BASE normal loopta modulu tam olarak bu base-noktasi
             ;; testiyle kopyalar. Ayni testi kullan ki atanmis modulun kolon
             ;; semasinda gercek bir kopyasi mutlaka bulunsun.
             (degk--block-touches-loop-p (list ent) blkObj tol))
      (setq hit T))
    (setq i (1+ i))
  )
  hit
)

(defun degk--flasher-terminal-fallback
  (plEnt blockObjs polylines tol sourceSira / sourceLayout sourceFloor blkObj info layout sameFloor copyable ins cp gap rank best bestRank bestGap)
  ;; Flasor polyline'i kontrol modulune fiziksel olarak degmiyorsa once ayni
  ;; katta ve secilen normal loopta kopyalanacak modulu, sonra en yakin uygun
  ;; modulu sec. Boylece hem kat hem de kolon semasindaki gercek hiza korunur.
  (setq sourceLayout (degk--layout-key-from-sira sourceSira)
        sourceFloor  (if sourceLayout (car sourceLayout) nil))
  (foreach blkObj blockObjs
    (if (degk--flasher-terminal-module-p blkObj)
      (progn
        (setq info       (degk--block-first-layout-info blkObj)
              layout     (if info (cadr info) nil)
              sameFloor  (and (numberp sourceFloor)
                              layout
                              (= sourceFloor (car layout)))
              copyable   (degk--block-touches-selected-normal-p
                           blkObj polylines tol)
              ins        (deg-get-inspt blkObj)
              cp         (if ins (deg-safe-closest-point plEnt ins) nil)
              gap        (if (and ins cp) (distance ins cp) 1.0e99)
              rank
                (cond
                  ((and sameFloor copyable) 0)
                  (copyable 1)
                  (sameFloor 2)
                  (T 3)))
        (if (or (null bestRank)
                (< rank bestRank)
                (and (= rank bestRank) (< gap bestGap)))
          (setq best     blkObj
                bestRank rank
                bestGap  gap))
      )
    )
  )
  best
)

(defun degk--records-flasher-last (records / normal flasher rec ent layer)
  ;; Once ana/yangin looplari kopyalanir; boylece flasor loopu kendi
  ;; kontrol modulunun kolon semasindaki gercek konumunu bulabilir.
  (foreach rec records
    (setq ent   (nth 4 rec)
          layer (if ent (cdr (assoc 8 (entget ent))) nil))
    (if (and layer (degk--flasher-loop-layer-p layer))
      (setq flasher (cons rec flasher))
      (setq normal (cons rec normal)))
  )
  (append (reverse normal) (reverse flasher))
)

(defun degk--layout-record-flasher-p (rec / ent layer)
  (setq ent   (nth 4 rec)
        layer (if ent (cdr (assoc 8 (entget ent))) nil))
  (and layer (degk--flasher-loop-layer-p layer))
)

(defun degk--flasher-record-copy-x (rec / sourceObj copyRec anchor p)
  ;; Terminal kopyalari normal looplar islenirken kaydedilir. Siralama,
  ;; plandaki kaynak konumdan degil kolon semasindaki gercek kopyadan yapilir.
  (setq sourceObj (nth 6 rec)
        copyRec   (if sourceObj
                    (degk--area-module-copy-get sourceObj (nth 1 rec))
                    nil)
        anchor    (if copyRec (cadr copyRec) nil))
  (if (and anchor (numberp (car anchor)) (numberp (cadr anchor)))
    (setq p (trans anchor 0 1))
    (if sourceObj
      (setq p (trans (deg-get-inspt sourceObj) 0 1))
    )
  )
  (if (and p (numberp (car p))) (car p) -1.0e99)
)

(defun degk--flasher-record-right-first-less-p (a b / floorA floorB xA xB indexA indexB)
  ;; Katlar kendi sirasini korur; ayni katta terminali daha sagda olan
  ;; ozel loop once islenir ve boylece yukariya en yakin baglanti seviyesini alir.
  (setq floorA (nth 1 a)
        floorB (nth 1 b)
        xA     (degk--flasher-record-copy-x a)
        xB     (degk--flasher-record-copy-x b)
        indexA (nth 3 a)
        indexB (nth 3 b))
  (cond
    ((/= floorA floorB) (< floorA floorB))
    ((> (abs (- xA xB)) 1e-6) (> xA xB))
    (T (< indexA indexB)))
)

(defun degk--sort-flasher-records-right-first (records /)
  (vl-sort records 'degk--flasher-record-right-first-less-p)
)

(defun degk--flasher-records-connected-first (records / connected openRecords rec sourceObj)
  ;; Once kolon kopyasi gercekten bulunan bagli looplari isle. Boylece daha
  ;; sonra gelen acik looplar yalniz gercekte bos kalan terminali kullanir.
  (foreach rec records
    (setq sourceObj (nth 6 rec))
    (if (and sourceObj
             (degk--area-module-copy-get sourceObj (nth 1 rec)))
      (setq connected (cons rec connected))
      (setq openRecords (cons rec openRecords))))
  (append (reverse connected) (reverse openRecords))
)

