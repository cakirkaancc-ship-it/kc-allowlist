(defun degk--curve-ok? (ent / r)
  (setq r (vl-catch-all-apply 'vlax-curve-getStartPoint (list ent)))
  (not (vl-catch-all-error-p r))
)

(defun degk--poly-touch-insertion? (plEnt blkObj tol / ins cp)
  (setq ins (deg-get-inspt blkObj))
  (and ins
       (degk--point-near-loop-bounds-p ins (degk--loop-bounds plEnt) tol)
       (setq cp (deg-safe-closest-point plEnt ins))
       (<= (distance ins cp) tol))
)

(defun degk--block-touches-loop-p (loopEnts blkObj tol / hit plEnt)
  ;; Tek bir loop birden fazla polyline parcasindan olusabilir.
  (setq hit nil)
  (foreach plEnt loopEnts
    (if (and (not hit)
             plEnt
             (degk--curve-ok? plEnt)
             (degk--poly-touch-insertion? plEnt blkObj tol))
      (setq hit T)
    )
  )
  hit
)

(defun degk--dist-along (plEnt pt)
  (deg-safe-dist-at-point plEnt (deg-safe-closest-point plEnt pt))
)

(defun degk--get-att (blkObj tagName / res atts a tg val)
  (setq res nil)
  (setq atts (degk--att-list blkObj))
  (foreach a atts
    (setq tg (vl-catch-all-apply 'vla-get-TagString (list a)))
    (if (not (vl-catch-all-error-p tg))
      (progn
        (if (= (strcase tg) (strcase tagName))
          (progn
            (setq val (vl-catch-all-apply 'vla-get-TextString (list a)))
            (if (not (vl-catch-all-error-p val))
              (setq res val)
            )
          )
        )
      )
    )
  )
  (degk--clean-text res)
)

(defun degk--use-from-lower-sira-records
  (records totalLen / rec dist endGap n startDist startNum endDist endNum)
  (foreach rec records
    (setq dist (car rec)
          n (cadr rec)
          endGap (- totalLen dist))
    (if (or (null startDist) (< dist startDist))
      (setq startDist dist startNum n)
    )
    (if (or (null endDist) (< endGap endDist))
      (setq endDist endGap endNum n)
    )
  )
  (cond
    ((and startNum endNum (< startNum endNum)) T)
    ((and startNum endNum (> startNum endNum)) nil)
    ((and startNum endNum) (<= startDist endDist))
    (startNum T)
    (endNum nil)
    (T T)
  )
)

(defun degk--use-from-lower-sira-side
  (plEnt blocks totalLen / blkObj ins dist n records)
  (foreach blkObj blocks
    (setq n (degk--sira-min-number (degk--get-att blkObj "SIRA_NO")))
    (if n
      (progn
        (setq ins (deg-get-inspt blkObj))
        (if ins
          (progn
            (setq dist (degk--dist-along plEnt ins))
            (setq records (cons (list dist n) records))
          )
        )
      )
    )
  )
  (degk--use-from-lower-sira-records records totalLen)
)

(defun degk--set-att (blkObj tagName newVal / atts a tg)
  (setq newVal (degk--clean-text newVal))
  (degk--make-object-and-atts-editable blkObj)
  (setq atts (degk--att-list blkObj))
  (foreach a atts
    (setq tg (vl-catch-all-apply 'vla-get-TagString (list a)))
    (if (and (not (vl-catch-all-error-p tg)) (= (strcase tg) (strcase tagName)))
      (vl-catch-all-apply 'vla-put-TextString (list a newVal))
    )
  )
  nil
)


