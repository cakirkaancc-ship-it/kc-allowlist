        (cons 100 "AcDbEntity")
        (cons 8 lay)
        (cons 100 "AcDbPolyline")
        (cons 90 n)
        (cons 70 1)
        (cons 38 0.0)
        (cons 43 0.0)
      ))
      (while pts
        (setq p (car pts))
        (setq data (append data (list (cons 10 (list (car p) (cadr p))))))
        (setq pts (cdr pts))
      )
      (setq e (entmakex data))
      e
    )
    nil
  )
)

