      (setq cp1 (g365_closest_on_seg ip a b))
      (setq cp2 (g365_closest_on_seg ip c d))
      (if (and cp1 cp2 (<= (nth 2 cp1) tol) (<= (nth 2 cp2) tol))
        ip
        nil
      )
    )
    nil
  )
)

(defun g377_bump_vertex_cap (boundaryPts idx step childId dist /
                                   childAug brL brR childBM bpt isClosed prevPt nextPt
                                   lenPrev lenNext minLen capD minD trip
                                   enter exit
                                   brL0 brR0 side1 side2 tag1 tag2
                                   attIn attOut
                                   n jj idxCur key brList tmp rec bump didBump kk2 farOther seq)

  (setq childAug (g372_node childId 'aug))
  (setq brL      (g372_node childId 'left))
  (setq brR      (g372_node childId 'right))
  (setq childBM  (g372_node childId 'branchMap))

  (setq isClosed (g376_is_closed boundaryPts))
  (setq bpt (g377_get_bpt boundaryPts idx))

  (if (or (null bpt) (null childAug) (< (length childAug) 2)
          (null brL) (null brR) (< (length brL) 2) (< (length brR) 2))
    nil
    (progn
      (setq minD (max (* 0.15 dist) 0.001))
      (setq prevPt (g412_seek_leg_point boundaryPts idx -1 bpt minD isClosed))
      (setq nextPt (g412_seek_leg_point boundaryPts idx  1 bpt minD isClosed))

      (setq trip (g411_orient_triplet_to_bpt childAug brL brR bpt))
      (setq childAug (nth 0 trip))
      (setq brL      (nth 1 trip))
      (setq brR      (nth 2 trip))

      (setq lenPrev (if prevPt (distance bpt prevPt) 0.0))
      (setq lenNext (if nextPt (distance bpt nextPt) 0.0))
      (cond
        ((and prevPt nextPt) (setq minLen (min lenPrev lenNext)))
        (prevPt             (setq minLen lenPrev))
        (nextPt             (setq minLen lenNext))
        (t                  (setq minLen 0.0))
      )

      (setq capD (min (* 0.7 dist) (* 0.45 minLen)))
      (if (< capD (* 0.05 dist)) (setq capD (* 0.05 dist)))

      (setq enter (if prevPt (g378_pt_towards bpt prevPt capD) bpt))
      (setq exit  (if nextPt (g378_pt_towards bpt nextPt capD) bpt))

      (setq brL0 (car brL))
      (setq brR0 (car brR))

      (if (and brL0 brR0 prevPt (< (distance brL0 prevPt) (distance brR0 prevPt)))
        (progn
          (setq side1 brL  tag1  1)
          (setq side2 brR  tag2 -1)
        )
        (progn
          (setq side1 brR  tag1 -1)
          (setq side2 brL  tag2  1)
        )
      )

      (setq attIn  (if prevPt (g413_attach_on_bound (nth 0 side1) (nth 1 side1) prevPt bpt dist) bpt))
      (setq attOut (if nextPt (g413_attach_on_bound (nth 0 side2) (nth 1 side2) bpt nextPt dist) bpt))
      (if (null attIn)  (setq attIn bpt))
      (if (null attOut) (setq attOut bpt))

      (setq side1 (cons attIn  (cdr side1)))
      (setq side2 (cons attOut (cdr side2)))

      (setq n (length childAug))
      (if (or (< n 2) (/= (length side1) n) (/= (length side2) n))
        nil
        (progn
          (setq seq nil)

          (setq seq (g365_append_pt seq enter))
          (if prevPt
            (progn
              (if (and (not (g387_on_seg prevPt bpt attIn)) (not (g365_closep attIn bpt)))
                (setq seq (g365_append_pt seq bpt))
              )
              (setq seq (g365_append_pt seq attIn))
            )
            (setq seq (g365_append_pt seq attIn))
          )

          (setq jj 1)
          (while (< jj n)
            (setq key (g365_ptkey (nth jj childAug)))
            (setq brList (if childBM (cdr (assoc key childBM)) nil))
            (setq didBump nil)

            (if (and brList (> jj 0) (< jj (1- n)))
              (progn
                (setq tmp brList)
                (while tmp
                  (setq rec (car tmp))
                  (if (= (car rec) tag1)
                    (progn
                      (setq bump (g377_bump_force_rec side1 jj 1 (cadr rec) dist))
                      (if bump
                        (progn
                          (setq kk2 0)
                          (while (< kk2 (length bump))
                            (setq seq (g365_append_pt seq (nth kk2 bump)))
                            (setq kk2 (1+ kk2))
                          )
                          (setq didBump 1)
                        )
                      )
                    )
                  )
                  (setq tmp (cdr tmp))
                )
              )
            )

            (if (not didBump)
              (setq seq (g365_append_pt seq (nth jj side1)))
            )
            (setq jj (1+ jj))
          )

          (setq farOther (nth (1- n) side2))
          (setq seq (g365_append_pt seq farOther))

          (setq idxCur (- n 2))
          (while (>= idxCur 0)
            (setq key (g365_ptkey (nth idxCur childAug)))
            (setq brList (if childBM (cdr (assoc key childBM)) nil))
            (setq didBump nil)

            (if (and brList (> idxCur 0) (< idxCur (1- n)))
              (progn
                (setq tmp brList)
                (while tmp
                  (setq rec (car tmp))
                  (if (= (car rec) tag2)
                    (progn
                      (setq bump (g377_bump_force_rec side2 idxCur -1 (cadr rec) dist))
                      (if bump
                        (progn
                          (setq kk2 0)
                          (while (< kk2 (length bump))
                            (setq seq (g365_append_pt seq (nth kk2 bump)))
                            (setq kk2 (1+ kk2))
                          )
                          (setq didBump 1)
                        )
                      )
                    )
                  )
                  (setq tmp (cdr tmp))
                )
              )
            )

            (if (not didBump)
              (setq seq (g365_append_pt seq (nth idxCur side2)))
            )
            (setq idxCur (1- idxCur))
          )

          (if nextPt
            (progn
              (if (and (not (g387_on_seg bpt nextPt attOut)) (not (g365_closep attOut bpt)))
                (setq seq (g365_append_pt seq bpt))
              )
              (setq seq (g365_append_pt seq exit))
            )
            (setq seq (g365_append_pt seq exit))
          )

          seq
        )
      )
    )
  )
)

(defun dzo415_entmake_closed_poly (lay pts / n data e p)
  (setq n (length pts))
  (if (and n (> n 2))
    (progn
      (setq data (list
        (cons 0 "LWPOLYLINE")
        (cons 100 "AcDbEntity")
        (cons 8 lay)
        (cons 100 "AcDbPolyline")
        (cons 90 n)
        (cons 70 1)
        (cons 38 0.0)
        (cons 43 0.0)
      ))
      (while pts
        (setq p (car pts))
        (setq data (append data (list (cons 10 (list (car p) (cadr p))))))
        (setq pts (cdr pts))
      )
      (setq e (entmakex data))
      e
    )
    nil
  )
)

(defun dzo418_flush_cmd (/ i)
  (setq i 0)
  (while (and (> (getvar "CMDACTIVE") 0) (< i 80))
    (vl-cmdf "")
    (setq i (1+ i))
  )
  (setq i 0)
  (while (and (> (getvar "CMDACTIVE") 0) (< i 10))
    (vl-cmdf "\003") 
    (setq i (1+ i))
  )
  (setq i 0)
  (while (and (> (getvar "CMDACTIVE") 0) (< i 10))
    (vl-cmdf "_.CANCEL")
    (setq i (1+ i))
  )
  T
)

(defun dzo415_ss_from_list (lst / ss)
  (setq ss (ssadd))
  (while lst
    (if (and (car lst) (entget (car lst)))
      (ssadd (car lst) ss)
    )
    (setq lst (cdr lst))
  )
  ss
)

(defun dzo415_collect_new_ents (afterEnt / e out)
  (setq out nil)
  (setq e (if afterEnt (entnext afterEnt) (entnext nil)))
  (while e
    (setq out (cons e out))
    (setq e (entnext e))
  )
  (reverse out)
)

(defun dzo415_poly_closed_p (e / ed flg)
  (setq ed (entget e))
  (setq flg (cdr (assoc 70 ed)))
  (and flg (= 1 (logand 1 flg)))
)

(defun dzo415_poly_area (e / o a)
  (vl-load-com)
  (setq o (vlax-ename->vla-object e))
  (setq a (vl-catch-all-apply 'vla-get-Area (list o)))
  (if (vl-catch-all-error-p a) 0.0 a)
)

(defun dzo415_pick_largest_closed_poly (cand / best bestA e a)
  (setq best nil bestA 0.0)
  (while cand
    (setq e (car cand))
    (if (and (entget e) (= (cdr (assoc 0 (entget e))) "LWPOLYLINE") (dzo415_poly_closed_p e))
      (progn
        (setq a (dzo415_poly_area e))
        (if (> a bestA)
          (progn (setq best e) (setq bestA a))
        )
      )
    )
    (setq cand (cdr cand))
  )
  best
)

(defun dzo415_delete_ents (lst)
  (while lst
    (if (and (car lst) (entget (car lst)))
      (entdel (car lst))
    )
    (setq lst (cdr lst))
  )
  T
)

(defun dzo415_get_assigned_original_ents (allEnts / out scan e)
  (setq out nil)
  (setq scan allEnts)
  (while scan
    (setq e (car scan))
    (if (and e (g372_assigned_p e))
      (setq out (cons e out))
    )
    (setq scan (cdr scan))
  )
  (reverse out)
)

(defun dzo415_make_tube_poly_from_ent (ent dist lay / pts left right path)
  (setq pts (g365_get_pts ent))
  (if (and pts (>= (length pts) 2))
    (progn
      (setq left  (g365_offset_open_pts pts dist  1))
      (setq right (g365_offset_open_pts pts dist -1))
      (if (and left right (= (length left) (length pts)) (= (length right) (length pts)))
        (progn
          (setq path (append left (reverse right)))
          (dzo415_entmake_closed_poly lay path)
        )
        nil
      )
    )
    nil
  )
)

(defun dzo415_pick_any_poly (cand / e typ)
  (setq e nil)
  (while (and cand (null e))
    (setq typ (cdr (assoc 0 (entget (car cand)))))
    (if (member typ '("LWPOLYLINE" "POLYLINE"))
      (setq e (car cand))
    )
    (setq cand (cdr cand))
  )
  e
)

(defun dzo415_pt_close_p (p q tol)
  (and p q (<= (distance p q) tol))
)

(defun dzo415_seg_reversed (seg)
  (list (cons 'sp (cdr (assoc 'ep seg)))
        (cons 'ep (cdr (assoc 'sp seg)))
        (cons 'bul (- (cdr (assoc 'bul seg)))))
)

(defun dzo415_arc_bulge (ed / a1 a2 da)
  (setq a1 (cdr (assoc 50 ed))
        a2 (cdr (assoc 51 ed))
        da (- a2 a1))
  (while (< da 0.0) (setq da (+ da (* 2.0 pi))))
  (while (>= da (* 2.0 pi)) (setq da (- da (* 2.0 pi))))
  (tan (/ da 4.0))
)

(defun dzo415_curve_to_seg (e / ed typ c r a1 a2)
  (setq ed (entget e)
        typ (cdr (assoc 0 ed)))
  (cond
    ((= typ "LINE")
      (list (cons 'sp (cdr (assoc 10 ed)))
            (cons 'ep (cdr (assoc 11 ed)))
            (cons 'bul 0.0)))
    ((= typ "ARC")
      (setq c (cdr (assoc 10 ed))
            r (cdr (assoc 40 ed))
            a1 (cdr (assoc 50 ed))
            a2 (cdr (assoc 51 ed)))
      (list (cons 'sp (polar c a1 r))
            (cons 'ep (polar c a2 r))
            (cons 'bul (dzo415_arc_bulge ed))))
    (T nil)
  )
)

(defun dzo415_order_segs (segs tol / ordered rest cur idx orig matched)
  (if (null segs)
    nil
    (progn
      (setq ordered (list (car segs))
            rest    (cdr segs)
            cur     (cdr (assoc 'ep (car segs))))
      (while rest
        (setq matched nil idx 0)
        (while (and (< idx (length rest)) (null matched))
          (setq orig (nth idx rest))
          (cond
            ((dzo415_pt_close_p (cdr (assoc 'sp orig)) cur tol)
              (setq matched orig))
            ((dzo415_pt_close_p (cdr (assoc 'ep orig)) cur tol)
              (setq matched (dzo415_seg_reversed orig))))
          (setq idx (1+ idx))
        )
        (if matched
          (progn
            (setq ordered (append ordered (list matched)))
            (setq cur (cdr (assoc 'ep matched)))
            (setq rest (vl-remove orig rest)))
          (setq rest nil)
        )
      )
      ordered
    )
  )
)

(defun dzo415_build_lwpoly_from_curves (curves layer / segs seg ord tol pts buls firstp lastseg lastp data pt i)
  (setq segs nil)
  (foreach e curves
    (setq seg (dzo415_curve_to_seg e))
    (if seg (setq segs (append segs (list seg)))))
  (setq tol 1e-4)
  (setq ord (dzo415_order_segs segs tol))
  (if (and ord (= (length ord) (length segs)))
    (progn
      (setq firstp (cdr (assoc 'sp (car ord)))
            lastseg (car (last ord))
            lastp (cdr (assoc 'ep lastseg)))
      (if (dzo415_pt_close_p firstp lastp tol)
        (progn
          (setq pts nil buls nil)
          (foreach seg ord
            (setq pts (append pts (list (cdr (assoc 'sp seg)))))
            (setq buls (append buls (list (cdr (assoc 'bul seg))))))
          (setq data (list '(0 . "LWPOLYLINE")
                           '(100 . "AcDbEntity")
                           (cons 8 layer)
                           '(100 . "AcDbPolyline")
                           (cons 90 (length pts))
                           '(70 . 1)))
          (setq i 0)
          (while (< i (length pts))
            (setq pt (nth i pts))
            (setq data (append data
                               (list (cons 10 (list (car pt) (cadr pt)))
                                     (cons 42 (nth i buls)))))
            (setq i (1+ i))
          )
          (entmakex data)
        )
      )
    )
  )
)

(defun dzo415_force_close_poly (e / ed old70)
  (if (and e (entget e))
    (progn
      (setq ed (entget e))
      (setq old70 (cdr (assoc 70 ed)))
      (if (null old70) (setq old70 0))
      (if (= 0 (logand old70 1))
        (progn
          (setq ed (subst (cons 70 (boole 7 old70 1)) (assoc 70 ed) ed))
          (entmod ed)
          (entupd e)
        )
      )
    )
  )
  e
)

(defun dzo415_union_tubes_to_outline (tubePls lay / oldCm oldPe oldOsm oldCl beforeR regEnts ssReg beforeU uniEnts regU beforeX curves ssC beforeP newEnts cand best)
  (setq best nil)
  (if (null tubePls)
    nil
    (progn
      (setq oldCm (getvar "CMDECHO"))
      (setq oldPe (getvar "PEDITACCEPT"))
      (setq oldOsm (getvar "OSMODE"))
      (setq oldCl (getvar "CLAYER"))
      (setvar "CMDECHO" 0)
      (setvar "PEDITACCEPT" 1)
      (setvar "OSMODE" 0)

      (setq beforeR (entlast))
      (vl-cmdf "_.REGION" (dzo415_ss_from_list tubePls) "")
      (setq regEnts (dzo415_collect_new_ents beforeR))

      (if regEnts
        (progn
          (setq ssReg (dzo415_ss_from_list regEnts))
          (setq beforeU (entlast))
          (vl-cmdf "_.UNION" ssReg "")
          (setq uniEnts (dzo415_collect_new_ents beforeU))
          (if uniEnts
            (setq regU (car (last uniEnts)))
            (setq regU (entlast))
          )

          (if (and regU (entget regU))
            (progn
              (setq beforeX (entlast))
              (vl-cmdf "_.EXPLODE" regU)
              (setq curves (dzo415_collect_new_ents beforeX))

              (if curves
                (progn
                  (setq ssC (dzo415_ss_from_list curves))
                  (setq beforeP (entlast))
                  (setq oldPEDITACCEPT (getvar "PEDITACCEPT"))
                  (setvar "PEDITACCEPT" 1)
                  (vl-cmdf "_.PEDIT" "_M" ssC "" "_J" 0.0 "")
                  (setvar "PEDITACCEPT" oldPEDITACCEPT)
                  (dzo418_flush_cmd)
                  (setq newEnts (dzo415_collect_new_ents beforeP))
                  (setq cand (append curves newEnts))
                  (setq best (dzo415_pick_largest_closed_poly cand))
                  (if (null best)
                    (setq best (dzo415_pick_any_poly cand))
                  )
                  (if (null best)
                    (setq best (dzo415_build_lwpoly_from_curves curves lay))
                  )
                  (if best
                    (progn
                      (dzo415_force_close_poly best)
                      (dzo415_delete_ents (vl-remove best cand))
                    )
                  )
                )
              )
            )
          )
        )
      )

      (dzo418_flush_cmd)
      (setvar "CMDECHO" oldCm)
      (setvar "PEDITACCEPT" oldPe)
      (setvar "OSMODE" oldOsm)
      (setvar "CLAYER" oldCl)

      best
    )
  )
)

(defun g417_take (lst n / out i)
  (setq out nil i 0)
  (while (and lst (< i n))
    (setq out (cons (car lst) out))
    (setq lst (cdr lst))
    (setq i (1+ i))
  )
  (reverse out)
)

(defun g417_nthcdr (n lst / i)
  (setq i 0)
  (while (and lst (< i n))
    (setq lst (cdr lst))
    (setq i (1+ i))
  )
  lst
)

(defun g417_rotate (lst k / a b)
  (if (or (null lst) (<= k 0))
    lst
    (progn
      (setq a (g417_nthcdr k lst))
      (setq b (g417_take lst k))
      (append a b)
    )
  )
)

(defun g417_set_nth (lst idx val / i out)
  (setq i 0 out nil)
  (while lst
    (setq out (cons (if (= i idx) val (car lst)) out))
    (setq lst (cdr lst))
    (setq i (1+ i))
  )
  (reverse out)
)

(defun g417_nearest_vertex (p pts / i bestI bestD d)
  (setq i 0 bestI 0 bestD 1e99)
  (while (< i (length pts))
    (setq d (distance p (nth i pts)))
    (if (< d bestD)
      (progn
        (setq bestD d)
        (setq bestI i)
      )
    )
    (setq i (1+ i))
  )
  (list bestI (nth bestI pts) bestD)
)

(defun g417_farthest_index (p pts / i bestI bestD d)
  (setq i 0 bestI 0 bestD -1.0)
  (while (< i (length pts))
    (setq d (distance p (nth i pts)))
    (if (> d bestD)
      (progn
        (setq bestD d)
        (setq bestI i)
      )
    )
    (setq i (1+ i))
  )
  bestI
)

(defun g417_lwpoly_parse (ed / pts bul sw ew curIdx pr code val)
  (setq pts nil bul nil sw nil ew nil curIdx -1)
  (while ed
    (setq pr (car ed))
    (setq code (car pr))
    (setq val (cdr pr))
    (cond
      ((= code 10)
        (setq pts (append pts (list (list (car val) (cadr val) 0.0))))
        (setq bul (append bul (list 0.0)))
        (setq sw  (append sw  (list nil)))
        (setq ew  (append ew  (list nil)))
        (setq curIdx (1- (length pts)))
      )
      ((and (>= curIdx 0) (= code 42))
        (setq bul (g417_set_nth bul curIdx val))
      )
      ((and (>= curIdx 0) (= code 40))
        (setq sw (g417_set_nth sw curIdx val))
      )
      ((and (>= curIdx 0) (= code 41))
        (setq ew (g417_set_nth ew curIdx val))
      )
    )
    (setq ed (cdr ed))
  )
  (list pts bul sw ew)
)

(defun g417_lwpoly_rebuild (pre pts bul sw ew / n i x y out)
  (setq n (length pts))
  (setq out nil)
  (while pre
    (if (= (car (car pre)) 90)
      (setq out (cons (cons 90 n) out))
      (setq out (cons (car pre) out))
    )
    (setq pre (cdr pre))
  )
  (setq out (reverse out))

  (setq i 0)
  (while (< i n)
    (setq x (car (nth i pts)))
    (setq y (cadr (nth i pts)))
    (setq out (append out (list (cons 10 (list x y)))))
    (if (nth i sw) (setq out (append out (list (cons 40 (nth i sw))))))
    (if (nth i ew) (setq out (append out (list (cons 41 (nth i ew))))))
    (if (and (nth i bul) (/= (nth i bul) 0.0))
      (setq out (append out (list (cons 42 (nth i bul)))))
    )
    (setq i (1+ i))
  )
  out
)

(defun g417_lwpoly_rotate_start (e k / ed pre rest parsed pts bul sw ew n pts2 bul2 sw2 ew2 newEd)
  (setq ed (entget e))
  (if (/= (cdr (assoc 0 ed)) "LWPOLYLINE")
    nil
    (progn
      (setq pre nil rest ed)
      (while (and rest (/= (car (car rest)) 10))
        (setq pre (append pre (list (car rest))))
        (setq rest (cdr rest))
      )
      (setq parsed (g417_lwpoly_parse ed))
      (setq pts (nth 0 parsed))
      (setq bul (nth 1 parsed))
      (setq sw  (nth 2 parsed))
      (setq ew  (nth 3 parsed))
      (setq n (length pts))
      (if (< n 3)
        nil
        (progn
          (setq k (rem k n))
          (if (< k 0) (setq k (+ k n)))
          (setq pts2 (g417_rotate pts k))
          (setq bul2 (g417_rotate bul k))
          (setq sw2  (g417_rotate sw k))
          (setq ew2  (g417_rotate ew k))
          (setq newEd (g417_lwpoly_rebuild pre pts2 bul2 sw2 ew2))
          (entmod newEd)
          (entupd e)
          T
        )
      )
    )
  )
)

(defun g417_move_outline_seam (outline pick mainPts / nearV outPts k)
  (if (and outline pick mainPts)
    (progn
      (if (= (cdr (assoc 0 (entget outline))) "LWPOLYLINE")
        (progn
          (setq nearV (g417_nearest_vertex pick mainPts))
          (setq outPts (g365_get_pts outline))
          (if (and outPts (>= (length outPts) 3))
            (progn
              (setq k (g417_farthest_index (cadr nearV) outPts))
              (g417_lwpoly_rotate_start outline k)
            )
          )
        )
      )
    )
  )
  T
)

(vl-load-com)

(defun DZO--ename (x)
  (cond
    ((= (type x) 'ENAME) x)
    ((= (type x) 'VLA-OBJECT) (vlax-vla-object->ename x))
    (t nil)
  )
)

(defun DZO--pt2d (p)
  (cond
    ((and (listp p) (>= (length p) 2)) (list (car p) (cadr p)))
    (t p)
  )
)

(defun DZO--pt3d (p)
  (setq p (DZO--pt2d p))
  (list (car p) (cadr p) 0.0)
)

(defun dzo-safe-closest-point (crv pt / e r)
  (setq e (DZO--ename crv))
  (if (not e)
    (DZO--pt2d pt)
    (progn
      (setq r (vl-catch-all-apply 'vlax-curve-getClosestPointTo (list e (DZO--pt3d pt))))
      (if (vl-catch-all-error-p r)
        (DZO--pt2d pt)
        (DZO--pt2d r)
      )
    )
  )
)

(defun dzo-safe-dist-at-point (crv pt / e cp r)
  (setq e  (DZO--ename crv))
  (if (not e)
    0.0
    (progn
      (setq cp (dzo-safe-closest-point e pt))
      (setq r  (vl-catch-all-apply 'vlax-curve-getDistAtPoint (list e (DZO--pt3d cp))))
      (if (vl-catch-all-error-p r)
        0.0
        r
      )
    )
  )
)

(defun DZO--safe-props (e / ed pr)
  (setq e  (DZO--ename e))
  (setq ed (entget e))
  (setq pr (vl-remove nil (list (assoc 8 ed) (assoc 62 ed) (assoc 6 ed) (assoc 48 ed) (assoc 370 ed))))
  pr
)

(defun DZO--get-lwpts (e / ed pts x)
  (setq e  (DZO--ename e))
  (setq ed (entget e) pts '())
  (foreach x ed
    (if (= (car x) 10)
      (cond
        ((listp (cdr x)) (setq pts (append pts (list (DZO--pt2d (cdr x))))))
        ((and (listp x) (>= (length x) 3))
         (setq pts (append pts (list (list (cadr x) (caddr x))))))
      )
    )
  )
  pts
)

(defun DZO--entmakex-lwpoly (pts props closed70 / lst e)
  (if (null closed70) (setq closed70 0))
  (setq lst
    (append
      (list (cons 0 "LWPOLYLINE") (cons 100 "AcDbEntity"))
      props
      (list (cons 100 "AcDbPolyline") (cons 90 (length pts)) (cons 70 closed70))
      (apply 'append (mapcar '(lambda (p) (list (cons 10 (DZO--pt2d p)))) pts))
    )
  )
  (entmake lst)
  (setq e (entlast))
  e
)

(defun DZO--ensure-last (lst pt)
  (if (or (null lst) (> (distance (DZO--pt2d (last lst)) (DZO--pt2d pt)) 1e-6))
    (append lst (list (DZO--pt2d pt)))
    lst
  )
)

(defun DZO--unit (vx vy / l)
  (setq l (sqrt (+ (* vx vx) (* vy vy))))
  (if (> l 1e-12)
    (list (/ vx l) (/ vy l) l)
    (list 0.0 0.0 0.0)
  )
)


(defun DZO--perp-axis-from-curve (crv pt / obj par der dx dy)
  ;; ORTHO: curve tangent -> choose dominant axis, return perpendicular unit (rx ry)
  (setq obj (if (vlax-objectp crv) crv (vlax-ename->vla-object crv)))
  (setq par (vl-catch-all-apply 'vlax-curve-getParamAtPoint (list obj pt)))
  (if (vl-catch-all-error-p par)
    (progn
      (list 1.0 0.0)
    )
    (progn
      (setq der (vl-catch-all-apply 'vlax-curve-getFirstDeriv (list obj par)))
      (if (vl-catch-all-error-p der)
        (list 1.0 0.0)
        (progn
          (setq dx (car der) dy (cadr der))
          (if (>= (abs dx) (abs dy))
            (list 0.0 1.0)  ;; curve ~ horizontal -> perp is vertical
            (list 1.0 0.0)  ;; curve ~ vertical   -> perp is horizontal
          )
        )
      )
    )
  )
)

(defun DZO--curve-total (crv)
  (setq crv (DZO--ename crv))
  (if (not crv)
    0.0
    (vlax-curve-getDistAtParam crv (vlax-curve-getEndParam crv))
  )
)

(defun DZO--clamp (v a b)
  (cond ((< v a) a) ((> v b) b) (t v))
)

(defun DZO--distpair10 (distMid dirSign maxDist half / d1 d2)
  ;; distMid etrafýnda ±half (toplam 2*half) olacak þekilde iki mesafe üretir.
  ;; Uçlarda (0 / maxDist) 10 birimi korumak için içeri kaydýrýr.
  (setq full (* 2.0 half))
  (setq d1 (- distMid (* half dirSign)))
  (setq d2 (+ distMid (* half dirSign)))

  ;; önce kaba clamp
  (setq d1 (DZO--clamp d1 0.0 maxDist))
  (setq d2 (DZO--clamp d2 0.0 maxDist))

  ;; eðer 10 birim bozulduysa, uca göre düzelt
  (if (< (abs (- d2 d1)) (- full 1e-3))
    (cond
      ;; baþlangýca çok yakýn
      ((< distMid half)
        (if (>= dirSign 0.0)
          (progn (setq d1 0.0) (setq d2 (DZO--clamp full 0.0 maxDist)))
          (progn (setq d2 0.0) (setq d1 (DZO--clamp full 0.0 maxDist)))
        )
      )
      ;; sona çok yakýn
      ((< (- maxDist distMid) half)
        (if (>= dirSign 0.0)
          (progn (setq d2 maxDist) (setq d1 (DZO--clamp (- maxDist full) 0.0 maxDist)))
          (progn (setq d1 maxDist) (setq d2 (DZO--clamp (- maxDist full) 0.0 maxDist)))
        )
      )
    )
  )

  (list d1 d2)
)

(defun DZO--closest-on-seg (a b p / ax ay bx by px py abx aby apx apy den tt cx cy dx dy)
  (setq a (DZO--pt2d a) b (DZO--pt2d b) p (DZO--pt2d p))
  (setq ax (car a) ay (cadr a))
  (setq bx (car b) by (cadr b))
  (setq px (car p) py (cadr p))
  (setq abx (- bx ax) aby (- by ay))
  (setq apx (- px ax) apy (- py ay))
  (setq den (+ (* abx abx) (* aby aby)))
  (if (< den 1e-12)
    (list a (+ (* apx apx) (* apy apy)))
    (progn
      (setq tt (/ (+ (* apx abx) (* apy aby)) den))
      (setq tt (DZO--clamp tt 0.0 1.0))
      (setq cx (+ ax (* tt abx)))
      (setq cy (+ ay (* tt aby)))
      (setq dx (- px cx))
      (setq dy (- py cy))
      (list (list cx cy) (+ (* dx dx) (* dy dy)))
    )
  )
)

(defun DZO--poly-closest-seg-index (pts p closed70 / n lim i a b res d2 bestI bestD)
  (setq pts (mapcar 'DZO--pt2d pts))
  (setq p (DZO--pt2d p))
  (setq n (length pts))
  (if (< n 2)
    0
    (progn
      (setq lim (if (/= (logand closed70 1) 0) n (1- n)))
      (setq i 0 bestI 0 bestD 1e99)
      (while (< i lim)
        (setq a (nth i pts))
        (setq b (nth (if (= i (1- n)) 0 (1+ i)) pts))
        (setq res (DZO--closest-on-seg a b p))
        (setq d2 (cadr res))
        (if (< d2 bestD)
          (progn (setq bestD d2) (setq bestI i))
        )
        (setq i (1+ i))
      )
      bestI
    )
  )
)

(defun DZO--poly-closest-on-seg (pts segIdx p closed70 / n a b res)
  (setq pts (mapcar 'DZO--pt2d pts))
  (setq p (DZO--pt2d p))
  (setq n (length pts))
  (if (< n 2)
    p
    (progn
      (setq a (nth segIdx pts))
      (setq b (nth (if (= segIdx (1- n)) 0 (1+ segIdx)) pts))
      (setq res (DZO--closest-on-seg a b p))
      (car res)
    )
  )
)

(defun DZO--cpE-side (crv cp join rx ry / e d tot pPlus pMin v1x v1y v2x v2y s1 s2)
  (setq e (DZO--ename crv))
  (setq cp (DZO--pt2d cp))
  (if (not e)
    cp
    (progn
      (setq d   (dzo-safe-dist-at-point e cp))
      (setq tot (DZO--curve-total e))

      (setq pPlus (vlax-curve-getPointAtDist e (min tot (+ d join))))
      (setq pMin  (vlax-curve-getPointAtDist e (max 0.0 (- d join))))

      (setq pPlus (DZO--pt2d pPlus))
      (setq pMin  (DZO--pt2d pMin))

      (setq v1x (- (car pPlus) (car cp)))
      (setq v1y (- (cadr pPlus) (cadr cp)))
      (setq v2x (- (car pMin) (car cp)))
      (setq v2y (- (cadr pMin) (cadr cp)))

      (setq s1 (+ (* v1x rx) (* v1y ry)))
      (setq s2 (+ (* v2x rx) (* v2y ry)))

      (if (>= s1 s2) pPlus pMin)
    )
  )
)

(defun DZO--cpE-side-flag (crv cp join choosePlus / e d tot pPlus pMin)
  (setq e (DZO--ename crv))
  (setq cp (DZO--pt2d cp))
  (if (not e)
    cp
    (progn
      (setq d   (dzo-safe-dist-at-point e cp))
      (setq tot (DZO--curve-total e))
      (setq pPlus (DZO--pt2d (vlax-curve-getPointAtDist e (min tot (+ d join)))))
      (setq pMin  (DZO--pt2d (vlax-curve-getPointAtDist e (max 0.0 (- d join)))))
      (if choosePlus pPlus pMin)
    )
  )
)

(defun DZO--shorten-toward-cp (crv cp cpE short / e dcp dE tot dNew)
  (setq e (DZO--ename crv))
  (setq cp  (DZO--pt2d cp))
  (setq cpE (DZO--pt2d cpE))
  (if (not e)
    cpE
    (progn
      (setq dcp (dzo-safe-dist-at-point e cp))
      (setq dE  (dzo-safe-dist-at-point e cpE))
      (setq tot (DZO--curve-total e))

      (if (>= dE dcp)
        (setq dNew (max dcp (- dE short)))
        (setq dNew (min dcp (+ dE short)))
      )
      (DZO--pt2d (vlax-curve-getPointAtDist e (DZO--clamp dNew 0.0 tot)))
    )
  )
)

(defun DZO--insert-detour (crv attachA attachB midPts / e pts props pA pB tmp sIdx eIdx head tail k newPts firstPt lastPt keepScore revScore midNorm p)
  (setq e     (DZO--ename crv))
  (setq pts   (DZO--get-lwpts e))
  (setq props (DZO--safe-props e))

  (setq attachA (dzo-safe-closest-point e attachA))
  (setq attachB (dzo-safe-closest-point e attachB))

  (setq pA (vl-catch-all-apply 'vlax-curve-getParamAtPoint (list e (DZO--pt3d attachA))))
  (setq pB (vl-catch-all-apply 'vlax-curve-getParamAtPoint (list e (DZO--pt3d attachB))))
  (if (or (vl-catch-all-error-p pA) (vl-catch-all-error-p pB))
    crv
    (progn
      (if (> pA pB)
        (progn
          (setq tmp attachA attachA attachB attachB tmp)
          (setq tmp pA pA pB pB tmp)
        )
      )
      ;; midPts tek nokta ya da karisik liste gelebilir; sadece gercek noktalari kullan.
      (setq midNorm '())
      (cond
        ((null midPts)
          (setq midPts nil)
        )
        ((not (listp midPts))
          (setq midPts nil)
        )
        ((and (numberp (car midPts)) (numberp (cadr midPts)))
          (setq midPts (list (DZO--pt2d midPts)))
        )
        (T
          (foreach p midPts
            (if (and (listp p) (numberp (car p)) (numberp (cadr p)))
              (setq midNorm (append midNorm (list (DZO--pt2d p))))
            )
          )
          (setq midPts midNorm)
        )
      )

      ;; Polyline cizim yonu ters olsa bile agiz eslesmesi yakinliga gore kalsin.
      (if (and midPts (cdr midPts)
               (listp attachA) (numberp (car attachA)) (numberp (cadr attachA))
               (listp attachB) (numberp (car attachB)) (numberp (cadr attachB)))
        (progn
          (setq firstPt (DZO--pt2d (car midPts)))
          (setq lastPt  (DZO--pt2d (car (last midPts))))
          (setq keepScore (+ (distance (DZO--pt2d attachA) firstPt) (distance (DZO--pt2d attachB) lastPt)))
          (setq revScore  (+ (distance (DZO--pt2d attachA) lastPt)  (distance (DZO--pt2d attachB) firstPt)))
          (if (< revScore keepScore)
            (setq midPts (reverse midPts))
          )
        )
      )

      (setq sIdx (fix pA))
      (setq eIdx (fix pB))

      (setq head '() k 0)
      (while (<= k sIdx)
        (setq head (append head (list (nth k pts))))
        (setq k (1+ k))
      )
      (setq head (DZO--ensure-last head attachA))

      (setq tail '() k (1+ eIdx))
      (while (< k (length pts))
        (setq tail (append tail (list (nth k pts))))
        (setq k (1+ k))
      )

      (setq newPts (append head (mapcar 'DZO--pt2d midPts) (list attachB) tail))

      (entdel e)
      (DZO--entmakex-lwpoly newPts props 0)
    )
  )
)

(defun DZO--block-effective-name (en / vla nm ed)
  (setq en (DZO--ename en))
  (if (not en)
    nil
    (progn
      (setq ed (entget en))
      (setq nm (cdr (assoc 2 ed)))
      (if (and nm (= (substr nm 1 1) "*"))
        (progn
          (setq vla (vlax-ename->vla-object en))
          (if (vlax-property-available-p vla 'EffectiveName)
            (setq nm (vla-get-EffectiveName vla))
          )
        )
      )
      nm
    )
  )
)

(defun DZO--skip-block-p (blk / nm nmU)
  (setq nm  (DZO--block-effective-name blk))
  (setq nmU (strcase (if nm nm "")))
  (if (or (vl-string-search "FLASOR" nmU)
          (vl-string-search "FLAR"   nmU))
    T
    nil
  )
)

(defun DZO--floor (x)
  (if (>= x 0.0) (fix x) (1- (fix x)))
)

(defun DZO--cellkey (p cell / cx cy)
  (setq p (DZO--pt2d p))
  (setq cx (DZO--floor (/ (car p) cell)))
  (setq cy (DZO--floor (/ (cadr p) cell)))
  (list cx cy)
)

(defun DZO--cells-put (cells key val / rec)
  (if (setq rec (assoc key cells))
    (subst (cons key (cons val (cdr rec))) rec cells)
    (cons (list key val) cells)
  )
)

(defun DZO--uf-init (parents x)
  (if (assoc x parents) parents (cons (cons x x) parents))
)

(defun DZO--uf-find (parents x / p)
  (setq p (cdr (assoc x parents)))
  (if (null p) x
    (progn
      (while (and p (not (equal p x)))
        (setq x p)
        (setq p (cdr (assoc x parents)))
      )
      x
    )
  )
)

(defun DZO--uf-union (parents a b / ra rb rec)
  (setq ra (DZO--uf-find parents a))
  (setq rb (DZO--uf-find parents b))
  (if (not (equal ra rb))
    (progn
      (setq rec (assoc rb parents))
      (if rec
        (setq parents (subst (cons rb ra) rec parents))
        (setq parents (cons (cons rb ra) parents))
      )
    )
  )
  parents
)

(defun DZO--groups-build (parents data / groups blk rep r rec)
  (setq groups '())
  (foreach rec data
    (setq blk (car rec))
    (setq rep (DZO--uf-find parents blk))
    (if (setq r (assoc rep groups))
      (setq groups (subst (cons rep (cons rec (cdr r))) r groups))
      (setq groups (cons (list rep rec) groups))
    )
  )
  groups
)

(defun DZO--choosePlus-main (mainCrv ip cp join / vvx vvy uu dx dy rx ry cpE d tot pPlus)
  (setq ip (DZO--pt2d ip))
  (setq cp (DZO--pt2d cp))

  (setq vvx (- (car ip) (car cp)))
  (setq vvy (- (cadr ip) (cadr cp)))
  (setq uu (DZO--unit vvx vvy))
  (setq dx (car uu) dy (cadr uu))

  (setq rperp (DZO--perp-axis-from-curve mainTmp cpMain))
              (setq rx (car rperp))
              (setq ry (cadr rperp))

  (setq cpE (DZO--cpE-side mainCrv cp join rx ry))

  (setq d   (dzo-safe-dist-at-point mainCrv cp))
  (setq tot (DZO--curve-total mainCrv))
  (setq pPlus (DZO--pt2d (vlax-curve-getPointAtDist (DZO--ename mainCrv) (min tot (+ d join)))))

  (if (<= (distance cpE pPlus) 1e-6) T nil)
)

(defun DZO--point-toward (a b dist / a2 b2 vx vy uu)
  (setq a2 (DZO--pt2d a))
  (setq b2 (DZO--pt2d b))
  (setq vx (- (car b2) (car a2)))
  (setq vy (- (cadr b2) (cadr a2)))
  (setq uu (DZO--unit vx vy))
  (if (> (caddr uu) 1e-12)
    (list (+ (car a2) (* (car uu) dist)) (+ (cadr a2) (* (cadr uu) dist)))
    a2
  )
)

(defun DZO--calc-L-corner (S B uPerp / S2 B2 c1 c2 d1 d2)
  ;; ORTHO KÖÞE: Baðlantýlar sadece 0/90/180/270 olacak þekilde,
  ;; S -> corner -> B iki eksenli (yatay/dikey) kýrýlým üretir.
  (setq S2 (DZO--pt2d S))
  (setq B2 (DZO--pt2d B))

  ;; Ýki olasý L köþe
  (setq c1 (list (car S2) (cadr B2))) ; önce dikey, sonra yatay
  (setq c2 (list (car B2) (cadr S2))) ; önce yatay, sonra dikey

  ;; S'den daha kýsa ilk bacaðý seç
  (setq d1 (distance S2 c1))
  (setq d2 (distance S2 c2))
  (if (<= d1 d2) c1 c2)
)


(defun DZO--ortho-first-axis (ip cp / dx dy)
  ;; T => once X, NIL => once Y
  (setq dx (abs (- (car ip) (car cp))))
  (setq dy (abs (- (cadr ip) (cadr cp))))
  (< dx dy)
)

(defun DZO--axis-horiz-at (crv cp / e prm der dx dy)
  ;; Ana hattin tangent yonune gore yatay mi (T) dikey mi (NIL)
  (setq e (DZO--ename crv))
  (if (not e)
    T
    (progn
      (setq prm (vl-catch-all-apply 'vlax-curve-getParamAtPoint (list e (DZO--pt3d cp))))
      (if (vl-catch-all-error-p prm)
        T
        (progn
          (setq der (vl-catch-all-apply 'vlax-curve-getFirstDeriv (list e prm)))
          (if (vl-catch-all-error-p der)
            T
            (progn
              (setq dx (abs (car der)))
              (setq dy (abs (cadr der)))
              (>= dx dy)
            )
          )
        )
      )
    )
  )
)

;; Ana hattin yonunu, cp noktasinin hemen ilerisinden/gerisinden (choosePlus) örnekleyerek bulur.
;; Köþe (vertex) üstünde derivative belirsiz kaldýðýnda, ilk kolun gerçekten ana hat hizasýnda
;; baþlamasý için kullanýlýr.
(defun DZO--axis-horiz-at2 (crv cp choosePlus / e prm dist maxDist dist2 p2 vx vy)
  (setq e (DZO--ename crv))
  (if (not e)
    T
    (progn
      (setq prm (vl-catch-all-apply 'vlax-curve-getParamAtPoint (list e (DZO--pt3d cp))))
      (if (vl-catch-all-error-p prm)
        (DZO--axis-horiz-at crv cp)
        (progn
          (setq dist    (vlax-curve-getDistAtParam e prm))
          (setq maxDist (vlax-curve-getDistAtParam e (vlax-curve-getEndParam e)))
          ;; 1.0 birimlik örnekleme, köþe noktalarýnda yönü netleþtirir
          (setq dist2 (if choosePlus (+ dist 1.0) (- dist 1.0)))
          (setq dist2 (DZO--clamp dist2 0.0 maxDist))
          (setq p2 (DZO--pt2d (vlax-curve-getPointAtDist e dist2)))
          (setq vx (- (car p2) (car cp)))
          (setq vy (- (cadr p2) (cadr cp)))
          (if (and (< (abs vx) 1e-6) (< (abs vy) 1e-6))
            (DZO--axis-horiz-at crv cp)
            (>= (abs vx) (abs vy))
          )
        )
      )
    )
  )
)

(defun DZO--perp-axis-from-curve (crv pt / prm deriv tx ty)
  ;; ORTHO için ana hattýn tangent yönüne göre (x/y) eksen-perp döndürür.
  ;; dönüþ: (rx ry) birim vektör (mutlak eksen), iþaret sideFact ile verilir.
  (setq prm (vlax-curve-getParamAtPoint (DZO--ename crv) (DZO--pt3d pt)))
  (setq deriv (vlax-curve-getFirstDeriv (DZO--ename crv) prm))
  (setq tx (car deriv) ty (cadr deriv))
  (if (> (abs tx) (abs ty))
    (list 0.0 1.0)   ;; tangent yatay => perp dikey
    (list 1.0 0.0)   ;; tangent dikey => perp yatay
  )
)

(defun DZO--calc-L-corner-mode (S B mode / S2 B2)
  ;; ORTHO KÖÞE (MODLU): mode = 'vfirst veya 'hfirst
  ;; vfirst: (Sx, By)  -> önce dikey, sonra yatay
  ;; hfirst: (Bx, Sy)  -> önce yatay, sonra dikey
  (setq S2 (DZO--pt2d S))
  (setq B2 (DZO--pt2d B))
  (if (= mode 'vfirst)
    (list (car S2) (cadr B2))
    (list (car B2) (cadr S2))
  )
)
(defun DZO--lmode-along-main (cpA cpB / a b dx dy)
  ;; ORTHO zorlanan yerlerde ilk bacak her zaman ana hat hizasinda olsun:
  ;; cpA->cpB vektoru ana hattin tangent eksenini temsil eder.
  ;; yatay => 'hfirst (ilk bacak yatay), dikey => 'vfirst (ilk bacak dikey)
  (setq a (DZO--pt2d cpA))
  (setq b (DZO--pt2d cpB))
  (setq dx (abs (- (car b) (car a))))
  (setq dy (abs (- (cadr b) (cadr a))))
  (if (>= dx dy) 'hfirst 'vfirst)
)

;; ORTHO zorlanan baglantilarda ana hat hizasini secmek icin:
;; cpCur noktasinda egri uzerinde iki yonde (once/sonra) kucuk bir ornek alinir.
;; Blok vektoru ile daha iyi hizalanan yon secilir; bu sayede cpCur bir vertex uzerindeyken
;; "yanlis segment" baz alinmaz (blok sag/ustte kalinca gorulen bozulma).
(defun DZO--lmode-along-main-at (crv cpCur ip / e cp b d len eps d1 d2 p1 p2 v1 v2 vt dot1 dot2 vx vy)
  (setq e (DZO--ename crv))
  (setq cp (DZO--pt2d cpCur))
  (setq b  (DZO--pt2d ip))
  (setq vt (list (- (car b) (car cp)) (- (cadr b) (cadr cp)) 0.0))

  ;; dist clamp
  (setq d   (vlax-curve-getDistAtPoint e cp))
  (setq len (vlax-curve-getDistAtParam e (vlax-curve-getEndParam e)))
  (setq eps 1.0)
  (setq d1 (max 0.0 (- d eps)))
  (setq d2 (min len (+ d eps)))
  (setq p1 (DZO--pt2d (vlax-curve-getPointAtDist e d1)))
  (setq p2 (DZO--pt2d (vlax-curve-getPointAtDist e d2)))

  ;; v1: p1->cp, v2: cp->p2
  (setq v1 (list (- (car cp) (car p1)) (- (cadr cp) (cadr p1)) 0.0))
  (setq v2 (list (- (car p2) (car cp)) (- (cadr p2) (cadr cp)) 0.0))

  (setq dot1 (abs (+ (* (car v1) (car vt)) (* (cadr v1) (cadr vt)))))
  (setq dot2 (abs (+ (* (car v2) (car vt)) (* (cadr v2) (cadr vt)))))

  (if (>= dot2 dot1)
    (progn (setq vx (car v2)) (setq vy (cadr v2)))
    (progn (setq vx (car v1)) (setq vy (cadr v1)))
  )

  (if (> (abs vx) (abs vy)) 'hfirst 'vfirst)
)

(defun DZO--APPLY (crv0 ss / crv i blk ip blk2 ip2
               ptsMain propsMain mainTmp mainClosed
               joinCand short shift approach
               vvx vvy uu dx dy len rx ry ipRin
               nearLim mainFarLim mergeOff
               cell cells
               parents data
               groups
               forcedReps sideMap segMap
               anchorMap stemMap  remoteMap mergeMap
               dirMap dirRec udir mdx mdy p1 ipb p1b pJoin stemRec stemA stemB cpSec pStep pStepb
               g rep recs r bestRec bestIp bestD dNow segIdx choosePlus
               procData anchorRec remote
               forceMain isAnchor cpMain cpCur cpE cpEshort
               uTan uPerp corner1 corner2 paramCur distEnds
               pDown pDownRin uDirRemote anchorStemDir
               key cx cy ix iy rec item mergePt isTargetSide
               sX sY sideFact 
               ipAvg pMid paramMid deriv Tlen Tx Ty Lx Ly dotProd dirSign distMid distDown distDownRin maxDist
               pMerge pMergeRin pLeft pRight ipLeft ipRight pMainTop pMainBot ipTop ipBot yTop yBot pTopA pBotA pTopB pBotB pTopDrop pBotDrop scoreA scoreB outsideLeft fromTop sideMode shortIp longIp calcCrv)

  (vl-load-com)

  (setq joinCand 20.0)
  (setq short    10.0)
  (setq shift    10.0)
  (setq approach 10.0)

  (setq nearLim    100.0)
  (setq mainFarLim 200.0)
  (setq mergeOff   50.0)

  (setq crv0 (DZO--ename crv0))

  (if (not (and crv0 (entget crv0)))
    (progn (princ "\nDZ: Gecersiz polyline.") (princ))
    (if (not (and ss (= (type ss) 'PICKSET) (> (sslength ss) 0)))
      (progn (princ "\nDZ: Block secimi yok.") (princ))
      (progn

        (setq ptsMain   (DZO--get-lwpts crv0))
        (setq propsMain (DZO--safe-props crv0))
        (setq mainClosed (cdr (assoc 70 (entget crv0))))
        (if (null mainClosed) (setq mainClosed 0))
        (setq mainClosed (if (/= (logand mainClosed 1) 0) 1 0))
        (setq mainTmp   (DZO--entmakex-lwpoly ptsMain propsMain mainClosed))

        (setq cell    nearLim)
        (setq cells   '())
        (setq parents '())
        (setq data    '())

        (setq i 0)
        (while (< i (sslength ss))
          (setq blk (ssname ss i))
          (if (not (DZO--skip-block-p blk))
            (progn
              (setq ip (DZO--pt2d (cdr (assoc 10 (entget blk)))))

              (setq parents (DZO--uf-init parents blk))
              (setq data (append data (list (list blk ip))))

              (setq key (DZO--cellkey ip cell))
              (setq cx (car key) cy (cadr key))

              (setq ix -1)
              (while (<= ix 1)
                (setq iy -1)
                (while (<= iy 1)
                  (setq rec (assoc (list (+ cx ix) (+ cy iy)) cells))
                  (if rec
                    (foreach item (cdr rec)
                      (setq blk2 (car item))
                      (setq ip2  (cadr item))
                      (if (and blk2 ip2 (<= (distance ip ip2) nearLim))
                        (setq parents (DZO--uf-union parents blk blk2))
                      )
                    )
                  )
                  (setq iy (1+ iy))
                )
                (setq ix (1+ ix))
              )

              (setq cells (DZO--cells-put cells (list cx cy) (list blk ip)))
            )
          )
          (setq i (1+ i))
        )

        (setq groups (DZO--groups-build parents data))

        (setq forcedReps '())
        (setq sideMap    '())
        (setq segMap     '())
        (setq anchorMap  '())
        (setq stemMap    '())
        (setq remoteMap  '())
        (setq mergeMap   '())
        (setq dirMap     '())

        (foreach g groups
          (setq rep  (car g))
          (setq recs (cdr g))

          (setq bestRec nil)
          (setq bestD   1e99)
          (foreach r recs
            (setq ip (cadr r))
            (setq cpMain (dzo-safe-closest-point mainTmp ip))
            (setq dNow (distance (DZO--pt2d ip) (DZO--pt2d cpMain)))
            (if (< dNow bestD)
              (progn (setq bestD dNow) (setq bestRec r))
            )
          )
          (if (null bestRec) (setq bestRec (car recs)))
          (setq bestIp (cadr bestRec))
          (setq anchorMap (cons (cons rep bestRec) anchorMap))

          (setq cpMain (dzo-safe-closest-point mainTmp bestIp))
          (setq stemMap (cons (cons rep (list (DZO--pt2d bestIp) (DZO--pt2d cpMain))) stemMap))
          (setq choosePlus (DZO--choosePlus-main mainTmp bestIp cpMain joinCand))
          (setq sideMap (cons (cons rep choosePlus) sideMap))
          (setq segIdx (DZO--poly-closest-seg-index ptsMain bestIp mainClosed))
          (setq segMap (cons (cons rep segIdx) segMap))

          (if (> (length recs) 1)
            (progn
              (if (> bestD mainFarLim)
                (progn
                  (setq remoteMap (cons (cons rep T) remoteMap))
                  (setq mergePt (DZO--point-toward bestIp cpMain mergeOff))
                  (setq mergeMap (cons (cons rep mergePt) mergeMap))

                  (setq udir (DZO--unit (- (car bestIp) (car cpMain)) (- (cadr bestIp) (cadr cpMain))))
                  (setq dirMap (cons (cons rep (list (car udir) (cadr udir))) dirMap))
                )
                (progn
                  (setq remoteMap (cons (cons rep nil) remoteMap))
                  (setq forcedReps (cons rep forcedReps))
                )
              )
            )
            (setq remoteMap (cons (cons rep nil) remoteMap))
          )
        )

        (setq procData '())
        (foreach g groups
          (setq rep  (car g))
          (setq recs (cdr g))
          (setq remote (cdr (assoc rep remoteMap)))
          (if (and remote (> (length recs) 1))
            (progn
              (setq anchorRec (cdr (assoc rep anchorMap)))
              (setq procData (append procData (list anchorRec)))
              (foreach r recs
                (if (not (equal (car r) (car anchorRec)))
                  (setq procData (append procData (list r)))
                )
              )
            )
            (setq procData (append procData recs))
          )
        )

        (setq crv crv0)

        (foreach rec procData
          (setq blk (car rec))
          (setq ip  (cadr rec))

          (setq rep (DZO--uf-find parents blk))
          (setq choosePlus (cdr (assoc rep sideMap)))
          (if (null choosePlus) (setq choosePlus T))
          (setq remote (cdr (assoc rep remoteMap)))

          (setq anchorRec (cdr (assoc rep anchorMap)))
          (setq isAnchor (and remote anchorRec (equal blk (car anchorRec))))
          (setq forceMain (if (member rep forcedReps) T nil))

          (cond
            (forceMain
              (progn
                (setq segIdx (cdr (assoc rep segMap)))
                (if (null segIdx) (setq segIdx 0))
                (setq cpMain (DZO--poly-closest-on-seg ptsMain segIdx ip mainClosed))
              )
            )
            (remote
              (if isAnchor
                (progn
                  (setq segIdx (cdr (assoc rep segMap)))
                  (if (null segIdx) (setq segIdx 0))
                  (setq cpMain (DZO--poly-closest-on-seg ptsMain segIdx ip mainClosed))
                )
                (progn
                  (setq cpMain (dzo-safe-closest-point mainTmp ip))
                )
              )
            )
            (T (setq cpMain (dzo-safe-closest-point mainTmp ip)))
          )

          (setq cpCur (dzo-safe-closest-point crv cpMain))

          (setq ip     (DZO--pt2d ip))
          (setq cpMain (DZO--pt2d cpMain))
          (setq cpCur  (DZO--pt2d cpCur))

          (setq vvx (- (car ip) (car cpMain)))
          (setq vvy (- (cadr ip) (cadr cpMain)))
          
          (setq orthoForced (and (> (abs vvx) 1e-6) (> (abs vvy) 1e-6)))
(setq shiftBlk (if orthoForced 10.0 shift))

;; ORTHO zorlamasi (diag) durumunda dx/dy eksenini sabitle:
;; - Bloktan ana hatta en kisa eksen (X veya Y) secilir.
;; - Böylece shiftBlk=10.0 gercekten 10 olarak kalir (capraz unit ile bozulmaz).
(if orthoForced
  (progn
    (setq firstX (>= (abs vvx) (abs vvy)))
    (setq dx (if firstX (if (>= vvx 0.0) 1.0 -1.0) 0.0))
    (setq dy (if firstX 0.0 (if (>= vvy 0.0) 1.0 -1.0)))
    (setq len 100.0)
  )
  (progn
    (setq uu (DZO--unit vvx vvy))
    (setq dx (car uu) dy (cadr uu) len (caddr uu))
  )
)

          (if (and remote (not isAnchor))
            (progn
              (setq uDirRemote (cdr (assoc rep dirMap)))
              (setq dx (car uDirRemote))
              (setq dy (cadr uDirRemote))
              (setq len 100.0)
            )
          )

          (if (> len 1e-9)
            (progn
              (setq rx dy)
              (setq ry (- dx))

              ;; =========================================================
              ;; 1. BLOK BACAK YONU VE TARAF KONTROLU (HERKES ICIN)
              ;; =========================================================
              (setq isTargetSide (or (> dy 1e-4) (< dx -1e-4)))
              (setq sideFact (if isTargetSide -1.0 1.0))

              ;; Sol/Ust taraf ise bacaklari ters yone cevir
              (setq ipRin
                (list
                  (+ (car ip) (* rx shiftBlk sideFact))
                  (+ (cadr ip) (* ry shiftBlk sideFact))
                )
              )
              (setq ipRin
                 (list 
                   (- (car ipRin) (* dx approach))
                   (- (cadr ipRin) (* dy approach))
                 )
              )
              
              ;; cpE noktasini da tarafa gore duzelt (Referans icin)
              (setq rx (* rx sideFact))
              (setq ry (* ry sideFact))

              ;; Remote + anchor + sol/ust ise ANA HAT UZERINDEKI CIKIS VERTEX'INI OBUR TARAFA AL
              ;; (blok bacagi/yonu degismez, sadece ana hatta degdigi taraf degisir)
              (if (and remote isAnchor isTargetSide)
                (setq choosePlus (if choosePlus nil T))
              )

              (if (or forceMain remote)
                (setq cpE (DZO--cpE-side-flag crv cpCur joinCand choosePlus))
                (setq cpE (DZO--cpE-side      crv cpCur joinCand rx ry))
              )

              (setq cpEshort (DZO--shorten-toward-cp crv cpCur cpE short))

              (if (> (distance cpCur cpEshort) 1e-4)
                (progn
                  
                  (if (and remote (not isAnchor))
                     ;; =====================================================
                     ;; DURUM A: UZAK BLOKLAR (REMOTE) -> L-SHAPE / MERGE
                     ;; =====================================================
                     ;; * Bu bloklar komsu hattina baglanmali (Merge).
                     ;; * Hesaplamalar 'crv' (islenmis hat) uzerinde yapilmali.
                     (progn
                       ;; pMerge: ip'den mergeOff kadar asagi
                       (setq pMerge
                        (list
                          (+ (car ip) (* (- dx) mergeOff))
                          (+ (cadr ip) (* (- dy) mergeOff))
                        )
                       )
                       ;; pMergeRin: ipRin hizasinda
                       (setq pMergeRin
                        (list
                          (+ (car pMerge) (- (car ipRin) (car ip)))
                          (+ (cadr pMerge) (- (cadr ipRin) (cadr ip)))
                        )
                       )
                       
                       ;; Ana hat uzerindeki noktalar (Mevcut 'crv' uzerinden alinir)
                       (setq cpCur    (dzo-safe-closest-point crv pMerge))
                       (setq cpEshort (dzo-safe-closest-point crv pMergeRin))
                       
                       ;; Baglanti: pMerge noktalarini kullan (L Sekli)
                       ;; ACI ZORLANAN (ORTHO) DURUMDA:
                       ;; Ilk kolu her zaman "ana hat hizasinda" baslatmak icin, cpCur noktasinda
                       ;; egri uzerinde iki yonde orneklenir ve bloða dogru daha iyi hizalanan
                       ;; segmentin ekseni secilir (vertex ustu sapmalari engeller).
                       (if orthoForced
                         (setq lmode (DZO--lmode-along-main-at crv cpCur ip))
                         (progn
                           (setq firstX (DZO--ortho-first-axis ip cpCur))
                           (setq lmode (if firstX 'hfirst 'vfirst))
                         )
                       )

                       (setq corner1 (DZO--calc-L-corner-mode cpCur    ip   lmode))
                       (setq corner2 (DZO--calc-L-corner-mode cpEshort ipRin lmode))

                       (setq crv (DZO--insert-detour crv cpCur cpEshort (list corner1 ip ipRin corner2)))
                     )
                     
                     ;; =====================================================
                     ;; DURUM B: YAKIN BLOKLAR (DIRECT CONNECT)
                     ;; =====================================================
                     ;; * Bu bloklar DIREKT ana hatta baglanmali.
                     ;; * Komsunun bacagina YAPISMAMALI.
                     ;; * Bu yuzden referans olarak 'mainTmp' (Temiz Hat) kullanilmali.
                     (progn
                        (if (and remote isAnchor)
                            ;; Anchor ozel durumu (Pahli Baglanti)
                            (progn
                              (setq distEnds (distance cpCur cpEshort))
                              (setq uTan (list (/ (- (car cpEshort) (car cpCur)) distEnds)
                                               (/ (- (cadr cpEshort) (cadr cpCur)) distEnds)))
                              (setq uPerp (list (- (cadr uTan)) (car uTan)))
                              (setq corner1 (DZO--calc-L-corner cpCur ip uPerp))
                              (setq corner2 (DZO--calc-L-corner cpEshort ipRin uPerp))
                              (setq crv (DZO--insert-detour crv cpCur cpEshort (list corner1 ip ipRin corner2)))
                            )
                            
                            ;; STANDART DIREKT BAGLANTI (VEKTOREL HIZALAMA)
                            (progn
                                ;; *** ONEMLI: Hesaplamalarda 'mainTmp' (Temiz Hat) kullan! ***
                                (setq calcCrv mainTmp) 
                                
                                ;; A. Orta noktayi bul
                                (setq ipAvg (list (/ (+ (car ip) (car ipRin)) 2.0) (/ (+ (cadr ip) (cadr ipRin)) 2.0)))
                                (setq pMid (dzo-safe-closest-point calcCrv ipAvg))
                                
                                ;; B. Hattin yonunu bul (Temiz hat uzerinden)
                                (setq paramMid (vlax-curve-getParamAtPoint (DZO--ename calcCrv) (DZO--pt3d pMid)))
                                (setq deriv (vlax-curve-getFirstDeriv (DZO--ename calcCrv) paramMid))
                                (setq Tlen (distance '(0 0 0) deriv))
                                (if (< Tlen 1e-9)
                                   (progn (setq Tx rx) (setq Ty ry))
                                   (progn (setq Tx (/ (car deriv) Tlen)) (setq Ty (/ (cadr deriv) Tlen)))
                                )

                                ;; C. Hizalama Yonu
                                (setq Lx (- (car ipRin) (car ip)))
                                (setq Ly (- (cadr ipRin) (cadr ip)))
                                (setq dotProd (+ (* Tx Lx) (* Ty Ly)))
                                (setq dirSign (if (>= dotProd 0) 1.0 -1.0))

                                ;; Remote + anchor + target side: reverse direction so the short piece is taken from the other side
                                (if (and remote isAnchor isTargetSide)
                                  (setq dirSign (- dirSign))
                                )
                                
                                ;; D. Sabit 10 birim aralik (Merkezden +/- 5.0)
                                (setq distMid (vlax-curve-getDistAtParam (DZO--ename calcCrv) paramMid))
                                (setq maxDist (DZO--curve-total calcCrv))
                                
                                (setq distPair (DZO--distpair10 distMid dirSign maxDist shift))
                                (setq distDown (car distPair))
                                (setq distDownRin (cadr distPair))
                                
                                ;; Noktalari Temiz Hat uzerinden al (Komsunun bacagina carpmaz)
                                (setq pDown    (DZO--pt2d (vlax-curve-getPointAtDist (DZO--ename calcCrv) distDown)))
                                (setq pDownRin (DZO--pt2d (vlax-curve-getPointAtDist (DZO--ename calcCrv) distDownRin)))

                                ;; Detour ekleme noktalarini guncel 'crv' uzerinde bul
                                ;; pDown temiz hat uzerinde oldugu icin, 'crv' uzerinde de govdeye denk gelir.
                                (setq cpCur    (dzo-safe-closest-point crv pDown))
                                (setq cpEshort (dzo-safe-closest-point crv pDownRin))
                                
                                ;; DIREKT BAGLANTI LISTESI
                                ;; ORTHO modunu ana hattin yonune gore sabitle (iki uc ayni mod kullanir)
                                (if orthoForced
                                (setq lmode (DZO--lmode-along-main-at crv cpCur ip))
                                (progn
                                  (setq firstX (DZO--ortho-first-axis ip cpCur))
                                  (setq lmode (if firstX 'hfirst 'vfirst))
                                )
                              )
                       ;; ORTHO zorlanan ve blok ana hattin ustunde/solunda ise
                       ;; kisa kolun blok tarafinda kalmasi icin mode'u corner->ip mesafesine gore sec
                       (if (and orthoForced isTargetSide)
                         (progn
                           (setq dxA (abs (- (car ip) (car cpCur))))
                           (setq dyA (abs (- (cadr ip) (cadr cpCur))))
                           ;; vfirst => corner->ip yatay (dx), hfirst => corner->ip dikey (dy)
                           (setq lmode (if (< dxA dyA) 'vfirst 'hfirst))
                         )
                       )
(setq corner1 (DZO--calc-L-corner-mode cpCur    ip   lmode))
                                (setq corner2 (DZO--calc-L-corner-mode cpEshort ipRin lmode))
                                (setq crv (DZO--insert-detour crv cpCur cpEshort (list corner1 ip ipRin corner2)))
                            )
                        )
                     )
                  )
                )
              )
            )
          )
        )

        (if mainTmp (entdel mainTmp))
      )
    )
  )
  (if (and crv (entget crv)) crv nil)
)

(defun DZO-DR--RUN (mainEnt pick dist / mainPts tol ss allEnts rootId assignedEnts lay mainCol tubePls scan e pl outline)
  (setq mainPts (g365_get_pts mainEnt))
  (if (or (null mainPts) (< (length mainPts) 2))
    (progn (princ "\nAna hat okunamadi / cok kisa.") nil)
    (progn
      (setq tol (DEG:CFG-TOL-NUM-OR 'DR_TREE_TOL 0.1))
      (if (<= dist 0.0)
        (progn (princ "\nGecersiz mesafe.") nil)
        (progn
          (setq lay (cdr (assoc 8 (entget mainEnt))))
          (setq mainCol (g365_effective_color mainEnt))
          ;; Iskelete dahil olacak nesneler, secilen ana hat ile AYNI layer'da olmalidir.
          (if (and lay (/= lay ""))
            (setq ss (ssget "X" (list (cons 0 "LWPOLYLINE,POLYLINE,LINE") (cons 8 lay))))
            (setq ss (ssget "X" '((0 . "LWPOLYLINE,POLYLINE,LINE"))))
          )
          (if (null ss)
            (progn (princ "\nHic nesne bulunamadi.") nil)
            (progn
              (setq allEnts (g372_ss_to_list ss))
              ;; Iskelete dahil olacak nesneler, secilen ana hat ile AYNI renkte olmalidir.
              (setq allEnts
                (vl-remove nil
                  (mapcar
                    '(lambda (en)
                       (if (= (g365_effective_color en) mainCol) en nil)
                     )
                    allEnts
                  )
                )
              )
              (setq rootId (g372_build_tree mainEnt mainPts allEnts tol))
              (setq assignedEnts (dzo415_get_assigned_original_ents allEnts))
              
              (setq tubePls nil)
              (setq scan assignedEnts)
              (while scan
                (setq e (car scan))
                (setq pl (dzo415_make_tube_poly_from_ent e dist lay))
                (if pl (setq tubePls (cons pl tubePls)))
                (setq scan (cdr scan))
              )
              (setq tubePls (reverse tubePls))
              (setq outline (dzo415_union_tubes_to_outline tubePls lay))

              (if outline
                (progn
                  (setq outline (dzo418_rebuild_outline_seam outline lay pick mainPts dist))
                  (if outline (g365_copy_color mainEnt outline))
                  (dzo415_delete_ents assignedEnts)
                  (dzo418_flush_cmd)
                  outline
                )
                nil
              )
            )
          )
        )
      )
    )
  )
)

