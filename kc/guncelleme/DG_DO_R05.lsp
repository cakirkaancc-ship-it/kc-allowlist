(defun degkk--active-p ()
  (and (boundp '*DEG_DKK_MODE*) *DEG_DKK_MODE*)
)

(defun degkk--as-object (item / obj)
  (cond
    ((= (type item) 'VLA-OBJECT) item)
    ((= (type item) 'ENAME)
      (setq obj (vl-catch-all-apply 'vlax-ename->vla-object (list item)))
      (if (vl-catch-all-error-p obj) nil obj)
    )
    (T nil)
  )
)

(defun degkk--object-handle (blkObj / h)
  (setq h (if blkObj (vl-catch-all-apply 'vla-get-Handle (list blkObj)) nil))
  (if (or (null h) (vl-catch-all-error-p h)) "" h)
)

(defun degkk--symbol-key (item / obj n h)
  (setq obj (degkk--as-object item)
        n   (if obj (degk--blockname obj) nil)
        h   (if obj (degkk--object-handle obj) ""))
  (cond
    ((and n (/= n "")) (strcase n))
    ((/= h "") (strcat "#" h))
    (T "#UNKNOWN")
  )
)

(defun degkk--normal-group-key (blkObj / key handle)
  ;; DKK normal sembolleri ayni polyline icinde ozetlemeye devam eder.
  ;; Flasor terminal ve monitor modulleri fiziksel baglanti hedefidir; ayni
  ;; blok adina sahip olsalar bile kaynak INSERT handle'i ile ayrilmalidir.
  (setq key (degkk--symbol-key blkObj))
  (if (degk--column-anchor-module-p blkObj)
    (progn
      (setq handle (degkk--object-handle blkObj))
      (if (/= handle "")
        (setq key (strcat key "|ANCHOR|" handle))))
  )
  key
)

(defun degkk--unique-strings (items / out seen item key)
  (foreach item items
    (if (= (type item) 'STR)
      (progn
        (setq key (strcase item))
        (if (not (member key seen))
          (setq seen (cons key seen)
                out  (cons item out))
        )
      )
    )
  )
  (reverse out)
)

(defun degkk--prepare-items (items / counts groups unique seen item key rec)
  (setq counts nil groups nil unique nil seen nil)
  (foreach item items
    (setq key (degkk--symbol-key item))
    (if (setq rec (assoc key counts))
      (setq counts (subst (cons key (1+ (cdr rec))) rec counts))
      (setq counts (cons (cons key 1) counts))
    )
    (if (setq rec (assoc key groups))
      (setq groups (subst (cons key (append (cdr rec) (list item))) rec groups))
      (setq groups (cons (cons key (list item)) groups))
    )
    (if (not (member key seen))
      (setq seen   (cons key seen)
            unique (cons item unique))
    )
  )
  (setq *DEG_DKK_LIST_COUNTS* counts
        *DEG_DKK_LIST_GROUPS* groups)
  (reverse unique)
)

(defun degkk--item-count (item / rec)
  (setq rec (assoc (degkk--symbol-key item) *DEG_DKK_LIST_COUNTS*))
  (if rec (cdr rec) 1)
)

(defun degkk--group-items (item / rec)
  (setq rec (assoc (degkk--symbol-key item) *DEG_DKK_LIST_GROUPS*))
  (if rec (cdr rec) (list item))
)

(defun degkk--normal-token (blkObj siraOne / h)
  (setq h (degkk--object-handle blkObj))
  (strcat h "|" (degk--clean-text siraOne))
)

(defun degkk--normal-occurrence-state (blkObj siraOne / token key rec count pastedObj)
  (setq token (degkk--normal-token blkObj siraOne))
  (if (member token *DEG_DKK_SEEN_OCCURRENCES*)
    'SEEN
    (progn
      (setq *DEG_DKK_SEEN_OCCURRENCES* (cons token *DEG_DKK_SEEN_OCCURRENCES*)
            key (degkk--normal-group-key blkObj)
            rec (assoc key *DEG_DKK_GROUPS*))
      (if rec
        (progn
          (setq count (1+ (cadr rec))
                pastedObj (caddr rec))
          (setq *DEG_DKK_GROUPS*
            (subst (list key count pastedObj) rec *DEG_DKK_GROUPS*))
          (if pastedObj
            (degk--set-att pastedObj "ADET" (strcat "x" (itoa count)))
          )
          'DUPLICATE
        )
        'NEW
      )
    )
  )
)

(defun degkk--register-normal-copy (blkObj copyObj / key)
  (if (and copyObj (= (type copyObj) 'VLA-OBJECT))
    (progn
      (setq key (degkk--normal-group-key blkObj)
            *DEG_DKK_GROUPS* (cons (list key 1 copyObj) *DEG_DKK_GROUPS*))
      (degk--set-att copyObj "ADET" "x1")
    )
  )
  copyObj
)

