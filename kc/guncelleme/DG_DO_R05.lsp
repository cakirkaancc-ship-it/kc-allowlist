            scale     (DT--hatch-scale)
            normal    (DT--plane-normal pts)
            ocsPts    (if normal (mapcar '(lambda (p) (trans p 0 normal)) pts) nil)
            elevation (if ocsPts (caddr (car ocsPts)) 0.0)
            n         (length ocsPts))
      (if (and normal (>= n 3))
        (progn
          (setq data
