(defun DGT_ORIG
  ( / blkEnt continue tmp s txtObj pageName sortedList
     scopeSel scopePolySS scopeBlkSS res )

  (deg-reset-session)
  (deg-clear-deg-done-xdata)
  (vl-load-com)
  (setq continue T)

  (while continue
    (setq *degDGScopePolySS* nil)
    (setq *degDGScopeBlkSS*  nil)

    (setq blkEnt (entsel "\nReferans polyline'ý seçin (ESC = bitir): "))
    (if (not blkEnt)
      (setq continue nil)
      (progn
        (setq tmp (car blkEnt))
        (setq s   (cadr blkEnt))
        (if (not (and tmp
                      (wcmatch (cdr (assoc 0 (entget tmp))) "LWPOLYLINE,POLYLINE")))
          (progn
            (setq continue nil)
            (princ "\n\nLütfen geçerli bir polyline seçin.")
          )
          (progn
            (princ "\nSonra alan seçin (polyline ve blocklar): ")
            (setq scopeSel (ssget '((0 . "LWPOLYLINE,POLYLINE,INSERT"))))

            (if (not scopeSel)
              (progn
                (setq continue nil)
                (princ "\n\nDGT bitti (alan seçilmedi).")
              )
              (progn
                (setq scopePolySS (DEG:SS-FILTER-BY-TYPE scopeSel "LWPOLYLINE,POLYLINE"))
                (setq scopeBlkSS  (DEG:SS-FILTER-BY-TYPE scopeSel "INSERT"))
                (setq scopeBlkSS  (DEG:SS-REMOVE-IGNORED-BLOCKS scopeBlkSS))

                (if (<= (DEG:SS-LEN scopePolySS) 0) (setq scopePolySS nil))
                (if (<= (DEG:SS-LEN scopeBlkSS) 0)  (setq scopeBlkSS  nil))

                (if (not scopePolySS) (setq scopePolySS (ssadd)))
                (if (and tmp (not (DEG:SS-CONTAINS-ENAME? scopePolySS tmp)))
                  (ssadd tmp scopePolySS)
                )

                (setq *degDGScopePolySS* scopePolySS)
                (setq *degDGScopeBlkSS*  scopeBlkSS)

                (setq txtObj   (vlax-ename->vla-object tmp))
                (setq pageName (deg-pt3 (deg-nearest-vertex txtObj s)))
                (if (not pageName) (setq pageName (deg-pt3 s)))
                (if (not pageName) (setq pageName (deg-pt3 (vlax-curve-getStartPoint txtObj))))
                (setq *degForceRefObj* txtObj)
                (setq *degForceRefPt*  pageName)

                ;; Sadece test/renk/tol çemberleri: popup/CSV/yol sorusu yok
                (setq res (vl-catch-all-apply 'deg-build-data (list T pageName)))

                (setq *degForceRefObj* nil)
                (setq *degForceRefPt*  nil)

                (if (vl-catch-all-error-p res)
                  (princ "\n\nDGT hata verdi; geçersiz nokta/içerik atlanarak iþlem durduruldu.")
                  (progn
                    (setq sortedList res)
                    (deg-color-ref-chain-white)
                  )
                )
              )
            )
          )
        )
      )
    )
  )

  (setq *degDGScopePolySS* nil)
  (setq *degDGScopeBlkSS*  nil)
  (princ)
)



(defun DEGDO--trim (s)
  (if s (vl-string-trim " \t\r\n" s) "")
)

(defun DEGDO--join-layers (lst / out)
  (foreach x lst
    (setq x (DEGDO--trim x))
    (if (and (/= x "") (not (member (norm-layer x) (mapcar 'norm-layer out))))
      (setq out (append out (list x)))
    )
  )
  (if out
    (apply 'strcat
      (cons (car out)
        (mapcar '(lambda (a) (strcat "," a)) (cdr out))
      )
    )
    ""
  )
)

(defun DEGDO--codes-merged (codes / out)
  (foreach c codes
    (setq out (append out (DEG:VAL-LIST c)))
  )
  (DEGDO--join-layers out)
)


(defun DEGDO--plan-e-line-layer-list (/ ss i ent ed lay ctab laytab out)
  ;; GstarCAD uyumu: DO acilirken ActiveX ile model taramasi yapma.
  (setq ctab (strcase (getvar "CTAB"))
        out  nil)
  (setq ss (ssget "_X" '((0 . "LINE,LWPOLYLINE,POLYLINE"))))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent (ssname ss i)
              ed  (entget ent)
              lay (cdr (assoc 8 ed))
              laytab (cdr (assoc 410 ed)))
        (if (and lay
                 (or (null laytab) (= (strcase laytab) ctab))
                 (wcmatch (strcase lay) "E_*")
                 (not (member (norm-layer lay) (mapcar 'norm-layer out))))
          (setq out (cons lay out))
        )
        (setq i (1+ i))
      )
    )
  )
  (if out
    (vl-sort out '(lambda (a b) (< (strcase a) (strcase b))))
    nil
  )
)
(defun DEGDO--plan-e-line-layers ()
  (DEGDO--join-layers (DEGDO--plan-e-line-layer-list))
)
