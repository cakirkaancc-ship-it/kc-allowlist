(defun deg-fire-flasher-filter (plLayer blkName blkLayer / L B BL)
  (setq L  (strcase plLayer)
        B  (strcase blkName)
        BL (strcase blkLayer))
  (cond
    ((DEGN-DN--match-list-p B (DEGN-DN--cfg-list-or-codes 'DN_FILTER_IGNORE_BLOCKS '(N1 K2 N2))) nil)

    ((DEGN-DN--match-list-p L (DEGN-DN--cfg-list-or-codes 'DN_FILTER_FIRE_LAYER_PATTERNS '(K11 K10 K9)))
     (not (DEGN-DN--match-list-p B (DEGN-DN--cfg-list-or-codes 'DN_FILTER_FIRE_BLOCK_EXCLUDES '(K13 K14 K15))))
    )

    ((DEGN-DN--match-list-p L (DEGN-DN--cfg-list-or-codes 'DN_FILTER_CO_LAYER_PATTERNS '(K8)))
     (DEGN-DN--match-list-p B (DEGN-DN--cfg-list-or-codes 'DN_FILTER_CO_BLOCKS '(K7)))
    )

    ((DEGN-DN--match-list-p L (DEGN-DN--cfg-list-or-codes 'DN_FILTER_FLASOR_LAYERS '(K1)))
     (DEGN-DN--match-list-p B (DEGN-DN--cfg-list-or-codes 'DN_FILTER_FLASOR_BLOCKS '(K12)))
    )

    ((DEGN-DN--match-list-p L (DEGN-DN--cfg-list-or-codes 'DN_FILTER_SOUND_LAYER_PATTERNS '(K13 K14 K15)))
     (DEGN-DN--match-list-p B (DEGN-DN--cfg-list-or-codes 'DN_FILTER_SOUND_BLOCK_PATTERNS '(K13 K14 K15)))
    )

    (T T)
  )
)




(setq *deg-grid-size* 2000.0) ;; hücre boyutu (ççizim birimi ile)

(defun deg--ifloor (x / i)
  (setq i (fix x))
  (if (and (< x 0.0) (/= x i)) (1- i) i)
)

(defun deg-cellkey (ix iy /) (list ix iy))

(defun deg-pt->cellkey (pt size / ix iy)
  (setq ix (deg--ifloor (/ (car pt) size)))
  (setq iy (deg--ifloor (/ (cadr pt) size)))
  (deg-cellkey ix iy)
)

(defun deg-grid-get (grid key / a)
  (setq a (assoc key grid))
  (if a (cdr a) nil)
)

(defun deg-grid-put (grid key obj / a lst)
  (setq a (assoc key grid))
  (if a
    (progn
      (setq lst (cdr a))
      (subst (cons key (cons obj lst)) a grid)
    )
    (cons (cons key (list obj)) grid)
  )
)

(defun deg-build-ref-grid (refInfos size / grid inf robj mn mx mnpt mxpt
                                   x0 x1 y0 y1 ix0 ix1 iy0 iy1 ix iy key)
  (setq grid '())
  (foreach inf refInfos
    (setq robj (car inf))
    (if (and robj (vlax-curve-p robj))
      (progn
        (vla-getBoundingBox robj 'mn 'mx)
        (setq mnpt (vlax-safearray->list mn)
              mxpt (vlax-safearray->list mx))
        (setq x0 (car mnpt) y0 (cadr mnpt)
              x1 (car mxpt) y1 (cadr mxpt))
        (setq ix0 (deg--ifloor (/ x0 size))
              ix1 (deg--ifloor (/ x1 size))
              iy0 (deg--ifloor (/ y0 size))
              iy1 (deg--ifloor (/ y1 size)))
        (setq ix ix0)
        (while (<= ix ix1)
          (setq iy iy0)
          (while (<= iy iy1)
            (setq key (deg-cellkey ix iy))
            (setq grid (deg-grid-put grid key robj))
            (setq iy (1+ iy))
          )
          (setq ix (1+ ix))
        )
      )
    )
  )
  grid
)

(defun deg-grid-candidates (grid pt size / key ix iy dx dy res lst h seen)
  (setq key (deg-pt->cellkey pt size))
  (setq ix (car key) iy (cadr key))
  (setq res '() seen '())
  (setq dx -1)
  (while (<= dx 1)
    (setq dy -1)
    (while (<= dy 1)
      (setq lst (deg-grid-get grid (deg-cellkey (+ ix dx) (+ iy dy))))
      (foreach obj lst
        (setq h (vlax-get obj 'Handle))
        (if (not (member h seen))
          (progn
            (setq seen (cons h seen))
            (setq res  (cons obj res))
          )
        )
      )
      (setq dy (1+ dy))
    )
    (setq dx (1+ dx))
  )
  res
)

(defun deg-touch-cp (plObj blkObj tol / insPt cp d)
  (setq insPt (deg-get-inspt blkObj))
  (setq cp    (deg-safe-closest-point plObj insPt))
  (setq d     (distance insPt cp))
  (if (<= d tol) (list cp d) nil)
)



