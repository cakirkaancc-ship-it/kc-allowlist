(defun deg-detect-ref-layer (blkRefObj / ss i ent obj layerName insPt candPt candD bestRefObj bestRefD)
  (vl-load-com)
  (setq ss (ssget "_X" '((0 . "LWPOLYLINE"))))
  (setq bestRefObj nil bestRefD nil)

  (if ss
    (progn
      (setq insPt (deg-get-inspt blkRefObj))
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent (ssname ss i)
              obj (vlax-ename->vla-object ent)
              layerName (norm-layer (vlax-get obj 'Layer)))

        (if (or (= layerName (DEG:VAL 'B2))
                (= layerName (DEG:VAL 'B4))
                (= layerName (DEG:VAL 'A3))
                (= layerName (DEG:VAL 'A5))
                (= layerName (DEG:VAL 'E3))
                (= layerName (DEG:VAL 'F4))
                (= layerName (DEG:VAL 'C3))
                (= layerName (DEG:VAL 'C7))
                (= layerName (DEG:VAL 'E5))
                (= layerName (DEG:VAL 'F2))
                (= layerName (DEG:VAL 'C8))
                (= layerName (DEG:VAL 'C4))
                (= layerName (DEG:VAL 'G2))
                (= layerName (DEG:VAL 'G4))
                (= layerName (DEG:VAL 'H2))
                (= layerName (DEG:VAL 'D4))
                (= layerName (DEG:VAL 'D3))
                (= layerName (DEG:VAL 'H4)))
          (progn
            (setq candPt (deg-safe-closest-point obj insPt))
            (if (deg-endpoint-touch? obj blkRefObj 50.0)
              (progn
                (setq candD (distance candPt insPt))
                (if (or (not bestRefD) (< candD bestRefD))
                  (progn
                    (setq bestRefD candD)
                    (setq bestRefObj obj)
                  )
                )
              )
            )
          )
        )
        (setq i (1+ i))
      )
    )
  )

  (if bestRefObj
    (norm-layer (vlax-get bestRefObj 'Layer))
    nil
  )
)

(defun deg-popup-results (sortedList title / msg cnt i row total v)
  (setq cnt (length sortedList))
  (setq total 0.0)
  (foreach row sortedList
    (setq v (nth 5 row))
    (if (numberp v) (setq total (+ total v)))
  )

  (setq msg (strcat title "\nSatýr: " (itoa cnt) "\n\n"))
  (setq i 0)
  (foreach row sortedList
    (if (< i 25)
      (progn
        (setq msg
          (strcat msg
                  (if (nth 0 row) (nth 0 row) "") " | "
                  (if (nth 1 row) (nth 1 row) "") " | "
                  (if (nth 5 row) (strcat (DEG:DP-LEN-STR (nth 5 row)) (if *degLastIsCCTV* " (m)" (strcat " " (DEG:LEN-UNIT-LABEL)))) (if *degLastIsCCTV* "0 (m)" (strcat "0 " (DEG:LEN-UNIT-LABEL))))
                  "\n"
          )
        )
        (setq i (1+ i))
      )
    )
  )
  (if (> cnt 25)
    (setq msg (strcat msg "\n... (" (itoa (- cnt 25)) " satýr daha)\n"))
    (setq msg (strcat msg "\n"))
  )

  (setq msg
    (strcat msg
            "==============================\n" "TOPLAM: " (DEG:DP-LEN-STR total) (if *degLastIsCCTV* " (m)" (strcat " " (DEG:LEN-UNIT-LABEL))) "\n" "==============================\n"
    )
  )
(DEG:WIN-MESSAGE msg)
)


