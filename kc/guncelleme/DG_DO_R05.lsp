(defun DEGP--data-report-single (sel / ent pickPt ed typ obj refPt selectedLayer scopeSel scopePolySS scopeBlkSS sortedList codeSnap oldDpDataMode)
  (setq ent    (car sel)
        pickPt (cadr sel)
        ed     (if ent (entget ent))
        typ    (cdr (assoc 0 ed)))
  (if (and ent typ
           (wcmatch typ "LWPOLYLINE,POLYLINE")
           (DEGP--data-layer-name-p (cdr (assoc 8 ed))))
    (progn
      (DEGP--reset-data-run-state)
      (setq selectedLayer (norm-layer (cdr (assoc 8 ed))))
      (setq *DEGP_DP_DATA_SELECTED_LAYER* selectedLayer)
      (princ "\nDP DATA: Alan secin (polyline ve blocklar): ")
      (setq scopeSel (ssget '((0 . "LWPOLYLINE,POLYLINE,INSERT"))))
      (if (not scopeSel)
        (progn
          (DEGP--reset-data-run-state)
          (princ "\n\nDP DATA iptal: alan secilmedi.")
          T
        )
        (progn
          (setq scopePolySS (DEG:SS-FILTER-BY-TYPE scopeSel "LWPOLYLINE,POLYLINE"))
          (setq scopeBlkSS  (DEG:SS-FILTER-BY-TYPE scopeSel "INSERT"))
          (if (<= (DEG:SS-LEN scopePolySS) 0) (setq scopePolySS nil))
          (if (<= (DEG:SS-LEN scopeBlkSS) 0)  (setq scopeBlkSS  nil))
          (if (not scopePolySS) (setq scopePolySS (ssadd)))
          (if (and ent (not (DEG:SS-CONTAINS-ENAME? scopePolySS ent)))
            (ssadd ent scopePolySS)
          )
          (setq obj   (vlax-ename->vla-object ent))
          (setq refPt (deg-safe-closest-point obj pickPt))
          (if (not refPt)
            (setq refPt (deg-nearest-vertex obj pickPt))
          )
          (setq *degDGScopePolySS* scopePolySS)
          (setq *degDGScopeBlkSS*  scopeBlkSS)
          (setq *degForceRefObj* obj)
          (setq *degForceRefPt*  refPt)
          (setq oldDpDataMode (if (boundp '*DEGP_DP_DATA_MODE*) *DEGP_DP_DATA_MODE* nil))
          (setq *DEGP_DP_DATA_MODE* T)
          (setq codeSnap (DEGP--data-code-snapshot))
          (DEGP--apply-data-code-overrides)
          (setq sortedList (vl-catch-all-apply 'deg-build-data (list nil refPt)))
          (DEGP--restore-data-code-snapshot codeSnap)
          (setq *DEGP_DP_DATA_MODE* oldDpDataMode)
          (setq *degForceRefObj* nil)
          (setq *degForceRefPt*  nil)
          (setq *degDGScopePolySS* nil)
          (setq *degDGScopeBlkSS*  nil)
          (if (vl-catch-all-error-p sortedList)
            (progn
              (princ (strcat "\nDP DATA hata: " (vl-catch-all-error-message sortedList)))
              (setq sortedList nil)
            )
          )
          (if sortedList
            (DEGP--popup-results-by-layer (deg-filter-out-kombine-rows sortedList) "DP - DATA Sonuclari")
            (DEG:WIN-MESSAGE "DP - DATA\nBu referans icin veri bulunamadi."))
          (DEGP--reset-data-run-state)
          T
        )
      )
    )
  )
)

