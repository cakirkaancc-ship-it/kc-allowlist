(defun DEGDO--dcl-safe (s)
  (if s (vl-string-translate (chr 34) "'" s) "")
)

(defun DEGDO--split-delim (s delim / txt pos part out dlen)
  (setq txt  (if s s "")
        dlen (strlen delim)
        out  nil)
  (while (/= txt "")
    (setq pos (vl-string-search delim txt))
    (if pos
      (progn
        (setq part (substr txt 1 pos))
        (setq txt (substr txt (+ pos dlen 1)))
      )
      (progn
        (setq part txt)
        (setq txt "")
      )
    )
    (setq out (append out (list part)))
  )
  out
)

(defun DEGDO--dp-e-values-alist (/ part pos layer val out)
  (foreach part (DEGDO--split-delim (DEG:CFG-GET 'DP_E_LINE_VALUES) "|")
    (setq pos (vl-string-search "=" part))
    (if pos
      (progn
        (setq layer (norm-layer (substr part 1 pos)))
        (setq val   (DEGDO--trim (substr part (+ pos 2))))
        (if (and (/= layer "") (/= val ""))
          (setq out (cons (cons layer val) out))
        )
      )
    )
  )
  (reverse out)
)

(defun DEGDO--dp-e-value-get (al layer / a)
  (if (setq a (assoc (norm-layer layer) al))
    (cdr a)
    ""
  )
)

(defun DEGDO--dp-e-values-pack (al / out p)
  (foreach p al
    (if (and (car p) (cdr p) (/= (DEGDO--trim (cdr p)) ""))
      (setq out (append out (list (strcat (norm-layer (car p)) "=" (DEGDO--trim (cdr p))))))
    )
  )
  (if out
    (apply 'strcat (cons (car out) (mapcar '(lambda (a) (strcat "|" a)) (cdr out))))
    ""
  )
)

(defun DEGP--layer-list-add-unique (layers lay / u)
  (setq u (norm-layer lay))
  (if (and (/= u "") (not (member u layers)))
    (setq layers (append layers (list u)))
  )
  layers
)

(defun DEGP--merge-layer-lists (a b / out lay)
  (setq out nil)
  (foreach lay (append a b)
    (setq out (DEGP--layer-list-add-unique out lay))
  )
  out
)

(defun DEGP--data-comb-like-layer-p (lay / u)
