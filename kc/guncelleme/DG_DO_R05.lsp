(defun g415_union_tubes_to_outline (tubePls lay / oldCm oldPe oldOsm oldCl beforeR regEnts ssReg beforeU uniEnts regU beforeX curves ssC beforeP newEnts cand best)
  (setq best nil)
  (if (null tubePls)
    nil
    (progn
      (setq oldCm (getvar "CMDECHO"))
      (setq oldPe (getvar "PEDITACCEPT"))
      (setq oldOsm (getvar "OSMODE"))
      (setq oldCl (getvar "CLAYER"))
      (setvar "CMDECHO" 0)
      (setvar "PEDITACCEPT" 1)
      (setvar "OSMODE" 0)

      (setq beforeR (entlast))
      (vl-cmdf "_.REGION" (g415_ss_from_list tubePls) "")
      (setq regEnts (g415_collect_new_ents beforeR))

      (if regEnts
        (progn
          (setq ssReg (g415_ss_from_list regEnts))
          (setq beforeU (entlast))
          (vl-cmdf "_.UNION" ssReg "")
          (setq uniEnts (g415_collect_new_ents beforeU))
          (if uniEnts
            (setq regU (car (last uniEnts)))
            (setq regU (entlast))
          )

          (if (and regU (entget regU))
            (progn
              (setq beforeX (entlast))
              (vl-cmdf "_.EXPLODE" regU)
              (setq curves (g415_collect_new_ents beforeX))

              (if curves
                (progn
                  (setq ssC (g415_ss_from_list curves))
                  (setq beforeP (entlast))
                  (setq oldPEDITACCEPT (getvar "PEDITACCEPT"))
                  (setvar "PEDITACCEPT" 1)
                  (vl-cmdf "_.PEDIT" "_M" ssC "" "_J" 0.0 "_C" "")
                  (setvar "PEDITACCEPT" oldPEDITACCEPT)
                  (g418_flush_cmd)
                  (setq newEnts (g415_collect_new_ents beforeP))
                  (setq cand (append curves newEnts))
                  (setq best (g415_pick_largest_closed_poly cand))
                  (if (null best)
                    (setq best (g415_pick_any_poly cand))
                  )
                  (if best
                    (progn
                      (g415_force_close_poly best)
                      (g415_delete_ents (vl-remove best cand))
                    )
                  )
                )
              )
            )
          )
        )
      )

      (g418_flush_cmd)
      (setvar "CMDECHO" oldCm)
      (setvar "PEDITACCEPT" oldPe)
      (setvar "OSMODE" oldOsm)
      (setvar "CLAYER" oldCl)

      best
    )
  )
)

(defun g417_take (lst n / out i)
  (setq out nil i 0)
  (while (and lst (< i n))
    (setq out (cons (car lst) out))
    (setq lst (cdr lst))
    (setq i (1+ i))
  )
  (reverse out)
)

(defun g417_nthcdr (n lst / i)
  (setq i 0)
  (while (and lst (< i n))
    (setq lst (cdr lst))
    (setq i (1+ i))
  )
  lst
)

(defun g417_rotate (lst k / a b)
  (if (or (null lst) (<= k 0))
    lst
    (progn
      (setq a (g417_nthcdr k lst))
      (setq b (g417_take lst k))
      (append a b)
    )
  )
)

(defun g417_set_nth (lst idx val / i out)
  (setq i 0 out nil)
  (while lst
    (setq out (cons (if (= i idx) val (car lst)) out))
    (setq lst (cdr lst))
    (setq i (1+ i))
  )
  (reverse out)
)

(defun g417_nearest_vertex (p pts / i bestI bestD d)
  (setq i 0 bestI 0 bestD 1e99)
  (while (< i (length pts))
    (setq d (distance p (nth i pts)))
    (if (< d bestD)
      (progn
        (setq bestD d)
        (setq bestI i)
      )
    )
    (setq i (1+ i))
  )
  (list bestI (nth bestI pts) bestD)
)

(defun g417_farthest_index (p pts / i bestI bestD d)
  (setq i 0 bestI 0 bestD -1.0)
  (while (< i (length pts))
    (setq d (distance p (nth i pts)))
    (if (> d bestD)
      (progn
        (setq bestD d)
        (setq bestI i)
      )
    )
    (setq i (1+ i))
  )
  bestI
)

(defun g417_lwpoly_parse (ed / pts bul sw ew curIdx pr code val)
  (setq pts nil bul nil sw nil ew nil curIdx -1)
  (while ed
    (setq pr (car ed))
    (setq code (car pr))
    (setq val (cdr pr))
    (cond
      ((= code 10)
        (setq pts (append pts (list (list (car val) (cadr val) 0.0))))
        (setq bul (append bul (list 0.0)))
        (setq sw  (append sw  (list nil)))
        (setq ew  (append ew  (list nil)))
        (setq curIdx (1- (length pts)))
      )
      ((and (>= curIdx 0) (= code 42))
        (setq bul (g417_set_nth bul curIdx val))
      )
      ((and (>= curIdx 0) (= code 40))
        (setq sw (g417_set_nth sw curIdx val))
      )
      ((and (>= curIdx 0) (= code 41))
        (setq ew (g417_set_nth ew curIdx val))
      )
    )
    (setq ed (cdr ed))
  )
  (list pts bul sw ew)
)

(defun g417_lwpoly_rebuild (pre pts bul sw ew / n i x y out)
  (setq n (length pts))
  (setq out nil)
  (while pre
    (if (= (car (car pre)) 90)
      (setq out (cons (cons 90 n) out))
      (setq out (cons (car pre) out))
    )
    (setq pre (cdr pre))
  )
  (setq out (reverse out))

  (setq i 0)
  (while (< i n)
    (setq x (car (nth i pts)))
    (setq y (cadr (nth i pts)))
    (setq out (append out (list (cons 10 (list x y)))))
    (if (nth i sw) (setq out (append out (list (cons 40 (nth i sw))))))
    (if (nth i ew) (setq out (append out (list (cons 41 (nth i ew))))))
    (if (and (nth i bul) (/= (nth i bul) 0.0))
      (setq out (append out (list (cons 42 (nth i bul)))))
    )
    (setq i (1+ i))
  )
  out
)

(defun g417_lwpoly_rotate_start (e k / ed pre rest parsed pts bul sw ew n pts2 bul2 sw2 ew2 newEd)
  (setq ed (entget e))
  (if (/= (cdr (assoc 0 ed)) "LWPOLYLINE")
    nil
    (progn
      (setq pre nil rest ed)
      (while (and rest (/= (car (car rest)) 10))
        (setq pre (append pre (list (car rest))))
        (setq rest (cdr rest))
      )
      (setq parsed (g417_lwpoly_parse ed))
      (setq pts (nth 0 parsed))
      (setq bul (nth 1 parsed))
      (setq sw  (nth 2 parsed))
      (setq ew  (nth 3 parsed))
      (setq n (length pts))
      (if (< n 3)
        nil
        (progn
          (setq k (rem k n))
          (if (< k 0) (setq k (+ k n)))
          (setq pts2 (g417_rotate pts k))
          (setq bul2 (g417_rotate bul k))
          (setq sw2  (g417_rotate sw k))
          (setq ew2  (g417_rotate ew k))
          (setq newEd (g417_lwpoly_rebuild pre pts2 bul2 sw2 ew2))
          (entmod newEd)
          (entupd e)
          T
        )
      )
    )
  )
)

(defun g417_move_outline_seam (outline pick mainPts / nearV outPts k)
  (if (and outline pick mainPts)
    (progn
      (if (= (cdr (assoc 0 (entget outline))) "LWPOLYLINE")
        (progn
          (setq nearV (g417_nearest_vertex pick mainPts))
          (setq outPts (g365_get_pts outline))
          (if (and outPts (>= (length outPts) 3))
            (progn
              (setq k (g417_farthest_index (cadr nearV) outPts))
              (g417_lwpoly_rotate_start outline k)
            )
          )
        )
      )
    )
  )
  T
)

(vl-load-com)

(defun DEGZ--ename (x)
  (cond
    ((= (type x) 'ENAME) x)
    ((= (type x) 'VLA-OBJECT) (vlax-vla-object->ename x))
    (t nil)
  )
)

(defun DEGZ--pt2d (p)
  (cond
    ((and (listp p) (>= (length p) 2)) (list (car p) (cadr p)))
    (t p)
  )
)

(defun DEGZ--pt3d (p)
  (setq p (DEGZ--pt2d p))
  (list (car p) (cadr p) 0.0)
)

(defun deg-safe-closest-point (crv pt / e r p2)
  (setq e (DEGZ--ename crv))
  (setq p2 (DEGZ--pt2d-safe pt nil))
  (if (or (not e) (not p2))
    p2
    (progn
      (setq r (vl-catch-all-apply 'vlax-curve-getClosestPointTo (list e (list (car p2) (cadr p2) 0.0))))
      (if (vl-catch-all-error-p r)
        p2
        (DEGZ--pt2d-safe r p2)
      )
    )
  )
)

(defun deg-safe-dist-at-point (crv pt / e cp r)
  (setq e  (DEGZ--ename crv))
  (if (not e)
    0.0
    (progn
      (setq cp (deg-safe-closest-point e pt))
      (if (not cp)
        0.0
        (progn
          (setq r  (vl-catch-all-apply 'vlax-curve-getDistAtPoint (list e (list (car cp) (cadr cp) 0.0))))
          (if (vl-catch-all-error-p r)
            0.0
            r
          )
        )
      )
    )
  )
)

(defun DEGZ--safe-props (e / ed pr)
  (setq e  (DEGZ--ename e))
  (setq ed (entget e))
  (setq pr (vl-remove nil (list (assoc 8 ed) (assoc 62 ed) (assoc 6 ed) (assoc 48 ed) (assoc 370 ed))))
  pr
)

(defun DEGZ--get-lwpts (e / ed pts x)
  (setq e  (DEGZ--ename e))
  (setq ed (entget e) pts '())
  (foreach x ed
    (if (= (car x) 10)
      (cond
        ((listp (cdr x)) (setq pts (append pts (list (DEGZ--pt2d (cdr x))))))
        ((and (listp x) (>= (length x) 3))
         (setq pts (append pts (list (list (cadr x) (caddr x))))))
      )
    )
  )
  pts
)

(defun DEGZ--entmakex-lwpoly (pts props closed70 / lst e)
  (if (null closed70) (setq closed70 0))
  (setq lst
    (append
      (list (cons 0 "LWPOLYLINE") (cons 100 "AcDbEntity"))
      props
      (list (cons 100 "AcDbPolyline") (cons 90 (length pts)) (cons 70 closed70))
      (apply 'append (mapcar '(lambda (p) (list (cons 10 (DEGZ--pt2d p)))) pts))
    )
  )
  (entmake lst)
  (setq e (entlast))
  e
)

(defun DEGZ--ensure-last (lst pt)
  (if (or (null lst) (> (distance (DEGZ--pt2d (last lst)) (DEGZ--pt2d pt)) 1e-6))
    (append lst (list (DEGZ--pt2d pt)))
    lst
  )
)

(defun DEGZ--unit (vx vy / l)
  (setq l (sqrt (+ (* vx vx) (* vy vy))))
  (if (> l 1e-12)
    (list (/ vx l) (/ vy l) l)
    (list 0.0 0.0 0.0)
  )
)


(defun DEGZ--perp-axis-from-curve (crv pt / obj par der dx dy)
  ;; ORTHO: curve tangent -> choose dominant axis, return perpendicular unit (rx ry)
  (setq obj (if (vlax-objectp crv) crv (vlax-ename->vla-object crv)))
  (setq par (vl-catch-all-apply 'vlax-curve-getParamAtPoint (list obj pt)))
  (if (vl-catch-all-error-p par)
    (progn
      (list 1.0 0.0)
    )
    (progn
      (setq der (vl-catch-all-apply 'vlax-curve-getFirstDeriv (list obj par)))
      (if (vl-catch-all-error-p der)
        (list 1.0 0.0)
        (progn
          (setq dx (car der) dy (cadr der))
          (if (>= (abs dx) (abs dy))
            (list 0.0 1.0)  ;; curve ~ horizontal -> perp is vertical
            (list 1.0 0.0)  ;; curve ~ vertical   -> perp is horizontal
          )
        )
      )
    )
  )
)

(defun DEGZ--curve-total (crv)
  (setq crv (DEGZ--ename crv))
  (if (not crv)
    0.0
    (vlax-curve-getDistAtParam crv (vlax-curve-getEndParam crv))
  )
)

(defun DEGZ--clamp (v a b)
  (cond ((< v a) a) ((> v b) b) (t v))
)

(defun DEGZ--direct-detour-order (blockSide a b ip ipRin / pa pb ia ib tmp sA sB)
  ;; Direkt/normal baglantida ana hat agzi, blok tarafindaki en yakin ucla eslessin.
  ;; Gecersiz nokta gelirse distance patlamasin; cagiran taraf baglantiyi atlar.
  (setq pa (if (and (listp a) (numberp (car a)) (numberp (cadr a))) (DEGZ--pt2d a) nil))
  (setq pb (if (and (listp b) (numberp (car b)) (numberp (cadr b))) (DEGZ--pt2d b) nil))
  (setq ia (if (and (listp ip) (numberp (car ip)) (numberp (cadr ip))) (DEGZ--pt2d ip) nil))
  (setq ib (if (and (listp ipRin) (numberp (car ipRin)) (numberp (cadr ipRin))) (DEGZ--pt2d ipRin) nil))
  (if (and pa pb ia ib)
    (progn
      (setq sA (+ (DEGZ--safe-distance pa ia) (DEGZ--safe-distance pb ib)))
      (setq sB (+ (DEGZ--safe-distance pa ib) (DEGZ--safe-distance pb ia)))
      (if (< sB sA)
        (progn
          (setq tmp ia)
          (setq ia ib)
          (setq ib tmp)
        )
      )
      (list pa pb ia ib)
    )
    nil
  )
)
(defun DEGZ--distpair10 (distMid dirSign maxDist half / d1 d2)
  ;; distMid etrafýnda ±half (toplam 2*half) olacak þekilde iki mesafe üretir.
  ;; Uçlarda (0 / maxDist) 10 birimi korumak için içeri kaydýrýr.
  (setq full (* 2.0 half))
  (setq d1 (- distMid (* half dirSign)))
  (setq d2 (+ distMid (* half dirSign)))

  ;; önce kaba clamp
  (setq d1 (DEGZ--clamp d1 0.0 maxDist))
  (setq d2 (DEGZ--clamp d2 0.0 maxDist))

  ;; eðer 10 birim bozulduysa, uca göre düzelt
  (if (< (abs (- d2 d1)) (- full 1e-3))
    (cond
      ;; baþlangýca çok yakýn
      ((< distMid half)
        (if (>= dirSign 0.0)
          (progn (setq d1 0.0) (setq d2 (DEGZ--clamp full 0.0 maxDist)))
          (progn (setq d2 0.0) (setq d1 (DEGZ--clamp full 0.0 maxDist)))
        )
      )
      ;; sona çok yakýn
      ((< (- maxDist distMid) half)
        (if (>= dirSign 0.0)
          (progn (setq d2 maxDist) (setq d1 (DEGZ--clamp (- maxDist full) 0.0 maxDist)))
          (progn (setq d1 maxDist) (setq d2 (DEGZ--clamp (- maxDist full) 0.0 maxDist)))
        )
      )
    )
  )

  (list d1 d2)
)

(defun DEGZ--closest-on-seg (a b p / ax ay bx by px py abx aby apx apy den tt cx cy dx dy)
  (setq a (DEGZ--pt2d a) b (DEGZ--pt2d b) p (DEGZ--pt2d p))
  (setq ax (car a) ay (cadr a))
  (setq bx (car b) by (cadr b))
  (setq px (car p) py (cadr p))
  (setq abx (- bx ax) aby (- by ay))
  (setq apx (- px ax) apy (- py ay))
  (setq den (+ (* abx abx) (* aby aby)))
  (if (< den 1e-12)
    (list a (+ (* apx apx) (* apy apy)))
    (progn
      (setq tt (/ (+ (* apx abx) (* apy aby)) den))
      (setq tt (DEGZ--clamp tt 0.0 1.0))
      (setq cx (+ ax (* tt abx)))
      (setq cy (+ ay (* tt aby)))
      (setq dx (- px cx))
      (setq dy (- py cy))
      (list (list cx cy) (+ (* dx dx) (* dy dy)))
    )
  )
)

(defun DEGZ--poly-closest-seg-index (pts p closed70 / n lim i a b res d2 bestI bestD)
  (setq pts (mapcar 'DEGZ--pt2d pts))
  (setq p (DEGZ--pt2d p))
  (setq n (length pts))
  (if (< n 2)
    0
    (progn
      (setq lim (if (/= (logand closed70 1) 0) n (1- n)))
      (setq i 0 bestI 0 bestD 1e99)
      (while (< i lim)
        (setq a (nth i pts))
        (setq b (nth (if (= i (1- n)) 0 (1+ i)) pts))
        (setq res (DEGZ--closest-on-seg a b p))
        (setq d2 (cadr res))
        (if (< d2 bestD)
          (progn (setq bestD d2) (setq bestI i))
        )
        (setq i (1+ i))
      )
      bestI
    )
  )
)

(defun DEGZ--poly-closest-on-seg (pts segIdx p closed70 / n a b res)
  (setq pts (mapcar 'DEGZ--pt2d pts))
  (setq p (DEGZ--pt2d p))
  (setq n (length pts))
  (if (< n 2)
    p
    (progn
      (setq a (nth segIdx pts))
      (setq b (nth (if (= segIdx (1- n)) 0 (1+ segIdx)) pts))
      (setq res (DEGZ--closest-on-seg a b p))
      (car res)
    )
  )
)

(defun DEGZ--cpE-side (crv cp join rx ry / e d tot pPlus pMin v1x v1y v2x v2y s1 s2 rPlus rMin)
  (setq e (DEGZ--ename crv))
  (setq cp (DEGZ--pt2d-safe cp nil))
  (if (or (not e) (not cp))
    cp
    (progn
      (setq d   (deg-safe-dist-at-point e cp))
      (setq tot (DEGZ--curve-total e))
      (setq rPlus (vl-catch-all-apply 'vlax-curve-getPointAtDist (list e (min tot (+ d join)))))
      (setq rMin  (vl-catch-all-apply 'vlax-curve-getPointAtDist (list e (max 0.0 (- d join)))))
      (setq pPlus (if (vl-catch-all-error-p rPlus) cp (DEGZ--pt2d-safe rPlus cp)))
      (setq pMin  (if (vl-catch-all-error-p rMin)  cp (DEGZ--pt2d-safe rMin  cp)))
      (if (and pPlus pMin)
        (progn
          (setq v1x (- (car pPlus) (car cp)))
          (setq v1y (- (cadr pPlus) (cadr cp)))
          (setq v2x (- (car pMin) (car cp)))
          (setq v2y (- (cadr pMin) (cadr cp)))
          (setq s1 (+ (* v1x rx) (* v1y ry)))
          (setq s2 (+ (* v2x rx) (* v2y ry)))
          (if (>= s1 s2) pPlus pMin)
        )
        cp
      )
    )
  )
)

(defun DEGZ--cpE-side-flag (crv cp join choosePlus / e d tot pPlus pMin rPlus rMin)
  (setq e (DEGZ--ename crv))
  (setq cp (DEGZ--pt2d-safe cp nil))
  (if (or (not e) (not cp))
    cp
    (progn
      (setq d   (deg-safe-dist-at-point e cp))
      (setq tot (DEGZ--curve-total e))
      (setq rPlus (vl-catch-all-apply 'vlax-curve-getPointAtDist (list e (min tot (+ d join)))))
      (setq rMin  (vl-catch-all-apply 'vlax-curve-getPointAtDist (list e (max 0.0 (- d join)))))
      (setq pPlus (if (vl-catch-all-error-p rPlus) cp (DEGZ--pt2d-safe rPlus cp)))
      (setq pMin  (if (vl-catch-all-error-p rMin)  cp (DEGZ--pt2d-safe rMin  cp)))
      (if choosePlus pPlus pMin)
    )
  )
)

(defun DEGZ--shorten-toward-cp (crv cp cpE short / e dcp dE tot dNew res)
  (setq e (DEGZ--ename crv))
  (setq cp  (DEGZ--pt2d-safe cp nil))
  (setq cpE (DEGZ--pt2d-safe cpE cp))
  (if (or (not e) (not cp) (not cpE))
    cpE
    (progn
      (setq dcp (deg-safe-dist-at-point e cp))
      (setq dE  (deg-safe-dist-at-point e cpE))
      (setq tot (DEGZ--curve-total e))
      (if (>= dE dcp)
        (setq dNew (max dcp (- dE short)))
        (setq dNew (min dcp (+ dE short)))
      )
      (setq res (vl-catch-all-apply 'vlax-curve-getPointAtDist (list e (DEGZ--clamp dNew 0.0 tot))))
      (if (vl-catch-all-error-p res)
        cpE
        (DEGZ--pt2d-safe res cpE)
      )
    )
  )
)

(defun DEGZ--insert-detour (crv attachA attachB midPts / e pts props pA pB tmp sIdx eIdx head tail k newPts firstPt lastPt keepScore revScore midNorm p)
  (setq e     (DEGZ--ename crv))
  (setq pts   (DEGZ--get-lwpts e))
  (setq props (DEGZ--safe-props e))

  (setq attachA (deg-safe-closest-point e attachA))
  (setq attachB (deg-safe-closest-point e attachB))

  (setq pA (vl-catch-all-apply 'vlax-curve-getParamAtPoint (list e (DEGZ--pt3d attachA))))
  (setq pB (vl-catch-all-apply 'vlax-curve-getParamAtPoint (list e (DEGZ--pt3d attachB))))
  (if (or (vl-catch-all-error-p pA) (vl-catch-all-error-p pB))
    crv
    (progn
      (if (> pA pB)
        (progn
          (setq tmp attachA attachA attachB attachB tmp)
          (setq tmp pA pA pB pB tmp)
        )
      )
      ;; midPts tek nokta ya da karisik liste gelebilir; sadece gercek noktalari kullan.
      (setq midNorm '())
      (cond
        ((null midPts)
          (setq midPts nil)
        )
        ((not (listp midPts))
          (setq midPts nil)
        )
        ((and (numberp (car midPts)) (numberp (cadr midPts)))
          (setq midPts (list (DEGZ--pt2d midPts)))
        )
        (T
          (foreach p midPts
            (if (and (listp p) (numberp (car p)) (numberp (cadr p)))
              (setq midNorm (append midNorm (list (DEGZ--pt2d p))))
            )
          )
          (setq midPts midNorm)
        )
      )

      ;; Polyline cizim yonu ters olsa bile agiz eslesmesi yakinliga gore kalsin.
      (if (and midPts (cdr midPts)
               (listp attachA) (numberp (car attachA)) (numberp (cadr attachA))
               (listp attachB) (numberp (car attachB)) (numberp (cadr attachB)))
        (progn
          (setq firstPt (DEGZ--pt2d (car midPts)))
          (setq lastPt  (DEGZ--pt2d (car (last midPts))))
          (setq keepScore (+ (distance (DEGZ--pt2d attachA) firstPt) (distance (DEGZ--pt2d attachB) lastPt)))
          (setq revScore  (+ (distance (DEGZ--pt2d attachA) lastPt)  (distance (DEGZ--pt2d attachB) firstPt)))
          (if (< revScore keepScore)
            (setq midPts (reverse midPts))
          )
        )
      )

      (setq sIdx (fix pA))
      (setq eIdx (fix pB))

      (setq head '() k 0)
      (while (<= k sIdx)
        (setq head (append head (list (nth k pts))))
        (setq k (1+ k))
      )
      (setq head (DEGZ--ensure-last head attachA))

      (setq tail '() k (1+ eIdx))
      (while (< k (length pts))
        (setq tail (append tail (list (nth k pts))))
        (setq k (1+ k))
      )

      (setq newPts (append head (mapcar 'DEGZ--pt2d midPts) (list attachB) tail))

      (entdel e)
      (DEGZ--entmakex-lwpoly newPts props 0)
    )
  )
)

(defun DEGZ--block-effective-name (en / vla nm ed)
  (setq en (DEGZ--ename en))
  (if (not en)
    nil
    (progn
      (setq ed (entget en))
      (setq nm (cdr (assoc 2 ed)))
      (if (and nm (= (substr nm 1 1) "*"))
        (progn
          (setq vla (vlax-ename->vla-object en))
          (if (vlax-property-available-p vla 'EffectiveName)
            (setq nm (vla-get-EffectiveName vla))
          )
        )
      )
      nm
    )
  )
)

(defun DEGZ--skip-block-p (blk / nm nmU)
  (setq nm  (DEGZ--block-effective-name blk))
  (setq nmU (strcase (if nm nm "")))
  (if (or (vl-string-search "FLASOR" nmU)
          (vl-string-search "FLAR"   nmU))
    T
    nil
  )
)

(defun DEGZ--floor (x)
  (if (>= x 0.0) (fix x) (1- (fix x)))
)

(defun DEGZ--cellkey (p cell / cx cy)
  (setq p (DEGZ--pt2d p))
  (setq cx (DEGZ--floor (/ (car p) cell)))
  (setq cy (DEGZ--floor (/ (cadr p) cell)))
  (list cx cy)
)

(defun DEGZ--cells-put (cells key val / rec)
  (if (setq rec (assoc key cells))
    (subst (cons key (cons val (cdr rec))) rec cells)
    (cons (list key val) cells)
  )
)

(defun DEGZ--uf-init (parents x)
  (if (assoc x parents) parents (cons (cons x x) parents))
)

(defun DEGZ--uf-find (parents x / p)
  (setq p (cdr (assoc x parents)))
  (if (null p) x
    (progn
      (while (and p (not (equal p x)))
        (setq x p)
        (setq p (cdr (assoc x parents)))
      )
      x
    )
  )
)

(defun DEGZ--uf-union (parents a b / ra rb rec)
  (setq ra (DEGZ--uf-find parents a))
  (setq rb (DEGZ--uf-find parents b))
  (if (not (equal ra rb))
    (progn
      (setq rec (assoc rb parents))
      (if rec
        (setq parents (subst (cons rb ra) rec parents))
        (setq parents (cons (cons rb ra) parents))
      )
    )
  )
  parents
)

(defun DEGZ--groups-build (parents data / groups blk rep r rec)
  (setq groups '())
  (foreach rec data
    (setq blk (car rec))
    (setq rep (DEGZ--uf-find parents blk))
    (if (setq r (assoc rep groups))
      (setq groups (subst (cons rep (cons rec (cdr r))) r groups))
      (setq groups (cons (list rep rec) groups))
    )
  )
  groups
)

(defun DEGZ--perp-axis-from-curve-safe (crv pt / tan tx ty)
  ;; ActiveX belge nesnesine ihtiyac duymadan yerel tegetten baskin dik ekseni al.
  ;; AutoCAD Core Console ve GStarCAD'de de ayni sonucu verir.
  (setq tan (DEGZ--canonical-tangent-at crv pt)
        tx (car tan)
        ty (cadr tan))
  (if (>= (abs tx) (abs ty))
    (list 0.0 1.0)
    (list 1.0 0.0))
)

(defun DEGZ--choosePlus-main (mainCrv ip cp join / vvx vvy uu dx dy rx ry rperp cpE d tot pPlus)
  (setq ip (DEGZ--pt2d ip))
  (setq cp (DEGZ--pt2d cp))

  (setq vvx (- (car ip) (car cp)))
  (setq vvy (- (cadr ip) (cadr cp)))
  (setq uu (DEGZ--unit vvx vvy))
  (setq dx (car uu) dy (cadr uu))

  (setq rperp (DEGZ--perp-axis-from-curve-safe mainCrv cp))
              (setq rx (car rperp))
              (setq ry (cadr rperp))

  (setq cpE (DEGZ--cpE-side mainCrv cp join rx ry))

  (setq d   (deg-safe-dist-at-point mainCrv cp))
  (setq tot (DEGZ--curve-total mainCrv))
  (setq pPlus (DEGZ--pt2d (vlax-curve-getPointAtDist (DEGZ--ename mainCrv) (min tot (+ d join)))))

  (if (<= (distance cpE pPlus) 1e-6) T nil)
)

(defun DEGZ--point-toward (a b dist / a2 b2 vx vy uu)
  (setq a2 (DEGZ--pt2d a))
  (setq b2 (DEGZ--pt2d b))
  (setq vx (- (car b2) (car a2)))
  (setq vy (- (cadr b2) (cadr a2)))
  (setq uu (DEGZ--unit vx vy))
  (if (> (caddr uu) 1e-12)
    (list (+ (car a2) (* (car uu) dist)) (+ (cadr a2) (* (cadr uu) dist)))
    a2
  )
)

(defun DEGZ--calc-L-corner (S B uPerp / S2 B2 c1 c2 d1 d2)
  ;; ORTHO KÖÞE: Baðlantýlar sadece 0/90/180/270 olacak þekilde,
  ;; S -> corner -> B iki eksenli (yatay/dikey) kýrýlým üretir.
  (setq S2 (DEGZ--pt2d S))
  (setq B2 (DEGZ--pt2d B))

  ;; Ýki olasý L köþe
  (setq c1 (list (car S2) (cadr B2))) ; önce dikey, sonra yatay
  (setq c2 (list (car B2) (cadr S2))) ; önce yatay, sonra dikey

  ;; S'den daha kýsa ilk bacaðý seç
  (setq d1 (distance S2 c1))
  (setq d2 (distance S2 c2))
  (if (<= d1 d2) c1 c2)
)


(defun DEGZ--ortho-first-axis (ip cp / dx dy)
  ;; T => once X, NIL => once Y
  (setq dx (abs (- (car ip) (car cp))))
  (setq dy (abs (- (cadr ip) (cadr cp))))
  (< dx dy)
)

(defun DEGZ--axis-horiz-at (crv cp / e prm der dx dy)
  ;; Ana hattin tangent yonune gore yatay mi (T) dikey mi (NIL)
  (setq e (DEGZ--ename crv))
  (if (not e)
    T
    (progn
      (setq prm (vl-catch-all-apply 'vlax-curve-getParamAtPoint (list e (DEGZ--pt3d cp))))
      (if (vl-catch-all-error-p prm)
        T
        (progn
          (setq der (vl-catch-all-apply 'vlax-curve-getFirstDeriv (list e prm)))
          (if (vl-catch-all-error-p der)
            T
            (progn
              (setq dx (abs (car der)))
              (setq dy (abs (cadr der)))
              (>= dx dy)
            )
          )
        )
      )
    )
  )
)

;; Ana hattin yonunu, cp noktasinin hemen ilerisinden/gerisinden (choosePlus) örnekleyerek bulur.
;; Köþe (vertex) üstünde derivative belirsiz kaldýðýnda, ilk kolun gerçekten ana hat hizasýnda
;; baþlamasý için kullanýlýr.
(defun DEGZ--axis-horiz-at2 (crv cp choosePlus / e prm dist maxDist dist2 p2 vx vy)
  (setq e (DEGZ--ename crv))
  (if (not e)
    T
    (progn
      (setq prm (vl-catch-all-apply 'vlax-curve-getParamAtPoint (list e (DEGZ--pt3d cp))))
      (if (vl-catch-all-error-p prm)
        (DEGZ--axis-horiz-at crv cp)
        (progn
          (setq dist    (vlax-curve-getDistAtParam e prm))
          (setq maxDist (vlax-curve-getDistAtParam e (vlax-curve-getEndParam e)))
          ;; 1.0 birimlik örnekleme, köþe noktalarýnda yönü netleþtirir
          (setq dist2 (if choosePlus (+ dist 1.0) (- dist 1.0)))
          (setq dist2 (DEGZ--clamp dist2 0.0 maxDist))
          (setq p2 (DEGZ--pt2d (vlax-curve-getPointAtDist e dist2)))
          (setq vx (- (car p2) (car cp)))
          (setq vy (- (cadr p2) (cadr cp)))
          (if (and (< (abs vx) 1e-6) (< (abs vy) 1e-6))
            (DEGZ--axis-horiz-at crv cp)
            (>= (abs vx) (abs vy))
          )
        )
      )
    )
  )
)

(defun DEGZ--perp-axis-from-curve (crv pt / prm deriv tx ty)
  ;; ORTHO için ana hattýn tangent yönüne göre (x/y) eksen-perp döndürür.
  ;; dönüþ: (rx ry) birim vektör (mutlak eksen), iþaret sideFact ile verilir.
  (setq prm (vlax-curve-getParamAtPoint (DEGZ--ename crv) (DEGZ--pt3d pt)))
  (setq deriv (vlax-curve-getFirstDeriv (DEGZ--ename crv) prm))
  (setq tx (car deriv) ty (cadr deriv))
  (if (> (abs tx) (abs ty))
    (list 0.0 1.0)   ;; tangent yatay => perp dikey
    (list 1.0 0.0)   ;; tangent dikey => perp yatay
  )
)

(defun DEGZ--calc-L-corner-mode (S B mode / S2 B2)
  ;; ORTHO KÖÞE (MODLU): mode = 'vfirst veya 'hfirst
  ;; vfirst: (Sx, By)  -> önce dikey, sonra yatay
  ;; hfirst: (Bx, Sy)  -> önce yatay, sonra dikey
  (setq S2 (DEGZ--pt2d S))
  (setq B2 (DEGZ--pt2d B))
  (if (= mode 'vfirst)
    (list (car S2) (cadr B2))
    (list (car B2) (cadr S2))
  )
)
(defun DEGZ--lmode-along-main (cpA cpB / a b dx dy)
  ;; ORTHO zorlanan yerlerde ilk bacak her zaman ana hat hizasinda olsun:
  ;; cpA->cpB vektoru ana hattin tangent eksenini temsil eder.
  ;; yatay => 'hfirst (ilk bacak yatay), dikey => 'vfirst (ilk bacak dikey)
  (setq a (DEGZ--pt2d cpA))
  (setq b (DEGZ--pt2d cpB))
  (setq dx (abs (- (car b) (car a))))
  (setq dy (abs (- (cadr b) (cadr a))))
  (if (>= dx dy) 'hfirst 'vfirst)
)

;; ORTHO zorlanan baglantilarda ana hat hizasini secmek icin:
;; cpCur noktasinda egri uzerinde iki yonde (once/sonra) kucuk bir ornek alinir.
;; Blok vektoru ile daha iyi hizalanan yon secilir; bu sayede cpCur bir vertex uzerindeyken
;; "yanlis segment" baz alinmaz (blok sag/ustte kalinca gorulen bozulma).
(defun DEGZ--lmode-along-main-at (crv cpCur ip / e cp b d len eps d1 d2 p1 p2 v1 v2 vt dot1 dot2 vx vy)
  (setq e (DEGZ--ename crv))
  (setq cp (DEGZ--pt2d cpCur))
  (setq b  (DEGZ--pt2d ip))
  (setq vt (list (- (car b) (car cp)) (- (cadr b) (cadr cp)) 0.0))

  ;; dist clamp
  (setq d   (vlax-curve-getDistAtPoint e cp))
  (setq len (vlax-curve-getDistAtParam e (vlax-curve-getEndParam e)))
  (setq eps 1.0)
  (setq d1 (max 0.0 (- d eps)))
  (setq d2 (min len (+ d eps)))
  (setq p1 (DEGZ--pt2d (vlax-curve-getPointAtDist e d1)))
  (setq p2 (DEGZ--pt2d (vlax-curve-getPointAtDist e d2)))

  ;; v1: p1->cp, v2: cp->p2
  (setq v1 (list (- (car cp) (car p1)) (- (cadr cp) (cadr p1)) 0.0))
  (setq v2 (list (- (car p2) (car cp)) (- (cadr p2) (cadr cp)) 0.0))

  (setq dot1 (abs (+ (* (car v1) (car vt)) (* (cadr v1) (cadr vt)))))
  (setq dot2 (abs (+ (* (car v2) (car vt)) (* (cadr v2) (cadr vt)))))

  (if (>= dot2 dot1)
    (progn (setq vx (car v2)) (setq vy (cadr v2)))
    (progn (setq vx (car v1)) (setq vy (cadr v1)))
  )

  (if (> (abs vx) (abs vy)) 'hfirst 'vfirst)
)

(defun DEGZ--canonical-tangent-at (crv pt / e prm der ln tx ty)
  ;; Polyline cizim yonunden bagimsiz yerel teget: +X, dikeyde +Y yonune sabitlenir.
  (setq e (DEGZ--ename crv))
  (if (not e)
    (list 1.0 0.0)
    (progn
      (setq prm
        (vl-catch-all-apply
          'vlax-curve-getParamAtPoint
          (list e (DEGZ--pt3d (deg-safe-closest-point e pt)))
        )
      )
      (if (vl-catch-all-error-p prm)
        (list 1.0 0.0)
        (progn
          (setq der (vl-catch-all-apply 'vlax-curve-getFirstDeriv (list e prm)))
          (if (or (vl-catch-all-error-p der) (not (listp der)))
            (list 1.0 0.0)
            (progn
              (setq ln (sqrt (+ (* (car der) (car der)) (* (cadr der) (cadr der)))))
              (if (<= ln 1e-12)
                (list 1.0 0.0)
                (progn
                  (setq tx (/ (car der) ln)
                        ty (/ (cadr der) ln))
                  (if (or (< tx -1e-10)
                          (and (<= (abs tx) 1e-10) (< ty 0.0)))
                    (setq tx (- tx) ty (- ty))
                  )
                  (list tx ty)
                )
              )
            )
          )
        )
      )
    )
  )
)

(defun DEGZ--local-side-factor (crv pt dx dy rx ry / tan tx ty nx ny dotT dotN refx refy)
  ;; Egik hatta WCS RIGHT/TOP esigi yerine ana hattin yerel eksenini kullan.
  ;; Baglanti ana hatta paralelse ofset +yerel normale, dikse -yerel tegete bakar.
  (setq tan (DEGZ--canonical-tangent-at crv pt)
        tx (car tan)
        ty (cadr tan)
        nx (- ty)
        ny tx
        dotT (+ (* dx tx) (* dy ty))
        dotN (+ (* dx nx) (* dy ny)))
  (if (>= (abs dotT) (abs dotN))
    (setq refx nx refy ny)
    (setq refx (- tx) refy (- ty))
  )
  (if (>= (+ (* rx refx) (* ry refy)) 0.0) 1.0 -1.0)
)

(defun DEGZ--APPLY (crv0 ss / crv i blk ip blk2 ip2
               ptsMain propsMain mainTmp mainClosed guideCrv
               joinCand short shift approach
               vvx vvy uu dx dy len rx ry ipRin
               nearLim mainFarLim mergeOff
               cell cells
               parents data
               groups
               forcedReps sideMap segMap
               anchorMap stemMap  remoteMap mergeMap
               dirMap dirRec udir mdx mdy p1 ipb p1b pJoin stemRec stemA stemB cpSec pStep pStepb
               g rep recs r bestRec bestIp bestD dNow segIdx choosePlus
               procData anchorRec remote
               forceMain isAnchor cpMain cpCur cpE cpEshort
               uTan uPerp corner1 corner2 paramCur distEnds
               pDown pDownRin uDirRemote anchorStemDir
               key cx cy ix iy rec item mergePt isTargetSide
               sX sY sideFact 
               ipAvg pMid paramMid deriv Tlen Tx Ty Lx Ly dotProd dirSign distMid distDown distDownRin maxDist
               pMerge pMergeRin pLeft pRight ipLeft ipRight pMainTop pMainBot ipTop ipBot yTop yBot pTopA pBotA pTopB pBotB pTopDrop pBotDrop scoreA scoreB outsideLeft fromTop sideMode shortIp longIp calcCrv)

  (vl-load-com)

  (setq joinCand 20.0)
  (setq short    10.0)
  (setq shift    10.0)
  (setq approach 10.0)

  (setq nearLim    100.0)
  (setq mainFarLim 200.0)
  (setq mergeOff   50.0)

  (setq crv0 (DEGZ--ename crv0))

  (if (not (and crv0 (entget crv0)))
    (progn (princ "\nDZ: Gecersiz polyline.") (princ))
    (if (not (and ss (= (type ss) 'PICKSET) (> (sslength ss) 0)))
      (progn (princ "\nDZ: Block secimi yok.") (princ))
      (progn

        (setq ptsMain   (DEGZ--get-lwpts crv0))
        (setq propsMain (DEGZ--safe-props crv0))
        (setq mainClosed (cdr (assoc 70 (entget crv0))))
        (if (null mainClosed) (setq mainClosed 0))
        (setq mainClosed (if (/= (logand mainClosed 1) 0) 1 0))
        (setq mainTmp   (DEGZ--entmakex-lwpoly ptsMain propsMain mainClosed))

        (setq cell    nearLim)
        (setq cells   '())
        (setq parents '())
        (setq data    '())

        (setq i 0)
        (while (< i (sslength ss))
          (setq blk (ssname ss i))
          (if (not (DEGZ--skip-block-p blk))
            (progn
              (setq ip (DEGZ--pt2d (cdr (assoc 10 (entget blk)))))

              (setq parents (DEGZ--uf-init parents blk))
              (setq data (append data (list (list blk ip))))

              (setq key (DEGZ--cellkey ip cell))
              (setq cx (car key) cy (cadr key))

              (setq ix -1)
              (while (<= ix 1)
                (setq iy -1)
                (while (<= iy 1)
                  (setq rec (assoc (list (+ cx ix) (+ cy iy)) cells))
                  (if rec
                    (foreach item (cdr rec)
                      (setq blk2 (car item))
                      (setq ip2  (cadr item))
                      (if (and blk2 ip2 (<= (distance ip ip2) nearLim))
                        (setq parents (DEGZ--uf-union parents blk blk2))
                      )
                    )
                  )
                  (setq iy (1+ iy))
                )
                (setq ix (1+ ix))
              )

              (setq cells (DEGZ--cells-put cells (list cx cy) (list blk ip)))
            )
          )
          (setq i (1+ i))
        )

        (setq groups (DEGZ--groups-build parents data))

        (setq forcedReps '())
        (setq sideMap    '())
        (setq segMap     '())
        (setq anchorMap  '())
        (setq stemMap    '())
        (setq remoteMap  '())
        (setq mergeMap   '())
        (setq dirMap     '())

        (foreach g groups
          (setq rep  (car g))
          (setq recs (cdr g))

          (setq bestRec nil)
          (setq bestD   1e99)
          (foreach r recs
            (setq ip (cadr r))
            (setq cpMain (deg-safe-closest-point mainTmp ip))
            (setq dNow (distance (DEGZ--pt2d ip) (DEGZ--pt2d cpMain)))
            (if (< dNow bestD)
              (progn (setq bestD dNow) (setq bestRec r))
            )
          )
          (if (null bestRec) (setq bestRec (car recs)))
          (setq bestIp (cadr bestRec))
          (setq anchorMap (cons (cons rep bestRec) anchorMap))

          (setq cpMain (deg-safe-closest-point mainTmp bestIp))
          (setq stemMap (cons (cons rep (list (DEGZ--pt2d bestIp) (DEGZ--pt2d cpMain))) stemMap))
          (setq choosePlus (DEGZ--choosePlus-main mainTmp bestIp cpMain joinCand))
          (setq sideMap (cons (cons rep choosePlus) sideMap))
          (setq segIdx (DEGZ--poly-closest-seg-index ptsMain bestIp mainClosed))
          (setq segMap (cons (cons rep segIdx) segMap))

          (if (> (length recs) 1)
            (progn
              (if (> bestD mainFarLim)
                (progn
                  (setq remoteMap (cons (cons rep T) remoteMap))
                  (setq mergePt (DEGZ--point-toward bestIp cpMain mergeOff))
                  (setq mergeMap (cons (cons rep mergePt) mergeMap))

                  (setq udir (DEGZ--unit (- (car bestIp) (car cpMain)) (- (cadr bestIp) (cadr cpMain))))
                  (setq dirMap (cons (cons rep (list (car udir) (cadr udir))) dirMap))
                )
                (progn
                  (setq remoteMap (cons (cons rep nil) remoteMap))
                  (setq forcedReps (cons rep forcedReps))
                )
              )
            )
            (setq remoteMap (cons (cons rep nil) remoteMap))
          )
        )

        (setq procData '())
        (foreach g groups
          (setq rep  (car g))
          (setq recs (cdr g))
          (setq remote (cdr (assoc rep remoteMap)))
          (if (and remote (> (length recs) 1))
            (progn
              (setq anchorRec (cdr (assoc rep anchorMap)))
              (setq procData (append procData (list anchorRec)))
              (foreach r recs
                (if (not (equal (car r) (car anchorRec)))
                  (setq procData (append procData (list r)))
                )
              )
            )
            (setq procData (append procData recs))
          )
        )

        (setq crv crv0)

        (foreach rec procData
          (setq blk (car rec))
          (setq ip  (cadr rec))

          (setq rep (DEGZ--uf-find parents blk))
          (setq choosePlus (cdr (assoc rep sideMap)))
          (if (null choosePlus) (setq choosePlus T))
          (setq remote (cdr (assoc rep remoteMap)))

          (setq anchorRec (cdr (assoc rep anchorMap)))
          (setq isAnchor (and remote anchorRec (equal blk (car anchorRec))))
          (setq forceMain (if (member rep forcedReps) T nil))

          (cond
            (forceMain
              (progn
                (setq segIdx (cdr (assoc rep segMap)))
                (if (null segIdx) (setq segIdx 0))
                (setq cpMain (DEGZ--poly-closest-on-seg ptsMain segIdx ip mainClosed))
              )
            )
            (remote
              (if isAnchor
                (progn
                  (setq segIdx (cdr (assoc rep segMap)))
                  (if (null segIdx) (setq segIdx 0))
                  (setq cpMain (DEGZ--poly-closest-on-seg ptsMain segIdx ip mainClosed))
                )
                (progn
                  (setq cpMain (deg-safe-closest-point mainTmp ip))
                )
              )
            )
            (T (setq cpMain (deg-safe-closest-point mainTmp ip)))
          )

          (setq cpCur (deg-safe-closest-point crv cpMain))

          (setq ip     (DEGZ--pt2d ip))
          (setq cpMain (DEGZ--pt2d cpMain))
          (setq cpCur  (DEGZ--pt2d cpCur))

          (setq vvx (- (car ip) (car cpMain)))
          (setq vvy (- (cadr ip) (cadr cpMain)))
          
          (setq orthoForced (and (> (abs vvx) 1e-6) (> (abs vvy) 1e-6)))
(setq shiftBlk (if orthoForced 10.0 shift))

;; ORTHO zorlamasi (diag) durumunda dx/dy eksenini sabitle:
;; - Bloktan ana hatta en kisa eksen (X veya Y) secilir.
;; - Böylece shiftBlk=10.0 gercekten 10 olarak kalir (capraz unit ile bozulmaz).
(if orthoForced
  (progn
    (setq firstX (>= (abs vvx) (abs vvy)))
    (setq dx (if firstX (if (>= vvx 0.0) 1.0 -1.0) 0.0))
    (setq dy (if firstX 0.0 (if (>= vvy 0.0) 1.0 -1.0)))
    (setq len 100.0)
  )
  (progn
    (setq uu (DEGZ--unit vvx vvy))
    (setq dx (car uu) dy (cadr uu) len (caddr uu))
  )
)

          (if (and remote (not isAnchor))
            (progn
              (setq uDirRemote (cdr (assoc rep dirMap)))
              (setq dx (car uDirRemote))
              (setq dy (cadr uDirRemote))
              (setq len 100.0)
            )
          )

          (if (> len 1e-9)
            (progn
              (setq rx dy)
              (setq ry (- dx))

              ;; =========================================================
              ;; 1. BLOK BACAK YONU VE TARAF KONTROLU (HERKES ICIN)
              ;; =========================================================
              (setq isTargetSide (or (> dy 1e-4) (< dx -1e-4)))
              (setq sideFact (if isTargetSide -1.0 1.0))

              ;; Sol/Ust taraf ise bacaklari ters yone cevir
              (setq ipRin
                (list
                  (+ (car ip) (* rx shiftBlk sideFact))
                  (+ (cadr ip) (* ry shiftBlk sideFact))
                )
              )
              (setq ipRin
                 (list 
                   (- (car ipRin) (* dx approach))
                   (- (cadr ipRin) (* dy approach))
                 )
              )
              
              ;; cpE noktasini da tarafa gore duzelt (Referans icin)
              (setq rx (* rx sideFact))
              (setq ry (* ry sideFact))

              ;; Remote + anchor + sol/ust ise ANA HAT UZERINDEKI CIKIS VERTEX'INI OBUR TARAFA AL
              ;; (blok bacagi/yonu degismez, sadece ana hatta degdigi taraf degisir)
              (if (and remote isAnchor isTargetSide)
                (setq choosePlus (if choosePlus nil T))
              )

              (if (or forceMain remote)
                (setq cpE (DEGZ--cpE-side-flag crv cpCur joinCand choosePlus))
                (setq cpE (DEGZ--cpE-side      crv cpCur joinCand rx ry))
              )
              (setq cpCur (DEGZ--pt2d-safe cpCur cpMain))
              (setq cpE   (DEGZ--pt2d-safe cpE cpCur))
              (if (and cpCur cpE)
                (setq cpEshort (DEGZ--shorten-toward-cp crv cpCur cpE (min short (* (distance cpCur cpE) 0.45))))
                (setq cpEshort cpCur)
              )
              (setq cpEshort (DEGZ--pt2d-safe cpEshort cpCur))

              (if (and cpCur cpEshort (> (distance cpCur cpEshort) 1e-4))
                (progn
                  
                  (if (and remote (not isAnchor))
                     ;; =====================================================
                     ;; DURUM A: UZAK BLOKLAR (REMOTE) -> L-SHAPE / MERGE
                     ;; =====================================================
                     ;; * Bu bloklar komsu hattina baglanmali (Merge).
                     ;; * Hesaplamalar 'crv' (islenmis hat) uzerinde yapilmali.
                     (progn
                       ;; pMerge: ip'den mergeOff kadar asagi
                       (setq pMerge
                        (list
                          (+ (car ip) (* (- dx) mergeOff))
                          (+ (cadr ip) (* (- dy) mergeOff))
                        )
                       )
                       ;; pMergeRin: ipRin hizasinda
                       (setq pMergeRin
                        (list
                          (+ (car pMerge) (- (car ipRin) (car ip)))
                          (+ (cadr pMerge) (- (cadr ipRin) (cadr ip)))
                        )
                       )
                       
                       ;; Ana hat uzerindeki noktalar (Mevcut 'crv' uzerinden alinir)
                       (setq cpCur    (deg-safe-closest-point crv pMerge))
                       (setq cpEshort (deg-safe-closest-point crv pMergeRin))
                       
                       ;; Baglanti: pMerge noktalarini kullan (L Sekli)
                       ;; ACI ZORLANAN (ORTHO) DURUMDA:
                       ;; Ilk kolu her zaman "ana hat hizasinda" baslatmak icin, cpCur noktasinda
                       ;; egri uzerinde iki yonde orneklenir ve bloða dogru daha iyi hizalanan
                       ;; segmentin ekseni secilir (vertex ustu sapmalari engeller).
                       (if orthoForced
                         (setq lmode (DEGZ--lmode-along-main-at crv cpCur ip))
                         (progn
                           (setq firstX (DEGZ--ortho-first-axis ip cpCur))
                           (setq lmode (if firstX 'hfirst 'vfirst))
                         )
                       )

                       (setq corner1 (DEGZ--calc-L-corner-mode cpCur    ip   lmode))
                       (setq corner2 (DEGZ--calc-L-corner-mode cpEshort ipRin lmode))

                       (setq crv (DEGZ--insert-detour crv cpCur cpEshort (list corner1 ip ipRin corner2)))
                     )
                     
                     ;; =====================================================
                     ;; DURUM B: YAKIN BLOKLAR (DIRECT CONNECT)
                     ;; =====================================================
                     ;; * Bu bloklar DIREKT ana hatta baglanmali.
                     ;; * Komsunun bacagina YAPISMAMALI.
                     ;; * Bu yuzden referans olarak 'mainTmp' (Temiz Hat) kullanilmali.
                     (progn
                        (if (and remote isAnchor)
                            ;; Anchor ozel durumu (Pahli Baglanti)
                            (progn
                              (setq distEnds (distance cpCur cpEshort))
                              (setq uTan (list (/ (- (car cpEshort) (car cpCur)) distEnds)
                                               (/ (- (cadr cpEshort) (cadr cpCur)) distEnds)))
                              (setq uPerp (list (- (cadr uTan)) (car uTan)))
                              (setq corner1 (DEGZ--calc-L-corner cpCur ip uPerp))
                              (setq corner2 (DEGZ--calc-L-corner cpEshort ipRin uPerp))
                              (setq crv (DEGZ--insert-detour crv cpCur cpEshort (list corner1 ip ipRin corner2)))
                            )
                            
                            ;; STANDART DIREKT BAGLANTI (VEKTOREL HIZALAMA)
                            (progn
                                ;; *** ONEMLI: Hesaplamalarda 'mainTmp' (Temiz Hat) kullan! ***
                                (setq calcCrv mainTmp) 
                                
                                ;; A. Orta noktayi bul
                                (setq ipAvg (list (/ (+ (car ip) (car ipRin)) 2.0) (/ (+ (cadr ip) (cadr ipRin)) 2.0)))
                                (setq pMid (deg-safe-closest-point calcCrv ipAvg))
                                
                                ;; B. Hattin yonunu bul (Temiz hat uzerinden)
                                (setq paramMid (vlax-curve-getParamAtPoint (DEGZ--ename calcCrv) (DEGZ--pt3d pMid)))
                                (setq deriv (vlax-curve-getFirstDeriv (DEGZ--ename calcCrv) paramMid))
                                (setq Tlen (distance '(0 0 0) deriv))
                                (if (< Tlen 1e-9)
                                   (progn (setq Tx rx) (setq Ty ry))
                                   (progn (setq Tx (/ (car deriv) Tlen)) (setq Ty (/ (cadr deriv) Tlen)))
                                )

                                ;; C. Hizalama Yonu
                                (setq Lx (- (car ipRin) (car ip)))
                                (setq Ly (- (cadr ipRin) (cadr ip)))
                                (setq dotProd (+ (* Tx Lx) (* Ty Ly)))
                                (setq dirSign (if (>= dotProd 0) 1.0 -1.0))

                                ;; Remote + anchor + target side: reverse direction so the short piece is taken from the other side
                                (if (and remote isAnchor isTargetSide)
                                  (setq dirSign (- dirSign))
                                )
                                
                                ;; D. Sabit 10 birim aralik (Merkezden +/- 5.0)
                                (setq distMid (vlax-curve-getDistAtParam (DEGZ--ename calcCrv) paramMid))
                                (setq maxDist (DEGZ--curve-total calcCrv))
                                
                                (setq distPair (DEGZ--distpair10 distMid dirSign maxDist (/ shift 4.0)))
                                (setq distDown (car distPair))
                                (setq distDownRin (cadr distPair))
                                
                                ;; Noktalari Temiz Hat uzerinden al (Komsunun bacagina carpmaz)
                                (setq pDown    (DEGZ--pt2d (vlax-curve-getPointAtDist (DEGZ--ename calcCrv) distDown)))
                                (setq pDownRin (DEGZ--pt2d (vlax-curve-getPointAtDist (DEGZ--ename calcCrv) distDownRin)))

                                ;; Detour ekleme noktalarini guncel 'crv' uzerinde bul
                                ;; pDown temiz hat uzerinde oldugu icin, 'crv' uzerinde de govdeye denk gelir.
                                (setq cpCur    (deg-safe-closest-point crv pDown))
                                (setq cpEshort (deg-safe-closest-point crv pDownRin))
                                
                                ;; DIREKT BAGLANTI LISTESI
                                ;; ORTHO modunu ana hattin yonune gore sabitle (iki uc ayni mod kullanir)
                                (if orthoForced
                                (setq lmode (DEGZ--lmode-along-main-at crv cpCur ip))
                                (progn
                                  (setq firstX (DEGZ--ortho-first-axis ip cpCur))
                                  (setq lmode (if firstX 'hfirst 'vfirst))
                                )
                              )
                       ;; ORTHO zorlanan ve blok ana hattin ustunde/solunda ise
                       ;; kisa kolun blok tarafinda kalmasi icin mode'u corner->ip mesafesine gore sec
                       (if (and orthoForced isTargetSide)
                         (progn
                           (setq dxA (abs (- (car ip) (car cpCur))))
                           (setq dyA (abs (- (cadr ip) (cadr cpCur))))
                           ;; vfirst => corner->ip yatay (dx), hfirst => corner->ip dikey (dy)
                           (setq lmode (if (< dxA dyA) 'vfirst 'hfirst))
                         )
                       )
(setq corner1 (DEGZ--calc-L-corner-mode cpCur    ip   lmode))
                                (setq corner2 (DEGZ--calc-L-corner-mode cpEshort ipRin lmode))
                                (setq crv (DEGZ--insert-detour crv cpCur cpEshort (list corner1 ip ipRin corner2)))
                            )
                        )
                     )
                  )
                )
              )
            )
          )
        )

        (if mainTmp (entdel mainTmp))
      )
    )
  )
  (princ)
)

(defun DEGDR--RUN (mainEnt pick dist / mainPts tol ss allEnts rootId assignedEnts lay mainCol tubePls scan e pl outline)
  (setq mainPts (g365_get_pts mainEnt))
  (if (or (null mainPts) (< (length mainPts) 2))
    (progn (princ "\nAna hat okunamadi / cok kisa.") nil)
    (progn
      (setq tol (DEG:CFG-TOL-NUM-OR 'DR_TREE_TOL 0.1))
      (if (<= dist 0.0)
        (progn (princ "\nGecersiz mesafe.") nil)
        (progn
          (setq lay (cdr (assoc 8 (entget mainEnt))))
          (setq mainCol (g365_effective_color mainEnt))
          ;; Iskelete dahil olacak nesneler, secilen ana hat ile AYNI layer'da olmalidir.
          (if (and lay (/= lay ""))
            (setq ss (ssget "X" (list (cons 0 "LWPOLYLINE,POLYLINE,LINE") (cons 8 lay))))
            (setq ss (ssget "X" '((0 . "LWPOLYLINE,POLYLINE,LINE"))))
          )
          (if (null ss)
            (progn (princ "\nHic nesne bulunamadi.") nil)
            (progn
              (setq allEnts (g372_ss_to_list ss))
              ;; Iskelete dahil olacak nesneler, secilen ana hat ile AYNI renkte olmalidir.
              (setq allEnts
                (vl-remove nil
                  (mapcar
                    '(lambda (en)
                       (if (= (g365_effective_color en) mainCol) en nil)
                     )
                    allEnts
                  )
                )
              )
              (setq rootId (g372_build_tree mainEnt mainPts allEnts tol))
              (setq assignedEnts (g415_get_assigned_original_ents allEnts))
              
              (setq tubePls nil)
              (setq scan assignedEnts)
              (while scan
                (setq e (car scan))
                (setq pl (g415_make_tube_poly_from_ent e dist lay))
                (if pl (setq tubePls (cons pl tubePls)))
                (setq scan (cdr scan))
              )
              (setq tubePls (reverse tubePls))
              (setq outline (g415_union_tubes_to_outline tubePls lay))

              (if outline
                (progn
                  (setq outline (g418_rebuild_outline_seam outline lay pick mainPts dist))
                  (if outline (g365_copy_color mainEnt outline))
                  (g415_delete_ents assignedEnts)
                  (g418_flush_cmd)
                  outline
                )
                nil
              )
            )
          )
        )
      )
    )
  )
)

