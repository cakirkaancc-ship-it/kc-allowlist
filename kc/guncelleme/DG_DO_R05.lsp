(setq *DEG-BLOCK-WRITTEN* *DEG-BLOCK-WRITTEN*)

(defun DEG-DGT--app () "DEG_DGT_RESET")

(defun DEG-DGT--regapp (/ app)
  (setq app (DEG-DGT--app))
  (if (not (tblsearch "APPID" app)) (regapp app))
  app
)

(defun DEG-DGT--xdata-strings (e / xd rec appData out item)
  (setq xd (assoc -3 (entget e (list (DEG-DGT--app)))))
  (setq appData nil)
  (cond
    ((and xd (listp (cadr xd)) (= (caadr xd) (DEG-DGT--app)))
      (setq appData (cadr xd)))
    ((and xd (listp (cdr xd)) (listp (car (cdr xd))))
      (setq rec (car (cdr xd)))
      (if (= (car rec) (DEG-DGT--app)) (setq appData rec)))
  )
  (setq out nil)
  (if appData
    (foreach item (cdr appData)
      (if (and (listp item) (= (car item) 1000))
        (setq out (append out (list (cdr item))))
      )
    )
  )
  out
)

(defun DEG-DGT--xdata-kind (e / vals)
  (setq vals (DEG-DGT--xdata-strings e))
  (if vals (car vals) nil)
)

(defun DEG-DGT--mark-xdata (e kind vals / data)
  (if e
    (progn
      (DEG-DGT--regapp)
      (setq data (append (list (DEG-DGT--app) (cons 1000 kind))
                         (mapcar '(lambda (s) (cons 1000 (if s s ""))) vals)))
      (vl-catch-all-apply 'entmod (list (append (entget e) (list (list -3 data)))))
      (vl-catch-all-apply 'entupd (list e))
    )
  )
  e
)


(defun DEG-DGT--clear-xdata (e / ed newed x3 app rec)
  (if e
    (progn
      (setq app (DEG-DGT--app))
      (setq ed (entget e '("*")))
      (setq newed nil)
      (foreach x3 ed
        (setq rec (if (and (= (car x3) -3) (listp (cadr x3))) (cadr x3) nil))
        (if (and rec (= (car rec) app))
          (setq newed newed)
          (setq newed (append newed (list x3)))
        )
      )
      (if (and newed (/= (length newed) (length ed)))
        (progn
          (vl-catch-all-apply 'entmod (list newed))
          (vl-catch-all-apply 'entupd (list e))
        )
      )
    )
  )
  e
)
(defun DEG-DGT--mark-color (x / e ed c62 c420 c430 kind)
  (setq e (deg--to-ename x))
  (setq kind (if e (DEG-DGT--xdata-kind e)))
  (if (and e (not (and kind (= kind "COLOR"))))
    (progn
      (setq ed (entget e))
      (setq c62  (assoc 62 ed))
      (setq c420 (assoc 420 ed))
      (setq c430 (assoc 430 ed))
      (DEG-DGT--mark-xdata e "COLOR"
        (list
          (if c62 (itoa (cdr c62)) "")
          (if c420 (itoa (cdr c420)) "")
          (if c430 (cdr c430) "")
        )
      )
    )
  )
  e
)

(defun DEG-DGT--mark-circle (e / kind)
  (setq kind (if e (DEG-DGT--xdata-kind e)))
  (if (and e (not (and kind (= kind "CIRCLE"))))
    (DEG-DGT--mark-xdata e "CIRCLE" nil)
  )
  e
)

(defun DEG-DGT--remove-codes (ed codes / out p)
  (setq out nil)
  (foreach p ed
    (if (not (member (car p) codes))
      (setq out (append out (list p)))
    )
  )
  out
)

(defun DEG-DGT--insert-after-code (ed code ins / out done p)
  (setq out nil done nil)
  (foreach p ed
    (setq out (append out (list p)))
    (if (and (not done) (= (car p) code))
      (progn
        (setq out (append out ins))
        (setq done T)
      )
    )
  )
  (if done out (append out ins))
)

(defun DEG-DGT--restore-color (e c62s c420s c430s / ed add c62v c420v)
  (if e
    (progn
      (setq ed (entget e))
      (setq ed (DEG-DGT--remove-codes ed '(62 420 430)))
      (setq add nil)
      (if (and c62s (/= c62s ""))
        (setq c62v (atoi c62s))
        (setq c62v 256)
      )
      (setq add (append add (list (cons 62 c62v))))
      (if (and c420s (/= c420s ""))
        (progn
          (setq c420v (atoi c420s))
          (setq add (append add (list (cons 420 c420v))))
        )
      )
      (if (and c430s (/= c430s ""))
        (setq add (append add (list (cons 430 c430s))))
      )
      (setq ed (DEG-DGT--insert-after-code ed 8 add))
      (vl-catch-all-apply 'entmod (list ed))
      (vl-catch-all-apply 'entupd (list e))
    )
  )
  e
)

