      (setq i 0)
      (while (< i (sslength a))
        (ssadd (ssname a i) out)
        (setq i (1+ i))
      )
    )
  )
  (if b
    (progn
      (setq i 0)
      (while (< i (sslength b))
        (ssadd (ssname b i) out)
        (setq i (1+ i))
      )
    )
  )
  out
)

(defun DEGV:_ss-add-unique (ss e / i hit he hs cur)
  (if (and ss e (= (type e) 'ENAME))
    (progn
      (setq he (DEGV:_ename-handle e))
      (setq i 0 hit nil)
      (while (and (< i (sslength ss)) (not hit))
        (setq cur (ssname ss i))
        (setq hs (DEGV:_ename-handle cur))
        (if (or (equal e cur) (and he hs (= he hs)))
          (setq hit T)
        )
        (setq i (1+ i))
      )
      (if (not hit) (ssadd e ss))
    )
  )
  ss
)

