                (vl-string-search "PANEL" u)
                (vl-string-search "RACK" u)
                (vl-string-search "DOSEME" u))))
)

(defun DEGDO--plan-e-block-list (/ ss i ent ed bname ctab laytab out)
  ;; GstarCAD uyumu: EffectiveName icin ActiveX cagirmadan INSERT adlarini oku.
  (setq ctab (strcase (getvar "CTAB"))
        out  nil)
  (setq ss (ssget "_X" '((0 . "INSERT"))))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent (ssname ss i)
              ed  (entget ent)
              bname (cdr (assoc 2 ed))
              laytab (cdr (assoc 410 ed)))
        (if (and bname
                 (or (null laytab) (= (strcase laytab) ctab))
                 (DEGDO--dp-allow-e-block-p bname)
                 (not (member (strcase bname) (mapcar 'strcase out))))
          (setq out (cons bname out))
        )
        (setq i (1+ i))
      )
    )
  )
  (if out
    (vl-sort out '(lambda (a b) (< (strcase a) (strcase b))))
    nil
  )
)
(defun DEGDO--dp-e-block-values-alist (/ part pos blk rest vals data tel tv out)
  (foreach part (DEGDO--split-delim (DEG:CFG-GET 'DP_E_BLOCK_VALUES) "|")
    (setq pos (vl-string-search "=" part))
    (if pos
      (progn
        (setq blk  (strcase (DEGDO--trim (substr part 1 pos)))
              rest (substr part (+ pos 2))
              vals (DEGDO--split-delim rest "^")
              data (DEGDO--trim (car vals))
              tel  (DEGDO--trim (cadr vals))
              tv   (DEGDO--trim (caddr vals)))
        (if (/= blk "")
          (setq out (cons (list blk data tel tv) out))
        )
      )
    )
  )
  (reverse out)
)

(defun DEGDO--dp-e-block-row-get (al blk / row hit)
  (setq blk (strcase blk))
  (foreach row al
    (if (= (car row) blk)
      (setq hit row)
    )
  )
  hit
)

(defun DEGDO--dp-e-block-value-get (al blk idx / row)
  (setq row (DEGDO--dp-e-block-row-get al blk))
  (if row
    (nth (+ idx 1) row)
    ""
  )
)

(defun DEGDO--dp-e-block-values-pack (al / out row blk data tel tv)
  (foreach row al
    (setq blk  (if (car row) (strcase (car row)) "")
          data (DEGDO--trim (nth 1 row))
          tel  (DEGDO--trim (nth 2 row))
          tv   (DEGDO--trim (nth 3 row)))
    (if (and (/= blk "")
             (or (/= data "") (/= tel "") (/= tv "")))
      (setq out (append out (list (strcat blk "=" data "^" tel "^" tv))))
    )
  )
  (if out
    (apply 'strcat (cons (car out) (mapcar '(lambda (a) (strcat "|" a)) (cdr out))))
    ""
  )
)

(defun DEGDO--split-columns (lst cols / total per idx chunk out)
  (if (< cols 1) (setq cols 1))
  (setq total (length lst))
  (if (= total 0)
    nil
    (progn
      (setq per (fix (/ (+ total cols -1) cols)))
      (if (< per 1) (setq per 1))
      (setq idx 0
            out nil)
      (while (< idx total)
        (setq chunk nil)
        (repeat per
          (if (< idx total)
            (progn
              (setq chunk (append chunk (list (nth idx lst))))
              (setq idx (1+ idx))
            )
          )
        )
        (setq out (append out (list chunk)))
      )
      out
    )
  )
)

