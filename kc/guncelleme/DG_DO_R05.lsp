    (progn
      (setq dosemeTol (DEG:CFG-TOL-NUM-OR 'DN_DOSEME_TOL 10.0))
      (if (> dosemeTol baseTol) dosemeTol baseTol)
    )
    baseTol
  )
)



(defun deg-make-circle (pt rad / layerName col)
  (setq pt  (deg-pt3 pt))
  (setq rad (if (and (numberp rad) (> rad 0.0)) rad 7.0))
  (if (not pt)
    nil
    (progn
      (if (<= rad 7.0)
        (progn
          (setq layerName (DEG:TOL 'Q1))
          (setq col (DEG:CFG-ACI-OR 'DGT_TOL_SMALL_COLOR 2))
        )
        (progn
          (setq layerName (DEG:TOL 'Q2))
          (setq col (DEG:CFG-ACI-OR 'DGT_TOL_BIG_COLOR 3))
        )
      )
      (deg-ensure-layer layerName col)
      (DEG-DGT--make-circle pt rad layerName col)
    )
  )
)

(defun get-sembol-adi-from-block (blkObj / attList att tag val sym adet n numstr idx ch)
  (setq sym   nil
        adet  nil)
  (if (= :vlax-true (vla-get-HasAttributes blkObj))
    (progn
      (setq attList (vlax-invoke blkObj 'GetAttributes))
      (foreach att attList
        (setq tag (strcase (vla-get-TagString att)))
        (setq val (vla-get-TextString att))
        (cond
          ((or (= tag "SEMBOL_ADI") (= tag "SEMBOL ADI"))
           (setq sym val)
          )
          ((= tag "ADET")
           (setq adet val)
          )
        )
      )
    )
  )
  (if sym
    (progn
      (setq numstr "")
      (if adet
        (progn
          (setq idx 1)

          (while (<= idx (strlen adet))
            (setq ch (substr adet idx 1))
            (if (and (>= (ascii ch) 48) (<= (ascii ch) 57))
              (setq numstr (strcat numstr ch))
            )
            (setq idx (1+ idx))
          )
        )
      )
      (setq n (if (> (strlen numstr) 0) (atoi numstr) 0))
      (if (<= n 0) (setq n 1))
      (list (cons sym n))
    )
    '()
  )
)

(defun get-adet-from-block (blkObj / attList att tag val numstr idx ch n)
  (setq n 0)
  (if (= :vlax-true (vla-get-HasAttributes blkObj))
    (progn
      (setq attList (vlax-invoke blkObj 'GetAttributes))
      (foreach att attList
        (setq tag (strcase (vla-get-TagString att)))
        (setq val (vla-get-TextString att))
        (if (= tag "ADET")
          (progn
            (setq numstr ""
                  idx 1)
            (while (<= idx (strlen val))
              (setq ch (substr val idx 1))
              (if (and (>= (ascii ch) 48) (<= (ascii ch) 57))
                (setq numstr (strcat numstr ch)))
              (setq idx (1+ idx))
            )
            (if (> (strlen numstr) 0)
              (setq n (atoi numstr)))
          )
        )
      )
    )
  )
  n
)

(defun get-linye-numarasýi-from-block (blkObj / attList att tag val res)
  (setq res nil)
  (if (= :vlax-true (vla-get-HasAttributes blkObj))
    (progn
      (setq attList (vlax-invoke blkObj 'GetAttributes))
      (foreach att attList
        (setq tag (strcase (vla-get-TagString att)))
        (setq val (vla-get-TextString att))
        (if (or (= tag "LINYE_NUMARASI")
                (= tag "LÝNYE_NUMARASI"))
          (setq res val)
        )
      )
    )
  )
  res
)

(defun block-ref-contact-point (plObj blkObj tol / res lst
                                         insPt pts allPts p cpt d bestD bestP)
  (setq res
    (vl-catch-all-apply
      (function
        (lambda ()
          (vlax-invoke plObj 'IntersectWith blkObj 0)))))
  (if (not (vl-catch-all-error-p res))
    (progn
      (setq lst (vl-catch-all-apply 'DEG:PT->LIST (list res)))
      (if (vl-catch-all-error-p lst) (setq lst nil))
      (if (and (listp lst) (>= (length lst) 2))
        (setq bestP (list (nth 0 lst) (nth 1 lst) 0.0))
      )
    )
  )
  (if (not bestP)
    (progn
      (setq insPt (deg-get-inspt blkObj))
      (setq pts   (bbox-test-points blkObj))
      (setq allPts (cons insPt pts))
      (foreach p allPts
        (if p
          (progn
            (setq cpt (deg-safe-closest-point plObj p))
            (if cpt
              (progn
                (setq d (distance p cpt))
                (if (and (< d tol)
                         (or (not bestD) (< d bestD)))
                  (setq bestD d
                        bestP cpt)
                )
              )
            )
          )
        )
      )
    )
  )
  bestP
)

(defun parse-linye-key (s / i len ch prefix numstr)
  (if (not s) (setq s ""))
  (setq len (strlen s))
  (setq i 1
        prefix ""
        numstr "")
  (while (and (<= i len)
              (or (and (>= (ascii (substr s i 1)) 65) (<= (ascii (substr s i 1)) 90))
                  (and (>= (ascii (substr s i 1)) 97) (<= (ascii (substr s i 1)) 122))))
    (setq prefix (strcat prefix (substr s i 1)))
    (setq i (1+ i))
  )
  (while (<= i len)
    (setq ch (substr s i 1))
    (if (and (>= (ascii ch) 48) (<= (ascii ch) 57))
      (setq numstr (strcat numstr ch)))
    (setq i (1+ i))
  )
  (cons (strcase prefix) (if (> (strlen numstr) 0) (atoi numstr) 0))
)

(defun deg-trim-string (s)
  (if s
    (vl-string-trim " " s)
    ""
  )
)

(defun deg-block-linye-key (blkObj / ln)
  (setq ln (deg-trim-string (get-linye-numarasýi-from-block blkObj)))
  (if ln ln "")
)

(defun deg-build-sembol-list-from-blocks (blocks / symAssoc sembolList b vals sym n old pair)
  (setq symAssoc '())
  (foreach b blocks
    (foreach vals (get-sembol-adi-from-block b)
      (setq sym (car vals)
            n   (cdr vals)
            old (assoc sym symAssoc))
      (if old
        (setq symAssoc
              (subst (cons sym (+ n (cdr old))) old symAssoc))
        (setq symAssoc (cons (cons sym n) symAssoc))
      )
    )
  )
  (setq symAssoc (reverse symAssoc)
        sembolList '())
  (foreach pair symAssoc
    (setq sembolList
          (append sembolList
                  (list (strcat (itoa (cdr pair)) "x" (car pair)))))
  )
  sembolList
)

(defun deg-group-blocks-by-linye (blocks / blankBlocks nonBlankOrder nonBlankAssoc b ln old grouped)
  (setq blankBlocks   '()
        nonBlankOrder '()
        nonBlankAssoc '())
  (foreach b blocks
    (setq ln (deg-block-linye-key b))
    (if (> (strlen ln) 0)
      (progn
        (if (not (assoc ln nonBlankAssoc))
          (setq nonBlankOrder (append nonBlankOrder (list ln))))
        (setq old (assoc ln nonBlankAssoc))
        (if old
          (setq nonBlankAssoc
                (subst (cons ln (append (cdr old) (list b))) old nonBlankAssoc))
          (setq nonBlankAssoc (append nonBlankAssoc (list (cons ln (list b)))))
        )
      )
      (setq blankBlocks (append blankBlocks (list b)))
    )
  )
  (cond
    (nonBlankOrder
      (if (= (length nonBlankOrder) 1)
        (progn
          (setq ln  (car nonBlankOrder)
                old (assoc ln nonBlankAssoc))
          (setq nonBlankAssoc
                (subst (cons ln (append (cdr old) blankBlocks)) old nonBlankAssoc))
        )
      )
      (setq grouped '())
      (foreach ln nonBlankOrder
        (setq old (assoc ln nonBlankAssoc))
        (if old
          (setq grouped (append grouped (list (cons ln (cdr old)))))
        )
      )
      grouped
    )
    (blocks
      (list (cons "" blocks))
    )
    (T nil)
  )
)

(defun deg-build-data-rows-by-linye (blocks layerName mesafe len blockMesafe toplam kitLayerP
                                    / groups rows grp ln rowBlocks blockNamesStr sembolList
                                      adetFactor adetRaw toplamx)
  (setq groups (deg-group-blocks-by-linye blocks)
        rows   '())
  (if (and kitLayerP (null groups))
    (setq groups (list (cons "" nil))))
  (foreach grp groups
    (setq ln        (car grp)
          rowBlocks (cdr grp))
    (setq adetFactor 1)
    (foreach b rowBlocks
      (setq adetRaw (get-adet-from-block b))
      (if (> adetRaw 0)
        (if (= adetFactor 1)
          (setq adetFactor adetRaw)
          (if (> adetRaw adetFactor)
            (setq adetFactor adetRaw)
          )
        )
      )
    )
    (setq toplamx nil)
    (if (deg--layer-is-data-tv-tel layerName)
      (setq toplamx (* toplam adetFactor))
    )
    (if kitLayerP
      (setq rows
            (append rows
                    (list (list ln layerName mesafe len blockMesafe toplam toplamx "" nil))))
      (progn
        (setq blockNamesStr (deg-block-count-string rowBlocks))
        (if (and blockNamesStr (/= blockNamesStr ""))
          (progn
            (setq sembolList (deg-build-sembol-list-from-blocks rowBlocks))
            (setq rows
                  (append rows
                          (list (list ln layerName mesafe len blockMesafe toplam toplamx blockNamesStr sembolList))))
          )
        )
      )
    )
  )
  rows
)

(defun deg-block-name (blkObj / nm dyn)
  (setq nm (vla-get-Name blkObj))
  (if (and nm (= (substr nm 1 1) "*"))
    (progn
      (if (vlax-property-available-p blkObj 'EffectiveName)
        (setq nm (vla-get-EffectiveName blkObj))
        (if (and (vlax-property-available-p blkObj 'DynamicBlockTableRecord)
                 (= :vlax-true (vla-get-IsDynamicBlock blkObj)))
          (progn
            (setq dyn (vla-get-DynamicBlockTableRecord blkObj))
            (setq nm (vla-get-Name dyn))
          )
        )
      )
    )
  )
  (strcase nm)
)


(defun deg-block-name-raw (blkObj / nm dyn)
