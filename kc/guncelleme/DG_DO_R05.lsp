(defun deg-norm (s / tmp)
  (if (null s) ""
    (progn
      (setq tmp (vl-princ-to-string s))
      (setq tmp (vl-string-translate "ÝIý" "iii" tmp))
      (strcase tmp)
    )
  )
)

(defun deg--layer-is-data-tv-tel (layer / n)
  (setq n (deg-norm layer))
  (or (wcmatch n (DEG:VAL 'C9))
      (DEG:LAYER-IN-CODES? n '(C1 C2 C3 C4))
      (wcmatch n (DEG:VAL 'E4))
      (wcmatch n (DEG:VAL 'H5))
      (DEGQ:_cctv-layer-name-p n)
      (wcmatch n (DEG:VAL 'F5)))
)

(defun deg--dp-layer-family (layer / n)
  (setq n (norm-layer layer))
  (cond
    ((or (DEGP--data-layer-name-p n) (DEG:LAYER-IN-CODES? n '(C1 C2 C3 C4)) (wcmatch n (DEG:VAL 'C9))) "DATA")
    ((or (DEG:LAYER-IN-CODES? n '(E1 E2 E3 E5)) (wcmatch n (DEG:VAL 'E4))) "TEL")
    ((or (DEG:LAYER-IN-CODES? n '(F1 F2 F3 F4)) (wcmatch n (DEG:VAL 'F5))) "TV")
    ((DEGQ:_cctv-layer-name-p n) "CCTV")
    ((or (DEG:LAYER-IN-CODES? n '(H1 H2 H3 H4)) (wcmatch n (DEG:VAL 'H5))) "KARTLI")
    ((DEGP--lighting-layer-name-p n) "AYDINLATMA")
    ((DEG:LAYER-IN-CODES? n '(B1 B2 B3 B4)) "PRIZ")
    ((DEG:LAYER-IN-CODES? n '(G1 G2 G3 G4)) "UPS")
    (T n)
  )
)

(defun deg--dp-same-layer-family-p (a b)
  (= (deg--dp-layer-family a) (deg--dp-layer-family b))
)

(defun deg--dp-block-written-key (h layer)
  (strcat h "|" (deg--dp-layer-family layer))
)


  (setq *degRefChainEnts* nil)
  (setq tolRef    (DEG:CFG-TOL-NUM-OR 'DG_REF_TOL 50.0)
        tolChain  (DEG:CFG-TOL-NUM-OR 'DG_CHAIN_TOL 7.0)
        tolReport (DEG:CFG-TOL-NUM-OR 'DG_REPORT_TOL 7.0)
        tolRefDal (DEG:CFG-TOL-NUM-OR 'DG_REF_DAL_TOL 7.0))

  (setq markedTol30Handles '())
  (setq markedTol7Handles  '())

  (setq ss    (cond
                ((and (boundp '*degDGScopePolySS*) *degDGScopePolySS*) *degDGScopePolySS*)
                (T (ssget "_X" '((0 . "LWPOLYLINE"))))
              ))
  (setq blkSS (cond
                ((and (boundp '*degDGScopeBlkSS*) *degDGScopeBlkSS*) *degDGScopeBlkSS*)
                (T (ssget "_X" '((0 . "INSERT"))))
              ))
  (if (<= (DEG:SS-LEN ss) 0)    (setq ss nil))
  (if (<= (DEG:SS-LEN blkSS) 0) (setq blkSS nil))

  (if (not ss)
    (progn
      (princ "\n\nPolyline yok.")
      (setq sortedList nil)
    )
    (progn
      (setq bestRefObj nil
            bestRefPt  nil
            bestRefD   nil)

(if (and (boundp '*degForceRefObj*) *degForceRefObj*)
  (progn
    (setq bestRefObj *degForceRefObj*)
    (setq insPt (deg-get-inspt blkRefObj))
    (setq bestRefPt (if (and (boundp '*degForceRefPt*) *degForceRefPt*)
                      *degForceRefPt*
                      (vlax-curve-getStartPoint bestRefObj)))
    (setq bestRefD (distance (deg-safe-closest-point bestRefObj insPt) insPt))
  )
)

(setq i 0)
      (while (< i (sslength ss))
        (setq ent (ssname ss i)
              obj (vlax-ename->vla-object ent)
              layerName (norm-layer (vlax-get obj 'Layer)))
        (if (DEG:LAYER-IN-CODES? layerName '(B2 B4 A3 A5 E3 F4 C3 C7 E5 C1 C2 F2 C8 C4 G2 G4 H2 D4))
          (progn
            (setq insPt  (deg-get-inspt blkRefObj))
            (setq candPt (deg-safe-closest-point obj insPt))
            (if (deg-endpoint-touch? obj blkRefObj tolRef)
              (progn
                (setq candD (distance candPt insPt))
                (if (or (not bestRefD) (< candD bestRefD))
                  (progn
                    (setq bestRefD   candD)
                    (setq bestRefObj obj)
                    (setq bestRefPt  candPt)
                  )
                )
              )
            )
          )
        )
        (setq i (1+ i))
      )

      (if (not bestRefObj)
        (progn
          (princ "\n\nSeçilen bloða deðen KOMBINE polyline bulunamadý.")
          (setq *degHideToplamx* nil)
          (setq *degHideSortiToplam* nil)
          (setq dataList (deg-build-knx-chain testMode blkRefObj ss blkSS))
          (setq sortedList dataList)
        )
        (progn
          (setq refLayer (norm-layer (vlax-get bestRefObj 'Layer)))
          (setq *degLastRefLayer* refLayer)
          (setq *degLastIsCCTV*
            (or (DEGQ:_cctv-layer-name-p refLayer)
                (and (DEGP--dp-data-mode-p) (DEGP--data-layer-name-p refLayer))))

          (setq isCctvKartli
                 (or (DEGQ:_cctv-layer-name-p refLayer)
                     (and (DEGP--dp-data-mode-p) (DEGP--data-layer-name-p refLayer))
                     (wcmatch (deg-norm refLayer) (DEG:VAL 'H5))))
          (if isCctvKartli
            (progn
              (setq tolChain  (DEG:CFG-TOL-NUM-OR 'DG_CHAIN_TOL 7.0))
              (setq tolReport (DEG:CFG-TOL-NUM-OR 'DG_REPORT_TOL 7.0))
              (setq tolRefDal (DEG:CFG-TOL-NUM-OR 'DG_REF_DAL_TOL 7.0))
            )
          )

          (setq *degHideToplamx* (deg--layer-is-priz-or-lighting refLayer))
          (setq *degHideSortiToplam* (not *degHideToplamx*))

          (cond
            ((and (DEGP--dp-data-mode-p) (DEGP--data-layer-name-p refLayer))
             (setq refL (DEGP--data-ref-layers))
             (setq dalL (DEGP--data-dal-layers))
            )
            ((and (DEGP--dp-lighting-mode-p)
                  (DEGP--lighting-layer-name-p refLayer))
             (setq refL
               (if (DEGP--lighting-comb-like-layer-p refLayer)
                 (DEGP--lighting-comb-layers)
                 (DEGP--lighting-line-layers)))
             (setq dalL (DEGP--lighting-line-layers))
            )
            ((member refLayer (DEG:VALS '(B2 B4)))
             (setq refL (DEG:VALS '(B2 B4)))
             (setq dalL (DEG:VALS '(B1 B3)))
            )
            ((member refLayer (DEG:VALS '(A2 A4)))
             (setq refL (DEG:VALS '(A2 A4)))
             (setq dalL (append (DEG:VALS '(A2 A4 A7)) (DEG:CFG-LIST 'DG_KIT_LAYER) (DEG:CFG-LIST 'DG_ANAHTAR_LAYER) (DEG:DG-EXTRA-LAYERS)))
            )
            ((member refLayer (DEG:VALS '(A3 A5)))
             (setq refL (DEG:VALS '(A3 A5)))
             (setq dalL (append (DEG:VALS '(A2 A4 A7)) (DEG:CFG-LIST 'DG_KIT_LAYER) (DEG:CFG-LIST 'DG_ANAHTAR_LAYER) (DEG:DG-EXTRA-LAYERS)))
            )
            ((member refLayer (DEG:VALS '(F2 F4)))
             (setq refL (DEG:VALS '(F2 F4)))
             (setq dalL (DEG:VALS '(F1 F3)))
            )
            ((member refLayer (DEG:VALS '(D1 D2 D3 D4)))
             (setq refL (DEG:VALS '(D4 D3)))
             (setq dalL (DEG:VALS '(D1 D2)))
            )
            ((member refLayer (DEG:VALS '(H2 H4)))
             (setq refL (DEG:VALS '(H2 H4)))
             (setq dalL (DEG:VALS '(H1 H3)))
            )
            ((member refLayer (DEG:VALS '(E5 E3)))
             (setq refL (DEG:VALS '(E5 E3)))
             (setq dalL (DEG:VALS '(E1 E2)))
            )
            ((member refLayer (DEG:VALS '(C4 C3)))
             (setq refL (DEG:VALS '(C4 C3)))
             (setq dalL (DEG:VALS '(C1 C2 F1 F3 E2 E1)))
            )
            ((member refLayer (DEG:VALS '(C8 C7)))
             (setq refL (DEG:VALS '(C8 C7)))
             (setq dalL (DEG:VALS '(C6)))
            )
            ((member refLayer (DEG:VALS '(G2 G4)))
             (setq refL (DEG:VALS '(G2 G4)))
             (setq dalL (DEG:VALS '(G1 G3)))
            )
            (T
             (princ
               (strcat
                 "\nUyarý: Tanýnmayan referans layer: " refLayer
                 " – tüm layer’lar serbest çalýþýyor."))
             (setq refL (DEG:VALS '(B2 B4 A3 A5 F2 F4 D4 H2 D3 E5 E3 C4 C3 C8 C7 G2 G4)))
             (setq dalL (DEG:VALS '(B1 B3 A2 A4 A7 F1 D1 H1 D2 F3 E1 E2 C1 C2 C6 G1 G3)))
            )
          )

          (setq tolReport (DEG:CFG-TOL-NUM-OR 'DG_REPORT_TOL 7.0))

          (setq startPtOnRef bestRefPt)
          (setq startDist (deg-safe-dist-at-point bestRefObj startPtOnRef))

          (setq refInfos (list (list bestRefObj startDist 0.0)))

          (setq kombList '())
          (setq i 0)
          (while (< i (sslength ss))
            (setq ent (ssname ss i)
                  obj (vlax-ename->vla-object ent)
                  layerName (norm-layer (vlax-get obj 'Layer)))
            (if (and (/= (vlax-get obj 'Handle) (vlax-get bestRefObj 'Handle))
                     (member layerName refL))
              (setq kombList (cons obj kombList))
            )
            (setq i (1+ i))
          )

          (setq changed T)
          (while changed
            (setq changed nil)
            (foreach kobj kombList
              (if (not (ref-find-info kobj refInfos))
                (progn
                  (setq connFound nil)
                  (setq kStart (vlax-curve-getStartPoint kobj))
                  (setq kEnd   (vlax-curve-getEndPoint   kobj))
                  (setq overlapRefDalP
                    (member (norm-layer (vlax-get kobj 'Layer)) dalL))

                  ;; Aydinlatmada A2/A4 hem referans hem dal listesinde olabilir.
                  ;; Secilen referansa baglanan diger A2/A4 polylinelarini ana hat
                  ;; devami saymak, ayni dugumdeki kardes dallari yutuyordu.
                  (if (not overlapRefDalP)
                    (foreach info refInfos
                      (if (not connFound)
                        (progn
                          (setq robj      (car  info))
                          (setq baseParam (cadr info))
                          (setq baseDist  (caddr info))

                          (setq cpt (deg-safe-closest-point robj kStart))
                          (if (< (distance kStart cpt) tolRef)
                            (progn
                              (setq paramConnRobj (deg-safe-dist-at-point robj cpt))
                              (setq baseDist (+ baseDist (abs (- paramConnRobj baseParam))))
                              (setq paramConnKobj (deg-safe-dist-at-point kobj kStart))
                              (setq refInfos (cons (list kobj paramConnKobj baseDist)
                                                   refInfos))
                              (setq connFound T)
                            )
                          )

                          (if (not connFound)
                            (progn
                              (setq cpt (deg-safe-closest-point robj kEnd))
                              (if (< (distance kEnd cpt) tolRef)
                                (progn
                                  (setq paramConnRobj (deg-safe-dist-at-point robj cpt))
                                  (setq baseDist (+ baseDist (abs (- paramConnRobj baseParam))))
                                  (setq paramConnKobj (deg-safe-dist-at-point kobj kEnd))
                                  (setq refInfos (cons (list kobj paramConnKobj baseDist)
                                                       refInfos))
                                  (setq connFound T)
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )

                  (if connFound
                    (setq changed T)
                  )
                )
              )
            )
          )

          (if blkSS
            (progn
              (setq changed T)
              (while changed
                (setq changed nil)
                (foreach kobj kombList
                  (if (not (ref-find-info kobj refInfos))
                    (progn
                      (setq connFound nil)
                      (setq overlapRefDalP
                        (member (norm-layer (vlax-get kobj 'Layer)) dalL))
                      (setq j 0)
                      (while (and (< j (sslength blkSS)) (not connFound))
                        (setq blkEnt (ssname blkSS j)
                              blkObj (vlax-ename->vla-object blkEnt))
                        (setq blkName (deg-block-name blkObj))
                        (setq tolRefLocal
                          (deg-block-tol
                            (cond
                              ((= blkName (DEG:VAL 'P1))
                                (DEG:CFG-TOL-NUM-OR 'DG_P1_TOL 3.0))
                              ((deg-doseme-inis-block-p blkObj) tolRef)
                              (T tolChain))
                            blkObj))
                        (if (and
                              (or (not overlapRefDalP)
                                  (deg-doseme-inis-block-p blkObj))
                              (deg-poly-touch-block-base-p kobj blkObj tolRefLocal))
                          (progn
                            (foreach info refInfos
                              (if (not connFound)
                                (progn
                                  (setq robj (car info))
                                  (if (deg-poly-touch-block-base-p robj blkObj tolRefLocal)
                                    (progn
                                      (setq baseParam (cadr info)
                                            baseDist  (caddr info))
                                      (setq insPt (deg-get-inspt blkObj))
                                      (if (deg-doseme-inis-block-p blkObj)
                                        (progn
                                          (setq connOnRobj (block-ref-contact-point robj blkObj tolRefLocal))
                                          (setq connOnKobj (block-ref-contact-point kobj blkObj tolRefLocal))
                                        )
                                        (progn
                                          (setq connOnRobj (deg-safe-closest-point robj insPt))
                                          (setq connOnKobj (deg-safe-closest-point kobj insPt))
                                          (if (not (and insPt connOnRobj connOnKobj
                                                        (< (distance insPt connOnRobj) tolRefLocal)
                                                        (< (distance insPt connOnKobj) tolRefLocal)))
                                            (setq connOnRobj nil
                                                  connOnKobj nil)
                                          )
                                        )
                                      )
                                      (if (and connOnRobj connOnKobj)
                                        (progn
                                          (setq paramConnRobj (deg-safe-dist-at-point robj connOnRobj))
                                          (setq baseDist (+ baseDist (abs (- paramConnRobj baseParam))))
                                          (setq paramConnKobj (deg-safe-dist-at-point kobj connOnKobj))
                                          (setq refInfos
                                                (cons (list kobj paramConnKobj baseDist)
                                                      refInfos))
                                          (setq connFound T
                                                changed   T)
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                        (setq j (1+ j))
                      )
                    )
                  )
                )
              )
            )
          )

          (setq *degRefChainEnts* (mapcar 'car refInfos))

          (setq dataList '()
                processedPlineHandles '()
                i 0)

          (while (< i (sslength ss))
            (setq ent  (ssname ss i)
                  obj  (vlax-ename->vla-object ent)
                  layerName (norm-layer (vlax-get obj 'Layer))
                  hCur (vlax-get obj 'Handle))

            (setq kitLayerP (wcmatch (deg-norm layerName) "*KIT*,E_ANAHTAR_HATTI"))

            (if (and
                  (member layerName dalL)
                  (not (in-ref-infos? obj refInfos))
                  (not (handle-in-list? hCur processedPlineHandles))
                )

              (progn
                (setq ds (vlax-curve-getStartPoint obj))
                (setq de (vlax-curve-getEndPoint   obj))

                (setq bestMesafe nil
                      bestPx     nil
                      bestPy     nil
                      bestRobj   nil)

                (foreach info refInfos
                  (setq robj      (car  info))
                  (setq baseParam (cadr info))
                  (setq baseDist  (caddr info))

                  (setq cpt (deg-safe-closest-point robj ds))
                  (if (< (distance ds cpt) tolRefDal)
                    (progn
                      (setq connOnRobj    cpt)
                      (setq paramConnRobj (deg-safe-dist-at-point robj connOnRobj))
                      (setq mesafeTmp (+ baseDist (abs (- paramConnRobj baseParam))))
                      (if (or (not bestMesafe) (< mesafeTmp bestMesafe))
                        (progn
                          (setq bestMesafe mesafeTmp)
                          (setq bestPx (car cpt))
                          (setq bestPy (cadr cpt))
                          (setq bestRobj robj)
                          (setq bestEnd "S")
                        )
                      )
                    )
                  )

                  (setq cpt (deg-safe-closest-point robj de))
                  (if (< (distance de cpt) tolRefDal)
                    (progn
                      (setq connOnRobj    cpt)
                      (setq paramConnRobj (deg-safe-dist-at-point robj connOnRobj))
                      (setq mesafeTmp (+ baseDist (abs (- paramConnRobj baseParam))))
                      (if (or (not bestMesafe) (< mesafeTmp bestMesafe))
                        (progn
                          (setq bestMesafe mesafeTmp)
                          (setq bestPx (car cpt))
                          (setq bestPy (cadr cpt))
                          (setq bestRobj robj)
                          (setq bestEnd "E")
                        )
                      )
                    )
                  )
                )

                (if bestMesafe
                  (progn
                    (setq rootPt (list bestPx bestPy 0.0))
                    (setq blockMesafe 0.0)
                    (if (and blkSS bestEnd (not kitLayerP))
                      (progn
                        (setq bestBlockDist nil)
                        (setq totalLen (vla-get-length obj))
                        (setq j 0)
                        (while (< j (sslength blkSS))
                          (setq blkEnt (ssname blkSS j)
                                blkObj (vlax-ename->vla-object blkEnt))
                          (setq blkName (deg-block-name blkObj))
                          (if (not (= blkName (DEG:VAL 'P1)))
                            (progn
                              (setq tolChainLocal (deg-block-tol tolChain blkObj))
                              (if (deg-poly-touch-block-base-p obj blkObj tolChainLocal)
                                (progn
                                  (setq insPt  (deg-get-inspt blkObj))
                                  (setq projPt (deg-safe-closest-point obj insPt))
                                  (setq distFromStart (deg-safe-dist-at-point obj projPt))
                                  (setq distFromRef
                                        (cond
                                          ((= bestEnd "S") distFromStart)
                                          ((= bestEnd "E") (- totalLen distFromStart))
                                          (T distFromStart)))
                                  (if (or (not bestBlockDist) (< distFromRef bestBlockDist))
                                    (setq bestBlockDist distFromRef)
                                  )
                                )
                              )
                            )
                          )
                          (setq j (1+ j))
                        )
                        (if bestBlockDist
                          (setq blockMesafe bestBlockDist)
                          (setq blockMesafe 0.0)
                        )
                      )
                    )

                    (setq mesafe bestMesafe
                          px     bestPx
                          py     bestPy)

                    (if (and testMode px py)
                      (progn
                        (deg-ensure-layer (DEG:VAL 'R2) (DEG:CFG-ACI-OR 'DGT_SORTI_COLOR 4))
                        (DEG-DGT--make-circle
                          (list px py 0.0)
                          10.0
                          (DEG:VAL 'R2)
                          (DEG:CFG-ACI-OR 'DGT_SORTI_COLOR 4)
                        )
                      )
                    )

                    (setq queue               (list obj))
                    (setq visitedPlineHandles (list hCur))
                    (setq visitedBlockHandles '())
                    (setq chainPlines         '())
                    (setq chainBlocks         '())

                    (while queue
                      (setq curPline (car queue)
                            queue    (cdr queue))

                      (setq chainPlines (cons curPline chainPlines))

                      (if (and blkSS (not kitLayerP))
                        (progn
                          (setq j 0)
                          (while (< j (sslength blkSS))
                            (setq blkEnt (ssname blkSS j))
                            (setq blkObj (vlax-ename->vla-object blkEnt))
                            (setq hB     (vlax-get blkObj 'Handle))
                            (setq blkName (deg-block-name blkObj))
                            (setq insPt (deg-get-inspt blkObj))

                            (setq tolChainLocal  (deg-block-tol (if (= blkName (DEG:VAL 'P1)) (DEG:CFG-TOL-NUM-OR 'DG_P1_TOL 3.0) tolChain) blkObj))
                            (setq tolReportLocal (deg-block-tol (if (= blkName (DEG:VAL 'P1)) (DEG:CFG-TOL-NUM-OR 'DG_P1_TOL 3.0) tolReport) blkObj))
                            (setq rootBridgeP
                              (and rootPt insPt
                                   (<= (distance rootPt insPt)
                                       (max tolRefDal tolChainLocal))))

                            (setq touchChain  (deg-poly-touch-block-base-p curPline blkObj tolChainLocal))
                            (setq touchReport (deg-poly-touch-block-base-p curPline blkObj tolReportLocal))

                            (if (or touchChain touchReport)
                              (progn
                                (if (and touchReport
                                         (not (handle-in-list? hB visitedBlockHandles)))
                                  (progn
                                    (setq visitedBlockHandles (cons hB visitedBlockHandles))
                                    (setq chainBlocks         (cons blkObj chainBlocks))

                                    (if (and testMode
                                             (not (handle-in-list? hB markedTol30Handles)))
                                      (progn
                                        (setq markedTol30Handles (cons hB markedTol30Handles))
                                        (setq rad (if (and (= (type blkRefObj) 'VLA-OBJECT)
                   (= hB (vlax-get blkRefObj 'Handle)))
              tolRef
              tolReportLocal))
                                        (deg-make-circle (deg-get-inspt blkObj) rad)
                                      )
                                    )
                                  )
                                )

                                (if (and touchChain
                                         (not (= blkName (DEG:VAL 'P1)))
                                         (not rootBridgeP))
                                  (progn
                                    (if (and testMode
                                             (not (handle-in-list? hB markedTol7Handles)))
                                      (progn
                                        (setq markedTol7Handles (cons hB markedTol7Handles))
                                        (deg-make-circle (deg-get-inspt blkObj) tolChainLocal)
                                      )
                                    )

                                    (setq k 0)
                                    (while (< k (sslength ss))
                                      (setq other    (ssname ss k)
                                            otherObj (vlax-ename->vla-object other))
                                      (setq hP (vlax-get otherObj 'Handle))
                                      (setq otherLayer (norm-layer (vlax-get otherObj 'Layer)))

                                      (if (and
                                            (member otherLayer dalL)
                                            (not (in-ref-infos? otherObj refInfos))
                                            (not (handle-in-list? hP visitedPlineHandles))
                                            (deg--dp-same-layer-family-p layerName otherLayer)
                                            (deg-poly-touch-block-base-p otherObj blkObj tolChainLocal)
                                          )
                                        (progn
                                          (setq visitedPlineHandles
                                                (cons hP visitedPlineHandles))
                                          (setq queue (cons otherObj queue))
                                        )
                                      )
                                      (setq k (1+ k))
                                    )
                                  )
                                )
                              )
                            )

                            (setq j (1+ j))
                          )
                        )
                      )

                      ;; Blok olmayan, gercekten uc uca devam eden dal parcalarini
                      ;; da izle. Ortak ana-hat kokunde kardes dallar birlestirilmez.
                      (setq k 0)
                      (while (< k (sslength ss))
                        (setq other    (ssname ss k)
                              otherObj (vlax-ename->vla-object other)
                              hP       (vlax-get otherObj 'Handle)
                              otherLayer (norm-layer (vlax-get otherObj 'Layer)))
                        (if (and
                              (member otherLayer dalL)
                              (not (in-ref-infos? otherObj refInfos))
                              (not (handle-in-list? hP visitedPlineHandles))
                              (deg--dp-same-layer-family-p layerName otherLayer)
                              (setq endConnPt
                                (deg-curves-endpoint-connection
                                  curPline otherObj tolChain))
                              (or (null rootPt)
                                  (> (distance rootPt endConnPt) tolRefDal)))
                          (progn
                            (setq visitedPlineHandles
                              (cons hP visitedPlineHandles))
                            (setq queue (cons otherObj queue))
                          )
                        )
                        (setq k (1+ k))
                      )
                    )

                    (if testMode (color-red chainPlines))

                    (foreach p chainPlines
                      (setq processedPlineHandles
                            (cons (vlax-get p 'Handle) processedPlineHandles))
                    )

                    (setq toplamUzunluk 0.0)
                    (foreach p chainPlines
                      (setq toplamUzunluk (+ toplamUzunluk (vla-get-length p)))
                    )

                    (setq toplam (+ mesafe toplamUzunluk))
                    (setq blockMesafe 0.0)
                    (if (and blkSS chainPlines (not kitLayerP))
                      (progn
                        (setq chainList (reverse chainPlines))
                        (setq bestBlockDistChain nil)

                        (setq j 0)
                        (while (< j (sslength blkSS))
                          (setq blkEnt (ssname blkSS j)
                                blkObj (vlax-ename->vla-object blkEnt))
                          (setq blkName (deg-block-name blkObj)
                                nm      (strcase blkName))

                          (if (not (or (= nm (DEG:VAL 'P1))
                                       (wcmatch nm (DEG:VAL 'I3))
                                       (wcmatch nm (DEG:VAL 'M2))
                                       (wcmatch nm (DEG:VAL 'J4))))
                            (progn
                              (setq insPt (deg-get-inspt blkObj))

                              (setq tolChainLocal
                                    (cond
                                      ((wcmatch nm (DEG:VAL 'I4))      7.0)
                                      ((= nm (DEG:VAL 'M1))     7.0)
                                      ((= nm (DEG:VAL 'P1))             3.0)
                                      (T
                                       (setq res (vl-catch-all-apply
                                                   'vla-getBoundingBox
                                                   (list blkObj 'minVar 'maxVar)))
                                       (if (vl-catch-all-error-p res)
                                         40.0
                                         (progn
                                           (setq minPt (vlax-safearray->list minVar)
                                                 maxPt (vlax-safearray->list maxVar)
                                                 xmin (car minPt)
                                                 ymin (cadr minPt)
                                                 xmax (car maxPt)
                                                 ymax (cadr maxPt)
                                                 c1   (list xmin ymin 0.0)
                                                 c2   (list xmin ymax 0.0)
                                                 c3   (list xmax ymin 0.0)
                                                 c4   (list xmax ymax 0.0)
                                                 ins2 (deg-get-inspt blkObj)
                                                 r    (apply 'max
                                                             (mapcar
                                                               '(lambda (p) (distance ins2 p))
                                                               (list c1 c2 c3 c4)))
                                           )
                                           (if (< r 30.0)
                                             r
                                             40.0
                                           )
                                         )
                                       )
                                      )
                                    )
                              )

                              (setq offset 0.0)

                              (foreach pl chainList
                                (if (deg-poly-touch-block-base-p pl blkObj tolChainLocal)
                                  (progn
                                    (setq projPt        (deg-safe-closest-point pl insPt))
                                    (setq distFromStart (deg-safe-dist-at-point pl projPt))
                                    (setq lenPl         (vla-get-length pl))

                                    (setq localDist
                                          (if (and bestEnd (eq pl obj))
                                            (cond
                                              ((= bestEnd "S") distFromStart)
                                              ((= bestEnd "E") (- lenPl distFromStart))
                                              (T              distFromStart))
                                            distFromStart))

                                    (setq totalDist (+ offset localDist))

                                    (if (or (not bestBlockDistChain)
                                            (< totalDist bestBlockDistChain))
                                      (setq bestBlockDistChain totalDist)
                                    )
                                  )
                                )
                                (setq offset (+ offset (vla-get-length pl)))
                              )
                            )
                          )

                          (setq j (1+ j))
                        )

                        (if bestBlockDistChain
                          (setq blockMesafe bestBlockDistChain)
                          (progn
                            (setq blockMesafe 0.0)
                            (if chainBlocks
                              (progn
                                (setq hasValidBlock nil)
                                (foreach b chainBlocks
                                  (setq nm (strcase (deg-block-name b)))
                                  (if (not (or (= nm (DEG:VAL 'P1))
                                               (wcmatch nm (DEG:VAL 'I3))
                                               (wcmatch nm (DEG:VAL 'M2))
                                               (wcmatch nm (DEG:VAL 'J4))))
                                    (setq hasValidBlock T)
                                  )
                                )
                                (if hasValidBlock
                                  (progn
                                    (setq len (vla-get-length obj))
                                    (setq blockMesafe len)
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )


                    (setq adetFactor 1)
                    (foreach b chainBlocks
                      (setq adetRaw (get-adet-from-block b))
                      (if (> adetRaw 0)
                        (if (= adetFactor 1)
                          (setq adetFactor adetRaw)
                          (if (> adetRaw adetFactor)
                            (setq adetFactor adetRaw)
                          )
                        )
                      )
                    )

                    (setq toplamx nil)
                    (if (deg--layer-is-data-tv-tel layerName)
                      (setq toplamx (* toplam adetFactor))
                    )
                    (if (not *DEG-BLOCK-WRITTEN*)
                      (setq *DEG-BLOCK-WRITTEN* '()))
                    (setq myBlocks '())
                    (if chainBlocks
                      (foreach b chainBlocks
                        (setq blkName (deg-block-name b)
                              nm      (strcase blkName)
                              hB      (vlax-get b 'Handle))
                        (cond
                          ((or (= nm (DEG:VAL 'I1))
                               (= nm (DEG:VAL 'I2))
                               (= nm (DEG:VAL 'M1)))
                           (setq myBlocks (cons b myBlocks)))
                          (T
                           (if (not (member (deg--dp-block-written-key hB layerName) *DEG-BLOCK-WRITTEN*))
                             (progn
                               (setq myBlocks (cons b myBlocks))
                               (setq *DEG-BLOCK-WRITTEN*
                                     (cons (deg--dp-block-written-key hB layerName) *DEG-BLOCK-WRITTEN*))
                             )
                           )
                          )
                        )
                      )
                    )

                    (setq len (vla-get-length obj))

                    (if (null blockMesafe)
                      (setq blockMesafe mesafe)
                    )

                    (setq dataList
                          (append dataList
                                  (deg-build-data-rows-by-linye myBlocks layerName mesafe len blockMesafe toplam kitLayerP)))
)
                )
              )
            )

            (setq i (1+ i))
          )

          
(if (and blkSS refInfos)
            (progn
              (setq tolDalSingle (DEG:CFG-TOL-NUM-OR 'DG_DAL_SINGLE_TOL 5.0))
              (setq *deg-ref-grid* (deg-build-ref-grid refInfos *deg-grid-size*))
              (setq i 0)
              (while (< i (sslength blkSS))
                (setq blkEnt  (ssname blkSS i)
                      blkObj  (vlax-ename->vla-object blkEnt)
                      blkName (deg-block-name blkObj))


(setq trunkObj    nil
      bestDist    nil
      bestCp      nil
      trunkObjEnd nil
      bestEndDist nil
      bestEndCp   nil)

(setq insPt (deg-get-inspt blkObj))

(setq trunkObj nil
      bestDist nil
      bestCp   nil)

(setq candList (deg-grid-candidates *deg-ref-grid* insPt *deg-grid-size*))

                  (if (null candList)
                    (setq candList (mapcar 'car refInfos))
                  )


(foreach robj candList
  (if (and (null trunkObj) robj (vlax-curve-p robj)
           (deg-poly-touch-block-base-p robj blkObj tolDalSingle))
    (progn
      (setq bestCp   (deg-safe-closest-point robj insPt))
      (setq bestDist (distance insPt bestCp))
      (setq trunkObj robj)
    )
  )
)
(if trunkObj
  (progn
    (if (or (= blkName (DEG:VAL 'P1))
            (= blkName (DEG:VAL 'I1))
            (= blkName (DEG:VAL 'I2))
            (deg-wcmatch blkName (DEG:VAL 'M2))
        )
      (progn
      )
      (progn
        (if (> bestDist 30.0)
          (progn
            (setq trunkObj nil)
            (setq bestCp   nil)
          )
        )
      )
    )
  )
)

                (if (and trunkObj bestDist (< bestDist tolDalSingle))
                  (progn
                    (setq trunkInfo (ref-find-info trunkObj refInfos))
                    (if trunkInfo
                      (progn
                        (setq baseParam (cadr  trunkInfo)
                              baseDist  (caddr trunkInfo))

                        (setq cp_ref bestCp)

                        (setq sp (vlax-curve-getStartPoint trunkObj)
                              ep (vlax-curve-getEndPoint   trunkObj))
                        (if (or (< (distance cp_ref sp) tolDalSingle)
                                (< (distance cp_ref ep) tolDalSingle))
                          (progn
                            (setq paramConnRobj (deg-safe-dist-at-point trunkObj cp_ref))
                            (setq mesafe (+ baseDist (abs (- paramConnRobj baseParam))))
                            (setq len    0.0)
                            (setq toplam mesafe)
                            (setq chainBlocks (list blkObj))

                            (if blkSS
                              (progn
                                (setq j 0)
                                (while (< j (sslength blkSS))
                                  (setq blkEnt2  (ssname blkSS j)
                                        blkObj2  (vlax-ename->vla-object blkEnt2)
                                        blkName2 (deg-block-name blkObj2))
                                  (if (and (= blkName2 (DEG:VAL 'P1))
                                           (/= (vlax-get blkObj2 'Handle)
                                               (vlax-get blkObj  'Handle))
                                           (deg-poly-touch-block-base-p
                                             trunkObj
                                             blkObj2
                                             (DEG:CFG-TOL-NUM-OR 'DG_P1_TOL 3.0))
                                           (equal (get-linye-numarasýi-from-block blkObj2)
                                                  (get-linye-numarasýi-from-block blkObj))
                                      )
                                    (setq chainBlocks (cons blkObj2 chainBlocks))
                                  )
                                  (setq j (1+ j))
                                )
                              )
                            )

                            (setq adetFactor 1)
                            (foreach b chainBlocks
                              (setq adetRaw (get-adet-from-block b))
                              (if (> adetRaw 0)
                                (if (= adetFactor 1)
                                  (setq adetFactor adetRaw)
                                  (if (> adetRaw adetFactor)
                                    (setq adetFactor adetRaw)
                                  )
                                )
                              )
                            )

                            (setq layerName (norm-layer (vlax-get trunkObj 'Layer)))
                            (setq toplamx nil)
                            (if (deg--layer-is-data-tv-tel layerName)
                              (setq toplamx (* toplam adetFactor))
                            )

                            (setq dataList
                                  (append dataList
                                          (deg-build-data-rows-by-linye chainBlocks layerName mesafe len mesafe toplam nil)))

                            (if testMode
                              (deg-make-circle (deg-get-inspt blkObj) tolDalSingle)
                            )
                          )
                        )
                      )
                    )
                  )
                )

                (setq i (1+ i))
              )
            )
          )


          
          (setq directRefRows '())
          (if (and blkSS refInfos)
            (progn
              (setq j 0)
              (while (< j (sslength blkSS))
                (setq blkEnt (ssname blkSS j)
                      blkObj (vlax-ename->vla-object blkEnt)
                      blkName (deg-block-name blkObj))

                (if (and blkName (wcmatch blkName "E_*"))
                  (progn
                    (setq tolReportLocal (deg-block-tol (if (= blkName (DEG:VAL 'P1)) (DEG:CFG-TOL-NUM-OR 'DG_P1_TOL 3.0) tolReport) blkObj))

                    (setq bestRefObj2 nil
                          bestRefPt2  nil
                          bestRefD2   nil)

                    (foreach info refInfos
                      (setq robj (car info))
                      (if (deg-poly-touch-block-base-p robj blkObj tolReportLocal)
                        (progn
                          (setq insPt (deg-get-inspt blkObj))
                          (setq cpt   (deg-safe-closest-point robj insPt))
                          (setq candD (distance insPt cpt))
                          (if (or (not bestRefD2) (< candD bestRefD2))
                            (setq bestRefD2  candD
                                  bestRefObj2 robj
                                  bestRefPt2  cpt)
                          )
                        )
                      )
                    )

                    (if bestRefObj2
                      (progn
                        (setq info2 (ref-find-info bestRefObj2 refInfos))
                        (if info2
                          (progn
                            (setq baseParam (cadr info2)
                                  baseDist  (caddr info2))

                            (setq paramCP (deg-safe-dist-at-point bestRefObj2 bestRefPt2))
                            (setq mesafe  (+ baseDist (abs (- paramCP baseParam))))
                            (setq len     0.0)
                            (setq toplam  mesafe)
                            (setq extraBlocks (deg-ss-blocks-touching-poly bestRefObj2 blkSS tolReportLocal blkObj))
                            (setq chainBlocks (deg-uniq-vla-by-handle (cons blkObj extraBlocks)))
                            (setq layerName (norm-layer (vlax-get bestRefObj2 'Layer)))
                            (setq kitLayerP (wcmatch (deg-norm layerName) "*KIT*,E_ANAHTAR_HATTI"))

                            ;; Dal satirinda kullanilmis ortak kok blogunu ana hat
                            ;; satirinda ikinci kez raporlama.
                            (setq myBlocks '())
                            (foreach b chainBlocks
                              (setq hB (vlax-get b 'Handle)
                                    writtenKey
                                      (deg--dp-block-written-key hB layerName))
                              (if (not (member writtenKey *DEG-BLOCK-WRITTEN*))
                                (progn
                                  (setq myBlocks (cons b myBlocks))
                                  (setq *DEG-BLOCK-WRITTEN*
                                    (cons writtenKey *DEG-BLOCK-WRITTEN*))
                                )
                              )
                            )
                            (if myBlocks
                              (setq directRefRows
                                (append directRefRows
                                  (deg-build-data-rows-by-linye
                                    myBlocks layerName mesafe len mesafe toplam kitLayerP)))
                            )
                          )
                        )
                      )
                    )
                  )
                )

                (setq j (1+ j))
              )
            )
          )

          (if directRefRows
            (setq dataList (append dataList (reverse directRefRows)))
          )


(setq dataList
                (append dataList
                        (deg-build-knx-chain testMode blkRefObj ss blkSS)))

          (setq sortedList
            (vl-sort dataList
              '(lambda (a b / ka kb pa pb na nb)
                 (setq ka (parse-linye-key (car a))
                       kb (parse-linye-key (car b))
                       pa (car ka)
                       pb (car kb)
                       na (cdr ka)
                       nb (cdr kb))
                 (cond
                   ((< (strcase pa) (strcase pb)) T)
                   ((> (strcase pa) (strcase pb)) nil)
                   (T (< na nb))))))
        )
      )
    )
  )
  sortedList
)

(defun sanitize-filename (name / res i c)
  (if (not name) (setq name "output"))
  (setq name (vl-string-translate "\n\r\t" "   " name))
  (setq res "")
  (setq i 1)
  (while (<= i (strlen name))
    (setq c (substr name i 1))
    (if (wcmatch c "[\\/:*?\"<>|]")
      (setq c "_")
    )
    (setq res (strcat res c))
    (setq i (1+ i))
  )
  (setq res (vl-string-trim " " res))
  (if (= res "") (setq res "output"))
  res
)



(defun deg--blank? (s /)
  (or (null s) (= (vl-string-trim " \t\r\n" s) ""))
)

(defun deg--layer-is-priz-or-lighting (layer / n)
  (setq n (norm-layer layer))
  (or (member n (DEG:VALS '(B2 B4 B1 B3 A3 A5 A2 A4 G2 G4 G1 G3 C1 C2 C3 C4)))
      (DEGP--lighting-layer-name-p n))
)

(defun deg--layer-is-data (layer / u lst)
  (setq u (deg--norm-tr layer))
  (setq lst (mapcar 'deg--norm-tr (DEG:VALS '(C1 C2 C3 C4))))
  (or (wcmatch u (DEG:VAL 'C9))
      (member u lst)
  )
)

(defun deg-clear-deg-done-xdata ( / ss i e ed)
  (regapp (DEG:VAL 'R1))
  (setq ss (ssget "X" '((0 . "LWPOLYLINE"))))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq e (ssname ss i))
        (setq ed (entget e (DEG:VALS '(R1))))
        (if (assoc -3 ed)
          (progn
            (setq ed (vl-remove (assoc -3 ed) ed))
            (entmod ed)
            (entupd e)
          )
        )
        (setq i (1+ i))
      )
    )
