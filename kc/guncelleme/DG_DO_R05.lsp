(defun deg-nearest-vertex (plObj pickPt / ent ed typ elev pts e vd p bestPt bestD d)
  (vl-load-com)

  ;; Referans noktaya en yakin VERTEX'i bul (vlax-curve param/distance kullanmadan)
  ;; plObj: VLA-OBJECT veya ENAME
  ;; pickPt: (x y z) seçim noktasý

  (setq ent
    (cond
      ((= (type plObj) 'VLA-OBJECT) (vlax-vla-object->ename plObj))
      ((= (type plObj) 'ENAME) plObj)
      (T nil)
    )
  )

  (if (not (and ent pickPt))
    (if pickPt pickPt (list 0.0 0.0 0.0))
    (progn
      (setq ed  (entget ent))
      (setq typ (cdr (assoc 0 ed)))
      (setq elev (cdr (assoc 38 ed)))
      (if (not (numberp elev)) (setq elev 0.0))
      (if (and pickPt (= (length pickPt) 3))
        (setq pickPt (list (car pickPt) (cadr pickPt) elev))
      )
      (setq pts nil)

      (cond
        ;; LWPOLYLINE: vertexler DXF 10 gruplari
        ((= typ "LWPOLYLINE")
          (foreach vd ed
            (if (= (car vd) 10)
              (progn
                (setq p (cdr vd))
                (if (= (length p) 2)
                  (setq p (list (car p) (cadr p) elev))
                )
                (setq pts (cons p pts))
              )
            )
          )
          (setq pts (reverse pts))
        )

        ;; 2D/3D POLYLINE: VERTEX entity'lerini tara
        ((= typ "POLYLINE")
          (setq e (entnext ent))
          (while e
            (setq ed (entget e))
            (cond
              ((= (cdr (assoc 0 ed)) "VERTEX")
                (setq p (cdr (assoc 10 ed)))
                (if (= (length p) 2)
                  (setq p (list (car p) (cadr p) elev))
                )
                (setq pts (cons p pts))
                (setq e (entnext e))
              )
              ((= (cdr (assoc 0 ed)) "SEQEND")
                (setq e nil)
              )
              (T (setq e (entnext e)))
            )
          )
          (setq pts (reverse pts))
        )
      )

      (if (not pts)
        pickPt
        (progn
          (setq bestPt (car pts))
          (setq bestD  (distance bestPt pickPt))
          (foreach p (cdr pts)
            (setq d (distance p pickPt))
            (if (< d bestD)
              (progn (setq bestD d) (setq bestPt p))
            )
          )
          bestPt
        )
      )
    )
  )
)

(defun deg-make-temp-ref-block (insPt lay / bname ent)
  (vl-load-com)
  (setq bname "DEG_TMP_REF")
  (if (not (tblsearch "BLOCK" bname))
    (progn
      (entmake (list '(0 . "BLOCK") (cons 2 bname) '(70 . 0) (list 10 0.0 0.0 0.0)))
      (entmake (list '(0 . "POINT") '(8 . "0") (list 10 0.0 0.0 0.0)))
      (entmake '((0 . "ENDBLK")))
    )
  )
  (setq ent
    (entmakex
      (list '(0 . "INSERT")
            (cons 2 bname)
            (cons 8 (if lay lay "0"))
            (cons 10 insPt)
            (cons 41 1.0) (cons 42 1.0) (cons 43 1.0)
            (cons 50 0.0))
    )
  )
  ent
)

