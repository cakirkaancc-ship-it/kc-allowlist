(defun connection-point (o1 o2 tol / res lst p1a p1b p2a p2b hit)
  (setq res
    (vl-catch-all-apply
      (function
        (lambda ()
          (vlax-invoke o1 'IntersectWith o2 0)))))
  (if (not (vl-catch-all-error-p res))
    (progn
      (setq lst (vl-catch-all-apply 'DEG:PT->LIST (list res)))
      (if (vl-catch-all-error-p lst) (setq lst nil))
      (if (and (listp lst) (>= (length lst) 2))
        (setq hit (list (nth 0 lst) (nth 1 lst) 0.0))
      )
    )
  )
  (if hit
    hit
    (progn
      (setq p1a (vlax-curve-getStartPoint o1))
      (setq p1b (vlax-curve-getEndPoint   o1))
      (setq p2a (vlax-curve-getStartPoint o2))
      (setq p2b (vlax-curve-getEndPoint   o2))
      (cond
        ((< (distance p1a p2a) tol) p1a)
        ((< (distance p1a p2b) tol) p1a)
        ((< (distance p1b p2a) tol) p1b)
        ((< (distance p1b p2b) tol) p1b)
        (T nil)
      )
    )
  )
)

(defun deg-endpoint-pair-connection (a1 a2 b1 b2 tol / pairs pair best bestD d)
  (setq pairs (list (list a1 b1) (list a1 b2) (list a2 b1) (list a2 b2))
        best nil
        bestD nil)
  (foreach pair pairs
    (if (and (deg-pt3 (car pair)) (deg-pt3 (cadr pair)))
      (progn
        (setq d (distance (deg-pt3 (car pair)) (deg-pt3 (cadr pair))))
        (if (and (<= d tol) (or (null bestD) (< d bestD)))
          (setq bestD d
                best
                  (list
                    (/ (+ (car (car pair)) (car (cadr pair))) 2.0)
                    (/ (+ (cadr (car pair)) (cadr (cadr pair))) 2.0)
                    (/ (+ (if (caddr (car pair)) (caddr (car pair)) 0.0)
                          (if (caddr (cadr pair)) (caddr (cadr pair)) 0.0))
                       2.0)))
        )
      )
    )
  )
  best
)

(defun deg-curves-endpoint-connection (o1 o2 tol / a1 a2 b1 b2)
  (if (and o1 o2)
    (progn
      (setq a1 (vl-catch-all-apply 'vlax-curve-getStartPoint (list o1))
            a2 (vl-catch-all-apply 'vlax-curve-getEndPoint   (list o1))
            b1 (vl-catch-all-apply 'vlax-curve-getStartPoint (list o2))
            b2 (vl-catch-all-apply 'vlax-curve-getEndPoint   (list o2)))
      (if (or (vl-catch-all-error-p a1)
              (vl-catch-all-error-p a2)
              (vl-catch-all-error-p b1)
              (vl-catch-all-error-p b2))
        nil
        (deg-endpoint-pair-connection a1 a2 b1 b2 tol)
      )
    )
  )
)

