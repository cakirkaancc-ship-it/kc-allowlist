)

(defun DEG-DGT--set-color-aci (x aci / e o)
  (setq e (deg--to-ename x))
  (if e
    (progn
      (DEG-DGT--mark-color e)
      (setq o (vlax-ename->vla-object e))
      (if o
        (vl-catch-all-apply
          '(lambda ()
             (if (vlax-property-available-p o 'Color)
               (vla-put-Color o aci)
             )
           )
          nil
        )
      )
    )
  )
  e
)

(defun DEG-DGT-RESET (/ ss i e vals kind c62s c420s c430s lay delLayers resetCnt delCnt)
  (vl-load-com)
  (DEG-DGT--regapp)
  (setq resetCnt 0 delCnt 0)
  (setq ss (ssget "_X" '((0 . "LINE,LWPOLYLINE,POLYLINE"))))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq e (ssname ss i))
        (setq vals (DEG-DGT--xdata-strings e))
        (if (and vals (= (car vals) "COLOR"))
          (progn
            (setq c62s  (cadr vals))
            (setq c420s (caddr vals))
            (setq c430s (cadddr vals))
            (DEG-DGT--restore-color e c62s c420s c430s)
            (DEG-DGT--clear-xdata e)
            (setq resetCnt (1+ resetCnt))
          )
        )
        (setq i (1+ i))
      )
    )
  )
  (setq delLayers (mapcar 'norm-layer (list (DEG:TOL 'Q1) (DEG:TOL 'Q2) (DEG:VAL 'R2))))
  (setq ss (ssget "_X" '((0 . "CIRCLE"))))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq e (ssname ss i))
        (setq kind (DEG-DGT--xdata-kind e))
        (setq lay (norm-layer (cdr (assoc 8 (entget e)))))
        (if (or (and kind (= kind "CIRCLE")) (member lay delLayers))
          (progn
            (entdel e)
            (setq delCnt (1+ delCnt))
          )
        )
        (setq i (1+ i))
      )
    )
  )
  (DEG:WIN-MESSAGE (strcat "DGT reset tamamlandi.\nPolyline renkleri: " (itoa resetCnt) "\nSilinen cember: " (itoa delCnt)))
  (princ)
)

