(defun deg-fmt-int (v / x)
  (setq x (DEG:LEN-CONVERT v))
  (if (>= x 0.0)
    (fix (+ x 0.5))
    (- (fix (+ (abs x) 0.5)))
  )
)

(defun deg--sorti-metraj (row / s bm)
