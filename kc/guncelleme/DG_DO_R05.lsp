(defun DEGQ:_append-unique-by-handle (hChain chain addList / e h)
  (foreach e addList
    (if (and e (= (type e) 'ENAME))
      (progn
        (setq h (DEGQ:_ename-handle e))
        (if (and h (not (DEGQ:_handle-in-list h hChain)))
          (progn
            (setq hChain (cons h hChain))
            (setq chain  (cons e chain))
          )
        )
      )
    )
  )
  (list hChain chain)
)

