  (while (and (null cand) (< j (min 12 n)))
    (setq k (+ idx (* dir j)))
    (if isClosed
      (setq k (g412_wrap_index k n))
      (if (or (< k 0) (>= k n)) (setq k nil))
    )
    (if k
      (progn
        (setq cand (nth k pts))
        (if (or (null cand) (<= (distance cand bpt) minD))
          (setq cand nil)
        )
      )
    )
    (setq j (1+ j))
  )
  (if cand cand (if isClosed (g376_nth_wrap pts (+ idx dir)) (g376_nth_safe pts (+ idx dir))))
)

(defun g413_inter_line (a b c d / x1 y1 x2 y2 x3 y3 x4 y4 den t1 t2 x y)
  (if (and a b c d)
    (progn
      (setq x1 (car a)  y1 (cadr a))
      (setq x2 (car b)  y2 (cadr b))
      (setq x3 (car c)  y3 (cadr c))
      (setq x4 (car d)  y4 (cadr d))
      (setq den (- (* (- x1 x2) (- y3 y4)) (* (- y1 y2) (- x3 x4))))
      (if (< (abs den) 1e-12)
        nil
        (progn
          (setq t1 (- (* x1 y2) (* y1 x2)))
          (setq t2 (- (* x3 y4) (* y3 x4)))
          (setq x (/ (- (* t1 (- x3 x4)) (* (- x1 x2) t2)) den))
          (setq y (/ (- (* t1 (- y3 y4)) (* (- y1 y2) t2)) den))
          (list x y)
        )
      )
    )
    nil
  )
)

