)

(defun DEGV:_pt (x y) (list x y 0.0))

(defun DEGV:_dist2d (p q)
  (sqrt
    (+ (expt (- (car p) (car q)) 2.0)
       (expt (- (cadr p) (cadr q)) 2.0))
  )
)

(defun DEGV:_bbox-sample-pts (mn mx / x1 y1 x2 y2 xc yc)
  (setq x1 (car mn)  y1 (cadr mn))
  (setq x2 (car mx)  y2 (cadr mx))
  (setq xc (/ (+ x1 x2) 2.0))
  (setq yc (/ (+ y1 y2) 2.0))
  (list
    (DEGV:_pt x1 y1) (DEGV:_pt x2 y1) (DEGV:_pt x2 y2) (DEGV:_pt x1 y2)
    (DEGV:_pt xc y1) (DEGV:_pt x2 yc) (DEGV:_pt xc y2) (DEGV:_pt x1 yc)
    (DEGV:_pt xc yc)
  )
)

(defun DEGV:_min-dist-pts-to-curve (e pts / i p cp d mind)
  (setq mind 1e99)
  (setq i 0)
  (while (< i (length pts))
    (setq p (nth i pts))
    (setq cp (vlax-curve-getclosestpointto e p))
    (if cp
      (progn
        (setq d (DEGV:_dist2d p cp))
        (if (< d mind) (setq mind d))
      )
    )
    (setq i (1+ i))
  )
  mind
)

