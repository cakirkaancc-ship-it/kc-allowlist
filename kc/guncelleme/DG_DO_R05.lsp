(defun DEG:PLAN-UNIT-KEY (/ v)
  (setq v (strcase (DEGDO--trim (DEG:CFG-GET 'PLAN_UNIT))))
  (cond
    ((= v "CM") "cm")
    ((or (= v "METRE") (= v "M")) "m")
    (T "mm")
  )
)

(defun DEG:LEN-DIVISOR (/ u)
  (setq u (DEG:PLAN-UNIT-KEY))
  (cond
    ((= u "mm") 1000.0)
    ((= u "cm") 100.0)
    (T 1.0)
  )
)

(defun DEG:LEN-CONVERT (v / x)
  (cond
    ((= (type v) 'STR)
      (setq x (atof (vl-string-subst "." "," v)))
    )
    ((numberp v)
      (setq x (float v))
    )
    (T
      (setq x 0.0)
    )
  )
  (/ x (DEG:LEN-DIVISOR))
)

(defun DEG:LEN-UNIT-LABEL ()
  (DEG:PLAN-UNIT-KEY)
)

(defun DEG:LEN-HEADER (label)
  (strcat label " (" (DEG:LEN-UNIT-LABEL) ")")
)

(defun DEG:DP-LEN-STR (v / x s)
  (setq x (DEG:LEN-CONVERT v))
  (if (< (abs x) 1.0)
    (progn
      (setq s (rtos x 2 2))
      (vl-string-subst "," "." s)
    )
    (itoa (deg-fmt-int v))
  )
)

(defun deg-fmt3 (v / s)
  (setq s (rtos (DEG:LEN-CONVERT v) 2 3))
  (vl-string-subst "," "." s)
)





(defun deg--pad3 (n / s)
  (setq s (itoa n))
  (cond
    ((= (strlen s) 1) (strcat "00" s))
    ((= (strlen s) 2) (strcat "0" s))
    (T s)
  )
)

(defun deg-fmt3fixed (v / x sgn ip fp n)
  (setq x (DEG:LEN-CONVERT v))
  (setq sgn (if (< x 0.0) "-" ""))
  (setq x (abs x))
  (setq n (fix (+ (* x 1000.0) 0.5)))
  (setq ip (fix (/ n 1000)))
  (setq fp (rem n 1000))
  (strcat sgn (itoa ip) "," (deg--pad3 fp))
)

(defun deg-fmt3t (v)
  (deg-fmt3fixed v)
)







(defun deg-excel-format-cd-3dec (csvPath / xl wbs wb ws rng)
  (vl-load-com)
  (if (and csvPath (/= csvPath ""))
