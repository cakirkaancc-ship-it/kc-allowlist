    (assoc 'C1 *DEG_CODE_OVERRIDES*)
    (assoc 'C2 *DEG_CODE_OVERRIDES*)
    (assoc 'C3 *DEG_CODE_OVERRIDES*)
    (assoc 'C4 *DEG_CODE_OVERRIDES*)
  )
)

(defun DEGP--apply-data-code-overrides (/ lineLayers combLayers)
  (setq lineLayers (DEGDO--join-layers (DEGP--data-line-layers)))
  (setq combLayers (DEGDO--join-layers (DEGP--data-comb-layers)))
  (setq *DEG_CODE_OVERRIDES* (DEG:ALIST-PUT *DEG_CODE_OVERRIDES* 'C1 lineLayers))
  (setq *DEG_CODE_OVERRIDES* (DEG:ALIST-PUT *DEG_CODE_OVERRIDES* 'C2 lineLayers))
  (setq *DEG_CODE_OVERRIDES* (DEG:ALIST-PUT *DEG_CODE_OVERRIDES* 'C3 combLayers))
  (setq *DEG_CODE_OVERRIDES* (DEG:ALIST-PUT *DEG_CODE_OVERRIDES* 'C4 combLayers))
  (princ)
)

(defun DEGP--restore-data-code-snapshot (snap / item key)
  (foreach key '(C1 C2 C3 C4)
    (setq *DEG_CODE_OVERRIDES* (DEG:ALIST-DEL *DEG_CODE_OVERRIDES* key))
  )
  (foreach item snap
    (if item
      (setq *DEG_CODE_OVERRIDES*
        (DEG:ALIST-PUT *DEG_CODE_OVERRIDES* (car item) (cdr item))
      )
    )
  )
  (princ)
)
