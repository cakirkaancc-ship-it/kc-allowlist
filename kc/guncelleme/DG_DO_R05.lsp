(defun DEGV:_attval (blk key / atts lst a tval)
  (setq tval "")
  (if (and blk key)
    (progn
      (if (vlax-method-applicable-p blk 'GetAttributes)
        (progn
          (setq atts (vlax-invoke blk 'GetAttributes))
          (setq lst (cond
                      ((= (type atts) 'VARIANT)  (vlax-safearray->list (vlax-variant-value atts)))
                      ((= (type atts) 'SAFEARRAY) (vlax-safearray->list atts))
                      (T nil)
                    )
          )
          (foreach a lst
            (if (or
                  (= (strcase (vla-get-TagString a)) (strcase key))
                  (and (vlax-property-available-p a 'PromptString)
                       (= (strcase (vla-get-PromptString a)) (strcase key)))
                )
              (setq tval (vla-get-TextString a))
            )
          )
        )
      )
    )
  )
  tval
)




