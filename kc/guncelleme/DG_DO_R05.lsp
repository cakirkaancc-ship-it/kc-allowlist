(defun DEGN-DEGA--pl-touches-block-tol (plEname blkEname tol / ip hit plObj blkObj cp)
  (setq plObj  (DEGN-DEGA--vla plEname))
  (setq blkObj (DEGN-DEGA--vla blkEname))
  (setq ip (deg-get-inspt blkObj))
  (if ip
    (progn
      (setq ip (cond
                 ((and (listp ip) (= (length ip) 3)) ip)
                 ((and (listp ip) (= (length ip) 2)) (list (car ip) (cadr ip) 0.0))
                 (T (list 0.0 0.0 0.0))))
      (setq hit (DEGN-DEGA--pt->curve-hit ip plEname tol))
      (if (not hit)
        (progn
          (setq cp (block-ref-contact-point plObj blkObj tol))
          (if cp (setq hit (list cp 0.0)))
        )
      )
      hit
    )
