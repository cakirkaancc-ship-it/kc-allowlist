(defun g372_delete_assigned (keepEnt / scan pair ent delCnt skipCnt)
  (setq delCnt 0)
  (setq skipCnt 0)
  (setq scan g372_assigned)
  (while scan
    (setq pair (car scan))
    (setq ent (car pair))
    (if (and ent (/= ent keepEnt) (entget ent))
      (progn
        (if (vl-catch-all-error-p (vl-catch-all-apply 'entdel (list ent)))
          (setq skipCnt (1+ skipCnt))
          (setq delCnt (1+ delCnt))
        )
      )
    )
    (setq scan (cdr scan))
  )
  T
)

