    (T 'TOP)
  )
)

(defun DEGZ--pair-main-block-no-cross (blockSide pA pB iA iB / pa pb ia ib keepScore crossScore)
  ;; Dirsekli cizimde de polyline yonunu kullanma.
  ;; Iki olasi eslesmeden toplam baglanti mesafesi kisa olani sec.
  (setq pa (DEGZ--pt2d-safe pA nil))
  (setq pb (DEGZ--pt2d-safe pB nil))
  (setq ia (DEGZ--pt2d-safe iA nil))
  (setq ib (DEGZ--pt2d-safe iB nil))
  (if (and pa pb ia ib)
    (progn
      (setq keepScore
        (+ (DEGZ--safe-distance pa ia)
           (DEGZ--safe-distance pb ib))
      )
      (setq crossScore
        (+ (DEGZ--safe-distance pa ib)
           (DEGZ--safe-distance pb ia))
      )
      (if (< crossScore keepScore)
        (list pa pb ib ia)
        (list pa pb ia ib)
      )
    )
    (list pA pB iA iB)
  )
)
(defun DEGZ--side-from-connect-to-block (cp ip / c p dx dy)
  ;; Ana hatta baglanilacak noktadan block base/baglanti noktasina bak.
  ;; block sagdaysa LEFT, soldaysa RIGHT, ustteyse BOTTOM, alttaysa TOP.
  (setq c (DEGZ--pt2d cp))
  (setq p (DEGZ--pt2d ip))
  (setq dx (- (car p) (car c)))
  (setq dy (- (cadr p) (cadr c)))
  (cond
    ((>= (abs dx) (abs dy)) (if (>= dx 0.0) 'LEFT 'RIGHT))
    ((>= dy 0.0) 'BOTTOM)
    (T 'TOP)
  )
)
(defun DEGZ--side-from-group-alignment (cp ipAvg recs / side c p minX maxX minY maxY r rp spreadX spreadY)
  ;; Koseye yakin bir blok grubu cp->ip vektoruyle capraz gorunebilir.
  ;; Acikca yatay/dikey dizilmis gruplarda gelis yonunu grup ekseninin
  ;; dikinden bul; boylece ayna cizimlerde RIGHT/BOTTOM karari degismez.
  (setq side (DEGZ--side-from-connect-to-block cp ipAvg))
  (if (and recs (> (length recs) 1))
    (progn
      (foreach r recs
        (setq rp (DEGZ--pt2d-safe (cadr r) nil))
        (if rp
          (progn
            (if (or (null minX) (< (car rp) minX)) (setq minX (car rp)))
            (if (or (null maxX) (> (car rp) maxX)) (setq maxX (car rp)))
            (if (or (null minY) (< (cadr rp) minY)) (setq minY (cadr rp)))
            (if (or (null maxY) (> (cadr rp) maxY)) (setq maxY (cadr rp)))
          )
        )
      )
      (if (and minX maxX minY maxY)
        (progn
          (setq spreadX (- maxX minX)
                spreadY (- maxY minY)
                c (DEGZ--pt2d cp)
                p (DEGZ--pt2d ipAvg))
          (cond
            ((> spreadX (* 1.5 (max spreadY 1e-6)))
              (setq side (if (>= (cadr p) (cadr c)) 'BOTTOM 'TOP)))
            ((> spreadY (* 1.5 (max spreadX 1e-6)))
              (setq side (if (>= (car p) (car c)) 'LEFT 'RIGHT)))
          )
        )
      )
    )
  )
  side
)
(defun DEGZ--group-approach-unit (cp ipAvg recs / c p minX maxX minY maxY r rp spreadX spreadY)
  ;; Acikca yatay dizilen gruba dikey, dikey dizilen gruba yatay yaklas.
  ;; Koseye olan capraz en-yakin vektorunun blok bacagini yamultmasini engeller.
  (if (and recs (> (length recs) 1))
    (progn
      (foreach r recs
        (setq rp (DEGZ--pt2d-safe (cadr r) nil))
        (if rp
          (progn
            (if (or (null minX) (< (car rp) minX)) (setq minX (car rp)))
            (if (or (null maxX) (> (car rp) maxX)) (setq maxX (car rp)))
            (if (or (null minY) (< (cadr rp) minY)) (setq minY (cadr rp)))
            (if (or (null maxY) (> (cadr rp) maxY)) (setq maxY (cadr rp)))
          )
        )
      )
      (if (and minX maxX minY maxY)
        (progn
          (setq spreadX (- maxX minX)
                spreadY (- maxY minY)
                c (DEGZ--pt2d cp)
                p (DEGZ--pt2d ipAvg))
          (cond
            ((> spreadX (* 1.5 (max spreadY 1e-6)))
              (list 0.0 (if (>= (cadr p) (cadr c)) 1.0 -1.0)))
            ((> spreadY (* 1.5 (max spreadX 1e-6)))
              (list (if (>= (car p) (car c)) 1.0 -1.0) 0.0))
            (T nil)
          )
        )
      )
    )
  )
)
(defun DEGZ--normal-group-no-cross-side (cp ipAvg recs fallback / c p minX maxX minY maxY r rp spreadX spreadY eps)
  ;; Yalniz normal baglantida kullanilir. Yakin bloklarin dizilim eksenine
  ;; paralel yaklasmak bir bloktan digerinin icinden gecirir. Bu nedenle
  ;; yatay gruba ust/alt, dikey gruba sol/sag ortak taraftan yaklas.
  (setq c (DEGZ--pt2d-safe cp nil)
        p (DEGZ--pt2d-safe ipAvg nil)
        eps 1e-6)
  (if (and c p recs (> (length recs) 1))
    (progn
      (foreach r recs
        (setq rp (DEGZ--pt2d-safe (cadr r) nil))
        (if rp
          (progn
            (if (or (null minX) (< (car rp) minX)) (setq minX (car rp)))
            (if (or (null maxX) (> (car rp) maxX)) (setq maxX (car rp)))
            (if (or (null minY) (< (cadr rp) minY)) (setq minY (cadr rp)))
            (if (or (null maxY) (> (cadr rp) maxY)) (setq maxY (cadr rp))))))
      (if (and minX maxX minY maxY)
        (progn
          (setq spreadX (- maxX minX)
                spreadY (- maxY minY))
          (if (>= spreadX spreadY)
            (cond
              ((< (cadr c) (- (cadr p) eps)) 'BOTTOM)
              ((> (cadr c) (+ (cadr p) eps)) 'TOP)
              (T 'BOTTOM))
            (cond
              ((< (car c) (- (car p) eps)) 'LEFT)
              ((> (car c) (+ (car p) eps)) 'RIGHT)
              (T 'LEFT))))
        fallback))
    fallback)
)
(defun DEGZ--approach-unit-for-side (side)
  (cond
    ((eq side 'BOTTOM) '(0.0 1.0))
    ((eq side 'TOP)    '(0.0 -1.0))
    ((eq side 'LEFT)   '(1.0 0.0))
    ((eq side 'RIGHT)  '(-1.0 0.0))
    (T nil))
)
(defun DEGZ--corner-mouth-pair-by-approach (crv cp groupDir span / e center d tot dMin dPlus rMin rPlus pMin pPlus valMin valPlus candidate candidateD v1 v2 l1 l2 dotAbs)
  ;; Kosenin iki komsu segmentinden grup yaklasimina dik olani sec.
  ;; Boylece agiz yatay ve dikey kollar arasinda bolunmez.
  (setq e (DEGZ--ename crv))
  (if e
    (setq center (DEGZ--pt2d-safe (deg-safe-closest-point e cp) nil)))
  (if (and e center groupDir (> span 1e-6))
    (progn
      (setq d (deg-safe-dist-at-point e center)
            tot (DEGZ--curve-total e)
            dMin (max 0.0 (- d span))
            dPlus (min tot (+ d span))
            rMin (vl-catch-all-apply 'vlax-curve-getPointAtDist (list e dMin))
            rPlus (vl-catch-all-apply 'vlax-curve-getPointAtDist (list e dPlus))
            pMin (if (vl-catch-all-error-p rMin) nil (DEGZ--pt2d-safe rMin nil))
            pPlus (if (vl-catch-all-error-p rPlus) nil (DEGZ--pt2d-safe rPlus nil)))
      (if (> (abs (cadr groupDir)) (abs (car groupDir)))
        (setq valMin (if pMin (abs (- (car pMin) (car center))) -1.0)
              valPlus (if pPlus (abs (- (car pPlus) (car center))) -1.0))
        (setq valMin (if pMin (abs (- (cadr pMin) (cadr center))) -1.0)
              valPlus (if pPlus (abs (- (cadr pPlus) (cadr center))) -1.0)))
      (if (and pMin pPlus)
        (progn
          (setq v1 (list (- (car pMin) (car center)) (- (cadr pMin) (cadr center)))
                v2 (list (- (car pPlus) (car center)) (- (cadr pPlus) (cadr center)))
                l1 (distance '(0.0 0.0) v1)
                l2 (distance '(0.0 0.0) v2))
          (if (and (> l1 (* span 0.5)) (> l2 (* span 0.5)))
            (setq dotAbs
              (abs (/ (+ (* (car v1) (car v2)) (* (cadr v1) (cadr v2))) (* l1 l2)))))))
      (if (and dotAbs (< dotAbs 0.25))
        ;; Gercek L kosesi: agzin iki ucu iki komsu kola gelsin.
        (list pMin pPlus)
        (progn
          (if (or (>= valMin 0.0) (>= valPlus 0.0))
            (if (>= valMin valPlus)
              (setq candidate pMin candidateD dMin)
              (setq candidate pPlus candidateD dPlus)))
          (if candidate
            (if (< candidateD d)
              (list candidate center)
              (list center candidate)))))
    )
  )
)
(defun DEGZ--corner-at-block-axis (mouthPt blockPt groupDir)
  ;; Agiz L'nin iki kolundaysa donusu blok tarafinda tut.
  (if (> (abs (cadr groupDir)) (abs (car groupDir)))
    (list (car blockPt) (cadr mouthPt))
    (list (car mouthPt) (cadr blockPt)))
)
(defun DEGZ--block-side-from-connect (blk ip / c p dx dy)
  ;; ip block'un baglanti/base noktasi kabul edilir.
  ;; Bu noktadan block govdesi hangi taraftaysa gelis tarafi onun tersidir:
  ;; govde sagda => LEFT, govde solda => RIGHT, govde ustte => BOTTOM, govde altta => TOP.
  (setq p (DEGZ--pt2d ip))
  (setq c (DEGZ--block-wcs-center blk))
  (setq dx (- (car c) (car p)))
  (setq dy (- (cadr c) (cadr p)))
  (cond
    ((>= (abs dx) (abs dy)) (if (>= dx 0.0) 'LEFT 'RIGHT))
    ((>= dy 0.0) 'BOTTOM)
    (T 'TOP)
  )
)
(defun DEGZ--incoming-block-side (crv cp ip / e cp2 ip2 prm deriv tlen tx ty vx vy)
  ;; Cikinti yonu: once ana hattin o noktada yatay mi dikey mi olduguna bak.
  ;; Ana hat yataysa karar sadece X'e gore verilir:
  ;;   blok baglanti noktasinin sagindaysa LEFT (soldan gelis -> cikinti altta)
  ;;   blok baglanti noktasinin solundaysa RIGHT (sagdan gelis -> cikinti ustte)
  ;; Ana hat dikeyse karar sadece Y'ye gore verilir:
  ;;   blok ustteyse BOTTOM, blok alttaysa TOP.
  (setq e (DEGZ--ename crv))
  (setq cp2 (DEGZ--pt2d cp))
  (setq ip2 (DEGZ--pt2d ip))
  (setq vx (- (car ip2) (car cp2)))
  (setq vy (- (cadr ip2) (cadr cp2)))
  (if e
    (progn
      (setq prm (vl-catch-all-apply 'vlax-curve-getParamAtPoint (list e (DEGZ--pt3d cp2))))
      (if (not (vl-catch-all-error-p prm))
        (progn
          (setq deriv (vlax-curve-getFirstDeriv e prm))
          (setq tlen (distance '(0 0 0) deriv))
          (if (> tlen 1e-9)
            (progn
              (setq tx (/ (car deriv) tlen))
              (setq ty (/ (cadr deriv) tlen))
              (if (>= (abs tx) (abs ty))
                (setq vy 0.0)
                (setq vx 0.0)
              )
            )
          )
        )
      )
    )
  )
  (cond
    ((>= (abs vx) (abs vy)) (if (>= vx 0.0) 'LEFT 'RIGHT))
    ((>= vy 0.0) 'BOTTOM)
    (T 'TOP)
  )
)
(defun DEGZ--oblique-vector-p (vx vy / ax ay)
  ;; Birim yonun iki bileseni de anlamliysa hat WCS eksenlerine paralel degildir.
  (setq ax (abs vx)
        ay (abs vy))
  (and (> ax 1e-4) (> ay 1e-4))
)
(defun DEGZ--local-bend-point (basePt targetPt nx ny tx ty blockSide / b q alen dotT)
  ;; Ofseti koruyan yerel dirsek: tabandan ana hatta paralel, block ucundan
  ;; baglanti koluna paralel gecen iki dogrunun kesisim noktasini verir.
  (setq b (DEGZ--pt2d basePt)
        q (DEGZ--pt2d targetPt)
        alen (sqrt (+ (* tx tx) (* ty ty))))
  (if (or (null b) (null q) (<= alen 1e-12))
    b
    (progn
      (setq tx (/ tx alen)
            ty (/ ty alen)
            dotT (+ (* (- (car q) (car b)) tx)
                    (* (- (cadr q) (cadr b)) ty)))
      (list (+ (car b) (* dotT tx))
            (+ (cadr b) (* dotT ty)))
    )
  )
)
(defun DEGZ--pair-by-local-offset (pA pB iA iB tx ty / pa pb ia ib baseOrder targetOrder)
  ;; 90 derece dirsekte ic/dis ofset sirasini yerel teget ekseninde korur.
  (setq pa (DEGZ--pt2d-safe pA nil)
        pb (DEGZ--pt2d-safe pB nil)
        ia (DEGZ--pt2d-safe iA nil)
        ib (DEGZ--pt2d-safe iB nil))
  (if (and pa pb ia ib)
    (progn
      (setq baseOrder
        (+ (* (- (car pb) (car pa)) tx)
           (* (- (cadr pb) (cadr pa)) ty)))
      (setq targetOrder
        (+ (* (- (car ib) (car ia)) tx)
           (* (- (cadr ib) (cadr ia)) ty)))
      (cond
        ((< (* baseOrder targetOrder) -1e-10)
          (list pa pb ib ia)
        )
        ((> (* baseOrder targetOrder) 1e-10)
          (list pa pb ia ib)
        )
        (T
          ;; Izdusum kararsizsa mevcut yakinlik eslestirmesine geri don.
          (DEGZ--pair-main-block-no-cross nil pa pb ia ib)
        )
      )
    )
    (list pA pB iA iB)
  )
)
(defun DEGZ--APPLY (crv0 ss / crv i blk ip blk2 ip2
               ptsMain propsMain mainTmp mainClosed guideSrc
               joinCand short shift approach
               vvx vvy uu dx dy len rx ry ipRin
               nearLim mainFarLim mergeOff
               cell cells
               parents data
               groups
               forcedReps sideMap segMap groupDirMap groupDir
               anchorMap stemMap  remoteMap mergeMap
               dirMap dirRec udir mdx mdy p1 ipb p1b pJoin stemRec stemA stemB cpSec pStep pStepb
               g rep recs r bestRec bestIp bestD dNow segIdx choosePlus
               procData anchorRec remote
               forceMain isAnchor cpMain cpCur cpE cpEshort
               uTan uPerp corner1 corner2 paramCur distEnds
               pDown pDownRin uDirRemote anchorStemDir
               key cx cy ix iy rec item mergePt isTargetSide
               sX sY sideFact 
               ipAvg pMid paramMid deriv Tlen Tx Ty Lx Ly dotProd dirSign distMid distDown distDownRin maxDist
               pMerge pMergeRin pLeft pRight ipLeft ipRight pMainTop pMainBot ipTop ipBot yTop yBot pTopA pBotA pTopB pBotB pTopDrop pBotDrop scoreA scoreB outsideLeft fromTop sideMode shortIp longIp calcCrv sideBase sideDx sideDy blockSide blockSideMap oblique alignedPair rowGuideActive preRec preSide preTarget)

  (vl-load-com)

  (setq joinCand (DEG:CFG-DDDZ-NUM-OR 'DZ_AGIZ_ARAMA 20.0))
  (if (<= joinCand 0.0)
    (setq joinCand (* 20.0 (DEG:PLAN-UNIT-SCALE))))
  (setq short (DEG:CFG-DDDZ-NUM-OR 'DZ_OFFSET 10.0))
  (if (<= short 0.0)
    (setq short (* 10.0 (DEG:PLAN-UNIT-SCALE))))
  (setq shift short)
  (setq approach short)

  (setq nearLim (DEG:CFG-DDDZ-NUM-OR 'DZ_BLOK_YAKINLIK 100.0))
  (if (<= nearLim 0.0)
    (setq nearLim (* 100.0 (DEG:PLAN-UNIT-SCALE))))
  (setq mainFarLim (DEG:CFG-DDDZ-NUM-OR 'DZ_DIRSEK_DIST 200.0))
  (if (<= mainFarLim 0.0)
    (setq mainFarLim (* 200.0 (DEG:PLAN-UNIT-SCALE))))
  (setq mergeOff (DEG:CFG-DDDZ-NUM-OR 'DZ_DIRSEK_KACIS 50.0))
  (if (<= mergeOff 0.0)
    (setq mergeOff (* 50.0 (DEG:PLAN-UNIT-SCALE))))

  (setq crv0 (DEGZ--ename crv0))

  (if (not (and crv0 (entget crv0)))
    (progn (princ "\nDZ: Gecersiz polyline.") (princ))
    (if (not (and ss (= (type ss) 'PICKSET) (> (sslength ss) 0)))
      (progn (princ "\nDZ: Block secimi yok.") (princ))
      (progn

        ;; Ortak omurgadaki bir sirayi islerken en yakin parcayi tum agdan
        ;; arama. O siraya ait cocuk dal merkezini hesap kilavuzu olarak kullan.
        (setq guideSrc
          (if (and (boundp '*DEGZ_ROW_GUIDE*)
                   *DEGZ_ROW_GUIDE*
                   (entget (DEGZ--ename *DEGZ_ROW_GUIDE*)))
            (DEGZ--ename *DEGZ_ROW_GUIDE*)
            crv0))
        (setq rowGuideActive (not (eq guideSrc crv0)))
        (setq ptsMain   (DEGZ--get-lwpts guideSrc))
        (setq propsMain (DEGZ--safe-props guideSrc))
        (setq mainClosed (cdr (assoc 70 (entget guideSrc))))
        (if (null mainClosed) (setq mainClosed 0))
        (setq mainClosed (if (/= (logand mainClosed 1) 0) 1 0))
        (setq mainTmp   (DEGZ--entmakex-lwpoly ptsMain propsMain mainClosed))

        (setq cell    nearLim)
        (setq cells   '())
        (setq parents '())
        (setq data    '())

        (setq i 0)
        (while (< i (sslength ss))
          (setq blk (ssname ss i))
          (if (not (DEGZ--skip-block-p blk))
            (progn
              (setq ip (DEGZ--pt2d (cdr (assoc 10 (entget blk)))))

              (setq parents (DEGZ--uf-init parents blk))
              (setq data (append data (list (list blk ip))))

              (setq key (DEGZ--cellkey ip cell))
              (setq cx (car key) cy (cadr key))

              (setq ix -1)
              (while (<= ix 1)
                (setq iy -1)
                (while (<= iy 1)
                  (setq rec (assoc (list (+ cx ix) (+ cy iy)) cells))
                  (if rec
                    (foreach item (cdr rec)
                      (setq blk2 (car item))
                      (setq ip2  (cadr item))
                      (if (and blk2 ip2 (<= (distance ip ip2) nearLim))
                        (setq parents (DEGZ--uf-union parents blk blk2))
                      )
                    )
                  )
                  (setq iy (1+ iy))
                )
                (setq ix (1+ ix))
              )

              (setq cells (DEGZ--cells-put cells (list cx cy) (list blk ip)))
            )
          )
          (setq i (1+ i))
        )

        (setq groups (DEGZ--groups-build parents data))

        (setq forcedReps '())
        (setq sideMap    '())
        (setq segMap     '())
        (setq anchorMap  '())
        (setq stemMap    '())
        (setq remoteMap  '())
        (setq mergeMap   '())
        (setq dirMap     '())
        (setq blockSideMap '())
        (setq groupDirMap '())

        (foreach g groups
          (setq rep  (car g))
          (setq recs (cdr g))

          (setq bestRec nil)
          (setq bestD   1e99)
          (foreach r recs
            (setq ip (cadr r))
            (setq cpMain (deg-safe-closest-point mainTmp ip))
            (setq dNow (distance (DEGZ--pt2d ip) (DEGZ--pt2d cpMain)))
            (if (< dNow bestD)
              (progn (setq bestD dNow) (setq bestRec r))
            )
          )
          (if (null bestRec) (setq bestRec (car recs)))
          (setq bestIp (cadr bestRec))
          (setq anchorMap (cons (cons rep bestRec) anchorMap))

          (setq cpMain (deg-safe-closest-point mainTmp bestIp))
          (setq stemMap (cons (cons rep (list (DEGZ--pt2d bestIp) (DEGZ--pt2d cpMain))) stemMap))
          (setq choosePlus (DEGZ--choosePlus-main mainTmp bestIp cpMain joinCand))
          (setq sideMap (cons (cons rep choosePlus) sideMap))
          (setq segIdx (DEGZ--poly-closest-seg-index ptsMain bestIp mainClosed))
          (setq segMap (cons (cons rep segIdx) segMap))

          ;; Cikinti yonu grupta tek karar olsun: tum bloklarin merkezini ana hatta gore oku.
          (setq sX 0.0)
          (setq sY 0.0)
          (setq scoreB 0)
          (foreach r recs
            (setq ip (DEGZ--pt2d (cadr r)))
            (setq sX (+ sX (car ip)))
            (setq sY (+ sY (cadr ip)))
            (setq scoreB (1+ scoreB))
          )
          (if (> scoreB 0)
            (setq ipAvg (list (/ sX scoreB) (/ sY scoreB)))
            (setq ipAvg bestIp)
          )
          (setq cpMain (deg-safe-closest-point mainTmp ipAvg))
          (setq blockSide (DEGZ--side-from-group-alignment cpMain ipAvg recs))
          (setq blockSideMap (cons (cons rep blockSide) blockSideMap))
          (setq groupDirMap
            (cons (cons rep (DEGZ--group-approach-unit cpMain ipAvg recs)) groupDirMap))

          ;; Anchor secimi ana hat acisi degisse de ayni blokta kalsin.
          ;; Egik hatta yerel teget sirasi; yatay/dikey hatta mevcut kural kullanilir.
          (if (> (length recs) 1)
            (progn
              (setq scoreA nil)
              (foreach r recs
                (setq ip (DEGZ--pt2d (cadr r)))
                (setq uTan (DEGZ--canonical-tangent-at mainTmp cpMain))
                (setq scoreB
                  (if (and (> (abs (car uTan)) 1e-4)
                           (> (abs (cadr uTan)) 1e-4))
                    ;; Egik hatta X/Y esigi kullanma; bloklari yerel ana-hat ekseninde sirala.
                    (- (+ (* (car ip) (car uTan))
                          (* (cadr ip) (cadr uTan))))
                    ;; Yatay/dikey mevcut davranisi koru.
                    (cond
                      ((eq blockSide 'LEFT) (- (cadr ip)))
                      ((eq blockSide 'RIGHT) (cadr ip))
                      ((or (eq blockSide 'TOP) (eq blockSide 'BOTTOM)) (- (car ip)))
                      (T 0.0)
                    )
                  )
                )
                (if (or (null scoreA) (< scoreB scoreA))
                  (progn
                    (setq scoreA scoreB)
                    (setq bestRec r)
                  )
                )
              )
              (setq bestIp (cadr bestRec))
              (setq anchorMap (cons (cons rep bestRec) anchorMap))
              (setq cpMain (deg-safe-closest-point mainTmp bestIp))
              (setq stemMap (cons (cons rep (list (DEGZ--pt2d bestIp) (DEGZ--pt2d cpMain))) stemMap))
              (setq choosePlus (DEGZ--choosePlus-main mainTmp bestIp cpMain joinCand))
              (setq sideMap (cons (cons rep choosePlus) sideMap))
              (setq segIdx (DEGZ--poly-closest-seg-index ptsMain bestIp mainClosed))
              (setq segMap (cons (cons rep segIdx) segMap))
            )
          )

          (if (> (length recs) 1)
            (progn
               ;; Bu satir icin cocuk dal onceden olusturulduysa 40 cm uzaklik
               ;; onu dirsekli/remote gruba cevirmesin. Yakin bloklar kendi
               ;; cocuk dalina normal ve tek ortak taraftan baglanir.
               (if (and (> bestD mainFarLim) (not rowGuideActive))
                (progn
                  (setq remoteMap (cons (cons rep T) remoteMap))
                  (setq mergePt (DEGZ--point-toward bestIp cpMain mergeOff))
                  (setq mergeMap (cons (cons rep mergePt) mergeMap))

                  (setq udir (DEGZ--unit (- (car bestIp) (car cpMain)) (- (cadr bestIp) (cadr cpMain))))
                  (setq dirMap (cons (cons rep (list (car udir) (cadr udir))) dirMap))
                )
                (progn
                  (setq remoteMap (cons (cons rep nil) remoteMap))
                  (setq forcedReps (cons rep forcedReps))
                  ;; Normal cizimde yakin grup tek taraftan baglansin. Yon,
                  ;; grubun dizilim eksenine dik secilerek blok ustunden gecis onlenir.
                  (setq cpMain (deg-safe-closest-point mainTmp ipAvg)
                        blockSide
                          (DEGZ--normal-group-no-cross-side
                            cpMain ipAvg recs blockSide))
                  (setq blockSideMap (cons (cons rep blockSide) blockSideMap)
                        groupDirMap
                          (cons
                            (cons rep (DEGZ--approach-unit-for-side blockSide))
                            groupDirMap))
                )
              )
            )
            (setq remoteMap (cons (cons rep nil) remoteMap))
          )
        )

        (setq procData '())
        (foreach g groups
          (setq rep  (car g))
          (setq recs (cdr g))
          (setq remote (cdr (assoc rep remoteMap)))
          (if (and remote (> (length recs) 1))
            (progn
              (setq anchorRec (cdr (assoc rep anchorMap)))
              (setq procData (append procData (list anchorRec)))
              (foreach r recs
                (if (not (equal (car r) (car anchorRec)))
                  (setq procData (append procData (list r)))
                )
              )
            )
            (setq procData (append procData recs))
          )
        )

        (setq crv crv0)

        (foreach rec procData
          (setq blk (car rec))
          (setq ip  (cadr rec))

          (setq rep (DEGZ--uf-find parents blk))
          (setq choosePlus (cdr (assoc rep sideMap)))
          (if (null choosePlus) (setq choosePlus T))
          (setq remote (cdr (assoc rep remoteMap)))
          (setq preRec
            (if (and (boundp '*DEGZ_PRE_COMMON_TARGET_MAP*)
                     *DEGZ_PRE_COMMON_TARGET_MAP*)
              (assoc blk *DEGZ_PRE_COMMON_TARGET_MAP*)
              nil)
                preSide (if preRec (cadr preRec) nil)
                preTarget (if preRec (caddr preRec) nil))

          (setq anchorRec (cdr (assoc rep anchorMap)))
          (setq isAnchor (and remote anchorRec (equal blk (car anchorRec))))
          (setq forceMain (if (member rep forcedReps) T nil))

          (cond
            (forceMain
              (progn
                (setq segIdx (cdr (assoc rep segMap)))
                (if (null segIdx) (setq segIdx 0))
                (setq cpMain (DEGZ--poly-closest-on-seg ptsMain segIdx ip mainClosed))
              )
            )
            (remote
              (if isAnchor
                (progn
                  (setq segIdx (cdr (assoc rep segMap)))
                  (if (null segIdx) (setq segIdx 0))
                  (setq cpMain (DEGZ--poly-closest-on-seg ptsMain segIdx ip mainClosed))
                )
                (progn
                  (setq cpMain (deg-safe-closest-point mainTmp ip))
                )
              )
            )
            (T (setq cpMain (deg-safe-closest-point mainTmp ip)))
          )
          (if (and preTarget (not remote))
            (setq cpMain preTarget))

          (setq cpCur (deg-safe-closest-point crv cpMain))

          (setq ip     (DEGZ--pt2d ip))
          (setq cpMain (DEGZ--pt2d cpMain))
          (setq cpCur  (DEGZ--pt2d cpCur))

          (setq vvx (- (car ip) (car cpMain)))
          (setq vvy (- (cadr ip) (cadr cpMain)))

          ;; Cikinti tarafi block'un baglanti/base noktasindan gorunen govdesine bakarak belirlenir.
          ;; Ana hat noktasi veya block rotasyonu bu karari bozmasin.
          (setq blockSide (cdr (assoc rep blockSideMap)))
          (if (null blockSide)
            (setq blockSide (DEGZ--side-from-connect-to-block cpMain ip))
          )
          (if (and preSide (not remote))
            (setq blockSide preSide))
          
          (DEGZ--dbg-cikinti "DZ" blockSide remote isAnchor forceMain ip cpMain)
          (setq orthoForced nil)
(setq shiftBlk shift)
          (setq uu (DEGZ--unit vvx vvy))
          (setq dx (car uu) dy (cadr uu) len (caddr uu))

          (if (and remote (not isAnchor))
            (progn
              (setq uDirRemote (cdr (assoc rep dirMap)))
              (setq dx (car uDirRemote))
              (setq dy (cadr uDirRemote))
              (setq len 100.0)
            )
          )
          (setq groupDir (cdr (assoc rep groupDirMap)))
          (if (and preSide (not remote))
            (setq groupDir (DEGZ--approach-unit-for-side preSide)))
          (if groupDir
            (setq dx (car groupDir)
                  dy (cadr groupDir)
                  len 100.0)
          )

          (if (> len 1e-9)
            (progn
              (setq rx dy)
              (setq ry (- dx))

              ;; =========================================================
              ;; 1. BLOK BACAK YONU VE TARAF KONTROLU (HERKES ICIN)
              ;; =========================================================
              (setq oblique (DEGZ--oblique-vector-p dx dy))
              (if oblique
                (progn
                  ;; Egik hatta taraf karari aciya ve RIGHT/TOP etiketine bagli degildir.
                  (setq sideFact
                    (DEGZ--local-side-factor mainTmp cpMain dx dy rx ry)
                  )
                  (setq isTargetSide (< sideFact 0.0))
                )
                (progn
                  (setq isTargetSide
                    (or (eq blockSide 'BOTTOM) (eq blockSide 'RIGHT))
                  )
                  (setq sideFact (if isTargetSide -1.0 1.0))
                )
              )

              ;; Plan tarafina gore gerekirse bacaklari ters yone cevir
              (setq ipRin
                (list
                  (+ (car ip) (* rx shiftBlk sideFact))
                  (+ (cadr ip) (* ry shiftBlk sideFact))
                )
              )
              (setq ipRin
                 (list 
                   (- (car ipRin) (* dx approach))
                   (- (cadr ipRin) (* dy approach))
                 )
              )
              ;; Sabit cikinti yonu icin ipRin WCS'te uretilir.
              ;; LEFT: altta, RIGHT: ustte, TOP/BOTTOM: solda.
              (if (not oblique)              (setq ipRin
                (cond
                  ((eq blockSide 'LEFT)
                    (list (- (car ip) approach) (- (cadr ip) shiftBlk))
                  )
                  ((eq blockSide 'RIGHT)
                    (list (+ (car ip) approach) (- (cadr ip) shiftBlk))
                  )
                  ((eq blockSide 'TOP)
                    (list (- (car ip) shiftBlk) (+ (cadr ip) approach))
                  )
                  ((eq blockSide 'BOTTOM)
                    (list (- (car ip) shiftBlk) (- (cadr ip) approach))
                  )
                  (T ipRin)
                )
              )              
              )
              ;; cpE noktasini da tarafa gore duzelt (Referans icin)
              (setq rx (* rx sideFact))
              (setq ry (* ry sideFact))

              ;; Remote + anchor + sol/ust ise ANA HAT UZERINDEKI CIKIS VERTEX'INI OBUR TARAFA AL
              ;; (blok bacagi/yonu degismez, sadece ana hatta degdigi taraf degisir)
              (if (and remote isAnchor isTargetSide)
                (setq choosePlus (if choosePlus nil T))
              )

              (if (or forceMain remote)
                (setq cpE (DEGZ--cpE-side-flag crv cpCur joinCand choosePlus))
                (setq cpE (DEGZ--cpE-side      crv cpCur joinCand rx ry))
              )
              (setq cpCur (DEGZ--pt2d-safe cpCur cpMain))
              (setq cpE   (DEGZ--pt2d-safe cpE cpCur))
              (if (and cpCur cpE)
                (setq cpEshort (DEGZ--shorten-toward-cp crv cpCur cpE (min short (* (distance cpCur cpE) 0.45))))
                (setq cpEshort cpCur)
              )
              (setq cpEshort (DEGZ--pt2d-safe cpEshort cpCur))

              ;; Capraz kose grubunda agzi yaklasima dik komsu segmentte ac.
              ;; Remote anchor agzi, hat acisindan bagimsiz olarak ayardaki
              ;; tam ofsetle kurulsun. Aksi halde yatay/dikey kollarda onceki
              ;; kisaltma hesabi agzi 10/20 gibi ara bir mesafede birakiyordu.
              (if (and groupDir remote isAnchor)
                (progn
                  (setq alignedPair
                    (DEGZ--corner-mouth-pair-by-approach crv cpMain groupDir short))
                  (if alignedPair
                    (setq cpCur (car alignedPair)
                          cpEshort (cadr alignedPair)))
                )
              )

              (if (and cpCur cpEshort (> (distance cpCur cpEshort) 1e-4))
                (progn
                  
                  (if (and remote (not isAnchor))
                     ;; =====================================================
                     ;; DURUM A: UZAK BLOKLAR (REMOTE) -> L-SHAPE / MERGE
                     ;; =====================================================
                     ;; * Bu bloklar komsu hattina baglanmali (Merge).
                     ;; * Hesaplamalar 'crv' (islenmis hat) uzerinde yapilmali.
                     (progn
                       ;; pMerge: ip'den mergeOff kadar asagi
                       (setq pMerge
                        (list
                          (+ (car ip) (* (- dx) mergeOff))
                          (+ (cadr ip) (* (- dy) mergeOff))
                        )
                       )
                       ;; pMergeRin: ipRin hizasinda
                       (setq pMergeRin
                        (list
                          (+ (car pMerge) (- (car ipRin) (car ip)))
                          (+ (cadr pMerge) (- (cadr ipRin) (cadr ip)))
                        )
                       )
                       
                       ;; Dis L eslesmesi:
                       ;; Ana hatta devam eden cift hatta soldaki kol ust yataya,
                       ;; sagdaki kol alt yataya baglanir. Boylece capraz eslesme olmaz.
                       (if (or (< (car pMerge) (car pMergeRin))
                               (and (equal (car pMerge) (car pMergeRin) 1e-9)
                                    (> (cadr pMerge) (cadr pMergeRin))))
                         (progn
                           (setq pLeft pMerge)
                           (setq ipLeft ip)
                           (setq pRight pMergeRin)
                           (setq ipRight ipRin)
                         )
                         (progn
                           (setq pLeft pMergeRin)
                           (setq ipLeft ipRin)
                           (setq pRight pMerge)
                           (setq ipRight ip)
                         )
                       )

                       (if (>= (cadr pLeft) (cadr pRight))
                         (progn (setq yTop (cadr pLeft)) (setq yBot (cadr pRight)))
                         (progn (setq yTop (cadr pRight)) (setq yBot (cadr pLeft)))
                       )

                       ;; Cikinti tarafindaki kisa ucu dis tarafa al.
                       ;; Ustten/alttan gelise gore capraz ureten eslesmeyi secme.
                       (setq outsideLeft
                         (>= (+ (* (car ipLeft) rx) (* (cadr ipLeft) ry))
                             (+ (* (car ipRight) rx) (* (cadr ipRight) ry)))
                       )
                       ;; Ustten gelen durumda cikinti aynalanir; kisa ucu dis tarafa almak icin eslesmeyi tersle.
                       (setq fromTop (eq blockSide 'TOP))
                       (if fromTop
                         (setq outsideLeft (if outsideLeft nil T))
                       )
                       ;; Asagidan geliste ust-alt eslesmesi ayri aynalanir.
                       (if (eq blockSide 'BOTTOM)
                         (setq outsideLeft (if outsideLeft nil T))
                       )
                       (setq pTopA (list (car pLeft) yTop))
                       (setq pBotA (list (car pRight) yBot))
                       (setq pTopB (list (car pRight) yTop))
                       (setq pBotB (list (car pLeft) yBot))
                       (if outsideLeft
                         (progn
                           (setq ipTop ipLeft)
                           (setq ipBot ipRight)
                           (setq pMainTop pTopA)
                           (setq pMainBot pBotA)
                         )
                         (progn
                           (setq ipTop ipRight)
                           (setq ipBot ipLeft)
                           (setq pMainTop pTopB)
                           (setq pMainBot pBotB)
                         )
                       )
                        ;; Ana hat agzinda capraz eslesme olmasin:
                        ;; ust/alt (veya sol/sag) ana hat ucu ayni siradaki blok ucuna baglansin.
                        (setq dirRec (DEGZ--pair-main-block-no-cross blockSide pMerge pMergeRin ip ipRin))
                        (setq pMainTop (car dirRec))
                        (setq pMainBot (cadr dirRec))
                        (setq ipTop (caddr dirRec))
                        (setq ipBot (cadddr dirRec))
                       ;; Ana hat uzerindeki noktalar (Mevcut 'crv' uzerinden alinir)
                       (setq cpCur    (deg-safe-closest-point crv pMainTop))
                       (setq cpEshort (deg-safe-closest-point crv pMainBot))
                       
                       ;; Alt kol ana hatta baglanir; ust kol dis L'yi tamamlar.
                       (setq pJoin
                         (inters
                           (list (car pMainBot) (cadr pMainBot) 0.0)
                           (list (+ (car pMainBot) rx) (+ (cadr pMainBot) ry) 0.0)
                           (list (car cpEshort) (cadr cpEshort) 0.0)
                           (list (+ (car cpEshort) dx) (+ (cadr cpEshort) dy) 0.0)
                           nil
                         )
                       )
                       (if pJoin
                         (setq pJoin (DEGZ--pt2d pJoin))
                         (setq pJoin (list (car cpEshort) (cadr pMainBot)))
                       )
                       ;; Blok cikislarina direkt capraz gitme.
                       ;; Ana hat noktasi ile blok cikisi hem X hem Y farkliyse araya kirim koy.
                       (setq sideMode
                         (or
                           (eq blockSide 'LEFT)
                           (eq blockSide 'RIGHT)
                           (and (> (abs (- (car pMainTop) (car ipTop))) 1e-6)
                                (> (abs (- (cadr pMainTop) (cadr ipTop))) 1e-6))
                           (and (> (abs (- (car pMainBot) (car ipBot))) 1e-6)
                                (> (abs (- (cadr pMainBot) (cadr ipBot))) 1e-6))
                         )
                       )
                       (if sideMode
                         (progn
                           ;; Sabit cikinti yonu:
                           ;; LEFT/RIGHT -> cikinti altta.
                           ;; TOP/BOTTOM -> cikinti solda.
                           (setq shortIp nil)
                           (setq longIp nil)
                           (if oblique
                             (if (or (eq blockSide 'LEFT) (eq blockSide 'RIGHT))
                               (progn
                                 ;; Bu dallarda pMainTop-longIp ve pJoin-shortIp ayni ofset kolunda kalir.
                                 (setq longIp ipTop)
                                 (setq shortIp ipBot)
                               )
                               (progn
                                 ;; Bu dallarda pMainTop-shortIp ve pJoin-longIp ayni ofset kolunda kalir.
                                 (setq shortIp ipTop)
                                 (setq longIp ipBot)
                               )
                             )
                             (cond
                               ((or (eq blockSide 'LEFT) (eq blockSide 'RIGHT))
                                 ;; Yatay gelislerde alt nokta short, ust nokta long olur.
                                 ;; Yatay dallar zit cizer: RIGHT short-first, LEFT long-first.
                                 (if (<= (cadr ipTop) (cadr ipBot))
                                   (progn (setq shortIp ipTop) (setq longIp ipBot))
                                   (progn (setq shortIp ipBot) (setq longIp ipTop))
                                 )
                               )
                               ((or (eq blockSide 'TOP) (eq blockSide 'BOTTOM))
                                 ;; Dikey gelislerde sol nokta short, sag nokta long olur.
                                 (if (<= (car ipTop) (car ipBot))
                                   (progn (setq shortIp ipTop) (setq longIp ipBot))
                                   (progn (setq shortIp ipBot) (setq longIp ipTop))
                                 )
                               )
                             )
                           )
                           (if oblique
                             (progn
                               ;; Egik dirsekte hat kimligini koru: pMerge-ip, pMergeRin-ipRin.
                               ;; Uclar ayrica siralanmaz; boylece aciya bagli Z/capraz dirsek olusmaz.
                               (setq pTopDrop
                                 (DEGZ--local-bend-point pMainTop ipTop dx dy rx ry blockSide)
                               )
                               (setq pBotDrop
                                 (DEGZ--local-bend-point pJoin ipBot dx dy rx ry blockSide)
                               )
                               (setq crv
                                 (DEGZ--insert-detour
                                   crv
                                   cpCur
                                   cpEshort
                                   (list pMainTop pTopDrop ipTop ipBot pBotDrop pJoin)
                                 )
                               )
                             )
                             (cond
                               ((eq blockSide 'TOP)
                                       ;; Ustten geliste mevcut dogru eslesme korunur.
                                       (if (not shortIp)
                                         (if (<= (distance pMainTop ipTop) (distance pMainTop ipBot))
                                           (progn (setq shortIp ipTop) (setq longIp ipBot))
                                           (progn (setq shortIp ipBot) (setq longIp ipTop))
                                         )
                                       )
                                       (setq pTopDrop
                                          (if oblique
                                            (DEGZ--local-bend-point pMainTop shortIp dx dy rx ry blockSide)
                                            (list (car pMainTop) (cadr shortIp))
                                          )
                                        )
                                       (setq pBotDrop
                                          (if oblique
                                            (DEGZ--local-bend-point pJoin longIp dx dy rx ry blockSide)
                                            (list (car pJoin) (cadr longIp))
                                          )
                                        )
                                       (setq crv
                                         (DEGZ--insert-detour
                                           crv
                                           cpCur
                                           cpEshort
                                           (list pMainTop pTopDrop shortIp longIp pBotDrop pJoin)
                                         )
                                       )                             )
                               ((eq blockSide 'BOTTOM)
                                 ;; Asagidan geliste cikinti kisa/uzun eslesmesi secim asamasinda aynalanir.
                                 (if (not shortIp)
                                   (if (<= (distance pMainTop ipTop) (distance pMainTop ipBot))
                                     (progn (setq shortIp ipTop) (setq longIp ipBot))
                                     (progn (setq shortIp ipBot) (setq longIp ipTop))
                                   )
                                 )
                                 (setq pTopDrop
                                          (if oblique
                                            (DEGZ--local-bend-point pMainTop shortIp dx dy rx ry blockSide)
                                            (list (car pMainTop) (cadr shortIp))
                                          )
                                        )
                                 (setq pBotDrop
                                          (if oblique
                                            (DEGZ--local-bend-point pJoin longIp dx dy rx ry blockSide)
                                            (list (car pJoin) (cadr longIp))
                                          )
                                        )
                                 (setq crv
                                   (DEGZ--insert-detour
                                     crv
                                     cpCur
                                     cpEshort
                                     (list pMainTop pTopDrop shortIp longIp pBotDrop pJoin)
                                   )
                                 )
                               )
                               ((eq blockSide 'RIGHT)
                                       ;; Sagdan geliste de UP/BOTTOM ile ayni agiz sirasi kullanilir.
                                       (if (not shortIp)
                                         (if (<= (distance pMainBot ipTop) (distance pMainBot ipBot))
                                           (progn (setq shortIp ipTop) (setq longIp ipBot))
                                           (progn (setq shortIp ipBot) (setq longIp ipTop))
                                         )
                                       )
                                       (setq pTopDrop
                                          (if oblique
                                            (DEGZ--local-bend-point pMainTop shortIp dx dy rx ry blockSide)
                                            (list (car pMainTop) (cadr shortIp))
                                          )
                                        )
                                       (setq pBotDrop
                                          (if oblique
                                            (DEGZ--local-bend-point pJoin longIp dx dy rx ry blockSide)
                                            (list (car pJoin) (cadr longIp))
                                          )
                                        )
                                       (setq crv
                                         (DEGZ--insert-detour
                                           crv
                                           cpCur
                                           cpEshort
                                           (list pMainTop pTopDrop shortIp longIp pBotDrop pJoin)
                                         )
                                       )                             )
                               ((eq blockSide 'LEFT)
                                       ;; LEFT, RIGHT'in aynasi olarak uzun ucu ust agza baglar.
                                       (if (not shortIp)
                                         (if (<= (distance pMainTop ipTop) (distance pMainTop ipBot))
                                           (progn (setq shortIp ipTop) (setq longIp ipBot))
                                           (progn (setq shortIp ipBot) (setq longIp ipTop))
                                         )
                                       )
                                       (setq pTopDrop
                                          (if oblique
                                            (DEGZ--local-bend-point pMainTop longIp dx dy rx ry blockSide)
                                            (list (car pMainTop) (cadr longIp))
                                          )
                                        )
                                       (setq pBotDrop
                                          (if oblique
                                            (DEGZ--local-bend-point pJoin shortIp dx dy rx ry blockSide)
                                            (list (car pJoin) (cadr shortIp))
                                          )
                                        )
                                       (setq crv
                                         (DEGZ--insert-detour
                                           crv
                                           cpCur
                                           cpEshort
                                           (list pMainTop pTopDrop longIp shortIp pBotDrop pJoin)
                                         )
                                       )                             )
                               (T
                                       ;; Belirsiz yonde varsayilan dogru eslesme.
                                       (if (not shortIp)
                                         (if (<= (distance pMainTop ipTop) (distance pMainTop ipBot))
                                           (progn (setq shortIp ipTop) (setq longIp ipBot))
                                           (progn (setq shortIp ipBot) (setq longIp ipTop))
                                         )
                                       )
                                       (setq pTopDrop
                                          (if oblique
                                            (DEGZ--local-bend-point pMainTop shortIp dx dy rx ry blockSide)
                                            (list (car pMainTop) (cadr shortIp))
                                          )
                                        )
                                       (setq pBotDrop
                                          (if oblique
                                            (DEGZ--local-bend-point pJoin longIp dx dy rx ry blockSide)
                                            (list (car pJoin) (cadr longIp))
                                          )
                                        )
                                       (setq crv
                                         (DEGZ--insert-detour
                                           crv
                                           cpCur
                                           cpEshort
                                           (list pMainTop pTopDrop shortIp longIp pBotDrop pJoin)
                                         )
                                       )                             )
                             )
                           )
                         )
                         (setq crv
                           (DEGZ--insert-detour
                             crv
                             cpCur
                             cpEshort
                             (list pMainTop ipTop ipBot pMainBot pJoin)
                           )
                         )
                       )
                     )
                     
                     ;; =====================================================
                     ;; DURUM B: YAKIN BLOKLAR (DIRECT CONNECT)
                     ;; =====================================================
                     ;; * Bu bloklar DIREKT ana hatta baglanmali.
                     ;; * Komsunun bacagina YAPISMAMALI.
                     ;; * Bu yuzden referans olarak 'mainTmp' (Temiz Hat) kullanilmali.
                     (progn
                        (if (and remote isAnchor)
                            ;; Anchor ozel durumu (Pahli Baglanti)
                            (progn
                              (setq dirRec
                                 (if oblique
                                   (DEGZ--pair-by-local-offset cpCur cpEshort ip ipRin rx ry)
                                   (DEGZ--direct-detour-order blockSide cpCur cpEshort ip ipRin)
                                 )
                               )
                              (if dirRec
                                (progn
                                  (setq cpCur    (car dirRec))
                                  (setq cpEshort (cadr dirRec))
                                  (setq ipTop    (caddr dirRec))
                                  (setq ipBot    (cadddr dirRec))
                                  (setq distEnds (distance cpCur cpEshort))
                                  (if (> distEnds 1e-9)
                                    (progn
                                      (setq uTan (list (/ (- (car cpEshort) (car cpCur)) distEnds)
                                                       (/ (- (cadr cpEshort) (cadr cpCur)) distEnds)))
                                      (setq uPerp (list (- (cadr uTan)) (car uTan)))
                                      (if alignedPair
                                        (progn
                                          (setq corner1 (DEGZ--corner-at-block-axis cpCur ipTop groupDir)
                                                corner2 (DEGZ--corner-at-block-axis cpEshort ipBot groupDir))
                                          (setq crv (DEGZ--insert-detour crv cpCur cpEshort
                                            (list corner1 ipTop ipBot corner2))))
                                        (progn
                                          (setq corner1 (DEGZ--calc-L-corner cpCur ipTop uPerp)
                                                corner2 (DEGZ--calc-L-corner cpEshort ipBot uPerp))
                                          (setq crv (DEGZ--insert-detour crv cpCur cpEshort
                                            (list corner1 ipTop ipBot corner2)))))
                                    )
                                  )
                                )
                              )
                            )
                            
                            ;; STANDART DIREKT BAGLANTI (VEKTOREL HIZALAMA)
                            (progn
                                ;; *** ONEMLI: Hesaplamalarda 'mainTmp' (Temiz Hat) kullan! ***
                                (setq calcCrv mainTmp) 
                                
                                ;; A. Orta noktayi bul
                                (setq ipAvg (list (/ (+ (car ip) (car ipRin)) 2.0) (/ (+ (cadr ip) (cadr ipRin)) 2.0)))
                                ;; Yakin bloklar icin ortak hedef son yakin-hat
                                ;; hesabindan once korunur.
                                (setq pMid
                                  (if (and preTarget (not remote))
                                    (deg-safe-closest-point calcCrv preTarget)
                                    (deg-safe-closest-point calcCrv ipAvg)))
                                
                                ;; B. Hattin yonunu bul (Temiz hat uzerinden)
                                (setq paramMid (vlax-curve-getParamAtPoint (DEGZ--ename calcCrv) (DEGZ--pt3d pMid)))
                                (setq deriv (vlax-curve-getFirstDeriv (DEGZ--ename calcCrv) paramMid))
                                (setq Tlen (distance '(0 0 0) deriv))
                                (if (< Tlen 1e-9)
                                   (progn (setq Tx rx) (setq Ty ry))
                                   (progn (setq Tx (/ (car deriv) Tlen)) (setq Ty (/ (cadr deriv) Tlen)))
                                )

                                ;; C. Hizalama Yonu
                                (setq Lx (- (car ipRin) (car ip)))
                                (setq Ly (- (cadr ipRin) (cadr ip)))
                                (setq dotProd (+ (* Tx Lx) (* Ty Ly)))
                                (setq dirSign (if (>= dotProd 0) 1.0 -1.0))

                                ;; Remote + anchor + target side: reverse direction so the short piece is taken from the other side
                                (if (and remote isAnchor isTargetSide)
                                  (setq dirSign (- dirSign))
                                )
                                
                                ;; D. DZ_OFFSET iki ray arasindaki toplam mesafedir.
                                ;; Agiz noktalari merkezden +/- DZ_OFFSET/2 uretilir.
                                (setq distMid (vlax-curve-getDistAtParam (DEGZ--ename calcCrv) paramMid))
                                (setq maxDist (DEGZ--curve-total calcCrv))
                                
                                (setq distPair (DEGZ--distpair10 distMid dirSign maxDist (* 0.5 shift)))
                                (setq distDown (car distPair))
                                (setq distDownRin (cadr distPair))
                                
                                ;; Noktalari Temiz Hat uzerinden al (Komsunun bacagina carpmaz)
                                (setq pDown    (DEGZ--pt2d (vlax-curve-getPointAtDist (DEGZ--ename calcCrv) distDown)))
                                (setq pDownRin (DEGZ--pt2d (vlax-curve-getPointAtDist (DEGZ--ename calcCrv) distDownRin)))

                                ;; Detour ekleme noktalarini guncel 'crv' uzerinde bul
                                ;; pDown temiz hat uzerinde oldugu icin, 'crv' uzerinde de govdeye denk gelir.
                                (setq cpCur    (deg-safe-closest-point crv pDown))
                                (setq cpEshort (deg-safe-closest-point crv pDownRin))
                                
                                (setq ipRin (DEGZ--direct-offset-end ip ipRin cpCur cpEshort short))
                                ;; DIREKT BAGLANTI LISTESI
                                (setq dirRec
                                 (DEGZ--pair-by-local-offset cpCur cpEshort ip ipRin
                                   (- (car cpEshort) (car cpCur))
                                   (- (cadr cpEshort) (cadr cpCur)))
                               )
                                (if dirRec
                                  (progn
                                    (setq cpCur    (car dirRec))
                                    (setq cpEshort (cadr dirRec))
                                    (setq ipTop    (caddr dirRec))
                                    (setq ipBot    (cadddr dirRec))
                                    (setq distEnds (distance cpCur cpEshort))
                                    (if (> distEnds 1e-9)
                                      (progn
                                        (setq uTan (list (/ (- (car cpEshort) (car cpCur)) distEnds)
                                                         (/ (- (cadr cpEshort) (cadr cpCur)) distEnds)))
                                        (setq uPerp (list (- (cadr uTan)) (car uTan)))
                                        (setq corner1 (DEGZ--calc-L-corner cpCur ipTop uPerp))
                                        (setq corner2 (DEGZ--calc-L-corner cpEshort ipBot uPerp))
                                        (setq crv (DEGZ--insert-detour crv cpCur cpEshort (list corner1 ipTop ipBot corner2)))
                                      )
                                      (setq crv (DEGZ--insert-detour crv cpCur cpEshort (list ipTop ipBot)))
                                    )
                                  )
                                )
                            )
                        )
                     )
                  )
                )
              )
            )
          )
        )

        (if mainTmp (entdel mainTmp))
      )
    )
  )
  ;; DZ_ORIG final cizimi tek seferlik kontrol edebilsin diye son entity'yi dondur.
  (if (and crv (entget crv)) crv nil)
)

(defun DEGDR--RUN (mainEnt pick dist / mainPts tol ss allEnts rootId assignedEnts lay mainCol tubePls scan e pl outline)
  (setq mainPts (g365_get_pts mainEnt))
  (if (or (null mainPts) (< (length mainPts) 2))
    (progn (princ "\nAna hat okunamadi / cok kisa.") nil)
    (progn
      (setq tol (DEG:CFG-TOL-NUM-OR 'DR_TREE_TOL 0.1))
      (if (<= dist 0.0)
        (progn (princ "\nGecersiz mesafe.") nil)
        (progn
          (setq lay (cdr (assoc 8 (entget mainEnt))))
          (setq mainCol (g365_effective_color mainEnt))
          ;; Iskelete dahil olacak nesneler, secilen ana hat ile AYNI layer'da olmalidir.
          (if (and lay (/= lay ""))
            (setq ss (ssget "X" (list (cons 0 "LWPOLYLINE,POLYLINE,LINE") (cons 8 lay))))
            (setq ss (ssget "X" '((0 . "LWPOLYLINE,POLYLINE,LINE"))))
          )
          (if (null ss)
            (progn (princ "\nHic nesne bulunamadi.") nil)
            (progn
              (setq allEnts (g372_ss_to_list ss))
              ;; Iskelete dahil olacak nesneler, secilen ana hat ile AYNI renkte olmalidir.
              (setq allEnts
                (vl-remove nil
                  (mapcar
                    '(lambda (en)
                       (if (= (g365_effective_color en) mainCol) en nil)
                     )
                    allEnts
                  )
                )
              )
              (setq rootId (g372_build_tree mainEnt mainPts allEnts tol))
              (setq assignedEnts (g415_get_assigned_original_ents allEnts))
              
              (setq tubePls nil)
              (setq scan assignedEnts)
              (while scan
                (setq e (car scan))
                (setq pl (g415_make_tube_poly_from_ent e dist lay))
                (if pl (setq tubePls (cons pl tubePls)))
                (setq scan (cdr scan))
              )
              (setq tubePls (reverse tubePls))
              (setq outline (g415_union_tubes_to_outline tubePls lay))

              (if outline
                (progn
                  (setq outline (g418_rebuild_outline_seam outline lay pick mainPts dist))
                  (if outline (g365_copy_color mainEnt outline))
                  (g415_delete_ents assignedEnts)
                  (g418_flush_cmd)
                  outline
                )
                nil
              )
            )
          )
        )
      )
    )
  )
)

(defun DEGDC--collect-connected (mainEnt / mainPts tol ss allEnts lay mainCol found)
  (setq mainPts (g365_get_pts mainEnt))
  (if (or (null mainPts) (< (length mainPts) 2))
    nil
    (progn
      (setq tol (DEG:CFG-TOL-NUM-OR 'DR_TREE_TOL 0.1))
      (setq lay     (cdr (assoc 8 (entget mainEnt))))
      (setq mainCol (g365_effective_color mainEnt))
      (if (and lay (/= lay ""))
        (setq ss (ssget "X" (list (cons 0 "LWPOLYLINE,POLYLINE,LINE") (cons 8 lay))))
        (setq ss (ssget "X" '((0 . "LWPOLYLINE,POLYLINE,LINE"))))
      )
      (if ss
        (progn
          (setq allEnts (g372_ss_to_list ss))
          (setq allEnts
            (vl-remove nil
              (mapcar
                '(lambda (en)
                   (if (= (g365_effective_color en) mainCol) en nil)
                 )
                allEnts
              )
            )
          )
          (g372_build_tree mainEnt mainPts allEnts tol)
          (setq found (g415_get_assigned_original_ents allEnts))
          (g372_reset_tree)
          found
        )
        nil
      )
    )
  )
)

(defun DEGDC--closest-on-ents (pt ents / basePt bestPt bestEnt bestD en cp d)
  (setq basePt (deg-pt3 pt))
  (setq bestPt nil bestEnt nil bestD nil)
  (while ents
    (setq en (car ents))
    (if (and basePt en (entget en))
      (progn
        (setq cp (deg-safe-closest-point en basePt))
        (if cp
          (progn
            (setq d (distance basePt cp))
            (if (or (null bestD) (< d bestD))
              (setq bestPt cp
                    bestEnt en
                    bestD d)
            )
          )
        )
      )
    )
    (setq ents (cdr ents))
  )
  (if bestPt
    (list bestPt bestEnt bestD)
    nil
  )
)

(defun DEGDC--block-rotation (blkEnt / ang)
  (setq ang (cdr (assoc 50 (entget blkEnt))))
  (if (numberp ang) ang 0.0)
)

(defun DEGDC--offset-point (pt ang dist / p)
  (setq p (deg-pt3 pt))
  (if p
    (list
      (+ (car p) (* dist (cos ang)))
      (+ (cadr p) (* dist (sin ang)))
      (caddr p)
    )
    nil
  )
)

(defun DEGDC--block-ortho-tail-pts (fromPt joinPt joinEnt downAng / d h uTan vx vy offH pickPt prefT rawT dir rad stubLen p1 pEnd)
  (setq d (list (cos downAng) (sin downAng) 0.0))
  (setq h (list (- (sin downAng)) (cos downAng) 0.0))
  (setq uTan (DEGDC--curve-unit-tangent joinEnt joinPt))
  (if (null uTan)
    (setq uTan h)
  )
  (setq vx (- (car joinPt) (car fromPt)))
  (setq vy (- (cadr joinPt) (cadr fromPt)))
  (setq offH (+ (* vx (car h)) (* vy (cadr h))))
  (setq pickPt (deg-pt3 *DEGDC_PICKPT*))
  (setq rawT (+ (* vx (car uTan)) (* vy (cadr uTan))))
  (if pickPt
    (setq prefT (+ (* (- (car pickPt) (car joinPt)) (car uTan)) (* (- (cadr pickPt) (cadr joinPt)) (cadr uTan))))
    (setq prefT rawT)
  )
  (cond
    ((> prefT 1e-6) (setq dir 1.0))
    ((< prefT -1e-6) (setq dir -1.0))
    ((> rawT 1e-6) (setq dir 1.0))
    ((< rawT -1e-6) (setq dir -1.0))
    (T (setq dir 1.0))
  )
  (setq rad (DEG:CFG-NUM-OR 'DC_FILLET_R 10.0))
  (if (<= rad 0.0) (setq rad 10.0))
  (setq stubLen (max rad 1.0))
  (setq p1
    (list
      (+ (car fromPt) (* offH (car h)))
      (+ (cadr fromPt) (* offH (cadr h)))
      (if (caddr fromPt) (caddr fromPt) 0.0)
    )
  )
  (setq pEnd
    (list
      (+ (car joinPt) (* dir stubLen (car uTan)))
      (+ (cadr joinPt) (* dir stubLen (cadr uTan)))
      (if (caddr joinPt) (caddr joinPt) 0.0)
    )
  )
  (g365_clean_pts (list p1 (deg-pt3 joinPt) pEnd))
)
(defun DEGDC--horizontal-sign (pDown ents baseAng sideLen / refRec refPt dx dy axisDot rightPt leftPt rightRec leftRec)
  (if (or (null sideLen) (<= sideLen 0.0))
    (setq sideLen 700.0)
  )
  (setq refRec (DEGDC--closest-on-ents pDown ents))
  (if (null refRec)
    1.0
    (progn
      (setq refPt (car refRec))
      (setq dx (- (car refPt) (car pDown)))
      (setq dy (- (cadr refPt) (cadr pDown)))
      (setq axisDot (+ (* dx (cos baseAng)) (* dy (sin baseAng))))
      (cond
        ((> axisDot 1e-9) 1.0)
        ((< axisDot -1e-9) -1.0)
        (T
          (setq rightPt  (DEGDC--offset-point pDown baseAng sideLen))
          (setq leftPt   (DEGDC--offset-point pDown (+ baseAng pi) sideLen))
          (setq rightRec (DEGDC--closest-on-ents rightPt ents))
          (setq leftRec  (DEGDC--closest-on-ents leftPt ents))
          (cond
            ((and rightRec leftRec)
              (if (<= (caddr rightRec) (caddr leftRec)) 1.0 -1.0)
            )
            (rightRec 1.0)
            (leftRec -1.0)
            (T 1.0)
          )
        )
      )
    )
  )
)

(defun DEGDC--dot2 (a b)
  (+ (* (car a) (car b)) (* (cadr a) (cadr b)))
)

(defun DEGDC--pt+scale (pt vec s)
  (list
    (+ (car pt) (* (car vec) s))
    (+ (cadr pt) (* (cadr vec) s))
    (if (caddr pt) (caddr pt) 0.0)
  )
)

(defun DEGDC--block-visible-bbox (blkEnt / obj bb)
  (setq obj (if (vlax-objectp blkEnt) blkEnt (vlax-ename->vla-object blkEnt)))
  (setq bb (degk--get-bbox-visible-by-explode obj))
  (if (null bb)
    (setq bb (degk--ent-bbox obj))
  )
  bb
)

(defun DEGDC--bbox-support (bb axis / mn mx hx hy)
  (if (null bb)
    0.0
    (progn
      (setq mn (car bb) mx (cadr bb))
      (setq hx (/ (- (car mx) (car mn)) 2.0))
      (setq hy (/ (- (cadr mx) (cadr mn)) 2.0))
      (+ (* hx (abs (car axis))) (* hy (abs (cadr axis))))
    )
  )
)

(defun DEGDC--seg-hit-bbox-p (a b bb / pA pB mn mx p1 p2 p3 p4)
  (setq pA (deg-pt3 a))
  (setq pB (deg-pt3 b))
  (and pA pB bb
       (or
         (degw-point-in-bbox-p pA bb)
         (degw-point-in-bbox-p pB bb)
         (progn
           (setq mn (car bb) mx (cadr bb))
           (setq p1 (list (car mn) (cadr mn) 0.0))
           (setq p2 (list (car mx) (cadr mn) 0.0))
           (setq p3 (list (car mx) (cadr mx) 0.0))
           (setq p4 (list (car mn) (cadr mx) 0.0))
           (or (inters pA pB p1 p2 T)
               (inters pA pB p2 p3 T)
               (inters pA pB p3 p4 T)
               (inters pA pB p4 p1 T))
         )
       )
  )
)

(defun DEGDC--curve-unit-tangent (ent pt / obj segTan d endPar endDist span d1 d2 p1 p2 dx dy len)
  (setq segTan (DEGDC--segment-unit-at-point ent pt))
  (if segTan
    segTan
    (progn
      (setq obj (if (vlax-objectp ent) ent (vlax-ename->vla-object ent)))
      (setq d (deg-safe-dist-at-point obj pt))
      (setq endPar (vl-catch-all-apply 'vlax-curve-getEndParam (list obj)))
      (if (vl-catch-all-error-p endPar)
        nil
        (progn
          (setq endDist (vl-catch-all-apply 'vlax-curve-getDistAtParam (list obj endPar)))
          (if (or (vl-catch-all-error-p endDist) (not (numberp endDist)))
            nil
            (progn
              (setq span (min 1.0 (max 0.01 (/ endDist 100.0))))
              (setq d1 (max 0.0 (- d span)))
              (setq d2 (min endDist (+ d span)))
              (if (<= (abs (- d2 d1)) 1e-9)
                nil
                (progn
                  (setq p1 (vl-catch-all-apply 'vlax-curve-getPointAtDist (list obj d1)))
                  (setq p2 (vl-catch-all-apply 'vlax-curve-getPointAtDist (list obj d2)))
                  (if (or (vl-catch-all-error-p p1) (vl-catch-all-error-p p2))
                    nil
                    (progn
                      (setq p1 (deg-pt3 p1))
                      (setq p2 (deg-pt3 p2))
                      (if (or (null p1) (null p2))
                        nil
                        (progn
                          (setq dx (- (car p2) (car p1)))
                          (setq dy (- (cadr p2) (cadr p1)))
                          (setq len (sqrt (+ (* dx dx) (* dy dy))))
                          (if (> len 1e-9)
                            (list (/ dx len) (/ dy len) 0.0)
                            nil
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
(defun DEGDC--shift-point-on-curve (ent pt delta / obj curDist endPar endDist target res)
  (setq obj (if (vlax-objectp ent) ent (vlax-ename->vla-object ent)))
  (setq curDist (deg-safe-dist-at-point obj pt))
  (setq endPar (vl-catch-all-apply 'vlax-curve-getEndParam (list obj)))
  (if (vl-catch-all-error-p endPar)
    nil
    (progn
      (setq endDist (vl-catch-all-apply 'vlax-curve-getDistAtParam (list obj endPar)))
      (if (vl-catch-all-error-p endDist)
        nil
        (progn
          (setq target (+ curDist delta))
          (if (< target 0.0) (setq target 0.0))
          (if (> target endDist) (setq target endDist))
          (setq res (vl-catch-all-apply 'vlax-curve-getPointAtDist (list obj target)))
          (if (vl-catch-all-error-p res)
            nil
            (deg-pt3 res)
          )
        )
      )
    )
  )
)

(defun DEGDC--pick-directed-join-rec (fromPt joinRec / pickPt joinPt joinEnt uTan rawTan prefTan dir bias shift newJoin)
  (setq pickPt (deg-pt3 *DEGDC_PICKPT*))
  (if (or (null joinRec) (null pickPt))
    joinRec
    (progn
      (setq joinPt (car joinRec) joinEnt (cadr joinRec))
      (setq uTan (DEGDC--curve-unit-tangent joinEnt joinPt))
      (if (null uTan)
        joinRec
        (progn
          (setq rawTan (+ (* (- (car fromPt) (car joinPt)) (car uTan)) (* (- (cadr fromPt) (cadr joinPt)) (cadr uTan))))
          (setq prefTan (+ (* (- (car pickPt) (car joinPt)) (car uTan)) (* (- (cadr pickPt) (cadr joinPt)) (cadr uTan))))
          (cond
            ((> prefTan 1e-6) (setq dir 1.0))
            ((< prefTan -1e-6) (setq dir -1.0))
            ((> rawTan 1e-6) (setq dir -1.0))
            ((< rawTan -1e-6) (setq dir 1.0))
            (T (setq dir 1.0))
          )
          (setq bias (max (* 2.0 (DEG:CFG-NUM-OR 'DC_FILLET_R 10.0)) 1.0))
          (setq shift (+ rawTan (* dir bias)))
          (setq newJoin (DEGDC--shift-point-on-curve joinEnt joinPt shift))
          (if newJoin
            (list newJoin joinEnt (distance fromPt newJoin))
            joinRec
          )
        )
      )
    )
  )
)

(defun DEGDC--ortho-join-pts (fromPt joinPt joinEnt / uTan uPerp vx vy rawTan rawPerp pickPt prefTan projTan perpDir rad stubLen pStub pMid)
  (setq uTan (DEGDC--curve-unit-tangent joinEnt joinPt))
  (if (null uTan)
    (list (deg-pt3 joinPt))
    (progn
      (setq uPerp (list (- (cadr uTan)) (car uTan) 0.0))
      (setq vx (- (car fromPt) (car joinPt)))
      (setq vy (- (cadr fromPt) (cadr joinPt)))
      (setq rawTan  (+ (* vx (car uTan))  (* vy (cadr uTan))))
      (setq rawPerp (+ (* vx (car uPerp)) (* vy (cadr uPerp))))
      (setq pickPt (deg-pt3 *DEGDC_PICKPT*))
      (if pickPt
        (setq prefTan (+ (* (- (car pickPt) (car joinPt)) (car uTan)) (* (- (cadr pickPt) (cadr joinPt)) (cadr uTan))))
        (setq prefTan rawTan)
      )
      (cond
        ((> prefTan 1e-6) (setq projTan (abs rawTan)))
        ((< prefTan -1e-6) (setq projTan (- (abs rawTan))))
        (T (setq projTan rawTan))
      )
      (cond
        ((> rawPerp 1e-6) (setq perpDir 1.0))
        ((< rawPerp -1e-6) (setq perpDir -1.0))
        (T (setq perpDir 1.0))
      )
      (setq rad (DEG:CFG-NUM-OR 'DC_FILLET_R 10.0))
      (if (<= rad 0.0) (setq rad 10.0))
      (setq stubLen (max (* rad 2.0) 1.0))
      (setq pStub
        (list
          (+ (car joinPt) (* perpDir stubLen (car uPerp)))
          (+ (cadr joinPt) (* perpDir stubLen (cadr uPerp)))
          (if (caddr joinPt) (caddr joinPt) 0.0)
        )
      )
      (setq pMid
        (list
          (+ (car pStub) (* projTan (car uTan)))
          (+ (cadr pStub) (* projTan (cadr uTan)))
          (if (caddr joinPt) (caddr joinPt) 0.0)
        )
      )
      (g365_clean_pts (list pMid pStub (deg-pt3 joinPt)))
    )
  )
)
(defun DEGDC--tail-hit-bbox-p (fromPt tail bb / segA segB)
  (and bb tail (> (length tail) 0)
       (or
         (DEGDC--seg-hit-bbox-p fromPt (car tail) bb)
         (and (> (length tail) 1)
              (setq segA (nth (- (length tail) 2) tail))
              (setq segB (car (last tail)))
              (DEGDC--seg-hit-bbox-p segA segB bb))
       )
  )
)

(defun DEGDC--adjust-join-for-bbox (fromPt joinRec bb / gap joinPt joinEnt tail segA segB uTan ctr d need signs scales sc s newJoin newTail chosen)
  (setq gap (DEG:CFG-NUM-OR 'DC_CLEAR_GAP 5.0))
  (if (<= gap 0.0) (setq gap 5.0))
  (if (or (null bb) (null joinRec))
    joinRec
    (progn
      (setq joinPt (car joinRec) joinEnt (cadr joinRec))
      (setq tail (DEGDC--ortho-join-pts fromPt joinPt joinEnt))
      (if (or (null tail) (< (length tail) 2))
        joinRec
        (progn
          (setq segA (nth (- (length tail) 2) tail))
          (setq segB (car (last tail)))
          (if (not (DEGDC--seg-hit-bbox-p segA segB bb))
            joinRec
            (progn
              (setq uTan (DEGDC--curve-unit-tangent joinEnt joinPt))
              (if (null uTan)
                joinRec
                (progn
                  (setq ctr (degw-bbox-center bb))
                  (setq d (DEGDC--dot2 (list (- (car joinPt) (car ctr)) (- (cadr joinPt) (cadr ctr)) 0.0) uTan))
                  (setq need (- (+ (DEGDC--bbox-support bb uTan) gap) (abs d)))
                  (if (<= need 0.0) (setq need gap))
                  (setq signs (if (>= d 0.0) (list 1.0 -1.0) (list -1.0 1.0)))
                  (setq scales (list 1.0 1.5 2.0 3.0 4.0 6.0 8.0 12.0))
                  (foreach sc scales
                    (foreach s signs
                      (if (null chosen)
                        (progn
                          (setq newJoin (DEGDC--shift-point-on-curve joinEnt joinPt (* s need sc)))
                          (if newJoin
                            (progn
                              (setq newTail (DEGDC--ortho-join-pts fromPt newJoin joinEnt))
                              (if (and newTail (> (length newTail) 1)
                                       (not (DEGDC--seg-hit-bbox-p (nth (- (length newTail) 2) newTail) (car (last newTail)) bb)))
                                (setq chosen (list newJoin joinEnt (distance fromPt newJoin)))
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                  (if chosen chosen joinRec)
                )
              )
            )
          )
        )
      )
    )
  )
)

(defun DEGDC--safe-tail-pts (fromPt joinRec blkEnt / gap bb joinAdj tail firstPt uTan uPerp ctr d need signs scales sc s esc tail2 chosen)
  (setq gap (DEG:CFG-NUM-OR 'DC_CLEAR_GAP 5.0))
  (if (<= gap 0.0) (setq gap 5.0))
  (setq bb (DEGDC--block-visible-bbox blkEnt))
  (if bb
    (setq bb (degw-bbox-expand bb gap))
  )
  (setq joinAdj (if bb (DEGDC--adjust-join-for-bbox fromPt joinRec bb) joinRec))
  (if (null joinAdj)
    nil
    (progn
      (setq tail (DEGDC--ortho-join-pts fromPt (car joinAdj) (cadr joinAdj)))
      (if (or (null bb) (null tail) (= (length tail) 0))
        tail
        (progn
          (if (DEGDC--tail-hit-bbox-p fromPt tail bb)
            (progn
              (setq joinAdj (DEGDC--adjust-join-for-bbox fromPt joinAdj (degw-bbox-expand bb gap)))
              (setq tail (DEGDC--ortho-join-pts fromPt (car joinAdj) (cadr joinAdj)))
            )
          )
          (if (not (DEGDC--tail-hit-bbox-p fromPt tail bb))
            tail
            (progn
              (setq firstPt (car tail))
              (if (not (DEGDC--seg-hit-bbox-p fromPt firstPt bb))
                nil
                (progn
                  (setq uTan (DEGDC--curve-unit-tangent (cadr joinAdj) (car joinAdj)))
                  (if (null uTan)
                    tail
                    (progn
                      (setq uPerp (list (- (cadr uTan)) (car uTan) 0.0))
                      (setq ctr (degw-bbox-center bb))
                      (setq d (DEGDC--dot2 (list (- (car fromPt) (car ctr)) (- (cadr fromPt) (cadr ctr)) 0.0) uPerp))
                      (setq need (- (+ (DEGDC--bbox-support bb uPerp) gap) (abs d)))
                      (if (<= need 0.0) (setq need gap))
                      (setq signs (if (>= d 0.0) (list 1.0 -1.0) (list -1.0 1.0)))
                      (setq scales (list 1.0 1.5 2.0 3.0 4.0 6.0))
                      (foreach sc scales
                        (foreach s signs
                          (if (null chosen)
                            (progn
                              (setq esc (DEGDC--pt+scale fromPt uPerp (* s need sc)))
                              (setq tail2 (DEGDC--ortho-join-pts esc (car joinAdj) (cadr joinAdj)))
                              (if (and tail2 (> (length tail2) 0)
                                       (not (DEGDC--seg-hit-bbox-p fromPt esc bb))
                                       (not (DEGDC--tail-hit-bbox-p esc tail2 bb)))
                                (setq chosen (append (list esc) tail2))
                              )
                            )
                          )
                        )
                      )
                      (if chosen chosen tail)
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

(defun DEGDC--build-link-pts (blkEnt ents / blkObj ins rot downAng pDown joinRec tailPts downLen)
  (if (and blkEnt (entget blkEnt))
    (progn
      (setq blkObj (vlax-ename->vla-object blkEnt))
      (setq ins (deg-get-inspt blkObj))
      (if ins
        (progn
          (setq downLen (DEG:CFG-NUM-OR 'DC_DOWN_LEN 200.0))
          (if (<= downLen 0.0) (setq downLen 200.0))
          (setq rot     (DEGDC--block-rotation blkEnt))
          (setq downAng (- rot (/ pi 2.0)))
          (setq pDown   (DEGDC--offset-point ins downAng downLen))
          (setq joinRec (DEGDC--closest-on-ents pDown ents))
          (if joinRec
            (progn
              (setq tailPts (g365_clean_pts (DEGDC--ortho-join-pts pDown (car joinRec) (cadr joinRec))))
              (if tailPts
                (g365_clean_pts (append (list ins pDown) tailPts))
                nil
              )
            )
            nil
          )
        )
        nil
      )
    )
    nil
  )
)
(defun DEGDC--cross2 (a b)
  (- (* (car a) (cadr b)) (* (cadr a) (car b)))
)

(defun DEGDC--clamp (v lo hi)
  (max lo (min hi v))
)

(defun DEGDC--acos (x / xc y)
  (setq xc (DEGDC--clamp x -1.0 1.0))
  (cond
    ((>= xc 1.0) 0.0)
    ((<= xc -1.0) pi)
    (T
      (setq y (sqrt (max 0.0 (- 1.0 (* xc xc)))))
      (atan y xc)
    )
  )
)

(defun DEGDC--tan (x / c)
  (setq c (cos x))
  (if (< (abs c) 1e-12)
    nil
    (/ (sin x) c)
  )
)

(defun DEGDC--unit-from-to (a b / dx dy len)
  (setq dx (- (car b) (car a)))
  (setq dy (- (cadr b) (cadr a)))
  (setq len (sqrt (+ (* dx dx) (* dy dy))))
  (if (> len 1e-9)
    (list (/ dx len) (/ dy len) 0.0)
    nil
  )
)

(defun DEGDC--closest-point-on-seg (a b p / pA pB pP ax ay bx by px py vx vy wx wy vv t)
  (setq pA (deg-pt3 a))
  (setq pB (deg-pt3 b))
  (setq pP (deg-pt3 p))
  (if (or (null pA) (null pB) (null pP))
    nil
    (progn
      (setq ax (car pA) ay (cadr pA))
      (setq bx (car pB) by (cadr pB))
      (setq px (car pP) py (cadr pP))
      (setq vx (- bx ax) vy (- by ay))
      (setq wx (- px ax) wy (- py ay))
      (setq vv (+ (* vx vx) (* vy vy)))
      (if (<= vv 1e-12)
        pA
        (progn
          (setq t (/ (+ (* wx vx) (* wy vy)) vv))
          (if (< t 0.0) (setq t 0.0))
          (if (> t 1.0) (setq t 1.0))
          (list
            (+ ax (* t vx))
            (+ ay (* t vy))
            (if (caddr pP) (caddr pP) 0.0)
          )
        )
      )
    )
  )
)

(defun DEGDC--segment-unit-at-point (ent pt / pts basePt bestU bestD i p1 p2 cp d)
  (setq pts (g365_get_pts ent))
  (setq basePt (deg-pt3 pt))
  (if (and basePt pts (> (length pts) 1))
    (progn
      (setq bestU nil bestD nil i 0)
      (while (< i (1- (length pts)))
        (setq p1 (deg-pt3 (nth i pts)))
        (setq p2 (deg-pt3 (nth (1+ i) pts)))
        (if (and p1 p2 (> (distance p1 p2) 1e-9))
          (progn
            (setq cp (DEGDC--closest-point-on-seg p1 p2 basePt))
            (if cp
              (progn
                (setq d (distance basePt cp))
                (if (or (null bestD) (< d bestD))
                  (progn
                    (setq bestD d)
                    (setq bestU (DEGDC--unit-from-to p1 p2))
                  )
                )
              )
            )
          )
        )
        (setq i (1+ i))
      )
      bestU
    )
    nil
  )
)

(defun DEGDC--zeros (n / out)
  (setq out nil)
  (while (> n 0)
    (setq out (cons 0.0 out))
    (setq n (1- n))
  )
  out
)

(defun DEGDC--set-nth (lst idx val / out i)
  (setq out nil i 0)
  (foreach x lst
    (setq out (cons (if (= i idx) val x) out))
    (setq i (1+ i))
  )
  (reverse out)
)

(defun DEGDC--entmake-open-poly-bulges (lay pts buls / data i pt b)
  (if (and pts (> (length pts) 1))
    (progn
      (setq data (list
        (cons 0 "LWPOLYLINE")
        (cons 100 "AcDbEntity")
        (cons 8 lay)
        (cons 100 "AcDbPolyline")
        (cons 90 (length pts))
        (cons 70 0)
        (cons 38 0.0)
        (cons 43 0.0)
      ))
      (setq i 0)
      (while (< i (length pts))
        (setq pt (nth i pts))
        (setq data (append data (list (cons 10 (list (car pt) (cadr pt))))))
        (setq b (if (and buls (< i (length buls))) (nth i buls) 0.0))
        (if (and b (/= b 0.0))
          (setq data (append data (list (cons 42 b))))
        )
        (setq i (1+ i))
      )
      (entmakex data)
    )
    nil
  )
)

(defun DEGDC--fillet-last-corner-data (pts rad / n prev corner next u1 u2 len1 len2 dot ang trim maxTrim pA pB prefix outPts buls bulge i bulIdx)
  (setq pts (g365_clean_pts pts))
  (setq n (length pts))
  (if (or (null pts) (< n 4) (null rad) (<= rad 1e-9))
    (list pts nil)
    (progn
      (setq prev   (nth (- n 3) pts))
      (setq corner (nth (- n 2) pts))
      (setq next   (nth (- n 1) pts))
      (setq u1 (DEGDC--unit-from-to prev corner))
      (setq u2 (DEGDC--unit-from-to corner next))
      (if (or (null u1) (null u2))
        (list pts nil)
        (progn
          (setq len1 (distance prev corner))
          (setq len2 (distance corner next))
          (setq dot (DEGDC--clamp (DEGDC--dot2 u1 u2) -1.0 1.0))
          (setq ang (DEGDC--acos dot))
          (if (or (<= ang 1e-6) (>= ang (- pi 1e-6)))
            (list pts nil)
            (progn
              (setq trim (* rad (DEGDC--tan (/ ang 2.0))))
              (setq maxTrim (- (min len1 len2) 1e-6))
              (if (or (null trim) (> trim maxTrim)) (setq trim maxTrim))
              (if (<= trim 1e-6)
                (list pts nil)
                (progn
                  (setq pA (DEGDC--pt+scale corner u1 (- trim)))
                  (setq pB (DEGDC--pt+scale corner u2 trim))
                  (setq prefix nil)
                  (setq i 0)
                  (while (<= i (- n 3))
                    (setq prefix (append prefix (list (nth i pts))))
                    (setq i (1+ i))
                  )
                  (if (< (distance pB next) 1e-6)
                    (setq outPts (append prefix (list pA next)))
                    (setq outPts (append prefix (list pA pB next)))
                  )
                  (setq outPts (g365_clean_pts outPts))
                  (setq buls (DEGDC--zeros (length outPts)))
                  (setq bulge (* (if (< (DEGDC--cross2 u1 u2) 0.0) -1.0 1.0) (DEGDC--tan (/ ang 4.0))))
                  (setq bulIdx (length prefix))
                  (if (and (>= bulIdx 0) (< bulIdx (length buls)))
                    (setq buls (DEGDC--set-nth buls bulIdx bulge))
                  )
                  (list outPts buls)
                )
              )
            )
          )
        )
      )
    )
  )
)
(defun DEGDC--draw-link (mainEnt pts / lay rad filletData pts2 buls newEnt)
  (setq lay (getvar "CLAYER"))
  (setq rad (DEG:CFG-NUM-OR 'DC_FILLET_R 10.0))
  (if (and pts (> (length pts) 1))
    (progn
      (setq filletData (vl-catch-all-apply 'DEGDC--fillet-last-corner-data (list pts rad)))
      (if (vl-catch-all-error-p filletData)
        (setq newEnt (g365_entmake_open_poly lay pts))
        (progn
          (setq pts2 (car filletData))
          (setq buls (cadr filletData))
          (if (and buls pts2 (> (length pts2) 1))
            (progn
              (setq newEnt (vl-catch-all-apply 'DEGDC--entmake-open-poly-bulges (list lay pts2 buls)))
              (if (vl-catch-all-error-p newEnt)
                (setq newEnt nil)
              )
            )
          )
          (if (null newEnt)
            (setq newEnt (g365_entmake_open_poly lay pts))
          )
        )
      )
      newEnt
    )
    nil
  )
)

(defun DC_ORIG (/ sel mainEnt found ssSel ssBlk i blkEnt pts newEnt cnt)
  (vl-load-com)
  (setq sel (entsel "\nDC: Polyline sec (bagli hatlari bul): "))
  (if (null sel)
    (princ "\nSecim yok.")
    (progn
      (setq mainEnt (car sel))
      (setq *DEGDC_PICKPT* (cadr sel))
      (if (not (wcmatch (cdr (assoc 0 (entget mainEnt))) "LWPOLYLINE,POLYLINE,LINE"))
        (princ "\nGecerli bir polyline/line sec.")
        (progn
          (setq found (DEGDC--collect-connected mainEnt))
          (if (and found (> (length found) 0))
            (progn
              (setq ssSel (g415_ss_from_list found))
              (sssetfirst nil ssSel)
              (princ (strcat "\nDC: " (itoa (DEG:SS-LEN ssSel)) " obje secildi."))
              (prompt "\nDC: Block'lari sec (INSERT): ")
              (setq ssBlk (ssget '((0 . "INSERT"))))
              (if (null ssBlk)
                (princ "\nBlock secimi yok.")
                (progn
                  (setq i 0 cnt 0)
                  (while (< i (sslength ssBlk))
                    (setq blkEnt (ssname ssBlk i))
                    (setq pts (vl-catch-all-apply 'DEGDC--build-link-pts (list blkEnt found)))
                    (if (vl-catch-all-error-p pts)
                      (setq pts nil)
                    )
                    (if pts
                      (progn
                        (setq newEnt (vl-catch-all-apply 'DEGDC--draw-link (list mainEnt pts)))
                        (if (vl-catch-all-error-p newEnt)
                          (setq newEnt nil)
                        )
                        (if newEnt
                          (setq cnt (1+ cnt))
                        )
                      )
                    )
                    (setq i (1+ i))
                  )
                  (princ (strcat "\nDC: " (itoa cnt) " baglanti cizildi."))
                )
              )
            )
            (progn
              (sssetfirst nil nil)
              (princ "\nDC: Bagli hat bulunamadi.")
            )
          )
        )
      )
    )
  )
  (setq *DEGDC_PICKPT* nil)
  (princ)
)

(defun c:DC ()
  (if (KC:InitLicense)
    (DC_ORIG)
    (KC:Blocked)
  )
)
(defun DEG:UNDO-GROUP-BEGIN (/ app doc res)
  (vl-load-com)
  (setq app (vl-catch-all-apply 'vlax-get-acad-object '()))
  (if (not (vl-catch-all-error-p app))
    (setq doc (vl-catch-all-apply 'vla-get-ActiveDocument (list app)))
  )
  (if (and doc (not (vl-catch-all-error-p doc)))
    (setq res (vl-catch-all-apply 'vla-StartUndoMark (list doc)))
  )
  (if (and doc (not (vl-catch-all-error-p doc))
           (not (vl-catch-all-error-p res)))
    (list 'VLA doc)
    (progn
      (setq res (vl-catch-all-apply 'vl-cmdf (list "_.UNDO" "_Begin")))
      (if (vl-catch-all-error-p res) nil (list 'CMD nil))
    )
  )
)

(defun DEG:UNDO-GROUP-END (token)
  (cond
    ((and token (= (car token) 'VLA) (cadr token))
      (vl-catch-all-apply 'vla-EndUndoMark (list (cadr token))))
    ((and token (= (car token) 'CMD))
      (vl-catch-all-apply 'vl-cmdf (list "_.UNDO" "_End")))
  )
  nil
)

;; Ana hatta dik bir sirada bulunan yakin blocklar, dogrudan ana hatta
;; baglandiklarinda ayni agzi paylasip ust uste binebilir. Bu ozel durumda
;; ana hatta temas eden ve block sirasinin 40 cm gerisinden gecen bir alt dal
;; olusturulur. Mevcut DD/DZ cizicisi blocklari bu dal uzerinden ayri ayri
;; baglar; diger blocklar normal ana-hat akisini kullanmaya devam eder.
(defun DEGZ--selected-block-groups (ss nearLim / cell cells parents data i blk ip key cx cy ix iy rec item blk2 ip2)
  (setq cell (max nearLim 1e-6)
        cells '()
        parents '()
        data '())
  (if (and ss (= (type ss) 'PICKSET))
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq blk (ssname ss i))
        (if (and blk (entget blk) (not (DEGZ--skip-block-p blk)))
          (progn
            (setq ip (DEGZ--pt2d (cdr (assoc 10 (entget blk))))
                  parents (DEGZ--uf-init parents blk)
                  data (append data (list (list blk ip)))
                  key (DEGZ--cellkey ip cell)
                  cx (car key)
                  cy (cadr key)
                  ix -1)
            (while (<= ix 1)
              (setq iy -1)
              (while (<= iy 1)
                (setq rec (assoc (list (+ cx ix) (+ cy iy)) cells))
                (if rec
                  (foreach item (cdr rec)
                    (setq blk2 (car item)
                          ip2 (cadr item))
                    (if (and blk2 ip2 (<= (DEGZ--safe-distance ip ip2) nearLim))
                      (setq parents (DEGZ--uf-union parents blk blk2))
                    )
                  )
                )
                (setq iy (1+ iy))
              )
              (setq ix (1+ ix))
            )
            (setq cells (DEGZ--cells-put cells (list cx cy) (list blk ip)))
          )
        )
        (setq i (1+ i))
      )
    )
  )
  (DEGZ--groups-build parents data)
)

(defun DEGZ--row-axis-from-records (recs / bestD bestA bestB r1 r2 p1 p2 d)
  (setq bestD 0.0)
  (foreach r1 recs
    (setq p1 (DEGZ--pt2d (cadr r1)))
    (foreach r2 recs
      (setq p2 (DEGZ--pt2d (cadr r2))
            d (DEGZ--safe-distance p1 p2))
      (if (> d bestD)
        (setq bestD d
              bestA p1
              bestB p2))))
  (if (> bestD 1e-6)
    (DEGZ--canonical-vector
      (- (car bestB) (car bestA))
      (- (cadr bestB) (cadr bestA)))
    nil)
)

(defun DEGZ--compatible-parent-record
  (mainCrv avg rowAxis / e pts ed closed n lim i a b segLen segAxis dotAbs hit d2 bestD bestPt bestTan)
  ;; En yakin herhangi bir parcayi degil, block sirasina dik olan en yakin
  ;; ana/cocuk hat parcasini ebeveyn sec.
  (setq e (DEGZ--ename mainCrv)
        pts (if e (DEGZ--get-lwpts e))
        ed (if e (entget e))
        closed (if ed (cdr (assoc 70 ed)) 0))
  (if (null closed) (setq closed 0))
  (if (and pts rowAxis (>= (length pts) 2))
    (progn
      (setq n (length pts)
            lim (if (/= (logand closed 1) 0) n (1- n))
            i 0
            bestD 1e99)
      (while (< i lim)
        (setq a (DEGZ--pt2d (nth i pts))
              b (DEGZ--pt2d (nth (if (= i (1- n)) 0 (1+ i)) pts))
              segLen (DEGZ--safe-distance a b))
        (if (> segLen 1e-6)
          (progn
            (setq segAxis (DEGZ--canonical-vector
                            (- (car b) (car a))
                            (- (cadr b) (cadr a)))
                  dotAbs (abs (+ (* (car segAxis) (car rowAxis))
                                 (* (cadr segAxis) (cadr rowAxis)))))
            (if (< dotAbs 0.25)
              (progn
                (setq hit (DEGZ--closest-on-seg a b avg)
                      d2 (cadr hit))
                (if (< d2 bestD)
                  (setq bestD d2
                        bestPt (car hit)
                        bestTan segAxis))))))
        (setq i (1+ i)))
      (if bestPt
        (list bestPt bestTan (DEGZ--safe-distance avg bestPt))))
  )
)

(defun DEGZ--perp-row-branch-points (mainCrv recs alignTol dropDist extend maxConnectDist / count sx sy avg cp tan tx ty nx ny minT maxT minN maxN r ip vx vy qT qN rowSide rowSign downSign target attach ux uy along maxAlong valid endDist connectDist rowAxis parentRec)
  (if (< (length recs) 2)
    nil
    (progn
      (setq count 0 sx 0.0 sy 0.0)
      (foreach r recs
        (setq ip (DEGZ--pt2d (cadr r))
              sx (+ sx (car ip))
              sy (+ sy (cadr ip))
              count (1+ count))
      )
      (setq avg (list (/ sx count) (/ sy count))
            rowAxis (DEGZ--row-axis-from-records recs)
            parentRec (DEGZ--compatible-parent-record mainCrv avg rowAxis)
            cp (if parentRec
                 (car parentRec)
                 (DEGZ--pt2d (deg-safe-closest-point mainCrv avg)))
            connectDist (if parentRec
                          (caddr parentRec)
                          (DEGZ--safe-distance avg cp))
            tan (if parentRec
                  (cadr parentRec)
                  (DEGZ--canonical-tangent-at mainCrv cp))
            tx (car tan)
            ty (cadr tan)
            nx (- ty)
            ny tx
            minT nil maxT nil minN nil maxN nil)
      (foreach r recs
        (setq ip (DEGZ--pt2d (cadr r))
              vx (- (car ip) (car avg))
              vy (- (cadr ip) (cadr avg))
              qT (+ (* vx tx) (* vy ty))
              qN (+ (* vx nx) (* vy ny)))
        (if (or (null minT) (< qT minT)) (setq minT qT))
        (if (or (null maxT) (> qT maxT)) (setq maxT qT))
        (if (or (null minN) (< qN minN)) (setq minN qN))
        (if (or (null maxN) (> qN maxN)) (setq maxN qN))
      )
      (setq rowSide
        (+ (* (- (car avg) (car cp)) nx)
           (* (- (cadr avg) (cadr cp)) ny)))
      (if (or (> (- maxT minT) alignTol)
              (<= (- maxN minN) 1e-6)
              (<= (abs rowSide) alignTol)
              (and (numberp maxConnectDist)
                   (> maxConnectDist 0.0)
                   (> connectDist maxConnectDist)))
        nil
        (progn
          ;; Kanonik tegetin WCS'te asagi bakan yonunu sec. Yatay tegette
          ;; ayni geometrik kural, tegetin eksi yonunu kullanir.
          (setq downSign
            (cond
              ((> ty 1e-8) -1.0)
              ((< ty -1e-8) 1.0)
              (T -1.0)))
          (setq target
            (list (+ (car avg) (* tx downSign dropDist))
                  (+ (cadr avg) (* ty downSign dropDist)))
                attach (DEGZ--pt2d (deg-safe-closest-point mainCrv target))
                rowSign (if (>= rowSide 0.0) 1.0 -1.0)
                ux (* nx rowSign)
                uy (* ny rowSign)
                maxAlong 0.0
                valid T)
          (foreach r recs
            (setq ip (DEGZ--pt2d (cadr r))
                  along (+ (* (- (car ip) (car attach)) ux)
                           (* (- (cadr ip) (cadr attach)) uy)))
            (if (< along (- alignTol)) (setq valid nil))
            (if (> along maxAlong) (setq maxAlong along))
          )
          (if (not valid)
            nil
            (progn
              (setq endDist (+ maxAlong extend))
              (list attach
                    (list (+ (car attach) (* ux endDist))
                          (+ (cadr attach) (* uy endDist))))
            )
          )
        )
      )
    )
  )
)

(defun DEGZ--selected-aligned-groups (mainCrv ss alignTol dropDist extend maxConnectDist / data rows i blk ip rec best bestDist g candidate branchPts d r newRows)
  ;; Bu ozel 40 cm dal gruplamasinda bloklarin birbirine uzakligi sinir degildir.
  ;; Bir blok birden fazla hizaya uyarsa yalnizca en yakin mevcut hizaya eklenir.
  (setq data '()
        rows '())
  (if (and ss (= (type ss) 'PICKSET))
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq blk (ssname ss i))
        (if (and blk (entget blk) (not (DEGZ--skip-block-p blk)))
          (progn
            (setq ip (DEGZ--pt2d (cdr (assoc 10 (entget blk)))))
            (setq data (append data (list (list blk ip))))
          )
        )
        (setq i (1+ i))
      )
    )
  )
  (foreach rec data
    (setq best nil
          bestDist nil)
    (foreach g rows
      (setq candidate (append (cdr g) (list rec))
            branchPts (DEGZ--perp-row-branch-points
                        mainCrv candidate alignTol dropDist extend maxConnectDist))
      (if branchPts
        (progn
          (setq d nil)
          (foreach r (cdr g)
            (if (or (null d)
                    (< (DEGZ--safe-distance (cadr rec) (cadr r)) d))
              (setq d (DEGZ--safe-distance (cadr rec) (cadr r)))
            )
          )
          (if (or (null bestDist) (< d bestDist))
            (setq best g
                  bestDist d)
          )
        )
      )
    )
    (if best
      (progn
        (setq newRows '())
        (foreach g rows
          (if (eq g best)
            (setq newRows
              (append newRows
                (list (cons (car g) (append (cdr g) (list rec))))))
            (setq newRows (append newRows (list g)))
          )
        )
        (setq rows newRows)
      )
      (setq rows (append rows (list (list (car rec) rec))))
    )
  )
  rows
)

(defun DEGZ--records-average (recs / count sx sy rec ip)
  (setq count 0
        sx 0.0
        sy 0.0)
  (foreach rec recs
    (setq ip (DEGZ--pt2d (cadr rec))
          sx (+ sx (car ip))
          sy (+ sy (cadr ip))
          count (1+ count)))
  (if (> count 0)
    (list (/ sx count) (/ sy count))
    nil)
)

(defun DEGZ--axis-level (pt axis)
  (+ (* (car pt) (car axis))
     (* (cadr pt) (cadr axis)))
)

(defun DEGZ--row-level-match-count (recsA recsB axis tol / count recA recB levelA levelB matched)
  (setq count 0)
  (foreach recA recsA
    (setq levelA (DEGZ--axis-level (DEGZ--pt2d (cadr recA)) axis)
          matched nil)
    (foreach recB recsB
      (setq levelB (DEGZ--axis-level (DEGZ--pt2d (cadr recB)) axis))
      (if (<= (abs (- levelA levelB)) tol)
        (setq matched T)))
    (if matched (setq count (1+ count))))
  count
)

(defun DEGZ--records-by-axis-level (recs axis tol / parents i j recA recB levelA levelB groups)
  ;; Ortak omurgadaki blocklari ayni kot/seviye satirlarina ayir.
  (setq parents '())
  (foreach recA recs
    (setq parents (DEGZ--uf-init parents (car recA))))
  (setq i 0)
  (while (< i (length recs))
    (setq recA (nth i recs)
          levelA (DEGZ--axis-level (DEGZ--pt2d (cadr recA)) axis)
          j (1+ i))
    (while (< j (length recs))
      (setq recB (nth j recs)
            levelB (DEGZ--axis-level (DEGZ--pt2d (cadr recB)) axis))
      (if (<= (abs (- levelA levelB)) tol)
        (setq parents (DEGZ--uf-union parents (car recA) (car recB))))
      (setq j (1+ j)))
    (setq i (1+ i)))
  (setq groups (DEGZ--groups-build parents recs))
  (mapcar (function (lambda (group) (cdr group))) groups)
)

(defun DEGZ--extend-branch-for-records (branchPts recs extend / attach far dir originalLen maxAlong rec ip along)
  (setq attach (DEGZ--pt2d (car branchPts))
        far (DEGZ--pt2d (cadr branchPts))
        dir (DEGZ--unit (- (car far) (car attach))
                        (- (cadr far) (cadr attach)))
        originalLen (DEGZ--safe-distance attach far)
        maxAlong 0.0)
  (foreach rec recs
    (setq ip (DEGZ--pt2d (cadr rec))
          along (+ (* (- (car ip) (car attach)) (car dir))
                   (* (- (cadr ip) (cadr attach)) (cadr dir))))
    (if (> along maxAlong) (setq maxAlong along)))
  (setq maxAlong (max originalLen (+ maxAlong extend)))
  (list attach
        (list (+ (car attach) (* (car dir) maxAlong))
              (+ (cadr attach) (* (cadr dir) maxAlong))))
)

(defun DEGZ--insert-child-detour (mainCrv branchPts short / attachBase farCenter dMid maxDist distPair mouthA mouthB deltaA deltaB farA farB res)
  ;; Ortak omurganin bir kenarinda agiz acip seviyeye cift hatli cocuk dal ekle.
  (setq mainCrv (DEGZ--ename mainCrv)
        attachBase (DEGZ--pt2d (car branchPts))
        farCenter (DEGZ--pt2d (cadr branchPts))
        dMid (vl-catch-all-apply
               'vlax-curve-getDistAtPoint
               (list mainCrv (DEGZ--pt3d attachBase))))
  (if (vl-catch-all-error-p dMid)
    nil
    (progn
      (setq dMid (DEGZ--corner-mouth-center-dist
                   mainCrv attachBase farCenter dMid (* 0.5 short))
            maxDist (DEGZ--curve-total mainCrv)
            distPair (DEGZ--distpair10 dMid 1.0 maxDist (* 0.5 short))
            mouthA (DEGZ--pt2d
                     (vlax-curve-getPointAtDist mainCrv (car distPair)))
            mouthB (DEGZ--pt2d
                     (vlax-curve-getPointAtDist mainCrv (cadr distPair)))
            deltaA (list (- (car mouthA) (car attachBase))
                         (- (cadr mouthA) (cadr attachBase)))
            deltaB (list (- (car mouthB) (car attachBase))
                         (- (cadr mouthB) (cadr attachBase)))
            farA (list (+ (car farCenter) (car deltaA))
                       (+ (cadr farCenter) (cadr deltaA)))
            farB (list (+ (car farCenter) (car deltaB))
                       (+ (cadr farCenter) (cadr deltaB)))
            res (vl-catch-all-apply
                  'DEGZ--insert-detour
                  (list mainCrv mouthA mouthB (list farA farB))))
      (if (and (not (vl-catch-all-error-p res))
               res
               (entget (DEGZ--ename res)))
        (DEGZ--ename res)
        nil)))
)

(defun DEGZ--aligned-group-descriptor
  (mainCrv g alignTol dropDist extend maxConnectDist / recs branchPts axis avg perp trans branchDir)
  (setq recs (cdr g)
        branchPts (DEGZ--perp-row-branch-points
                    mainCrv recs alignTol dropDist extend maxConnectDist)
        axis (DEGZ--row-axis-from-records recs)
        avg (DEGZ--records-average recs))
  (if (and branchPts axis avg)
    (progn
      (setq perp (DEGZ--canonical-vector (- (cadr axis)) (car axis))
            trans (DEGZ--axis-level avg perp)
            branchDir (DEGZ--unit
                        (- (car (cadr branchPts)) (car (car branchPts)))
                        (- (cadr (cadr branchPts)) (cadr (car branchPts)))))
      (list g recs branchPts axis avg trans branchDir))
    nil)
)

(defun DEGZ--aligned-descriptors-same-bank-p
  (descA descB alignTol dropDist extend / axisA axisB dirA dirB dotAxis dotDir transGap gapLimit matches)
  (setq axisA (nth 3 descA)
        axisB (nth 3 descB)
        dirA (nth 6 descA)
        dirB (nth 6 descB)
        dotAxis (abs (+ (* (car axisA) (car axisB))
                        (* (cadr axisA) (cadr axisB))))
        dotDir (+ (* (car dirA) (car dirB))
                  (* (cadr dirA) (cadr dirB)))
        transGap (abs (- (nth 5 descA) (nth 5 descB)))
        gapLimit (max (* 2.0 dropDist) (* 2.0 extend))
        matches (DEGZ--row-level-match-count
                  (nth 1 descA) (nth 1 descB) axisA alignTol))
  ;; En az iki ortak seviye, iki komsu block sutununun ayni banka ait
  ;; oldugunu gosterir. Tek ortak seviye tesadufi kesisme sayilir.
  (and (>= dotAxis 0.98)
       (>= dotDir 0.90)
       (<= transGap gapLimit)
       (>= matches 2))
)

(defun DEGZ--descriptor-fits-column-bank-p
  (candidate hostDescs alignTol / hostAxis candAxis dotAxis hostPerp rec recTrans hostDesc d bestD bestTrans used allMatch)
  ;; Greedy secimde yatay bir cift ayri grup kalabilir. Bu ciftin her blogu
  ;; birlesmis bankanin farkli bir dikey kolonuna oturuyorsa ayni seviyedir.
  (setq hostAxis (nth 3 (car hostDescs))
        candAxis (nth 3 candidate)
        dotAxis (abs (+ (* (car hostAxis) (car candAxis))
                        (* (cadr hostAxis) (cadr candAxis))))
        hostPerp (DEGZ--canonical-vector (- (cadr hostAxis)) (car hostAxis))
        used '()
        allMatch T)
  (if (or (>= dotAxis 0.25) (< (length (nth 1 candidate)) 2))
    nil
    (progn
      (foreach rec (nth 1 candidate)
        (setq recTrans (DEGZ--axis-level (DEGZ--pt2d (cadr rec)) hostPerp)
              bestD nil
              bestTrans nil)
        (foreach hostDesc hostDescs
          (setq d (abs (- recTrans (nth 5 hostDesc))))
          (if (or (null bestD) (< d bestD))
            (setq bestD d
                  bestTrans (nth 5 hostDesc))))
        (if (and bestD (<= bestD alignTol))
          (if (not (member bestTrans used))
            (setq used (cons bestTrans used)))
          (setq allMatch nil)))
      (and allMatch (>= (length used) 2))))
)

(defun DEGZ--descriptor-by-id (descs id / found desc)
  (foreach desc descs
    (if (equal (car (car desc)) id) (setq found desc)))
  found
)

(defun DEGZ--aligned-group-jobs
  (mainCrv groups alignTol dropDist extend maxConnectDist
   / descs g desc parents i j descA descB idA idB banks rep bank host other hostRep hostDescs candidate candidateId absorbMap owner newBanks newDescs pair extraDesc extraRecs jobs descList base axis allRecs branchPts rowGroups)
  (setq descs '()
        parents '())
  (foreach g groups
    (setq desc (DEGZ--aligned-group-descriptor
                 mainCrv g alignTol dropDist extend maxConnectDist))
    (if desc
      (progn
        (setq descs (append descs (list desc)))
        (setq parents (DEGZ--uf-init parents (car (car desc)))))))

  (setq i 0)
  (while (< i (length descs))
    (setq descA (nth i descs)
          idA (car (car descA))
          j (1+ i))
    (while (< j (length descs))
      (setq descB (nth j descs)
            idB (car (car descB)))
      (if (DEGZ--aligned-descriptors-same-bank-p
            descA descB alignTol dropDist extend)
        (setq parents (DEGZ--uf-union parents idA idB)))
      (setq j (1+ j)))
    (setq i (1+ i)))

  (setq banks '())
  (foreach desc descs
    (setq rep (DEGZ--uf-find parents (car (car desc)))
          bank (assoc rep banks))
    (if bank
      (setq banks
        (subst (cons rep (append (cdr bank) (list desc))) bank banks))
      (setq banks (append banks (list (list rep desc))))))

  ;; Ayni iki kolona oturan tek yatay sirayi bankanin yon tanimina katma.
  ;; Yalnizca block kayitlarini ekle; boylece WCS koordinat buyuklukleri
  ;; omurga referansini yatay gruba ceviremez.
  (setq absorbMap '())
  (foreach host banks
    (setq hostRep (car host)
          hostDescs (cdr host))
    (if (> (length hostDescs) 1)
      (foreach other banks
        (if (and (not (equal (car other) hostRep))
                 (= (length (cdr other)) 1))
          (progn
            (setq candidate (cadr other)
                  candidateId (car (car candidate)))
            (if (and (null (assoc candidateId absorbMap))
                     (DEGZ--descriptor-fits-column-bank-p
                       candidate hostDescs alignTol))
              (setq absorbMap
                (cons (cons candidateId hostRep) absorbMap))))))))

  (if absorbMap
    (progn
      (setq newBanks '())
      (foreach bank banks
        (setq rep (car bank)
              newDescs '())
        (foreach desc (cdr bank)
          (setq owner (assoc (car (car desc)) absorbMap))
          (if (null owner)
            (setq newDescs (append newDescs (list desc)))))
        (if newDescs
          (setq newBanks
            (append newBanks (list (cons rep newDescs))))))
      (setq banks newBanks)))

  (setq jobs '())
  (foreach bank banks
    (setq descList (cdr bank)
          base (car descList)
          allRecs '()
          extraRecs '())
    ;; Kanonik en dis sutunu ortak omurganin referansi yap.
    (foreach desc descList
      (setq allRecs (append allRecs (nth 1 desc)))
      (if (< (nth 5 desc) (nth 5 base)) (setq base desc)))
    (foreach pair absorbMap
      (if (equal (cdr pair) (car bank))
        (progn
          (setq extraDesc (DEGZ--descriptor-by-id descs (car pair)))
          (if extraDesc
            (setq extraRecs
              (append extraRecs (nth 1 extraDesc)))))))
    (setq allRecs (append allRecs extraRecs))
    (setq axis (nth 3 base)
          branchPts (DEGZ--extend-branch-for-records
                      (nth 2 base) allRecs extend)
          rowGroups (if (> (length descList) 1)
                      (DEGZ--records-by-axis-level allRecs axis alignTol)
                      (list allRecs)))
    (setq jobs
      (append jobs
        (list (list branchPts rowGroups allRecs (length descList))))))
  jobs
)

(defun DEGZ--canonical-vector (dx dy / unit tx ty)
  (setq unit (DEGZ--unit dx dy)
        tx (car unit)
        ty (cadr unit))
  (if (or (< tx -1e-10)
          (and (<= (abs tx) 1e-10) (< ty 0.0)))
    (setq tx (- tx)
          ty (- ty)))
  (list tx ty)
)

(defun DEGZ--corner-mouth-center-dist
  (crv attach farPt dMid half
   / total eps before after vb va branch lenB lenA straightDot scoreB scoreA center)
  ;; Agiz bir L kosesine denk gelirse iki ofset noktasi farkli segmentlere
  ;; dagilmasin. Cocuk dala daha dik olan ana-hat segmentini sec ve agzin
  ;; iki ucunu o segment uzerinde tut.
  (setq total (DEGZ--curve-total crv)
        eps (max 1e-3 (* 0.25 (DEG:PLAN-UNIT-SCALE)))
        before (DEGZ--pt2d
                 (vlax-curve-getPointAtDist crv (max 0.0 (- dMid eps))))
        after (DEGZ--pt2d
                (vlax-curve-getPointAtDist crv (min total (+ dMid eps))))
        lenB (DEGZ--safe-distance attach before)
        lenA (DEGZ--safe-distance attach after)
        vb (DEGZ--canonical-vector
             (- (car attach) (car before))
             (- (cadr attach) (cadr before)))
        va (DEGZ--canonical-vector
             (- (car after) (car attach))
             (- (cadr after) (cadr attach)))
        branch (DEGZ--canonical-vector
                 (- (car farPt) (car attach))
                 (- (cadr farPt) (cadr attach)))
        straightDot (abs (+ (* (car vb) (car va))
                            (* (cadr vb) (cadr va)))))
  (if (or (<= lenB 1e-9)
          (<= lenA 1e-9)
          (>= straightDot 0.98))
    dMid
    (progn
      (setq scoreB (abs (+ (* (car vb) (car branch))
                           (* (cadr vb) (cadr branch))))
            scoreA (abs (+ (* (car va) (car branch))
                           (* (cadr va) (cadr branch))))
            center (if (< scoreA scoreB)
                     (+ dMid half)
                     (- dMid half)))
      (DEGZ--clamp center half (max half (- total half)))
    )
  )
)

(defun DEGDD--mode-key (ddKey dfKey)
  (if (and (boundp '*DEG_DD_MODE*) (eq *DEG_DD_MODE* 'DF)) dfKey ddKey)
)

(defun DEGZ--opposite-side (side)
  (cond
    ((eq side 'BOTTOM) 'TOP)
    ((eq side 'TOP) 'BOTTOM)
    ((eq side 'LEFT) 'RIGHT)
    ((eq side 'RIGHT) 'LEFT)
    (T nil))
)

(defun DEGZ--ray-hit-for-side
  (crv origin side / pts ed closed count limit dir rayEnd i a b hit segHit along best bestD tol)
  (setq crv (DEGZ--ename crv)
        origin (DEGZ--pt2d origin)
        pts (if crv (DEGZ--get-lwpts crv) nil)
        ed (if crv (entget crv) nil)
        closed (if ed (cdr (assoc 70 ed)) 0)
        closed (if (and closed (/= (logand closed 1) 0)) 1 0)
        dir (cond
              ((eq side 'BOTTOM) '(0.0 -1.0))
              ((eq side 'TOP) '(0.0 1.0))
              ((eq side 'LEFT) '(-1.0 0.0))
              ((eq side 'RIGHT) '(1.0 0.0))
              (T nil))
        tol 1e-5)
  (if (and dir pts (> (length pts) 1))
    (progn
      (setq rayEnd (list (+ (car origin) (car dir))
                         (+ (cadr origin) (cadr dir)))
            count (length pts)
            limit (if (= closed 1) count (1- count))
            i 0)
      (while (< i limit)
        (setq a (DEGZ--pt2d (nth i pts))
              b (DEGZ--pt2d (nth (rem (1+ i) count) pts))
              hit (inters origin rayEnd a b nil))
        (if hit
          (progn
            (setq hit (DEGZ--pt2d hit)
                  segHit (DEGZ--closest-on-seg a b hit)
                  along (+ (* (- (car hit) (car origin)) (car dir))
                           (* (- (cadr hit) (cadr origin)) (cadr dir))))
            (if (and (> along tol)
                     (<= (cadr segHit) (* tol tol))
                     (or (null bestD) (< along bestD)))
              (setq best hit
                    bestD along))))
        (setq i (1+ i)))
      best))
)

(defun DEGZ--common-side-candidate (mainCrv recs side / out rec hit score ok)
  (setq out '()
        score 0.0
        ok T)
  (foreach rec recs
    (setq hit (DEGZ--ray-hit-for-side mainCrv (cadr rec) side))
    (if hit
      (progn
        (setq score (+ score (DEGZ--safe-distance (cadr rec) hit)))
        (setq out (append out (list (list (car rec) side hit)))))
      (setq ok nil)))
  (if ok (list score out) nil)
)

(defun DEGZ--pre-common-target-map
  (mainCrv ss mode / nearKey nearLim groups g recs minX maxX minY maxY rec ip spreadX spreadY avg cp fallback preferred other candA candB chosen out)
  (setq nearKey (cond
                  ((eq mode 'DD) 'DD_BLOK_YAKINLIK)
                  ((eq mode 'DF) 'DF_BLOK_YAKINLIK)
                  (T 'DZ_BLOK_YAKINLIK))
        nearLim (DEG:CFG-DDDZ-NUM-OR nearKey 100.0))
  (if (<= nearLim 0.0)
    (setq nearLim (* 100.0 (DEG:PLAN-UNIT-SCALE))))
  (setq groups (DEGZ--selected-block-groups ss nearLim)
        out '())
  (foreach g groups
    (setq recs (cdr g))
    (if (> (length recs) 1)
      (progn
        (setq minX nil maxX nil minY nil maxY nil)
        (foreach rec recs
          (setq ip (DEGZ--pt2d (cadr rec)))
          (if (or (null minX) (< (car ip) minX)) (setq minX (car ip)))
          (if (or (null maxX) (> (car ip) maxX)) (setq maxX (car ip)))
          (if (or (null minY) (< (cadr ip) minY)) (setq minY (cadr ip)))
          (if (or (null maxY) (> (cadr ip) maxY)) (setq maxY (cadr ip))))
        (setq spreadX (- maxX minX)
              spreadY (- maxY minY)
              avg (DEGZ--records-average recs)
              cp (DEGZ--pt2d (deg-safe-closest-point mainCrv avg))
              fallback (DEGZ--side-from-group-alignment cp avg recs)
              preferred (DEGZ--normal-group-no-cross-side cp avg recs fallback))
        ;; Ayni hizada bloklarda yalniz dizilim eksenine dik iki ortak yonu dene.
        (if (>= spreadX spreadY)
          (if (not (member preferred '(TOP BOTTOM))) (setq preferred 'BOTTOM))
          (if (not (member preferred '(LEFT RIGHT))) (setq preferred 'LEFT)))
        (setq other (DEGZ--opposite-side preferred)
              candA (DEGZ--common-side-candidate mainCrv recs preferred)
              candB (DEGZ--common-side-candidate mainCrv recs other)
              chosen (cond
                       ((and candA candB) (if (<= (car candA) (car candB)) candA candB))
                       (candA candA)
                       (candB candB)
                       (T nil)))
        (if chosen (setq out (append (cadr chosen) out))))))
  out
)

(defun DEGDF--clicked-segment (ent pick / e ed typ cp param endParam maxSeg seg p0 p1 props guide)
  (setq e (DEGZ--ename ent)
        ed (if e (entget e))
        typ (if ed (cdr (assoc 0 ed))))
  (if (not (member typ '("LWPOLYLINE" "POLYLINE")))
    nil
    (progn
      (setq cp (vl-catch-all-apply
                 'vlax-curve-getClosestPointTo
                 (list e (DEGZ--pt3d pick))))
      (if (vl-catch-all-error-p cp)
        nil
        (progn
          (setq param (vl-catch-all-apply
                        'vlax-curve-getParamAtPoint
                        (list e cp))
                endParam (vl-catch-all-apply
                           'vlax-curve-getEndParam
                           (list e)))
          (if (or (vl-catch-all-error-p param)
                  (vl-catch-all-error-p endParam)
                  (< endParam 1.0))
            nil
            (progn
              (setq maxSeg (1- (fix endParam))
                    seg (fix param))
              (if (< seg 0) (setq seg 0))
              (if (> seg maxSeg) (setq seg maxSeg))
              (setq p0 (vl-catch-all-apply
                         'vlax-curve-getPointAtParam
                         (list e seg))
                    p1 (vl-catch-all-apply
                         'vlax-curve-getPointAtParam
                         (list e (1+ seg))))
              (if (or (vl-catch-all-error-p p0)
                      (vl-catch-all-error-p p1)
                      (equal (DEGZ--pt2d p0) (DEGZ--pt2d p1) 1e-9))
                nil
                (progn
                  (setq props (DEGZ--safe-props e)
                        guide (DEGZ--entmakex-lwpoly
                                (list (DEGZ--pt2d p0) (DEGZ--pt2d p1))
                                props 0))
                  guide
                )
              )
            )
          )
        )
      )
    )
  )
)

(defun DEGZ--route-has-block-point-p (points ip / found)
  ;; Every completed block detour contains its insertion point as a vertex.
  (setq found nil)
  (while (and points (not found))
    (if (equal (DEGZ--pt2d (car points)) (DEGZ--pt2d ip) 1e-6)
      (setq found T))
    (setq points (cdr points)))
  found)

(defun DEGZ--preprocess-perp-row-groups (mainCrv ss mode / shortKey mouthKey short mouth alignTol dropDist extend childMaxDist groups jobs job recs branchPts rowGroups rowRecs rowItem allRecs bankCount groupSS r applyFn applyRes applyOk handled remaining i ent guideCrv detectPts detectProps detectClosed detectCrv detectOwned attachBase farCenter dMid maxDist distPair mouthA mouthB deltaA deltaB farA farB mainRes rowBranchPts rowMainRes rowGuideCrv readyRows commonSS commonMap finalPoints *DEGZ_ROW_GUIDE*)
  (setq mainCrv (DEGZ--ename mainCrv))
  (setq guideCrv (if (and (eq mode 'DF)
                          (boundp '*DEG_DF_GUIDE*)
                          *DEG_DF_GUIDE*
                          (entget (DEGZ--ename *DEG_DF_GUIDE*)))
                   (DEGZ--ename *DEG_DF_GUIDE*)
                   mainCrv)
        shortKey (cond ((eq mode 'DD) 'DD_OFFSET)
                       ((eq mode 'DF) 'DF_OFFSET)
                       (T 'DZ_OFFSET))
        mouthKey (cond ((eq mode 'DD) 'DD_AGIZ_ARAMA)
                       ((eq mode 'DF) 'DF_AGIZ_ARAMA)
                       (T 'DZ_AGIZ_ARAMA))
        short    (DEG:CFG-DDDZ-NUM-OR shortKey 10.0)
        mouth    (DEG:CFG-DDDZ-NUM-OR mouthKey 20.0)
        dropDist (* 40.0 (DEG:PLAN-UNIT-SCALE)))
  (if (<= short 0.0) (setq short (* 10.0 (DEG:PLAN-UNIT-SCALE))))
  (if (<= mouth 0.0) (setq mouth (* 20.0 (DEG:PLAN-UNIT-SCALE))))
  (setq childMaxDist (if (eq mode 'DZ)
                       (DEG:CFG-DDDZ-NUM-OR 'DZ_COCUK_HAT_MESAFE 750.0)
                       nil)
        alignTol (max (* 0.5 short) (* 0.5 (DEG:PLAN-UNIT-SCALE)))
        extend (+ mouth short)
        groups (DEGZ--selected-aligned-groups
                 guideCrv ss alignTol dropDist extend childMaxDist)
        applyFn (if (member mode '(DD DF)) 'DEGDD--APPLY 'DEGZ--APPLY)
        handled '())
  (setq *DEGZ_PRE_COMMON_TARGET_MAP*
    (append (DEGZ--pre-common-target-map guideCrv ss mode)
            (if (and (boundp '*DEGZ_PRE_COMMON_TARGET_MAP*)
                     *DEGZ_PRE_COMMON_TARGET_MAP*)
              *DEGZ_PRE_COMMON_TARGET_MAP*
              '())))

  ;; Keep one untouched detector curve. Each successful mouth operation replaces
  ;; mainCrv, while the remaining row tests must still use the original geometry.
  (setq detectPts (DEGZ--get-lwpts guideCrv)
        detectProps (DEGZ--safe-props guideCrv)
        detectClosed (cdr (assoc 70 (entget guideCrv))))
  (if (null detectClosed) (setq detectClosed 0))
  (setq detectClosed (if (/= (logand detectClosed 1) 0) 1 0)
        detectCrv (DEGZ--entmakex-lwpoly detectPts detectProps detectClosed)
        detectOwned T)
  (if (not (and detectCrv (entget detectCrv)))
    (setq detectCrv mainCrv
          detectOwned nil))

  (setq jobs (DEGZ--aligned-group-jobs
               detectCrv groups alignTol dropDist extend childMaxDist))

  (foreach job jobs
    (setq branchPts (car job)
          rowGroups (cadr job)
          allRecs (caddr job)
          recs allRecs
          bankCount (cadddr job))
    (if branchPts
      (progn
        (setq attachBase (DEGZ--pt2d (car branchPts))
              farCenter  (DEGZ--pt2d (cadr branchPts))
              dMid       (vl-catch-all-apply
                           'vlax-curve-getDistAtPoint
                           (list (DEGZ--ename detectCrv) (DEGZ--pt3d attachBase))))
        (if (not (vl-catch-all-error-p dMid))
          (progn
            (setq dMid (DEGZ--corner-mouth-center-dist
                         detectCrv attachBase farCenter dMid (* 0.5 short))
                  maxDist (DEGZ--curve-total detectCrv)
                  ;; OFFSET iki agiz arasindaki toplam mesafedir; her yana yarisi dusur.
                  distPair (DEGZ--distpair10 dMid 1.0 maxDist (* 0.5 short))
                  mouthA (DEGZ--pt2d
                           (vlax-curve-getPointAtDist
                             (DEGZ--ename detectCrv) (car distPair)))
                  mouthB (DEGZ--pt2d
                           (vlax-curve-getPointAtDist
                             (DEGZ--ename detectCrv) (cadr distPair)))
                  deltaA (list (- (car mouthA) (car attachBase))
                               (- (cadr mouthA) (cadr attachBase)))
                  deltaB (list (- (car mouthB) (car attachBase))
                               (- (cadr mouthB) (cadr attachBase)))
                  farA (list (+ (car farCenter) (car deltaA))
                             (+ (cadr farCenter) (cadr deltaA)))
                  farB (list (+ (car farCenter) (car deltaB))
                             (+ (cadr farCenter) (cadr deltaB)))
                  mainRes (vl-catch-all-apply
                            'DEGZ--insert-detour
                            (list mainCrv mouthA mouthB (list farA farB))))
            (if (and (not (vl-catch-all-error-p mainRes))
                     mainRes
                     (entget (DEGZ--ename mainRes)))
              (progn
                (setq mainCrv (DEGZ--ename mainRes)
                      applyOk T)
                ;; Ortak omurgayi koru; blocklari baglamadan once her seviyede
                ;; omurgadan gercek bir agiz ve cift hatli cocuk dal olustur.
                (setq readyRows '())
                (foreach rowRecs rowGroups
                  (setq readyRows
                    (append readyRows
                      (list
                        (list rowRecs
                          ;; DF bloklari yeniden tiklanan ana segmente donmesin;
                          ;; az once uretilen cocuk dali baglanti kilavuzu yap.
                          (if (eq mode 'DF) branchPts nil))))))
                (if (> bankCount 1)
                  (progn
                    (setq readyRows '())
                    (foreach rowRecs rowGroups
                      (setq rowBranchPts
                        (DEGZ--perp-row-branch-points
                          mainCrv rowRecs alignTol dropDist extend childMaxDist)
                            rowMainRes nil)
                      (if rowBranchPts
                        (setq rowMainRes
                          (DEGZ--insert-child-detour
                            mainCrv rowBranchPts short)))
                      (if (and rowMainRes
                               (entget (DEGZ--ename rowMainRes)))
                        (progn
                          (setq mainCrv (DEGZ--ename rowMainRes))
                          (setq readyRows
                            (append readyRows
                              (list (list rowRecs rowBranchPts)))))
                        (setq applyOk nil)))))

                ;; Cocuk dallar artik geometride. Satirlar ayri cizim
                ;; cagrilarina bolunmeden once yakin bloklarin ortak yonunu ve
                ;; o yondeki gercek ana-hat hedefini birlikte kaydet.
                (setq commonSS (ssadd))
                (foreach r allRecs (ssadd (car r) commonSS))
                (setq commonMap
                  (DEGZ--pre-common-target-map mainCrv commonSS mode))
                (if commonMap
                  (setq *DEGZ_PRE_COMMON_TARGET_MAP*
                    (append commonMap *DEGZ_PRE_COMMON_TARGET_MAP*)))

                ;; Artik her block sirasi omurgaya degil kendi cocuk dalina gider.
                (foreach rowItem readyRows
                  (setq rowRecs (car rowItem)
                        rowBranchPts (cadr rowItem)
                        rowGuideCrv nil)
                  (if rowBranchPts
                    (setq rowGuideCrv
                      (DEGZ--entmakex-lwpoly
                        (list (DEGZ--pt2d (car rowBranchPts))
                              (DEGZ--pt2d (cadr rowBranchPts)))
                        (DEGZ--safe-props mainCrv)
                        0)))
                  (setq groupSS (ssadd))
                  (foreach r rowRecs (ssadd (car r) groupSS))
                  (setq *DEGZ_ROW_GUIDE* rowGuideCrv)
                  (setq applyRes (vl-catch-all-apply applyFn (list mainCrv groupSS)))
                  (setq *DEGZ_ROW_GUIDE* nil)
                  (if (and rowGuideCrv (entget rowGuideCrv))
                    (entdel rowGuideCrv))
                  (if (vl-catch-all-error-p applyRes)
                    (progn
                      (setq applyOk nil)
                      (princ
                        (strcat "\n" (vl-symbol-name mode)
                                " alt dal hata: " (vl-catch-all-error-message applyRes))))
                    (progn
                      (if (and applyRes (entget (DEGZ--ename applyRes)))
                        (setq mainCrv (DEGZ--ename applyRes)))
                      (setq finalPoints (DEGZ--get-lwpts mainCrv))
                      (foreach r rowRecs
                        (if (DEGZ--route-has-block-point-p finalPoints (cadr r))
                          (setq handled (cons (car r) handled))
                          (setq applyOk nil))))))
                (if applyOk
                  (if (> bankCount 1)
                    (princ
                      (strcat "\n" (vl-symbol-name mode)
                              ": " (itoa (length allRecs))
                              " block ortak dikey cocuk omurgaya baglandi."))
                    (princ
                      (strcat "\n" (vl-symbol-name mode)
                              ": Ayni hizadaki " (itoa (length recs))
                              " block ana polyline agzindan 40 cm alt dala baglandi."))))
              )
            )
          )
        )
      )
    )
  )
  (if (and detectOwned detectCrv (entget detectCrv)) (entdel detectCrv))
  ;; A later detour may have replaced an earlier mouth; verify the final route.
  (setq finalPoints (DEGZ--get-lwpts mainCrv))
  (setq remaining (ssadd))
  (if (and ss (= (type ss) 'PICKSET))
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent (ssname ss i))
        (if (or (not (member ent handled))
                (not (DEGZ--route-has-block-point-p finalPoints
                       (cdr (assoc 10 (entget ent))))))
          (ssadd ent remaining))
        (setq i (1+ i))
      )
    )
  )
  (list mainCrv remaining)
)

(defun DEGZ--preprocess-perp-row-chain (mainCrv ss mode / pass maxPass prevCount nextCount prepRes keepGoing)
  ;; Ilk varsayilan dal olustuktan sonra kalan blocklari guncel geometriye gore
  ;; yeniden tara. Boylece yeni dal da ana hat gibi davranip gerekiyorsa devam eder.
  (setq pass 0
        maxPass (if (and ss (= (type ss) 'PICKSET))
                  (max 1 (sslength ss))
                  1)
        keepGoing T)
  (while (and keepGoing
              (< pass maxPass)
              ss
              (= (type ss) 'PICKSET)
              (> (sslength ss) 1))
    (setq prevCount (sslength ss)
          prepRes (DEGZ--preprocess-perp-row-groups mainCrv ss mode)
          mainCrv (car prepRes)
          ss (cadr prepRes)
          nextCount (if (and ss (= (type ss) 'PICKSET))
                      (sslength ss)
                      0))
    (if (< nextCount prevCount)
      (setq pass (1+ pass))
      (setq keepGoing nil)
    )
  )
  (list mainCrv ss)
)

(defun DZ_ORIG (/ *error* sel crv0 pick ss dist newPl snapLimit undoToken oldCm oldRegen prepRes *DEGZ_PRE_COMMON_TARGET_MAP*)
  (vl-load-com)
  (setq oldCm (getvar "CMDECHO")
        oldRegen (vl-catch-all-apply 'getvar (list "REGENMODE")))
  (if (vl-catch-all-error-p oldRegen) (setq oldRegen nil))

  (defun *error* (msg)
    (if undoToken
      (progn
        (DEG:UNDO-GROUP-END undoToken)
        (setq undoToken nil)
      )
    )
    (if (numberp oldCm) (setvar "CMDECHO" oldCm))
    (if (numberp oldRegen)
      (vl-catch-all-apply 'setvar (list "REGENMODE" oldRegen)))
    (redraw)
    (if (and msg (not (wcmatch (strcase msg) "*CANCEL*,*QUIT*,*BREAK*")))
      (princ (strcat "\nDZ hata: " msg))
    )
    (princ)
  )

  (setvar "CMDECHO" 0)
  (if (numberp oldRegen)
    (vl-catch-all-apply 'setvar (list "REGENMODE" 0)))

  (prompt "\nDZ: Ana hat icin bir polyline sec (tikla): ")
  (setq sel (entsel))
  (if (null sel)
    (princ "\nSecim yok.")
    (progn
      (setq crv0 (car sel)
            pick (cadr sel))
      (prompt "\nDZ: Ana hatta baglanacak BLOCK'lari sec (INSERT): ")
      (setq ss (ssget '((0 . "INSERT"))))
      (if (null ss)
        (princ "\nBlock secimi yok.")
        (progn
          (setq *DEGZ_PRE_COMMON_TARGET_MAP* nil
                snapLimit (DEG:CFG-DDDZ-NUM-OR 'DZ_OFFSET 10.0))
          (if (<= snapLimit 0.0) (setq snapLimit 5.0))
          (setq dist (/ snapLimit 2.0))
          ;; DR ve DZ'nin tum ara olustur/sil adimlari tek Undo islemi olsun.
          (setq undoToken (DEG:UNDO-GROUP-BEGIN))
          (princ "\nDEG_R324 RUNNING (DR -> DZ)")
          (setq newPl (DEGDR--RUN crv0 pick dist))
          (if (and newPl (entget newPl))
            (progn
              (setq prepRes (DEGZ--preprocess-perp-row-chain newPl ss 'DZ)
                    newPl (car prepRes)
                    ss (cadr prepRes))
              (if (> (sslength ss) 0)
                (setq newPl (DEGZ--APPLY newPl ss)))
              (if (and newPl (entget newPl))
                (setq newPl (DEGZ--snap-close-double-turn-entity newPl snapLimit)))
              (princ "\nDZ tamam.")
            )
            (princ "\nDR sonucunda yeni polyline olusmadi. DZ calistirilamadi.")
          )
          (if undoToken
            (progn
              (DEG:UNDO-GROUP-END undoToken)
              (setq undoToken nil)
            )
          )
        )
      )
    )
  )

  (if (numberp oldCm) (setvar "CMDECHO" oldCm))
  (if (numberp oldRegen)
    (vl-catch-all-apply 'setvar (list "REGENMODE" oldRegen)))
  (redraw)
  (princ)
)
(defun DR_ORIG (/ sel mainEnt pick dist newPl ss)
  (vl-load-com)
  (setq sel (entsel "\nDR: Ana hat polyline sec (tikla): "))
  (if (null sel)
    (princ "\nSecim yok.")
    (progn
      (setq mainEnt (car sel))
      (setq pick    (cadr sel))

      (setq dist (getdist "\nMesafe <5>: "))
      (if (null dist) (setq dist 5.0))

      (princ "\nDR calisiyor...")
      (setq newPl (DEGDR--RUN mainEnt pick dist))

      (if (and newPl (entget newPl))
        (progn
          (prompt "\nDR->DZ: Ana hatta baglanacak BLOCK'lari sec (INSERT) [Enter=Iptal]: ")
          (setq ss (ssget '((0 . "INSERT"))))
          (if (and ss (= (type ss) 'PICKSET) (> (sslength ss) 0))
            (progn
              (DEGZ--APPLY newPl ss)
              (princ "\nDR+DZ tamam.")
            )
            (princ "\nDR tamam. DZ icin block secilmedi.")
          )
        )
        (princ "\nDR sonucunda yeni polyline olusmadi. DZ calistirilamadi.")
      )
    )
  )
  (princ)
)




(defun DZO-ORIG ()
  (DZ_ORIG)
)


;;; --- DD icin ayri ofset uygulamasi ---
(defun DEGDD--APPLY (crv0 ss / crv i blk ip blk2 ip2
               ptsMain propsMain mainTmp mainClosed guideCrv
               joinCand short shift approach
               vvx vvy uu dx dy len rx ry ipRin
               nearLim mainFarLim mergeOff
               cell cells
               parents data
               groups
               forcedReps sideMap segMap groupDirMap groupDir
               anchorMap stemMap  remoteMap mergeMap
               dirMap dirRec udir mdx mdy p1 ipb p1b pJoin stemRec stemA stemB cpSec pStep pStepb
               g rep recs r bestRec bestIp bestD dNow segIdx choosePlus
               procData anchorRec remote
               forceMain isAnchor cpMain cpCur cpE cpEshort
               uTan uPerp corner1 corner2 paramCur distEnds
               pDown pDownRin uDirRemote anchorStemDir
               key cx cy ix iy rec item mergePt isTargetSide
               sX sY sideFact cpERes shortRes 
               ipAvg pMid paramMid deriv Tlen Tx Ty Lx Ly dotProd dirSign distMid distDown distDownRin maxDist
               pMerge pMergeRin pLeft pRight ipLeft ipRight pMainTop pMainBot ipTop ipBot yTop yBot pTopA pBotA pTopB pBotB pTopDrop pBotDrop scoreA scoreB outsideLeft fromTop sideMode shortIp longIp calcCrv sideBase sideDx sideDy blockSide blockSideMap oblique alignedPair rowGuideActive preRec preSide preTarget)

  (vl-load-com)

  (setq joinCand (DEG:CFG-DDDZ-NUM-OR
                   (DEGDD--mode-key 'DD_AGIZ_ARAMA 'DF_AGIZ_ARAMA) 20.0))
  (if (<= joinCand 0.0)
    (setq joinCand (* 20.0 (DEG:PLAN-UNIT-SCALE))))
  (setq short (DEG:CFG-DDDZ-NUM-OR
                (DEGDD--mode-key 'DD_OFFSET 'DF_OFFSET) 10.0))
  (if (<= short 0.0)
    (setq short (* 10.0 (DEG:PLAN-UNIT-SCALE))))
  (setq shift short)
  (setq approach short)

  (setq nearLim (DEG:CFG-DDDZ-NUM-OR
                  (DEGDD--mode-key 'DD_BLOK_YAKINLIK 'DF_BLOK_YAKINLIK) 100.0))
  (if (<= nearLim 0.0)
    (setq nearLim (* 100.0 (DEG:PLAN-UNIT-SCALE))))
  (setq mainFarLim (DEG:CFG-DDDZ-NUM-OR
                     (DEGDD--mode-key 'DD_DIRSEK_DIST 'DF_DIRSEK_DIST) 200.0))
  (if (<= mainFarLim 0.0)
    (setq mainFarLim (* 200.0 (DEG:PLAN-UNIT-SCALE))))
  (setq mergeOff (DEG:CFG-DDDZ-NUM-OR
                   (DEGDD--mode-key 'DD_DIRSEK_KACIS 'DF_DIRSEK_KACIS) 50.0))
  (if (<= mergeOff 0.0)
    (setq mergeOff (* 50.0 (DEG:PLAN-UNIT-SCALE))))

  (setq crv0 (DEGZ--ename crv0))

  (if (not (and crv0 (entget crv0)))
    (progn (princ "\nDZ: Gecersiz polyline.") (princ))
    (if (not (and ss (= (type ss) 'PICKSET) (> (sslength ss) 0)))
      (progn (princ "\nDZ: Block secimi yok.") (princ))
      (progn

        (setq guideCrv
          (cond
            ((and (boundp '*DEGZ_ROW_GUIDE*)
                  *DEGZ_ROW_GUIDE*
                  (entget (DEGZ--ename *DEGZ_ROW_GUIDE*)))
              (DEGZ--ename *DEGZ_ROW_GUIDE*))
            ((and (boundp '*DEG_DF_GUIDE*)
                  *DEG_DF_GUIDE*
                  (entget (DEGZ--ename *DEG_DF_GUIDE*)))
              (DEGZ--ename *DEG_DF_GUIDE*))
            (T crv0)))
        (setq rowGuideActive
          (and (boundp '*DEGZ_ROW_GUIDE*)
               *DEGZ_ROW_GUIDE*
               (eq guideCrv (DEGZ--ename *DEGZ_ROW_GUIDE*))))
        (setq ptsMain   (DEGZ--get-lwpts guideCrv))
        (setq propsMain (DEGZ--safe-props guideCrv))
        (setq mainClosed (if (eq guideCrv crv0)
                           (cdr (assoc 70 (entget crv0)))
                           0))
        (if (null mainClosed) (setq mainClosed 0))
        (setq mainClosed (if (/= (logand mainClosed 1) 0) 1 0))
        (setq mainTmp   (DEGZ--entmakex-lwpoly ptsMain propsMain mainClosed))

        (setq cell    nearLim)
        (setq cells   '())
        (setq parents '())
        (setq data    '())

        (setq i 0)
        (while (< i (sslength ss))
          (setq blk (ssname ss i))
          (if (not (DEGZ--skip-block-p blk))
            (progn
              (setq ip (DEGZ--pt2d (cdr (assoc 10 (entget blk)))))

              (setq parents (DEGZ--uf-init parents blk))
              (setq data (append data (list (list blk ip))))

              (setq key (DEGZ--cellkey ip cell))
              (setq cx (car key) cy (cadr key))

              (setq ix -1)
              (while (<= ix 1)
                (setq iy -1)
                (while (<= iy 1)
                  (setq rec (assoc (list (+ cx ix) (+ cy iy)) cells))
                  (if rec
                    (foreach item (cdr rec)
                      (setq blk2 (car item))
                      (setq ip2  (cadr item))
                      (if (and blk2 ip2 (<= (DEGZ--safe-distance ip ip2) nearLim))
                        (setq parents (DEGZ--uf-union parents blk blk2))
                      )
                    )
                  )
                  (setq iy (1+ iy))
                )
                (setq ix (1+ ix))
              )

              (setq cells (DEGZ--cells-put cells (list cx cy) (list blk ip)))
            )
          )
          (setq i (1+ i))
        )

        (setq groups (DEGZ--groups-build parents data))

        (setq forcedReps '())
        (setq sideMap    '())
        (setq segMap     '())
        (setq anchorMap  '())
        (setq stemMap    '())
        (setq remoteMap  '())
        (setq mergeMap   '())
        (setq dirMap     '())
        (setq blockSideMap '())
        (setq groupDirMap '())

        (foreach g groups
          (setq rep  (car g))
          (setq recs (cdr g))

          (setq bestRec nil)
          (setq bestD   1e99)
          (foreach r recs
            (setq ip (cadr r))
            (setq cpMain (deg-safe-closest-point mainTmp ip))
            (setq dNow (DEGZ--safe-distance (DEGZ--pt2d ip) (DEGZ--pt2d cpMain)))
            (if (< dNow bestD)
              (progn (setq bestD dNow) (setq bestRec r))
            )
          )
          (if (null bestRec) (setq bestRec (car recs)))
          (setq bestIp (cadr bestRec))
          (setq anchorMap (cons (cons rep bestRec) anchorMap))

          (setq cpMain (deg-safe-closest-point mainTmp bestIp))
          (setq stemMap (cons (cons rep (list (DEGZ--pt2d bestIp) (DEGZ--pt2d cpMain))) stemMap))
          (setq choosePlus (DEGZ--choosePlus-main mainTmp bestIp cpMain joinCand))
          (setq sideMap (cons (cons rep choosePlus) sideMap))
          (setq segIdx (DEGZ--poly-closest-seg-index ptsMain bestIp mainClosed))
          (setq segMap (cons (cons rep segIdx) segMap))

          ;; Cikinti yonu grupta tek karar olsun: tum bloklarin merkezini ana hatta gore oku.
          (setq sX 0.0)
          (setq sY 0.0)
          (setq scoreB 0)
          (foreach r recs
            (setq ip (DEGZ--pt2d (cadr r)))
            (setq sX (+ sX (car ip)))
            (setq sY (+ sY (cadr ip)))
            (setq scoreB (1+ scoreB))
          )
          (if (> scoreB 0)
            (setq ipAvg (list (/ sX scoreB) (/ sY scoreB)))
            (setq ipAvg bestIp)
          )
          (setq cpMain (deg-safe-closest-point mainTmp ipAvg))
          (setq blockSide (DEGZ--side-from-group-alignment cpMain ipAvg recs))
          (setq blockSideMap (cons (cons rep blockSide) blockSideMap))
          (setq groupDirMap
            (cons (cons rep (DEGZ--group-approach-unit cpMain ipAvg recs)) groupDirMap))

          ;; Anchor secimi ana hat acisi degisse de ayni blokta kalsin.
          ;; Egik hatta yerel teget sirasi; yatay/dikey hatta mevcut kural kullanilir.
          (if (> (length recs) 1)
            (progn
              (setq scoreA nil)
              (foreach r recs
                (setq ip (DEGZ--pt2d (cadr r)))
                (setq uTan (DEGZ--canonical-tangent-at mainTmp cpMain))
                (setq scoreB
                  (if (and (> (abs (car uTan)) 1e-4)
                           (> (abs (cadr uTan)) 1e-4))
                    ;; Egik hatta X/Y esigi kullanma; bloklari yerel ana-hat ekseninde sirala.
                    (- (+ (* (car ip) (car uTan))
                          (* (cadr ip) (cadr uTan))))
                    ;; Yatay/dikey mevcut davranisi koru.
                    (cond
                      ((eq blockSide 'LEFT) (- (cadr ip)))
                      ((eq blockSide 'RIGHT) (cadr ip))
                      ((or (eq blockSide 'TOP) (eq blockSide 'BOTTOM)) (- (car ip)))
                      (T 0.0)
                    )
                  )
                )
                (if (or (null scoreA) (< scoreB scoreA))
                  (progn
                    (setq scoreA scoreB)
                    (setq bestRec r)
                  )
                )
              )
              (setq bestIp (cadr bestRec))
              (setq anchorMap (cons (cons rep bestRec) anchorMap))
              (setq cpMain (deg-safe-closest-point mainTmp bestIp))
              (setq stemMap (cons (cons rep (list (DEGZ--pt2d bestIp) (DEGZ--pt2d cpMain))) stemMap))
              (setq choosePlus (DEGZ--choosePlus-main mainTmp bestIp cpMain joinCand))
              (setq sideMap (cons (cons rep choosePlus) sideMap))
              (setq segIdx (DEGZ--poly-closest-seg-index ptsMain bestIp mainClosed))
              (setq segMap (cons (cons rep segIdx) segMap))
            )
          )

          (if (> (length recs) 1)
            (progn
               ;; Ozel cocuk-dal kilavuzunda uzaklik remote/dirsek karari
               ;; degildir; dal zaten bu yakin blok sirasi icin olusturulmustur.
               (if (and (> bestD mainFarLim) (not rowGuideActive))
                (progn
                  (setq remoteMap (cons (cons rep T) remoteMap))
                  (setq mergePt (DEGZ--point-toward bestIp cpMain mergeOff))
                  (setq mergeMap (cons (cons rep mergePt) mergeMap))

                  (setq udir (DEGZ--unit (- (car bestIp) (car cpMain)) (- (cadr bestIp) (cadr cpMain))))
                  (setq dirMap (cons (cons rep (list (car udir) (cadr udir))) dirMap))
                )
                (progn
                  (setq remoteMap (cons (cons rep nil) remoteMap))
                  (setq forcedReps (cons rep forcedReps))
                  ;; DD/DF normal ciziminde de yakin grup ayni carpismasiz
                  ;; ortak taraftan baglanir; dirsekli dal degistirilmez.
                  (setq cpMain (deg-safe-closest-point mainTmp ipAvg)
                        blockSide
                          (DEGZ--normal-group-no-cross-side
                            cpMain ipAvg recs blockSide))
                  (setq blockSideMap (cons (cons rep blockSide) blockSideMap)
                        groupDirMap
                          (cons
                            (cons rep (DEGZ--approach-unit-for-side blockSide))
                            groupDirMap))
                )
              )
            )
            (setq remoteMap (cons (cons rep nil) remoteMap))
          )
        )

        (setq procData '())
        (foreach g groups
          (setq rep  (car g))
          (setq recs (cdr g))
          (setq remote (cdr (assoc rep remoteMap)))
          (if (and remote (> (length recs) 1))
            (progn
              (setq anchorRec (cdr (assoc rep anchorMap)))
              (setq procData (append procData (list anchorRec)))
              (foreach r recs
                (if (not (equal (car r) (car anchorRec)))
                  (setq procData (append procData (list r)))
                )
              )
            )
            (setq procData (append procData recs))
          )
        )

        (setq crv crv0)

        (foreach rec procData
          (setq blk (car rec))
          (setq ip  (cadr rec))

          (setq rep (DEGZ--uf-find parents blk))
          (setq choosePlus (cdr (assoc rep sideMap)))
          (if (null choosePlus) (setq choosePlus T))
          (setq remote (cdr (assoc rep remoteMap)))
          (setq preRec
            (if (and (boundp '*DEGZ_PRE_COMMON_TARGET_MAP*)
                     *DEGZ_PRE_COMMON_TARGET_MAP*)
              (assoc blk *DEGZ_PRE_COMMON_TARGET_MAP*)
              nil)
                preSide (if preRec (cadr preRec) nil)
                preTarget (if preRec (caddr preRec) nil))

          (setq anchorRec (cdr (assoc rep anchorMap)))
          (setq isAnchor (and remote anchorRec (equal blk (car anchorRec))))
          (setq forceMain (if (member rep forcedReps) T nil))

          (cond
            (forceMain
              (progn
                (setq segIdx (cdr (assoc rep segMap)))
                (if (null segIdx) (setq segIdx 0))
                (setq cpMain (DEGZ--poly-closest-on-seg ptsMain segIdx ip mainClosed))
              )
            )
            (remote
              (if isAnchor
                (progn
                  (setq segIdx (cdr (assoc rep segMap)))
                  (if (null segIdx) (setq segIdx 0))
                  (setq cpMain (DEGZ--poly-closest-on-seg ptsMain segIdx ip mainClosed))
                )
                (progn
                  (setq cpMain (deg-safe-closest-point mainTmp ip))
                )
              )
            )
            (T (setq cpMain (deg-safe-closest-point mainTmp ip)))
          )
          (if (and preTarget (not remote))
            (setq cpMain preTarget))

          (setq cpCur (deg-safe-closest-point crv cpMain))

          (setq ip     (DEGZ--pt2d ip))
          (setq cpMain (DEGZ--pt2d cpMain))
          (setq cpCur  (DEGZ--pt2d cpCur))

          (setq vvx (- (car ip) (car cpMain)))
          (setq vvy (- (cadr ip) (cadr cpMain)))

          ;; Cikinti tarafi block'un baglanti/base noktasindan gorunen govdesine bakarak belirlenir.
          ;; Ana hat noktasi veya block rotasyonu bu karari bozmasin.
          (setq blockSide (cdr (assoc rep blockSideMap)))
          (if (null blockSide)
            (setq blockSide (DEGZ--side-from-connect-to-block cpMain ip))
          )
          (if (and preSide (not remote))
            (setq blockSide preSide))
          
          (DEGZ--dbg-cikinti "DD" blockSide remote isAnchor forceMain ip cpMain)
          (setq orthoForced nil)
(setq shiftBlk shift)
          (setq uu (DEGZ--unit vvx vvy))
              (if (and (boundp '*DEG-DDDZ-CIKINTI-DEBUG*) *DEG-DDDZ-CIKINTI-DEBUG*)
                (princ "\nDD step=UNIT")
              )
          (setq dx (car uu) dy (cadr uu) len (caddr uu))

          (if (and remote (not isAnchor))
            (progn
              (setq uDirRemote (cdr (assoc rep dirMap)))
              (setq dx (car uDirRemote))
              (setq dy (cadr uDirRemote))
              (setq len 100.0)
            )
          )
          (setq groupDir (cdr (assoc rep groupDirMap)))
          (if (and preSide (not remote))
            (setq groupDir (DEGZ--approach-unit-for-side preSide)))
          (if groupDir
            (setq dx (car groupDir)
                  dy (cadr groupDir)
                  len 100.0)
          )

          (if (> len 1e-9)
            (progn
              (setq rx dy)
              (setq ry (- dx))

              ;; =========================================================
              ;; 1. BLOK BACAK YONU VE TARAF KONTROLU (HERKES ICIN)
              ;; =========================================================
              (setq oblique (DEGZ--oblique-vector-p dx dy))
              (if oblique
                (progn
                  ;; Egik hatta taraf karari aciya ve RIGHT/TOP etiketine bagli degildir.
                  (setq sideFact
                    (DEGZ--local-side-factor mainTmp cpMain dx dy rx ry)
                  )
                  (setq isTargetSide (< sideFact 0.0))
                )
                (progn
                  (setq isTargetSide
                    (or (eq blockSide 'BOTTOM) (eq blockSide 'RIGHT))
                  )
                  (setq sideFact (if isTargetSide -1.0 1.0))
                )
              )

              ;; Plan tarafina gore gerekirse bacaklari ters yone cevir
              (setq ipRin
                (list
                  (+ (car ip) (* rx shiftBlk sideFact))
                  (+ (cadr ip) (* ry shiftBlk sideFact))
                )
              )
              (setq ipRin
                 (list 
                   (- (car ipRin) (* dx approach))
                   (- (cadr ipRin) (* dy approach))
                 )
              )
              ;; Sabit cikinti yonu icin ipRin WCS'te uretilir.
              ;; LEFT: altta, RIGHT: ustte, TOP/BOTTOM: solda.
              (if (not oblique)              (setq ipRin
                (cond
                  ((eq blockSide 'LEFT)
                    (list (- (car ip) approach) (- (cadr ip) shiftBlk))
                  )
                  ((eq blockSide 'RIGHT)
                    (list (+ (car ip) approach) (- (cadr ip) shiftBlk))
                  )
                  ((eq blockSide 'TOP)
                    (list (- (car ip) shiftBlk) (+ (cadr ip) approach))
                  )
                  ((eq blockSide 'BOTTOM)
                    (list (- (car ip) shiftBlk) (- (cadr ip) approach))
                  )
                  (T ipRin)
                )
              )              
              )
              ;; cpE noktasini da tarafa gore duzelt (Referans icin)
              (setq rx (* rx sideFact))
              (setq ry (* ry sideFact))

              ;; Remote + anchor + sol/ust ise ANA HAT UZERINDEKI CIKIS VERTEX'INI OBUR TARAFA AL
              ;; (blok bacagi/yonu degismez, sadece ana hatta degdigi taraf degisir)
              (if (and remote isAnchor isTargetSide)
                (setq choosePlus (if choosePlus nil T))
              )

              (if (and (boundp '*DEG-DDDZ-CIKINTI-DEBUG*) *DEG-DDDZ-CIKINTI-DEBUG*)
                (princ "\nDD step=CPE_START")
              )
              (if (or forceMain remote)
                (setq cpERes (vl-catch-all-apply 'DEGZ--cpE-side-flag (list crv cpCur joinCand choosePlus)))
                (setq cpERes (vl-catch-all-apply 'DEGZ--cpE-side      (list crv cpCur joinCand rx ry)))
              )
              (if (vl-catch-all-error-p cpERes)
                (progn
                  (if (and (boundp '*DEG-DDDZ-CIKINTI-DEBUG*) *DEG-DDDZ-CIKINTI-DEBUG*)
                    (princ (strcat "\nDD CPE hata: " (vl-catch-all-error-message cpERes)))
                  )
                  (setq cpE cpCur)
                )
                (setq cpE cpERes)
              )
              (if (and (boundp '*DEG-DDDZ-CIKINTI-DEBUG*) *DEG-DDDZ-CIKINTI-DEBUG*)
                (princ "\nDD step=CPE_DONE")
              )
              (setq cpCur (DEGZ--pt2d-safe cpCur cpMain))
              (setq cpE   (DEGZ--pt2d-safe cpE cpCur))
              (if (and cpCur cpE)
                (progn
                  (setq shortRes
                    (vl-catch-all-apply
                      'DEGZ--shorten-toward-cp
                      (list crv cpCur cpE (min short (* (DEGZ--safe-distance cpCur cpE) 0.45)))
                    )
                  )
                  (if (vl-catch-all-error-p shortRes)
                    (progn
                      (if (and (boundp '*DEG-DDDZ-CIKINTI-DEBUG*) *DEG-DDDZ-CIKINTI-DEBUG*)
                        (princ (strcat "\nDD SHORT hata: " (vl-catch-all-error-message shortRes)))
                      )
                      (setq cpEshort cpCur)
                    )
                    (setq cpEshort shortRes)
                  )
                )
                (setq cpEshort cpCur)
              )
              (setq cpEshort (DEGZ--pt2d-safe cpEshort cpCur))
              (if (and groupDir remote isAnchor
                       (> (abs vvx) joinCand)
                       (> (abs vvy) joinCand))
                (progn
                  (setq alignedPair
                    (DEGZ--corner-mouth-pair-by-approach crv cpMain groupDir short))
                  (if alignedPair
                    (setq cpCur (car alignedPair)
                          cpEshort (cadr alignedPair)))
                )
              )
              (if (and (boundp '*DEG-DDDZ-CIKINTI-DEBUG*) *DEG-DDDZ-CIKINTI-DEBUG*)
                (princ "\nDD step=SHORT_DONE")
              )

              (if (and cpCur cpEshort (> (DEGZ--safe-distance cpCur cpEshort) 1e-4))
                (progn
                  
                  (if (and remote (not isAnchor))
                     ;; =====================================================
                     ;; DURUM A: UZAK BLOKLAR (REMOTE) -> L-SHAPE / MERGE
                     ;; =====================================================
                     ;; * Bu bloklar komsu hattina baglanmali (Merge).
                     ;; * Hesaplamalar 'crv' (islenmis hat) uzerinde yapilmali.
                     (progn
                       ;; pMerge: ip'den mergeOff kadar asagi
                       (setq pMerge
                        (list
                          (+ (car ip) (* (- dx) mergeOff))
                          (+ (cadr ip) (* (- dy) mergeOff))
                        )
                       )
                       ;; pMergeRin: ipRin hizasinda
                       (setq pMergeRin
                        (list
                          (+ (car pMerge) (- (car ipRin) (car ip)))
                          (+ (cadr pMerge) (- (cadr ipRin) (cadr ip)))
                        )
                       )
                       
                       ;; Dis L eslesmesi:
                       ;; Ana hatta devam eden cift hatta soldaki kol ust yataya,
                       ;; sagdaki kol alt yataya baglanir. Boylece capraz eslesme olmaz.
                       (if (or (< (car pMerge) (car pMergeRin))
                               (and (equal (car pMerge) (car pMergeRin) 1e-9)
                                    (> (cadr pMerge) (cadr pMergeRin))))
                         (progn
                           (setq pLeft pMerge)
                           (setq ipLeft ip)
                           (setq pRight pMergeRin)
                           (setq ipRight ipRin)
                         )
                         (progn
                           (setq pLeft pMergeRin)
                           (setq ipLeft ipRin)
                           (setq pRight pMerge)
                           (setq ipRight ip)
                         )
                       )

                       (if (>= (cadr pLeft) (cadr pRight))
                         (progn (setq yTop (cadr pLeft)) (setq yBot (cadr pRight)))
                         (progn (setq yTop (cadr pRight)) (setq yBot (cadr pLeft)))
                       )

                       ;; Cikinti tarafindaki kisa ucu dis tarafa al.
                       ;; Ustten/alttan gelise gore capraz ureten eslesmeyi secme.
                       (setq outsideLeft
                         (>= (+ (* (car ipLeft) rx) (* (cadr ipLeft) ry))
                             (+ (* (car ipRight) rx) (* (cadr ipRight) ry)))
                       )
                       ;; Ustten gelen durumda cikinti aynalanir; kisa ucu dis tarafa almak icin eslesmeyi tersle.
                       (setq fromTop (eq blockSide 'TOP))
                       (if fromTop
                         (setq outsideLeft (if outsideLeft nil T))
                       )
                       ;; Asagidan geliste ust-alt eslesmesi ayri aynalanir.
                       (if (eq blockSide 'BOTTOM)
                         (setq outsideLeft (if outsideLeft nil T))
                       )
                       (setq pTopA (list (car pLeft) yTop))
                       (setq pBotA (list (car pRight) yBot))
                       (setq pTopB (list (car pRight) yTop))
                       (setq pBotB (list (car pLeft) yBot))
                       (if outsideLeft
                         (progn
                           (setq ipTop ipLeft)
                           (setq ipBot ipRight)
                           (setq pMainTop pTopA)
                           (setq pMainBot pBotA)
                         )
                         (progn
                           (setq ipTop ipRight)
                           (setq ipBot ipLeft)
                           (setq pMainTop pTopB)
                           (setq pMainBot pBotB)
                         )
                       )
                       ;; DD main/ip pair alignment: pMainTop/pMainBot ile ipTop/ipBot ters siralanirsa
                       ;; secilen polyline agzinda bosluk capraz kapanir. Once bu ciftleri ayni yone al.
                       (if (< (+ (* (- (car pMainBot) (car pMainTop)) (- (car ipBot) (car ipTop)))
                                 (* (- (cadr pMainBot) (cadr pMainTop)) (- (cadr ipBot) (cadr ipTop))))
                              0.0)
                         (progn
                           (setq pStep ipTop)
                           (setq ipTop ipBot)
                           (setq ipBot pStep)
                         )
                       )
                        ;; Ana hat agzinda capraz eslesme olmasin:
                        ;; ust/alt (veya sol/sag) ana hat ucu ayni siradaki blok ucuna baglansin.
                        (setq dirRec (DEGZ--pair-main-block-no-cross blockSide pMerge pMergeRin ip ipRin))
                        (setq pMainTop (car dirRec))
                        (setq pMainBot (cadr dirRec))
                        (setq ipTop (caddr dirRec))
                        (setq ipBot (cadddr dirRec))
                       ;; Ana hat uzerindeki noktalar (Mevcut 'crv' uzerinden alinir)
                       (setq cpCur    (deg-safe-closest-point crv pMainTop))
                       (setq cpEshort (deg-safe-closest-point crv pMainBot))
                       
                       ;; Alt kol ana hatta baglanir; ust kol dis L'yi tamamlar.
                       (setq pJoin
                         (inters
                           (list (car pMainBot) (cadr pMainBot) 0.0)
                           (list (+ (car pMainBot) rx) (+ (cadr pMainBot) ry) 0.0)
                           (list (car cpEshort) (cadr cpEshort) 0.0)
                           (list (+ (car cpEshort) dx) (+ (cadr cpEshort) dy) 0.0)
                           nil
                         )
                       )
                       (if pJoin
                         (setq pJoin (DEGZ--pt2d pJoin))
                         (setq pJoin (list (car cpEshort) (cadr pMainBot)))
                       )
                       ;; Blok cikislarina direkt capraz gitme.
                       ;; Ana hat noktasi ile blok cikisi hem X hem Y farkliyse araya kirim koy.
                       (setq sideMode
                         (or
                           (eq blockSide 'LEFT)
                           (eq blockSide 'RIGHT)
                           (and (> (abs (- (car pMainTop) (car ipTop))) 1e-6)
                                (> (abs (- (cadr pMainTop) (cadr ipTop))) 1e-6))
                           (and (> (abs (- (car pMainBot) (car ipBot))) 1e-6)
                                (> (abs (- (cadr pMainBot) (cadr ipBot))) 1e-6))
                         )
                       )
                        (if sideMode
                          (progn
                            ;; Sabit cikinti yonu:
                            ;; LEFT/RIGHT -> cikinti altta.
                            ;; TOP/BOTTOM -> cikinti solda.
                            (setq shortIp nil)
                            (setq longIp nil)
                            (if oblique
                              (if (or (eq blockSide 'LEFT) (eq blockSide 'RIGHT))
                                (progn
                                  ;; Bu dallarda pMainTop-longIp ve pJoin-shortIp ayni ofset kolunda kalir.
                                  (setq longIp ipTop)
                                  (setq shortIp ipBot)
                                )
                                (progn
                                  ;; Bu dallarda pMainTop-shortIp ve pJoin-longIp ayni ofset kolunda kalir.
                                  (setq shortIp ipTop)
                                  (setq longIp ipBot)
                                )
                              )
                              (cond
                                ((or (eq blockSide 'LEFT) (eq blockSide 'RIGHT))
                                  ;; Yatay gelislerde alt nokta short, ust nokta long olur.
                                  ;; Yatay dallar zit cizer: RIGHT short-first, LEFT long-first.
                                  (if (<= (cadr ipTop) (cadr ipBot))
                                    (progn (setq shortIp ipTop) (setq longIp ipBot))
                                    (progn (setq shortIp ipBot) (setq longIp ipTop))
                                  )
                                )
                                ((or (eq blockSide 'TOP) (eq blockSide 'BOTTOM))
                                  ;; Dikey gelislerde sol nokta short, sag nokta long olur.
                                  (if (<= (car ipTop) (car ipBot))
                                    (progn (setq shortIp ipTop) (setq longIp ipBot))
                                    (progn (setq shortIp ipBot) (setq longIp ipTop))
                                  )
                                )
                              )
                            )
                            (if oblique
                              (progn
                                ;; Egik dirsekte hat kimligini koru: pMerge-ip, pMergeRin-ipRin.
                                ;; Uclar ayrica siralanmaz; boylece aciya bagli Z/capraz dirsek olusmaz.
                                (setq pTopDrop
                                  (DEGZ--local-bend-point pMainTop ipTop dx dy rx ry blockSide)
                                )
                                (setq pBotDrop
                                  (DEGZ--local-bend-point pJoin ipBot dx dy rx ry blockSide)
                                )
                                (setq crv
                                  (DEGZ--insert-detour
                                    crv
                                    cpCur
                                    cpEshort
                                    (list pMainTop pTopDrop ipTop ipBot pBotDrop pJoin)
                                  )
                                )
                              )
                              (cond
                                ((eq blockSide 'TOP)
                                        ;; Ustten geliste mevcut dogru eslesme korunur.
                                        (if (not shortIp)
                                          (if (<= (DEGZ--safe-distance pMainTop ipTop) (DEGZ--safe-distance pMainTop ipBot))
                                            (progn (setq shortIp ipTop) (setq longIp ipBot))
                                            (progn (setq shortIp ipBot) (setq longIp ipTop))
                                          )
                                        )
                                        (setq pTopDrop
                                          (if oblique
                                            (DEGZ--local-bend-point pMainTop shortIp dx dy rx ry blockSide)
                                            (list (car pMainTop) (cadr shortIp))
                                          )
                                        )
                                        (setq pBotDrop
                                          (if oblique
                                            (DEGZ--local-bend-point pJoin longIp dx dy rx ry blockSide)
                                            (list (car pJoin) (cadr longIp))
                                          )
                                        )
                                        (setq crv
                                          (DEGZ--insert-detour
                                            crv
                                            cpCur
                                            cpEshort
                                            (list pMainTop pTopDrop shortIp longIp pBotDrop pJoin)
                                          )
                                        )                              )
                                ((eq blockSide 'BOTTOM)
                                  ;; Asagidan geliste cikinti kisa/uzun eslesmesi secim asamasinda aynalanir.
                                  (if (not shortIp)
                                    (if (<= (DEGZ--safe-distance pMainTop ipTop) (DEGZ--safe-distance pMainTop ipBot))
                                      (progn (setq shortIp ipTop) (setq longIp ipBot))
                                      (progn (setq shortIp ipBot) (setq longIp ipTop))
                                    )
                                  )
                                  (setq pTopDrop
                                          (if oblique
                                            (DEGZ--local-bend-point pMainTop shortIp dx dy rx ry blockSide)
                                            (list (car pMainTop) (cadr shortIp))
                                          )
                                        )
                                  (setq pBotDrop
                                          (if oblique
                                            (DEGZ--local-bend-point pJoin longIp dx dy rx ry blockSide)
                                            (list (car pJoin) (cadr longIp))
                                          )
                                        )
                                  (setq crv
                                    (DEGZ--insert-detour
                                      crv
                                      cpCur
                                      cpEshort
                                      (list pMainTop pTopDrop shortIp longIp pBotDrop pJoin)
                                    )
                                  )
                                )
                                ((eq blockSide 'RIGHT)
                                        ;; Sagdan geliste de UP/BOTTOM ile ayni agiz sirasi kullanilir.
                                        (if (not shortIp)
                                          (if (<= (DEGZ--safe-distance pMainBot ipTop) (DEGZ--safe-distance pMainBot ipBot))
                                            (progn (setq shortIp ipTop) (setq longIp ipBot))
                                            (progn (setq shortIp ipBot) (setq longIp ipTop))
                                          )
                                        )
                                        (setq pTopDrop
                                          (if oblique
                                            (DEGZ--local-bend-point pMainTop shortIp dx dy rx ry blockSide)
                                            (list (car pMainTop) (cadr shortIp))
                                          )
                                        )
                                        (setq pBotDrop
                                          (if oblique
                                            (DEGZ--local-bend-point pJoin longIp dx dy rx ry blockSide)
                                            (list (car pJoin) (cadr longIp))
                                          )
                                        )
                                        (setq crv
                                          (DEGZ--insert-detour
                                            crv
                                            cpCur
                                            cpEshort
                                            (list pMainTop pTopDrop shortIp longIp pBotDrop pJoin)
                                          )
                                        )                              )
                                ((eq blockSide 'LEFT)
                                        ;; LEFT, RIGHT'in aynasi olarak uzun ucu ust agza baglar.
                                        (if (not shortIp)
                                          (if (<= (DEGZ--safe-distance pMainTop ipTop) (DEGZ--safe-distance pMainTop ipBot))
                                            (progn (setq shortIp ipTop) (setq longIp ipBot))
                                            (progn (setq shortIp ipBot) (setq longIp ipTop))
                                          )
                                        )
                                        (setq pTopDrop
                                          (if oblique
                                            (DEGZ--local-bend-point pMainTop longIp dx dy rx ry blockSide)
                                            (list (car pMainTop) (cadr longIp))
                                          )
                                        )
                                        (setq pBotDrop
                                          (if oblique
                                            (DEGZ--local-bend-point pJoin shortIp dx dy rx ry blockSide)
                                            (list (car pJoin) (cadr shortIp))
                                          )
                                        )
                                        (setq crv
                                          (DEGZ--insert-detour
                                            crv
                                            cpCur
                                            cpEshort
                                            (list pMainTop pTopDrop longIp shortIp pBotDrop pJoin)
                                          )
                                        )                              )
                                (T
                                        ;; Belirsiz yonde varsayilan dogru eslesme.
                                        (if (not shortIp)
                                          (if (<= (DEGZ--safe-distance pMainTop ipTop) (DEGZ--safe-distance pMainTop ipBot))
                                            (progn (setq shortIp ipTop) (setq longIp ipBot))
                                            (progn (setq shortIp ipBot) (setq longIp ipTop))
                                          )
                                        )
                                        (setq pTopDrop
                                          (if oblique
                                            (DEGZ--local-bend-point pMainTop shortIp dx dy rx ry blockSide)
                                            (list (car pMainTop) (cadr shortIp))
                                          )
                                        )
                                        (setq pBotDrop
                                          (if oblique
                                            (DEGZ--local-bend-point pJoin longIp dx dy rx ry blockSide)
                                            (list (car pJoin) (cadr longIp))
                                          )
                                        )
                                        (setq crv
                                          (DEGZ--insert-detour
                                            crv
                                            cpCur
                                            cpEshort
                                            (list pMainTop pTopDrop shortIp longIp pBotDrop pJoin)
                                          )
                                        )                              )
                              )
                            )
                          )
                          (setq crv
                            (DEGZ--insert-detour
                              crv
                              cpCur
                              cpEshort
                              (list pMainTop ipTop ipBot pMainBot pJoin)
                            )
                          )
                        )
                      )
                      
                     ;; =====================================================
                     ;; DURUM B: YAKIN BLOKLAR (DIRECT CONNECT)
                     ;; =====================================================
                     ;; * Bu bloklar DIREKT ana hatta baglanmali.
                     ;; * Komsunun bacagina YAPISMAMALI.
                     ;; * Bu yuzden referans olarak 'mainTmp' (Temiz Hat) kullanilmali.
                     (progn
                        (if (and remote isAnchor)
                            ;; Anchor ozel durumu (Pahli Baglanti)
                            (progn
                              (setq dirRec
                                 (if oblique
                                   (DEGZ--pair-by-local-offset cpCur cpEshort ip ipRin rx ry)
                                   (DEGZ--direct-detour-order blockSide cpCur cpEshort ip ipRin)
                                 )
                               )
                              (if dirRec
                                (progn
                                  (setq cpCur    (car dirRec))
                                  (setq cpEshort (cadr dirRec))
                                  (setq ipTop    (caddr dirRec))
                                  (setq ipBot    (cadddr dirRec))
                                  (setq distEnds (DEGZ--safe-distance cpCur cpEshort))
                                  (if (> distEnds 1e-9)
                                    (progn
                                      (setq uTan (list (/ (- (car cpEshort) (car cpCur)) distEnds)
                                                       (/ (- (cadr cpEshort) (cadr cpCur)) distEnds)))
                                      (setq uPerp (list (- (cadr uTan)) (car uTan)))
                                      (if alignedPair
                                        (progn
                                          (setq corner1 (DEGZ--corner-at-block-axis cpCur ipTop groupDir)
                                                corner2 (DEGZ--corner-at-block-axis cpEshort ipBot groupDir))
                                          (setq crv (DEGZ--insert-detour crv cpCur cpEshort
                                            (list corner1 ipTop ipBot corner2))))
                                        (progn
                                          (setq corner1 (DEGZ--calc-L-corner cpCur ipTop uPerp)
                                                corner2 (DEGZ--calc-L-corner cpEshort ipBot uPerp))
                                          (setq crv (DEGZ--insert-detour crv cpCur cpEshort
                                            (list corner1 ipTop ipBot corner2)))))
                                    )
                                  )
                                )
                              )
                            )
                            
                            ;; STANDART DIREKT BAGLANTI (VEKTOREL HIZALAMA)
                            (progn
                                ;; *** ONEMLI: Hesaplamalarda 'mainTmp' (Temiz Hat) kullan! ***
                                (setq calcCrv mainTmp) 
                                
                                ;; A. Orta noktayi bul
                                (setq ipAvg (list (/ (+ (car ip) (car ipRin)) 2.0) (/ (+ (cadr ip) (cadr ipRin)) 2.0)))
                                ;; DD/DF tarafinda da ortak hedef son yakin-hat
                                ;; hesabindan once korunur.
                                (setq pMid
                                  (if (and preTarget (not remote))
                                    (deg-safe-closest-point calcCrv preTarget)
                                    (deg-safe-closest-point calcCrv ipAvg)))
                                
                                ;; B. Hattin yonunu bul (Temiz hat uzerinden)
                                (setq paramMid (vlax-curve-getParamAtPoint (DEGZ--ename calcCrv) (DEGZ--pt3d pMid)))
                                (setq deriv (vlax-curve-getFirstDeriv (DEGZ--ename calcCrv) paramMid))
                                (setq Tlen (DEGZ--safe-distance '(0 0 0) deriv))
                                (if (< Tlen 1e-9)
                                   (progn (setq Tx rx) (setq Ty ry))
                                   (progn (setq Tx (/ (car deriv) Tlen)) (setq Ty (/ (cadr deriv) Tlen)))
                                )

                                ;; C. Hizalama Yonu
                                (setq Lx (- (car ipRin) (car ip)))
                                (setq Ly (- (cadr ipRin) (cadr ip)))
                                (setq dotProd (+ (* Tx Lx) (* Ty Ly)))
                                (setq dirSign (if (>= dotProd 0) 1.0 -1.0))

                                ;; Remote + anchor + target side: reverse direction so the short piece is taken from the other side
                                (if (and remote isAnchor isTargetSide)
                                  (setq dirSign (- dirSign))
                                )
                                
                                ;; D. Sabit 10 birim aralik (Merkezden +/- 5.0)
                                (setq distMid (vlax-curve-getDistAtParam (DEGZ--ename calcCrv) paramMid))
                                (setq maxDist (DEGZ--curve-total calcCrv))
                                
                                (setq distPair (DEGZ--distpair10 distMid dirSign maxDist shift))
                                (setq distDown (car distPair))
                                (setq distDownRin (cadr distPair))
                                
                                ;; Noktalari Temiz Hat uzerinden al (Komsunun bacagina carpmaz)
                                (setq pDown    (DEGZ--pt2d (vlax-curve-getPointAtDist (DEGZ--ename calcCrv) distDown)))
                                (setq pDownRin (DEGZ--pt2d (vlax-curve-getPointAtDist (DEGZ--ename calcCrv) distDownRin)))
                                ;; Detour ekleme noktalarini guncel 'crv' uzerinde bul
                                ;; pDown temiz hat uzerinde oldugu icin, 'crv' uzerinde de govdeye denk gelir.
                                (setq cpCur    (deg-safe-closest-point crv pDown))
                                (setq cpEshort (deg-safe-closest-point crv pDownRin))
                                
                                (setq ipRin (DEGZ--direct-offset-end ip ipRin cpCur cpEshort short))
                                ;; DIREKT BAGLANTI LISTESI
                                (setq dirRec
                                 (DEGZ--pair-by-local-offset cpCur cpEshort ip ipRin
                                   (- (car cpEshort) (car cpCur))
                                   (- (cadr cpEshort) (cadr cpCur)))
                               )
                                (if dirRec
                                  (progn
                                    (setq cpCur    (car dirRec))
                                    (setq cpEshort (cadr dirRec))
                                    (setq ipTop    (caddr dirRec))
                                    (setq ipBot    (cadddr dirRec))
                                    (setq distEnds (DEGZ--safe-distance cpCur cpEshort))
                                    (if (> distEnds 1e-9)
                                      (progn
                                        (setq uTan (list (/ (- (car cpEshort) (car cpCur)) distEnds)
                                                         (/ (- (cadr cpEshort) (cadr cpCur)) distEnds)))
                                        (setq uPerp (list (- (cadr uTan)) (car uTan)))
                                        (setq corner1 (DEGZ--calc-L-corner cpCur ipTop uPerp))
                                        (setq corner2 (DEGZ--calc-L-corner cpEshort ipBot uPerp))
                                        (setq crv (DEGZ--insert-detour crv cpCur cpEshort (list corner1 ipTop ipBot corner2)))
                                      )
                                      (setq crv (DEGZ--insert-detour crv cpCur cpEshort (list ipTop ipBot)))
                                    )
                                  )
                                )
                            )
                        )
                     )
                  )
                )
              )
            )
          )
        )

        (if mainTmp (entdel mainTmp))
      )
    )
  )
  (if (and crv (entget crv)) crv nil)
)



;; =============================================================
;; DS - block sembol/adet listesi
;; =============================================================
(defun DS--app () "DEG_DS")

(defun DS--regapp (/ app)
  (setq app (DS--app))
  (if (not (tblsearch "APPID" app)) (regapp app))
  app
)

(defun DS--created-p (e / xd rec)
  (setq xd (assoc -3 (entget e (list (DS--app)))))
  (setq rec (if (and xd (listp (cadr xd))) (cadr xd) nil))
  (and rec (= (car rec) (DS--app)))
)

(defun DS--mark-created (e / app)
  (if e
    (progn
      (DS--regapp)
      (setq app (DS--app))
      (vl-catch-all-apply 'entmod (list (append (entget e) (list (list -3 (list app (cons 1000 "CREATED")))))))
      (vl-catch-all-apply 'entupd (list e))
    )
  )
  e
)

(defun DS--num (key def / v)
  (setq v (DEG:CFG-GETNUM key))
  (* (if (> v 0.0) v def) (DEG:PLAN-UNIT-SCALE))
)

(defun DS--exclude-list (/ raw parts out p u)
  (setq raw (DEG:CFG-GET 'DS_EXCLUDE_BLOCKS))
  (if (= (DEGDO--trim raw) "")
    (setq raw "E_OK,E_ARROW,E_DÖÞEME,E_DÖSEME,E_DOSEME")
  )
  (setq parts (DEGDO--split-delim raw ","))
  (foreach p parts
    (setq u (strcase (DEGDO--trim p)))
    (if (/= u "")
      (setq out (append out (list u)))
    )
  )
  out
)

(defun DS--excluded-block-p (u / hit pat)
  (foreach pat (DS--exclude-list)
    (if (wcmatch u (strcat "*" pat "*"))
      (setq hit T)
    )
  )
  hit
)

(defun DS--block-name-ok-p (nm / u)
  (setq u (if nm (strcase nm) ""))
  (and (/= u "")
       (not (DS--excluded-block-p u))
  )
)

(defun DS--symbol-raw (blk / vals s)
  (setq vals (get-sembol-adi-from-block blk))
  (setq s (if (and vals (car vals)) (car (car vals)) ""))
  (setq s (deg-trim-string (vl-princ-to-string s)))
  (if s s "")
)

(defun DS--block-count (blk / symPairs adet)
  (setq symPairs (get-sembol-adi-from-block blk))
  (setq adet     (get-adet-from-block blk))
  (cond
    ((> adet 0) adet)
    ((and symPairs (> (cdr (car symPairs)) 0))
     (cdr (car symPairs)))
    (T 1)
  )
)

(defun DS--symbol-display (blk sym / s)
  (setq s (deg-trim-string (vl-princ-to-string sym)))
  (if (= s "")
    (setq s "-")
  )
  (if s s "-")
)

(defun DS--sort-key (row / sym nm key)
  (setq sym (deg-trim-string (vl-princ-to-string (nth 2 row))))
  (setq nm  (deg-trim-string (vl-princ-to-string (nth 1 row))))
  (setq key (deg-trim-string (vl-princ-to-string (car row))))
  (if (= sym "")
    (strcat "1|" (strcase nm) "|" (strcase key))
    (strcat "0|" (strcase sym) "|" (strcase key))
  )
)

(defun DS--sort-rows (rows)
  (vl-sort rows
    (function
      (lambda (a b)
        (< (DS--sort-key a) (DS--sort-key b))
      )
    )
  )
)

(defun DS--text-height ()
  (DS--num 'DS_TEXT_HEIGHT 25.0)
)

(defun DS--text-layer () "e_sembol_listesi_yazý_ds")

(defun DS--layer-flag-state (flags mask)
  (if (/= 0 (logand flags mask)) :vlax-true :vlax-false)
)

(defun DS--set-layer-flag-state (flags mask state)
  (if (= state :vlax-true)
    (logior flags mask)
    (- flags (logand flags mask))
  )
)

(defun DS--layer-state-record (layData / layName color flags)
  (if layData
    (progn
      (setq layName (cdr (assoc 2 layData)))
      (setq color   (cdr (assoc 62 layData)))
      (setq flags   (cdr (assoc 70 layData)))
      (if (null color) (setq color 7))
      (if (null flags) (setq flags 0))
      (list
        (strcase layName)
        layName
        (if (< color 0) :vlax-false :vlax-true)
        (DS--layer-flag-state flags 1)
        (DS--layer-flag-state flags 4)
      )
    )
  )
)

(defun DS--snapshot-all-layer-states (/ layData state)
  ;; DS block kopyalarken nested obje layerlarini da gecici olarak acabilir.
  ;; Komut basinda butun mevcut layerlari saklamak, hata/iptal dahil tam geri donus saglar.
  (setq *DS-LAYER-STATES* nil)
  (setq layData (tblnext "LAYER" T))
  (while layData
    (setq state (DS--layer-state-record layData))
    (if state
      (setq *DS-LAYER-STATES* (cons state *DS-LAYER-STATES*))
    )
    (setq layData (tblnext "LAYER"))
  )
  *DS-LAYER-STATES*
)

(defun DS--remember-layer-state (layName / key state)
  ;; Snapshot sonrasinda DS'nin olusturmadigi ama sonradan karsilastigi layerlari da sakla.
  (if (and (boundp '*DS-LAYER-STATES*)
           (= (type layName) 'STR)
           (/= layName "")
           (tblsearch "LAYER" layName))
    (progn
      (setq key (strcase layName))
      (if (not (assoc key *DS-LAYER-STATES*))
        (progn
          (setq state (DS--layer-state-record (tblsearch "LAYER" layName)))
          (if state
            (setq *DS-LAYER-STATES* (cons state *DS-LAYER-STATES*))
          )
        )
      )
    )
  )
  layName
)

(defun DS--remember-object-layer-states (obj / lay atts a)
  (if (and obj (= (type obj) 'VLA-OBJECT))
    (progn
      (setq lay (vl-catch-all-apply 'vla-get-Layer (list obj)))
      (if (not (vl-catch-all-error-p lay))
        (DS--remember-layer-state lay)
      )
      (setq atts (degk--att-list obj))
      (foreach a atts
        (setq lay (vl-catch-all-apply 'vla-get-Layer (list a)))
        (if (not (vl-catch-all-error-p lay))
          (DS--remember-layer-state lay)
        )
      )
    )
  )
  obj
)

(defun DS--restore-layer-states (/ rec layEnt layData color flags newColor newFlags)
  (if (boundp '*DS-LAYER-STATES*)
    (progn
      (foreach rec *DS-LAYER-STATES*
        (setq layEnt (tblobjname "LAYER" (cadr rec)))
        (if layEnt
          (progn
            (setq layData (entget layEnt))
            (setq color (cdr (assoc 62 layData)))
            (setq flags (cdr (assoc 70 layData)))
            (if (null color) (setq color 7))
            (if (null flags) (setq flags 0))
            (setq newColor
              (if (= (nth 2 rec) :vlax-true)
                (abs color)
                (- (abs color))))
            (setq newFlags (DS--set-layer-flag-state flags 1 (nth 3 rec)))
            (setq newFlags (DS--set-layer-flag-state newFlags 4 (nth 4 rec)))
            (if (assoc 62 layData)
              (setq layData (subst (cons 62 newColor) (assoc 62 layData) layData))
              (setq layData (append layData (list (cons 62 newColor))))
            )
            (if (assoc 70 layData)
              (setq layData (subst (cons 70 newFlags) (assoc 70 layData) layData))
              (setq layData (append layData (list (cons 70 newFlags))))
            )
            (vl-catch-all-apply 'entmod (list layData))
          )
        )
      )
      (setq *DS-LAYER-STATES* nil)
    )
  )
  T
)

(defun DS--ensure-text-layer (/ layName layObj)
  (setq layName (DS--text-layer))
  (DS--remember-layer-state layName)
  (if (not (tblsearch "LAYER" layName))
    (entmake
      (list
        (cons 0 "LAYER")
        (cons 100 "AcDbSymbolTableRecord")
        (cons 100 "AcDbLayerTableRecord")
        (cons 2 layName)
        (cons 70 0)
        (cons 62 7)
      )
    )
  )
  (setq layObj (tblobjname "LAYER" layName))
  (if layObj
    (progn
      (entmod (subst (cons 62 7) (assoc 62 (entget layObj)) (entget layObj)))
      (entupd layObj)
    )
  )
  (degk--ensure-layer-editable layName)
  layName
)

(defun DS--make-table-poly (pts / lay data e p)
  (setq lay (DS--ensure-text-layer))
  (if (and pts (> (length pts) 1))
    (progn
      (setq data
        (list
          (cons 0 "LWPOLYLINE")
          (cons 100 "AcDbEntity")
          (cons 8 lay)
          (cons 100 "AcDbPolyline")
          (cons 90 (length pts))
          (cons 70 0)
        )
      )
      (foreach p pts
        (setq data (append data (list (cons 10 (list (car p) (cadr p))))))
      )
      (setq e (entmakex data))
      (if e (DS--mark-created e))
      e
    )
  )
)

(defun DS--draw-table-frame (base rowCount / rowH blockW symbolW countW left x1 x2 right top bottom i y x z)
  (if (and base rowCount (> rowCount 0))
    (progn
      (setq rowH (DS--num 'DS_ROW_SPACING 110.0))
      (setq blockW (DS--num 'DS_TABLE_BLOCK_W 110.0))
      (setq symbolW (DS--num 'DS_TABLE_SYMBOL_W 120.0))
      (setq countW (DS--num 'DS_TABLE_COUNT_W 120.0))
      (setq z (if (caddr base) (caddr base) 0.0))
      (setq left  (- (car base) (/ blockW 2.0)))
      (setq x1    (+ left blockW))
      (setq x2    (+ x1 symbolW))
      (setq right (+ x2 countW))
      (setq top    (+ (cadr base) (/ rowH 2.0)))
      (setq bottom (- (cadr base) (* (- rowCount 1) rowH) (/ rowH 2.0)))
      (setq i 0)
      (while (<= i rowCount)
        (setq y (- top (* i rowH)))
        (DS--make-table-poly (list (list left y z) (list right y z)))
        (setq i (1+ i))
      )
      (foreach x (list left x1 x2 right)
        (DS--make-table-poly (list (list x top z) (list x bottom z)))
      )
    )
  )
)

(defun DS--add-text (pt txt align / doc ms p tx res lay)
  (vl-load-com)
  (setq txt (degk--clean-text txt))
  (if (and pt txt (/= txt ""))
    (progn
      (degk--ensure-textstyle "STANDARD" "arial.ttf")
      (setq lay (DS--ensure-text-layer))
      (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)))
      (setq ms  (vla-get-ModelSpace doc))
      (setq p   (deg-pt3 pt))
      (setq res (vl-catch-all-apply 'vla-AddText (list ms txt (vlax-3d-point p) (DS--text-height))))
      (if (vl-catch-all-error-p res)
        nil
        (progn
          (setq tx res)
          (if (vlax-property-available-p tx 'StyleName)
            (vl-catch-all-apply 'vla-put-StyleName (list tx "STANDARD"))
          )
          (if (and lay (/= lay ""))
            (vl-catch-all-apply 'vla-put-Layer (list tx lay))
          )
          (if (null align) (setq align acAlignmentMiddleLeft))
          (if (vlax-property-available-p tx 'Alignment)
            (vl-catch-all-apply 'vla-put-Alignment (list tx align))
          )
          (if (vlax-property-available-p tx 'TextAlignmentPoint)
            (vl-catch-all-apply 'vla-put-TextAlignmentPoint (list tx (vlax-3d-point p)))
          )
          tx
        )
      )
    )
  )
)

(defun DS--raw-to-list (raw)
  (cond
    ((vl-catch-all-error-p raw) nil)
    ((= (type raw) 'VARIANT)  (DS--raw-to-list (vlax-variant-value raw)))
    ((= (type raw) 'SAFEARRAY) (vlax-safearray->list raw))
    ((listp raw) raw)
    (T nil)
  )
)

(defun DS--constant-att-list (blk / raw)
  (if (and blk (= (type blk) 'VLA-OBJECT)
           (vlax-method-applicable-p blk 'GetConstantAttributes))
    (progn
      (setq raw (vl-catch-all-apply 'vlax-invoke (list blk 'GetConstantAttributes)))
      (DS--raw-to-list raw)
    )
    nil
  )
)

(defun DS--zero-inner-text-rotation (blk / atts a)
  (setq atts (append (degk--att-list blk) (DS--constant-att-list blk)))
  (foreach a atts
    (if (and a (= (type a) 'VLA-OBJECT) (vlax-property-available-p a 'Rotation))
      (vl-catch-all-apply 'vla-put-Rotation (list a 0.0))
    )
  )
  blk
)

(defun DS--zero-attrib-dxf-rotation (blk / e ad a)
  (setq e
    (cond
      ((= (type blk) 'ENAME) blk)
      ((= (type blk) 'VLA-OBJECT) (vlax-vla-object->ename blk))
      (T nil)
    )
  )
  (if e
    (progn
      (setq a (entnext e))
      (while (and a (setq ad (entget a)) (not (= (cdr (assoc 0 ad)) "SEQEND")))
        (if (= (cdr (assoc 0 ad)) "ATTRIB")
          (progn
            (if (assoc 50 ad)
              (setq ad (subst (cons 50 0.0) (assoc 50 ad) ad))
              (setq ad (append ad (list (cons 50 0.0))))
            )
            (vl-catch-all-apply 'entmod (list ad))
            (vl-catch-all-apply 'entupd (list a))
          )
        )
        (setq a (entnext a))
      )
      (vl-catch-all-apply 'entupd (list e))
    )
  )
  blk
)

(defun DS--make-scale-positive (blk / sx sy sz)
  (if (and blk (= (type blk) 'VLA-OBJECT)
           (vlax-property-available-p blk 'XScaleFactor)
           (vlax-property-available-p blk 'YScaleFactor)
           (vlax-property-available-p blk 'ZScaleFactor))
    (progn
      (setq sx (vl-catch-all-apply 'vla-get-XScaleFactor (list blk)))
      (setq sy (vl-catch-all-apply 'vla-get-YScaleFactor (list blk)))
      (setq sz (vl-catch-all-apply 'vla-get-ZScaleFactor (list blk)))
      (if (not (vl-catch-all-error-p sx))
        (vl-catch-all-apply 'vla-put-XScaleFactor (list blk (abs sx)))
      )
      (if (not (vl-catch-all-error-p sy))
        (vl-catch-all-apply 'vla-put-YScaleFactor (list blk (abs sy)))
      )
      (if (not (vl-catch-all-error-p sz))
        (vl-catch-all-apply 'vla-put-ZScaleFactor (list blk (abs sz)))
      )
    )
  )
  blk
)

(defun DS--reset-attribute-positions (insE)
  (if (and insE (= (type insE) 'ENAME))
    (vl-catch-all-apply 'degk--reset-insert-attrs (list insE))
  )
  insE
)

(defun DS--clear-attributes (blk / atts a tag)
  (setq atts (degk--att-list blk))
  (foreach a atts
    (if (and a (= (type a) 'VLA-OBJECT))
      (progn
        (setq tag (vl-catch-all-apply 'vla-get-TagString (list a)))
        (if (and (not (vl-catch-all-error-p tag))
                 (member (strcase (deg-trim-string tag)) '("ADET" "SIRA_NO" "SIRA NO"))
                 (vlax-property-available-p a 'TextString T))
          (vl-catch-all-apply 'vla-put-TextString (list a ""))
        )
      )
    )
  )
  (if (and blk (= (type blk) 'VLA-OBJECT)
           (vlax-method-applicable-p blk 'Update))
    (vl-catch-all-apply 'vla-Update (list blk))
  )
  blk
)

(defun DS--copy-block-to (blk target / copyObj copyE fromPt res msg nm)
  (setq res
    (vl-catch-all-apply
      (function
        (lambda ()
          (DS--remember-object-layer-states blk)
          (degk--make-object-and-atts-editable blk)
          (setq copyObj (vla-Copy blk))
          (setq copyE (vlax-vla-object->ename copyObj))
          (DS--remember-object-layer-states copyObj)
          (degk--make-object-and-atts-editable copyObj)
          (DS--make-scale-positive copyObj)
          (if (vlax-property-available-p copyObj 'Rotation)
            (vl-catch-all-apply 'vla-put-Rotation (list copyObj 0.0))
          )
          (DS--zero-inner-text-rotation copyObj)
          (setq fromPt (deg-get-inspt copyObj))
          (if fromPt
            (vla-Move copyObj (vlax-3d-point fromPt) (vlax-3d-point target))
          )
          (vl-catch-all-apply 'entupd (list copyE))
          (DS--reset-attribute-positions copyE)
          (DS--clear-attributes copyObj)
          (DS--remember-object-layer-states copyObj)
          (degk--make-object-and-atts-editable copyObj)
          (DS--zero-inner-text-rotation copyObj)
          (DS--zero-attrib-dxf-rotation copyObj)
          (DS--mark-created copyE)
          copyObj
        )
      )
      '()
    )
  )
  (if (vl-catch-all-error-p res)
    (progn
      (setq msg (vl-catch-all-error-message res))
      (setq nm (deg-block-name-raw blk))
      (princ (strcat "\nDS: " (if nm nm "<BLOCK>") " kopyalanamadi. Sebep: " msg))
      nil
    )
    res
  )
)

(defun DS--collect-blocks (ss / i ent obj nm sym rawSym adetUse key rec rows)
  (setq rows nil)
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent (ssname ss i))
        (setq obj (vlax-ename->vla-object ent))
        (setq nm  (deg-block-name obj))
        (if (and (not (DS--created-p ent)) (DS--block-name-ok-p nm))
          (progn
            (setq rawSym (DS--symbol-raw obj))
            (setq sym (DS--symbol-display obj rawSym))
            (setq adetUse (DS--block-count obj))
            (setq key (strcat (strcase nm) "|" (strcase rawSym)))
            (setq rec (assoc key rows))
            (if rec
              (setq rows (subst (list key nm rawSym sym (+ adetUse (nth 4 rec)) (nth 5 rec)) rec rows))
              (setq rows (append rows (list (list key nm rawSym sym adetUse obj))))
            )
          )
        )
        (setq i (1+ i))
      )
    )
  )
  (DS--sort-rows rows)
)

(defun DS_ORIG (/ *error* base ss rows row target sample sym count copied y oldTS oldCLayer *DS-LAYER-STATES*)
  (vl-load-com)
  (setq *DS-LAYER-STATES* nil
        oldTS (getvar "TEXTSTYLE")
        oldCLayer (getvar "CLAYER"))
  (defun *error* (msg)
    (if oldTS
      (vl-catch-all-apply 'setvar (list "TEXTSTYLE" oldTS))
    )
    (if oldCLayer
      (vl-catch-all-apply 'setvar (list "CLAYER" oldCLayer))
    )
    (DS--restore-layer-states)
    (if (and msg (not (wcmatch (strcase msg) "*CANCEL*,*QUIT*,*BREAK*")))
      (princ (strcat "\nDS hata: " msg))
    )
    (princ)
  )
  (DS--snapshot-all-layer-states)
  (princ "\nDS: Alan icindeki blocklari sec: ")
  (setq ss (ssget '((0 . "INSERT"))))
  (if (not ss)
    (princ "\nDS: Block secimi yok.")
    (progn
      (setq rows (DS--collect-blocks ss))
      (if (not rows)
        (princ "\nDS: Secilen alanda uygun block bulunamadi.")
        (progn
          (setq base (getpoint "\nDS: Liste baslangic noktasini tikla: "))
          (if (not base)
            (princ "\nDS: Nokta secilmedi.")
            (progn
              (degk--ensure-textstyle "STANDARD" "arial.ttf")
              (setvar "TEXTSTYLE" "STANDARD")
              (setq y 0)
              (foreach row rows
                (setq target (list (car base) (- (cadr base) (* y (DS--num 'DS_ROW_SPACING 110.0))) (if (caddr base) (caddr base) 0.0)))
                (setq sample (nth 5 row))
                (setq sym    (nth 3 row))
                (setq count  (nth 4 row))
                (setq copied (DS--copy-block-to sample target))
                (if copied
                  (progn
                    (DS--add-text (list (+ (car target) (DS--num 'DS_SYMBOL_DX 110.0)) (cadr target) (caddr target)) sym nil)
                    (DS--add-text (list (+ (car target) (DS--num 'DS_SYMBOL_DX 110.0) (DS--num 'DS_COUNT_DX 120.0)) (cadr target) (caddr target)) (itoa count) acAlignmentMiddleCenter)
                    (setq y (1+ y))
                  )
                )
              )
              (DS--draw-table-frame base y)
              (princ (strcat "\nDS tamam. " (itoa y) " satir olusturuldu."))
            )
          )
        )
      )
    )
  )
  (if oldTS
    (vl-catch-all-apply 'setvar (list "TEXTSTYLE" oldTS))
  )
  (if oldCLayer
    (vl-catch-all-apply 'setvar (list "CLAYER" oldCLayer))
  )
  (DS--restore-layer-states)
  (princ)
)


;; ============================================================
;; DT - 10 BIRIM KABLO TAVASI
;; Komut icinde cizdirilen acik polyline merkez hattini gizli katmanda saklar,
;; tava konturunu ve donus/T/+ baglanti elemanlarini cizer.
;; ============================================================

(defun DT--type-key (idx suffix)
  (read (strcat "DT_TYPE" (itoa idx) "_" suffix))
)

(defun DT--type-color-default (idx)
  (cond
    ((= idx 1) (DEG:CFG-ACI-OR 'DT_KA_COLOR 7))
    ((= idx 2) (DEG:CFG-ACI-OR 'DT_ZA_COLOR 7))
    (T 7)
  )
)

(defun DT--type-color (idx / key value)
  (setq key (DT--type-key idx "COLOR"))
  (if (assoc key *DEG_CFG_OVERRIDES*)
    (DEG:CFG-ACI-OR key (DT--type-color-default idx))
    (DT--type-color-default idx)
  )
)

(defun DT--type-hatch-pattern-default (idx)
  "SOLID"
)

(defun DT--type-hatch-pattern (idx / key s)
  (setq key (DT--type-key idx "HATCH_PATTERN"))
  (setq s (strcase (vl-string-trim " \t\r\n" (DEG:CFG-GET key))))
  (cond
    ((= s "SOLID") "SOLID")
    ((= s "HEX") "HEX")
    ((= s "") "SOLID")
    (T "HEX"))
)

(defun DT--type-hatch-color-default (idx)
  8
)

(defun DT--type-hatch-color (idx)
  (DEG:CFG-ACI-OR (DT--type-key idx "HATCH_COLOR") (DT--type-hatch-color-default idx))
)

(defun DT--type-hatch-scale-default (idx)
  10.0
)

(defun DT--type-hatch-scale (idx)
  (DEG:CFG-NUM-OR (DT--type-key idx "HATCH_SCALE") (DT--type-hatch-scale-default idx))
)

(defun DT--mode-hatch-pattern (mode / rec)
  (setq rec (DT--find-type (DT--normalize-mode mode)))
  (if rec (nth 4 rec) "SOLID")
)

(defun DT--mode-hatch-color (mode / rec)
  (setq rec (DT--find-type (DT--normalize-mode mode)))
  (if rec (nth 5 rec) 8)
)

(defun DT--mode-hatch-scale (mode / rec)
  (setq rec (DT--find-type (DT--normalize-mode mode)))
  (if rec (nth 6 rec) 10.0)
)

(defun DT--type-default-layer (code)
  (strcat "e_" (DT--name-safe code) "_tava")
)

(defun DT--type-configs (/ i code layer out)
  (setq i 1)
  (while (<= i 7)
    (setq code
      (strcase
        (vl-string-trim " \t\r\n" (DEG:CFG-GET (DT--type-key i "CODE")))
      )
    )
    (setq layer
      (vl-string-trim " \t\r\n" (DEG:CFG-GET (DT--type-key i "LAYER")))
    )
    ;; Kisa adi girilen tip palette mutlaka gelsin. Layer bos birakilmissa
    ;; tip yine cizilebilir olsun ve tahmin edilebilir bir layer kullansin.
    (if (and (/= code "") (= layer ""))
      (setq layer (DT--type-default-layer code)))
    (if (/= code "")
      (setq out
        (append out
          (list
            (list
              code
              layer
              (DT--type-color i)
              i
              (DT--type-hatch-pattern i)
              (DT--type-hatch-color i)
              (DT--type-hatch-scale i)
            )
          )
        )
      )
    )
    (setq i (1+ i))
  )
  out
)
(defun DT--find-type (mode / u rec hit)
  (setq u (if mode (strcase (vl-string-trim " \t\r\n" mode)) ""))
  (if (= u "LV") (setq u "KA"))
  (if (= u "WC") (setq u "ZA"))
  (foreach rec (DT--type-configs)
    (if (= (car rec) u) (setq hit rec))
  )
  hit
)

(defun DT--normalize-mode (mode / rec types)
  (setq rec (DT--find-type mode))
  (if rec
    (car rec)
    (progn
      (setq types (DT--type-configs))
      (if types (caar types) "KA")
    )
  )
)

(defun DT--mode-layer (mode / rec)
  (setq rec (DT--find-type (DT--normalize-mode mode)))
  (if rec (cadr rec) "e_KA_tava")
)

(defun DT--mode-color (mode / rec)
  (setq rec (DT--find-type (DT--normalize-mode mode)))
  (if rec (nth 2 rec) 7)
)

(defun DT--mode-list-label (/ out rec)
  (foreach rec (DT--type-configs)
    (setq out
      (if out
        (strcat out "/" (car rec))
        (car rec)
      )
    )
  )
  (if out out "KA")
)

(defun DT--last-mode (/ s)
  (setq s (getenv "DEG_DT_LAST_MODE"))
  (DT--normalize-mode s)
)

(defun DT--remember-mode (mode)
  (setq *DT_ACTIVE_MODE* (DT--normalize-mode mode))
  (setq *DT_ACTIVE_LAYER* (DT--mode-layer *DT_ACTIVE_MODE*))
  (setenv "DEG_DT_LAST_MODE" *DT_ACTIVE_MODE*)
  *DT_ACTIVE_MODE*
)

(defun DT--mode-keyword (s / rec)
  (setq rec (DT--find-type s))
  (if rec (car rec) nil)
)

(defun DT--layer-visible ()
  (if (and *DT_ACTIVE_LAYER* (/= *DT_ACTIVE_LAYER* ""))
    *DT_ACTIVE_LAYER*
    (DT--mode-layer (DT--last-mode))
  )
)
(defun DT--layer-center  () "e_tava_dt_merkez")
(defun DT--layer-fitting () (DT--layer-visible))

(defun DT--line-layer-p (lay / u)
  (setq u (if lay (strcase lay) ""))
  (wcmatch u "*_ÇÝZGÝ,*_ÇIZGI")
)

(defun DT--base-layer-name (lay)
  (if (DT--line-layer-p lay)
    (substr lay 1 (- (strlen lay) 6))
    lay
  )
)

(defun DT--line-layer-name (lay)
  (if (DT--line-layer-p lay)
    lay
    (strcat (DT--base-layer-name lay) "_çizgi")
  )
)

(defun DT--layer-color-for-name (lay / base rec color)
  (setq base (strcase (DT--base-layer-name lay))
        color 7)
  (foreach rec (DT--type-configs)
    (if (= base (strcase (cadr rec))) (setq color (nth 2 rec))))
  color
)

(defun DT--layer-linework (/ base line)
  (setq base (DT--base-layer-name (DT--layer-visible))
        line (DT--line-layer-name base))
  (DT--ensure-layer line (DT--layer-color-for-name base) nil)
  line
)

(defun DT--tray-visible-layer-p (lay / u hit rec)
  (setq u (if lay (strcase (DT--base-layer-name lay)) ""))
  (if (= u "E_TAVA") (setq hit T))
  (foreach rec (DT--type-configs)
    (if (= u (strcase (cadr rec))) (setq hit T))
  )
  hit
)

(defun DT--visible-layer-filter (/ out rec)
  (setq out "e_tava,e_tava_çizgi")
  (foreach rec (DT--type-configs)
    (setq out
      (strcat out "," (cadr rec) "," (DT--line-layer-name (cadr rec))))
  )
  out
)

(defun DT--ensure-type-layers (/ rec)
  (foreach rec (DT--type-configs)
    (DT--ensure-layer (cadr rec) (nth 5 rec) nil)
    (DT--ensure-layer (DT--line-layer-name (cadr rec)) (nth 2 rec) nil)
  )
)

(defun DT--ensure-layer (name color offp / rec ed c)
  (setq c (abs color))
  (if offp (setq c (- c)))
  (if (not (tblsearch "LAYER" name))
    (entmakex
      (list
        (cons 0 "LAYER")
        (cons 100 "AcDbSymbolTableRecord")
        (cons 100 "AcDbLayerTableRecord")
        (cons 2 name)
        (cons 70 0)
        (cons 62 c)
        (cons 6 "CONTINUOUS")
      )
    )
  )
  (setq rec (tblobjname "LAYER" name))
  (if rec
    (progn
      (setq ed (entget rec))
      (if (assoc 62 ed)
        (setq ed (subst (cons 62 c) (assoc 62 ed) ed))
        (setq ed (append ed (list (cons 62 c))))
      )
      (entmod ed)
      (entupd rec)
    )
  )
  name
)

(defun DT--set-layer-bylayer (ent lay / ed obj)
  (setq ed (entget ent))
  (if (assoc 8 ed)
    (setq ed (subst (cons 8 lay) (assoc 8 ed) ed))
    (setq ed (append ed (list (cons 8 lay))))
  )
  (setq ed (vl-remove-if '(lambda (x) (member (car x) '(62 420 430))) ed))
  (entmod ed)
  (setq obj (vl-catch-all-apply 'vlax-ename->vla-object (list ent)))
  (if (and obj (not (vl-catch-all-error-p obj)))
    (progn
      (vl-catch-all-apply 'vla-put-Layer (list obj lay))
      (vl-catch-all-apply 'vla-put-Color (list obj 256))))
  (entupd ent)
  ent
)

(defun DT--closed-p (ent / flg)
  (setq flg (cdr (assoc 70 (entget ent))))
  (and flg (= 1 (logand flg 1)))
)

(defun DT--has-arc-p (ent / typ ed hit x v vd)
  (setq typ (cdr (assoc 0 (entget ent))) hit nil)
  (if (= typ "LWPOLYLINE")
    (progn
      (setq ed (entget ent))
      (foreach x ed
        (if (and (= (car x) 42) (> (abs (cdr x)) 1e-10)) (setq hit T))
      )
    )
    (if (= typ "POLYLINE")
      (progn
        (setq v (entnext ent))
        (while (and v (/= (cdr (assoc 0 (entget v))) "SEQEND"))
          (setq vd (entget v))
          (if (and (= (cdr (assoc 0 vd)) "VERTEX")
                   (assoc 42 vd)
                   (> (abs (cdr (assoc 42 vd))) 1e-10))
            (setq hit T)
          )
          (setq v (entnext v))
        )
      )
    )
  )
  hit
)

(defun DT--tray-height-elevation (value / text parsed)
  (setq text
    (vl-string-translate
      ","
      "."
      (vl-string-trim " \t\r\n" (if (= (type value) 'STR) value ""))))
  (setq parsed (if (/= text "") (distof text 2) nil))
  (if (numberp parsed) parsed 0.0)
)

(defun DT--active-elevation ()
  (if (and (boundp '*DT_ACTIVE_ELEVATION*) (numberp *DT_ACTIVE_ELEVATION*))
    *DT_ACTIVE_ELEVATION*
    0.0
  )
)

(defun DT--point-at-elevation (point elevation)
  (list (car point) (cadr point) (float elevation))
)

(defun DT--distance-xy (a b)
  (if (and a b)
    (distance (list (car a) (cadr a) 0.0)
              (list (car b) (cadr b) 0.0))
  )
)

(defun DT--entity-elevation (ent / ed typ value point)
  (if (and ent (setq ed (entget ent)))
    (progn
      (setq typ (cdr (assoc 0 ed)))
      (cond
        ((= typ "LWPOLYLINE")
          (setq value (cdr (assoc 38 ed))))
        ((member typ '("INSERT" "HATCH" "LINE" "CIRCLE" "ARC"))
          (setq point (cdr (assoc 10 ed))
                value (if (and point (caddr point)) (caddr point) 0.0)))
        (T (setq value 0.0))
      )
    )
  )
  (if (numberp value) value 0.0)
)

(defun DT--same-active-elevation-p (ent)
  (equal (DT--entity-elevation ent) (DT--active-elevation) 0.000001)
)

(defun DT--center-elevation-app () "DT_END_ELEVATION")

(defun DT--center-elevation-profile-app () "DT_ELEV_PROFILE")

(defun DT--set-center-end-elevations (center startZ endZ / app ed payload)
  (setq app (DT--center-elevation-app))
  (if (not (tblsearch "APPID" app)) (regapp app))
  (if (and center (entget center) (numberp startZ) (numberp endZ))
    (progn
      (setq payload (list app (cons 1040 (float startZ)) (cons 1040 (float endZ))))
      (setq ed (entget center '("*")))
      (setq ed (DT--xdata-set-app ed app payload))
      (entmod ed)
      (entupd center)
    )
  )
  center
)

(defun DT--set-center-base-elevation (center elevation / ed rec)
  (if (and center (numberp elevation)
           (setq ed (entget center '("*")))
           (= (cdr (assoc 0 ed)) "LWPOLYLINE"))
    (progn
      (setq rec (assoc 38 ed))
      (setq ed
        (if rec
          (subst (cons 38 (float elevation)) rec ed)
          (append ed (list (cons 38 (float elevation))))))
      (entmod ed)
      (entupd center)
    )
  )
  center
)

(defun DT--center-end-elevations (center / app ed xd rec item values fallback)
  (setq app      (DT--center-elevation-app)
        fallback (DT--entity-elevation center))
  (if (and center (entget center))
    (progn
      (setq ed  (entget center (list app))
            xd  (assoc -3 ed)
            rec (if xd (cadr xd) nil))
      (if (and rec (= (car rec) app))
        (foreach item (cdr rec)
          (if (= (car item) 1040)
            (setq values (append values (list (cdr item))))
          )
        )
      )
    )
  )
  (if (>= (length values) 2)
    (list (car values) (cadr values))
    (list fallback fallback)
  )
)

(defun DT--set-center-elevation-profile (center startTrim endTrim startLineZ endLineZ / app ed payload)
  (setq app (DT--center-elevation-profile-app))
  (if (not (tblsearch "APPID" app)) (regapp app))
  (if (and center (entget center) (numberp startTrim) (numberp endTrim))
    (progn
      (setq payload
        (list app
          (cons 1040 (float (max 0.0 startTrim)))
          (cons 1040 (float (max 0.0 endTrim)))))
      (if (and (numberp startLineZ) (numberp endLineZ))
        (setq payload
          (append payload
            (list (cons 1040 (float startLineZ))
                  (cons 1040 (float endLineZ)))))
      )
      (setq ed (entget center '("*")))
      (setq ed (DT--xdata-set-app ed app payload))
      (entmod ed)
      (entupd center)))
  center
)

(defun DT--center-elevation-profile (center / app ed xd rec item values)
  (setq app (DT--center-elevation-profile-app))
  (if (and center (entget center))
    (progn
      (setq ed  (entget center (list app))
            xd  (assoc -3 ed)
            rec (if xd (cadr xd) nil))
      (if (and rec (= (car rec) app))
        (foreach item (cdr rec)
          (if (= (car item) 1040)
            (setq values (append values (list (cdr item)))))))))
  (if (>= (length values) 2)
    (list (max 0.0 (car values))
          (max 0.0 (cadr values))
          (if (>= (length values) 4) (nth 2 values) nil)
          (if (>= (length values) 4) (nth 3 values) nil))
    (list 0.0 0.0 nil nil))
)

(defun DT--route-total-length (pts / total i)
  (setq total 0.0 i 0)
  (while (< i (1- (length pts)))
    (setq total (+ total (DT--distance-xy (nth i pts) (nth (1+ i) pts))))
    (setq i (1+ i))
  )
  total
)

(defun DT--route-distance-at-point (pt pts / total bestPos bestD i a b segLen rec cp d)
  (setq total 0.0 i 0)
  (while (< i (1- (length pts)))
    (setq a      (nth i pts)
          b      (nth (1+ i) pts)
          segLen (DT--distance-xy a b)
          rec    (g365_closest_on_seg pt a b))
    (if rec
      (progn
        (setq cp (car rec) d (nth 2 rec))
        (if (or (null bestD) (< d bestD))
          (setq bestD d bestPos (+ total (DT--distance-xy a cp)))
        )
      )
    )
    (setq total (+ total segLen)
          i     (1+ i))
  )
  (if (numberp bestPos) bestPos 0.0)
)

(defun DT--route-elevation-at-point (pt pts startZ endZ / total at ratio)
  (setq total (DT--route-total-length pts))
  (if (> total 0.000001)
    (progn
      (setq at    (DT--route-distance-at-point pt pts)
            ratio (max 0.0 (min 1.0 (/ at total))))
      (+ startZ (* ratio (- endZ startZ)))
    )
    startZ
  )
)

(defun DT--route-elevation-profile-at-point (pt pts startZ endZ startTrim endTrim startLineZ endLineZ / total at usable ratio tol)
  (setq total     (DT--route-total-length pts)
        startTrim (max 0.0 (if (numberp startTrim) startTrim 0.0))
        endTrim   (max 0.0 (if (numberp endTrim) endTrim 0.0))
        startLineZ (if (numberp startLineZ) startLineZ startZ)
        endLineZ   (if (numberp endLineZ) endLineZ endZ)
        tol         0.000001)
  (if (> total 0.000001)
    (progn
      (setq at       (DT--route-distance-at-point pt pts)
            usable   (- total startTrim endTrim))
      (cond
        ((<= usable 0.000001)
          (DT--route-elevation-at-point pt pts startZ endZ))
        ((< at (- startTrim tol)) startZ)
        ((> at (+ (- total endTrim) tol)) endZ)
        (T
          (setq ratio (/ (- at startTrim) usable))
          (setq ratio (max 0.0 (min 1.0 ratio)))
          (+ startLineZ (* ratio (- endLineZ startLineZ))))))
    startZ)
)

(defun DT--center-elevation-at-point (center pt / pts elevations profile)
  (setq pts        (g365_get_pts center)
        elevations (DT--center-end-elevations center)
        profile     (DT--center-elevation-profile center))
  (if (and pts (> (length pts) 1))
    (DT--route-elevation-profile-at-point
      pt pts
      (car elevations) (cadr elevations)
      (car profile) (cadr profile) (nth 2 profile) (nth 3 profile))
    (car elevations)
  )
)

(defun DT--build-elevation-at-point (pt)
  (if (and (boundp '*DT_BUILD_ROUTE_PTS*)
           (boundp '*DT_BUILD_START_ELEVATION*)
           (boundp '*DT_BUILD_END_ELEVATION*)
           *DT_BUILD_ROUTE_PTS*
           (numberp *DT_BUILD_START_ELEVATION*)
           (numberp *DT_BUILD_END_ELEVATION*))
    (DT--route-elevation-profile-at-point
      pt
      *DT_BUILD_ROUTE_PTS*
      *DT_BUILD_START_ELEVATION*
      *DT_BUILD_END_ELEVATION*
      (if (and (boundp '*DT_BUILD_START_TRIM*)
               (numberp *DT_BUILD_START_TRIM*))
        *DT_BUILD_START_TRIM* 0.0)
      (if (and (boundp '*DT_BUILD_END_TRIM*)
               (numberp *DT_BUILD_END_TRIM*))
        *DT_BUILD_END_TRIM* 0.0)
      (if (and (boundp '*DT_BUILD_START_LINE_ELEVATION*)
               (numberp *DT_BUILD_START_LINE_ELEVATION*))
        *DT_BUILD_START_LINE_ELEVATION* *DT_BUILD_START_ELEVATION*)
      (if (and (boundp '*DT_BUILD_END_LINE_ELEVATION*)
               (numberp *DT_BUILD_END_LINE_ELEVATION*))
        *DT_BUILD_END_LINE_ELEVATION* *DT_BUILD_END_ELEVATION*))
    (DT--active-elevation)
  )
)

(defun DT--make-poly (lay pts closedp / data p ent)
  (if (and pts (> (length pts) 1))
    (progn
      (setq data
        (list
          (cons 0 "LWPOLYLINE")
          (cons 100 "AcDbEntity")
          (cons 8 lay)
        )
      )
      ;; Merkez cizgisi gorunmez yardimci geometridir; sadece tava cizgileri 0.30 mm olur.
      (if (/= (strcase lay) (strcase (DT--layer-center)))
        (setq data (append data (list (cons 370 30))))
      )
      (setq data
        (append data
          (list
          (cons 100 "AcDbPolyline")
          (cons 90 (length pts))
          (cons 70 (if closedp 1 0))
          (cons 38 (DT--active-elevation))
          (cons 43 0.0)
          )
        )
      )
      (foreach p pts
        (setq data (append data (list (cons 10 (list (car p) (cadr p))))))
      )
      (setq ent (entmakex data))
      ent
    )
  )
)

(defun DT--make-poly3d (lay pts closedp / poly p made)
  (if (and pts (> (length pts) 1))
    (progn
      (setq made
        (entmake
          (list
            '(0 . "POLYLINE")
            '(100 . "AcDbEntity")
            (cons 8 lay)
            '(370 . 30)
            '(100 . "AcDb3dPolyline")
            '(66 . 1)
            '(10 0.0 0.0 0.0)
            (cons 70 (if closedp 9 8)))))
      (if made
        (progn
          (foreach p pts
            (entmake
              (list
                '(0 . "VERTEX")
                '(100 . "AcDbEntity")
                (cons 8 lay)
                '(100 . "AcDbVertex")
                '(100 . "AcDb3dPolylineVertex")
                (cons 10 (list (car p) (cadr p) (if (caddr p) (caddr p) 0.0)))
                '(70 . 32))))
          (entmake (list '(0 . "SEQEND") '(100 . "AcDbEntity") (cons 8 lay)))
          (setq poly (entlast))
        )
      )
      poly
    )
  )
)

(setq *DT_HATCH_PATTERN_CACHE* nil)

(defun DT--trim (s)
  (vl-string-trim " \t\r\n" (if (= (type s) 'STR) s ""))
)

(defun DT--split-comma (s / txt pos part out)
  (setq txt (if (= (type s) 'STR) s ""))
  (while (setq pos (vl-string-search "," txt))
    (setq part (substr txt 1 pos))
    (setq out (append out (list part)))
    (setq txt (substr txt (+ pos 2)))
  )
  (append out (list txt))
)

(defun DT--deg-rad (deg)
  (* pi (/ deg 180.0))
)

(defun DT--pat-line-numbers (line / part out)
  (foreach part (DT--split-comma line)
    (setq part (DT--trim part))
    (if (/= part "")
      (setq out (append out (list (atof part))))
    )
  )
  (if (>= (length out) 5) out nil)
)

(defun DT--pat-file ()
  (or
    (findfile "acad.pat")
    (findfile "acadiso.pat")
  )
)

(defun DT--read-pat-lines (pattern / key cached file f line s pos name found done nums out)
  (setq key (strcase (DT--trim pattern)))
  (setq cached (assoc key *DT_HATCH_PATTERN_CACHE*))
  (if cached
    (cdr cached)
    (progn
      (setq file (DT--pat-file))
      (if (and file (setq f (open file "r")))
        (progn
          (while (and (not done) (setq line (read-line f)))
            (setq s (DT--trim line))
            (cond
              ((= s ""))
              ((= (substr s 1 1) ";"))
              ((= (substr s 1 1) "*")
                (if found
                  (setq done T)
                  (progn
                    (setq pos (vl-string-search "," s))
                    (setq name
                      (strcase
                        (DT--trim
                          (if pos
                            (substr s 2 (1- pos))
                            (substr s 2)
                          )
                        )
                      )
                    )
                    (if (= name key) (setq found T))
                  )
                )
              )
              (found
                (setq nums (DT--pat-line-numbers s))
                (if nums (setq out (append out (list nums))))
              )
            )
          )
          (close f)
        )
      )
      (if out
        (setq *DT_HATCH_PATTERN_CACHE* (cons (cons key out) *DT_HATCH_PATTERN_CACHE*))
      )
      out
    )
  )
)

(defun DT--hex-pat-lines ()
  (list
    (list 0.0 0.0 0.0 0.0 0.21650635094610966 0.125 -0.25)
    (list 120.0 0.0 0.0 0.0 0.21650635094610966 0.125 -0.25)
    (list 60.0 0.125 0.0 0.0 0.21650635094610966 0.125 -0.25)
  )
)

(defun DT--pat-lines->dxfs (lines scale / out nums ang rad ca sa xo yo xd yd dx dy dash dashes)
  (foreach nums lines
    (setq ang (nth 0 nums)
          xo  (nth 1 nums)
          yo  (nth 2 nums)
          xd  (nth 3 nums)
          yd  (nth 4 nums)
          rad (DT--deg-rad ang)
          ca  (cos rad)
          sa  (sin rad)
          dx  (* scale (- (* xd ca) (* yd sa)))
          dy  (* scale (+ (* xd sa) (* yd ca)))
          dashes (cddddr (cdr nums)))
    (setq out
      (append out
        (list
          (cons 53 rad)
          (cons 43 (* xo scale))
          (cons 44 (* yo scale))
          (cons 45 dx)
          (cons 46 dy)
          (cons 79 (length dashes))
        )
      )
    )
    (foreach dash dashes
      (setq out (append out (list (cons 49 (* dash scale)))))
    )
  )
  out
)

(defun DT--hatch-scale ()
  (DT--mode-hatch-scale *DT_ACTIVE_MODE*)
)

(defun DT--hatch-pattern-info (pattern / name scale defs)
  (setq name (strcase (DT--trim pattern)))
  (if (= name "") (setq name "SOLID"))
  (cond
    ((= name "SOLID")
      (list "SOLID" nil))
    (T
      ;; DT icin HEX pattern'i dogrudan DXF tanimiyla uretiyoruz.
      ;; AutoCAD'in acad.pat okumasina baglanmak farkli kurulumlarda
      ;; "stringp T" hatasi verebildigi icin desteklenmeyen isimler HEX'e duser.
      (if (/= name "HEX") (setq name "HEX"))
      (setq scale (DT--hatch-scale))
      (setq defs (DT--pat-lines->dxfs (DT--hex-pat-lines) scale))
      (list name defs)
    )
  )
)

(defun DT--hatch-data (lay pts pattern color elevation / info pat defs solidp scale data i a b n)
  (if (and lay pts (>= (length pts) 3))
    (progn
      (setq info (DT--hatch-pattern-info pattern)
            pat  (car info)
            defs (cadr info)
            solidp (= pat "SOLID")
            scale (DT--hatch-scale)
            n (length pts))
      (setq data
        (list
          (cons 0 "HATCH")
          (cons 100 "AcDbEntity")
          (cons 8 lay)
          (cons 62 256)
          (cons 100 "AcDbHatch")
          (cons 10 (list 0.0 0.0 (if (numberp elevation) elevation 0.0)))
          (cons 210 (list 0.0 0.0 1.0))
          (cons 2 pat)
          (cons 70 (if solidp 1 0))
          (cons 71 0)
          (cons 91 1)
          (cons 92 1)
          (cons 93 n)
        )
      )
      (setq i 0)
      (while (< i n)
        (setq a (nth i pts)
              b (nth (rem (1+ i) n) pts))
        (setq data
          (append data
            (list
              (cons 72 1)
              (cons 10 (list (car a) (cadr a) 0.0))
              (cons 11 (list (car b) (cadr b) 0.0))
            )
          )
        )
        (setq i (1+ i))
      )
      (setq data
        (append data
          (list
            (cons 97 0)
            (cons 75 1)
            (cons 76 1)
          )
        )
      )
      (if (not solidp)
        (setq data
          (append data
            (list
              (cons 52 0.0)
              (cons 41 scale)
              (cons 77 0)
              (cons 78 (/ (length defs) 8))
            )
            defs
          )
        )
      )
      (append data (list (cons 98 0)))
    )
  )
)

(defun DT--hatch-data-assoc-at (lay pts pattern color elevation boundary / data out item)
  (setq data (DT--hatch-data lay pts pattern color elevation))
  (if (and data boundary (entget boundary))
    (progn
      (foreach item data
        (cond
          ((= (car item) 71)
            (setq out (append out (list (cons 71 1)))))
          ((= (car item) 97)
            (setq out (append out (list (cons 97 1) (cons 330 boundary)))))
          (T
            (setq out (append out (list item))))
        )
      )
      out
    )
    data
  )
)

(defun DT--hatch-data-assoc (lay pts pattern color boundary)
  (DT--hatch-data-assoc-at
    lay pts pattern color (DT--active-elevation) boundary)
)

(defun DT--vec3-sub (a b)
  (list (- (car a) (car b))
        (- (cadr a) (cadr b))
        (- (if (caddr a) (caddr a) 0.0) (if (caddr b) (caddr b) 0.0)))
)

(defun DT--cross3 (a b)
  (list
    (- (* (cadr a) (caddr b)) (* (caddr a) (cadr b)))
    (- (* (caddr a) (car b)) (* (car a) (caddr b)))
    (- (* (car a) (cadr b)) (* (cadr a) (car b))))
)

(defun DT--dot3 (a b)
  (+ (* (car a) (car b))
     (* (cadr a) (cadr b))
     (* (caddr a) (caddr b)))
)

(defun DT--unit3 (v / len)
  (setq len (sqrt (+ (* (car v) (car v))
                     (* (cadr v) (cadr v))
                     (* (caddr v) (caddr v)))))
  (if (> len 0.000000001)
    (list (/ (car v) len) (/ (cadr v) len) (/ (caddr v) len))
  )
)

(defun DT--plane-normal (pts / p0 p1 p2 normal)
  (if (>= (length pts) 3)
    (progn
      (setq p0     (car pts)
            p1     (nth 1 pts)
            p2     (g365_last pts)
            normal (DT--unit3
                     (DT--cross3 (DT--vec3-sub p1 p0) (DT--vec3-sub p2 p0))))
      (if (and normal (< (caddr normal) 0.0))
        (setq normal (list (- (car normal)) (- (cadr normal)) (- (caddr normal))))
      )
      normal
    )
  )
)

(defun DT--hatch-data-plane-assoc (lay pts pattern color boundary / info pat defs solidp scale normal ocsPts elevation data i n a b)
