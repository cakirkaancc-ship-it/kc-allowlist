      (mode_tile "defaults" 0)
      (action_tile "defaults" "(DEGDO--reset-dt)")
      (action_tile "accept" "(DEGDO--save-dt) (done_dialog 1)")
    )
    ((= page "do_dtt")
      (DEGDO--fill-dtt)
      (mode_tile "defaults" 0)
      (action_tile "defaults" "(DEGDO--reset-dtt)")
      (action_tile "accept" "(DEGDO--save-dtt) (done_dialog 1)")
    )
    ((= page "do_dn")
      (DEGDO--fill-dn)
      (mode_tile "defaults" 0)
      (action_tile "defaults" "(DEGDO--reset-dn)")
      (action_tile "dn_clear_sira" "(DEGDO--save-dn) (done_dialog 3)")
      (action_tile "accept" "(DEGDO--save-dn) (done_dialog 1)")
    )
    ((= page "do_dp")
      (DEGDO--fill-dp)
      (mode_tile "defaults" 0)
      (action_tile "defaults" "(DEGDO--reset-dp)")
      (action_tile "accept" "(DEGDO--save-dp) (done_dialog 1)")
    )
    ((= page "do_blocklar")
      (DEGDO--fill-blocklar)
      (mode_tile "defaults" 0)
      (action_tile "defaults" "(DEGDO--reset-blocklar)")
      (action_tile "accept" "(DEGDO--save-blocklar) (done_dialog 1)")
    )
    ((= page "do_dk")
      (DEGDO--fill-dk)
      (mode_tile "defaults" 0)
      (action_tile "defaults" "(DEGDO--reset-dk)")
      (action_tile "accept" "(DEGDO--save-dk) (done_dialog 1)")
    )
    ((= page "do_dz")
      (DEGDO--fill-dz)
      (mode_tile "defaults" 0)
      (action_tile "defaults" "(DEGDO--reset-dz)")
      (action_tile "accept" "(DEGDO--save-dz) (done_dialog 1)")
    )
    ((= page "do_dc")
      (DEGDO--fill-dc)
      (mode_tile "defaults" 0)
      (action_tile "defaults" "(DEGDO--reset-dc)")
      (action_tile "accept" "(DEGDO--save-dc) (done_dialog 1)")
    )
    ((= page "do_plan")
      (DEGDO--fill-plan)
      (mode_tile "defaults" 0)
      (action_tile "defaults" "(DEGDO--reset-plan)")
      (action_tile "accept" "(DEGDO--save-plan) (done_dialog 1)")
    )
    ((= page "do_kayit")
      (DEGDO--fill-kayit)
      (mode_tile "defaults" 0)
      (action_tile "defaults" "(DEGDO--reset-kayit)")
      (action_tile "kayit_browse" "(DEGDO--browse-kayit)")
      (action_tile "accept" "(DEGDO--save-kayit) (done_dialog 1)")
