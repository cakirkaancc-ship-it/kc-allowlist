(defun DEGP--scope-lighting-layers (/ out ss i ent ed lay baseLayers)
  (setq out nil
        baseLayers (DEGP--lighting-base-layers)
        ss (if (and (boundp '*degDGScopePolySS*) *degDGScopePolySS*)
             *degDGScopePolySS*
             nil))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent (ssname ss i)
              ed  (if ent (entget ent))
              lay (if ed (norm-layer (cdr (assoc 8 ed))) ""))
        (if (and (/= lay "")
                 (or (member lay baseLayers)
                     (DEGP--lighting-name-pattern-p lay)))
          (setq out (DEGP--layer-list-add-unique out lay)))
        (setq i (1+ i)))))
  out
)

(defun DEGP--lighting-line-layers (/ out lay selected)
  (setq out nil)
  (foreach lay (append (DEGP--lighting-base-layers)
                       (DEGP--scope-lighting-layers))
    (if (not (DEGP--lighting-comb-like-layer-p lay))
      (setq out (DEGP--layer-list-add-unique out lay))))
  (setq selected
    (if (and (boundp '*DEGP_DP_LIGHTING_SELECTED_LAYER*)
             *DEGP_DP_LIGHTING_SELECTED_LAYER*)
      (norm-layer *DEGP_DP_LIGHTING_SELECTED_LAYER*)
      ""))
  (if (and (/= selected "")
           (not (DEGP--lighting-comb-like-layer-p selected)))
    (setq out (DEGP--layer-list-add-unique out selected)))
  out
)

(defun DEGP--lighting-comb-layers (/ out lay selected)
  (setq out nil)
  (foreach lay (append (DEGP--lighting-base-layers)
                       (DEGP--scope-lighting-layers))
    (if (DEGP--lighting-comb-like-layer-p lay)
      (setq out (DEGP--layer-list-add-unique out lay))))
  (setq selected
    (if (and (boundp '*DEGP_DP_LIGHTING_SELECTED_LAYER*)
             *DEGP_DP_LIGHTING_SELECTED_LAYER*)
      (norm-layer *DEGP_DP_LIGHTING_SELECTED_LAYER*)
      ""))
  (if (and (/= selected "")
           (DEGP--lighting-comb-like-layer-p selected))
    (setq out (DEGP--layer-list-add-unique out selected)))
  out
)

(defun DEGP--lighting-layer-name-p (lay / u)
  (setq u (norm-layer lay))
  (and (/= u "")
       (or (member u (DEGP--lighting-base-layers))
           (DEGP--lighting-name-pattern-p u)))
