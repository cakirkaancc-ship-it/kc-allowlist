(defun DEGN-DEGA--scope-reset ()
  (setq DEGN-DEGA--SCOPE-ACTIVE nil)
  (setq DEGN-DEGA--SCOPE-POLYS nil)
  (setq DEGN-DEGA--SCOPE-BLOCKS nil)
  (setq DEGN-DEGA--SCOPE-POLY-HANDLES nil)
  (setq DEGN-DEGA--SCOPE-BLOCK-HANDLES nil)
)

(defun DEGN-DEGA--scope-handle (e)
  (if (and e (= (type e) 'ENAME))
    (cdr (assoc 5 (entget e)))
    nil
  )
)

(defun DEGN-DEGA--scope-add-poly (e / h typ)
  (if (and e (= (type e) 'ENAME))
    (progn
      (setq typ (cdr (assoc 0 (entget e))))
      (if (member typ '("LWPOLYLINE" "POLYLINE"))
        (progn
          (setq h (DEGN-DEGA--scope-handle e))
          (if (and h (not (member h DEGN-DEGA--SCOPE-POLY-HANDLES)))
            (progn
              (setq DEGN-DEGA--SCOPE-POLY-HANDLES (cons h DEGN-DEGA--SCOPE-POLY-HANDLES))
              (setq DEGN-DEGA--SCOPE-POLYS (cons e DEGN-DEGA--SCOPE-POLYS))
            )
          )
        )
      )
    )
  )
)

(defun DEGN-DEGA--scope-add-block (e / h typ)
  (if (and e (= (type e) 'ENAME))
    (progn
      (setq typ (cdr (assoc 0 (entget e))))
      (if (= typ "INSERT")
        (progn
          (setq h (DEGN-DEGA--scope-handle e))
          (if (and h (not (member h DEGN-DEGA--SCOPE-BLOCK-HANDLES)))
            (progn
              (setq DEGN-DEGA--SCOPE-BLOCK-HANDLES (cons h DEGN-DEGA--SCOPE-BLOCK-HANDLES))
              (setq DEGN-DEGA--SCOPE-BLOCKS (cons e DEGN-DEGA--SCOPE-BLOCKS))
            )
          )
        )
      )
    )
  )
)

(defun DEGN-DEGA--scope-set-from-ss (ss seed / i e typ)
  (DEGN-DEGA--scope-reset)
  (setq DEGN-DEGA--SCOPE-ACTIVE T)
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq e (ssname ss i))
        (setq typ (cdr (assoc 0 (entget e))))
        (cond
          ((member typ '("LWPOLYLINE" "POLYLINE")) (DEGN-DEGA--scope-add-poly e))
          ((= typ "INSERT") (DEGN-DEGA--scope-add-block e))
        )
        (setq i (1+ i))
      )
    )
  )
  (DEGN-DEGA--scope-add-poly seed)
  (setq DEGN-DEGA--SCOPE-POLYS (reverse DEGN-DEGA--SCOPE-POLYS))
  (setq DEGN-DEGA--SCOPE-BLOCKS (reverse DEGN-DEGA--SCOPE-BLOCKS))
)

(defun DEGN-DEGA--scope-poly-p (e / h)
  (if (not DEGN-DEGA--SCOPE-ACTIVE)
    T
    (progn
      (setq h (DEGN-DEGA--scope-handle e))
      (if (and h (member h DEGN-DEGA--SCOPE-POLY-HANDLES)) T nil)
    )
  )
)

(defun DEGN-DEGA--scope-block-p (e / h)
  (if (not DEGN-DEGA--SCOPE-ACTIVE)
    T
    (progn
      (setq h (DEGN-DEGA--scope-handle e))
      (if (and h (member h DEGN-DEGA--SCOPE-BLOCK-HANDLES)) T nil)
    )
  )
)

(defun DEGN-DEGA--scope-ss-to-list (ss / out i)
  (setq out nil)
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq out (cons (ssname ss i) out))
        (setq i (1+ i))
      )
    )
  )
  (reverse out)
)

