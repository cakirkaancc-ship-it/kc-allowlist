(defun DEGDO--prepare-page (page)
  (DEGDO--bind-tabs page)
  (action_tile "cancel" "(done_dialog 0)")
  (cond
    ((= page "do_dd")
      (DEGDO--fill-dd)
      (mode_tile "defaults" 0)
      (action_tile "defaults" "(DEGDO--reset-dd)")
      (action_tile "accept" "(DEGDO--save-dd) (done_dialog 1)")
    )
    ((= page "do_df")
      (DEGDO--fill-df)
      (mode_tile "defaults" 0)
      (action_tile "defaults" "(DEGDO--reset-df)")
      (action_tile "accept" "(DEGDO--save-df) (done_dialog 1)")
    )
    ((= page "do_dg")
      (DEGDO--fill-dg)
      (mode_tile "defaults" 0)
      (action_tile "defaults" "(DEGDO--reset-dg)")
      (action_tile "accept" "(DEGDO--save-dg) (done_dialog 1)")
    )
    ((= page "do_dgt")
      (DEGDO--fill-dgt)
      (mode_tile "defaults" 0)
      (action_tile "defaults" "(DEGDO--reset-dgt)")
      (action_tile "dgt_reset" "(DEG-DGT-RESET)")
      (action_tile "accept" "(DEGDO--save-dgt) (done_dialog 1)")
    )
    ((= page "do_dt")
