(defun degk--split-commas (s / txt p part out)
  (setq txt (vl-string-trim " \t\r\n" (if s s "")))
  (while (/= txt "")
    (setq p (vl-string-search "," txt))
    (if p
      (progn
        (setq part (substr txt 1 p))
        (setq txt  (substr txt (+ p 2)))
      )
      (progn
        (setq part txt)
        (setq txt  "")
      )
    )
    (setq part (vl-string-trim " \t\r\n" part))
    (if (/= part "") (setq out (append out (list part))))
  )
  out
)

(defun DEG:SPLIT-LAYERS (s / txt p part out)
  (setq txt (vl-string-trim " \t\r\n" (if s s "")))
  (while (/= txt "")
    (setq p (vl-string-search "," txt))
    (if p
      (progn
        (setq part (substr txt 1 p))
        (setq txt  (substr txt (+ p 2)))
      )
      (progn
        (setq part txt)
        (setq txt  "")
      )
    )
    (setq part (norm-layer (vl-string-trim " \t\r\n" part)))
    (if (/= part "") (setq out (append out (list part))))
  )
  out
)

(defun DEG:VAL-LIST (code)
  (DEG:SPLIT-LAYERS (DEG:VAL code))
)

(defun DEG:CFG-LIST (key)
  (DEG:SPLIT-LAYERS (DEG:CFG-GET key))
)

(defun DEG:VALS (codes / out)
  (foreach c codes
    (setq out (append out (DEG:VAL-LIST c)))
  )
  out
)

(defun DEGN-DN--cfg-list-or-codes (key codes / raw)
  (setq raw (vl-string-trim " \t\r\n" (DEG:CFG-GET key)))
  (if (/= raw "")
    (DEG:SPLIT-LAYERS raw)
    (DEG:VALS codes)
  )
)

(defun DEGN-DN--cfg-list-or-mix (key codes extra / raw out)
  (setq raw (vl-string-trim " \t\r\n" (DEG:CFG-GET key)))
  (if (/= raw "")
    (DEG:SPLIT-LAYERS raw)
    (append (DEG:VALS codes) (DEG:SPLIT-LAYERS extra))
  )
)

