             (deg-layerE-ename-p polyE)
             (not (deg-layer0-ename-p polyE))
             (member (cdr (assoc 0 (entget polyE))) '("LWPOLYLINE" "POLYLINE")))
      (if (DEGV:_touch-block-to-poly? blkObj polyE tolTouch)
        (ssadd polyE out)
      )
    )
  )
  out
)

(defun DEGV:_touching-polyline-layers-for-block (blkObj chain tolTouch / ss i e o lyr out)
  (setq out nil)
  (setq ss (DEGV:_touching-polylines-in-chain-for-block blkObj chain tolTouch))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq e (ssname ss i))
        (if e
          (progn
            (setq o (vl-catch-all-apply 'vlax-ename->vla-object (list e)))
            (if (not (vl-catch-all-error-p o))
              (progn
                (setq lyr (vla-get-Layer o))
                (if (and lyr (/= (strcase lyr) "0") (not (member lyr out)))
                  (setq out (cons lyr out))
                )
              )
            )
          )
        )
        (setq i (1+ i))
      )
    )
  )
  (reverse out)
)



(defun DEGV:_nearest-touching-polyline-layer (blkObj chain tolTouch / ip bestE bestD polyE cp d)
  (setq ip (DEGV:_v2l (vla-get-InsertionPoint blkObj)))
  (setq bestE nil)
  (setq bestD 1e99)
  (if ip
    (foreach polyE chain
      (if (and polyE (= (type polyE) 'ENAME)
               (member (cdr (assoc 0 (entget polyE))) '("LWPOLYLINE" "POLYLINE")))
        (progn
          (setq cp (vlax-curve-getclosestpointto polyE ip))
          (if cp
            (progn
              (setq d (DEGV:_dist2d ip cp))
              (if (and (<= d tolTouch) (< d bestD))
                (progn (setq bestD d) (setq bestE polyE))
              )
            )
          )
        )
      )
    )
  )
  (if bestE
    (vla-get-Layer (vlax-ename->vla-object bestE))
    nil
  )
)

(defun DEGV:_doseme_expand_filtered (chain ssBlocksNoDoseme tolTouch / hChain polyE ssDoseme i blkE blkObj
                                         touchedByChain ipd mnw mxw ssCand j candE
                                         newSeeds added pack)

  (setq hChain nil)
  (foreach polyE chain
    (if (and polyE (= (type polyE) 'ENAME)
             (not (deg-layer0-ename-p polyE)))
      (setq hChain (cons (DEGV:_ename-handle polyE) hChain))
    )
  )

  (if DEGN-DEGA--SCOPE-ACTIVE
    (setq ssDoseme (DEGN-DEGA--scope-ss-from-list (DEGN-DEGA--e_dosemeye_blocks)))
    (setq ssDoseme (ssget "X" (list (cons 0 "INSERT") (cons 2 (DEG:VAL 'M1)))))
  )
  (if (not ssDoseme)
    chain
    (progn
      (setq i 0)
      (while (< i (sslength ssDoseme))
        (setq blkE   (ssname ssDoseme i))
        (setq blkObj (vlax-ename->vla-object blkE))

        (setq touchedByChain nil)
        (foreach polyE chain
          (if (and (not touchedByChain)
                   (member (cdr (assoc 0 (entget polyE))) '("LWPOLYLINE" "POLYLINE")))
            (if (DEGV:_touch-block-to-poly? blkObj polyE tolTouch)
              (setq touchedByChain T)
            )
          )
        )

        (if touchedByChain
          (progn
            (setq ipd (DEGV:_v2l (vla-get-InsertionPoint blkObj)))
            (if ipd
              (progn
                (setq mnw (list (- (car ipd) tolTouch) (- (cadr ipd) tolTouch) 0.0))
                (setq mxw (list (+ (car ipd) tolTouch) (+ (cadr ipd) tolTouch) 0.0))

                (setq ssCand (ssget "_C" mnw mxw '((0 . "LWPOLYLINE,POLYLINE"))))
                (if ssCand
                  (progn
                    (setq newSeeds nil)
                    (setq j 0)
                    (while (< j (sslength ssCand))
                      (setq candE (ssname ssCand j))
                      (if (and candE (not (DEGN-DEGA--scope-poly-p candE))) (setq candE nil))

                      (if (and candE (DEGV:_touch-block-to-poly? blkObj candE tolTouch))
                        (progn
                          (if (DEGV:_poly-touches-any-selected-block? candE ssBlocksNoDoseme tolTouch)
                            (setq newSeeds (cons candE newSeeds))
                          )
                        )
                      )

                      (setq j (1+ j))
                    )

                    (foreach candE newSeeds
                      (if (and candE (= (type candE) 'ENAME))
                        (if (not (DEGV:_handle-in-list (DEGV:_ename-handle candE) hChain))
                          (progn
                            (setq added (DEGN-DEGA--chain candE))
            (setq added (DEGV:_filter-chain-data added))
                            (if added
                              (progn
                                (setq pack (DEGV:_append-unique-by-handle hChain chain added))
                                (setq hChain (car pack))
                                (setq chain  (cadr pack))
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )

        (setq i (1+ i))
      )
      chain
    )
  )
)

  



(defun DEGV:RUN ( / pasteCount refEnt refObj refLayer firstStart lastBottom firstSet pastedBlks ent obj plLayer
    refStartPt
    tolTouch areaSS oldErr
    chain signalChain ends blocks blocksND
    ip baseX baseY
    i blkE blkObj lyr
    ms doc cpObj cpE
    tgt disp
    _idx _cnt _dx _x
    ssNew
    blksSorted lyrList prevBottom plObj _lyr _y _leadSign _vlen _sira _ipV _ip _tpt _tx
    dkkItem dkkObj
  )
  (vl-load-com)
  (setq oldErr *error*)
  (defun *error* (msg)
    (DEGN-DEGA--scope-reset)
    (setq *error* oldErr)
    (if (and msg (not (wcmatch (strcase msg) "*BREAK*,*CANCEL*,*QUIT*")))
      (princ (strcat "\nDEGV hata: " msg))
    )
    (princ)
  )


(defun DEGV:_regapp (app /)
  (if (not (tblsearch "APPID" app))
    (regapp app)
  )
  app
)

(defun DEGV:_mark-created (e /)
  (if (and e (= (type e) 'ENAME))
    (progn
      (DEGV:_regapp "DEGV")
      (entmod (append (entget e) (list (list -3 (list "DEGV" (cons 1000 "CREATED"))))))
      (entupd e)
    )
  )
  e
)

(defun DEGV:_is-created (e / x)
  (if (and e (= (type e) 'ENAME))
    (progn
      (setq x (assoc -3 (entget e '("DEGV"))))
      (and x (vl-string-search "CREATED" (vl-prin1-to-string x)))
    )
    nil
  )
)

  (setq tolTouch (DEG:CFG-TOL-NUM-OR 'DN_BLOCK_TOL 1.0))
  (setq *degk-attsync-names* nil)
  (setq firstSet nil firstStart nil lastBottom nil prevBottom nil blksSorted nil lyrList nil)

  (if (and (boundp '*degk-dispatch-sel*) *degk-dispatch-sel*)
    (progn (setq sel *degk-dispatch-sel*) (setq *degk-dispatch-sel* nil))
    (setq sel (entsel "\nDEGV: Polyline seç: ")))
  (if (not sel) (progn (princ) (exit)))
  (setq ent (car sel))
  (setq pickPt (cadr sel))
(setq obj (vlax-ename->vla-object ent))
  (setq refEnt ent)
  (setq refObj obj)
  (setq refLayer (vla-get-Layer refObj))

  (setq refStartPt (DEGV:_get-pl-startpt ent pickPt))

  (setq plLayer (strcase (vla-get-Layer obj)))
  (if (not (DEGK--data-layer-name-p plLayer))
    (progn (princ "\n\nDEGV: Seçilen polyline DATA layerýnda deðil.") (princ) (exit))
  )

  (princ "\nDK DATA: Alan icindeki block ve polyline'lari secin: ")
  (setq areaSS (ssget '((0 . "INSERT,LWPOLYLINE,POLYLINE"))))
  (if (not areaSS)
    (progn
      (DEGN-DEGA--scope-reset)
      (setq *error* oldErr)
      (princ)
      (exit)
    )
  )
  (DEGN-DEGA--scope-set-from-ss areaSS ent)

  (setq signalChain (DEGN-DEGA--chain ent))
  (setq chain (DEGV:_filter-chain-data signalChain))
  (setq signalChain (DEGV:_filter-chain-data-tel-tv signalChain))
  (if (not chain) (progn (princ "\n\nDEGV: Chain bulunamadý.") (princ) (exit)))
  (if (not signalChain) (setq signalChain chain))

  (setq ends   (DEGN-DEGA--chain-ends signalChain DEGN-DEGA--TOL))
  (setq blocks (DEGN-DEGA--blocks-near ends DEGN-DEGA--TOLBLOCK))
  (setq blocks (DEGV:_ss-union blocks (DEGV:_blocks-touching-chain signalChain tolTouch)))
  (setq blocksND (DEGV:_filter-blocks-with-sira-no (DEGV:_filter-out-doseme-blocks blocks)))
  (setq blocksND (DEGV:_ss-unique (DEG:SS-REMOVE-IGNORED-BLOCKS blocksND)))

  (setq chain (DEGV:_doseme_expand_filtered chain blocksND tolTouch))
  (setq signalChain (DEGV:_chain-merge-unique signalChain chain))


  (DEGV:_set-chain-polylines-white chain)
  (setq ends     (DEGN-DEGA--chain-ends signalChain DEGN-DEGA--TOL))
  (setq blocks   (DEGN-DEGA--blocks-near ends DEGN-DEGA--TOLBLOCK))
  (setq blocks (DEGV:_ss-union blocks (DEGV:_blocks-touching-chain signalChain tolTouch)))
  (setq blocksND (DEGV:_filter-blocks-with-sira-no (DEGV:_filter-out-doseme-blocks blocks)))
  (setq blocksND (DEGV:_ss-unique (DEG:SS-REMOVE-IGNORED-BLOCKS blocksND)))

  (if (or (null blocksND) (= (sslength blocksND) 0))
    (progn (princ "\n\nDEGV: (Doseme hariç) block bulunamadý.") (princ) (exit))
  )

  (setq ip (getpoint "\nYapýþtýrma baþlangýç noktasý: "))
  (if (not ip) (progn (princ) (exit)))
  (setq baseX (car ip) baseY (cadr ip))

  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)))
  (setq ms  (vla-get-ModelSpace doc))

  (setq pastedBlks nil)
  (setq ssNew (ssadd))

  (setq blksSorted (DEGV:_sort-blocks-by-sirano-int blocksND))

  (if (degkk--active-p)
    (setq blksSorted (degkk--prepare-items blksSorted))
  )

  (setq pasteCount (length blksSorted))

  (setq i 0)
  (foreach blkE blksSorted
    (setq blkObj (vlax-ename->vla-object blkE))
    (degk--attsync-add blkObj)
    (setq lyrList (DEGV:_touching-polyline-layers-for-block-global blkObj (vl-remove nil (mapcar 'degk--as-ename signalChain)) tolTouch))
    (if (degkk--active-p)
      (foreach dkkItem (degkk--group-items blkObj)
        (setq dkkObj (degkk--as-object dkkItem))
        (if dkkObj
          (setq lyrList
            (append
              lyrList
              (DEGV:_touching-polyline-layers-for-block-global
                dkkObj
                (vl-remove nil (mapcar 'degk--as-ename signalChain))
                tolTouch)))
        )
      )
    )
    (setq lyrList (degkk--unique-strings lyrList))
    (setq lyrList (vl-remove-if-not 'deg-layerE-str-p lyrList))
    (if (or (null lyrList) (= (length lyrList) 0))
      (setq lyrList nil)
    )
    (DEGV:_mark-nonchain-touched-polys-red blkObj signalChain tolTouch)

    (setq cpObj (vla-Copy blkObj))

    (DEGV:_make-scale-positive cpObj)
    (degk--ensure-layer (DEG:VAL 'O2))
    (vla-put-Layer cpObj (DEG:VAL 'O2))


    (setq pastedBlks (cons (DEG:ENAME cpObj) pastedBlks))
    (setq cpE   (vlax-vla-object->ename cpObj))

    (if (= (vla-get-ObjectName cpObj) "AcDbBlockReference")
      (vla-put-Rotation cpObj 0.0)
    )

    (ssadd cpE ssNew)

    (setq tgt (list (+ baseX (* i (DEG:CFG-DK-NUM-OR 'DKX_COPY_SPACING 140.0))) baseY 0.0))
    (if (not firstSet)
      (progn
        (setq firstStart (list (- (car tgt) (DEG:CFG-DK-NUM-OR 'DKX_FIRSTSTART_X 110.0)) (- (cadr tgt) (DEG:CFG-DK-NUM-OR 'DKX_FIRSTSTART_Y 100.0))))
        (setq firstSet T)
      )
    )
    (setq prevBottom lastBottom)
    (setq lastBottom (list (- (car tgt) (DEG:CFG-DK-NUM-OR 'DKX_LASTBOTTOM_X 10.0)) (- (cadr tgt) (DEG:CFG-DK-NUM-OR 'DKX_LASTBOTTOM_Y 100.0))))


    (setq disp
      (mapcar '-
        tgt
        (DEGV:_v2l (vla-get-InsertionPoint blkObj))
      )
    )
    (vla-Move cpObj (vlax-3d-point '(0 0 0)) (vlax-3d-point disp))
    (degk--reset-insert-attrs cpE)
    (if (degkk--active-p)
      (degk--set-att cpObj "ADET" (strcat "x" (itoa (degkk--item-count blkObj))))
    )
    (ssadd cpE ssNew)

    (DEGV:_ensure-layer doc "e_kolon_numarasi")

    (setq _sira "")
    (if (and cpObj (vlax-method-applicable-p cpObj 'GetAttributes))
      (foreach a (vlax-safearray->list (vlax-variant-value (vla-GetAttributes cpObj)))
        (if (= (strcase (vla-get-TagString a)) "SIRA_NO")
          (setq _sira (vla-get-TextString a))
        )
      )
    )
    (if (= _sira "") (setq _sira (DEGV:_attval cpObj "SIRA_NO")))
    (if (= _sira "") (setq _sira "<NO_SIRA_NO>"))

    (setq _ipV (deg-get-inspt cpObj))
    (setq _ip  (cond
                 ((= (type _ipV) 'VARIANT)  (vlax-safearray->list (vlax-variant-value _ipV)))
                 ((= (type _ipV) 'SAFEARRAY)(vlax-safearray->list _ipV))
                 (T (list (car tgt) (cadr tgt) 0.0))
               )
    )
    (setq _tpt (list (car _ip) (+ (cadr _ip) (DEG:CFG-DK-NUM-OR 'DKX_TEXT_OFFSET_Y 70.0)) (if (caddr _ip) (caddr _ip) 0.0)))

    (if (not (degkk--active-p))
      (progn
        (setq _tx  (vla-AddText ms _sira (vlax-3d-point _tpt) (DEG:CFG-DK-NUM-OR 'DKX_TEXT_HEIGHT 25.0)))
        (vla-put-Layer _tx "e_kolon_numarasi")
        (vla-put-Rotation _tx (/ pi 2.0))
        (vla-put-Alignment _tx acAlignmentMiddleLeft)
        (vla-put-TextAlignmentPoint _tx (vlax-3d-point _tpt))
        (ssadd (vlax-vla-object->ename _tx) ssNew)
      )
    )

    (DEGV:_attclear cpObj "SIRA_NO")
(setq _cnt (length lyrList))
(setq _idx 0)
(foreach _lyr lyrList
  (if (or (null _lyr) (= _lyr ""))
    (setq _lyr (if refLayer refLayer (getvar "CLAYER")))
  )
  (DEGV:_ensure-layer doc _lyr)

  (setq _dx 0.0)
  (cond
    ((= _cnt 3)
      (cond
        ((= _idx 1) (setq _dx (- (DEG:CFG-DK-NUM-OR 'DKX_MULTI_DX 10.0))))
        ((= _idx 2) (setq _dx  (DEG:CFG-DK-NUM-OR 'DKX_MULTI_DX 10.0)))
      )
    )
    ((= _cnt 2)
      (if (= _idx 1) (setq _dx (DEG:CFG-DK-NUM-OR 'DKX_MULTI_DX 10.0)))
    )
  )

  (setq _x (+ (car tgt) _dx))
  (setq _y (cadr tgt))
  (setq _leadSign nil)
  (if (> _idx 0)
    (setq _leadSign (if (< _dx 0.0) 1.0 -1.0))
  )
  (if (> _idx 0) (setq _y (- _y (DEG:CFG-DK-NUM-OR 'DKX_MULTI_DROP_Y 10.0))))
  (setq _vlen (if (> _idx 0) (DEG:CFG-DK-NUM-OR 'DKX_VLEN_SECONDARY 90.0) (DEG:CFG-DK-NUM-OR 'DKX_VLEN_MAIN 100.0))) ;; 2. ve 3. polyline 10 birim kýsa
  (setq _hlen (DEG:CFG-DK-NUM-OR 'DKX_HLEN_DEFAULT 150.0))
  (if (and (= i (1- pasteCount))
           (= _cnt 2)
           (= _idx 1)
           (not (DEGV:_layer-is-data-str _lyr refLayer)))
    (setq _hlen (DEG:CFG-DK-NUM-OR 'DKX_HLEN_LAST2 20.0))
  )
  (if (and (= i (1- pasteCount))
           (= _cnt 3))
    (progn
      (if (and (= _idx 1)
               (not (DEGV:_layer-is-data-str _lyr refLayer)))
        (setq _hlen (DEG:CFG-DK-NUM-OR 'DKX_HLEN_LAST3_LEFT 10.0))
      )
      (if (and (= _idx 2)
               (not (DEGV:_layer-is-data-str _lyr refLayer)))
        (setq _hlen (DEG:CFG-DK-NUM-OR 'DKX_HLEN_LAST3_RIGHT 20.0))
      )
    )
  )

  (if (= i (1- pasteCount))
    (cond
      ((and (= _cnt 3) (= _idx 1) (not (DEGV:_layer-is-data-str _lyr refLayer)))
        (setq plObj (DEGV:_add-under-polyline-last-filleted ms _x _y _lyr _vlen _hlen _leadSign))
      )
      ((and (or (= _cnt 2) (= _cnt 3))
            (DEGV:_layer-is-data-str _lyr refLayer))
        (setq plObj (DEGV:_add-under-polyline-last-filleted ms _x _y _lyr _vlen _hlen _leadSign))
      )
      (T
        (setq plObj (DEGV:_add-under-polyline-last ms _x _y _lyr _vlen _hlen _leadSign))
      )
    )
    (setq plObj (DEGV:_add-under-polyline-filleted ms _x _y _lyr _vlen _leadSign))
  )

(ssadd (vlax-vla-object->ename plObj) ssNew)
  (setq _idx (1+ _idx))
)
(setq i (1+ i))
  )

  (if (and firstSet firstStart prevBottom refLayer (deg-layerE-str-p refLayer) (/= (strcase refLayer) "0"))
    (DEGV:_add-2pt-lwpoly ms firstStart prevBottom refLayer)
  )

  (sssetfirst nil ssNew)

  (vl-catch-all-apply 'DEGV:_move-klemens-terminal (list pastedBlks))
  (degk--attsync-run)
  (DEGN-DEGA--scope-reset)
  (setq *error* oldErr)
  (princ)
)

(princ)


