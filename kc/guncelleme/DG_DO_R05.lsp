(defun deg-block-count-string (blocks / namesAssoc blkObj blkName blkNameU old res
                                      adetRaw adetUse)
  (setq namesAssoc '())
  (foreach blkObj blocks
    (setq blkName  (deg-block-name-raw blkObj))
    (setq blkNameU (strcase blkName))

    (setq adetRaw (get-adet-from-block blkObj))
    (setq adetUse (if (> adetRaw 0) adetRaw 1))

    (if (and
          (not (wcmatch blkNameU (DEG:VAL 'J4)))
          (not (deg-member blkNameU
                     (DEG:VALS '(P1 I2 M1 J1 J2 J3)))))
      (progn
        (setq old (assoc blkName namesAssoc))
        (if old
          (setq namesAssoc
                (subst (cons blkName (+ adetUse (cdr old))) old namesAssoc))
          (setq namesAssoc (cons (cons blkName adetUse) namesAssoc))
        )
      )
    )
  )

  (setq namesAssoc (reverse namesAssoc))
  (setq res "")
  (foreach p namesAssoc
    (setq res (strcat res (itoa (cdr p)) "x" (car p) ",")))
  (if (> (strlen res) 0)
    (substr res 1 (1- (strlen res)))   ;; sondaki virgülü sil
    ""
  )
)



(defun deg-build-knx-chain (testMode blkRefObj ss blkSS
                          / knxLayers chainLayer
                            tolKnxStart tolKnxBlock tolKnxEnd
                            knxList startList dataRows
                            i ent obj layerName
                            queue curPline visitedPlineHandles visitedBlockHandles
                            chainPlines chainBlocks
                            blkEnt blkObj blkName hP hB
                            totalLen len toplam
                            blockNamesStr
                            symAssoc sembolList vals sym n old
                            linyeList ln linyeStr)

  (setq knxLayers  (list (DEG:VAL 'A1) (DEG:VAL 'A7)))
  (setq tolKnxStart (DEG:CFG-TOL-NUM-OR 'DG_KNX_START_TOL 50.0))   ;; referans BLOÐU – KNX polyline baþlangýç toleransý
  (setq tolKnxBlock (DEG:CFG-TOL-NUM-OR 'DG_KNX_BLOCK_TOL 30.0))   ;; KNX dalý üüzerindeki blok toleransý
  (setq tolKnxEnd   (DEG:CFG-TOL-NUM-OR 'DG_KNX_END_TOL 30.0))   ;; KNX polylineler arasýý baðlantý toleransý
  (setq dataRows   '())

  (if ss
    (progn
      (setq knxList '())
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent (ssname ss i)
              obj (vlax-ename->vla-object ent)
              layerName (norm-layer (vlax-get obj 'Layer)))
        (if (member layerName knxLayers)
          (setq knxList (cons obj knxList))
        )
        (setq i (1+ i))
      )
    )
  )

  (if (and blkRefObj knxList)
    (progn
      (setq startList '())
      (foreach obj knxList
        (if (poly-touch-block? obj blkRefObj tolKnxStart)
          (setq startList (cons obj startList))
        )
      )

      (if startList
        (progn
          (setq visitedPlineHandles '())

          (foreach obj startList
            (setq hP (vlax-get obj 'Handle))
            (if (not (handle-in-list? hP visitedPlineHandles))
              (progn
                (setq queue               (list obj))
                (setq chainPlines         '())
                (setq chainBlocks         '())
                (setq chainLayer          (norm-layer (vlax-get obj 'Layer)))
                (setq visitedPlineHandles (cons hP visitedPlineHandles))
                (setq visitedBlockHandles '())

                (while queue
                  (setq curPline (car queue)
                        queue    (cdr queue))
                  (setq chainPlines (cons curPline chainPlines))

                  (if blkSS
                    (progn
                      (setq i 0)
                      (while (< i (sslength blkSS))
                        (setq blkEnt (ssname blkSS i)
                              blkObj (vlax-ename->vla-object blkEnt))
                        (setq blkName (deg-block-name blkObj))
                        (setq hB      (vlax-get blkObj 'Handle))

                        (setq tolLocal
                              (deg-block-tol
                                (if (= blkName (DEG:VAL 'P1)) (DEG:CFG-TOL-NUM-OR 'DG_P1_TOL 3.0) tolKnxBlock)
                                blkObj))

                        (if (and
                              (poly-touch-block? curPline blkObj tolLocal)
                              (not (= blkName (DEG:VAL 'A6)))
                              (not (handle-in-list? hB visitedBlockHandles)))
                          (progn
                            (setq visitedBlockHandles (cons hB visitedBlockHandles))
                            (setq chainBlocks         (cons blkObj chainBlocks))
                            (if testMode
                              (deg-make-circle (deg-get-inspt blkObj) tolLocal)
                            )

                            (foreach other knxList
                              (setq hP (vlax-get other 'Handle))
                              (if (and
                                    (not (handle-in-list? hP visitedPlineHandles))
                                    (poly-touch-block? other blkObj tolLocal))
                                (progn
                                  (setq visitedPlineHandles (cons hP visitedPlineHandles))
                                  (setq queue (cons other queue))
                                )
                              )
                            )
                          )
                        )
                        (setq i (1+ i))
                      )
                    )
                  )

                  (foreach other knxList
                    (setq hP (vlax-get other 'Handle))
                    (if (and
                          (not (handle-in-list? hP visitedPlineHandles))
                          (connection-point curPline other tolKnxEnd))
                      (progn
                        (setq visitedPlineHandles (cons hP visitedPlineHandles))
                        (setq queue (cons other queue))
                      )
                    )
                  )
                ) ;; while queue

                (if chainPlines
                  (progn
                    (if testMode (color-red chainPlines))

                    (setq totalLen 0.0)
                    (foreach p chainPlines
                      (setq totalLen (+ totalLen (vla-get-length p)))
                    )
                    (setq len    totalLen)
                    (setq toplam totalLen)

                    (setq dataRows
                          (append (reverse (deg-build-data-rows-by-linye chainBlocks chainLayer 0.0 len 0.0 toplam nil))
                                  dataRows))
                  )
                )
              )
            )
          )
        )
      )
    )
  )

  (reverse dataRows)
)

