(defun DEG:READ-ALL-LINES (fn / f line out)
  (if (and fn (setq f (open fn "r")))
    (progn
      (while (setq line (read-line f))
        (setq out (append out (list line)))
      )
      (close f)
      out
    )
  )
)

(defun DEG:WRITE-ALL-LINES (fn lines / f ok)
  (if (and fn (setq f (open fn "w")))
    (progn
      (foreach line lines
        (write-line line f)
      )
      (close f)
      (setq ok T)
    )
  )
  ok
)

(defun DEG:FILE-MATCHES-LINES-P (fn lines / current)
  (and fn
       (findfile fn)
       (setq current (DEG:READ-ALL-LINES fn))
       (equal current lines))
)

(defun DEG:SAFE-DELETE-FILE (fn / result)
  (if (and fn (findfile fn))
    (progn
      (setq result (vl-catch-all-apply 'vl-file-delete (list fn)))
      (and (not (vl-catch-all-error-p result)) (not (findfile fn))))
    T)
)

(defun DEG:WRITE-SETTINGS-FILE (fn lines / tmp bak hadOriginal backupReady result ok)
  (setq tmp (strcat fn ".tmp." (itoa (getvar "MILLISECS")))
        bak (strcat fn ".bak")
        hadOriginal (if (findfile fn) T nil))
  (DEG:SAFE-DELETE-FILE tmp)
  (if (DEG:WRITE-ALL-LINES tmp lines)
    (progn
      (DEG:SAFE-DELETE-FILE bak)
      (if hadOriginal
        (progn
          (setq result (vl-catch-all-apply 'vl-file-copy (list fn bak)))
          (setq backupReady
            (and (not (vl-catch-all-error-p result)) (findfile bak))))
        (setq backupReady T))
      ;; AutoCAD ve GstarCAD vl-file-rename icin farkli donus degerleri
      ;; verebildiginden basariyi dosyanin gercek icerigiyle dogrula.
      (if (or (not hadOriginal) backupReady)
        (progn
          (DEG:SAFE-DELETE-FILE fn)
          (setq result (vl-catch-all-apply 'vl-file-rename (list tmp fn)))
          (setq ok (DEG:FILE-MATCHES-LINES-P fn lines))))
      (if (not ok)
        (progn
          (DEG:SAFE-DELETE-FILE fn)
          (setq result (vl-catch-all-apply 'vl-file-copy (list tmp fn)))
          (setq ok (DEG:FILE-MATCHES-LINES-P fn lines))))
      (if (not ok)
        (progn
          (setq result (vl-catch-all-apply 'DEG:WRITE-ALL-LINES (list fn lines)))
          (setq ok (and (not (vl-catch-all-error-p result))
                        (DEG:FILE-MATCHES-LINES-P fn lines)))))
      (if (and (not ok) backupReady (findfile bak))
        (progn
          (DEG:SAFE-DELETE-FILE fn)
          (vl-catch-all-apply 'vl-file-copy (list bak fn))))
      (DEG:SAFE-DELETE-FILE tmp)))
  ok
)

(defun DEG:WRITE-PERSISTED-SETTINGS (/ fn lines ok)
  (setq fn (DEG:SETTINGS-FILE)
        lines
          (list
            ";; DEG DO settings - generated automatically."
            (strcat "(setq *DEG_PERSIST_CODE_OVERRIDES* "
                    (vl-prin1-to-string *DEG_CODE_OVERRIDES*) ")")
            (strcat "(setq *DEG_PERSIST_CFG_OVERRIDES* "
                    (vl-prin1-to-string *DEG_CFG_OVERRIDES*) ")")))
  (if fn (setq ok (DEG:WRITE-SETTINGS-FILE fn lines)))
  ok
)

(defun DEG:UPDATE-SELF-SETTINGS (/ fn tmp lines out line skip found ok)
  (setq fn (DEG:SELF-FILE))
  (setq lines (DEG:READ-ALL-LINES fn))
  (if lines
    (progn
      (foreach line lines
        (cond
          ((wcmatch line "*DEG_DO_PERSIST_BEGIN*")
           (setq skip T found T)
           (setq out
             (append out
               (list
                 line
                 (strcat "(setq *DEG_PERSIST_CODE_OVERRIDES* " (vl-prin1-to-string *DEG_CODE_OVERRIDES*) ")")
                 (strcat "(setq *DEG_PERSIST_CFG_OVERRIDES* " (vl-prin1-to-string *DEG_CFG_OVERRIDES*) ")")
               )
             )
           )
          )
          ((and skip (wcmatch line "*DEG_DO_PERSIST_END*"))
           (setq skip nil)
           (setq out (append out (list line)))
          )
          ((not skip)
           (setq out (append out (list line)))
          )
        )
      )
      (if (not found)
        (setq out
          (append out
            (list
              ";; DEG_DO_PERSIST_BEGIN"
              (strcat "(setq *DEG_PERSIST_CODE_OVERRIDES* " (vl-prin1-to-string *DEG_CODE_OVERRIDES*) ")")
              (strcat "(setq *DEG_PERSIST_CFG_OVERRIDES* " (vl-prin1-to-string *DEG_CFG_OVERRIDES*) ")")
              ";; DEG_DO_PERSIST_END"
            )
          )
        )
      )
      (setq tmp (strcat fn ".tmp"))
      (if (and tmp (DEG:WRITE-ALL-LINES tmp out))
        (progn
          (if (findfile fn) (vl-file-delete fn))
          (setq ok (vl-file-copy tmp fn))
          (if (findfile tmp) (vl-file-delete tmp))
          ok
        )
      )
    )
  )
)

(defun DEG:SAVE-SETTINGS (/ ok codeText cfgText codeResult cfgResult envOk)
  (DEG:SANITIZE-SETTINGS)
  (setq ok       (DEG:WRITE-PERSISTED-SETTINGS)
        codeText (vl-prin1-to-string *DEG_CODE_OVERRIDES*)
        cfgText  (vl-prin1-to-string *DEG_CFG_OVERRIDES*)
        codeResult (vl-catch-all-apply 'setenv (list "DEG_DO_CODE_OVERRIDES" codeText))
        cfgResult  (vl-catch-all-apply 'setenv (list "DEG_DO_CFG_OVERRIDES" cfgText))
        envOk
          (and (not (vl-catch-all-error-p codeResult))
               (not (vl-catch-all-error-p cfgResult))
               (= (if (getenv "DEG_DO_CODE_OVERRIDES") (getenv "DEG_DO_CODE_OVERRIDES") "") codeText)
               (= (if (getenv "DEG_DO_CFG_OVERRIDES") (getenv "DEG_DO_CFG_OVERRIDES") "") cfgText)))
  (vl-catch-all-apply 'setenv
    (list "DEG_DO_SETTINGS_FALLBACK" (if ok "0" "1")))
  (or ok envOk)
)

