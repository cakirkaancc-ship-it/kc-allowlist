(defun DEGV:_nearest-vertex (plE pickPt / ed v best bestd p d)
  (setq best nil bestd 1e99)
  (setq ed (entget plE))
  (foreach v ed
    (if (= (car v) 10)
      (progn
        (setq p (list (car (cdr v)) (cadr (cdr v)) 0.0))
        (setq d (distance p pickPt))
        (if (< d bestd) (setq bestd d best p))
      )
    )
  )
  (if best best pickPt)
)

(defun DEGV:_get-pl-startpt (plE pickPt / sp ep vPick totalLen pDist)
  (setq sp (vlax-curve-getStartPoint plE))
  (setq ep (vlax-curve-getEndPoint   plE))
  (setq vPick (DEGV:_nearest-vertex plE pickPt))
  (setq totalLen (vlax-curve-getDistAtParam plE (vlax-curve-getEndParam plE)))
  (setq pDist (deg-safe-dist-at-point plE (deg-safe-closest-point plE vPick)))
  (if (<= pDist (- totalLen pDist))
    sp
    ep
  )
)

(defun DEGV:_v2l (v / r)
