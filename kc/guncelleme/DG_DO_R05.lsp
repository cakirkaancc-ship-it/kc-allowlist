(defun DEGN-DEGA--pick-start-end (pl pickPt tol / o sp ep)
  (setq o  (DEGN-DEGA--vla pl))
  (setq sp (vlax-curve-getStartPoint o))
  (setq ep (vlax-curve-getEndPoint   o))
  (cond
    ((DEGN-DEGA--eq-tol pickPt sp tol) sp)
    ((DEGN-DEGA--eq-tol pickPt ep tol) ep)
    (T (if (< (distance pickPt sp) (distance pickPt ep)) sp ep))
  )
)


