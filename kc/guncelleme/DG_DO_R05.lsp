(defun DEGDO--fill-dt (/ i codeKey layerKey)
  (setq i 1)
  (while (<= i 7)
    (setq codeKey  (DT--type-key i "CODE")
          layerKey (DT--type-key i "LAYER"))
    (set_tile (strcat "dt_type" (itoa i) "_code") (DEG:CFG-GET codeKey))
    (set_tile (strcat "dt_type" (itoa i) "_layer") (DEG:CFG-GET layerKey))
    (DEGDO--fill-dt-color (strcat "dt_type" (itoa i) "_color") i)
    (DEGDO--fill-dt-hatch-pattern (strcat "dt_type" (itoa i) "_hatch_pattern") i)
    (DEGDO--fill-dt-hatch-color (strcat "dt_type" (itoa i) "_hatch_color") i)
    (set_tile (strcat "dt_type" (itoa i) "_hatch_scale") (DEG:NUM->STR (DT--type-hatch-scale i)))
    (setq i (1+ i))
  )
)
(defun DEGDO--save-dt (/ i code layer colorKey hatchPatternKey hatchColorKey hatchScaleKey hatchPattern hatchScale)
  (setq i 1)
  (while (<= i 7)
    (setq code
      (strcase
        (DEGDO--trim (get_tile (strcat "dt_type" (itoa i) "_code")))
      )
    )
    (setq layer
      (DEGDO--trim (get_tile (strcat "dt_type" (itoa i) "_layer")))
    )
    (setq hatchPattern
      (DEGDO--dt-hatch-pattern-value
        (strcat "dt_type" (itoa i) "_hatch_pattern")))
    (setq hatchScale
      (DEGDO--trim (get_tile (strcat "dt_type" (itoa i) "_hatch_scale")))
    )
    (setq colorKey        (DT--type-key i "COLOR")
          hatchPatternKey (DT--type-key i "HATCH_PATTERN")
          hatchColorKey   (DT--type-key i "HATCH_COLOR")
          hatchScaleKey   (DT--type-key i "HATCH_SCALE"))
    (DEG:CFG-SET (DT--type-key i "CODE") code)
    (DEG:CFG-SET (DT--type-key i "LAYER") layer)
    (DEG:CFG-SET colorKey
      (DEGDO--dgt-color-value
        (strcat "dt_type" (itoa i) "_color")
        (DT--type-color-default i)
      )
    )
    (DEG:CFG-SET hatchPatternKey hatchPattern)
    (DEG:CFG-SET hatchColorKey
      (DEGDO--dgt-color-value
        (strcat "dt_type" (itoa i) "_hatch_color")
        (DT--type-hatch-color-default i)
      )
    )
    (DEG:CFG-SET hatchScaleKey hatchScale)
    (if (= i 1) (DEG:CFG-SET 'DT_KA_COLOR (DEG:CFG-GET colorKey)))
    (if (= i 2) (DEG:CFG-SET 'DT_ZA_COLOR (DEG:CFG-GET colorKey)))
    (setq i (1+ i))
  )
  (DEG:SAVE-SETTINGS)
  (DEGDO--apply-dt-layer-colors)
  (DT--remember-mode (DT--last-mode))
)
(defun DEGDO--reset-dt (/ i)
  (setq i 1)
  (while (<= i 7)
    (DEG:CFG-SET (DT--type-key i "CODE") "")
    (DEG:CFG-SET (DT--type-key i "LAYER") "")
    (DEG:CFG-SET (DT--type-key i "COLOR") "")
    (DEG:CFG-SET (DT--type-key i "HATCH_PATTERN") "")
    (DEG:CFG-SET (DT--type-key i "HATCH_COLOR") "")
    (DEG:CFG-SET (DT--type-key i "HATCH_SCALE") "")
    (setq i (1+ i))
  )
  (DEGDO--fill-dt)
  (DEGDO--apply-dt-layer-colors)
)
