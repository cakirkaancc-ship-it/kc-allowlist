(defun DEGN-DEGA--blconn-exists-p (blkPt pl / ok)
  (setq ok nil)
  (foreach x DEGN-DEGA--BLCONNS
    (if (and (not ok)
             (= (car x) "TOUCH")
             (= (caddr x) pl)
             (DEGN-DEGA--eq-tol (cadr x) blkPt 1e-6))
      (setq ok T)
