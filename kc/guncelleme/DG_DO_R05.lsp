(defun KC:UpdateTargetDir (/ self dir base ext script)
  (setq self (DEG:SELF-FILE))
  (if self
    (setq dir  (vl-filename-directory self)
          base (strcase (vl-filename-base self))
          ext  (strcase (if (vl-filename-extension self) (vl-filename-extension self) ""))))
  (if (not (and dir
                (= base "DG_DO_R05")
                (= ext ".VLX")
                (KC:UpdateDirValidP dir)))
    (progn
      (setq script (DEGDO--win-script-path)
            dir    (if script (vl-filename-directory script) nil))))
  (if (KC:UpdateDirValidP dir) dir nil)
)

(defun KC:CheckForUpdates (showProgress / script target state resultPath logPath cmd runResult result file pid)
  (setq script (DEGDO--win-script-path)
        target (KC:UpdateTargetDir))
  (if (and script target)
    (progn
      (setq state
        (DEG:RUNTIME-FILE
          (strcat "kc_update_" (KC:ProcessToken) ".txt"))
        resultPath (strcat state ".result")
        logPath    (strcat state ".log"))
      (foreach file (list state resultPath logPath)
        (if (KC:FileExists file) (vl-file-delete file)))
      (setq pid (vl-catch-all-apply 'getvar (list "PROCESSID")))
      (if (or (vl-catch-all-error-p pid) (not (numberp pid)))
        (setq pid 0)
        (setq pid (fix pid)))
      (setq cmd
        (strcat
          "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \""
          script
          "\" -Mode Update -StatePath \""
          state
          "\" -UpdateApiUrl \""
          *KC_UPDATE_COMMIT_API_URL*
          "\" -UpdateContentsApiUrl \""
          *KC_UPDATE_CONTENTS_API_URL*
          "\" -UpdateRawBaseUrl \""
          *KC_UPDATE_RAW_BASE_URL*
          "\" -TargetDirectory \""
          target
          "\" -UpdateStatePath \""
          (KC:UpdateStateFile)
          "\" -HostPid "
          (itoa pid)
          (if showProgress " -ShowProgress" "")))
      (setq runResult (vl-catch-all-apply 'KC:RunHidden (list cmd T)))
      (if (and (not (vl-catch-all-error-p runResult))
               (KC:FileExists resultPath))
        (setq result (KC:Trim (KC:ReadFirstLine resultPath)))
        (setq result
          (if (vl-catch-all-error-p runResult)
            "FAILED|POWERSHELL_START"
            "FAILED|RESULT_MISSING")))
      (foreach file (list state resultPath)
        (if (KC:FileExists file) (vl-file-delete file)))
      (if (and (KC:FileExists logPath)
               (not (wcmatch (strcase result) "FAILED|*")))
        (vl-file-delete logPath))
      (if (and result (wcmatch (strcase result) "UPDATED|*"))
        (princ "\n[KC] Yeni DEG surumu kuruldu. CAD programini yeniden baslatin.\n"))
      result)
    (if script
      "FAILED|TARGET_NOT_FOUND"
      "FAILED|UI_SCRIPT_NOT_FOUND"))
)

(defun KC:SessionLicenseRead (/ data)
  (setq data
    (vl-catch-all-apply
      'vl-bb-ref
      (list 'KC_LICENSE_SESSION_DATA)
    )
  )
  (if (or (vl-catch-all-error-p data)
          (/= (type data) 'LIST)
          (< (length data) 4)
          (/= (car data) *KC_LICENSE_SESSION_VERSION*)
          (not (nth 1 data))
          (not (numberp (nth 3 data)))
          (> (- (getvar "DATE") (nth 3 data)) *KC_ALLOW_CACHE_DAYS*))
    nil
    data
  )
)

(defun KC:SessionLicenseWrite (ok code / result)
  (setq result
    (vl-catch-all-apply
      'vl-bb-set
      (list
        'KC_LICENSE_SESSION_DATA
        (list
          *KC_LICENSE_SESSION_VERSION*
          (if ok T nil)
          code
          (getvar "DATE")
        )
      )
    )
  )
  (not (vl-catch-all-error-p result))
)

(defun KC:LicenseCheckFreshP ()
  (and *KC_LICENSE_CHECKED*
       *KC_LICENSE_OK*
       (numberp *KC_LICENSE_LAST_CHECK*)
       (<= (- (getvar "DATE") *KC_LICENSE_LAST_CHECK*) *KC_ALLOW_CACHE_DAYS*))
)

(defun KC:InitLicense (/ session code result ok)
  (if (not (KC:LicenseCheckFreshP))
    (progn
      (setq *KC_LICENSE_OK* nil
            *KC_LICENSE_CHECKED* nil
            *KC_LICENSE_LAST_CHECK* nil)
      (setq session (KC:SessionLicenseRead))
      (if session
        (progn
          (setq *KC_LICENSE_OK* T
                *KC_LICENSE_CHECKED* T
                *KC_LICENSE_LAST_CHECK* (nth 3 session)))
        (progn
          (KC:DeleteLegacyLicenseCache)
          (setq code   (KC:GetDeviceCode)
                result (if code (KC:CheckDeviceLicense code) nil)
                ok     (and result (wcmatch (strcase result) "OK|*")))

          ;; PowerShell once Windows-acilisina bagli bypass kaydini, sonra 24
          ;; saatlik DPAPI grant'i denetler; gerekirse yalniz bu cihazin .lic
          ;; dosyasini GitHub'dan sorgular.
          (if ok
            (progn
              (setq *KC_LICENSE_OK* T
                    *KC_LICENSE_CHECKED* T
                    *KC_LICENSE_LAST_CHECK* (getvar "DATE"))
              (KC:SessionLicenseWrite T code))
            (progn
              (setq *KC_LICENSE_OK* nil
                    *KC_LICENSE_CHECKED* nil
                    *KC_LICENSE_LAST_CHECK* nil)
              (if (KC:ShowDeviceCodeDialog code)
                (progn
                  (setq *KC_LICENSE_OK* T
                        *KC_LICENSE_CHECKED* T
                        *KC_LICENSE_LAST_CHECK* (getvar "DATE"))
                  (KC:SessionLicenseWrite T code))))))
      )
    )
  )
  *KC_LICENSE_OK*
)



