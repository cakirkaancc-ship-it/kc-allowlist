(defun DT--repair-existing-fitting-line-layers
  (/ ss i ins ed base mode name done count
     *DT_ACTIVE_MODE* *DT_ACTIVE_LAYER*)
  (setq ss (ssget "_X" '((0 . "INSERT") (-3 ("DT_FITTING"))))
        i 0
        count 0)
  (if ss
    (while (< i (sslength ss))
      (setq ins  (ssname ss i)
            ed   (entget ins)
            base (DT--base-layer-name (cdr (assoc 8 ed)))
            mode (DT--mode-from-layer base)
            name (cdr (assoc 2 ed)))
      (if (and name (not (member (strcase name) done)))
