)


(defun DEGV:_sirano-int-from-ename (blkE / e d tag val n)
  (setq tag "SIRA_NO")
  (setq val "")
  (if blkE
    (progn
      (setq e (entnext blkE))
      (while (and e (setq d (entget e)) (not (= (cdr (assoc 0 d)) "SEQEND")))
        (if (= (cdr (assoc 0 d)) "ATTRIB")
          (if (= (strcase (cdr (assoc 2 d))) tag)
            (setq val (cdr (assoc 1 d)))
          )
        )
        (setq e (entnext e))
      )
    )
  )
  (setq n (degk--sira-min-number val))
  (if n n 2147483647)
)

(defun DEGV:_sort-blocks-by-sirano-int (ss / lst i e)
  (setq lst nil)
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq e (ssname ss i))
        (setq lst (cons (list (DEGV:_sirano-int-from-ename e) e) lst))
        (setq i (1+ i))
      )
    )
  )
  (setq lst (vl-sort lst '(lambda (a b) (< (car a) (car b)))))
  (mapcar 'cadr lst)
)

