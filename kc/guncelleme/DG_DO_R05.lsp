(defun g408_fix_side_order (side aug0 / s0 se)
  (if (and side aug0 (> (length side) 1))
    (progn
      (setq s0 (car side))
      (setq se (g365_last side))
      (if (< (distance (g406_to3 se) (g406_to3 aug0))
             (distance (g406_to3 s0) (g406_to3 aug0)))
        (g365_rev side)
        side
      )
    )
    side
  )
)

(defun g409_p2 (p)
