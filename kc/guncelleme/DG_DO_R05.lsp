(defun DT--cross2 (u v)
  (- (* (car u) (cadr v)) (* (cadr u) (car v)))
)

(defun DT--vec-angle (u)
  (atan (cadr u) (car u))
)

(defun DT--mirror-for (u v)
  (if (< (DT--cross2 u v) 0.0) -1.0 1.0)
)

(defun DT--local-pts-xform (pts base ang yscale / out p dx dy ca sa x y)
  (setq ca (cos ang)
        sa (sin ang))
  (foreach p pts
    (setq dx (- (car p) (car base))
          dy (- (cadr p) (cadr base))
          x  (+ (* dx ca) (* dy sa))
          y  (+ (* (- dx) sa) (* dy ca)))
    (if (< yscale 0.0) (setq y (- y)))
    (setq out (append out (list (list x y 0.0))))
  )
  out
)

(defun DT--local-bulges-xform (bulges yscale / out b)
  (if bulges
    (progn
      (foreach b bulges
        (setq out
          (append out
            (list
              (if (< yscale 0.0) (- b) b)
            )
          )
        )
      )
      out
    )
  )
)
(defun DT--block-poly-entmake-at (pts closedp bulges elevation / data p b i)
  (if (and pts (> (length pts) 1))
    (progn
      (setq data
        (list
          (cons 0 "LWPOLYLINE")
          (cons 100 "AcDbEntity")
          (cons 8 (DT--layer-linework))
          (cons 370 30)
          (cons 100 "AcDbPolyline")
          (cons 90 (length pts))
          (cons 70 (if closedp 1 0))
          (cons 38 (if (numberp elevation) elevation 0.0))
          (cons 43 0.0)
        )
      )
      (setq i 0)
      (foreach p pts
        (setq data (append data (list (cons 10 (list (car p) (cadr p))))))
        (setq b (if bulges (nth i bulges) 0.0))
        (if (and b (> (abs b) 1e-10))
          (setq data (append data (list (cons 42 b))))
        )
        (setq i (1+ i))
      )
      (entmake data)
    )
  )
)

(defun DT--block-poly-entmake (pts closedp bulges)
  (DT--block-poly-entmake-at pts closedp bulges 0.0)
)

