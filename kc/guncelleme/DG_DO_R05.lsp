(defun DEGN-DEGA--ptparam (pl pt / o p3 cp par d sp ep spPar epPar)
  (setq o (DEGN-DEGA--vla pl))
  (setq p3 (cond
             ((and (listp pt) (= (length pt) 3)) pt)
             ((and (listp pt) (= (length pt) 2)) (list (car pt) (cadr pt) 0.0))
             (T (list 0.0 0.0 0.0))))
  (setq cp (deg-safe-closest-point o p3))
  (if cp
    (setq par
      (vl-catch-all-apply
        'vlax-curve-getParamAtPoint (list o cp))))
  (if (not (numberp par))
    (progn
      (if cp
        (setq d
          (vl-catch-all-apply
            'vlax-curve-getDistAtPoint (list o cp))))
      (if (numberp d)
        (setq par
          (vl-catch-all-apply
            'vlax-curve-getParamAtDist (list o d))))
    )
  )
  (if (not (numberp par))
    (progn
      (setq sp
              (vl-catch-all-apply
                'vlax-curve-getStartPoint (list o))
            ep
              (vl-catch-all-apply
                'vlax-curve-getEndPoint (list o))
            spPar
              (vl-catch-all-apply
                'vlax-curve-getStartParam (list o))
            epPar
              (vl-catch-all-apply
                'vlax-curve-getEndParam (list o)))
      (if (and (listp sp) (listp ep)
               (numberp spPar) (numberp epPar))
        (setq par
          (if (<= (distance p3 sp) (distance p3 ep))
            spPar epPar))
      )
    )
  )
  (if (numberp par) par nil)
)
(defun DEGN-DEGA--distAtParam (pl par / o d p)
  (setq o (DEGN-DEGA--vla pl))
  (if (not (numberp par)) (setq par 0.0))
  (setq d (vl-catch-all-apply 'vlax-curve-getDistAtParam (list o par)))
  (if (not (numberp d))
    (progn
      (setq p
        (vl-catch-all-apply
          'vlax-curve-getPointAtParam (list o par)))
      (if (not (vl-catch-all-error-p p))
        (setq d
          (vl-catch-all-apply
            'vlax-curve-getDistAtPoint (list o p))))
    )
  )
  (if (numberp d) d 0.0)
)

(defun DEGN-DN--pick-on-polyline (pl pickPt / o p3 wcsPt cp)
  ;; ENTSEL noktasi UCS'dedir. Once WCS'ye cevir, sonra secilen
  ;; polyline uzerine izduser; vertexlere kus ucusu karsilastirma yapma.
  (setq o (DEGN-DEGA--vla pl)
        p3
          (cond
            ((and (listp pickPt) (= (length pickPt) 3)) pickPt)
            ((and (listp pickPt) (= (length pickPt) 2))
              (list (car pickPt) (cadr pickPt) 0.0))
            (T '(0.0 0.0 0.0)))
        wcsPt (vl-catch-all-apply 'trans (list p3 1 0)))
  (if (vl-catch-all-error-p wcsPt)
    (setq wcsPt p3)
  )
  (setq cp
    (if o
      (vl-catch-all-apply 'deg-safe-closest-point (list o wcsPt))))
  (if (or (null cp) (vl-catch-all-error-p cp))
    wcsPt
    (deg-pt3 cp)
  )
)

