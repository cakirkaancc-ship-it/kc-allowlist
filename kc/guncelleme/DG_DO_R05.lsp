(defun DG_ORIG
  ( / blkEnt blkRefObj
     sortedList row
     continue
     txtEnt txtObj pageName s
     tmp
     filepath csvfile line anyBlkFound
     maxBlkPairs maxSymPairs flatBlk flatSym blkFields symFields
     scopeSel scopePolySS scopeBlkSS
  )

  (deg-reset-session)
  (deg-clear-deg-done-xdata)
  (vl-load-com)
  (setq continue T)

  (while continue
    (setq *degDGScopePolySS* nil)
    (setq *degDGScopeBlkSS*  nil)

    (setq blkEnt (entsel "\nReferans polyline'ý seçin: "))
    (if (not blkEnt)
      (progn
        (setq continue nil)
        (princ "\n\nDEG bitti (referans polyline seçilmedi).")
      )
      (progn
        (setq tmp (car blkEnt))   ;; ref polyline ename
        (setq s   (cadr blkEnt))  ;; pick point

        (if (not (and tmp
                      (wcmatch (cdr (assoc 0 (entget tmp))) "LWPOLYLINE,POLYLINE")
                      (not (DEGQ:_cctv-layer-name-p (cdr (assoc 8 (entget tmp)))))))
          (progn
            (setq continue nil)
            (if (and tmp
                     (wcmatch (cdr (assoc 0 (entget tmp))) "LWPOLYLINE,POLYLINE")
                     (DEGQ:_cctv-layer-name-p (cdr (assoc 8 (entget tmp)))))
              (princ "\n\nDG: KOMBINE raporu DP komutuna tasindi. DP komutu ile tek KOMBINE polyline secin.")
              (princ "\n\nLutfen gecerli bir polyline secin.")
            )
          )
          (progn
            (princ "\nSonra alan seçin (polyline ve blocklar): ")
            (setq scopeSel (ssget '((0 . "LWPOLYLINE,POLYLINE,INSERT"))))

            (if (not scopeSel)
              (progn
                (setq continue nil)
                (princ "\n\nDEG bitti (alan seçilmedi).")
              )
              (progn
                (setq scopePolySS (DEG:SS-FILTER-BY-TYPE scopeSel "LWPOLYLINE,POLYLINE"))
                (setq scopeBlkSS  (DEG:SS-FILTER-BY-TYPE scopeSel "INSERT"))
                (if (<= (DEG:SS-LEN scopePolySS) 0) (setq scopePolySS nil))
                (if (<= (DEG:SS-LEN scopeBlkSS) 0)  (setq scopeBlkSS  nil))
                (if (not scopePolySS) (setq scopePolySS (ssadd)))
                (if (and tmp (not (DEG:SS-CONTAINS-ENAME? scopePolySS tmp)))
                  (ssadd tmp scopePolySS)
                )
                (setq *degDGScopePolySS* scopePolySS)
                (setq *degDGScopeBlkSS*  scopeBlkSS)

                (setq txtObj (vlax-ename->vla-object tmp))     ;; ref polyline obj
                (setq pageName (deg-nearest-vertex txtObj s))  ;; refPt (x y z)
                (setq blkRefObj pageName)
                (setq *degForceRefObj* txtObj)
                (setq *degForceRefPt* pageName)

                (setq sortedList (deg-build-data nil blkRefObj))
                (setq *degForceRefObj* nil)
                (setq *degForceRefPt* nil)

            (setq txtEnt (entsel
              "\nCSV dosya ismi için TEXT'e týklayýn veya elle girmek için Enter (boþ Enter = bitir): "
            ))

            (if txtEnt
              (progn
                (setq txtObj (vlax-ename->vla-object (car txtEnt)))
                (setq s      (get-entity-text txtObj))
                (if s
                  (setq pageName s)
                  (setq pageName (getstring T "\nTEXT okunamadý, dosya ismini elle yazýn: "))
                )
              )
              (progn
                (setq pageName (getstring T "\nCSV dosya ismini yazýn (boþ Enter = bitir): "))
              )
            )

            (if (or (null pageName) (= pageName ""))
              (progn
                (setq continue nil)
                (princ "\n\nDEG bitti (dosya ismi girilmedi).")
              )
              (progn
                (setq pageName (sanitize-filename pageName))


                (if (not sortedList)
                  (princ "\n\nBu referans için hesaplanacak veri bulunamad.")
                  (progn
                    (setq *degFolder*
                      (DEGDO--csv-folder *degFolder* pageName "CSV kaydedilecek konumu secin")
                    )
                    (if (not *degFolder*)
                      (progn
                        (setq continue nil)
                        (princ "\n\nDO > KAYIT sayfasinda klasor lokasyonu girin.")
                      )
                    )
                    (if (and continue *degFolder*)
                      (progn
                        (setq filepath (DEGDO--csv-filepath *degFolder* pageName))
                        (setq csvfile  (open filepath "w"))

                        (if csvfile
                          (progn
                            (setq maxBlkPairs 0
                                  maxSymPairs 0)

                            (foreach row sortedList
                              (if (not (and (deg--layer-is-priz-or-lighting (nth 1 row))
                                            (deg--blank? (nth 0 row))
                                            (not (deg--layer-is-data (nth 1 row)))
                                            (not (wcmatch (deg--norm-tr (nth 1 row)) "*KIT*"))))
                                (progn
                                  (setq flatBlk (deg-csv-counted-string->flat-list (nth 7 row))
                                        flatSym (deg-csv-counted-list->flat-list   (nth 8 row)))
                                  (if (> (fix (/ (length flatBlk) 2)) maxBlkPairs)
                                    (setq maxBlkPairs (fix (/ (length flatBlk) 2))))
                                  (if (> (fix (/ (length flatSym) 2)) maxSymPairs)
                                    (setq maxSymPairs (fix (/ (length flatSym) 2))))
                                )
                              )
                            )

                            (if (< maxBlkPairs 1) (setq maxBlkPairs 1))
                            (if (< maxSymPairs 1) (setq maxSymPairs 1))

                            (write-line
                              (strcat
                                (cond
                                  (*degHideSortiToplam*
                                    (if *degHideToplamx*
                                      "Linye;Layer" (strcat "Linye;Layer;" (DEG:LEN-HEADER "ToplamxAdet"))
                                    )
                                  )
                                  (T
                                    (if *degHideToplamx*
                                      (strcat "Linye;Layer;Sorti Metraj (m);Toplam (m)")
                                      (strcat "Linye;Layer;Sorti Metraj (m);Toplam (m);" (DEG:LEN-HEADER "ToplamxAdet"))
                                    )
                                  )
                                )
                                ";"
                                (deg-csv-build-paired-headers "BagliBlok" maxBlkPairs)
                                ";"
                                (deg-csv-build-paired-headers "Sembol" maxSymPairs)
                              )
                              csvfile)

                            (setq anyBlkFound nil)

                            (foreach row sortedList
                              (if (not (and (deg--layer-is-priz-or-lighting (nth 1 row))
                                            (deg--blank? (nth 0 row))
                                            (not (deg--layer-is-data (nth 1 row)))
                                            (not (wcmatch (deg--norm-tr (nth 1 row)) "*KIT*"))))
                                (progn
                                  (setq line
                                    (cond
                                      (*degHideSortiToplam*
                                        (if *degHideToplamx*
                                          (strcat
                                            (nth 0 row) ";"
                                            (nth 1 row))
                                          (strcat
                                            (nth 0 row) ";"
                                            (nth 1 row) ";"
                                            (if (nth 6 row) (itoa (deg-fmt-int (nth 6 row))) ""))
                                        )
                                      )
                                      (T
                                        (if *degHideToplamx*
                                          (strcat
                                            (nth 0 row) ";"
                                            (nth 1 row) ";"
                                            (if (deg--sorti-metraj row) (itoa (deg-fmt-int (deg--sorti-metraj row))) "") ";"
                                            (itoa (deg-fmt-int (nth 5 row))))
                                          (strcat
                                            (nth 0 row) ";"
                                            (nth 1 row) ";"
                                            (if (deg--sorti-metraj row) (itoa (deg-fmt-int (deg--sorti-metraj row))) "") ";"
                                            (itoa (deg-fmt-int (nth 5 row))) ";"
                                            (if (nth 6 row) (itoa (deg-fmt-int (nth 6 row))) ""))
                                        )
                                      )
                                    ))
                                  (setq blkFields (deg-csv-counted-flat-list->fields
                                                    (deg-csv-counted-string->flat-list (nth 7 row))
                                                    maxBlkPairs)
                                        symFields (deg-csv-counted-flat-list->fields
                                                    (deg-csv-counted-list->flat-list (nth 8 row))
                                                    maxSymPairs))
                                  (setq line
                                        (strcat line
                                                ";"
                                                blkFields
                                                ";"
                                                symFields))
                                  (if (or (and (nth 7 row) (not (deg--blank? (nth 7 row))))
                                          (and (nth 8 row) (> (length (nth 8 row)) 0)))
                                    (setq anyBlkFound T)
                                  )
                                  (write-line line csvfile)
                                )
                              )
                            )



                            (close csvfile)
                            (princ)
                            (princ (strcat "\nOluþturulan dosya: " filepath))
                          )
                          (princ (strcat "\nDosya açýlamadý / oluþturulamadý: " filepath))
                        )
                      )
                    )
                  )
                )
              )
            )
            )
          )
        )
      )
    )
  )

  (setq *degDGScopePolySS* nil)
  (setq *degDGScopeBlkSS*  nil)
  (princ)
)
)
(defun deg-expand-loop (s / pos leftPart rightPart len i ch numL numR prefixL
                           startN endN width res n numStr)
  (if (and s (setq pos (vl-string-search ",...," s)))
    (progn
      (setq leftPart  (substr s 1 pos))
      (setq rightPart (substr s (+ pos 6)))

      (setq len (strlen leftPart)
            numL ""
            i   len)
      (while (and (> i 0)
                  (setq ch (substr leftPart i 1))
                  (>= (ascii ch) 48) (<= (ascii ch) 57))
        (setq numL (strcat ch numL))
        (setq i (1- i))
      )
      (setq prefixL (substr leftPart 1 i))

      (setq len (strlen rightPart)
            numR ""
            i   1)
      (while (and (<= i len)
                  (setq ch (substr rightPart i 1))
                  (>= (ascii ch) 48) (<= (ascii ch) 57))
        (setq numR (strcat numR ch))
        (setq i (1+ i))
      )

      (if (and (> (strlen numL) 0) (> (strlen numR) 0))
        (progn
          (setq startN (atoi numL)
                endN   (atoi numR)
                width  (max (strlen numL) (strlen numR)))
          (if (< startN endN)
            (progn
              (setq res '()
                    n   startN)
              (while (<= n endN)
                (setq numStr (itoa n))
                (while (< (strlen numStr) width)
                  (setq numStr (strcat "0" numStr))
                )
                (setq res (cons (strcat prefixL numStr) res))
                (setq n (1+ n))
              )
              (reverse res)
            )
            (list s)
          )
        )
        (list s)
      )
    )
    (if s (list s) '())
  )
)

(defun get-loop-adi-from-block (blkObj / attList att tag val res)
  (setq res nil)
  (if (= :vlax-true (vla-get-HasAttributes blkObj))
    (progn
