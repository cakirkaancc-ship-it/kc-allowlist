(defun DEGP--dispatch-single (sel / ent pickPt ed typ)
  (setq ent    (car sel)
        pickPt (cadr sel)
        ed     (if ent (entget ent))
        typ    (cdr (assoc 0 ed)))
  (if (and ent typ (wcmatch typ "LWPOLYLINE,POLYLINE"))
    (cond
      ((DEGP--data-report-single sel) T)
      ((DEGP--lighting-report-single sel) T)
      ((DEGP--kombine-report-single sel) T)
      (T nil)
    )
  )
)

