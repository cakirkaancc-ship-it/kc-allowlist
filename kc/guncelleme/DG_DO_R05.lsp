(defun KC:ShowDeviceCodeDialog (code / script path resultPath logPath file pid cmd runResult result item)
  (setq script (DEGDO--win-script-path)
        path
          (DEG:RUNTIME-FILE
            (strcat
              "kc_license_"
              (KC:ProcessToken)
              "_"
              (itoa (getvar "MILLISECS"))
              ".txt"))
        resultPath (strcat path ".result")
        logPath    (strcat path ".log"))
  (foreach item (list path resultPath logPath)
    (if (KC:FileExists item) (vl-file-delete item)))
  (if (and script (setq file (open path "w")))
    (progn
      (write-line "DEG" file)
      (write-line (if code code "<KOD_OLUSTURULAMADI>") file)
      (close file)
      (setq pid (vl-catch-all-apply 'getvar (list "PROCESSID")))
      (if (or (vl-catch-all-error-p pid) (not (numberp pid)))
        (setq pid 0)
        (setq pid (fix pid)))
      (setq cmd
        (strcat
          "powershell.exe -NoProfile -ExecutionPolicy Bypass -STA -WindowStyle Hidden -File \""
          script
          "\" -Mode License -StatePath \""
          path
          "\" -DeviceCode \""
          (if code code "")
          "\" -PasswordUrl \""
          *KC_BYPASS_VERIFIER_URL*
          "\" -LicenseOverridePath \""
          (KC:SessionOverrideFile)
          "\" -HostPid " (itoa pid)
          " -HostHwnd 0"))
      (setq runResult (vl-catch-all-apply 'KC:RunHidden (list cmd T)))
      (if (and (not (vl-catch-all-error-p runResult))
               (KC:FileExists resultPath))
        (setq result (strcase (KC:Trim (KC:ReadFirstLine resultPath)))))
      (foreach item (list path resultPath)
        (if (KC:FileExists item) (vl-file-delete item)))
      (if (and (not (vl-catch-all-error-p runResult))
               (= runResult 0)
               (member result '("OK" "CLOSED"))
               (KC:FileExists logPath))
        (vl-file-delete logPath))
      (= result "OK"))
    nil)
)

