(defun DEGZ--ename (x)
  (cond
    ((= (type x) 'ENAME) x)
    ((= (type x) 'VLA-OBJECT) (vlax-vla-object->ename x))
    (t nil)
  )
)

(defun DEGZ--pt2d (p)
  (cond
    ((and (listp p) (>= (length p) 2)) (list (car p) (cadr p)))
    (t p)
  )
)
(defun DEGZ--pt-ok-p (p)
  (and (listp p) (numberp (car p)) (numberp (cadr p)))
)

(defun DEGZ--pt2d-safe (p fallback / q)
  (cond
    ((DEGZ--pt-ok-p p) (DEGZ--pt2d p))
    ((and (listp p) (DEGZ--pt-ok-p (car p))) (DEGZ--pt2d (car p)))
    ((DEGZ--pt-ok-p fallback) (DEGZ--pt2d fallback))
    (T nil)
  )
)

(defun DEGZ--safe-distance (a b / pa pb)
  (setq pa (DEGZ--pt2d-safe a nil))
  (setq pb (DEGZ--pt2d-safe b nil))
  (if (and pa pb)
    (distance pa pb)
    0.0
  )
)

(defun DEGZ--redundant-mouth3-p (a b c / pa pb pc abx aby bcx bcy cross dot lenAB lenBC tol)
  (setq pa (DEGZ--pt2d-safe a nil))
  (setq pb (DEGZ--pt2d-safe b nil))
  (setq pc (DEGZ--pt2d-safe c nil))
  (if (and pa pb pc)
    (progn
      (setq abx (- (car pb) (car pa)))
      (setq aby (- (cadr pb) (cadr pa)))
      (setq bcx (- (car pc) (car pb)))
      (setq bcy (- (cadr pc) (cadr pb)))
      (setq cross (- (* abx bcy) (* aby bcx)))
      (setq dot (+ (* abx bcx) (* aby bcy)))
      (setq lenAB (sqrt (+ (* abx abx) (* aby aby))))
      (setq lenBC (sqrt (+ (* bcx bcx) (* bcy bcy))))
      (setq tol (* 1e-7 (max 1.0 (* lenAB lenBC))))
      (and (> lenAB 1e-9)
           (> lenBC 1e-9)
           (<= (abs cross) tol)
           (> (abs dot) 1e-8))
    )
    nil
  )
)

(defun DEGZ--mouth-redundant-p (a b c / pa pb pc abx aby bcx bcy cross dot lenAB lenBC tol)
  ;; Sadece ana hat agzinda kullanilir. Hesaptan kalan cok kucuk aci farklarini
  ;; ayni dogrultu sayar; gercek dirsek ve cikinti koselerine dokunmaz.
  (setq pa (DEGZ--pt2d-safe a nil))
  (setq pb (DEGZ--pt2d-safe b nil))
  (setq pc (DEGZ--pt2d-safe c nil))
  (if (and pa pb pc)
    (progn
      (setq abx (- (car pb) (car pa)))
      (setq aby (- (cadr pb) (cadr pa)))
      (setq bcx (- (car pc) (car pb)))
      (setq bcy (- (cadr pc) (cadr pb)))
      (setq cross (- (* abx bcy) (* aby bcx)))
      (setq dot (+ (* abx bcx) (* aby bcy)))
      (setq lenAB (sqrt (+ (* abx abx) (* aby aby))))
      (setq lenBC (sqrt (+ (* bcx bcx) (* bcy bcy))))
      (setq tol (* 1e-5 (max 1.0 (* lenAB lenBC))))
      (and (> lenAB 1e-9)
           (> lenBC 1e-9)
           (<= (abs cross) tol)
           (> (abs dot) 1e-8))
    )
    nil
  )
)
(defun DEGZ--trim-route-mouth-backtracks (pts / rev clean p)
  ;; Once ayni konumdaki ardisik rota noktalarini tek noktaya indir.
  ;; Sifir uzunluklu parca agizdaki dogrusal kontrolu engellemesin.
  (setq clean '())
  (foreach p pts
    (setq p (DEGZ--pt2d p))
    (if (or (null clean) (> (DEGZ--safe-distance p (car clean)) 1e-6))
      (setq clean (cons p clean))
    )
  )
  (setq pts (reverse clean))

  ;; Sadece agizlara komsu tasan vertexleri sil; dirsek icini koru.
  (while (and (>= (length pts) 3)
              (DEGZ--mouth-redundant-p (car pts) (cadr pts) (caddr pts)))
    (setq pts (cons (car pts) (cddr pts)))
  )
  (setq rev (reverse pts))
  (while (and (>= (length rev) 3)
              (DEGZ--mouth-redundant-p (car rev) (cadr rev) (caddr rev)))
    (setq rev (cons (car rev) (cddr rev)))
  )
  (reverse rev)
)
