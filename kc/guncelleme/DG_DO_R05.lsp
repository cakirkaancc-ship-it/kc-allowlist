(defun DEGQ:_block-has-attrib-tag? (blkE tag / e d)
  (setq tag (strcase tag))
  (setq e (entnext blkE))
  (while (and e
              (setq d (entget e))
              (not (= (cdr (assoc 0 d)) "SEQEND")))
    (if (= (cdr (assoc 0 d)) "ATTRIB")
      (if (= (strcase (cdr (assoc 2 d))) tag)
        (progn (setq e nil) (setq d 'FOUND))
      )
    )
    (if e (setq e (entnext e)))
  )
  (if (= d 'FOUND) T nil)
)

