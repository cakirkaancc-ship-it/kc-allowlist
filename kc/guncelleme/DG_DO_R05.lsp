(defun DEG:NUM->STR (n / s)
  (setq s (rtos n 2 8))
  (if (vl-string-search "." s)
    (progn
      (while (and (> (strlen s) 1) (= (substr s (strlen s) 1) "0"))
        (setq s (substr s 1 (1- (strlen s))))
      )
      (if (= (substr s (strlen s) 1) ".")
        (setq s (substr s 1 (1- (strlen s))))
      )
    )
  )
  s
)

