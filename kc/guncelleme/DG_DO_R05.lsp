(defun DEGDO--fill-plan (/ v idx)
  (start_list "plan_unit")
  (add_list "mm")
  (add_list "cm")
  (add_list "metre")
  (end_list)
  (setq v (strcase (DEGDO--trim (DEG:CFG-GET 'PLAN_UNIT))))
  (setq idx
    (cond
      ((= v "CM") 1)
      ((or (= v "METRE") (= v "M")) 2)
      (T 0)
    )
  )
  (set_tile "plan_unit" (itoa idx))
)

(defun DEGDO--save-plan (/ idx)
  (setq idx (atoi (get_tile "plan_unit")))
  (DEG:CFG-SET 'PLAN_UNIT
    (cond
      ((= idx 1) "cm")
      ((= idx 2) "metre")
      (T "mm")
    )
  )
  (DEG:SAVE-SETTINGS)
  (DEG:TOL-REFRESH-DN-GLOBALS)
)

(defun DEGDO--reset-plan ()
  (DEG:CFG-SET 'PLAN_UNIT "")
  (DEG:TOL-REFRESH-DN-GLOBALS)
  (DEGDO--fill-plan)
)

