)

(defun g388_best_snap (p a b c d tol / r1 r2 d1 d2)
  (setq r1 (if (and a b) (g365_closest_on_seg p a b) nil))
  (setq r2 (if (and c d) (g365_closest_on_seg p c d) nil))
  (setq d1 (if r1 (nth 2 r1) 1e99))
  (setq d2 (if r2 (nth 2 r2) 1e99))
  (cond
    ((and r1 (<= d1 tol) (<= d1 d2)) (nth 0 r1))
    ((and r2 (<= d2 tol)) (nth 0 r2))
    (t p)
  )
)

