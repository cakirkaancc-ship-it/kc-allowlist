        (setq i (1+ i))
      )
    )
  )
  ok
)


(defun DEGV:_touching-polyline-layers-for-block-global (blkObj chain tolTouch / out ip touchedE polyE o lyr mnw mxw ssCand i e)
  (setq touchedE nil)
  (setq out nil)

  (if (not blkObj)
    nil
    (progn
      (setq ip (DEGV:_v2l (vla-get-InsertionPoint blkObj)))

      (foreach polyE chain
        (if (and polyE (= (type polyE) 'ENAME)
             (deg-layerE-ename-p polyE)
             (not (deg-layer0-ename-p polyE)))
          (if (DEGV:_touch-block-to-poly? blkObj polyE tolTouch)
            (if (not (member polyE touchedE))
              (setq touchedE (cons polyE touchedE))
            )
          )
        )
      )

      (if ip
        (progn
          (setq mnw (list (- (car ip) tolTouch) (- (cadr ip) tolTouch) 0.0))
          (setq mxw (list (+ (car ip) tolTouch) (+ (cadr ip) tolTouch) 0.0))
          (setq ssCand (ssget "_C" mnw mxw '((0 . "LWPOLYLINE,POLYLINE"))))
          (if ssCand
            (progn
              (setq i 0)
              (while (< i (sslength ssCand))
                (setq e (ssname ssCand i))
                (if (and e (not (DEGN-DEGA--scope-poly-p e))) (setq e nil))
                (if (and e (= (strcase (cdr (assoc 8 (entget e)))) (DEG:VAL 'O2))) (setq e nil))
                (if (and e (= (strcase (cdr (assoc 8 (entget e)))) "0")) (setq e nil))
                (if e
                  (if (and (not (member e chain))
                           (DEGV:_touch-block-to-poly? blkObj e tolTouch))
                    (progn
                      (setq o (vl-catch-all-apply 'vlax-ename->vla-object (list e)))
                      (if (not (vl-catch-all-error-p o))
                        (progn
                          (setq lyr (vla-get-Layer o))
                          (if (and lyr (deg-layerE-str-p lyr))
                            (if (not (member e touchedE))
                              (setq touchedE (cons e touchedE))
                            )
                          ))
                      )
                    )
                  )
                )
                (setq i (1+ i))
              )
            )
          )
        )
      )

      (foreach e (reverse touchedE)
        (setq o (vl-catch-all-apply 'vlax-ename->vla-object (list e)))
        (if (not (vl-catch-all-error-p o))
          (progn
            (setq lyr (vla-get-Layer o))
            (if (and lyr (deg-layerE-str-p lyr) (/= (strcase lyr) "0")) (setq out (cons lyr out)))
          )
        )
      )

      (reverse out)
    )
  )

)
    
  




