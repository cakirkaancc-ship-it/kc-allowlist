(defun DT--block-references-block-p (name nestedName / rec ent found)
  (setq rec (if name (tblobjname "BLOCK" name)))
  (if rec
    (progn
      (setq ent (entnext rec))
      (while (and ent (/= (cdr (assoc 0 (entget ent))) "ENDBLK") (null found))
        (if (and (= (cdr (assoc 0 (entget ent))) "INSERT")
                 (= (strcase (cdr (assoc 2 (entget ent)))) (strcase nestedName)))
          (setq found T))
        (setq ent (entnext ent)))))
  found
)

(defun DT--populate-fitting-block-vla (blk shapes base ang yscale shellName / shape local bulges pl hatch ok)
  (if (and blk shapes)
    (progn
      (setq ok T)
      (foreach shape shapes
        (setq local
          (DT--local-pts-xform
            (car shape)
            base
            ang
            yscale
          )
        )
        (setq bulges (DT--local-bulges-xform (caddr shape) yscale))
        (setq pl (DT--block-poly-vla blk local (cadr shape) bulges))
        (if (not pl) (setq ok nil))
        (if (and (cadr shape) pl)
          (progn
            (setq hatch (DT--block-hatch-vla blk pl))
            (if (not hatch) (setq ok nil))
          )
        )
      )
      (if shellName
        (if (not (DT--block-shell-insert-vla blk shellName)) (setq ok nil)))
      ok
    )
  )
)
(defun DT--redefine-fitting-block (name shapes base ang yscale shellName / blk rec doc blks)
  (vl-load-com)
  (setq rec (tblobjname "BLOCK" name))
  (setq blk
    (cond
      (rec (vlax-ename->vla-object rec))
      (T
        (setq doc  (vla-get-ActiveDocument (vlax-get-acad-object))
              blks (vla-get-Blocks doc))
        (vl-catch-all-apply 'vla-Item (list blks name))
      )
    )
  )
  (if (and blk (not (vl-catch-all-error-p blk)))
    (progn
      (DT--clear-block-object blk)
      (DT--populate-fitting-block-vla blk shapes base ang yscale shellName)
      (DT--block-associate-hatches name)
    )
  )
)
(defun DT--mark-fitting-insert (ins kind width / app ed payload)
  (setq app "DT_FITTING")
  (if (not (tblsearch "APPID" app)) (regapp app))
  (if (and ins (entget ins))
    (progn
      (setq payload
        (list app
          (cons 1000 (if kind kind ""))
          (cons 1040 (if (numberp width) width 0.0))
        )
      )
      (setq ed (entget ins '("*")))
      (setq ed (DT--xdata-set-app ed app payload))
      (entmod ed)
      (entupd ins)
    )
  )
  (DT--cache-fitting-insert ins)
  ins
)

