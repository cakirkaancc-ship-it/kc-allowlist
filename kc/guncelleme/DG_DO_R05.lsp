(defun vlax-objectp (x) (= (type x) 'VLA-OBJECT))

(defun degw-ensure-vlax ( / r )
  (setq r (vl-catch-all-apply 'vl-load-com '()))
  (princ)
)

(defun degw-_v2l (v)
  (cond
    ((= (type v) 'variant) (degw-_v2l (vlax-variant-value v)))
    ((= (type v) 'safearray) (vlax-safearray->list v))
    (T v)
  )
)

(defun degw-layer-visible-p (layerName / doc layers lyr r frz on)
  (degw-ensure-vlax)
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)))
  (setq layers (vla-get-Layers doc))
  (setq r (vl-catch-all-apply 'vla-Item (list layers layerName)))
  (if (vl-catch-all-error-p r)
    T
    (progn
      (setq lyr r)
      (setq frz (vla-get-Freeze lyr))
      (setq on  (vla-get-LayerOn lyr))
      (and (= frz :vlax-false) (= on :vlax-true))
    )
  )
)

(defun degw-text-entity-p (obj / onm)
  (setq onm (if obj (strcase (vla-get-ObjectName obj)) ""))
  (or (= onm "ACDBTEXT")
      (= onm "ACDBMTEXT")
      (= onm "ACDBATTRIBUTE")
      (= onm "ACDBATTRIBUTEREFERENCE")
      (= onm "ACDBATTRIBUTEDEFINITION")
      (= onm "ACDBATTDEF")
      (= onm "ACDBLEADER") ; içinde anotasyön olabiliyor
      (= onm "ACDBMLEADER")
  )
)

(defun degw-entity-visible-p (obj / vis r)
  (if (and obj (vlax-property-available-p obj 'Visible))
    (progn
      (setq r (vl-catch-all-apply 'vla-get-Visible (list obj)))
      (if (vl-catch-all-error-p r) T (= r :vlax-true))
    )
    T
  )
)

(defun degw-entity-eligible-for-bbox-p (obj / lyr)
  (and obj
       (not (degw-text-entity-p obj))
       (degw-entity-visible-p obj)
       (progn
         (setq lyr (vl-catch-all-apply 'vla-get-Layer (list obj)))
         (if (vl-catch-all-error-p lyr)
           T
           (degw-layer-visible-p lyr)
         )
       )
  )
)

(defun degw-bbox-union (bbA bbB / mnA mxA mnB mxB)
  (cond
    ((and (not bbA) (not bbB)) nil)
    ((not bbA) bbB)
    ((not bbB) bbA)
    (T
      (setq mnA (car bbA)  mxA (cadr bbA))
      (setq mnB (car bbB)  mxB (cadr bbB))
      (list
        (list (min (car mnA) (car mnB))
              (min (cadr mnA) (cadr mnB))
              (min (caddr mnA) (caddr mnB)))
        (list (max (car mxA) (car mxB))
              (max (cadr mxA) (cadr mxB))
              (max (caddr mxA) (caddr mxB)))
      )
    )
  )
)

(defun degw-get-bbox (obj / bb mn mx r exp lst one)
  (degw-ensure-vlax)
  (setq bb nil)

  (if (and obj (vlax-method-applicable-p obj 'Explode))
    (progn
      (setq exp (degw-explode->list obj))
      (if exp
        (progn
          (foreach one exp
            (if (degw-entity-eligible-for-bbox-p one)
              (progn
                (setq r (vl-catch-all-apply 'vla-getboundingbox (list one 'mn 'mx)))
                (if (not (vl-catch-all-error-p r))
                  (setq bb (degw-bbox-union bb (list (degw-_v2l mn) (degw-_v2l mx))))
                )
              )
            )
          )
        )
      )
      (degw-delete-objects exp)
    )
  )

  (if (not bb)
    (progn
      (setq r (vl-catch-all-apply 'vla-getboundingbox (list obj 'mn 'mx)))
      (if (vl-catch-all-error-p r)
        nil
        (list (degw-_v2l mn) (degw-_v2l mx))
      )
    )
    bb
  )
)

(defun degw-bbox-expand (bb tol)
  (if (not bb)
    nil
    (list
      (list (- (car  (car bb)) tol)
            (- (cadr (car bb)) tol)
            (- (caddr(car bb)) tol))
      (list (+ (car  (cadr bb)) tol)
            (+ (cadr (cadr bb)) tol)
            (+ (caddr(cadr bb)) tol))
    )
  )
)

(defun degw-bbox-overlap-p (bb1 bb2)
  (and bb1 bb2
       (not (or
              (> (car  (car bb1)) (car  (cadr bb2)))
              (> (cadr (car bb1)) (cadr (cadr bb2)))
              (> (caddr(car bb1)) (caddr(cadr bb2)))
              (< (car  (cadr bb1)) (car  (car  bb2)))
              (< (cadr (cadr bb1)) (cadr (car  bb2)))
              (< (caddr(cadr bb1)) (caddr(car  bb2)))
            )
       )
  )
)

(defun degw-block-effective-name (blkObj / nm)
  (degw-ensure-vlax)
  (setq nm (vl-catch-all-apply 'vla-get-effectivename (list blkObj)))
  (if (vl-catch-all-error-p nm)
    (setq nm (vla-get-name blkObj))
  )
  (if nm (strcase nm) "")
)

(defun degw-attrs->list (blkObj / raw v)
  (degw-ensure-vlax)
  (if (and blkObj
           (vlax-property-available-p blkObj 'HasAttributes)
           (= (vla-get-HasAttributes blkObj) :vlax-true))
    (progn
      (setq raw (vl-catch-all-apply 'vlax-invoke (list blkObj 'GetAttributes)))
      (if (vl-catch-all-error-p raw)
        nil
        (progn
          (setq v (degw-_v2l raw))
          (cond
            ((null v) nil)
            ((listp v) v)
            ((vlax-objectp v) (list v))
            (T nil)
          )
        )
      )
    )
    nil
  )
)

(defun degw-get-attrvalue (blkObj tag / atts a val)
  (setq val nil)
  (setq atts (degw-attrs->list blkObj))
  (if atts
    (foreach a atts
      (if (= (strcase (vla-get-TagString a)) (strcase tag))
        (setq val (vla-get-TextString a))
      )
    )
  )
  val
)

(defun degw-explode->list (obj / var lst)
  (degw-ensure-vlax)
  (setq var (vl-catch-all-apply 'vlax-invoke (list obj 'Explode)))
  (if (vl-catch-all-error-p var)
    nil
    (progn
      (setq lst (degw-_v2l var))
      (if (listp lst) lst nil)
    )
  )
)

(defun degw-delete-objects (lst)
  (foreach o lst
    (if (and o (vlax-objectp o))
      (vl-catch-all-apply 'vla-delete (list o))
    )
  )
)

(defun degw-intersect-p (o1 o2 / r a)
  (if (and o1 o2
           (vlax-objectp o1) (vlax-objectp o2)
           (vlax-method-applicable-p o1 'IntersectWith)
           (vlax-method-applicable-p o2 'IntersectWith))
    (progn
      (setq r (vl-catch-all-apply 'vlax-invoke (list o1 'IntersectWith o2 0))) ; acExtendNone=0
      (if (vl-catch-all-error-p r)
        nil
        (progn
          (setq a (degw-_v2l r))
          (and (listp a) (> (length a) 0))
        )
      )
    )
    nil
  )
)

(defun degw-objects-intersect-any-p (lst1 lst2 / o1 o2 hit)
  (setq hit nil)
  (foreach o1 lst1
    (if (not hit)
      (foreach o2 lst2
        (if (and (not hit) (degw-intersect-p o1 o2))
          (setq hit T)
        )
      )
    )
  )
  hit
)

(defun degw-point-in-bbox-p (pt bb / mn mx)
  (and pt bb
       (setq mn (car bb) mx (cadr bb))
       (<= (car mn) (car pt))
       (<= (car pt) (car mx))
       (<= (cadr mn) (cadr pt))
       (<= (cadr pt) (cadr mx))
       (<= (caddr mn) (caddr pt))
       (<= (caddr pt) (caddr mx))
  )
)

(defun degw-bbox-inside-p (inner outer / mn1 mx1 mn2 mx2)
  (and inner outer
       (setq mn1 (car inner) mx1 (cadr inner))
       (setq mn2 (car outer) mx2 (cadr outer))
       (<= (car mn2) (car mn1))
       (<= (cadr mn2) (cadr mn1))
       (<= (caddr mn2) (caddr mn1))
       (<= (car mx1) (car mx2))
       (<= (cadr mx1) (cadr mx2))
       (<= (caddr mx1) (caddr mx2))
  )
)

(defun degw-bbox-center (bb / mn mx)
  (if bb
    (progn
      (setq mn (car bb) mx (cadr bb))
      (list (/ (+ (car mn)   (car mx))   2.0)
            (/ (+ (cadr mn)  (cadr mx))  2.0)
            (/ (+ (caddr mn) (caddr mx)) 2.0))
    )
  )
)

(defun degw-touch-p (blkObj mahalObj / tol bb1 bb2 e1 e2 hit ins ctr)
  (setq tol (DEG:CFG-TOL-NUM-OR 'DW_TOUCH_TOL 1e-6))
  (setq bb1 (degw-bbox-expand (degw-get-bbox blkObj) tol))
  (setq bb2 (degw-bbox-expand (degw-get-bbox mahalObj) tol))
  (setq ins (deg-get-inspt blkObj))
  (setq ctr (degw-bbox-center bb1))
  (cond
    ((not (and bb1 bb2)) nil)
    ((degw-bbox-inside-p bb1 bb2) T)
    ((degw-point-in-bbox-p ins bb2) T)
    ((degw-point-in-bbox-p ctr bb2) T)
    ((not (degw-bbox-overlap-p bb1 bb2)) nil)
    (T
      (setq e1 (degw-explode->list blkObj))
      (setq e2 (degw-explode->list mahalObj))
      (setq hit (and e1 e2 (degw-objects-intersect-any-p e1 e2)))
      (degw-delete-objects e1)
      (degw-delete-objects e2)
      hit
    )
  )
)

(defun degw-get-emahal-unique ( / ss i ent obj nm bb lst pair)
  (degw-ensure-vlax)
  (setq lst '())
  (setq ss (ssget "X" '((0 . "INSERT"))))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent (ssname ss i))
        (setq obj (vlax-ename->vla-object ent))
        (if (and (degw-block-effective-name obj)
                 (wcmatch (strcase (degw-block-effective-name obj)) (strcat "*" (strcase (DEG:VAL 'P2)) "*")))
          (progn
            (setq nm (degw-get-attrvalue obj (DEG:VAL 'P2)))
            (if (and nm (/= nm ""))
              (progn
                (if (not (assoc nm lst))
                  (setq lst (cons (cons nm (list obj)) lst))
                  (progn
                    (setq pair (assoc nm lst))
                    (setq lst (subst (cons nm (cons obj (cdr pair))) pair lst))
                  )
                )
              )
            )
          )
        )
        (setq i (1+ i))
      )
    )
  )
  (reverse lst) ; (("MAHAL1" obj1 obj2 ...) ("MAHAL2" obj3 ...) ...)
)

(defun degw-matrix-inc (matrix key col qty / row assocList pair)
  (setq row (assoc key matrix))          ; (key . ((col . qty) ...))
  (if row
    (progn
      (setq assocList (cdr row))
      (setq pair (assoc col assocList))
      (if pair
        (setq assocList (subst (cons col (+ (cdr pair) qty)) pair assocList))
        (setq assocList (cons (cons col qty) assocList))
      )
      (setq matrix (subst (cons key assocList) row matrix))
    )
    (setq matrix (cons (cons key (list (cons col qty))) matrix))
  )
  matrix
)

(defun degw-roworder-add (rowOrder key)
  (if (member key rowOrder)
    rowOrder
    (cons key rowOrder)
  )
)



