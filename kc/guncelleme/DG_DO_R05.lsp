  (if (and shellName (tblsearch "BLOCK" shellName))
    (entmake
      (list
        '(0 . "INSERT")
        (cons 2 shellName)
        (cons 8 (DT--layer-fitting))
        '(10 0.0 0.0 0.0)
        '(41 . 1.0)
        '(42 . 1.0)
        '(43 . 1.0)
        '(50 . 0.0)))
  )
