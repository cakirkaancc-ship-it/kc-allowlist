  lst
)

(defun DEGQ:_touching-polylines-in-chain-for-block (blkObj chain tolTouch / out polyE)
  (setq out (ssadd))
  (foreach polyE chain
    (if (and polyE (= (type polyE) 'ENAME)
             (not (deg-layer0-ename-p polyE))
             (member (cdr (assoc 0 (entget polyE))) '("LWPOLYLINE" "POLYLINE")))
      (if (DEGQ:_touch-block-to-poly? blkObj polyE tolTouch)
        (ssadd polyE out)
      )
    )
  )
  out
)

(defun DEGQ:_touching-polyline-layers-for-block (blkObj chain tolTouch / ss i e o lyr out)
  (setq out nil)
  (setq ss (DEGQ:_touching-polylines-in-chain-for-block blkObj chain tolTouch))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq e (ssname ss i))
        (if e
          (progn
            (setq o (vl-catch-all-apply 'vlax-ename->vla-object (list e)))
            (if (not (vl-catch-all-error-p o))
              (progn
                (setq lyr (vla-get-Layer o))
                (if (and lyr (/= (strcase lyr) "0") (not (member lyr out)))
                  (setq out (cons lyr out))
                )
              )
            )
          )
        )
        (setq i (1+ i))
      )
    )
  )
  (reverse out)
)



(defun DEGQ:_nearest-touching-polyline-layer (blkObj chain tolTouch / ip bestE bestD polyE cp d)
  (setq ip (DEGQ:_v2l (vla-get-InsertionPoint blkObj)))
  (setq bestE nil)
  (setq bestD 1e99)
  (if ip
    (foreach polyE chain
      (if (and polyE (= (type polyE) 'ENAME)
               (member (cdr (assoc 0 (entget polyE))) '("LWPOLYLINE" "POLYLINE")))
        (progn
          (setq cp (vlax-curve-getclosestpointto polyE ip))
          (if cp
            (progn
              (setq d (DEGQ:_dist2d ip cp))
              (if (and (<= d tolTouch) (< d bestD))
                (progn (setq bestD d) (setq bestE polyE))
              )
            )
          )
        )
      )
    )
  )
  (if bestE
    (vla-get-Layer (vlax-ename->vla-object bestE))
    nil
  )
)

(defun DEGQ:_doseme_expand_filtered (chain ssBlocksNoDoseme tolTouch / hChain polyE ssDoseme i blkE blkObj
                                         touchedByChain ipd mnw mxw ssCand j candE
                                         newSeeds added pack)

  (setq hChain nil)
  (foreach polyE chain
    (if (and polyE (= (type polyE) 'ENAME)
             (not (deg-layer0-ename-p polyE)))
      (setq hChain (cons (DEGQ:_ename-handle polyE) hChain))
    )
  )

  (setq ssDoseme (ssget "X" (list (cons 0 "INSERT") (cons 2 (DEG:VAL 'M1)))))
  (if (not ssDoseme)
    chain
    (progn
      (setq i 0)
      (while (< i (sslength ssDoseme))
        (setq blkE   (ssname ssDoseme i))
        (setq blkObj (vlax-ename->vla-object blkE))

        (setq touchedByChain nil)
        (foreach polyE chain
          (if (and (not touchedByChain)
                   (member (cdr (assoc 0 (entget polyE))) '("LWPOLYLINE" "POLYLINE")))
            (if (DEGQ:_touch-block-to-poly? blkObj polyE tolTouch)
              (setq touchedByChain T)
            )
          )
        )

        (if touchedByChain
          (progn
            (setq ipd (DEGQ:_v2l (vla-get-InsertionPoint blkObj)))
            (if ipd
              (progn
                (setq mnw (list (- (car ipd) tolTouch) (- (cadr ipd) tolTouch) 0.0))
                (setq mxw (list (+ (car ipd) tolTouch) (+ (cadr ipd) tolTouch) 0.0))

                (setq ssCand (ssget "_C" mnw mxw '((0 . "LWPOLYLINE,POLYLINE"))))
                (if ssCand
                  (progn
                    (setq newSeeds nil)
                    (setq j 0)
                    (while (< j (sslength ssCand))
                      (setq candE (ssname ssCand j))

                      (if (DEGQ:_touch-block-to-poly? blkObj candE tolTouch)
                        (progn
                          (if (DEGQ:_poly-touches-any-selected-block? candE ssBlocksNoDoseme tolTouch)
                            (setq newSeeds (cons candE newSeeds))
                          )
                        )
                      )

                      (setq j (1+ j))
                    )

                    (foreach candE newSeeds
                      (if (and candE (= (type candE) 'ENAME))
                        (if (not (DEGQ:_handle-in-list (DEGQ:_ename-handle candE) hChain))
                          (progn
                            (setq added (DEGN-DEGA--chain candE))
            (setq added (DEGQ:_filter-chain-cctv added))
                            (if added
                              (progn
                                (setq pack (DEGQ:_append-unique-by-handle hChain chain added))
                                (setq hChain (car pack))
                                (setq chain  (cadr pack))
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )

        (setq i (1+ i))
      )
      chain
    )
  )
)

  



