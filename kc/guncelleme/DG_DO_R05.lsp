(defun DEGZ--distpair10 (distMid dirSign maxDist half / d1 d2)
  ;; distMid etrafÄ±nda Â±half (toplam 2*half) olacak ÅŸekilde iki mesafe Ã¼retir.
  ;; UÃ§larda (0 / maxDist) 10 birimi korumak iÃ§in iÃ§eri kaydÄ±rÄ±r.
  (setq full (* 2.0 half))
  (setq d1 (- distMid (* half dirSign)))
  (setq d2 (+ distMid (* half dirSign)))

  ;; Ã¶nce kaba clamp
  (setq d1 (DEGZ--clamp d1 0.0 maxDist))
  (setq d2 (DEGZ--clamp d2 0.0 maxDist))

  ;; eÄŸer 10 birim bozulduysa, uca gÃ¶re dÃ¼zelt
  (if (< (abs (- d2 d1)) (- full 1e-3))
    (cond
      ;; baÅŸlangÄ±ca Ã§ok yakÄ±n
      ((< distMid half)
        (if (>= dirSign 0.0)
          (progn (setq d1 0.0) (setq d2 (DEGZ--clamp full 0.0 maxDist)))
          (progn (setq d2 0.0) (setq d1 (DEGZ--clamp full 0.0 maxDist)))
        )
      )
      ;; sona Ã§ok yakÄ±n
      ((< (- maxDist distMid) half)
        (if (>= dirSign 0.0)
          (progn (setq d2 maxDist) (setq d1 (DEGZ--clamp (- maxDist full) 0.0 maxDist)))
          (progn (setq d1 maxDist) (setq d2 (DEGZ--clamp (- maxDist full) 0.0 maxDist)))
        )
      )
    )
  )

  (list d1 d2)
)

(defun DEGZ--closest-on-seg (a b p / ax ay bx by px py abx aby apx apy den tt cx cy dx dy)
  (setq a (DEGZ--pt2d a) b (DEGZ--pt2d b) p (DEGZ--pt2d p))
  (setq ax (car a) ay (cadr a))
  (setq bx (car b) by (cadr b))
  (setq px (car p) py (cadr p))
  (setq abx (- bx ax) aby (- by ay))
  (setq apx (- px ax) apy (- py ay))
  (setq den (+ (* abx abx) (* aby aby)))
  (if (< den 1e-12)
    (list a (+ (* apx apx) (* apy apy)))
    (progn
      (setq tt (/ (+ (* apx abx) (* apy aby)) den))
      (setq tt (DEGZ--clamp tt 0.0 1.0))
      (setq cx (+ ax (* tt abx)))
      (setq cy (+ ay (* tt aby)))
      (setq dx (- px cx))
      (setq dy (- py cy))
      (list (list cx cy) (+ (* dx dx) (* dy dy)))
    )
  )
)

(defun DEGZ--poly-closest-seg-index (pts p closed70 / n lim i a b res d2 bestI bestD)
  (setq pts (mapcar 'DEGZ--pt2d pts))
  (setq p (DEGZ--pt2d p))
  (setq n (length pts))
  (if (< n 2)
    0
    (progn
      (setq lim (if (/= (logand closed70 1) 0) n (1- n)))
      (setq i 0 bestI 0 bestD 1e99)
      (while (< i lim)
        (setq a (nth i pts))
        (setq b (nth (if (= i (1- n)) 0 (1+ i)) pts))
        (setq res (DEGZ--closest-on-seg a b p))
        (setq d2 (cadr res))
        (if (< d2 bestD)
          (progn (setq bestD d2) (setq bestI i))
        )
        (setq i (1+ i))
      )
      bestI
    )
  )
)

(defun DEGZ--poly-closest-on-seg (pts segIdx p closed70 / n a b res)
  (setq pts (mapcar 'DEGZ--pt2d pts))
  (setq p (DEGZ--pt2d p))
  (setq n (length pts))
  (if (< n 2)
    p
    (progn
      (setq a (nth segIdx pts))
      (setq b (nth (if (= segIdx (1- n)) 0 (1+ segIdx)) pts))
      (setq res (DEGZ--closest-on-seg a b p))
      (car res)
    )
  )
)

(defun DEGZ--cpE-side (crv cp join rx ry / e d tot pPlus pMin v1x v1y v2x v2y s1 s2 rPlus rMin)
  (setq e (DEGZ--ename crv))
  (setq cp (DEGZ--pt2d-safe cp nil))
  (if (or (not e) (not cp))
    cp
    (progn
      (setq d   (deg-safe-dist-at-point e cp))
      (setq tot (DEGZ--curve-total e))
      (setq rPlus (vl-catch-all-apply 'vlax-curve-getPointAtDist (list e (min tot (+ d join)))))
      (setq rMin  (vl-catch-all-apply 'vlax-curve-getPointAtDist (list e (max 0.0 (- d join)))))
      (setq pPlus (if (vl-catch-all-error-p rPlus) cp (DEGZ--pt2d-safe rPlus cp)))
      (setq pMin  (if (vl-catch-all-error-p rMin)  cp (DEGZ--pt2d-safe rMin  cp)))
      (if (and pPlus pMin)
        (progn
          (setq v1x (- (car pPlus) (car cp)))
          (setq v1y (- (cadr pPlus) (cadr cp)))
          (setq v2x (- (car pMin) (car cp)))
          (setq v2y (- (cadr pMin) (cadr cp)))
          (setq s1 (+ (* v1x rx) (* v1y ry)))
          (setq s2 (+ (* v2x rx) (* v2y ry)))
          (if (>= s1 s2) pPlus pMin)
        )
        cp
      )
    )
  )
)

(defun DEGZ--cpE-side-flag (crv cp join choosePlus / e d tot pPlus pMin rPlus rMin)
  (setq e (DEGZ--ename crv))
  (setq cp (DEGZ--pt2d-safe cp nil))
  (if (or (not e) (not cp))
    cp
    (progn
      (setq d   (deg-safe-dist-at-point e cp))
      (setq tot (DEGZ--curve-total e))
      (setq rPlus (vl-catch-all-apply 'vlax-curve-getPointAtDist (list e (min tot (+ d join)))))
      (setq rMin  (vl-catch-all-apply 'vlax-curve-getPointAtDist (list e (max 0.0 (- d join)))))
      (setq pPlus (if (vl-catch-all-error-p rPlus) cp (DEGZ--pt2d-safe rPlus cp)))
      (setq pMin  (if (vl-catch-all-error-p rMin)  cp (DEGZ--pt2d-safe rMin  cp)))
      (if choosePlus pPlus pMin)
    )
  )
)

(defun DEGZ--shorten-toward-cp (crv cp cpE short / e dcp dE tot dNew res)
  (setq e (DEGZ--ename crv))
  (setq cp  (DEGZ--pt2d-safe cp nil))
  (setq cpE (DEGZ--pt2d-safe cpE cp))
  (if (or (not e) (not cp) (not cpE))
    cpE
    (progn
      (setq dcp (deg-safe-dist-at-point e cp))
      (setq dE  (deg-safe-dist-at-point e cpE))
      (setq tot (DEGZ--curve-total e))
      (if (>= dE dcp)
        (setq dNew (max dcp (- dE short)))
        (setq dNew (min dcp (+ dE short)))
      )
      (setq res (vl-catch-all-apply 'vlax-curve-getPointAtDist (list e (DEGZ--clamp dNew 0.0 tot))))
      (if (vl-catch-all-error-p res)
        cpE
        (DEGZ--pt2d-safe res cpE)
      )
    )
  )
)

(defun DEGZ--right-angle3-p (a b c / pa pb pc ux uy vx vy lenU lenV dot tol)
  (setq pa (DEGZ--pt2d-safe a nil))
  (setq pb (DEGZ--pt2d-safe b nil))
  (setq pc (DEGZ--pt2d-safe c nil))
  (if (and pa pb pc)
    (progn
      (setq ux (- (car pa) (car pb)))
      (setq uy (- (cadr pa) (cadr pb)))
      (setq vx (- (car pc) (car pb)))
      (setq vy (- (cadr pc) (cadr pb)))
      (setq lenU (sqrt (+ (* ux ux) (* uy uy))))
      (setq lenV (sqrt (+ (* vx vx) (* vy vy))))
      (setq dot (+ (* ux vx) (* uy vy)))
      (setq tol (* 1e-6 (max 1.0 (* lenU lenV))))
      (and (> lenU 1e-8)
           (> lenV 1e-8)
           (<= (abs dot) tol))
    )
    nil
  )
)

(defun DEGZ--snap-close-double-turns (pts limit / src out clean snapped a b c d newB newC leftDist rightDist chooseLeft p tol)
  ;; A-B-C-D icinde B ve C yakin iki 90 derece koseyse, kisa B-C
  ;; donusunu A veya D dis komsusundan daha yakin olanin hizasina tasi.
  (setq src (mapcar 'DEGZ--pt2d pts))
  (setq out '())
  (setq tol (* 1e-6 (max 1.0 limit)))
  (while src
    (setq snapped nil)
    (if (>= (length src) 4)
      (progn
        (setq a (car src))
        (setq b (cadr src))
        (setq c (caddr src))
        (setq d (cadddr src))
        (if (and (<= (DEGZ--safe-distance b c) (+ limit tol))
                 (DEGZ--right-angle3-p a b c)
                 (DEGZ--right-angle3-p b c d))
          (progn
            ;; Her 90 derece kosenin dis komsusuna olan mesafesine bak.
            ;; A-B daha kisaysa A hizzasi, C-D daha kisaysa D hizzasi kazanir.
            (setq leftDist  (DEGZ--safe-distance a b))
            (setq rightDist (DEGZ--safe-distance c d))
            (setq chooseLeft
              (cond
                ((< leftDist (- rightDist tol)) T)
                ((< rightDist (- leftDist tol)) nil)
                ;; Esitlikte vertex sirasi degisse de ayni fiziksel nokta secilsin.
                ((< (car a) (car d)) T)
                ((> (car a) (car d)) nil)
                ((<= (cadr a) (cadr d)) T)
                (T nil)
              )
            )
            (if chooseLeft
              (progn
                ;; B, A ile cakisacagi icin sifir boylu parcayi ekleme.
                (setq newC
                  (list (+ (car a) (- (car c) (car b)))
                        (+ (cadr a) (- (cadr c) (cadr b)))))
                (setq out (append out (list a newC)))
              )
              (progn
                ;; C, D ile cakisacak; kisa parcayi D tarafina tasi.
                (setq newB
                  (list (- (car d) (- (car c) (car b)))
                        (- (cadr d) (- (cadr c) (cadr b)))))
                (setq out (append out (list a newB)))
              )
            )
            (setq src (cdddr src))
            (setq snapped T)
          )
        )
      )
    )
    (if (not snapped)
      (progn
        (setq out (append out (list (car src))))
        (setq src (cdr src))
      )
    )
  )

  ;; Tasima sonrasinda ayni konuma gelen ardisik noktalari tek noktaya indir.
  (setq clean '())
  (foreach p out
    (if (or (null clean)
            (> (DEGZ--safe-distance p (car clean)) 1e-7))
      (setq clean (cons p clean))
    )
  )
  (reverse clean)
)
(defun DEGZ--snap-close-double-turn-entity (crv limit / e pts origPts newPts props flags closed newEnt changed pass maxPass)
  ;; DZ bittikten sonra, uygun yakin cift dirsek kalmayana kadar final noktalarini tara.
  (setq e (DEGZ--ename crv))
  (if (or (not e) (not (numberp limit)) (<= limit 0.0))
    e
    (progn
      (setq pts (DEGZ--get-lwpts e))
      (setq origPts pts)
      (setq newPts pts)
      (setq changed T)
      (setq pass 0)
      ;; Her duzeltme nokta sayisini azalttigi icin baslangic nokta sayisi kesin sinirdir.
      (setq maxPass (max 1 (length pts)))
      (while (and changed (< pass maxPass))
        (setq pts newPts)
        (setq newPts (DEGZ--snap-close-double-turns pts limit))
        (setq changed (not (equal pts newPts 1e-8)))
        (setq pass (1+ pass))
      )
      (if (or (< (length newPts) 2) (equal origPts newPts 1e-8))
        e
        (progn
          (setq props (DEGZ--safe-props e))
          (setq flags (cdr (assoc 70 (entget e))))
          (if (not (numberp flags)) (setq flags 0))
          (setq closed (if (/= (logand flags 1) 0) 1 0))
          (entdel e)
          (setq newEnt (DEGZ--entmakex-lwpoly newPts props closed))
          (if newEnt
            newEnt
            (progn
              (entdel e)
              e
            )
          )
        )
      )
    )
  )
)
(defun DEGZ--actual-mouth (e a b route / firstPt lastPt span dx dy tol pa pb)
  ;; Only relocate mouths along the same straight baseline, never across a bend.
  (if (and route (cdr route) (> (setq span (distance a b)) 1e-9))
    (progn
      (setq firstPt (DEGZ--pt2d (car route)) lastPt (DEGZ--pt2d (last route))
            dx (/ (- (car b) (car a)) span)
            dy (/ (- (cadr b) (cadr a)) span) tol 1e-6)
      (if (and (> (distance firstPt lastPt) tol)
               (< (abs (- (* (- (car firstPt) (car a)) dy)
                          (* (- (cadr firstPt) (cadr a)) dx))) tol)
               (< (abs (- (* (- (car lastPt) (car a)) dy)
                          (* (- (cadr lastPt) (cadr a)) dx))) tol))
        (progn
          (setq pa (vl-catch-all-apply 'vlax-curve-getParamAtPoint
                     (list e (DEGZ--pt3d firstPt)))
                pb (vl-catch-all-apply 'vlax-curve-getParamAtPoint
                     (list e (DEGZ--pt3d lastPt))))
          (if (and (numberp pa) (numberp pb)
                   (equal (abs (- (vlax-curve-getDistAtParam e pa)
                                  (vlax-curve-getDistAtParam e pb)))
                          (distance firstPt lastPt) tol))
            (list firstPt lastPt pa pb)))))))

(defun DEGZ--insert-detour (crv attachA attachB midPts / e pts props pA pB tmp sIdx eIdx head tail k newPts firstPt lastPt keepScore revScore midNorm p routePts omitStart actualMouth)
  (setq e     (DEGZ--ename crv))
  (setq pts   (DEGZ--get-lwpts e))
  (setq props (DEGZ--safe-props e))

  (setq attachA (deg-safe-closest-point e attachA))
  (setq attachB (deg-safe-closest-point e attachB))

  (setq pA (vl-catch-all-apply 'vlax-curve-getParamAtPoint (list e (DEGZ--pt3d attachA))))
  (setq pB (vl-catch-all-apply 'vlax-curve-getParamAtPoint (list e (DEGZ--pt3d attachB))))
  (if (or (vl-catch-all-error-p pA) (vl-catch-all-error-p pB))
    crv
    (progn
      ;; midPts tek nokta ya da karisik liste gelebilir; sadece gercek noktalari kullan.
      (setq midNorm '())
      (cond
        ((null midPts)
          (setq midPts nil)
        )
        ((not (listp midPts))
          (setq midPts nil)
        )
        ((and (numberp (car midPts)) (numberp (cadr midPts)))
          (setq midPts (list (DEGZ--pt2d midPts)))
        )
        (T
          (foreach p midPts
            (if (and (listp p) (numberp (car p)) (numberp (cadr p)))
              (setq midNorm (append midNorm (list (DEGZ--pt2d p))))
            )
          )
          (setq midPts midNorm)
        )
      )

      (setq actualMouth (DEGZ--actual-mouth e attachA attachB midPts))
      (if actualMouth
        (setq attachA (car actualMouth) attachB (cadr actualMouth)
              pA (caddr actualMouth) pB (cadddr actualMouth)))
      ;; Polyline cizim yonu ters olsa bile agiz eslesmesi yakinliga gore kalsin.
      (if (and midPts (cdr midPts)
               (listp attachA) (numberp (car attachA)) (numberp (cadr attachA))
               (listp attachB) (numberp (car attachB)) (numberp (cadr attachB)))
        (progn
          (setq firstPt (DEGZ--pt2d (car midPts)))
          (setq lastPt  (DEGZ--pt2d (last midPts)))
          (setq keepScore (+ (DEGZ--safe-distance (DEGZ--pt2d attachA) firstPt) (DEGZ--safe-distance (DEGZ--pt2d attachB) lastPt)))
          (setq revScore  (+ (DEGZ--safe-distance (DEGZ--pt2d attachA) lastPt)  (DEGZ--safe-distance (DEGZ--pt2d attachB) firstPt)))
          (if (< revScore keepScore)
            (setq midPts (reverse midPts))
          )
        )
      )

      ;; Once yakinlik eslesmesi belirlendi. Simdi sadece polyline yeniden kurma
      ;; sirasi icin parametreleri sirala; eslesmis yolun tamamini birlikte cevir.
      (if (> pA pB)
        (progn
          (setq tmp attachA attachA attachB attachB tmp)
          (setq tmp pA pA pB pB tmp)
          (if midPts (setq midPts (reverse midPts)))
        )
      )

      (setq sIdx (fix pA))
      (setq eIdx (fix pB))

      (setq head '() k 0)
      (while (<= k sIdx)
        (setq head (append head (list (nth k pts))))
        (setq k (1+ k))
      )
      (setq head (DEGZ--ensure-last head attachA))

      (setq tail '() k (1+ eIdx))
      (while (< k (length pts))
        (setq tail (append tail (list (nth k pts))))
        (setq k (1+ k))
      )

      (setq routePts
        (append (list attachA) (mapcar 'DEGZ--pt2d midPts) (list attachB))
      )
      (setq routePts (DEGZ--trim-route-mouth-backtracks routePts))
      (DEGZ--dbg-route "FINAL" routePts)

      ;; Baslangic agzi: onceki ana hat noktasi - attachA - ilk rota noktasi.
      (setq omitStart nil)
      (if (and (>= (length head) 2)
               (>= (length routePts) 2)
               (DEGZ--mouth-redundant-p
                 (nth (- (length head) 2) head)
                 (car routePts)
                 (cadr routePts)))
        (progn
          (setq head (DEGZ--drop-last head))
          (setq routePts (cdr routePts))
          (setq omitStart T)
        )
      )

      ;; Bitis agzi: son rota noktasi - attachB - sonraki ana hat noktasi.
      (if (and tail
               (>= (length routePts) 2)
               (DEGZ--mouth-redundant-p
                 (nth (- (length routePts) 2) routePts)
                 (last routePts)
                 (car tail)))
        (setq routePts (DEGZ--drop-last routePts))
      )

      (if omitStart
        (setq newPts (append head routePts tail))
        (if routePts
          (setq newPts (append head (cdr routePts) tail))
          (setq newPts (append head tail))
        )
      )


      (entdel e)
      (DEGZ--entmakex-lwpoly newPts props 0)
    )
  )
)

(defun DEGZ--block-effective-name (en / vla nm ed)
  (setq en (DEGZ--ename en))
  (if (not en)
    nil
    (progn
      (setq ed (entget en))
      (setq nm (cdr (assoc 2 ed)))
      (if (and nm (= (substr nm 1 1) "*"))
        (progn
          (setq vla (vlax-ename->vla-object en))
          (if (vlax-property-available-p vla 'EffectiveName)
            (setq nm (vla-get-EffectiveName vla))
          )
        )
      )
      nm
    )
  )
)

(defun DEGZ--skip-block-p (blk / nm nmU)
  (setq nm  (DEGZ--block-effective-name blk))
  (setq nmU (strcase (if nm nm "")))
  (if (or (vl-string-search "FLASOR" nmU)
          (vl-string-search "FLAR"   nmU))
    T
    nil
  )
)

(defun DEGZ--block-wcs-center (blk / ip obj mn mx r mnL mxL)
  ;; Blok rotasyonundan bagimsiz taraf karari icin WCS bbox merkezini kullan.
  ;; Bbox okunamazsa eski INSERT/base noktasina duser.
  (setq ip (if (and blk (entget blk))
             (DEGZ--pt2d (cdr (assoc 10 (entget blk))))
             '(0.0 0.0)
           )
  )
  (setq obj (if (and blk (entget blk))
              (vl-catch-all-apply 'vlax-ename->vla-object (list blk))
              nil
            )
  )
  (if (or (null obj) (vl-catch-all-error-p obj))
    ip
    (progn
      (setq r (vl-catch-all-apply 'vla-getBoundingBox (list obj 'mn 'mx)))
      (if (or (vl-catch-all-error-p r) (null mn) (null mx))
        ip
        (progn
          (setq mnL (degw-_v2l mn))
          (setq mxL (degw-_v2l mx))
          (if (and (listp mnL) (listp mxL))
            (list (/ (+ (car mnL) (car mxL)) 2.0)
                  (/ (+ (cadr mnL) (cadr mxL)) 2.0))
            ip
          )
        )
      )
    )
  )
)
(defun DEGZ--floor (x)
  (if (>= x 0.0) (fix x) (1- (fix x)))
)

(defun DEGZ--cellkey (p cell / cx cy)
  (setq p (DEGZ--pt2d p))
  (setq cx (DEGZ--floor (/ (car p) cell)))
  (setq cy (DEGZ--floor (/ (cadr p) cell)))
  (list cx cy)
)

(defun DEGZ--cells-put (cells key val / rec)
  (if (setq rec (assoc key cells))
    (subst (cons key (cons val (cdr rec))) rec cells)
    (cons (list key val) cells)
  )
)

(defun DEGZ--uf-init (parents x)
  (if (assoc x parents) parents (cons (cons x x) parents))
)

(defun DEGZ--uf-find (parents x / p)
  (setq p (cdr (assoc x parents)))
  (if (null p) x
    (progn
      (while (and p (not (equal p x)))
        (setq x p)
        (setq p (cdr (assoc x parents)))
      )
      x
    )
  )
)

(defun DEGZ--uf-union (parents a b / ra rb rec)
  (setq ra (DEGZ--uf-find parents a))
  (setq rb (DEGZ--uf-find parents b))
  (if (not (equal ra rb))
    (progn
      (setq rec (assoc rb parents))
      (if rec
        (setq parents (subst (cons rb ra) rec parents))
        (setq parents (cons (cons rb ra) parents))
      )
    )
  )
  parents
)

(defun DEGZ--groups-build (parents data / groups blk rep r rec)
  (setq groups '())
  (foreach rec data
    (setq blk (car rec))
    (setq rep (DEGZ--uf-find parents blk))
    (if (setq r (assoc rep groups))
      (setq groups (subst (cons rep (cons rec (cdr r))) r groups))
      (setq groups (cons (list rep rec) groups))
    )
  )
  groups
)

(defun DEGZ--choosePlus-main (mainCrv ip cp join / vvx vvy uu dx dy rx ry rperp cpE d tot pPlus)
  (setq ip (DEGZ--pt2d ip))
  (setq cp (DEGZ--pt2d cp))

  (setq vvx (- (car ip) (car cp)))
  (setq vvy (- (cadr ip) (cadr cp)))
  (setq uu (DEGZ--unit vvx vvy))
  (setq dx (car uu) dy (cadr uu))

  (setq rperp (DEGZ--perp-axis-from-curve-safe mainCrv cp))
              (setq rx (car rperp))
              (setq ry (cadr rperp))

  (setq cpE (DEGZ--cpE-side mainCrv cp join rx ry))

  (setq d   (deg-safe-dist-at-point mainCrv cp))
  (setq tot (DEGZ--curve-total mainCrv))
  (setq pPlus (DEGZ--pt2d (vlax-curve-getPointAtDist (DEGZ--ename mainCrv) (min tot (+ d join)))))

  (if (<= (distance cpE pPlus) 1e-6) T nil)
)

(defun DEGZ--point-toward (a b dist / a2 b2 vx vy uu)
  (setq a2 (DEGZ--pt2d a))
  (setq b2 (DEGZ--pt2d b))
  (setq vx (- (car b2) (car a2)))
  (setq vy (- (cadr b2) (cadr a2)))
  (setq uu (DEGZ--unit vx vy))
  (if (> (caddr uu) 1e-12)
    (list (+ (car a2) (* (car uu) dist)) (+ (cadr a2) (* (cadr uu) dist)))
    a2
  )
)

(defun DEGZ--calc-L-corner (S B uPerp / S2 B2 c1 c2 d1 d2)
  ;; ORTHO KÃ–ÅE: BaÄŸlantÄ±lar sadece 0/90/180/270 olacak ÅŸekilde,
  ;; S -> corner -> B iki eksenli (yatay/dikey) kÄ±rÄ±lÄ±m Ã¼retir.
  (setq S2 (DEGZ--pt2d S))
  (setq B2 (DEGZ--pt2d B))

  ;; Ä°ki olasÄ± L kÃ¶ÅŸe
  (setq c1 (list (car S2) (cadr B2))) ; Ã¶nce dikey, sonra yatay
  (setq c2 (list (car B2) (cadr S2))) ; Ã¶nce yatay, sonra dikey

  ;; S'den daha kÄ±sa ilk bacaÄŸÄ± seÃ§
  (setq d1 (distance S2 c1))
  (setq d2 (distance S2 c2))
  (if (<= d1 d2) c1 c2)
)


(defun DEGZ--ortho-first-axis (ip cp)

(defun DEGZ--perp-axis-from-curve (crv pt / prm deriv tx ty)
  ;; ORTHO iÃ§in ana hattÄ±n tangent yÃ¶nÃ¼ne gÃ¶re (x/y) eksen-perp dÃ¶ndÃ¼rÃ¼r.
  ;; dönü?: (rx ry) birim vektÃ¶r (mutlak eksen), iÅŸaret sideFact ile verilir.
  (setq prm (vlax-curve-getParamAtPoint (DEGZ--ename crv) (DEGZ--pt3d pt)))
  (setq deriv (vlax-curve-getFirstDeriv (DEGZ--ename crv) prm))
  (setq tx (car deriv) ty (cadr deriv))
  (if (> (abs tx) (abs ty))
    (list 0.0 1.0)   ;; tangent yatay => perp dikey
    (list 1.0 0.0)   ;; tangent dikey => perp yatay
  )
)

  ;; T => once X (hfirst), NIL => once Y (vfirst)
  (< (abs (- (car (DEGZ--pt2d ip)) (car (DEGZ--pt2d cp))))
     (abs (- (cadr (DEGZ--pt2d ip)) (cadr (DEGZ--pt2d cp)))))
)

(defun DEGZ--direct-offset-end (base tip mouthA mouthB gap / span tx ty projection nx ny toward lateral setback)
  ;; The final legs are normal to the mouth, not necessarily to the block approach.
  ;; Both the rail gap and the setback toward the main line equal the offset.
  (setq span (distance mouthA mouthB))
  (if (or (<= span 1e-9) (<= gap 0.0))
    tip
    (progn
      (setq tx (/ (- (car mouthB) (car mouthA)) span)
            ty (/ (- (cadr mouthB) (cadr mouthA)) span)
            projection (+ (* (- (car tip) (car base)) tx)
                          (* (- (cadr tip) (cadr base)) ty))
            nx (- ty) ny tx
            toward (+ (* (- (car mouthA) (car base)) nx)
                      (* (- (cadr mouthA) (cadr base)) ny))
            lateral (if (< projection 0.0) (- gap) gap)
            setback (if (< toward 0.0) (- gap) gap))
      (list (+ (car base) (* lateral tx) (* setback nx))
            (+ (cadr base) (* lateral ty) (* setback ny))))))

(defun DEGZ--calc-L-corner (S B uPerp / S2 B2 up ux uy utx uty vx vy projT)
  ;; Vektorel kose:
  ;; S -> corner ana hat dogrultusunda,
  ;; corner -> B ise uPerp dogrultusunda gider.
  (setq S2 (DEGZ--pt2d S))
  (setq B2 (DEGZ--pt2d B))
  (setq up (DEGZ--pt2d uPerp))
  (setq ux (car up))
  (setq uy (cadr up))

  (if (< (+ (* ux ux) (* uy uy)) 1e-12)
    S2
    (progn
      (setq utx (- uy))
      (setq uty ux)
      (setq vx (- (car B2) (car S2)))
      (setq vy (- (cadr B2) (cadr S2)))
      (setq projT (+ (* vx utx) (* vy uty)))
      (list (+ (car S2) (* utx projT))
            (+ (cadr S2) (* uty projT)))
    )
  )
)
