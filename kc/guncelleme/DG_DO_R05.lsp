(defun deg-endpoint-touch? (plObj blkObj tol / sp ep ins)
  (setq sp  (vlax-curve-getStartPoint plObj))
  (setq ep  (vlax-curve-getEndPoint   plObj))
  (setq ins (deg-get-inspt blkObj))
  (and ins
       (or (< (distance sp ins) tol)
           (< (distance ep ins) tol)))
)

(defun deg-get-inspt (objOrPt / res v curvePt)
  (cond
    ((and (listp objOrPt) (>= (length objOrPt) 2))
      (deg-pt3 objOrPt)
    )
    (T
      (setq res (vl-catch-all-apply 'vlax-get-property (list objOrPt 'InsertionPoint)))
      (if (vl-catch-all-error-p res)
        (cond
          ((and (boundp '*degForceRefPt*)
                (deg-pt3 *degForceRefPt*))
            (deg-pt3 *degForceRefPt*))
          ((= (type objOrPt) 'VLA-OBJECT)
            (setq curvePt
              (vl-catch-all-apply
                (read "vlax-curve-getStartPoint")
                (list objOrPt)))
            (if (vl-catch-all-error-p curvePt)
              nil
              (deg-pt3 curvePt)))
          (T nil))
        (progn
          (setq v (if (= (type res) 'variant) (vlax-variant-value res) res))
          (cond
            ((= (type v) 'safearray) (deg-pt3 (vlax-safearray->list v)))
            ((listp v) (deg-pt3 v))
            (T nil)
          )
        )
      )
    )
  )
)

(defun vlax-safearray-p (x)
  (eq (type x) 'safearray)
)


(defun deg-pt3 (pt / v)
  (cond
    ((null pt) nil)
    ((= (type pt) 'VARIANT) (deg-pt3 (vlax-variant-value pt)))
    ((= (type pt) 'SAFEARRAY) (deg-pt3 (vlax-safearray->list pt)))
    ((and (listp pt) (>= (length pt) 3)
          (numberp (car pt)) (numberp (cadr pt)) (numberp (caddr pt)))
      (list (car pt) (cadr pt) (caddr pt)))
    ((and (listp pt) (= (length pt) 2)
          (numberp (car pt)) (numberp (cadr pt)))
      (list (car pt) (cadr pt) 0.0))
    (T nil)
  )
)

(defun deg-safe-closest-point (crv pt / p res)
  (setq p (deg-pt3 pt))
  (if (and crv p)
    (progn
      (setq res (vl-catch-all-apply (read "vlax-curve-getClosestPointTo") (list crv p)))
      (if (vl-catch-all-error-p res)
        nil
        (deg-pt3 res)
      )
    )
    nil
  )
)

(defun deg-safe-dist-at-point (crv pt / cp res)
  (setq cp (deg-safe-closest-point crv pt))
  (if (and crv cp)
    (progn
      (setq res (vl-catch-all-apply (read "vlax-curve-getDistAtPoint") (list crv cp)))
      (if (and (not (vl-catch-all-error-p res)) (numberp res))
        res
        0.0
      )
    )
    0.0
  )
)

(defun deg-key (s /)
