(defun DEGN-DEGA--chain (seed / candidates chain changed newc c hit blks blk hostFound hostPl hitB hitB2 ip touchPt gap)
  (setq DEGN-DEGA--CONNS nil)
  (setq DEGN-DEGA--BLCONNS nil)

  (setq blks (DEGN-DEGA--e_dosemeye_blocks))
  (setq candidates (vl-remove seed (if DEGN-DEGA--DATA-ONLY (DEGN-DEGA--all-polylines-data) (DEGN-DEGA--all-polylines))))
  (setq chain (list seed))
  (setq changed T)

  (while changed
    (setq changed nil)
    (setq newc '())

    (while candidates
      (setq c (car candidates))
      (setq candidates (cdr candidates))

      (setq hit (DEGN-DEGA--endpoints-hit-any-chain c chain DEGN-DEGA--TOL))
      (if hit
        (progn
          (setq chain (cons c chain))
          (setq changed T)

          (setq DEGN-DEGA--CONNS
                (cons (list c (nth 0 hit) (nth 1 hit) (nth 2 hit) (nth 3 hit)) DEGN-DEGA--CONNS))

          (DEGN-DEGA--draw-circle (nth 0 hit) DEGN-DEGA--TOL)
          (DEGN-DEGA--draw-circle (nth 2 hit) DEGN-DEGA--TOL)
        )
        (setq newc (cons c newc))
      )
    )
    (setq candidates (reverse newc))

    (foreach blk blks
      (setq hostFound nil)

      (foreach hostPl chain
        (if (not hostFound)
          (progn
            (setq hitB (DEGN-DEGA--pl-touches-block-tol hostPl blk DEGN-DEGA--TOL_DOSEME))
            (if hitB
              (progn
                (setq hostFound T)

                (setq ip (deg-get-inspt (DEGN-DEGA--vla blk)))
                (setq ip (list (car ip) (cadr ip) 0.0))

                (setq touchPt (car hitB) gap (cadr hitB))
                (if (not (DEGN-DEGA--blconn-exists-p ip hostPl))
                  (setq DEGN-DEGA--BLCONNS (cons (list "TOUCH" ip hostPl touchPt gap) DEGN-DEGA--BLCONNS))
                )
                (DEGN-DEGA--draw-circle ip DEGN-DEGA--TOL_DOSEME)
                (DEGN-DEGA--draw-circle touchPt DEGN-DEGA--TOL_DOSEME)

                (setq newc '())
                (while candidates
                  (setq c (car candidates))
                  (setq candidates (cdr candidates))
                  (setq hitB2 (DEGN-DEGA--pl-touches-block-tol c blk DEGN-DEGA--TOL_DOSEME))
                  (if hitB2
                    (progn
                      (setq touchPt (car hitB2) gap (cadr hitB2))
                      (if (not (DEGN-DEGA--blconn-exists-p ip c))
                        (setq DEGN-DEGA--BLCONNS (cons (list "TOUCH" ip c touchPt gap) DEGN-DEGA--BLCONNS))
                      )
                      (DEGN-DEGA--draw-circle ip DEGN-DEGA--TOL_DOSEME)
                      (DEGN-DEGA--draw-circle touchPt DEGN-DEGA--TOL_DOSEME)

                      (setq chain (cons c chain))
                      (setq changed T)
                    )
                    (setq newc (cons c newc))
                  )
                )
                (setq candidates (reverse newc))
              )
            )
          )
        )
      )
    )
  )
  (setq chain (vl-remove nil (mapcar '(lambda (x)
                                       (cond
                                         ((null x) nil)
                                         ((= (type x) 'VLA-OBJECT) (vlax-vla-object->ename x))
                                         (T x)))
                                     chain)))


  chain
)

(defun DEGN-DEGA--node-id (pt tol nodePts / id)
  (setq id nil)
  (foreach it nodePts
    (if (and (not id) (DEGN-DEGA--eq-tol pt (cdr it) tol))
      (setq id (car it))
    )
  )
  id
)

(defun DEGN-DEGA--add-node (pt nodePts / id)
  (setq id (length nodePts))
  (cons (cons id pt) nodePts)
)

(defun DEGN-DEGA--ensure-node (pt tol nodePts / id)
  (setq id (DEGN-DEGA--node-id pt tol nodePts))
  (if id
    (list id nodePts)
    (progn
      (setq nodePts (DEGN-DEGA--add-node pt nodePts))
      (list (car (car nodePts)) nodePts)
    )
  )
)

(defun DEGN-DEGA--adj-get (adj id) (cdr (assoc id adj)))

(defun DEGN-DEGA--adj-add (adj a b w / row)
  (setq row (assoc a adj))
  (if row
    (subst (cons a (cons (cons b w) (cdr row))) row adj)
    (cons (cons a (list (cons b w))) adj)
  )
)

(defun DEGN-DEGA--dget (dist id) (if (assoc id dist) (cdr (assoc id dist)) 1e99))
(defun DEGN-DEGA--dset (dist id v)
  (if (assoc id dist) (subst (cons id v) (assoc id dist) dist) (cons (cons id v) dist))
)

(defun DEGN-DEGA--min-unvisited (dist visited / bestId bestD it)
  (setq bestId nil bestD 1e99)
  (foreach it dist
    (if (and (not (member (car it) visited)) (< (cdr it) bestD))
      (progn (setq bestD (cdr it)) (setq bestId (car it)))
    )
  )
  bestId
)

(defun DEGN-DEGA--dijkstra (adj startId / dist visited u nbrs nb v alt)
  (setq dist (list (cons startId 0.0)))
  (setq visited '())
  (setq u (DEGN-DEGA--min-unvisited dist visited))
  (while u
    (setq visited (cons u visited))
    (setq nbrs (DEGN-DEGA--adj-get adj u))
    (foreach nb nbrs
      (setq v (car nb))
      (setq alt (+ (DEGN-DEGA--dget dist u) (cdr nb)))
      (if (< alt (DEGN-DEGA--dget dist v))
        (setq dist (DEGN-DEGA--dset dist v alt))
      )
    )
    (setq u (DEGN-DEGA--min-unvisited dist visited))
  )
  dist
)

(defun DEGN-DEGA--collect-splitpts-for-pl (pl conns tol / pts c)
  (setq pts (DEGN-DEGA--endpoints pl))

  (foreach c conns
    (if (= (nth 2 c) pl) (setq pts (cons (nth 3 c) pts)))
  )

  (foreach c DEGN-DEGA--BLCONNS
    (if (and (= (car c) "TOUCH") (= (caddr c) pl))
      (setq pts (cons (nth 3 c) pts))
    )
  )

  (DEGN-DEGA--uniq-pts pts tol)
)

(defun DEGN-DEGA--sort-pts-along-pl (pl pts / lst p par)
  (setq lst '())
  (foreach p pts
    (setq par (DEGN-DEGA--ptparam pl p))
    (if (numberp par)
      (setq lst (cons (list par p) lst)))
  )
  (vl-sort lst '(lambda (a b) (< (car a) (car b))))
)

(defun DEGN-DEGA--build-graph (chain conns tol / nodePts adj pl splitPts splSorted i a b ida idb resA resB
                                   distA distB oneMap endPt hostCp gap blkPt touchPt)
  (setq nodePts '())
  (setq adj '())
  (setq DEGN-DEGA--POLYNODESMAP '())

  (foreach pl chain
    (setq splitPts (DEGN-DEGA--collect-splitpts-for-pl pl conns tol))
    (if (and (boundp 'DEGN-DEGA--FORCED-SPLIT-PL)
             (boundp 'DEGN-DEGA--FORCED-SPLIT-PT)
             DEGN-DEGA--FORCED-SPLIT-PL
             DEGN-DEGA--FORCED-SPLIT-PT
             (equal pl DEGN-DEGA--FORCED-SPLIT-PL))
      (setq splitPts
        (cons DEGN-DEGA--FORCED-SPLIT-PT splitPts))
    )
    (setq splSorted (DEGN-DEGA--sort-pts-along-pl pl splitPts))

    (setq oneMap '())
    (foreach it splSorted
      (setq resA (DEGN-DEGA--ensure-node (cadr it) tol nodePts))
      (setq ida (car resA))
      (setq nodePts (cadr resA))
      (setq oneMap (cons (cons (car it) ida) oneMap))
    )
    (setq DEGN-DEGA--POLYNODESMAP (cons (cons pl (reverse oneMap)) DEGN-DEGA--POLYNODESMAP))

    (setq i 0)
    (while (< i (1- (length splSorted)))
      (setq a (nth i splSorted))
      (setq b (nth (1+ i) splSorted))

      (setq ida (cdr (assoc (car a) (cdr (assoc pl DEGN-DEGA--POLYNODESMAP)))))
      (setq idb (cdr (assoc (car b) (cdr (assoc pl DEGN-DEGA--POLYNODESMAP)))))

      (setq distA (DEGN-DEGA--distAtParam pl (car a)))
      (setq distB (DEGN-DEGA--distAtParam pl (car b)))
      (setq w (abs (- distB distA)))

      (setq adj (DEGN-DEGA--adj-add adj ida idb w))
      (setq adj (DEGN-DEGA--adj-add adj idb ida w))

      (setq i (1+ i))
    )
  )

  (foreach c conns
    (setq endPt (nth 1 c))
    (setq hostCp (nth 3 c))
    (setq gap (nth 4 c))

    (setq resA (DEGN-DEGA--ensure-node endPt tol nodePts))
    (setq ida (car resA)) (setq nodePts (cadr resA))

    (setq resB (DEGN-DEGA--ensure-node hostCp tol nodePts))
    (setq idb (car resB)) (setq nodePts (cadr resB))

    (setq adj (DEGN-DEGA--adj-add adj ida idb gap))
    (setq adj (DEGN-DEGA--adj-add adj idb ida gap))
  )

  (foreach c DEGN-DEGA--BLCONNS
    (if (= (car c) "TOUCH")
      (progn
        (setq blkPt   (cadr c))
        (setq touchPt (nth 3 c))
        (setq gap     (nth 4 c))

        (setq resA (DEGN-DEGA--ensure-node blkPt tol nodePts))
        (setq ida (car resA)) (setq nodePts (cadr resA))

        (setq resB (DEGN-DEGA--ensure-node touchPt tol nodePts))
        (setq idb (car resB)) (setq nodePts (cadr resB))

        (setq adj (DEGN-DEGA--adj-add adj ida idb gap))
        (setq adj (DEGN-DEGA--adj-add adj idb ida gap))
      )
    )
  )

  (list nodePts adj DEGN-DEGA--POLYNODESMAP)
)

(defun DEGN-DEGA--build-graph-at
  (chain conns tol forcedPl forcedPt
   / DEGN-DEGA--FORCED-SPLIT-PL DEGN-DEGA--FORCED-SPLIT-PT)
  ;; Yerel/dinamik baglar eski 3 argumanli build-graph API'sini korur.
  (setq DEGN-DEGA--FORCED-SPLIT-PL forcedPl
        DEGN-DEGA--FORCED-SPLIT-PT forcedPt)
  (DEGN-DEGA--build-graph chain conns tol)
)

(defun DEGN-DEGA--closest-on-chain (pt chain / best pl cp curd o thiscp lay)
  (setq best nil pl nil cp nil)

  ;; 1. pas: TV/TELEFON layerlarini atla
  (foreach e chain
    (setq o (DEGN-DEGA--vla e))
    (setq lay (vla-get-Layer o))
    (if (not (DEGN-DEGA--layer-tv-tel-p lay))
      (progn
        (setq thiscp (deg-safe-closest-point o (list (car pt) (cadr pt) 0.0)))
        (setq curd (distance (list (car pt) (cadr pt) 0.0)
                             (list (car thiscp) (cadr thiscp) 0.0)))
        (if (or (not best) (< curd best))
          (progn (setq best curd) (setq pl e) (setq cp thiscp))
        )
      )
    )
  )

  ;; 2. pas: eger hepsi TV/TELEFON ise (pl nil), eski davranis
  (if (not pl)
    (progn
      (setq best nil pl nil cp nil)
      (foreach e chain
        (setq o (DEGN-DEGA--vla e))
        (setq thiscp (deg-safe-closest-point o (list (car pt) (cadr pt) 0.0)))
        (setq curd (distance (list (car pt) (cadr pt) 0.0)
                             (list (car thiscp) (cadr thiscp) 0.0)))
        (if (or (not best) (< curd best))
          (progn (setq best curd) (setq pl e) (setq cp thiscp))
        )
      )
    )
  )

  (list best pl cp)
)


(defun DEGN-DEGA--bracket-nodes-on-pl (pl polyMap cp / par lst i left right a b)
  (setq par (DEGN-DEGA--ptparam pl cp))
  (setq lst polyMap)
  (setq left (car lst))
  (setq right (last lst))
  (setq i 0)
  (while (< i (1- (length lst)))
    (setq a (nth i lst))
    (setq b (nth (1+ i) lst))
    (if (and (<= (car a) par) (<= par (car b)))
      (progn (setq left a) (setq right b) (setq i (length lst)))
    )
    (setq i (1+ i))
  )
  (list par left right)
)

(defun DEGN-DN--poly-route-info
  (pl cp polyNodesMap dist
   / m bkt par left right leftId rightId dcp dl dr da db d1 d2 route leftD rightD anchor)
  (setq m (cdr (assoc pl polyNodesMap)))
  (if (and m cp)
    (progn
      (setq bkt
        (vl-catch-all-apply
          'DEGN-DEGA--bracket-nodes-on-pl
          (list pl m cp)))
      (if (not (vl-catch-all-error-p bkt))
        (progn
          (setq par (car bkt)
                left (cadr bkt)
                right (caddr bkt)
                leftId (if (and left (listp left)) (cdr left))
                rightId (if (and right (listp right)) (cdr right)))
          (if (and (numberp par)
                   left
                   right
                   (listp left)
                   (listp right)
                   leftId
                   rightId)
            (progn
              (setq dcp (DEGN-DEGA--distAtParam pl par)
                    dl (DEGN-DEGA--distAtParam pl (car left))
                    dr (DEGN-DEGA--distAtParam pl (car right)))
              (if (and (numberp dcp)
                       (numberp dl)
                       (numberp dr))
                (progn
                  (setq da (abs (- dcp dl))
                        db (abs (- dr dcp))
                        d1 (+ (DEGN-DEGA--dget dist leftId) da)
                        d2 (+ (DEGN-DEGA--dget dist rightId) db)
                        route (min d1 d2)
                        leftD (DEGN-DEGA--dget dist leftId)
                        rightD (DEGN-DEGA--dget dist rightId)
                        anchor (if (> leftD rightD) leftId rightId))
                  (list route anchor pl cp)
                )
              )
            )
          )
        )
      )
    )
  )
)

(defun DEGN-DN--block-host-info
  (blk chain polyNodesMap dist
   / blkObj ip3 plE plObj cpRes cp info d2d bestInfo bestContact bestRoute)
  ;; DATA/CCTV numaralandirmasinda DATA, TELEFON ve TV hatlarinin
  ;; tamamini gercek temas adayi olarak kullanir.
  (setq blkObj (DEGN-DEGA--vla blk)
        ip3 (if blkObj (deg-get-inspt blkObj))
        bestInfo nil
        bestContact nil
        bestRoute nil)
  (if ip3
    (progn
      (foreach plE chain
        (setq plObj (DEGN-DEGA--vla plE)
              cpRes
                (if plObj
                  (vl-catch-all-apply
                    'block-ref-contact-point
                    (list plObj blkObj DEGN-DEGA--TOL_DOSEME))))
        (if (and cpRes
                 (not (vl-catch-all-error-p cpRes)))
          (progn
            (setq cp cpRes
                  info
                    (DEGN-DN--poly-route-info
                      plE cp polyNodesMap dist))
            (if info
              (progn
                (setq d2d
                  (distance
                    (list (car ip3) (cadr ip3) 0.0)
                    (list (car cp) (cadr cp) 0.0)))
                (if (or
                      (not bestInfo)
                      (< d2d (- bestContact 0.001))
                      (and
                        (equal d2d bestContact 0.001)
                        (< (car info) bestRoute)))
                  (setq bestInfo info
                        bestContact d2d
                        bestRoute (car info))
                )
              )
            )
          )
        )
      )

      ;; Gercek temas bulunamazsa tum DATA/TELEFON/TV zincirinde
      ;; base noktasina en yakin graph kenarini kullan.
      (if (not bestInfo)
        (foreach plE chain
          (setq plObj (DEGN-DEGA--vla plE)
                cp
                  (if plObj
                    (deg-safe-closest-point plObj ip3)))
          (if cp
            (progn
              (setq info
                      (DEGN-DN--poly-route-info
                        plE cp polyNodesMap dist)
                    d2d
                      (distance
                        (list (car ip3) (cadr ip3) 0.0)
                        (list (car cp) (cadr cp) 0.0)))
              (if (and info
                       (or
                         (not bestInfo)
                         (< d2d (- bestContact 0.001))
                         (and
                           (equal d2d bestContact 0.001)
                           (< (car info) bestRoute))))
                (setq bestInfo info
                      bestContact d2d
                      bestRoute (car info))
              )
            )
          )
        )
      )
    )
  )
  (if bestInfo
    (append bestInfo (list bestContact))
  )
)

(defun DEGN-DEGA--block-chain-distance (blk chain tol polyNodesMap dist / info)
  (setq info
    (DEGN-DN--block-host-info
      blk chain polyNodesMap dist))
  (if info (car info))
)

(defun DEGN-DN--children-add (children parent child / row kids)
  (setq row (assoc parent children))
  (if row
    (progn
      (setq kids (cdr row))
      (if (not (member child kids))
        (setq children
          (subst
            (cons parent (append kids (list child)))
            row children)))
    )
    (setq children
      (cons (cons parent (list child)) children))
  )
  children
)

(defun DEGN-DN--neighbor-records (adj node dist / row nb id seen out)
  (setq row (assoc node adj))
  (foreach nb (if row (cdr row) nil)
    (setq id (car nb))
    (if (not (member id seen))
      (progn
        (setq seen (cons id seen))
        (setq out
          (cons
            (list id (DEGN-DEGA--dget dist id))
            out))
      )
    )
  )
  (vl-sort out
    '(lambda (a b)
       (if (equal (cadr a) (cadr b) 0.000001)
         (< (car a) (car b))
         (< (cadr a) (cadr b)))))
)

(defun DEGN-DN--graph-children-bfs (adj dist startId / visited queue node rec child children)
  ;; Graph'i tiklanan dugumden koklenen tek bir agaca cevirir.
  (setq visited (list startId)
        queue (list startId)
        children nil)
  (while queue
    (setq node (car queue)
          queue (cdr queue))
    (foreach rec (DEGN-DN--neighbor-records adj node dist)
      (setq child (car rec))
      (if (not (member child visited))
        (progn
          (setq visited (cons child visited)
                children
                  (DEGN-DN--children-add
                    children node child)
                queue (append queue (list child)))
        )
      )
    )
  )
  children
)

(defun DEGN-DN--node-point (nodePts id / row)
  (setq row (assoc id nodePts))
  (if row (cdr row) nil)
)

(defun DEGN-DN--unit-xy (a b / dx dy len)
  (if (and a b)
    (progn
      (setq dx (- (car b) (car a))
            dy (- (cadr b) (cadr a))
            len (sqrt (+ (* dx dx) (* dy dy))))
      (if (> len 0.000000001)
        (list (/ dx len) (/ dy len))
      )
    )
  )
)

(defun DEGN-DN--ordered-children
  (node parent children nodePts dist
   / kids nodePt parentPt inVec child childPt outVec dot bestDot continuation recs flag childDist edgeLen angleVal)
  (setq kids (cdr (assoc node children))
        nodePt (DEGN-DN--node-point nodePts node)
        parentPt (if parent (DEGN-DN--node-point nodePts parent))
        inVec (DEGN-DN--unit-xy parentPt nodePt)
        bestDot -2.0
        continuation nil)

  ;; Bir ayrimda gelis yonunu en cok koruyan kol ana devamdir.
  ;; Yan dallar once bitirilir, ana devam en sona birakilir.
  (if (and inVec (> (length kids) 1))
    (foreach child kids
      (setq childPt (DEGN-DN--node-point nodePts child)
            outVec (DEGN-DN--unit-xy nodePt childPt))
      (if outVec
        (progn
          (setq dot
            (+ (* (car inVec) (car outVec))
               (* (cadr inVec) (cadr outVec))))
          (if (> dot bestDot)
            (setq bestDot dot
                  continuation child))
        )
      )
    )
  )
  (if (< bestDot 0.70)
    (setq continuation nil))

  (foreach child kids
    (setq childPt (DEGN-DN--node-point nodePts child)
          flag (if (and continuation (= child continuation)) 1 0)
          childDist (DEGN-DEGA--dget dist child)
          edgeLen (if (and nodePt childPt) (distance nodePt childPt) 1e99)
          angleVal (if (and nodePt childPt) (angle nodePt childPt) 0.0)
          recs
            (cons
              (list child flag childDist edgeLen angleVal)
              recs))
  )
  (setq recs
    (vl-sort recs
      '(lambda (a b)
         (cond
           ((/= (cadr a) (cadr b))
            (< (cadr a) (cadr b)))
           ((not (equal (caddr a) (caddr b) 0.000001))
            (< (caddr a) (caddr b)))
           ((not (equal (cadddr a) (cadddr b) 0.000001))
            (< (cadddr a) (cadddr b)))
           ((not (equal (nth 4 a) (nth 4 b) 0.000001))
            (< (nth 4 a) (nth 4 b)))
           (T (< (car a) (car b)))))))
  (mapcar 'car recs)
)

(defun DEGN-DN--graph-edge-ranks
  (children dist startId nodePts / stack visited item node parent child rank ranks ordered)
  ;; DFS sirasi: bir dal ve butun alt dallari bitmeden kardes dala gecilmez.
  (setq stack (list (list startId nil))
        visited nil
        rank 0
        ranks (list (cons startId 0)))
  (while stack
    (setq item (car stack)
          stack (cdr stack)
          node (car item)
          parent (cadr item))
    (if (not (member node visited))
      (progn
        (setq visited (cons node visited))
        (if (/= node startId)
          (progn
            (setq rank (1+ rank))
            (setq ranks (cons (cons node rank) ranks)))
        )
        (setq ordered
          (DEGN-DN--ordered-children
            node parent children nodePts dist))
        (foreach child (reverse ordered)
          (setq stack (cons (list child node) stack)))
      )
    )
  )
  ranks
)

(defun DEGN-DN--block-anchor-node
  (blk chain polyNodesMap dist / info)
  (setq info
    (DEGN-DN--block-host-info
      blk chain polyNodesMap dist))
  (if info (cadr info))
)

(defun DEGN-DEGA--chain-ends (chain tol / pts uniq deg p e ep ends)
  (setq pts '())
  (foreach e chain (setq pts (append pts (DEGN-DEGA--endpoints e))))
  (setq uniq (DEGN-DEGA--uniq-pts pts tol))

  (setq ends '())
  (foreach p uniq
    (setq deg 0)
    (foreach e chain
      (setq ep (DEGN-DEGA--endpoints e))
      (if (or (DEGN-DEGA--eq-tol p (car ep) tol)
              (DEGN-DEGA--eq-tol p (cadr ep) tol))
        (setq deg (1+ deg))))
    (if (= deg 1) (setq ends (cons p ends))))
  ends
)

(defun DEGN-DEGA--blocks-near (pts tolBlock / res e ip lay src)
  (setq res (ssadd))
  (if DEGN-DEGA--SCOPE-ACTIVE
    (setq src DEGN-DEGA--SCOPE-BLOCKS)
    (setq src (DEGN-DEGA--scope-ss-to-list (ssget "X" '((0 . "INSERT")))))
  )
  (foreach e src
    (setq lay (cdr (assoc 8 (entget e))))
    (if (/= (strcase (if lay lay "")) (DEG:VAL 'O2))
      (progn
        (if (or (not DEGN-DEGA--DATA-ONLY) (DEGN-DEGA--layer-data-only-str-p lay))
          (progn
            (setq ip (deg-get-inspt (DEGN-DEGA--vla e)))
            (setq ip (list (car ip) (cadr ip)))
            (if (vl-some '(lambda (p) (<= (distance p ip) tolBlock)) pts)
              (ssadd e res)
            )
          )
        )
      )
    )
  )
  res
)
(defun DEGN-DEGA--ss-add-unique (ss e / i hit he hs cur)
  (if (and ss e (= (type e) 'ENAME))
    (progn
      (setq he (DEGN-DEGA--scope-handle e))
      (setq i 0 hit nil)
      (while (and (< i (sslength ss)) (not hit))
        (setq cur (ssname ss i))
        (setq hs (DEGN-DEGA--scope-handle cur))
        (if (or (equal e cur) (and he hs (= he hs)))
          (setq hit T)
        )
        (setq i (1+ i))
      )
      (if (not hit) (ssadd e ss))
    )
  )
  ss
)

(defun DEGN-DEGA--ss-union-unique (a b / out i)
  (setq out (ssadd))
  (if a
    (progn
      (setq i 0)
      (while (< i (sslength a))
        (setq out (DEGN-DEGA--ss-add-unique out (ssname a i)))
        (setq i (1+ i))
      )
    )
  )
  (if b
    (progn
      (setq i 0)
      (while (< i (sslength b))
        (setq out (DEGN-DEGA--ss-add-unique out (ssname b i)))
        (setq i (1+ i))
      )
    )
  )
  out
)

(defun DEGN-DEGA--block-touches-chain-p (blk chain tol / ip hit pl)
  (setq hit nil)
  (if (and blk (= (type blk) 'ENAME))
    (progn
      (setq ip (deg-get-inspt (DEGN-DEGA--vla blk)))
      (if ip
        (progn
          (setq ip (list (car ip) (cadr ip) 0.0))
          (foreach pl chain
            (if (and (not hit)
                     pl
                     (= (type pl) 'ENAME)
                     (DEGN-DEGA--scope-poly-p pl)
                     (DEGN-DEGA--pt->curve-hit ip pl tol))
              (setq hit T)
            )
          )
        )
      )
    )
  )
  hit
)

(defun DEGN-DEGA--blocks-touching-chain (chain tol / res src e lay)
  (setq res (ssadd))
  (if DEGN-DEGA--SCOPE-ACTIVE
    (setq src DEGN-DEGA--SCOPE-BLOCKS)
    (setq src (DEGN-DEGA--scope-ss-to-list (ssget "X" '((0 . "INSERT")))))
  )
  (foreach e src
    (if (and e (= (type e) 'ENAME) (DEGN-DEGA--scope-block-p e))
      (progn
        (setq lay (cdr (assoc 8 (entget e))))
        (if (/= (strcase (if lay lay "")) (DEG:VAL 'O2))
          (if (DEGN-DEGA--block-touches-chain-p e chain tol)
            (ssadd e res)
          )
        )
      )
    )
  )
  res
)
(defun DEGN-DEGA--pad2 (n / s) (setq s (itoa n)) (if (< (strlen s) 2) (strcat "0" s) s))

(defun DEGN-DN--number-count (blkObj / raw pairs pair n best)
  (setq best 1)
  (setq raw (vl-catch-all-apply 'get-adet-from-block (list blkObj)))
  (if (and (not (vl-catch-all-error-p raw))
           (numberp raw)
           (> raw 0))
    (setq best (max best (fix raw)))
  )
  (setq pairs (vl-catch-all-apply 'get-sembol-adi-from-block (list blkObj)))
  (if (and (not (vl-catch-all-error-p pairs)) (listp pairs))
    (foreach pair pairs
      (if (and (= (type pair) 'LIST)
               (numberp (cdr pair))
               (> (cdr pair) 0))
        (progn
          (setq n (fix (cdr pair)))
          (if (> n best) (setq best n))
        )
      )
    )
  )
  best
)

(defun DEGN-DN--number-range (start count / firstNum lastNum k suffix)
  (setq firstNum (if (numberp start) (fix start) 1)
        count    (if (and (numberp count) (> count 0)) (fix count) 1)
        lastNum  (+ firstNum count -1))
  (if (<= count 3)
    (progn
      (setq suffix ""
            k      firstNum)
      (while (<= k lastNum)
        (setq suffix
          (if (= suffix "")
            (DEGN-DEGA--pad2 k)
            (strcat suffix "," (DEGN-DEGA--pad2 k))))
        (setq k (1+ k))
      )
    )
    (setq suffix
      (strcat
        (DEGN-DEGA--pad2 firstNum)
        ",...,"
        (DEGN-DEGA--pad2 lastNum)))
  )
  (list suffix (1+ lastNum) firstNum lastNum)
)

(defun DEGN-DN--unique-block-order (items / seen out pair obj h)
  (setq seen '()
        out  '())
  (foreach pair items
    (setq obj (cdr pair)
          h   (if obj (vl-catch-all-apply 'vla-get-Handle (list obj)) nil))
    (if (vl-catch-all-error-p h) (setq h nil))
    (if (or (not h) (not (member h seen)))
      (progn
        (if h (setq seen (cons h seen)))
        (setq out (cons pair out))
      )
    )
  )
  (reverse out)
)

(defun DEGN-DEGA--set-attr (blk tag value / obj atts a ok)
  (setq ok nil)
  (setq obj (DEGN-DEGA--vla blk))
  (if (= (vla-get-HasAttributes obj) :vlax-true)
    (progn
      (setq atts (vlax-invoke obj 'GetAttributes))
      (foreach a atts
        (if (= (DEGN-DEGA--upper (vla-get-TagString a)) (DEGN-DEGA--upper tag))
          (progn (vla-put-TextString a value) (setq ok T))
        )
      )
    )
  )
  ok
)

(defun DEGN-DN--attr-tag-key (s / u)
  (setq u (vl-string-trim " \t\r\n" (if s (strcase s) "")))
  (vl-string-translate " -." "___" u)
)

(defun DEGN-DN--att-list (obj / raw hv)
  (setq raw nil)
  (if (and obj (vlax-method-applicable-p obj 'GetAttributes))
    (progn
      (setq hv (vl-catch-all-apply 'vla-get-HasAttributes (list obj)))
      (if (and (not (vl-catch-all-error-p hv)) (= hv :vlax-true))
        (setq raw (vl-catch-all-apply 'vlax-invoke (list obj 'GetAttributes)))
      )
    )
  )
  (cond
    ((vl-catch-all-error-p raw) nil)
    ((= (type raw) 'VARIANT)  (vlax-safearray->list (vlax-variant-value raw)))
    ((= (type raw) 'SAFEARRAY) (vlax-safearray->list raw))
    ((listp raw) raw)
    (T nil)
  )
)

(defun DEGN-DN--make-editable (obj / lay atts a)
  (if (and obj (= (type obj) 'VLA-OBJECT))
    (progn
      (setq lay (vl-catch-all-apply 'vla-get-Layer (list obj)))
      (if (not (vl-catch-all-error-p lay))
        (degk--ensure-layer-editable lay)
      )
      (setq atts (DEGN-DN--att-list obj))
      (foreach a atts
        (setq lay (vl-catch-all-apply 'vla-get-Layer (list a)))
        (if (not (vl-catch-all-error-p lay))
          (degk--ensure-layer-editable lay)
        )
      )
    )
  )
  obj
)

(defun DEGN-DN--put-sira-no (blk value / obj atts a ok tag res)
  (setq ok nil)
  (setq obj (DEG:VLA blk))
  (if obj
    (progn
      (DEGN-DN--make-editable obj)
      (setq atts (DEGN-DN--att-list obj))
      (foreach a atts
        (setq tag (vl-catch-all-apply 'vla-get-TagString (list a)))
        (if (and (not (vl-catch-all-error-p tag))
                 (= (DEGN-DN--attr-tag-key tag) "SIRA_NO"))
          (progn
            (setq res (vl-catch-all-apply 'vla-put-TextString (list a value)))
            (if (not (vl-catch-all-error-p res))
              (setq ok T)
            )
          )
        )
      )
      (if ok (vl-catch-all-apply 'vla-Update (list obj)))
    )
  )
  ok
)
(defun DEGN-DN--block-touch-normal-p (plObj blkObj tol / ins cp)
  (or
    (poly-touch-block? plObj blkObj tol)
    (and
      (setq ins (deg-get-inspt blkObj))
      (setq cp (deg-safe-closest-point plObj ins))
      (deg-pt3 ins)
      (deg-pt3 cp)
      (<= (distance (deg-pt3 ins) (deg-pt3 cp)) tol)
    )
  )
)



(defun DN_ORIG
  ( / tol loopName
     sel ent obj
     pickPt plStart plEnd
     idx
     txtEnt txtObj
     plLayer isDataLayer areaSS oldErr

     startPt chain signalChain ends blocks g nodePts adj polyNodesMap startId dist items sorted i blkEnt d n val wrote dnTreeChildren dnEdgeRanks dnHostResult dnHostInfo dnAnchor dnRank

     dStart dEnd useFromStart totalLen blkSS blkEnt2 blkObj
     j blockOrder insPt projPt curDist key
     attList att tag
     newStr
     blkName tolLocal
     adetUse rangeInfo
     blkLayer blkNameU L skipThis wroteSiraNo dnBlockCount dnWriteCount dnFailCount dnScanCount dnOldSkipCount dnOldFilterCount dnOldTouchFailCount dnOldAddCount dnFallbackLayer0Count dnFallbackIgnoreCount dnFallbackFilterCount dnFallbackTouchFailCount dnFallbackAddCount
     isFireLayer isFlasherLayer
  )

  (vl-load-com)
  (setq oldErr *error*)
  (defun *error* (msg)
    (DEGN-DEGA--scope-reset)
    (setq DEGN-DEGA--DATA-ONLY nil)
    (setq *error* oldErr)
    (if (and msg (not (wcmatch (strcase msg) "*BREAK*,*CANCEL*,*QUIT*")))
      (princ (strcat "\nDN hata: " msg))
    )
    (princ)
  )
  (setq tol DEGN-DEGA--TOL)

  (setq txtEnt (entsel "\nLoop adý için TEXT'e týklayýn veya elle yazmak için Enter: "))
  (if txtEnt
    (progn
      (setq txtObj (vlax-ename->vla-object (car txtEnt)))
      (setq loopName (get-entity-text txtObj))
      (if (not loopName)
        (setq loopName (getstring T "\nTEXT okunamadý, loop adýný elle yazýn: "))
      )
    )
    (setq loopName (getstring T "\nLoop adýný yazýn (boþ Enter = iptal): "))
  )
  (if (or (null loopName) (= loopName ""))
    (progn (princ "\n\nÝptal.") (princ) (exit))
  )

  (setq sel (entsel "\nDal polyline'ýný seçin: "))
  (if (not sel) (progn (princ "\n\nÝptal.") (princ) (exit)))
  (setq ent (car sel))
  (setq pickPt (cadr sel))
  (setq obj (vlax-ename->vla-object ent))

  (setq plLayer (strcase (vla-get-Layer obj)))
  (setq isDataLayer (DEGN-DEGA--layer-data-only-str-p plLayer))

  (setq plStart (vlax-curve-getStartPoint obj))
  (setq plEnd   (vlax-curve-getEndPoint   obj))
  (setq pickPt (DEGN-DN--pick-on-polyline obj pickPt))

  (if isDataLayer
    (progn
      (princ "\nDN DATA: Alan icindeki block ve polyline'lari secin: ")
      (setq areaSS (ssget '((0 . "INSERT,LWPOLYLINE,POLYLINE"))))
      (if (not areaSS)
        (progn
          (DEGN-DEGA--scope-reset)
          (setq DEGN-DEGA--DATA-ONLY nil)
          (setq *error* oldErr)
          (princ)
          (exit)
        )
      )
      (DEGN-DEGA--scope-set-from-ss areaSS ent)
      (setq idx (getint "\nBlok numaralandýrma baþlangýç sayýsý? "))
      (if (null idx) (setq idx 1))

      (setq startPt pickPt)

      (setq DEGN-DEGA--DATA-ONLY nil)
      (setq signalChain (DEGV:_filter-chain-data-tel-tv (DEGN-DEGA--chain ent)))
      (if (not signalChain)
        (progn (princ "\n\nHATA: DATA/TELEFON/TV zinciri bulunamadý.") (princ) (exit))
      )
      (setq chain signalChain)
      
      (setq ends   (DEGN-DEGA--chain-ends chain tol))
      (setq blocks (DEGN-DEGA--blocks-near ends DEGN-DEGA--TOLBLOCK))
      (setq blocks (DEGN-DEGA--ss-union-unique blocks (DEGN-DEGA--blocks-touching-chain chain DEGN-DEGA--TOLBLOCK)))
      (setq g
              (DEGN-DEGA--build-graph-at
                chain DEGN-DEGA--CONNS tol ent startPt))
      (setq nodePts     (nth 0 g))
      (setq adj         (nth 1 g))
      (setq polyNodesMap(nth 2 g))

      (setq startId (DEGN-DEGA--node-id startPt tol nodePts))
      (if (not startId)
        (progn (princ "\n\nHATA: Baþlangýç node bulunamadý.") (princ) (exit))
      )

      (setq dist (DEGN-DEGA--dijkstra adj startId))
      (setq dnTreeChildren
              (DEGN-DN--graph-children-bfs
                adj dist startId)
            dnEdgeRanks
              (DEGN-DN--graph-edge-ranks
                dnTreeChildren dist startId nodePts))

      (if (not blocks)
        (progn (princ "\n\nHATA: Zincir uçlarýnda blok bulunamadý.") (princ) (exit))
      )

      (setq items '())
      (setq i 0)
      (while (< i (sslength blocks))
        (setq blkEnt (ssname blocks i))
        (setq dnHostResult
                (vl-catch-all-apply
                  'DEGN-DN--block-host-info
                  (list blkEnt chain polyNodesMap dist))
              dnHostInfo
                (if (vl-catch-all-error-p dnHostResult)
                  nil dnHostResult)
              d
                (if dnHostInfo (car dnHostInfo)))
        (if (numberp d)
          (progn
            (setq dnAnchor
                    (cadr dnHostInfo)
                  dnRank
                    (if (and dnAnchor
                             (assoc dnAnchor dnEdgeRanks))
                      (cdr (assoc dnAnchor dnEdgeRanks))
                      1000000000))
            (setq items
              (cons
                (list dnRank d i blkEnt)
                items))
          )
        )
        (setq i (1+ i))
      )

      (if (null items)
        (progn (princ "\n\nHATA: Zincire oturan blok bulunamadý.") (princ) (exit))
      )

      (setq sorted
        (vl-sort items
          '(lambda (a b)
             (cond
               ((/= (car a) (car b))
                (< (car a) (car b)))
               ((not (equal (cadr a) (cadr b) 0.000001))
                (< (cadr a) (cadr b)))
               (T (< (caddr a) (caddr b)))))))

      (setq n idx)
      (foreach it sorted
        (setq blkEnt (nth 3 it))
        (setq val (strcat loopName "-" (DEGN-DEGA--pad2 n)))
        (setq wrote (DEGN-DEGA--set-attr blkEnt "SIRA_NO" val))
        (if wrote (setq n (1+ n)))
      )

      (sssetfirst nil nil)

      (princ (strcat "\nDEGN(DATA->DEGA): Yazýlan SIRA_NO: " (itoa (- n idx))))
      (princ)
    )

    (progn

      (setq isFireLayer
            (or (wcmatch plLayer (DEG:VAL 'K11))
                (wcmatch plLayer (DEG:VAL 'K9))))
      (setq isFlasherLayer
            (wcmatch plLayer "*FLAÞÖR*,*SOUNDER*"))

      ;; Eski davranýþ ayný polyline ikinci kez seçildiðinde soruyu atlayýp
      ;; önceki baþlangýç sayýsýný yeniden kullanýyordu. Bu durum özellikle
      ;; çoklu adetli bloklardan sonra numara aralýklarýný çakýþtýrabiliyordu.
      (setq idx (getint "\nBlok numaralandýrma baþlangýç sayýsý? "))
      (if (null idx) (setq idx 1))
      (setq *degn-last-poly* nil
            *degn-last-idx*  nil)

      (setq totalLen (vla-get-length obj))
      (setq pDist    (deg-safe-dist-at-point obj pickPt))
      (setq dStart   pDist)
      (setq dEnd     (- totalLen pDist))
      (setq useFromStart (<= dStart dEnd))

      (setq blkSS (ssget "_X" '((0 . "INSERT"))))
      (setq blockOrder '())
      (setq dnScanCount 0
            dnOldSkipCount 0
            dnOldFilterCount 0
            dnOldTouchFailCount 0
            dnOldAddCount 0
            dnFallbackLayer0Count 0
            dnFallbackIgnoreCount 0
            dnFallbackFilterCount 0
            dnFallbackTouchFailCount 0
            dnFallbackAddCount 0)

      (if blkSS
        (progn
          (setq j 0)
          (while (< j (sslength blkSS))
            (setq blkEnt2  (ssname blkSS j)
                  blkObj   (vlax-ename->vla-object blkEnt2))
            (setq blkName  (deg-block-name blkObj))
            (setq blkLayer (vla-get-Layer blkObj))
            (setq tolLocal (if (deg-wcmatch blkName "*MODL*") (max (DEG:CFG-TOL-NUM-OR 'DN_MODL_TOL 5.0) DEGN-DEGA--TOLBLOCK) DEGN-DEGA--TOLBLOCK))

            (setq blkNameU (strcase blkName)
                  L        (strcase plLayer))
            (setq skipThis
                  (or
                    (DEGN-DN--match-list-p blkNameU (DEGN-DN--cfg-list-or-codes 'DN_SKIP_BLOCKS '(K5 K18 K3 K4)))
                    (and
                      (DEGN-DN--match-list-p L (DEGN-DN--cfg-list-or-mix 'DN_SKIP_LAYER_PATTERNS '(K13 K14 K15) "*KARBONMONOKSIT*"))
                      (DEGN-DN--match-list-p blkNameU (DEGN-DN--cfg-list-or-codes 'DN_SKIP_LAYER_BLOCKS '(K6 K19)))
                    )
                  )
            )

            (setq dnScanCount (1+ dnScanCount))
            (cond
              (skipThis
                (setq dnOldSkipCount (1+ dnOldSkipCount))
              )
              ((not (deg-fire-flasher-filter plLayer blkName blkLayer))
                (setq dnOldFilterCount (1+ dnOldFilterCount))
              )
              ((not (DEGN-DN--block-touch-normal-p obj blkObj tolLocal))
                (setq dnOldTouchFailCount (1+ dnOldTouchFailCount))
              )
              (T
                (progn
                  (setq insPt   (deg-get-inspt blkObj))
                  (setq projPt  (deg-safe-closest-point obj insPt))
                  (setq curDist (deg-safe-dist-at-point obj projPt))
                  (setq key     (if useFromStart curDist (- totalLen curDist)))
                  (setq blockOrder (cons (cons key blkObj) blockOrder))
                  (setq dnOldAddCount (1+ dnOldAddCount))
                )
              )
            )
            (setq j (1+ j))
          )
        )
      )

      (if (and blkSS (null blockOrder))
        (progn
          (setq j 0)
          (while (< j (sslength blkSS))
            (setq blkEnt2 (ssname blkSS j)
                  blkObj  (vlax-ename->vla-object blkEnt2))
            (setq blkName  (deg-block-name blkObj))
            (setq blkLayer (vla-get-Layer blkObj))
            (cond
              ((= (strcase blkLayer) "0")
                (setq dnFallbackLayer0Count (1+ dnFallbackLayer0Count))
              )
              ((DEG:IGNORE-BLOCK-OBJ? blkObj)
                (setq dnFallbackIgnoreCount (1+ dnFallbackIgnoreCount))
              )
              ((not (deg-fire-flasher-filter plLayer blkName blkLayer))
                (setq dnFallbackFilterCount (1+ dnFallbackFilterCount))
              )
              ((not (DEGN-DN--block-touch-normal-p obj blkObj DEGN-DEGA--TOLBLOCK))
                (setq dnFallbackTouchFailCount (1+ dnFallbackTouchFailCount))
              )
              (T
                (progn
                  (setq insPt   (deg-get-inspt blkObj))
                  (setq projPt  (deg-safe-closest-point obj insPt))
                  (setq curDist (deg-safe-dist-at-point obj projPt))
                  (setq key     (if useFromStart curDist (- totalLen curDist)))
                  (setq blockOrder (cons (cons key blkObj) blockOrder))
                  (setq dnFallbackAddCount (1+ dnFallbackAddCount))
                )
              )
            )
            (setq j (1+ j))
          )
        )
      )

      (setq blockOrder (vl-sort blockOrder '(lambda (a b) (< (car a) (car b)))))
      (setq blockOrder (DEGN-DN--unique-block-order blockOrder))
      (setq dnBlockCount (length blockOrder)
            dnWriteCount 0
            dnFailCount 0)

      (foreach pair blockOrder
        (setq blkObj (cdr pair))
        (if (= :vlax-true (vla-get-HasAttributes blkObj))
          (progn
            (setq adetUse   (DEGN-DN--number-count blkObj)
                  rangeInfo (DEGN-DN--number-range idx adetUse)
                  newStr    (car rangeInfo))

            (setq wroteSiraNo
                  (DEGN-DN--put-sira-no blkObj (strcat loopName "-" newStr)))

            (if wroteSiraNo
              (progn
                (setq idx (cadr rangeInfo))
                (setq dnWriteCount (1+ dnWriteCount))
              )
              (setq dnFailCount (1+ dnFailCount))
            )
          )
        )
      )

      (sssetfirst nil nil)
      (princ
        (strcat
          "\n\nDN: Normal mod tamamlandi. Blok: "
          (itoa dnBlockCount)
          ", SIRA_NO yazilan: "
          (itoa dnWriteCount)
          ", yazilamayan: "
          (itoa dnFailCount)
        )
      )
      (if (= dnBlockCount 0)
        (progn
          (princ
            (strcat
              "\nDN debug: INSERT="
              (itoa dnScanCount)
              " eski[add="
              (itoa dnOldAddCount)
              ", skip="
              (itoa dnOldSkipCount)
              ", filter="
              (itoa dnOldFilterCount)
              ", touch="
              (itoa dnOldTouchFailCount)
              "] fallback[add="
              (itoa dnFallbackAddCount)
              ", layer0="
              (itoa dnFallbackLayer0Count)
              ", ignore="
              (itoa dnFallbackIgnoreCount)
              ", filter="
              (itoa dnFallbackFilterCount)
              ", touch="
              (itoa dnFallbackTouchFailCount)
              "]"
            )
          )
          (princ
            (strcat
              "\nDN active filter layers: fire="
              (vl-princ-to-string (DEGN-DN--cfg-list-or-codes 'DN_FILTER_FIRE_LAYER_PATTERNS '(K11 K10 K9)))
              " co="
              (vl-princ-to-string (DEGN-DN--cfg-list-or-codes 'DN_FILTER_CO_LAYER_PATTERNS '(K8)))
              " flasor="
              (vl-princ-to-string (DEGN-DN--cfg-list-or-codes 'DN_FILTER_FLASOR_LAYERS '(K1)))
              " sound="
              (vl-princ-to-string (DEGN-DN--cfg-list-or-codes 'DN_FILTER_SOUND_LAYER_PATTERNS '(K13 K14 K15)))
            )
          )
          (princ
            (strcat
              "\nDN active fire excludeBlock="
              (vl-princ-to-string (DEGN-DN--cfg-list-or-codes 'DN_FILTER_FIRE_BLOCK_EXCLUDES '(K13 K14 K15)))
            )
          )
        )
      )
      (princ)
    )
  )
  (DEGN-DEGA--scope-reset)
  (setq DEGN-DEGA--DATA-ONLY nil)
  (setq *error* oldErr)
  (princ)
)


(defun degw-sanitize-filename (name / res i c)
  (if (not name) (setq name "output"))
  (setq name (vl-string-translate "\n\r\t" "   " name))
  (setq res "")
  (setq i 1)
  (while (<= i (strlen name))
    (setq c (substr name i 1))
    (if (wcmatch c "[\\/:*?\"<>|]")
      (setq c "_")
    )
    (setq res (strcat res c))
    (setq i (1+ i))
  )
  (setq res (vl-string-trim " " res))
  (if (= res "") (setq res "output"))
  res
)

