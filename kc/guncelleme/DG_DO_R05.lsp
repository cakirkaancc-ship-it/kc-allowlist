(defun DEGDO--dn-cfg-or-codes (key codes / s)
  (setq s (DEGDO--trim (DEG:CFG-GET key)))
  (if (/= s "") s (DEGDO--codes-merged codes))
)

(defun DEGDO--dn-cfg-or-mix (key codes extra / s base)
  (setq s (DEGDO--trim (DEG:CFG-GET key)))
  (if (/= s "")
    s
    (progn
      (setq base (DEGDO--codes-merged codes))
      (if (= (DEGDO--trim extra) "")
        base
        (if (= base "") extra (strcat base "," extra))
      )
    )
  )
)

