(defun DT--palette-window-handle (/ app value)
  (vl-load-com)
  (setq app (vl-catch-all-apply 'vlax-get-acad-object '()))
  (if (and app (not (vl-catch-all-error-p app)))
    (setq value (vl-catch-all-apply 'vlax-get-property (list app 'HWND))))
  (if (and value (not (vl-catch-all-error-p value)) (numberp value))
    (fix value)
