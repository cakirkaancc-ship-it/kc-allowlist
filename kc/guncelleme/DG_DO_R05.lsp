(defun deg-fire-flasher-filter (plLayer blkName blkLayer / L B BL)
  (setq L  (strcase plLayer)
        B  (strcase blkName)
        BL (strcase blkLayer))
  (cond
    ((DEGN-DN--match-list-p B (DEGN-DN--cfg-list-or-codes 'DN_FILTER_IGNORE_BLOCKS '(N1 K2 N2))) nil)

    ((DEGN-DN--match-list-p L (DEGN-DN--cfg-list-or-codes 'DN_FILTER_FIRE_LAYER_PATTERNS '(K11 K10 K9)))
     (not (DEGN-DN--match-list-p B (DEGN-DN--cfg-list-or-codes 'DN_FILTER_FIRE_BLOCK_EXCLUDES '(K13 K14 K15))))
    )

    ((DEGN-DN--match-list-p L (DEGN-DN--cfg-list-or-codes 'DN_FILTER_CO_LAYER_PATTERNS '(K8)))
     (DEGN-DN--match-list-p B (DEGN-DN--cfg-list-or-codes 'DN_FILTER_CO_BLOCKS '(K7)))
    )

    ((DEGN-DN--match-list-p L (DEGN-DN--cfg-list-or-codes 'DN_FILTER_FLASOR_LAYERS '(K1)))
     (DEGN-DN--match-list-p B (DEGN-DN--cfg-list-or-codes 'DN_FILTER_FLASOR_BLOCKS '(K12)))
    )

    ((DEGN-DN--match-list-p L (DEGN-DN--cfg-list-or-codes 'DN_FILTER_SOUND_LAYER_PATTERNS '(K13 K14 K15)))
     (DEGN-DN--match-list-p B (DEGN-DN--cfg-list-or-codes 'DN_FILTER_SOUND_BLOCK_PATTERNS '(K13 K14 K15)))
    )

    (T T)
  )
)


(defun degp--alist-add (al k v / a)
  (setq a (assoc k al))
  (if a
    (subst (cons k (+ (cdr a) v)) a al)
    (cons (cons k v) al)
  )
)

(defun degp--sortlayers (al)
  (vl-sort al
    (function (lambda (a b) (< (strcase (car a)) (strcase (car b))))))
)

(defun degp--ename (x)
  (cond
    ((= (type x) 'ENAME) x)
    ((= (type x) 'VLA-OBJECT) (vlax-vla-object->ename x))
    (T nil)
  )
)

(defun degp--mline-length (e / ed flags item points previous total)
  (setq ed    (entget e)
        flags (if (assoc 71 ed) (cdr (assoc 71 ed)) 0)
        total 0.0)
  (foreach item ed
    (if (= (car item) 11)
      (setq points (append points (list (cdr item))))))
  (foreach item points
    (if previous (setq total (+ total (distance previous item))))
    (setq previous item))
  (if (and (> (length points) 2) (= (logand flags 2) 2))
    (setq total (+ total (distance (car (last points)) (car points)))))
  total
)

(defun degp--length (x / e ed typ obj len endParam)
  (setq e (degp--ename x))
  (if (null e)
    0.0
    (progn
      (setq ed  (entget e)
            typ (if ed (cdr (assoc 0 ed)) ""))
      (if (= typ "MLINE")
        (setq len (degp--mline-length e))
        (progn
          ;; Tum sonlu curve tiplerinde once ortak curve API'sini kullan.
          (setq endParam
            (vl-catch-all-apply 'vlax-curve-getEndParam (list e)))
          (if (not (vl-catch-all-error-p endParam))
            (setq len
              (vl-catch-all-apply
                'vlax-curve-getDistAtParam
                (list e endParam))))
          ;; CAD'e ozel bir curve tipi yalniz Length sunuyorsa onu da dene.
          (if (or (vl-catch-all-error-p len) (not (numberp len)))
            (progn
              (setq obj
                (vl-catch-all-apply 'vlax-ename->vla-object (list e)))
              (if (and obj (not (vl-catch-all-error-p obj)))
                (setq len
                  (vl-catch-all-apply 'vla-get-Length (list obj))))))))
      (if (and (numberp len) (> len 0.0)) len 0.0)
    )
  )
)

(defun degp--numstr (s / txt)
  (cond
    ((numberp s)
      (float s)
    )
    ((and (= (type s) 'STR)
          (/= (setq txt (vl-string-trim " \t\r\n" s)) ""))
      (atof (vl-string-subst "." "," txt))
    )
    (T nil)
  )
)

(defun DEGP--length-report (ss / i e ed lay len sums msg vals it qty qtyNum)
  (if (null ss)
    (progn (DEG:WIN-MESSAGE "Secim yok veya uygun obje yok.") (princ))
    (progn
      (setq sums '() i 0)
      (while (< i (sslength ss))
        (setq e   (ssname ss i)
              ed  (entget e)
              lay (cdr (assoc 8 ed))
              len (degp--length e))
        (if (> len 0.0)
          (setq sums (degp--alist-add sums lay len))
        )
        (setq i (1+ i))
      )

      (if (null sums)
        (DEG:WIN-MESSAGE "Secimde uzunlugu > 0 olan desteklenen bir cizgi/egri bulunamadi.")
        (progn
          (setq sums (degp--sortlayers sums))
          (setq vals (DEGDO--dp-e-values-alist))
          (setq msg "")
          (foreach it sums
            (setq lay    (car it)
                  len    (cdr it)
                  qty    (DEGDO--dp-e-value-get vals lay)
                  qtyNum (degp--numstr qty))
            (if qtyNum
              (setq msg
                (strcat msg
                        lay " : " (DEG:DP-LEN-STR len) " metre x " qty
                        " = " (DEG:DP-LEN-STR (* len qtyNum)) " metre\n"))
              (setq msg
                (strcat msg
                        lay " : " (DEG:DP-LEN-STR len) " metre\n"))
            )
          )
          (DEG:WIN-MESSAGE msg)
        )
      )
      (princ)
    )
  )
)

(defun DEGP--layer-total-pairs (rows / order sums row lay v rec out)
  (setq order '()
        sums  '())
  (foreach row rows
    (setq lay (nth 1 row)
          v   (nth 5 row))
    (if (and lay (/= lay "") (numberp v))
      (progn
        (if (not (assoc lay sums))
          (setq order (append order (list lay))))
        (setq rec (assoc lay sums))
        (if rec
          (setq sums (subst (cons lay (+ (cdr rec) v)) rec sums))
          (setq sums (append sums (list (cons lay v)))))
      )
    )
  )
  (setq out '())
  (foreach lay order
    (setq rec (assoc lay sums))
    (if rec
      (setq out (append out (list rec))))
  )
  out
)

(defun DEGP--popup-results-by-layer (sortedList title / msg cnt i row total v unitLab pair)
  (setq cnt (length sortedList))
  (setq total 0.0)
  (foreach row sortedList
    (setq v (nth 5 row))
    (if (numberp v) (setq total (+ total v)))
  )
  (setq unitLab (if *degLastIsCCTV* " (m)" (strcat " " (DEG:LEN-UNIT-LABEL))))
  (setq msg (strcat title "\nSatir: " (itoa cnt) "\n\n"))
  (setq i 0)
  (foreach row sortedList
    (if (< i 25)
      (progn
        (setq msg
          (strcat msg
                  (if (nth 0 row) (nth 0 row) "") " | "
                  (if (nth 1 row) (nth 1 row) "") " | "
                  (if (nth 5 row) (strcat (DEG:DP-LEN-STR (nth 5 row)) unitLab) (strcat "0" unitLab))
                  "\n"
          )
        )
        (setq i (1+ i))
      )
    )
  )
  (if (> cnt 25)
    (setq msg (strcat msg "\n... (" (itoa (- cnt 25)) " satir daha)\n"))
    (setq msg (strcat msg "\n"))
  )
  (setq msg (strcat msg "==============================\n"))
  (foreach pair (DEGP--layer-total-pairs sortedList)
    (setq msg
      (strcat msg
              (car pair) " TOPLAM: " (DEG:DP-LEN-STR (cdr pair)) unitLab "\n"))
  )
  (setq msg
    (strcat msg
            "------------------------------\n"
            "GENEL TOPLAM: " (DEG:DP-LEN-STR total) unitLab "\n"
            "==============================\n"
    )
  )
  (DEG:WIN-MESSAGE msg)
)

