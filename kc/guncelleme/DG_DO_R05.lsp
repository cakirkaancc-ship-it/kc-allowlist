(defun g365_append_pt (lst p)
  (if (or (null lst) (not (g365_closep (car (reverse lst)) p)))
    (append lst (list p))
    lst
  )
)

(defun g365_rev (lst / out)
  (setq out nil)
  (while lst
    (setq out (cons (car lst) out))
    (setq lst (cdr lst))
  )
  out
)

(defun g365_last (lst / x)
  (setq x nil)
  (while lst
    (setq x (car lst))
    (setq lst (cdr lst))
  )
  x
)

(defun g365_clean_pts (pts / out p prevPt)
  (setq out nil prevPt nil)
  (while pts
    (setq p (car pts))
    (if (or (null prevPt) (> (distance p prevPt) 1e-9))
      (progn
        (setq out (append out (list (list (car p) (cadr p) 0.0))))
        (setq prevPt (list (car p) (cadr p) 0.0))
      )
    )
    (setq pts (cdr pts))
  )
  out
)

(defun g365_get_pts_lw (e / ed pts pr)
  (setq ed (entget e) pts nil)
  (while ed
    (setq pr (car ed))
    (if (= (car pr) 10)
      (setq pts (append pts (list (list (car (cdr pr)) (cadr (cdr pr)) 0.0))))
    )
    (setq ed (cdr ed))
  )
  (g365_clean_pts pts)
)

(defun g365_get_pts_pl (e / pts en vd p)
  (setq pts nil)
  (setq en (entnext e))
  (while (and en (/= (cdr (assoc 0 (entget en))) "SEQEND"))
    (setq vd (entget en))
    (if (= (cdr (assoc 0 vd)) "VERTEX")
      (progn
        (setq p (cdr (assoc 10 vd)))
        (setq pts (append pts (list (list (car p) (cadr p) 0.0))))
      )
    )
    (setq en (entnext en))
  )
  (g365_clean_pts pts)
)

(defun g365_get_pts_line (e / ed p0 p1)
  (setq ed (entget e))
  (setq p0 (cdr (assoc 10 ed)))
  (setq p1 (cdr (assoc 11 ed)))
  (if (and p0 p1)
    (list (list (car p0) (cadr p0) 0.0) (list (car p1) (cadr p1) 0.0))
    nil
  )
)

(defun g365_get_pts (e / ed typ)
  (setq ed (entget e))
  (setq typ (cdr (assoc 0 ed)))
  (cond
    ((= typ "LWPOLYLINE") (g365_get_pts_lw e))
    ((= typ "POLYLINE")   (g365_get_pts_pl e))
    ((= typ "LINE")       (g365_get_pts_line e))
    (t nil)
  )
)

(defun g365_ptkey (p / sx sy)
  (setq sx (rtos (car p) 2 6))
  (setq sy (rtos (cadr p) 2 6))
  (strcat sx "," sy)
)

(defun g365_dot2 (ax ay bx by) (+ (* ax bx) (* ay by)))

(defun g365_closest_on_seg (p a b / ax ay bx by px py vx vy wx wy vv uPar cx cy)
  (setq ax (car a) ay (cadr a))
  (setq bx (car b) by (cadr b))
  (setq px (car p) py (cadr p))
  (setq vx (- bx ax))
  (setq vy (- by ay))
  (setq wx (- px ax))
  (setq wy (- py ay))
  (setq vv (+ (* vx vx) (* vy vy)))
  (if (<= vv 1e-12)
    (list a 0.0 (distance p a))
    (progn
      (setq uPar (/ (g365_dot2 wx wy vx vy) vv))
      (if (< uPar 0.0) (setq uPar 0.0))
      (if (> uPar 1.0) (setq uPar 1.0))
      (setq cx (+ ax (* uPar vx)))
      (setq cy (+ ay (* uPar vy)))
      (list (list cx cy 0.0) uPar (distance p (list cx cy 0.0)))
    )
  )
)

(defun g365_closest_on_poly (p pts / n i a b bestDist bestSeg bestU bestPt res curPt curU curDist)
  (setq n (length pts))
  (setq i 0)
  (setq bestDist 1e99)
  (setq bestSeg 0)
  (setq bestU 0.0)
  (setq bestPt (car pts))
  (while (< i (1- n))
    (setq a (nth i pts))
    (setq b (nth (1+ i) pts))
    (setq res (g365_closest_on_seg p a b))
    (setq curPt (nth 0 res))
    (setq curU (nth 1 res))
    (setq curDist (nth 2 res))
    (if (< curDist bestDist)
      (progn
        (setq bestDist curDist)
        (setq bestSeg i)
        (setq bestU curU)
        (setq bestPt curPt)
      )
    )
    (setq i (1+ i))
  )
  (list bestPt bestU bestSeg bestDist)
)

(defun g376_is_closed (pts / a b)
  (and pts (>= (length pts) 3)
       (<= (distance (car pts) (last pts)) 1e-6))
)

(defun g376_nth_safe (pts idx / n)
  (setq n (length pts))
  (if (or (< idx 0) (>= idx n)) nil (nth idx pts))
)

(defun g376_nth_wrap (pts idx / n i)
  (setq n (length pts))
  (if (<= n 0)
    nil
    (progn
      (setq i idx)
      (while (< i 0) (setq i (+ i n)))
      (while (>= i n) (setq i (- i n)))
      (nth i pts)
    )
  )
)

(defun g365_nearest_vidx (pts pick / n i bestI bestD dd)
  (setq n (length pts) i 0 bestI 0 bestD 1e99)
  (while (< i n)
    (setq dd (distance (nth i pts) pick))
    (if (< dd bestD) (setq bestD dd bestI i))
    (setq i (1+ i))
  )
  bestI
)

(defun g365_assoc_add (al key val / it)
  (setq it (assoc key al))
  (if it
    (subst (cons key (append (cdr it) (list val))) it al)
    (cons (cons key (list val)) al)
  )
)

(defun g365_assoc_set (al key val / it)
  (setq it (assoc key al))
  (if it
    (subst (cons key val) it al)
    (cons (cons key val) al)
  )
)

(defun g365_sort_u (lst / out mn scan)
  (setq out nil)
  (while lst
    (setq mn (car lst))
    (setq scan (cdr lst))
    (while scan
      (if (< (car (car scan)) (car mn)) (setq mn (car scan)))
      (setq scan (cdr scan))
    )
    (setq out (append out (list mn)))
    (setq lst (vl-remove mn lst))
  )
  out
)

(defun g365_line_inter (a b c d / x1 y1 x2 y2 x3 y3 x4 y4 den lam ix iy)
  (setq x1 (car a) y1 (cadr a))
  (setq x2 (car b) y2 (cadr b))
  (setq x3 (car c) y3 (cadr c))
  (setq x4 (car d) y4 (cadr d))
  (setq den (- (* (- x1 x2) (- y3 y4)) (* (- y1 y2) (- x3 x4))))
  (if (<= (g365_abs den) 1e-12)
    nil
    (progn
      (setq lam (/ (- (* (- x1 x3) (- y3 y4)) (* (- y1 y3) (- x3 x4))) den))
      (setq ix (+ x1 (* lam (- x2 x1))))
      (setq iy (+ y1 (* lam (- y2 y1))))
      (list ix iy 0.0)
    )
  )
)

(defun g365_seg_param (a b p / vx vy wx wy vv parVal)
  (setq vx (- (car b) (car a)))
  (setq vy (- (cadr b) (cadr a)))
  (setq wx (- (car p) (car a)))
  (setq wy (- (cadr p) (cadr a)))
  (setq vv (+ (* vx vx) (* vy vy)))
  (if (<= vv 1e-12)
    nil
    (/ (+ (* wx vx) (* wy vy)) vv)
  )
)

(defun g365_unit (vx vy / L)
  (setq L (distance (list 0.0 0.0 0.0) (list vx vy 0.0)))
  (if (<= L 1e-9)
    (list 0.0 0.0)
    (list (/ vx L) (/ vy L))
  )
)

(defun g365_left_normal (ux uy) (list (- uy) ux))
(defun g365_dot (ax ay bx by) (+ (* ax bx) (* ay by)))

(defun g384_need_corner (p1 corner p2 dist / v1 v2 u1 u2 l1 l2 dotv)
  (if (or (null p1) (null corner) (null p2) (null dist))
    nil
    (progn
      (setq l1 (distance p1 corner))
      (setq l2 (distance p2 corner))
      (if (and (<= l1 (* 2.0 dist)) (<= l2 (* 2.0 dist)))
        (progn
          (setq v1 (list (- (car p1) (car corner)) (- (cadr p1) (cadr corner))))
          (setq v2 (list (- (car p2) (car corner)) (- (cadr p2) (cadr corner))))
          (setq u1 (g365_unit (car v1) (cadr v1)))
          (setq u2 (g365_unit (car v2) (cadr v2)))
          (setq dotv (g365_abs (g365_dot (car u1) (cadr u1) (car u2) (cadr u2))))
          (< dotv 0.98)
        )
        nil
      )
    )
  )
)

(defun g365_offset_vertex_open (pPrev pCur pNext dist side / vx1 vy1 vx2 vy2 u1 u2 n1 n2
                                     a1 b1 a2 b2 ip
                                     ox oy lim
                                     bx by bL bux buy dotv mLen nx2 ny2 len1 len2)
  (setq vx1 (- (car pCur) (car pPrev)))
  (setq vy1 (- (cadr pCur) (cadr pPrev)))
  (setq vx2 (- (car pNext) (car pCur)))
  (setq vy2 (- (cadr pNext) (cadr pCur)))

  (setq len1 (sqrt (+ (* vx1 vx1) (* vy1 vy1))))
  (setq len2 (sqrt (+ (* vx2 vx2) (* vy2 vy2))))

  (setq u1 (g365_unit vx1 vy1))
  (setq u2 (g365_unit vx2 vy2))

  (setq n1 (g365_left_normal (car u1) (cadr u1)))
  (setq n2 (g365_left_normal (car u2) (cadr u2)))

  (setq n1 (list (* side (car n1)) (* side (cadr n1))))
  (setq n2 (list (* side (car n2)) (* side (cadr n2))))

  (setq lim (* 20.0 dist))

  (setq dotv (g365_dot (car u1) (cadr u1) (car u2) (cadr u2)))
  (if (and (> len1 1e-9) (> len2 1e-9) (> dotv 0.9999))
    (progn
      (setq ox (* (car n1) dist))
      (setq oy (* (cadr n1) dist))
    )
    (progn
      (cond
        ((and (<= len1 1e-9) (> len2 1e-9))
          (setq ox (* (car n2) dist) oy (* (cadr n2) dist))
        )
        ((and (<= len2 1e-9) (> len1 1e-9))
          (setq ox (* (car n1) dist) oy (* (cadr n1) dist))
        )
        (t
          (setq a1 (list (+ (car pPrev) (* (car n1) dist)) (+ (cadr pPrev) (* (cadr n1) dist)) 0.0))
          (setq b1 (list (+ (car pCur)  (* (car n1) dist)) (+ (cadr pCur)  (* (cadr n1) dist)) 0.0))
          (setq a2 (list (+ (car pCur)  (* (car n2) dist)) (+ (cadr pCur)  (* (cadr n2) dist)) 0.0))
          (setq b2 (list (+ (car pNext) (* (car n2) dist)) (+ (cadr pNext) (* (cadr n2) dist)) 0.0))
          (setq ip (g365_line_inter a1 b1 a2 b2))

          (if (and ip (<= (distance ip pCur) lim))
            (progn
              (setq ox (- (car ip) (car pCur)))
              (setq oy (- (cadr ip) (cadr pCur)))
            )
            (progn
              (setq bx (+ (car n1) (car n2)))
              (setq by (+ (cadr n1) (cadr n2)))
              (setq bL (distance (list 0.0 0.0 0.0) (list bx by 0.0)))

              (if (<= bL 1e-9)
                (progn (setq bux (car n2)) (setq buy (cadr n2)))
                (progn (setq bux (/ bx bL)) (setq buy (/ by bL)))
              )

              (setq nx2 (car n2))
              (setq ny2 (cadr n2))
              (setq dotv (g365_dot bux buy nx2 ny2))

              (if (<= dotv 0.001)
                (progn (setq ox (* nx2 dist)) (setq oy (* ny2 dist)))
                (progn
                  (setq mLen (/ dist dotv))
                  (if (> mLen lim) (setq mLen lim))
                  (setq ox (* bux mLen))
                  (setq oy (* buy mLen))
                )
              )
            )
          )
        )
      )
    )
  )

  (list (+ (car pCur) ox) (+ (cadr pCur) oy) 0.0)
)

(defun g365_offset_open_pts (pts dist side / n i p0 p1 pn2 pn1 u nrm out pPrev pCur pNext)
  (setq n (length pts))
  (setq out nil)
  (if (< n 2)
    out
    (progn
      (setq p0 (nth 0 pts))
      (setq p1 (nth 1 pts))
      (setq u (g365_unit (- (car p1) (car p0)) (- (cadr p1) (cadr p0))))
      (setq nrm (g365_left_normal (car u) (cadr u)))
      (setq nrm (list (* side (car nrm)) (* side (cadr nrm))))
      (setq out (append out (list (list (+ (car p0) (* (car nrm) dist)) (+ (cadr p0) (* (cadr nrm) dist)) 0.0))))

      (setq i 1)
      (while (< i (1- n))
        (setq pPrev (nth (1- i) pts))
        (setq pCur  (nth i pts))
        (setq pNext (nth (1+ i) pts))
        (setq out (append out (list (g365_offset_vertex_open pPrev pCur pNext dist side))))
        (setq i (1+ i))
      )

      (setq pn2 (nth (- n 2) pts))
      (setq pn1 (nth (- n 1) pts))
      (setq u (g365_unit (- (car pn1) (car pn2)) (- (cadr pn1) (cadr pn2))))
      (setq nrm (g365_left_normal (car u) (cadr u)))
      (setq nrm (list (* side (car nrm)) (* side (cadr nrm))))
      (setq out (append out (list (list (+ (car pn1) (* (car nrm) dist)) (+ (cadr pn1) (* (cadr nrm) dist)) 0.0))))
      out
    )
  )
)

(defun g365_entmake_open_poly (lay pts / n data e p)
  (setq n (length pts))
  (if (and n (> n 1))
    (progn
      (setq data (list
        (cons 0 "LWPOLYLINE")
        (cons 100 "AcDbEntity")
        (cons 8 lay)
        (cons 100 "AcDbPolyline")
        (cons 90 n)
        (cons 70 0)
        (cons 38 0.0)
        (cons 43 0.0)
      ))
      (while pts
        (setq p (car pts))
        (setq data (append data (list (cons 10 (list (car p) (cadr p))))))
        (setq pts (cdr pts))
      )
      (setq e (entmakex data))
      e
    )
    nil
  )
)

(defun g365_ed_remove_codes (ed codes / out pr)
  (setq out nil)
  (while ed
    (setq pr (car ed))
    (if (not (member (car pr) codes))
      (setq out (append out (list pr)))
    )
    (setq ed (cdr ed))
  )
  out
)

(defun g365_ed_ins_after_code (ed code ins / out done pr)
  (setq out nil done nil)
  (while ed
    (setq pr (car ed))
    (setq out (append out (list pr)))
    (if (and (not done) (= (car pr) code))
      (progn
        (setq out (append out ins))
        (setq done T)
      )
    )
    (setq ed (cdr ed))
  )
  (if done out (append out ins))
)

(defun g365_copy_color (srcEnt dstEnt / es oS oD srcCol c420 acad cm)
  (if (and srcEnt dstEnt)
    (progn
      (vl-load-com)
      (setq oS (vlax-ename->vla-object srcEnt))
      (setq oD (vlax-ename->vla-object dstEnt))

      (setq srcCol (vl-catch-all-apply 'vla-get-Color (list oS)))
      (if (not (vl-catch-all-error-p srcCol))
        (vl-catch-all-apply 'vla-put-Color (list oD srcCol))
      )

      (setq es (entget srcEnt))
      (setq c420 (assoc 420 es))
      (if c420
        (progn
          (setq acad (vlax-get-acad-object))
          (setq cm (vla-GetInterfaceObject acad "AutoCAD.AcCmColor"))
          (vl-catch-all-apply 'vla-put-ColorValue (list cm (cdr c420)))
          (vl-catch-all-apply 'vla-put-TrueColor (list oD cm))
        )
      )
    )
  )
  dstEnt
)

(defun g365_force_color_aci (ent aci / ed c62)
  (if ent
    (progn
      (setq ed (entget ent))
      (setq ed (g365_ed_remove_codes ed (list 420 430)))
      (setq c62 (assoc 62 ed))
      (if c62
        (setq ed (subst (cons 62 (fix aci)) c62 ed))
        (setq ed (g365_ed_ins_after_code ed 8 (list (cons 62 (fix aci)))))
      )
      (vl-catch-all-apply 'entmod (list ed))
      (vl-catch-all-apply 'entupd (list ent))
    )
  )
  ent
)

(defun g365_add_mouth_cand (candList signVal boundaryPt bA bB brA0 brA1 sideTag maxLen / ip parB parBr)
  (setq ip (g365_line_inter bA bB brA0 brA1))
  (if ip
    (progn
      (setq parB (g365_seg_param bA bB ip))
      (setq parBr (g365_seg_param brA0 brA1 ip))
      (if (and parB parBr
               (>= parB -1e-6) (<= parB (+ 1.0 1e-6))
               (<= (distance boundaryPt ip) maxLen)
               (<= (distance brA0 ip) maxLen))
        (append candList (list (list signVal ip sideTag)))
        candList
      )
    )
    candList
  )
)

(defun g365_pick_best_by_sign (candList wantNeg / best rec sgn absS)
  (setq best nil)
  (while candList
    (setq rec (car candList))
    (setq sgn (car rec))
    (if (or (and wantNeg (< sgn 0.0)) (and (not wantNeg) (> sgn 0.0)))
      (progn
        (setq absS (g365_abs sgn))
        (if (or (null best) (< absS (g365_abs (car best))))
          (setq best rec)
        )
      )
    )
    (setq candList (cdr candList))
  )
  best
)

(defun g365_pick_best_pos_opposite (candList negSideTag / best rec sgn absS)
  (setq best nil)
  (while candList
    (setq rec (car candList))
    (setq sgn (car rec))
    (if (and (> sgn 0.0) (/= (caddr rec) negSideTag))
      (progn
        (setq absS (g365_abs sgn))
        (if (or (null best) (< absS (g365_abs (car best))))
          (setq best rec)
        )
      )
    )
    (setq candList (cdr candList))
  )
  best
)

(defun g365_bump_open_mouth (boundaryPts idx step brPts dist / n bpt maxLen
                                       inA inB outA outB
                                       brL brR brL0 brL1 brR0 brR1
                                       cand negRec posRec posAlt
                                       enter exit enterTag exitTag
                                       startPoly otherPoly otherRev nOther jj seq farOther)
  (setq n (length boundaryPts))
  (if (or (<= idx 0) (>= idx (1- n)) (null brPts) (< (length brPts) 2))
    nil
    (progn
      (setq bpt (nth idx boundaryPts))
      (setq maxLen (* 8.0 dist))
      (setq brL (g365_offset_open_pts brPts dist  1))
      (setq brR (g365_offset_open_pts brPts dist -1))
      (if (or (null brL) (null brR) (< (length brL) 2) (< (length brR) 2))
        nil
        (progn
          (setq inA  (nth (- idx step) boundaryPts))
          (setq inB  (nth idx boundaryPts))
          (setq outA (nth idx boundaryPts))
          (setq outB (nth (+ idx step) boundaryPts))

          (setq brL0 (nth 0 brL)) (setq brL1 (nth 1 brL))
          (setq brR0 (nth 0 brR)) (setq brR1 (nth 1 brR))

          (setq cand nil)

          (setq cand (g365_add_mouth_cand cand (- (distance bpt inA)) bpt inA inB brL0 brL1  1 maxLen))
          (setq cand (g365_add_mouth_cand cand (- (distance bpt inA)) bpt inA inB brR0 brR1 -1 maxLen))

          (setq cand (g365_add_mouth_cand cand (distance bpt outB) bpt outA outB brL0 brL1  1 maxLen))
          (setq cand (g365_add_mouth_cand cand (distance bpt outB) bpt outA outB brR0 brR1 -1 maxLen))

          (setq negRec (g365_pick_best_by_sign cand 1))
          (setq posRec (g365_pick_best_by_sign cand nil))

          (if (and negRec posRec)
            (progn
              (if (= (caddr negRec) (caddr posRec))
                (progn
                  (setq posAlt (g365_pick_best_pos_opposite cand (caddr negRec)))
                  (if posAlt (setq posRec posAlt))
                )
              )

              (setq enter (cadr negRec))
              (setq exit  (cadr posRec))
              (setq enterTag (caddr negRec))
              (setq exitTag  (caddr posRec))

              (if (= enterTag exitTag)
                nil
                (progn
                  (if (= enterTag 1) (setq startPoly brL) (setq startPoly brR))
                  (if (= exitTag  1) (setq otherPoly brL) (setq otherPoly brR))

                  (setq seq nil)
                  (setq seq (g365_append_pt seq enter))

                  (setq jj 1)
                  (while (< jj (length startPoly))
                    (setq seq (g365_append_pt seq (nth jj startPoly)))
                    (setq jj (1+ jj))
                  )

                  (setq farOther (g365_last otherPoly))
                  (setq seq (g365_append_pt seq farOther))

                  (setq otherRev (g365_rev otherPoly))
                  (setq nOther (length otherPoly))
                  (setq jj 1)
                  (while (< jj (1- nOther))
                    (setq seq (g365_append_pt seq (nth jj otherRev)))
                    (setq jj (1+ jj))
                  )

                  (setq seq (g365_append_pt seq exit))
                  seq
                )
              )
            )
            nil
          )
        )
      )
    )
  )
)

(defun g371_sublist (lst start / i out n)
  (setq out nil)
  (setq n (length lst))
  (setq i start)
  (while (< i n)
    (setq out (append out (list (nth i lst))))
    (setq i (1+ i))
  )
  out
)

(defun g371_sublist_rev (lst idx / i out)
  (setq out nil)
  (setq i idx)
  (while (>= i 0)
    (setq out (append out (list (nth i lst))))
    (setq i (1- i))
  )
  out
)

(defun g371_best_contact (mainPts brPts tol / mN bN mi bi mA mB bA bB best bestD
                                   ip uM uB res pMain pBr d)
  (setq best nil)
  (setq bestD 1e99)
  (setq mN (length mainPts))
  (setq bN (length brPts))
  (if (or (< mN 2) (< bN 2))
    nil
    (progn
      (setq mi 0)
      (while (< mi (1- mN))
        (setq mA (nth mi mainPts))
        (setq mB (nth (1+ mi) mainPts))
        (setq bi 0)
        (while (< bi (1- bN))
          (setq bA (nth bi brPts))
          (setq bB (nth (1+ bi) brPts))

          (setq ip (g365_line_inter mA mB bA bB))
          (if ip
            (progn
              (setq uM (g365_seg_param mA mB ip))
              (setq uB (g365_seg_param bA bB ip))
              (if (and uM uB (>= uM -1e-6) (<= uM (+ 1.0 1e-6)) (>= uB -1e-6) (<= uB (+ 1.0 1e-6)))
                (progn
                  (setq d 0.0)
                  (if (< d bestD)
                    (progn
                      (setq bestD d)
                      (setq best (list d mi uM ip bi uB ip))
                    )
                  )
                )
              )
            )
          )

          (setq res (g365_closest_on_seg bA mA mB))
          (setq pMain (nth 0 res))
          (setq uM (nth 1 res))
          (setq d (nth 2 res))
          (if (< d bestD)
            (progn
              (setq bestD d)
              (setq best (list d mi uM pMain bi 0.0 bA))
            )
          )

          (setq res (g365_closest_on_seg bB mA mB))
          (setq pMain (nth 0 res))
          (setq uM (nth 1 res))
          (setq d (nth 2 res))
          (if (< d bestD)
            (progn
              (setq bestD d)
              (setq best (list d mi uM pMain bi 1.0 bB))
            )
          )

          (setq res (g365_closest_on_seg mA bA bB))
          (setq pBr (nth 0 res))
          (setq uB (nth 1 res))
          (setq d (nth 2 res))
          (if (< d bestD)
            (progn
              (setq bestD d)
              (setq best (list d mi 0.0 mA bi uB pBr))
            )
          )

          (setq res (g365_closest_on_seg mB bA bB))
          (setq pBr (nth 0 res))
          (setq uB (nth 1 res))
          (setq d (nth 2 res))
          (if (< d bestD)
            (progn
              (setq bestD d)
              (setq best (list d mi 1.0 mB bi uB pBr))
            )
          )

          (setq bi (1+ bi))
        )
        (setq mi (1+ mi))
      )

      (if (and best (<= (car best) tol)) best nil)
    )
  )
)

(defun g371_branch_dirs (pts segIdx u touchBr / eps n newPts idxTouch i out)
  (setq eps 1e-6)
  (setq n (length pts))
  (setq out nil)
  (if (or (null pts) (< n 2) (null segIdx) (null u) (null touchBr))
    nil
    (progn
      (if (<= u eps)
        (progn
          (setq newPts pts)
          (setq idxTouch segIdx)
        )
        (if (>= u (- 1.0 eps))
          (progn
            (setq newPts pts)
            (setq idxTouch (1+ segIdx))
          )
          (progn
            (setq newPts nil)
            (setq i 0)
            (while (< i n)
              (setq newPts (append newPts (list (nth i pts))))
              (if (= i segIdx)
                (setq newPts (append newPts (list touchBr)))
              )
              (setq i (1+ i))
            )
            (setq idxTouch (1+ segIdx))
          )
        )
      )

      (if (< idxTouch (1- (length newPts)))
        (setq out (append out (list (g371_sublist newPts idxTouch))))
      )
      (if (> idxTouch 0)
        (setq out (append out (list (g371_sublist_rev newPts idxTouch))))
      )
      out
    )
  )
)

(defun g371_make_branch (touchMain dirPts / out)
  (setq out nil)
  (if (and dirPts (>= (length dirPts) 2))
    (progn
      (if (g365_closep touchMain (car dirPts))
        (setq out (cons touchMain (cdr dirPts)))
        (setq out (cons touchMain dirPts))
      )
    )
  )
  (if (and out (>= (length out) 2)) out nil)
)

(defun g371_branch_side (mainAug iKey brPts left right / touch outPt pPrev pNext tx ty bx by cr)
  (setq touch (nth 0 brPts))
  (setq outPt (nth 1 brPts))
  (setq pPrev (if (> iKey 0) (nth (1- iKey) mainAug) (nth iKey mainAug)))
  (setq pNext (if (< iKey (1- (length mainAug))) (nth (1+ iKey) mainAug) (nth iKey mainAug)))
  (setq tx (- (car pNext) (car pPrev)))
  (setq ty (- (cadr pNext) (cadr pPrev)))
  (setq bx (- (car outPt) (car touch)))
  (setq by (- (cadr outPt) (cadr touch)))
  (setq cr (- (* tx by) (* ty bx)))
  (if (> (g365_abs cr) 1e-9)
    (if (> cr 0.0) 1 -1)
    (if (< (distance outPt (nth iKey left)) (distance outPt (nth iKey right))) 1 -1)
  )
)

(setq g372_nodes nil)
(setq g372_nextId 0)
(setq g372_assigned nil)

(defun g372_reset_tree ()
  (setq g372_nodes nil)
  (setq g372_nextId 0)
  (setq g372_assigned nil)
)

(defun g372_get_node (id) (cdr (assoc id g372_nodes)))

(defun g372_node (id sym / nd)
  (setq nd (g372_get_node id))
  (if nd (cdr (assoc sym nd)) nil)
)

(defun g372_set_node (id sym val / pair nd newnd)
  (setq pair (assoc id g372_nodes))
  (if pair
    (progn
      (setq nd (cdr pair))
      (setq newnd (g365_assoc_set nd sym val))
      (setq g372_nodes (subst (cons id newnd) pair g372_nodes))
    )
  )
  val
)

(defun g372_assigned_p (ent) (if (assoc ent g372_assigned) T nil))

(defun g372_assign (ent val)
  (setq g372_assigned (g365_assoc_set g372_assigned ent val))
  val
)

(defun g372_new_node (ent pts parentId parentKey / id nd)
  (setq id g372_nextId)
  (setq g372_nextId (1+ g372_nextId))
  (setq nd (list
    (cons 'id id)
    (cons 'ent ent)
    (cons 'pts pts)
    (cons 'parent parentId)
    (cons 'pkey parentKey)
    (cons 'touchBySeg nil)
    (cons 'childrenByKey nil)
    (cons 'aug nil)
    (cons 'left nil)
    (cons 'right nil)
    (cons 'keyIndex nil)
    (cons 'branchMap nil)
  ))
  (setq g372_nodes (cons (cons id nd) g372_nodes))
  id
)

(defun g372_ss_to_list (ss / i out)
  (setq out nil i 0)
  (if ss
    (while (< i (sslength ss))
      (setq out (cons (ssname ss i) out))
      (setq i (1+ i))
    )
  )
  out
)

(defun g372_build_tree (rootEnt rootPts allEnts tol / rootId queue pid pPts scan entScan brPts bestRes
                              segIdx uVal touchMain brSegIdx brU touchBr key dirList brPts2
                              firstChild touchBySeg childrenByKey childId)
  (g372_reset_tree)
  (setq rootId (g372_new_node rootEnt rootPts nil nil))
  (g372_assign rootEnt rootId)
  (setq queue (list rootId))

  (while queue
    (setq pid (car queue))
    (setq queue (cdr queue))
    (setq pPts (g372_node pid 'pts))

    (setq scan allEnts)
    (while scan
      (setq entScan (car scan))
      (if (and (/= entScan (g372_node pid 'ent)) (not (g372_assigned_p entScan)))
        (progn
          (setq brPts (g365_get_pts entScan))
          (if (and brPts (>= (length brPts) 2))
            (progn
              (setq bestRes (g371_best_contact pPts brPts tol))
              (if bestRes
                (progn
                  (setq segIdx    (nth 1 bestRes))
                  (setq uVal      (nth 2 bestRes))
                  (setq touchMain (nth 3 bestRes))
                  (setq brSegIdx  (nth 4 bestRes))
                  (setq brU       (nth 5 bestRes))
                  (setq touchBr   (nth 6 bestRes))

                  (setq key (g365_ptkey touchMain))

                  (setq touchBySeg (g372_node pid 'touchBySeg))
                  (setq touchBySeg (g365_assoc_add touchBySeg segIdx (list uVal touchMain key)))
                  (g372_set_node pid 'touchBySeg touchBySeg)

                  (setq dirList (g371_branch_dirs brPts brSegIdx brU touchBr))
                  (setq firstChild nil)
                  (while dirList
                    (setq brPts2 (g371_make_branch touchMain (car dirList)))
                    (if (and brPts2 (>= (length brPts2) 2))
                      (progn
                        (setq childId (g372_new_node entScan brPts2 pid key))
                        (if (null firstChild) (setq firstChild childId))
                        (setq queue (append queue (list childId)))
                        (setq childrenByKey (g372_node pid 'childrenByKey))
                        (setq childrenByKey (g365_assoc_add childrenByKey key childId))
                        (g372_set_node pid 'childrenByKey childrenByKey)
                      )
                    )
                    (setq dirList (cdr dirList))
                  )

                  (if firstChild (g372_assign entScan firstChild))
                )
              )
            )
          )
        )
      )
      (setq scan (cdr scan))
    )
  )

  rootId
)

(defun g372_prepare_node (id dist / pts touchBySeg childrenByKey mainAug segK segTouches sorted left right
                               keyIndexMap scan key childIds iKey childId childPts sidePick branchMap)
  (setq pts (g372_node id 'pts))
  (setq touchBySeg (g372_node id 'touchBySeg))
  (setq childrenByKey (g372_node id 'childrenByKey))

  (if (or (null pts) (< (length pts) 2))
    nil
    (progn
      (setq mainAug nil)
      (setq mainAug (append mainAug (list (nth 0 pts))))
      (setq segK 0)
      (while (< segK (1- (length pts)))
        (setq segTouches (cdr (assoc segK touchBySeg)))
        (if segTouches
          (progn
            (setq sorted (g365_sort_u segTouches))
            (while sorted
              (setq mainAug (g365_append_pt mainAug (cadr (car sorted))))
              (setq sorted (cdr sorted))
            )
          )
        )
        (setq mainAug (g365_append_pt mainAug (nth (1+ segK) pts)))
        (setq segK (1+ segK))
      )

      (setq left  (g365_offset_open_pts mainAug dist  1))
      (setq right (g365_offset_open_pts mainAug dist -1))

      (if (or (null left) (null right) (< (length left) 2) (/= (length left) (length mainAug)))
        (progn
          (g372_set_node id 'aug mainAug)
          (g372_set_node id 'left nil)
          (g372_set_node id 'right nil)
          (g372_set_node id 'keyIndex nil)
          (g372_set_node id 'branchMap nil)
          nil
        )
        (progn
          (setq keyIndexMap nil)
          (setq segK 0)
          (while (< segK (length mainAug))
            (setq keyIndexMap (g365_assoc_set keyIndexMap (g365_ptkey (nth segK mainAug)) segK))
            (setq segK (1+ segK))
          )

          (setq branchMap nil)
          (setq scan childrenByKey)
          (while scan
            (setq key (car (car scan)))
            (setq childIds (cdr (car scan)))
            (setq iKey (cdr (assoc key keyIndexMap)))
            (if iKey
              (progn
                (while childIds
                  (setq childId (car childIds))
                  (setq childPts (g372_node childId 'pts))
                  (if (and childPts (>= (length childPts) 2))
                    (progn
                      (setq sidePick (g371_branch_side mainAug iKey childPts left right))
                      (setq branchMap (g365_assoc_add branchMap key (list sidePick childId)))
                    )
                  )
                  (setq childIds (cdr childIds))
                )
              )
            )
            (setq scan (cdr scan))
          )

          (g372_set_node id 'aug mainAug)
          (g372_set_node id 'left left)
          (g372_set_node id 'right right)
          (g372_set_node id 'keyIndex keyIndexMap)
          (g372_set_node id 'branchMap branchMap)
          T
        )
      )
    )
  )
)

(defun g372_prepare_all (dist / ids p)
  (setq ids nil)
  (setq p g372_nodes)
  (while p
    (setq ids (cons (car (car p)) ids))
    (setq p (cdr p))
  )
  (while ids
    (g372_prepare_node (car ids) dist)
    (setq ids (cdr ids))
  )
  T
)

(defun g372_bump_open_mouth_rec (boundaryPts idx step childId dist / childAug brL brR childBM n bpt maxLen
                                        inA inB outA outB brL0 brL1 brR0 brR1
                                        cand negRec posRec posAlt enter exit enterTag exitTag
                                        startPoly otherPoly seq jj key brList tmp rec bump kk2
                                        nOther idxCur didBump farOther)
  (setq childAug (g372_node childId 'aug))
  (setq brL (g372_node childId 'left))
  (setq brR (g372_node childId 'right))
  (setq childBM (g372_node childId 'branchMap))

  (setq n (length boundaryPts))
  (if (or (<= idx 0) (>= idx (1- n)) (null childAug) (< (length childAug) 2)
          (null brL) (null brR) (< (length brL) 2) (< (length brR) 2))
    nil
    (progn
      (setq bpt (nth idx boundaryPts))
      (setq maxLen (* 8.0 dist))

      (setq inA  (nth (- idx step) boundaryPts))
      (setq inB  (nth idx boundaryPts))
      (setq outA (nth idx boundaryPts))
      (setq outB (nth (+ idx step) boundaryPts))

      (setq brL0 (nth 0 brL)) (setq brL1 (nth 1 brL))
      (setq brR0 (nth 0 brR)) (setq brR1 (nth 1 brR))

      (setq cand nil)
      (setq cand (g365_add_mouth_cand cand (- (distance bpt inA)) bpt inA inB brL0 brL1  1 maxLen))
      (setq cand (g365_add_mouth_cand cand (- (distance bpt inA)) bpt inA inB brR0 brR1 -1 maxLen))
      (setq cand (g365_add_mouth_cand cand (distance bpt outB) bpt outA outB brL0 brL1  1 maxLen))
      (setq cand (g365_add_mouth_cand cand (distance bpt outB) bpt outA outB brR0 brR1 -1 maxLen))

      (setq negRec (g365_pick_best_by_sign cand 1))
      (setq posRec (g365_pick_best_by_sign cand nil))

      (if (and negRec posRec)
        (progn
          (if (= (caddr negRec) (caddr posRec))
            (progn
              (setq posAlt (g365_pick_best_pos_opposite cand (caddr negRec)))
              (if posAlt (setq posRec posAlt))
            )
          )

          (setq enter (cadr negRec))
          (setq exit  (cadr posRec))
          (setq enterTag (caddr negRec))
          (setq exitTag  (caddr posRec))

          (if (= enterTag exitTag)
            nil
            (progn
              (if (= enterTag 1) (setq startPoly brL) (setq startPoly brR))
              (if (= exitTag  1) (setq otherPoly brL) (setq otherPoly brR))

              (setq seq nil)
              (setq seq (g365_append_pt seq enter))

              (setq jj 1)
              (while (< jj (length startPoly))
                (setq key (g365_ptkey (nth jj childAug)))
                (setq brList (cdr (assoc key childBM)))
                (setq didBump nil)

                (if brList
                  (progn
                    (setq tmp brList)
                    (while tmp
                      (setq rec (car tmp))
                      (if (= (car rec) enterTag)
                        (progn
                          (setq bump (g377_bump_force_rec startPoly jj 1 (cadr rec) dist))
                          (if bump
                            (progn
                              (setq kk2 0)
                              (while (< kk2 (length bump))
                                (setq seq (g365_append_pt seq (nth kk2 bump)))
                                (setq kk2 (1+ kk2))
                              )
                              (setq didBump 1)
                            )
                          )
                        )
                      )
                      (setq tmp (cdr tmp))
                    )
                  )
                )

                (if (not didBump)
                  (setq seq (g365_append_pt seq (nth jj startPoly)))
                )
                (setq jj (1+ jj))
              )

              (setq farOther (g365_last otherPoly))
              (setq seq (g365_append_pt seq farOther))

              (setq nOther (length otherPoly))
              (setq idxCur (- nOther 2))
              (while (>= idxCur 1)
                (setq key (g365_ptkey (nth idxCur childAug)))
                (setq brList (cdr (assoc key childBM)))
                (setq didBump nil)

                (if brList
                  (progn
                    (setq tmp brList)
                    (while tmp
                      (setq rec (car tmp))
                      (if (= (car rec) exitTag)
                        (progn
                          (setq bump (g377_bump_force_rec otherPoly idxCur -1 (cadr rec) dist))
                          (if bump
                            (progn
                              (setq kk2 0)
                              (while (< kk2 (length bump))
                                (setq seq (g365_append_pt seq (nth kk2 bump)))
                                (setq kk2 (1+ kk2))
                              )
                              (setq didBump 1)
                            )
                          )
                        )
                      )
                      (setq tmp (cdr tmp))
                    )
                  )
                )

                (if (not didBump)
                  (setq seq (g365_append_pt seq (nth idxCur otherPoly)))
                )

                (setq idxCur (1- idxCur))
              )

              (setq seq (g365_append_pt seq exit))
              seq
            )
          )
        )
        nil
      )
    )
  )
)

(defun g373_mouth_ip (bA bB boundaryPt brA0 brA1 sideTag maxLen / ip parB parBr res u d tolTouch)
  (setq ip (g365_line_inter bA bB brA0 brA1))
  (if ip
    (progn
      (setq parB (g365_seg_param bA bB ip))
      (setq parBr (g365_seg_param brA0 brA1 ip))
      (if (and parB parBr
               (>= parB -1e-6) (<= parB (+ 1.0 1e-6))
               (>= parBr -1e-6) (<= parBr (+ 1.0 1e-6))
               (<= (distance boundaryPt ip) maxLen)
               (<= (distance brA0 ip) maxLen))
        (list parB ip sideTag)
        nil
      )
    )
    (progn
      (setq tolTouch 0.1)
      (setq res (g365_closest_on_seg boundaryPt brA0 brA1))
      (setq u (nth 1 res))
      (setq d (nth 2 res))
      (if (and (<= d tolTouch)
               (or (<= u 1e-3) (>= u (- 1.0 1e-3))))
        (progn
          (setq parB (g365_seg_param bA bB boundaryPt))
          (if (and parB (>= parB -1e-6) (<= parB (+ 1.0 1e-6)))
            (list parB boundaryPt sideTag)
            nil
          )
        )
        nil
      )
    )
  )
)

(defun g372_bump_open_mouth_half_rec (boundaryPts idx step childId dist useIncoming / childAug brL brR childBM n bpt maxLen isClosed bInA bInB bOutA bOutB bA2 bB2 recL1 recR1 recL2 recR2 segL segR d1 d2 snapTol cornerTol cornerTol2
                                            bA bB brL0 brL1 brR0 brR1 recL recR enterRec exitRec
                                            enter exit enterTag exitTag
                                            startPoly otherPoly seq jj key brList tmp rec bump kk2
                                            nOther idxCur didBump farOther)
  (setq childAug (g372_node childId 'aug))
  (setq brL (g372_node childId 'left))
  (setq brR (g372_node childId 'right))
  (setq childBM (g372_node childId 'branchMap))

  (setq n (length boundaryPts))
  (if (or (null boundaryPts) (< n 2) (null childAug) (< (length childAug) 2)
          (null brL) (null brR) (< (length brL) 2) (< (length brR) 2))
    nil
    (progn
      (setq isClosed (g376_is_closed boundaryPts))
      (setq maxLen (* 8.0 dist))

      (if isClosed
        (setq bpt (g376_nth_wrap boundaryPts idx))
        (setq bpt (g376_nth_safe boundaryPts idx))
      )

      (if isClosed
        (progn
          (setq bInA  (g376_nth_wrap boundaryPts (- idx step)))
          (setq bInB  (g376_nth_wrap boundaryPts idx))
          (setq bOutA (g376_nth_wrap boundaryPts idx))
          (setq bOutB (g376_nth_wrap boundaryPts (+ idx step)))
        )
        (progn
          (setq bInA  (g376_nth_safe boundaryPts (- idx step)))
          (setq bInB  (g376_nth_safe boundaryPts idx))
          (setq bOutA (g376_nth_safe boundaryPts idx))
          (setq bOutB (g376_nth_safe boundaryPts (+ idx step)))
        )
      )

      (if useIncoming
        (progn
          (setq bA bInA) (setq bB bInB)
          (setq bA2 bOutA) (setq bB2 bOutB)
        )
        (progn
          (setq bA bOutA) (setq bB bOutB)
          (setq bA2 bInA) (setq bB2 bInB)
        )
      )

      (if (or (null bA) (null bB) (null bpt))
        nil
        (progn
          (setq brL0 (nth 0 brL)) (setq brL1 (nth 1 brL))
          (setq brR0 (nth 0 brR)) (setq brR1 (nth 1 brR))

          (setq snapTol 0.2)
          (if (<= (distance bpt brL0) snapTol)
            (progn
              (setq brL (cons bpt (cdr brL)))
              (setq brL0 bpt)
            )
          )
          (if (<= (distance bpt brR0) snapTol)
            (progn
              (setq brR (cons bpt (cdr brR)))
              (setq brR0 bpt)
            )
          )

          (setq recL1 (g373_mouth_ip bA  bB  bpt brL0 brL1  1 maxLen))
          (setq recR1 (g373_mouth_ip bA  bB  bpt brR0 brR1 -1 maxLen))
          (setq recL2 (if (and bA2 bB2) (g373_mouth_ip bA2 bB2 bpt brL0 brL1  1 maxLen) nil))
          (setq recR2 (if (and bA2 bB2) (g373_mouth_ip bA2 bB2 bpt brR0 brR1 -1 maxLen) nil))

          (setq recL nil) (setq segL 0)
          (if recL1 (progn (setq recL recL1) (setq segL 1)))
          (if recL2
            (if (null recL)
              (progn (setq recL recL2) (setq segL 2))
              (progn
                (setq d1 (distance bpt (cadr recL)))
                (setq d2 (distance bpt (cadr recL2)))
                (if (< d2 d1) (progn (setq recL recL2) (setq segL 2)))
              )
            )
          )

          (setq recR nil) (setq segR 0)
          (if recR1 (progn (setq recR recR1) (setq segR 1)))
          (if recR2
            (if (null recR)
              (progn (setq recR recR2) (setq segR 2))
              (progn
                (setq d1 (distance bpt (cadr recR)))
                (setq d2 (distance bpt (cadr recR2)))
                (if (< d2 d1) (progn (setq recR recR2) (setq segR 2)))
              )
            )
          )

          (setq cornerTol 0.2)
          (if (and recL recR (/= segL segR)
                   (<= (distance bpt (cadr recL)) cornerTol)
                   (<= (distance bpt (cadr recR)) cornerTol))
            (progn (setq recL nil) (setq recR nil))
          )


          (if (and recL recR)
            (progn
              (if (< (car recL) (car recR))
                (progn (setq enterRec recL) (setq exitRec recR))
                (progn (setq enterRec recR) (setq exitRec recL))
              )

              (setq enter (cadr enterRec))
              (setq exit  (cadr exitRec))
              (setq enterTag (caddr enterRec))
              (setq exitTag  (caddr exitRec))

              (if (= enterTag exitTag)
                nil
                (progn
                  (if (= enterTag 1) (setq startPoly brL) (setq startPoly brR))
                  (if (= exitTag  1) (setq otherPoly brL) (setq otherPoly brR))

                  (setq seq nil)
                  (setq seq (g365_append_pt seq enter))

                  (setq jj 1)
                  (while (< jj (length startPoly))
                    (setq key (g365_ptkey (nth jj childAug)))
                    (setq brList (cdr (assoc key childBM)))
                    (setq didBump nil)

                    (if brList
                      (progn
                        (setq tmp brList)
                        (while tmp
                          (setq rec (car tmp))
                          (if (= (car rec) enterTag)
                            (progn
                              (setq bump (g377_bump_force_rec startPoly jj 1 (cadr rec) dist))
                              (if bump
                                (progn
                                  (setq kk2 0)
                                  (while (< kk2 (length bump))
                                    (setq seq (g365_append_pt seq (nth kk2 bump)))
                                    (setq kk2 (1+ kk2))
                                  )
                                  (setq didBump 1)
                                )
                              )
                            )
                          )
                          (setq tmp (cdr tmp))
                        )
                      )
                    )

                    (if (not didBump)
                      (setq seq (g365_append_pt seq (nth jj startPoly)))
                    )
                    (setq jj (1+ jj))
                  )

                  (setq farOther (g365_last otherPoly))
                  (setq seq (g365_append_pt seq farOther))

                  (setq nOther (length otherPoly))
                  (setq idxCur (- nOther 2))
                  (while (>= idxCur 1)
                    (setq key (g365_ptkey (nth idxCur childAug)))
                    (setq brList (cdr (assoc key childBM)))
                    (setq didBump nil)

                    (if brList
                      (progn
                        (setq tmp brList)
                        (while tmp
                          (setq rec (car tmp))
                          (if (= (car rec) exitTag)
                            (progn
                              (setq bump (g377_bump_force_rec otherPoly idxCur -1 (cadr rec) dist))
                              (if bump
                                (progn
                                  (setq kk2 0)
                                  (while (< kk2 (length bump))
                                    (setq seq (g365_append_pt seq (nth kk2 bump)))
                                    (setq kk2 (1+ kk2))
                                  )
                                  (setq didBump 1)
                                )
                              )
                            )
                          )
                          (setq tmp (cdr tmp))
                        )
                      )
                    )

                    (if (not didBump)
                      (setq seq (g365_append_pt seq (nth idxCur otherPoly)))
                    )

                    (setq idxCur (1- idxCur))
                  )

                  (setq seq (g365_append_pt seq exit))
                  seq
                )
              )
            )
            nil
          )
        )
      )
    )
  )
)

(defun g377_get_bpt (boundaryPts idx / isClosed)
  (setq isClosed (g376_is_closed boundaryPts))
  (if isClosed
    (g376_nth_wrap boundaryPts idx)
    (g376_nth_safe boundaryPts idx)
  )
)

(defun g378_pt_towards (from to d / vx vy ln k)
  (setq vx (- (car to) (car from)))
  (setq vy (- (cadr to) (cadr from)))
  (setq ln (sqrt (+ (* vx vx) (* vy vy))))
  (if (<= ln 1e-9)
    from
    (progn
      (setq k (/ d ln))
      (list (+ (car from) (* k vx)) (+ (cadr from) (* k vy)) 0.0)
    )
  )
)

(defun g377_valid_inter (p0 p1 a b bpt maxd / ip tb tp)
  (setq ip (g365_line_inter p0 p1 a b))
  (if ip
    (progn
      (setq tb (g365_seg_param a b ip))
      (setq tp (g365_seg_param p0 p1 ip))
      (if (and tb tp
               (>= tb -0.05) (<= tb 1.05)
               (>= tp -0.05) (<= tp 1.05)
               (<= (distance ip bpt) maxd))
        ip
        nil
      )
    )
    nil
  )
)

(defun g377_proj_on_seg (p a b / res)
  (setq res (g365_closest_on_seg p a b))
  (if res (nth 0 res) nil)
)

(defun g377_pick_attach (poly prevPt bpt nextPt maxd usePrev / p0 p1 ip)
  (setq p0 (nth 0 poly))
  (setq p1 (nth 1 poly))
  (if (and p0 p1)
    (progn
      (if usePrev
        (progn
          (setq ip (if prevPt (g377_valid_inter p0 p1 prevPt bpt bpt maxd) nil))
          (if (null ip) (setq ip (if prevPt (g377_proj_on_seg p0 prevPt bpt) nil)))
        )
        (progn
          (setq ip (if nextPt (g377_valid_inter p0 p1 bpt nextPt bpt maxd) nil))
          (if (null ip) (setq ip (if nextPt (g377_proj_on_seg p0 bpt nextPt) nil)))
        )
      )
      (if (and ip (> (distance ip bpt) maxd)) (setq ip nil))
      ip
    )
    nil
  )
)

(defun g377_bump_force_rec (boundaryPts idx step childId dist / bump)
  (setq bump (g372_bump_open_mouth_rec boundaryPts idx step childId dist))
  (if bump bump (g377_bump_vertex_cap boundaryPts idx step childId dist))
)

(defun g377_bump_force_half (boundaryPts idx step childId dist useIncoming / bump)
  (setq bump (g372_bump_open_mouth_half_rec boundaryPts idx step childId dist useIncoming))
  (if bump bump (g377_bump_vertex_cap boundaryPts idx step childId dist))
)

(defun g385_chamfer_fix (pts dist / n i out p0 p1 p2 p3 u01 u12 u23 l12 dot01_23 dot12_01 dot12_23 ip maxD)
  (setq n (length pts))
  (if (or (null pts) (< n 4))
    pts
    (progn
      (setq out nil)
      (setq out (g365_append_pt out (nth 0 pts)))
      (setq i 1)
      (while (< i n)
        (if (<= i (- n 3))
          (progn
            (setq p0 (nth (1- i) pts))
            (setq p1 (nth i pts))
            (setq p2 (nth (1+ i) pts))
            (setq p3 (nth (+ i 2) pts))

            (setq l12 (distance p1 p2))
            (setq u01 (g365_unit (- (car p1) (car p0)) (- (cadr p1) (cadr p0))))
            (setq u12 (g365_unit (- (car p2) (car p1)) (- (cadr p2) (cadr p1))))
            (setq u23 (g365_unit (- (car p3) (car p2)) (- (cadr p3) (cadr p2))))

            (setq dot01_23 (g365_abs (g365_dot (car u01) (cadr u01) (car u23) (cadr u23))))
            (setq dot12_01 (g365_abs (g365_dot (car u12) (cadr u12) (car u01) (cadr u01))))
            (setq dot12_23 (g365_abs (g365_dot (car u12) (cadr u12) (car u23) (cadr u23))))

            (setq maxD (* 8.0 dist))

            (if (and (> dist 0.0)
                     (<= l12 (* 4.0 dist))
                     (< dot01_23 0.35)
                     (< dot12_01 0.95)
                     (< dot12_23 0.95)
                     (<= (distance p1 p0) maxD)
                     (<= (distance p2 p3) maxD))
              (progn
                (setq ip (g365_line_inter p0 p1 p2 p3))
                (if (and ip (<= (distance ip p1) maxD) (<= (distance ip p2) maxD))
                  (progn
                    (setq out (g365_append_pt out ip))
                    (setq i (+ i 2))
                  )
                  (progn
                    (setq out (g365_append_pt out p1))
                    (setq i (1+ i))
                  )
                )
              )
              (progn
                (setq out (g365_append_pt out p1))
                (setq i (1+ i))
              )
            )
          )
          (progn
            (setq out (g365_append_pt out (nth i pts)))
            (setq i (1+ i))
          )
        )
      )
      out
    )
  )
)

(defun g385_simplify_colinear (pts dist / n i out pPrev pCur pNext u1 u2 dotv res d tol)
  (setq n (length pts))
  (if (or (null pts) (< n 3))
    pts
    (progn
      (setq tol (max 0.05 (* 0.02 dist)))
      (setq out nil)
      (setq out (g365_append_pt out (nth 0 pts)))
      (setq i 1)
      (while (< i (1- n))
        (setq pPrev (g365_last out))
        (setq pCur (nth i pts))
        (setq pNext (nth (1+ i) pts))

        (setq u1 (g365_unit (- (car pCur) (car pPrev)) (- (cadr pCur) (cadr pPrev))))
        (setq u2 (g365_unit (- (car pNext) (car pCur)) (- (cadr pNext) (cadr pCur))))
        (setq dotv (g365_abs (g365_dot (car u1) (cadr u1) (car u2) (cadr u2))))

        (setq res (g365_closest_on_seg pCur pPrev pNext))
        (setq d (if res (nth 2 res) 1e99))

        (if (and (> dotv 0.9995) (<= d tol))
          out
          (setq out (g365_append_pt out pCur))
        )

        (setq i (1+ i))
      )
      (setq out (g365_append_pt out (nth (1- n) pts)))
      out
    )
  )
)

(defun g385_postprocess_path (pts dist / p1 p2)
  (setq p1 (g385_chamfer_fix pts dist))
  (setq p2 (g385_simplify_colinear p1 dist))
  p2
)

(defun g418_drop_last (pts / out)
  (if (and pts (> (length pts) 0))
    (reverse (cdr (reverse pts)))
    pts
  )
)

(defun g419_entmake_open_poly (lay pts / n data e p)
  (setq n (length pts))
  (if (and n (> n 1))
    (progn
      (setq data (list
        (cons 0 "LWPOLYLINE")
        (cons 100 "AcDbEntity")
        (cons 8 lay)
        (cons 100 "AcDbPolyline")
        (cons 90 n)
        (cons 70 0)
        (cons 38 0.0)
        (cons 43 0.0)
      ))
      (while pts
        (setq p (car pts))
        (setq data (append data (list (cons 10 (list (car p) (cadr p))))))
        (setq pts (cdr pts))
      )
      (setq e (entmakex data))
      e
    )
    nil
  )
)

(defun g419_main_tangent (pts idx / n i0 i1 p0 p1 v)
  (setq n (length pts))
  (if (< n 2)
    (list 0.0 0.0)
    (progn
      (setq i0 (max 0 (1- idx)))
      (setq i1 (min (1- n) (1+ idx)))
      (setq p0 (nth i0 pts))
      (setq p1 (nth i1 pts))
      (setq v (list (- (car p1) (car p0)) (- (cadr p1) (cadr p0))))
      (g365_unit (car v) (cadr v))
    )
  )
)

(defun g419_best_cap_start_index (outPts pMain uMain dist / n i a b mid v u dotv len d score best bestI)
  (setq n (length outPts))
  (setq i 0 best 1e99 bestI 0)
  (while (< i n)
    (setq a (nth i outPts))
    (setq b (nth (rem (1+ i) n) outPts))
    (setq mid (list (/ (+ (car a) (car b)) 2.0) (/ (+ (cadr a) (cadr b)) 2.0) 0.0))
    (setq v (list (- (car b) (car a)) (- (cadr b) (cadr a))))
    (setq len (sqrt (+ (* (car v) (car v)) (* (cadr v) (cadr v)))))
    (setq u (if (> len 1e-9) (list (/ (car v) len) (/ (cadr v) len)) (list 0.0 0.0)))
    (setq dotv (g365_abs (g365_dot (car u) (cadr u) (car uMain) (cadr uMain))))
    (setq d (distance mid pMain))
    (setq score (+ d (* dotv (* 10.0 dist)) (g365_abs (- len (* 2.0 dist)))))
    (if (< score best)
      (progn (setq best score) (setq bestI i))
    )
    (setq i (1+ i))
  )
  (rem (1+ bestI) n)
)

(defun g418_rebuild_outline_seam (outline lay pick mainPts dist / outPts nearV iMain pMain uMain k pts2 newEnt)
  (if (and outline (entget outline))
    (progn
      (setq outPts (g365_get_pts outline))
      (if (and outPts (>= (length outPts) 3) (g376_is_closed outPts))
        (setq outPts (g418_drop_last outPts))
      )
      (if (and outPts (>= (length outPts) 3) pick mainPts dist)
        (progn
          (setq nearV (g417_nearest_vertex pick mainPts))
          (setq iMain (car nearV))
          (setq pMain (cadr nearV))
          (setq uMain (g419_main_tangent mainPts iMain))
          (setq k (g419_best_cap_start_index outPts pMain uMain dist))
          (setq pts2 (g417_rotate outPts k))
          (setq newEnt (g419_entmake_open_poly lay pts2))
          (if newEnt
            (progn
              (entdel outline)
              newEnt
            )
            outline
          )
        )
        outline
      )
    )
    outline
  )
)

