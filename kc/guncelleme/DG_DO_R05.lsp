(defun DEGN-DEGA--endpoints-hit-any-chain (cand chain tol / ce p q hit pl r)
  (setq ce (DEGN-DEGA--endpoints cand))
  (setq p (car ce)  q (cadr ce))
  (setq hit nil)

  (foreach pl chain
    (if (not hit)
      (progn
        (setq r (DEGN-DEGA--pt->curve-hit p pl tol))
        (if r (setq hit (list p pl (car r) (cadr r))))
      )
    )
  )

  (if (not hit)
    (foreach pl chain
      (if (not hit)
        (progn
          (setq r (DEGN-DEGA--pt->curve-hit q pl tol))
          (if r (setq hit (list q pl (car r) (cadr r))))
        )
      )
    )
  )
  hit
)



