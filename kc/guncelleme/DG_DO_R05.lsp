(defun DW_ORIG
  (/ ss blockSs i ent ed typ lay len lenPair curveSums
     blkObj blkName
     symPairs adet adetUse pair sym
     aggAssoc existing
     emList hasEM
     matrix rowOrder anyMahalHit
     key line col mahalName mahalObjs mPair qty
     pageName tmp filepath csvfile alanNo areaMatrix areaCols areaRowOrder
     lengthMatrix lengthAreaCols lengthRows dpVals gap)

  (degw-ensure-vlax)

  ;; Mahal listesi (global)
  (setq emList (degw-get-emahal-unique))
  (setq hasEM (and emList (> (length emList) 0)))

  (setq pageName (getstring T "\nDW - CSV dosya ismini yazýn (boþ = iptal): "))
  (if (or (null pageName) (= pageName ""))
    (progn (princ "\n\nÝptal edildi.") (princ))
    (progn
      (setq pageName (degw-sanitize-filename pageName))

      ;; Klasör seçimi (1 kere)
      (setq *degwFolder*
        (DEGDO--csv-folder *degwFolder* pageName "DW - CSV kaydedilecek konumu secin")
      )
      (if (not *degwFolder*)
        (princ "\n\nDO > KAYIT sayfasinda klasor lokasyonu girin.")
        (progn
          (setq filepath (DEGDO--csv-filepath *degwFolder* pageName))
          (setq csvfile (open filepath "w"))

          (if (not csvfile)
            (princ (strcat "\nDosya açýlamadý/oluþturulamadý: " filepath))
            (progn
              (setq alanNo 1)
              (setq areaMatrix nil)
              (setq areaCols nil)
              (setq areaRowOrder nil)
              (setq lengthMatrix nil)
              (setq lengthAreaCols nil)
              (setq lengthRows nil)
              (setq dpVals (DEGDO--dp-e-values-alist))

              ;; Coklu alan seçimi (ENTER = bitir)
              (while
                (progn
                  (princ (strcat "\n\nAlan " (itoa alanNo) " seçin (pencere, crossing vs. serbest seçim) <ENTER=bitir>: "))
                  (setq ss
                    (ssget
                      '((0 . "INSERT,LINE,LWPOLYLINE,POLYLINE,SPLINE,ARC,CIRCLE,ELLIPSE,HELIX,MLINE"))))
                )

                (if ss
                  (progn
                    ;; Her alan için sifirla
                    (setq aggAssoc '())
                    (setq matrix '())
                    (setq rowOrder '())
                    (setq curveSums '())

                    ;; Ayni alan secimindeki bloklari ve sonlu cizgi/egrileri ayir.
                    (setq blockSs (ssadd))
                    (setq i 0)
                    (while (< i (sslength ss))
                      (setq ent (ssname ss i)
                            ed  (entget ent)
                            typ (cdr (assoc 0 ed)))
                      (if (= typ "INSERT")
                        (ssadd ent blockSs)
                        (progn
                          (setq lay (cdr (assoc 8 ed))
                                len (degp--length ent))
                          (if (> len 0.0)
                            (progn
                              ;; DP'de bu layer icin adet tanimliysa ayni carpani uygula.
                              (setq qty (degp--numstr (DEGDO--dp-e-value-get dpVals lay)))
                              (if qty (setq len (* len qty)))
                              (setq curveSums (degp--alist-add curveSums lay len))
                            )
                          )
                        )
                      )
                      (setq i (1+ i))
                    )

                    (setq lengthAreaCols (append lengthAreaCols (list alanNo)))
                    (foreach lenPair curveSums
                      (setq lay (car lenPair))
                      (setq lengthRows (degw-roworder-add lengthRows lay))
                      (setq lengthMatrix
                        (degw-matrix-inc lengthMatrix lay alanNo (cdr lenPair)))
                    )
                    (setq ss blockSs)

                    (setq i 0)
                    (while (< i (sslength ss))
                      (setq ent    (ssname ss i))
                      (setq blkObj (vlax-ename->vla-object ent))
                      (setq blkName (deg-block-name blkObj))

                                            (if (not (vl-string-search "_OK_" (strcase blkName)))
                        (progn
(if (and
                            (not (wcmatch (strcase (degw-block-effective-name blkObj)) "*E_MAHAL*"))
                            (not (wcmatch (strcase blkName) "*E_MAHAL*"))
                          )
                        (progn
                          (if (not (deg-member blkName (DEG:VALS '(P1 I2 M1 J1 J2 J3))))
                            (progn
                              (setq symPairs (get-sembol-adi-from-block blkObj))
                              (setq adet     (get-adet-from-block blkObj))

                              (setq adetUse
                                    (cond
                                      ((> adet 0) adet)
                                      ((and symPairs (> (cdr (car symPairs)) 0))
                                       (cdr (car symPairs)))
                                      (T 1)
                                    )
                              )

                              (if (not symPairs)
                                (setq symPairs (list (cons "" adetUse)))
                              )

                              (foreach pair symPairs
                                (setq sym (car pair))

                                (if (not hasEM)
                                  (progn
                                    (setq existing
                                          (vl-some
                                            (function
                                              (lambda (x)
                                                (if (and (= (car x) blkName)
                                                         (= (cadr x) sym))
                                                  x
                                                )
                                              )
                                            )
                                            aggAssoc
                                          )
                                    )
                                    (if existing
                                      (setq aggAssoc
                                            (subst
                                              (list blkName sym (+ adetUse (caddr existing)))
                                              existing
                                              aggAssoc
                                            )
                                      )
                                      (setq aggAssoc (cons (list blkName sym adetUse) aggAssoc))
                                    )
                                  )
                                  (progn
                                    (setq anyMahalHit nil)
                                    (setq key (list blkName sym))
                                    (setq rowOrder (degw-roworder-add rowOrder key))

                                    (foreach em emList
                                      (setq mahalName (car em))
                                      (setq mahalObjs (cdr em)) ; obj listesi
                                      (setq mPair nil)

                                      (foreach mo mahalObjs
                                        (if (and (not mPair) (degw-touch-p blkObj mo))
                                          (setq mPair T)
                                        )
                                      )

                                      (if mPair
                                        (progn
                                          (setq anyMahalHit T)
                                          (setq matrix (degw-matrix-inc matrix key mahalName adetUse))
                                        )
                                      )
                                    )

                                    (if (not anyMahalHit)
                                      (setq matrix (degw-matrix-inc matrix key "MAHALSIZ" adetUse))
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )

                        )
                      )
                      (setq i (1+ i))
                    )

                    ;; --- CSV yazimi / biriktirme ---
                    (if (not hasEM)
                      (progn
                        ;; Mahal bloðu yoksa: alanlari kolon yapacak sekilde biriktir
                        (setq areaCols (append areaCols (list alanNo)))
                        (foreach p (reverse aggAssoc)
                          (setq key (list (car p) (cadr p)))
                          (setq areaRowOrder (degw-roworder-add areaRowOrder key))
                          (setq areaMatrix (degw-matrix-inc areaMatrix key alanNo (caddr p)))
                        )
                      )
                      (progn
                        ;; Mahal bloðu varsa: mevcut format (alan bazlý)
                        (write-line (strcat "ALAN;" (itoa alanNo)) csvfile)

                        (setq line "BlokAdi;SembolAdi")
                        (foreach em emList
                          (setq line (strcat line ";" (car em)))
                        )
                        (setq line (strcat line ";MAHALSIZ"))
                        (write-line line csvfile)

                        (foreach key (reverse rowOrder)
                          (setq line (strcat (car key) ";" (cadr key)))
                          (foreach em emList
                            (setq col (car em))
                            (setq mPair (assoc key matrix))
                            (if mPair
                              (progn
                                (setq qty (assoc col (cdr mPair)))
                                (setq qty (if qty (cdr qty) 0))
                              )
                              (setq qty 0)
                            )
                            (setq line (strcat line ";" (itoa qty)))
                          )

                          (setq mPair (assoc key matrix))
                          (if mPair
                            (progn
                              (setq qty (assoc "MAHALSIZ" (cdr mPair)))
                              (setq qty (if qty (cdr qty) 0))
                            )
                            (setq qty 0)
                          )
                          (setq line (strcat line ";" (itoa qty)))

                          (write-line line csvfile)
                        )

                        ;; Alanlar arasýi boþ satir
                        (write-line "" csvfile)
                      )
                    )
                    (setq alanNo (1+ alanNo))
                  )
                )
              )

              
              ;; Mahal bloðu yoksa: tum alanlari tek tabloda yaz
              (if (not hasEM)
                (progn
                  (if areaCols
                    (progn
                      (setq line "BlokAdi;SembolAdi")
                      (foreach col areaCols
                        (setq line (strcat line ";ALAN" (itoa col)))
                      )
                      (write-line line csvfile)

                      (foreach key (reverse areaRowOrder)
                        (setq line (strcat (car key) ";" (cadr key)))
                        (foreach col areaCols
                          (setq mPair (assoc key areaMatrix))
                          (if mPair
                            (progn
                              (setq qty (assoc col (cdr mPair)))
                              (setq qty (if qty (cdr qty) 0))
                            )
                            (setq qty 0)
                          )
                          (setq line (strcat line ";" (itoa qty)))
                        )
                        (write-line line csvfile)
                      )
                    )
                    (if (not areaMatrix) (write-line "BlokAdi;SembolAdi" csvfile))
                  )
                )
              )

              ;; Son adet satirindan sonra tam 3 bos satir ve alan bazli uzunluklar.
              (if lengthMatrix
                (progn
                  ;; Mahal formatinda son alan tablosu zaten 1 bos satir birakir.
                  (setq gap (if hasEM 2 3))
                  (repeat gap (write-line "" csvfile))
                  (write-line "LAYER UZUNLUKLARI" csvfile)

                  ;; Ustteki BlokAdi;SembolAdi kolonlarini koru; ALAN kolonlari hizali kalsin.
                  (setq line "Layer;")
                  (foreach col lengthAreaCols
                    (setq line
                      (strcat line ";ALAN" (itoa col) " (metre)"))
                  )
                  (write-line line csvfile)

                  (setq lengthRows
                    (vl-sort lengthRows
                      (function
                        (lambda (a b) (< (strcase a) (strcase b))))))
                  (foreach lay lengthRows
                    (setq line (strcat lay ";"))
                    (setq mPair (assoc lay lengthMatrix))
                    (foreach col lengthAreaCols
                      (setq qty (if mPair (assoc col (cdr mPair)) nil))
                      (setq len (if qty (cdr qty) 0.0))
                      (setq line (strcat line ";" (DEG:DP-LEN-STR len)))
                    )
                    (write-line line csvfile)
                  )
                )
              )
(close csvfile)
              (princ (strcat "\nDEGW: Olüstürulan dosya: " filepath))
            )
          )
        )
      )
    )
  )

  (princ)
)

(defun degm-csv-cell (s)
  (if (null s) (setq s ""))
  (setq s (vl-string-subst "\"\"" "\"" s))
  (if (or (vl-string-search ";" s)
          (vl-string-search "\"" s)
          (vl-string-search "\n" s)
          (vl-string-search "\r" s))
    (strcat "\"" s "\"")
    s
  )
)

(defun degm-get-sembol-adi (blkObj / symPairs)
  (setq symPairs (get-sembol-adi-from-block blkObj))
  (if (and symPairs (car symPairs))
    (degm-clean-text (car (car symPairs)))
    ""
  )
)

(defun degm-xref-blockref-p (ent / edata blkDef blkName flags)
  (setq edata (entget ent))
  (setq blkName (cdr (assoc 2 edata)))
  (or
    (and blkName (vl-string-search "|" blkName))
    (and
      blkName
      (setq blkDef (tblsearch "BLOCK" blkName))
      (setq flags (cdr (assoc 70 blkDef)))
      (/= 0 (logand flags 124))
    )
  )
)



(defun degm-delete-selection (ss / i ent obj)
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent (ssname ss i))
        (if ent
          (progn
            (setq obj (vlax-ename->vla-object ent))
            (vl-catch-all-apply 'vla-delete (list obj))
          )
        )
        (setq i (1+ i))
      )
    )
  )
  T
)

(defun degm-write-room-row
  (filepath mahalName ss / counts allPairs matrix colCount roomRow rowPair key cnt colIdx)

  (setq counts   (degm-collect-selection-counts ss))
  (setq allPairs (degm-collect-all-pairs))
  (setq matrix   (degm-normalize-matrix (if (findfile filepath) (degm-read-csv-matrix filepath) nil)))

  (if (< (length matrix) 2)
    (setq matrix (list (list "BLOCK ADI") (list "SEMBOL ADI")))
  )

  (setq colCount (max 1 (degm-maxcols matrix)))
  (setq matrix   (degm-pad-matrix matrix colCount))
  (setq matrix   (degm-set-nth 0 (degm-set-nth 0 "BLOCK ADI" (nth 0 matrix)) matrix))
  (setq matrix   (degm-set-nth 1 (degm-set-nth 0 "SEMBOL ADI" (nth 1 matrix)) matrix))

  (foreach rowPair allPairs
    (if (null (degm-find-pair-col matrix (car rowPair) (cadr rowPair)))
      (setq matrix (degm-add-pair-col matrix (car rowPair) (cadr rowPair)))
    )
  )

  (setq colCount (max 1 (degm-maxcols matrix)))
  (setq matrix   (degm-pad-matrix matrix colCount))
  (setq roomRow  (degm-pad-row (list mahalName) colCount))

  (foreach rowPair allPairs
    (setq key    (degm-pair-key (degm-clean-text (car rowPair)) (degm-clean-text (cadr rowPair))))
    (setq cnt    (cdr (assoc key counts)))
    (setq colIdx (degm-find-pair-col matrix (degm-clean-text (car rowPair)) (degm-clean-text (cadr rowPair))))
    (if (and colIdx cnt (> cnt 0))
      (setq roomRow (degm-set-nth colIdx (itoa cnt) roomRow))
    )
  )

  (setq matrix (append matrix (list roomRow)))
  (degm-write-matrix filepath matrix)
)

(defun degm-clean-text (s / out)
  (setq out (if s s ""))
  (setq out (vl-string-translate (strcat (chr 9) (chr 10) (chr 13)) " " out))
  (setq out (vl-string-trim " " out))
  out
)

(defun degm-pair-key (blk sym)
  (strcat (strcase (degm-clean-text blk)) " " (strcase (degm-clean-text sym)))
)

(defun degm-inc-count (alist key / a)
  (if (setq a (assoc key alist))
    (subst (cons key (1+ (cdr a))) a alist)
    (cons (cons key 1) alist)
  )
)

(defun degm-valid-block-ent-p (ent / ed blkObj blkName)
  (and ent
       (setq ed (entget ent))
       (= (cdr (assoc 0 ed)) "INSERT")
       (= (cdr (assoc 410 ed)) "Model")
       (not (degm-xref-blockref-p ent))
       (setq blkObj (vlax-ename->vla-object ent))
       (setq blkName (degm-clean-text (deg-block-name blkObj)))
       (/= blkName "")
       (not (vl-string-search "_OK_" (strcase blkName)))
       (not (vl-string-search "LINYE" (strcase blkName)))
  )
)

(defun degm-collect-all-pairs (/ ss i ent blkObj blkName sym key seen out)
  (setq seen '())
  (setq out  '())
  (setq ss (ssget "_X" '((0 . "INSERT") (410 . "Model"))))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent (ssname ss i))
        (if (degm-valid-block-ent-p ent)
          (progn
            (setq blkObj  (vlax-ename->vla-object ent))
            (setq blkName (degm-clean-text (deg-block-name blkObj)))
            (setq sym     (degm-clean-text (degm-get-sembol-adi blkObj)))
            (setq key (degm-pair-key blkName sym))
            (if (not (member key seen))
              (progn
                (setq seen (cons key seen))
                (setq out  (append out (list (list blkName sym))))
              )
            )
          )
        )
        (setq i (1+ i))
      )
    )
  )
  out
)

(defun degm-collect-selection-counts (ss / i ent blkObj blkName sym key counts)
  (setq counts '())
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent (ssname ss i))
        (if (degm-valid-block-ent-p ent)
          (progn
            (setq blkObj  (vlax-ename->vla-object ent))
            (setq blkName (degm-clean-text (deg-block-name blkObj)))
            (setq sym     (degm-clean-text (degm-get-sembol-adi blkObj)))
            (setq key    (degm-pair-key blkName sym))
            (setq counts (degm-inc-count counts key))
          )
        )
        (setq i (1+ i))
      )
    )
  )
  counts
)

(defun degm-csv-parse-line (line / i len ch field fields inQ nxt)
  (setq i 1
        len (strlen line)
        field ""
        fields '()
        inQ nil)
  (while (<= i len)
    (setq ch (substr line i 1))
    (cond
      ((= ch "\"")
       (if inQ
         (progn
           (setq nxt (if (< i len) (substr line (1+ i) 1) ""))
           (if (= nxt "\"")
             (progn
               (setq field (strcat field "\""))
               (setq i (1+ i))
             )
             (setq inQ nil)
           )
         )
         (setq inQ T)
       )
      )
      ((and (not inQ) (= ch ";"))
       (setq fields (append fields (list field)))
       (setq field "")
      )
      (T
       (setq field (strcat field ch))
      )
    )
    (setq i (1+ i))
  )
  (append fields (list field))
)

(defun degm-read-lines (path / fh ln out)
  (setq out '())
  (if (setq fh (open path "r"))
    (progn
      (while (setq ln (read-line fh))
        (setq out (append out (list ln)))
      )
      (close fh)
    )
  )
  out
)

(defun degm-read-csv-matrix (path / lines matrix)
  (setq lines  (degm-read-lines path))
  (setq matrix '())
  (foreach ln lines
    (setq matrix (append matrix (list (degm-csv-parse-line ln))))
  )
  matrix
)

(defun degm-make-list (n val / out)
  (setq out '())
  (while (> n 0)
    (setq out (cons val out))
    (setq n (1- n))
  )
  out
)

(defun degm-maxcols (matrix / m)
  (setq m 0)
  (foreach row matrix
    (if (> (length row) m)
      (setq m (length row))
    )
  )
  m
)

(defun degm-pad-row (row n / diff)
  (setq diff (- n (length row)))
  (if (> diff 0)
    (append row (degm-make-list diff ""))
    row
  )
)

(defun degm-pad-matrix (matrix n / out)
  (setq out '())
  (foreach row matrix
    (setq out (append out (list (degm-pad-row row n))))
  )
  out
)

(defun degm-horizontal-matrix-p (matrix / r1 r2)
  (and matrix
       (>= (length matrix) 2)
       (setq r1 (car matrix))
       (setq r2 (cadr matrix))
       (= (strcase (if (car r1) (car r1) "")) "BLOCK ADI")
       (= (strcase (if (car r2) (car r2) "")) "SEMBOL ADI")
  )
)

(defun degm-vertical-matrix-p (matrix / r1)
  (and matrix
       (setq r1 (car matrix))
       (>= (length r1) 2)
       (= (strcase (if (nth 0 r1) (nth 0 r1) "")) "BLOCK ADI")
       (= (strcase (if (nth 1 r1) (nth 1 r1) "")) "SEMBOL ADI")
  )
)

(defun degm-convert-vertical-to-horizontal (matrix / header pairRows row1 row2 out roomIdx roomName roomRow pairRow maxc)
  (setq header   (car matrix))
  (setq pairRows (cdr matrix))
  (setq row1 (list "BLOCK ADI"))
  (setq row2 (list "SEMBOL ADI"))

  (foreach pairRow pairRows
    (setq row1 (append row1 (list (if (nth 0 pairRow) (nth 0 pairRow) ""))))
    (setq row2 (append row2 (list (if (nth 1 pairRow) (nth 1 pairRow) ""))))
  )

  (setq out (list row1 row2))
  (setq roomIdx 2)
  (while (< roomIdx (length header))
    (setq roomName (nth roomIdx header))
    (setq roomRow (list (if roomName roomName "")))
    (foreach pairRow pairRows
      (setq roomRow (append roomRow (list (if (nth roomIdx pairRow) (nth roomIdx pairRow) ""))))
    )
    (setq out (append out (list roomRow)))
    (setq roomIdx (1+ roomIdx))
  )

  (setq maxc (max 1 (degm-maxcols out)))
  (degm-pad-matrix out maxc)
)

(defun degm-normalize-matrix (matrix)
  (cond
    ((null matrix)
     (list (list "BLOCK ADI") (list "SEMBOL ADI"))
    )
    ((degm-horizontal-matrix-p matrix)
     (degm-pad-matrix matrix (max 1 (degm-maxcols matrix)))
    )
    ((degm-vertical-matrix-p matrix)
     (degm-convert-vertical-to-horizontal matrix)
    )
    (T
     (list (list "BLOCK ADI") (list "SEMBOL ADI"))
    )
  )
)

(defun degm-find-pair-col (matrix blk sym / row1 row2 idx found)
  (setq row1  (car matrix)
        row2  (cadr matrix)
        idx   1
        found nil)
  (setq blk (degm-clean-text blk)
        sym (degm-clean-text sym))
  (while (and (< idx (length row1)) (not found))
    (if (and (= (strcase (degm-clean-text (if (nth idx row1) (nth idx row1) ""))) (strcase blk))
             (= (strcase (degm-clean-text (if (nth idx row2) (nth idx row2) ""))) (strcase sym)))
      (setq found idx)
    )
    (setq idx (1+ idx))
  )
  found
)

(defun degm-set-nth (idx val lst / out i)
  (setq out '()
        i   0)
  (foreach x lst
    (if (= i idx)
      (setq out (append out (list val)))
      (setq out (append out (list x)))
    )
    (setq i (1+ i))
  )
  out
)

(defun degm-add-pair-col (matrix blk sym / out row idx)
  (setq out '()
        idx 0)
  (foreach row matrix
    (cond
      ((= idx 0)
       (setq out (append out (list (append row (list (if blk blk ""))))))
      )
      ((= idx 1)
       (setq out (append out (list (append row (list (if sym sym ""))))))
      )
      (T
       (setq out (append out (list (append row (list "")))))
      )
    )
    (setq idx (1+ idx))
  )
  out
)

(defun degm-join-semi (lst / out)
  (setq out "")
  (foreach x lst
    (if (= out "")
      (setq out (degm-csv-cell (if x x "")))
      (setq out (strcat out ";" (degm-csv-cell (if x x ""))))
    )
  )
  out
)

(defun degm-write-matrix (path matrix / fh)
  (if (setq fh (open path "w"))
    (progn
      (foreach row matrix
        (write-line (degm-join-semi row) fh)
      )
      (close fh)
      T
    )
    nil
  )
)

(defun DM_ORIG
  (/ pageName tmp filepath ss mahalName done emptySelCount emptyMahCount writeOk)

  (degw-ensure-vlax)

  (setq pageName (getstring T "\nDM - CSV dosya ismini yazýn (boþ = iptal): "))
  (if (or (null pageName) (= pageName ""))
    (progn
      (princ "\n\nÝptal edildi.")
      (princ)
    )
    (progn
      (setq pageName (degw-sanitize-filename pageName))

      (setq *degmFolder*
        (DEGDO--csv-folder *degmFolder* pageName "DM - CSV kaydedilecek konumu secin")
      )
      (if (not *degmFolder*)
        (princ "\n\nDO > KAYIT sayfasinda klasor lokasyonu girin.")
        (progn
          (setq filepath (DEGDO--csv-filepath *degmFolder* pageName))
          (setq done nil)
          (setq emptySelCount 0)

          (while (not done)
            (princ "\nBloklarý seçin: ")
            (setq ss (ssget '((0 . "INSERT"))))

            (if (not ss)
              (progn
                (setq emptySelCount (1+ emptySelCount))
                (if (>= emptySelCount 2)
                  (setq done T)
                  (princ "\nDM: Devam için blok seçin, bitirmek için tekrar Enter.")
                )
              )
              (progn
                (setq emptySelCount 0)
                (setq mahalName nil)
                (setq emptyMahCount 0)

                (while (and (not done) (null mahalName))
                  (setq mahalName (getstring T "\nMahal ismini yazýn: "))
                  (if (or (null mahalName) (= mahalName ""))
                    (progn
                      (setq mahalName nil)
                      (setq emptyMahCount (1+ emptyMahCount))
                      (if (>= emptyMahCount 2)
                        (setq done T)
                        (princ "\nDM: Devam için mahal ismi yazýn, çýkmak için tekrar Enter.")
                      )
                    )
                    (setq mahalName (degm-clean-text mahalName))
                  )
                )

                (if (and (not done) mahalName (/= mahalName ""))
                  (progn
                    (setq writeOk (degm-write-room-row filepath mahalName ss))
                    (if writeOk
                      (progn
                        (degm-delete-selection ss)
                        (princ (strcat "\nDM: Satýr yazýldý ve seçili bloklar silindi -> " mahalName))
                      )
                      (princ (strcat "\nDosya yazýlamadý: " filepath))
                    )
                  )
                )
              )
            )
          )

          (princ (strcat "\nDM tamamlandý: " filepath))
        )
      )
    )
  )

  (princ)
)

