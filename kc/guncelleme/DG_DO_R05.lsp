(defun DEGQ:_attval (blk key / atts lst a tval)
  (setq tval "")
  (if (and blk key)
    (progn
      (if (vlax-method-applicable-p blk 'GetAttributes)
        (progn
          (setq atts (vlax-invoke blk 'GetAttributes))
          (setq lst (cond
                      ((= (type atts) 'VARIANT)  (vlax-safearray->list (vlax-variant-value atts)))
                      ((= (type atts) 'SAFEARRAY) (vlax-safearray->list atts))
                      (T nil)
                    )
          )
          (foreach a lst
            (if (or
                  (= (strcase (vla-get-TagString a)) (strcase key))
                  (and (vlax-property-available-p a 'PromptString)
                       (= (strcase (vla-get-PromptString a)) (strcase key)))
                )
              (setq tval (vla-get-TextString a))
            )
          )
        )
      )
    )
  )
  tval
)




(defun DEGQ:_attclear (blk tag / a)
  (if (and blk tag (vlax-method-applicable-p blk 'GetAttributes))
    (foreach a (vlax-safearray->list (vlax-variant-value (vla-GetAttributes blk)))
      (if (= (strcase (vla-get-TagString a)) (strcase tag))
        (vla-put-TextString a "")
      )
    )
  )
  (princ)
)


(defun DEGQ:_sirano-int-from-ename (blkE / e d tag val n)
  (setq tag "SIRA_NO")
  (setq val "")
  (if blkE
    (progn
      (setq e (entnext blkE))
      (while (and e (setq d (entget e)) (not (= (cdr (assoc 0 d)) "SEQEND")))
        (if (= (cdr (assoc 0 d)) "ATTRIB")
          (if (= (strcase (cdr (assoc 2 d))) tag)
            (setq val (cdr (assoc 1 d)))
          )
        )
        (setq e (entnext e))
      )
    )
  )
  (setq n (degk--sira-min-number val))
  (if n n 2147483647)
)

(defun DEGQ:_sort-blocks-by-sirano-int (ss / lst i e)
  (setq lst nil)
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq e (ssname ss i))
        (setq lst (cons (list (DEGQ:_sirano-int-from-ename e) e) lst))
        (setq i (1+ i))
      )
    )
  )
  (setq lst (vl-sort lst '(lambda (a b) (< (car a) (car b)))))
  (mapcar 'cadr lst)
)

