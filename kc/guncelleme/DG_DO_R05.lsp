(defun deg-doseme-inis-block-p (blkObj / nm)
  (setq nm
    (if (= (type blkObj) 'VLA-OBJECT)
      (deg-block-name blkObj)
      ""))
  (or (= nm (DEG:VAL 'M1))
      (deg-wcmatch nm (DEG:VAL 'M2))
      (deg-wcmatch nm (DEG:VAL 'M3))
      (deg-wcmatch nm (DEG:VAL 'M4)))
)

(defun bbox-test-points (blkObj / ins res minVar maxVar minPt maxPt x1 y1 x2 y2 xc yc pts i f)
  (setq pts '())
  (setq ins (deg-get-inspt blkObj))
  (if ins (setq pts (cons (deg-pt3 ins) pts)))
  (setq res (vl-catch-all-apply 'vla-getBoundingBox (list blkObj 'minVar 'maxVar)))
  (if (not (vl-catch-all-error-p res))
    (progn
      (setq minPt (DEG:PT->LIST minVar)
            maxPt (DEG:PT->LIST maxVar)
            x1 (car minPt)
            y1 (cadr minPt)
            x2 (car maxPt)
            y2 (cadr maxPt)
            xc (/ (+ x1 x2) 2.0)
            yc (/ (+ y1 y2) 2.0))
      (setq pts
        (append
          (list
            (list x1 y1 0.0) (list x1 y2 0.0) (list x2 y1 0.0) (list x2 y2 0.0)
            (list xc yc 0.0) (list xc y1 0.0) (list xc y2 0.0) (list x1 yc 0.0) (list x2 yc 0.0)
          )
          pts
        )
      )
      (setq i 1)
      (while (< i 8)
        (setq f (/ i 8.0))
        (setq pts
          (append
            (list
              (list (+ x1 (* (- x2 x1) f)) y1 0.0)
              (list (+ x1 (* (- x2 x1) f)) y2 0.0)
              (list x1 (+ y1 (* (- y2 y1) f)) 0.0)
              (list x2 (+ y1 (* (- y2 y1) f)) 0.0)
            )
            pts
          )
        )
        (setq i (1+ i))
      )
    )
  )
  pts
)
(defun poly-touch-block? (plObj blkObj tol / insPt cpt)
  (setq insPt (deg-get-inspt blkObj))
  (if (and plObj insPt)
    (progn
      (setq cpt (deg-safe-closest-point plObj insPt))
      (or
        (and (deg-pt3 insPt)
             (deg-pt3 cpt)
             (< (distance (deg-pt3 insPt) (deg-pt3 cpt)) tol))
        (and (deg-doseme-inis-block-p blkObj)
             (block-ref-contact-point plObj blkObj tol))
      )
    )
    nil
  )
)

(defun deg-poly-touch-block-base-p (plObj blkObj tol / insPt cpt)
  (setq insPt (deg-get-inspt blkObj))
  (if (and plObj (deg-pt3 insPt))
    (progn
      (setq cpt (deg-safe-closest-point plObj insPt))
      (and
        (deg-pt3 cpt)
        (< (distance (deg-pt3 insPt) (deg-pt3 cpt)) tol)))
    nil)
)



(defun deg-ss-blocks-touching-poly (plObj ss tol excludeObj / res i ent obj nm hEx)
  (setq res '())
  (setq hEx (if excludeObj (vlax-get excludeObj 'Handle) ""))
  (if (and plObj (wcmatch (deg-norm (vlax-get plObj 'Layer)) "*KIT*"))
    (progn (setq ss nil))
  )
  (if (and plObj ss)
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent (ssname ss i))
        (if ent
          (progn
            (setq obj (vlax-ename->vla-object ent))
            (if (and obj (/= (vlax-get obj 'Handle) hEx))
              (progn
                (setq nm (deg-block-name obj))
                (if (and nm (wcmatch nm "E_*")
                         (deg-poly-touch-block-base-p plObj obj tol)
                         (/= (strcase nm) (DEG:VAL 'P1)))
                  (setq res (cons obj res))
                )
              )
            )
          )
        )
        (setq i (1+ i))
      )
    )
  )
  (reverse res)
)

(defun deg-uniq-vla-by-handle (lst / res seen h o)
  (setq res '() seen '())
  (foreach o lst
    (if o
      (progn
        (setq h (vlax-get o 'Handle))
        (if (and h (not (member h seen)))
          (progn
            (setq seen (cons h seen))
            (setq res  (cons o res))
          )
        )
      )
    )
  )
  (reverse res)
)

(defun deg-block-tol (baseTol blkObj / dosemeTol)
