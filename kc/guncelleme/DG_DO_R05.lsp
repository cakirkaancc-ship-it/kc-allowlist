(defun DEGDO--win-dn-effective (key / value)
  (setq value
    (cond
      ((= key 'DN_SKIP_BLOCKS)
        (DEGDO--dn-cfg-or-codes key '(K5 K18 K3 K4)))
      ((= key 'DN_SKIP_LAYER_PATTERNS)
        (DEGDO--dn-cfg-or-mix key '(K13 K14 K15) "*KARBONMONOKSIT*"))
      ((= key 'DN_SKIP_LAYER_BLOCKS)
        (DEGDO--dn-cfg-or-codes key '(K6 K19)))
      ((= key 'DN_FILTER_IGNORE_BLOCKS)
        (DEGDO--dn-cfg-or-codes key '(N1 K2 N2)))
      ((= key 'DN_FILTER_CO_LAYER_PATTERNS)
        (DEGDO--dn-cfg-or-codes key '(K8)))
      ((= key 'DN_FILTER_CO_BLOCKS)
        (DEGDO--dn-cfg-or-codes key '(K7)))
      ((= key 'DN_FILTER_FLASOR_LAYERS)
        (DEGDO--dn-cfg-or-codes key '(K1)))
      ((= key 'DN_FILTER_FLASOR_BLOCKS)
        (DEGDO--dn-cfg-or-codes key '(K12)))
      ((= key 'DN_FILTER_SOUND_LAYER_PATTERNS)
        (DEGDO--dn-cfg-or-codes key '(K13 K14 K15)))
      ((= key 'DN_FILTER_SOUND_BLOCK_PATTERNS)
        (DEGDO--dn-cfg-or-codes key '(K13 K14 K15)))
      ((= key 'DN_FILTER_FIRE_LAYER_PATTERNS)
        (DEGDO--dn-cfg-or-codes key '(K11 K10 K9)))
      ((= key 'DN_FILTER_FIRE_BLOCK_EXCLUDES)
        (DEGDO--dn-cfg-or-codes key '(K13 K14 K15)))
      (T nil)
    )
  )
  value
)

(defun DEGDO--win-cfg-current (key / value pair)
  (cond
    ((setq value (DEGDO--win-dn-effective key)) value)
    ((and (member key '(DD_DIRSEK_DIST DD_DIRSEK_KACIS
                       DF_DIRSEK_DIST DF_DIRSEK_KACIS
                       DZ_DIRSEK_DIST DZ_DIRSEK_KACIS))
          (= (DEGDO--trim (DEG:CFG-GET key)) ""))
      (cdr (assoc key (DEGDO--win-extra-cfg-defaults))))
    ((DEGDO--win-scaled-key-p key)
      (DEGDO--dk-display key))
    (T (DEG:CFG-GET key))
  )
)

(defun DEGDO--win-cfg-default (key / pair value scale)
  (cond
    ((setq value (DEGDO--win-dn-effective key)) value)
    ((setq pair (assoc key (DEGDO--win-extra-cfg-defaults)))
      (cdr pair))
    ((setq pair (assoc key *DEG_CFG_DEFAULTS*))
      (setq value (DEG:CFG-DEFAULT key))
      (if (and (DEGDO--win-scaled-key-p key) (/= (DEGDO--trim value) ""))
        (progn
          (setq scale (DEG:PLAN-UNIT-SCALE))
          (DEG:NUM->STR (* (atof value) scale)))
        value
      )
    )
    (T "")
  )
)

(defun DEGDO--win-cfg-group (key / name)
  (setq name (vl-symbol-name key))
  (cond
    ((DEGDO--win-prefix-p "CMD_" name) "KOMUTLAR")
    ((= name "PLAN_UNIT") "PLAN")
    ((= name "DO_KAYIT_PATH") "KAYIT")
    ((DEGDO--win-prefix-p "DGT_" name) "DGT")
    ((or (DEGDO--win-prefix-p "DG_" name)
         (DEGDO--win-prefix-p "DN_" name)
         (= name "DW_TOUCH_TOL")
         (= name "DR_TREE_TOL")
         (= name "DK_TOUCH_TOL")
         (= name "DKX_TOUCH_TOL"))
      (if (or (vl-string-search "_TOL" name)
              (= name "DW_TOUCH_TOL")
              (= name "DR_TREE_TOL")
              (= name "DK_TOUCH_TOL")
              (= name "DKX_TOUCH_TOL"))
        "TOL"
        (if (DEGDO--win-prefix-p "DN_" name) "DN" "DG")))
    ((DEGDO--win-prefix-p "DD_" name) "DD")
    ((DEGDO--win-prefix-p "DF_" name) "DF")
    ((DEGDO--win-prefix-p "DZ_" name) "DZ")
    ((DEGDO--win-prefix-p "DC_" name) "DC")
    ((DEGDO--win-prefix-p "DK" name) "DK")
    ((DEGDO--win-prefix-p "DP_E_BLOCK" name) "BLOCKLAR")
    ((DEGDO--win-prefix-p "DP_" name) "DP")
    ((DEGDO--win-prefix-p "DS_" name) "DS")
    ((DEGDO--win-prefix-p "DTT_" name) "DTT")
    ((or (DEGDO--win-prefix-p "DT_" name)
         (= name "DT_KA_COLOR")
         (= name "DT_ZA_COLOR")) "DT")
    (T "GENEL")
  )
)

(defun DEGDO--win-code-group (code / name first)
  (setq name (vl-symbol-name code)
        first (substr name 1 1))
  (cond
    ((member first '("A" "B" "C" "E" "F" "G" "H")) "DG")
    ((= first "D") "DP")
    ((member first '("I" "J" "K" "L" "M" "N" "O" "P")) "DN")
    (T "GENEL")
  )
)

(defun DEGDO--win-label (key)
  (cond
    ((= key 'DK_NORMAL_AREA_LAYERS) "Normal Loop Polyline Layerlari")
    ((= key 'DK_COMBINED_RISER_LAYERS) "Kombine Polyline Layerlari")
    ((= key 'DK_NORMAL_GROUP_SPACING) "Ayni Kat Loop Araligi")
    ((= key 'DK_NORMAL_FLOOR_SPACING) "Katlar Arasi Mesafe")
    ((= key 'DK_LOOP_TEXT_HEIGHT) "Loop Text Height")
    ((= key 'DK_LOOP_TEXT_X_OFFSET) "Loop Text X Ofset")
    ((= key 'DK_LOOP_TEXT_Y_MARGIN) "Loop Text Y Bosluk")
    ((= key 'DK_LOOP_LINE_SHIFT_X) "Loop Cizgi X Kaydirma")
    ((= key 'DK_LOOP_LINE_RISE) "Loop Cizgi Dikey Uzunluk")
    ((= key 'DK_LOOP_LINE_RUN) "Loop Cizgi Yatay Uzunluk")
    ((= key 'DK_LOOP_MARK_LENGTH) "Loop 45 Derece Isaret Boyu")
    ((member key '(DD_OFFSET DF_OFFSET DZ_OFFSET)) "Ofset")
    ((member key '(DD_AGIZ_ARAMA DF_AGIZ_ARAMA DZ_AGIZ_ARAMA)) "Ana Hat Agiz Arama Mesafesi")
    ((member key '(DD_BLOK_YAKINLIK DF_BLOK_YAKINLIK DZ_BLOK_YAKINLIK)) "Blok Yakinlik Mesafesi")
    ((member key '(DD_DIRSEK_DIST DF_DIRSEK_DIST DZ_DIRSEK_DIST)) "Dirsek Baslama Mesafesi")
    ((member key '(DD_DIRSEK_KACIS DF_DIRSEK_KACIS DZ_DIRSEK_KACIS)) "Dirsek Kacis Mesafesi")
    ((= key 'DZ_COCUK_HAT_MESAFE) "Cocuk Hat Baglanti Mesafesi")
    (T (vl-string-translate "_" " " (vl-symbol-name key)))
  )
)

(defun DEGDO--win-cfg-type (key / name)
  (setq name (vl-symbol-name key))
  (cond
    ((= key 'PLAN_UNIT) "CHOICE")
    ((= key 'DO_KAYIT_PATH) "PATH")
    ((or (vl-string-search "_LAYERS" name)
         (vl-string-search "_BLOCKS" name)
         (vl-string-search "_PATTERN" name)
         (= key 'DP_E_LINE_VALUES)
         (= key 'DP_E_BLOCK_VALUES)) "LONG")
    ((or (vl-string-search "_COLOR" name)
         (vl-string-search "HATCH_PATTERN" name)
         (= key 'DTT_ATT_TEXT_STYLE)) "CHOICE")
    (T "TEXT")
  )
)

(defun DEGDO--win-cfg-options (key / name)
  (setq name (vl-symbol-name key))
  (cond
    ((= key 'PLAN_UNIT) "mm|cm|metre")
    ((vl-string-search "_COLOR" name) "1|2|3|4|5|6|7|8|9")
    ((vl-string-search "HATCH_PATTERN" name) "SOLID|HEX")
    ((= key 'DTT_ATT_TEXT_STYLE)
      (DT--palette-join (DEGDO--text-style-names)))
    (T "")
  )
)

(defun DEGDO--win-write-record (file kind key group label value default type options)
  (write-line
    (strcat
      (DEGDO--win-safe-field kind) "\t"
      (DEGDO--win-safe-field key) "\t"
      (DEGDO--win-safe-field group) "\t"
      (DEGDO--win-safe-field label) "\t"
      (DEGDO--win-safe-field value) "\t"
      (DEGDO--win-safe-field default) "\t"
      (DEGDO--win-safe-field type) "\t"
      (DEGDO--win-safe-field options))
    file
  )
)

(defun DEGDO--win-write-schema (path / file key rec layer vals row block data tel tv)
  (setq file (open path "w"))
  (if file
    (progn
      (write-line (strcat "META\tREV\t" (itoa (getvar "MILLISECS")) "\t\t\t\t\t") file)
      (foreach key (DEGDO--win-cfg-keys)
        (if (not (DEGDO--win-hidden-cfg-key-p key))
          (DEGDO--win-write-record
            file "CFG" (vl-symbol-name key) (DEGDO--win-cfg-group key)
            (DEGDO--win-label key)
            (DEGDO--win-cfg-current key)
            (DEGDO--win-cfg-default key)
            (DEGDO--win-cfg-type key)
            (DEGDO--win-cfg-options key))
        )
      )
      (foreach rec *DEG_CODEMAP*
        (DEGDO--win-write-record
          file "CODE" (vl-symbol-name (car rec)) (DEGDO--win-code-group (car rec))
          (strcat (vl-symbol-name (car rec)) " - " (vl-princ-to-string (cadr rec)))
          (DEG:VAL (car rec)) (caddr rec) "LONG" "")
      )
      (setq *DEGDO_DP_E_LAYERS* (DEGDO--plan-e-line-layer-list)
            vals (DEGDO--dp-e-values-alist))
      (foreach layer *DEGDO_DP_E_LAYERS*
        (DEGDO--win-write-record
          file "DPLINE" layer "DP" (strcat layer " - Carpan")
          (DEGDO--dp-e-value-get vals layer) "" "TEXT" "")
      )
      (setq *DEGDO_DP_E_BLOCKS* (DEGDO--plan-e-block-list)
            vals (DEGDO--dp-e-block-values-alist))
      (foreach block *DEGDO_DP_E_BLOCKS*
        (setq row (DEGDO--dp-e-block-row-get vals block)
              data (if row (nth 1 row) "")
              tel  (if row (nth 2 row) "")
              tv   (if row (nth 3 row) ""))
        (DEGDO--win-write-record file "DPBLOCK" (strcat block "^DATA") "BLOCKLAR" (strcat block " - Data") data "" "TEXT" "")
        (DEGDO--win-write-record file "DPBLOCK" (strcat block "^TEL")  "BLOCKLAR" (strcat block " - Telefon") tel "" "TEXT" "")
        (DEGDO--win-write-record file "DPBLOCK" (strcat block "^TV")   "BLOCKLAR" (strcat block " - TV") tv "" "TEXT" "")
      )
      (DEGDO--win-write-record file "ACTION" "DGT_RESET" "DGT" "DGT cember ve renklerini sifirla" "DO Reset" "" "ACTION" "")
      (close file)
      T
    )
    nil
  )
)

(defun DEGDO--win-store-cfg-value (key value / scale)
  (setq value (DEGDO--trim value))
  (if (and (DEGDO--win-scaled-key-p key) (/= value ""))
    (progn
      (setq scale (DEG:PLAN-UNIT-SCALE))
      (if (<= scale 0.0) (setq scale 1.0))
      (DEG:NUM->STR (/ (atof value) scale))
    )
    value
  )
)

(defun DEGDO--win-remove-layer-value (items layer / out item)
  (foreach item items
    (if (/= (norm-layer (car item)) (norm-layer layer))
      (setq out (append out (list item)))
    )
  )
  out
)

(defun DEGDO--win-put-layer-value (items layer value / out)
  (setq out (DEGDO--win-remove-layer-value items layer)
        value (DEGDO--trim value))
  (if (/= value "")
    (setq out (append out (list (cons (norm-layer layer) value)))))
  out
)

(defun DEGDO--win-remove-block-row (items block / out row)
  (foreach row items
    (if (/= (strcase (car row)) (strcase block))
      (setq out (append out (list row)))
    )
  )
  out
)

(defun DEGDO--win-put-block-value (items key value / parts block field row data tel tv out)
  (setq parts (DEGDO--split-delim key "^")
        block (car parts)
        field (strcase (if (cadr parts) (cadr parts) ""))
        row   (DEGDO--dp-e-block-row-get items block)
        data  (if row (nth 1 row) "")
        tel   (if row (nth 2 row) "")
        tv    (if row (nth 3 row) "")
        value (DEGDO--trim value))
  (cond
    ((= field "DATA") (setq data value))
    ((= field "TEL")  (setq tel value))
    ((= field "TV")   (setq tv value))
  )
  (setq out (DEGDO--win-remove-block-row items block))
  (if (or (/= data "") (/= tel "") (/= tv ""))
    (setq out (append out (list (list (strcase block) data tel tv)))))
  out
)

(defun DEGDO--win-write-status (ok message statePath / file statusPath)
  (setq statusPath
    (if statePath
      (strcat statePath ".status")
      (DEGDO--win-status-path)))
  (if (setq file (open statusPath "w"))
    (progn
      (write-line (strcat "OK=" (if ok "1" "0")) file)
      (write-line (strcat "MESSAGE=" (DEGDO--win-safe-field message)) file)
      (write-line (strcat "REV=" (itoa (getvar "MILLISECS"))) file)
      (close file)
      T
    )
    nil
  )
)

(defun DEGDO--win-trace (message / file result)
  (setq result
    (vl-catch-all-apply 'open
      (list (DEG:RUNTIME-FILE "DO_SAVE_TRACE.log") "a")))
  (if (and result (not (vl-catch-all-error-p result)))
    (progn
      (setq file result)
      (vl-catch-all-apply 'write-line
        (list (strcat (itoa (getvar "MILLISECS")) "\t" message) file))
      (vl-catch-all-apply 'close (list file))))
  nil
)

(defun DEGDO--WIN-APPLY-FILE (path / statePath file line parts op kind keyText key value planOp planValue dpLines dpBlocks actionDone dtChanged cmdChanged saveOk)
  (DEGDO--win-trace (strcat "APPLY_START path=" (if path path "nil")))
  (setq statePath
          (if (and path (wcmatch (strcase path) "*.REQUEST"))
            (substr path 1 (- (strlen path) 8))
            (DEGDO--win-state-path))
        dpLines (DEGDO--dp-e-values-alist)
        dpBlocks (DEGDO--dp-e-block-values-alist))
  (if (not (setq file (open path "r")))
    ;; PowerShell, CAD mesgulken ayni geri cagridan birkac tane kuyruga
    ;; koyabilir. Ilk cagri request'i isleyip sildiyse sonrakiler basarili
    ;; durumu hata ile ezmemeli.
    (DEGDO--win-trace "REQUEST_MISSING_OR_ALREADY_HANDLED")
    (progn
      (while (setq line (read-line file))
        (setq parts (DEGDO--split-delim line "\t")
              op (strcase (if (car parts) (car parts) ""))
              kind (strcase (if (cadr parts) (cadr parts) ""))
              keyText (if (nth 2 parts) (nth 2 parts) "")
              value (if (nth 3 parts) (nth 3 parts) ""))
        (if (member op '("SET" "RESET" "ACTION"))
          (cond
            ((= kind "CFG")
              (setq key (read (strcase keyText)))
              (if (DEGDO--win-prefix-p "DT_TYPE" (vl-symbol-name key)) (setq dtChanged T))
              (if (DEGDO--win-prefix-p "CMD_" (vl-symbol-name key)) (setq cmdChanged T))
              (if (= key 'PLAN_UNIT)
                (setq planOp op planValue value)
                (progn
                  (if (= op "RESET")
                    (DEG:CFG-SET key "")
                    (DEG:CFG-SET key (DEGDO--win-store-cfg-value key value)))
                  (if (= key 'DN_BLOCK_TOL)
                    (progn
                      (if (= op "RESET")
                        (progn
                          (DEG:CFG-SET 'DK_TOUCH_TOL "")
                          (DEG:CFG-SET 'DKX_TOUCH_TOL ""))
                        (progn
                          (DEG:CFG-SET 'DK_TOUCH_TOL (DEGDO--win-store-cfg-value key value))
                          (DEG:CFG-SET 'DKX_TOUCH_TOL (DEGDO--win-store-cfg-value key value)))))
                  )
                  (if (= key 'DT_TYPE1_COLOR) (DEG:CFG-SET 'DT_KA_COLOR (DEG:CFG-GET key)))
                  (if (= key 'DT_TYPE2_COLOR) (DEG:CFG-SET 'DT_ZA_COLOR (DEG:CFG-GET key)))
                )
              )
            )
            ((= kind "CODE")
              (setq key (read (strcase keyText)))
              (DEG:SET key (if (= op "RESET") "" value))
            )
            ((= kind "DPLINE")
              (setq dpLines (DEGDO--win-put-layer-value dpLines keyText (if (= op "RESET") "" value)))
            )
            ((= kind "DPBLOCK")
              (setq dpBlocks (DEGDO--win-put-block-value dpBlocks keyText (if (= op "RESET") "" value)))
            )
            ((and (= kind "ACTION") (= keyText "DGT_RESET"))
              (setq actionDone T)
            )
          )
        )
      )
      (close file)
      (DEGDO--win-trace "REQUEST_READ_OK")
      (DEG:CFG-SET 'DP_E_LINE_VALUES (DEGDO--dp-e-values-pack dpLines))
      (DEG:CFG-SET 'DP_E_BLOCK_VALUES (DEGDO--dp-e-block-values-pack dpBlocks))
      (if planOp
        (DEG:CFG-SET 'PLAN_UNIT (if (= planOp "RESET") "" planValue)))
      (DEG:CFG-SET 'DD_DZ_ORTHO "0")
      (DEG:TOL-REFRESH-DN-GLOBALS)
      (DEGDO--win-trace (strcat "SAVE_START file=" (DEG:SETTINGS-FILE)))
      (setq saveOk (DEG:SAVE-SETTINGS))
      (DEGDO--win-trace (strcat "SAVE_DONE ok=" (if saveOk "1" "0")))
      (if dtChanged
        (progn
          (vl-catch-all-apply 'DEGDO--apply-dt-layer-colors '())
          (vl-catch-all-apply 'DT--palette-refresh-type-options '())))
      (if cmdChanged (vl-catch-all-apply 'DEG:CMD-APPLY-ALIASES '()))
      (if actionDone (vl-catch-all-apply 'DEG-DGT-RESET '()))
      (DEGDO--win-write-schema statePath)
      (if saveOk
        (DEGDO--win-write-status T "Ayarlar kaydedildi." statePath)
        (DEGDO--win-write-status nil
          (strcat "Ayarlar uygulandi fakat dosyaya kaydedilemedi: "
                  (DEG:SETTINGS-FILE))
          statePath))
      (if (findfile path) (vl-file-delete path))
    )
  )
  (princ)
)

(defun DEGDO--clear-sira-values (/ ss i blk att data count failed)
  (setq count 0 failed 0
        ss (ssget "_X" '((0 . "INSERT") (66 . 1) (410 . "Model"))))
  (if ss
    (progn
      (setq i 0)
      (repeat (sslength ss)
        (setq blk (ssname ss i) i (1+ i) att (entnext blk))
        (while (and att (setq data (entget att)) (= (cdr (assoc 0 data)) "ATTRIB"))
          (if (and (= (strcase (cdr (assoc 2 data))) "SIRA_NO")
                   (/= (cdr (assoc 1 data)) ""))
            (if (entmod (subst '(1 . "") (assoc 1 data) data))
              (setq count (1+ count))
              (setq failed (1+ failed))))
          (setq att (entnext att)))
        (entupd blk))))
  (list count failed))

(defun c:DO_DN_CLEAR_SIRA (/ *error* locked row en data result)
  (defun *error* (msg)
    (foreach data locked (entmod data))
    (command-s "_.UNDO" "_End")
    (princ (strcat "\nSIRA_NO temizleme durdu: " msg))
    (princ))
  (command-s "_.UNDO" "_Begin")
  ;; Restore the original layer records on success and on cancellation.
  (setq locked nil row (tblnext "LAYER" T))
  (while row
    (if (/= 0 (logand 4 (cdr (assoc 70 row))))
      (progn
        (setq en (tblobjname "LAYER" (cdr (assoc 2 row))) data (entget en))
        (setq locked (cons data locked))
        (entmod (subst (cons 70 (- (cdr (assoc 70 data)) 4)) (assoc 70 data) data))))
    (setq row (tblnext "LAYER")))
  (setq result (DEGDO--clear-sira-values))
  (foreach data locked (entmod data))
  (command-s "_.UNDO" "_End")
  (princ (strcat "\nSIRA_NO temizlenen: " (itoa (car result))
                 ", temizlenemeyen: " (itoa (cadr result))))
  (princ))

(defun C:DO_WINDOWS_APPLY ()
  (DEGDO--WIN-APPLY-FILE (DEGDO--win-request-path))
  (princ)
)

(defun DEG:WIN-MESSAGE-TITLED (title message / script path file pid hwnd args result)
  (setq script (DEGDO--win-script-path)
        path (DEG:RUNTIME-FILE
               (strcat "deg_message_" (itoa (DEGDO--win-process-id)) "_" (itoa (getvar "MILLISECS")) ".txt")))
  (if (and script (setq file (open path "w")))
    (progn
      (write-line (if title title "DEG") file)
      (write-line (if message message "") file)
      (close file)
      (setq pid (DEGDO--win-process-id)
            hwnd (DEGDO--win-window-handle)
            args
              (strcat
                "-NoProfile -ExecutionPolicy Bypass -STA -WindowStyle Hidden -File "
                (DEGDO--win-quote script)
                " -Mode Message -StatePath " (DEGDO--win-quote path)
                " -HostPid " (DEGDO--win-id-text pid)
                " -HostHwnd " (DEGDO--win-id-text hwnd))
            result (DEGDO--win-run-hidden "powershell.exe" args))
      (if (not result)
        (princ (strcat "\n" (if title title "DEG") ": " (if message message ""))))
      result
    )
    (progn
      (princ (strcat "\n" (if title title "DEG") ": " (if message message "")))
      nil
    )
  )
)

(defun DEG:WIN-MESSAGE (message)
  (DEG:WIN-MESSAGE-TITLED "DEG" message)
)

(defun DO_ORIG (/ script state pid hwnd args result)
  (setq script (DEGDO--win-script-path)
        state (DEGDO--win-state-path))
  (if (and script (DEGDO--win-write-schema state))
    (progn
      (setq pid (DEGDO--win-process-id)
            hwnd (DEGDO--win-window-handle)
            args
              (strcat
                "-NoProfile -ExecutionPolicy Bypass -STA -WindowStyle Hidden -File "
                (DEGDO--win-quote script)
                " -Mode Settings -StatePath " (DEGDO--win-quote state)
                " -HostPid " (DEGDO--win-id-text pid)
                " -HostHwnd " (DEGDO--win-id-text hwnd))
            result (DEGDO--win-run-hidden "powershell.exe" args))
      (if (not result)
        (progn
          (princ "\nDO: Windows ayar paneli acilamadi; DCL yedegi aciliyor.")
          (DO_DCL_ORIG)))
    )
    (DO_DCL_ORIG)
  )
  (princ)
)

(defun UCS_ORIG ()
  (initcommandversion)
  (command "_.UCS")
  (while (> (getvar "CMDACTIVE") 0)
    (command pause)
  )
  (princ)
)
(defun DEG:CMD-VALID-P (s / u i ch ok)
  (setq u (strcase (vl-string-trim " \t\r\n" (if s s ""))))
  (setq ok (and (> (strlen u) 0) (<= (strlen u) 31)))
  (setq i 1)
  (while (and ok (<= i (strlen u)))
    (setq ch (substr u i 1))
    (if (not (wcmatch ch "[A-Z0-9_?]"))
      (setq ok nil)
    )
    (setq i (1+ i))
  )
  ok
)

(defun DEG:CMD-NORM (s)
  (strcase (vl-string-trim " \t\r\n" (if s (vl-princ-to-string s) "")))
)

