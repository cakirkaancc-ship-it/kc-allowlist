(defun KC:FileExists (p) (and p (findfile p) T))

(defun KC:WriteTextFile (path text / f)
  (setq f (open path "w"))
  (if f (progn (write-line text f) (close f) T) nil)
)

(defun KC:ReadFirstLine (path / f line)
  (setq line "")
  (if (KC:FileExists path)
    (progn
      (setq f (open path "r"))
      (if f (progn (setq line (read-line f)) (close f)))
    )
  )
  (KC:Trim line)
)

(defun KC:NormalizeDeviceCode (s / u raw i ch ok)
  (setq u (strcase (KC:Trim s)))
  (if (and (>= (strlen u) 5) (= (substr u 1 5) "KCPC-"))
    (progn
      (setq raw ""
            i   6)
      (while (<= i (strlen u))
        (setq ch (substr u i 1))
        (if (/= ch "-") (setq raw (strcat raw ch)))
        (setq i (1+ i)))
      (setq ok (= (strlen raw) 32)
            i  1)
      (while (and ok (<= i 32))
        (if (null (vl-string-search (substr raw i 1) "0123456789ABCDEF"))
          (setq ok nil))
        (setq i (1+ i)))
      (if ok
        (strcat
          "KCPC-"
          (substr raw 1 8) "-" (substr raw 9 8) "-"
          (substr raw 17 8) "-" (substr raw 25 8))))
  )
)

(defun KC:ValidDeviceCodeP (s)
  (if (KC:NormalizeDeviceCode s) T nil)
)

(defun KC:SleepMS (ms / t0)
  (setq t0 (getvar "MILLISECS"))
  (while (< (- (getvar "MILLISECS") t0) ms) (princ))
  T
)
(defun KC:RunHidden (cmd wait / sh r)
  ;; Komut satýrý penceresi göstermeden (gizli) sistem komutu alistirir.
  ;; wait=T ise komut bitene kadar bekler.
  (vl-load-com)
  (setq sh (vlax-create-object "WScript.Shell"))
  (setq r (vlax-invoke-method sh 'Run cmd 0 (if wait :vlax-true :vlax-false)))
  (vlax-release-object sh)
  r
)

(defun KC:ProcessToken (/ pid hwnd)
  (setq pid (vl-catch-all-apply 'getvar (list "PROCESSID")))
  (cond
    ((and (not (vl-catch-all-error-p pid)) (= (type pid) 'INT) (> pid 0))
      (itoa pid)
    )
    ((and (not (vl-catch-all-error-p pid)) (= (type pid) 'REAL) (> pid 0.0))
      (rtos pid 2 0)
    )
    (T
      (setq hwnd (vl-catch-all-apply 'getvar (list "HWND")))
      (if (and (not (vl-catch-all-error-p hwnd))
               (member (type hwnd) '(INT REAL))
               (> hwnd 0))
        (if (= (type hwnd) 'INT) (itoa hwnd) (rtos hwnd 2 0))
        (strcat
          (itoa (getvar "MILLISECS"))
          "_"
          (vl-string-translate ".-" "__" (rtos (getvar "DATE") 2 12))
        )
      )
    )
  )
)

(defun KC:GetDeviceCode (/ script state resultPath logPath cmd runResult result code file)
  (setq script (DEGDO--win-script-path)
        state
          (DEG:RUNTIME-FILE
            (strcat "kc_device_" (KC:ProcessToken) ".txt"))
        resultPath (strcat state ".result")
        logPath    (strcat state ".log"))
  (foreach file (list state resultPath logPath)
    (if (KC:FileExists file) (vl-file-delete file)))
  (if script
    (progn
      (setq cmd
        (strcat
          "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \""
          script
          "\" -Mode DeviceCode -StatePath \""
          state
          "\" -DeviceCodePath \""
          (KC:DeviceCodeFile)
          "\""))
      (setq runResult (vl-catch-all-apply 'KC:RunHidden (list cmd T)))
      (if (and (not (vl-catch-all-error-p runResult))
               (KC:FileExists resultPath))
        (setq result (KC:Trim (KC:ReadFirstLine resultPath))))
      (if (and result (= (substr result 1 (min 3 (strlen result))) "OK|"))
        (setq code (KC:NormalizeDeviceCode (substr result 4))))
      (foreach file (list state resultPath)
        (if (KC:FileExists file) (vl-file-delete file)))
      (if (and code (KC:FileExists logPath)) (vl-file-delete logPath))))
  code
)

