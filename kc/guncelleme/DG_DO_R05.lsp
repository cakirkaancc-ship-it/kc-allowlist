(defun DT--2d-points-variant (pts / sa i p)
  (setq sa (vlax-make-safearray vlax-vbDouble (cons 0 (1- (* 2 (length pts))))))
  (setq i 0)
  (foreach p pts
    (vlax-safearray-put-element sa i (float (car p)))
    (setq i (1+ i))
    (vlax-safearray-put-element sa i (float (cadr p)))
    (setq i (1+ i))
  )
  (vlax-make-variant sa)
)

