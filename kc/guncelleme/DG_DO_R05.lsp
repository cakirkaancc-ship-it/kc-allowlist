(defun DT--set-block-linework-050
  (name / rec ent ed typ pair layerPair nestedName nestedNames)
  ;; Daha once cizimde olusmus ayni adli DT blocklarini da yeni lineweight'e tasir.
  (setq rec (if name (tblobjname "BLOCK" name)))
  (if rec
    (progn
      (setq ent (entnext rec))
      (while (and ent (/= (cdr (assoc 0 (entget ent))) "ENDBLK"))
        (setq ed  (entget ent)
              typ (cdr (assoc 0 ed)))
        (if (member typ '("LINE" "LWPOLYLINE" "POLYLINE" "3DFACE"))
          (progn
            (setq pair (assoc 370 ed)
                  ed   (if pair
                         (subst (cons 370 30) pair ed)
                         (append ed (list (cons 370 30))))
                  layerPair (assoc 8 ed)
                  ed (if layerPair
                       (subst (cons 8 (DT--layer-linework)) layerPair ed)
                       (append ed (list (cons 8 (DT--layer-linework)))))
                  ed (vl-remove-if '(lambda (x) (= (car x) 62)) ed))
            (entmod ed)))
        (if (= typ "HATCH")
          (progn
            (setq layerPair (assoc 8 ed)
                   ed (if layerPair
                        (subst (cons 8 (DT--layer-fitting)) layerPair ed)
                        (append ed (list (cons 8 (DT--layer-fitting)))))
                   ed (vl-remove-if
                        '(lambda (x) (member (car x) '(62 420 430)))
                        ed))
            (entmod ed)))
        (if (= typ "INSERT")
          (progn
            (setq nestedName (cdr (assoc 2 ed)))
            (if (and nestedName
                     (wcmatch (strcase nestedName) "DT$SHELL$*")
                     (not (member (strcase nestedName) nestedNames)))
              (setq nestedNames (cons (strcase nestedName) nestedNames)))))
        (setq ent (entnext ent)))
      (foreach nestedName nestedNames
        (DT--set-block-linework-050 nestedName))
      T)
  )
)

(defun DT--block-poly-vla-at (blk pts closedp bulges elevation / pl i b)
  (if (and blk pts (> (length pts) 1))
    (progn
      (setq pl (vla-AddLightWeightPolyline blk (DT--2d-points-variant pts)))
      (vla-put-Layer pl (DT--layer-linework))
      (vla-put-Lineweight pl 30)
      (vla-put-Closed pl (if closedp :vlax-true :vlax-false))
      (if (numberp elevation) (vla-put-Elevation pl elevation))
      (setq i 0)
      (foreach p pts
        (setq b (if bulges (nth i bulges) 0.0))
        (if (and b (> (abs b) 1e-10))
          (vla-SetBulge pl i b)
        )
        (setq i (1+ i))
      )
      pl
    )
  )
)

(defun DT--block-poly-vla (blk pts closedp bulges)
  (DT--block-poly-vla-at blk pts closedp bulges 0.0)
)

(defun DT--block-raised-outline-vla (blk pts closedp bulges / height p lineObj)
  (setq height (DT--active-side-height))
  (if (and blk closedp pts (> height 0.0))
    (progn
      (DT--block-poly-vla-at blk pts T bulges height)
      (foreach p pts
        (setq lineObj
          (vla-AddLine
            blk
            (vlax-3d-point (list (car p) (cadr p) 0.0))
            (vlax-3d-point (list (car p) (cadr p) height))))
        (if lineObj
          (progn
            (vla-put-Layer lineObj (DT--layer-linework))
            (vla-put-Lineweight lineObj 30)))
      )
    )
  )
)


(defun DT--block-hatch-vla (blk boundaryObj / pattern color hatch sa var ok)
  (if (and blk boundaryObj)
    (progn
      (setq pattern (car (DT--hatch-pattern-info (DT--mode-hatch-pattern *DT_ACTIVE_MODE*)))
            color   (DT--mode-hatch-color *DT_ACTIVE_MODE*))
      (setq hatch (vl-catch-all-apply 'vla-AddHatch (list blk 1 pattern :vlax-true)))
      (if (not (vl-catch-all-error-p hatch))
        (progn
          (setq sa (vlax-make-safearray vlax-vbObject '(0 . 0)))
          (vlax-safearray-put-element sa 0 boundaryObj)
          (setq var (vlax-make-variant sa))
          (setq ok (vl-catch-all-apply 'vla-AppendOuterLoop (list hatch var)))
          (if (not (vl-catch-all-error-p ok))
            (progn
              (vl-catch-all-apply 'vla-put-Layer (list hatch (DT--layer-fitting)))
              (vl-catch-all-apply 'vla-put-Color (list hatch 256))
              (vl-catch-all-apply 'vla-put-PatternScale (list hatch (DT--hatch-scale)))
              (vl-catch-all-apply 'vla-Evaluate (list hatch))
              hatch
            )
            (vl-catch-all-apply 'vla-Delete (list hatch))
          )
        )
      )
    )
  )
)

