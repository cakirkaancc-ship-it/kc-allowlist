          (setq *DT_ACTIVE_MODE* mode
                *DT_ACTIVE_LAYER* base)
          (DT--ensure-layer (DT--line-layer-name base)
                            (DT--layer-color-for-name base) nil)
          (DT--set-block-linework-050 name)
          (setq done  (cons (strcase name) done)
                count (1+ count))))
      (if (and ins base (/= base ""))
        (DT--set-entity-layer-only ins base))
      (setq i (1+ i))))
  count
)

(defun DT--sidewall-sync-command-name (info / cmd)
  (setq cmd (if (and (listp info) (car info)) (strcase (car info)) ""))
  cmd
)

(defun DT--composite-undo-command-p (cmd)
  (member cmd '("U" "UNDO" "REDO" "MREDO"))
)

(defun DT--sidewall-sync-watched-command-p (cmd)
  (and cmd
       (or (= cmd "STRETCH")
           (= cmd "GRIP_STRETCH")
           (= cmd "MOVE")
           (= cmd "GRIP_MOVE")
           (= cmd "ROTATE")
           (= cmd "GRIP_ROTATE")
           (= cmd "SCALE")
           (= cmd "GRIP_SCALE")
           (= cmd "MIRROR")
           (= cmd "ALIGN")))
)

(defun DT--composite-stretch-command-p (cmd)
  (member cmd '("STRETCH" "GRIP_STRETCH"))
)

(defun DT--composite-stretch-selection-begin (cmd / value)
  (if (DT--composite-stretch-command-p cmd)
    (progn
      (setq value (getvar "PICKSTYLE")
            *DT_COMPOSITE_PICKSTYLE_BEFORE* value)
      ;; STRETCH geometriyi ana sinirdan yonetsin; grup ve hatch secimi gecici kapanir.
      (setvar "PICKSTYLE" 0)))
)

(defun DT--composite-stretch-selection-end ()
  (if (and (boundp '*DT_COMPOSITE_PICKSTYLE_BEFORE*)
           (numberp *DT_COMPOSITE_PICKSTYLE_BEFORE*))
    (setvar "PICKSTYLE" *DT_COMPOSITE_PICKSTYLE_BEFORE*))
  (setq *DT_COMPOSITE_PICKSTYLE_BEFORE* nil)
)

(defun DT--composite-erase-map (/ ss i tray trayHandle entities ent handle handles out)
  (setq ss (ssget "_X" '((-3 ("DT_TRAY_HATCH"))))
        i 0)
  (if ss
    (while (< i (sslength ss))
      (setq tray       (ssname ss i)
            trayHandle (if tray (DT--ent-handle tray))
            entities   (if tray
                         (append (DT--linked-hatches tray) (DT--linked-sidewalls tray)))
            handles    nil)
      (foreach ent entities
        (setq handle (DT--ent-handle ent))
        (if handle (setq handles (cons handle handles))))
      (if (and trayHandle handles)
        (setq out (cons (cons trayHandle handles) out)))
      (setq i (1+ i))))
  out
)

(defun DT--handle-alive-p (handle / ent)
  (setq ent (if handle (handent handle)))
  (and ent (DT--entity-alive-p ent))
)

(defun DT--composite-erase-finish (/ record trayHandle tray affected handle ent)
  (if (and (boundp '*DT_COMPOSITE_ERASE_BEFORE*)
           *DT_COMPOSITE_ERASE_BEFORE*
           (not *DT_SIDEWALL_SYNC_BUSY*))
    (progn
      (setq *DT_SIDEWALL_SYNC_BUSY* T)
      (foreach record *DT_COMPOSITE_ERASE_BEFORE*
        (setq trayHandle (car record)
              tray       (handent trayHandle)
              affected   (not (and tray (DT--entity-alive-p tray))))
        (if (not affected)
          (foreach handle (cdr record)
            (if (not (DT--handle-alive-p handle)) (setq affected T))))
        (if affected
          (progn
            (DT--delete-group-by-name
              (strcat "DT$TAVA$" (strcase trayHandle)))
            (if (and tray (DT--entity-alive-p tray))
              (DT--safe-delete-ent tray)
              (foreach handle (cdr record)
                (setq ent (handent handle))
                (if (and ent (DT--entity-alive-p ent))
                  (vl-catch-all-apply 'entdel (list ent)))))
            (DT--remember-deleted-handle trayHandle)
            (foreach handle (cdr record) (DT--remember-deleted-handle handle)))))
      (setq *DT_COMPOSITE_ERASE_BEFORE* nil
            *DT_SIDEWALL_SYNC_BUSY* nil)))
  (princ)
)

(defun DT--sidewall-sync-command-start (reactor info / cmd)
  (if (not *DT_SIDEWALL_SYNC_BUSY*)
    (progn
      (setq cmd (DT--sidewall-sync-command-name info))
      (DT--composite-stretch-selection-begin cmd)
      (cond
        ((= cmd "ERASE")
          (setq *DT_COMPOSITE_ERASE_BEFORE* (DT--composite-erase-map)))
        ((DT--sidewall-sync-watched-command-p cmd)
          (setq *DT_SIDEWALL_SYNC_COMMAND* cmd
                *DT_SIDEWALL_SYNC_BEFORE* (DT--tray-signature-map))))))
  (princ)
)

(defun DT--sidewall-sync-command-finish (reactor info / cmd before now rec old tray result)
  (setq cmd (DT--sidewall-sync-command-name info))
  (if (= cmd "ERASE") (DT--composite-erase-finish))
  (if (DT--composite-undo-command-p cmd)
    (progn
      (setq *DT_DELETED_HANDLES* nil)
      (vl-catch-all-apply 'DT--repair-existing-hatch-associations '())
      (vl-catch-all-apply 'DT--repair-existing-tray-sidewalls '())
      (vl-catch-all-apply 'DT--repair-existing-tray-groups '())))
  (if (and (not *DT_SIDEWALL_SYNC_BUSY*)
           *DT_SIDEWALL_SYNC_COMMAND*
           (= cmd *DT_SIDEWALL_SYNC_COMMAND*))
    (progn
      (setq *DT_SIDEWALL_SYNC_BUSY* T
            before *DT_SIDEWALL_SYNC_BEFORE*
            now    (DT--tray-signature-map))
      (foreach rec now
        (setq old (assoc (car rec) before))
        (if (and old (not (equal (cdr old) (cdr rec) 0.000001)))
          (progn
            (setq tray (handent (car rec)))
            (if tray
              (setq result
                (vl-catch-all-apply 'DT--rebuild-tray-sidewall-geometry (list tray)))))))
      (setq *DT_SIDEWALL_SYNC_BEFORE* nil
            *DT_SIDEWALL_SYNC_COMMAND* nil
            *DT_SIDEWALL_SYNC_BUSY* nil)))
  (DT--composite-stretch-selection-end)
  (princ)
)

(defun DT--sidewall-sync-command-cancel (reactor info)
  (DT--composite-stretch-selection-end)
  (setq *DT_SIDEWALL_SYNC_BEFORE* nil
        *DT_SIDEWALL_SYNC_COMMAND* nil
        *DT_COMPOSITE_ERASE_BEFORE* nil
        *DT_SIDEWALL_SYNC_BUSY* nil)
  (princ)
)

(defun DT--reset-sidewall-sync-reactor ()
  (if (and (boundp '*DT_SIDEWALL_SYNC_REACTOR*) *DT_SIDEWALL_SYNC_REACTOR*)
    (vl-catch-all-apply 'vlr-remove (list *DT_SIDEWALL_SYNC_REACTOR*)))
  (setq *DT_SIDEWALL_SYNC_REACTOR*
    (vl-catch-all-apply
      'vlr-command-reactor
      (list
        nil
        (list
          (cons :vlr-commandWillStart 'DT--sidewall-sync-command-start)
          (cons :vlr-commandEnded 'DT--sidewall-sync-command-finish)
          (cons :vlr-commandCancelled 'DT--sidewall-sync-command-cancel)
          (cons :vlr-commandFailed 'DT--sidewall-sync-command-cancel)))))
  (if (vl-catch-all-error-p *DT_SIDEWALL_SYNC_REACTOR*)
    (setq *DT_SIDEWALL_SYNC_REACTOR* nil))
  *DT_SIDEWALL_SYNC_REACTOR*
)

(defun DT--repair-tray-hatch-associations (tray / hatches walls hatchList)
  (setq hatches (DT--linked-hatches tray)
        walls   (DT--linked-sidewalls tray))
  (if hatches
    (progn
      (if (or (null walls) (= (length hatches) (1+ (length walls))))
        (progn
          (DT--hatch-set-source (car hatches) tray)
          (setq hatchList (cdr hatches)))
        (setq hatchList hatches))
      (while (and hatchList walls)
        (DT--hatch-set-source (car hatchList) (car walls))
        (setq hatchList (cdr hatchList)
              walls     (cdr walls))))
  )
  tray
)

(defun DT--repair-existing-hatch-associations (/ ss i tray)
  (setq ss (ssget "_X" '((-3 ("DT_TRAY_HATCH"))))
        i 0)
  (if ss
    (while (< i (sslength ss))
      (setq tray (ssname ss i))
      (if (DT--visible-tray-p tray)
        (DT--repair-tray-hatch-associations tray))
      (setq i (1+ i))))
  T
)

(defun DT--safe-delete-ent (ent / h obj r hatch hh wall wh)
  (DT--delete-tray-group ent)
  (foreach hatch (DT--linked-hatches ent)
    (if (and hatch (entget hatch))
      (progn
        (setq hh (DT--ent-handle hatch))
        (vl-catch-all-apply 'entdel (list hatch))
        (if hh (DT--remember-deleted-handle hh))
      )
    )
  )
  (foreach wall (DT--linked-sidewalls ent)
    (if (and wall (entget wall))
      (progn
        (setq wh (DT--ent-handle wall))
        (vl-catch-all-apply 'entdel (list wall))
        (if wh (DT--remember-deleted-handle wh))
      )
    )
  )
  (setq h (DT--ent-handle ent))
  (if (and (DT--entity-alive-p ent) (not (DT--deleted-handle-p h)))
    (progn
      (setq obj (DT--vla-object-for-ent ent))
      (setq r
        (if obj
          (vl-catch-all-apply 'vla-delete (list obj))
          (vl-catch-all-apply 'entdel (list ent))
        )
      )
      (if (not (vl-catch-all-error-p r))
        (DT--remember-deleted-handle h)
      )
    )
  )
)
(defun DT--linked-trays (center / app ed xd rec h tray out x)
  (setq app "DT_TRAY_LINK")
  (setq ed (entget center (list app)))
  (setq xd (assoc -3 ed))
  (if xd
    (progn
      (setq rec (cadr xd))
      (foreach x (cdr rec)
        (if (= (car x) 1005)
          (progn
            (setq h (cdr x))
            (setq tray (handent h))
            (if (DT--entity-alive-p tray)
              (setq out (append out (list tray)))
            )
          )
        )
      )
    )
  )
  out
)

(defun DT--linked-tray (center)
  (car (DT--linked-trays center))
)

(defun DT--replace-linked-tray (center oldTray newTray / tray out replaced)
  (if (and center oldTray newTray
           (entget center) (entget oldTray) (entget newTray))
    (progn
      (foreach tray (DT--linked-trays center)
        (if (eq tray oldTray)
          (progn
            (setq out (append out (list newTray))
                  replaced T))
          (setq out (append out (list tray)))))
      (if (not replaced)
        (setq out (append out (list newTray))))
      (DT--xdata-link-tray center out)
      newTray))
)

(defun DT--cut-point (cut)
  (if (and (listp cut) (listp (car cut)))
    (car cut)
    cut
  )
)

(defun DT--cut-gap (cut fallback)
  (if (and (listp cut) (listp (car cut)) (numberp (cadr cut)) (> (cadr cut) 0.0))
    (cadr cut)
    fallback
  )
)

(defun DT--cut-encode (cut / p gap)
  (setq p (DT--cut-point cut))
  (setq gap (if (and (listp cut) (listp (car cut))) (cadr cut) nil))
  (strcat
    (rtos (car p) 2 12)
    "|"
    (rtos (cadr p) 2 12)
    (if (and (numberp gap) (> gap 0.0))
      (strcat "|" (rtos gap 2 12))
      ""
    )
  )
)

(defun DT--cut-decode (s / pos rest pos2 p gap)
  (if (and s (setq pos (vl-string-search "|" s)))
    (progn
      (setq rest (substr s (+ pos 2)))
      (setq pos2 (vl-string-search "|" rest))
      (if pos2
        (progn
          (setq p
            (list
              (atof (substr s 1 pos))
              (atof (substr rest 1 pos2))
              0.0
            )
          )
          (setq gap (atof (substr rest (+ pos2 2))))
        )
        (setq p
          (list
            (atof (substr s 1 pos))
            (atof rest)
            0.0
          )
        )
      )
      (list p (if (and (numberp gap) (> gap 0.0)) gap nil))
    )
    nil
  )
)

(defun DT--plus-cuts (center / app ed xd rec out x cut)
  (setq app "DT_PLUS_CUTS")
  (setq ed (entget center (list app)))
  (setq xd (assoc -3 ed))
  (if xd
    (progn
      (setq rec (cadr xd))
      (foreach x (cdr rec)
        (if (= (car x) 1000)
          (progn
            (setq cut (DT--cut-decode (cdr x)))
            (if cut (setq out (append out (list cut))))
          )
        )
      )
    )
  )
  out
)

(defun DT--set-plus-cuts (center cuts / app ed payload cut)
  (setq app "DT_PLUS_CUTS")
  (if (not (tblsearch "APPID" app)) (regapp app))
  (if (and center (entget center))
    (progn
      (setq payload (list app))
      (foreach cut cuts
        (setq payload (append payload (list (cons 1000 (DT--cut-encode cut)))))
      )
      (setq ed (entget center '("*")))
      ;; Bos cut listesinde eski DT_PLUS_CUTS XData kaydi kalmasin.
      (setq ed (DT--xdata-set-app ed app payload))
      (entmod ed)
      (entupd center)
    )
  )
  center
)

(defun DT--add-plus-cut (center pt gap / cuts out cut oldGap found)
  (setq cuts (DT--plus-cuts center))
  (foreach cut cuts
    (if (<= (distance pt (DT--cut-point cut)) 0.001)
      (progn
        (setq oldGap (DT--cut-gap cut 0.0))
        (setq out
          (append out
            (list
              (list pt
                (cond
                  ((and (numberp gap) (> gap oldGap)) gap)
                  ((> oldGap 0.0) oldGap)
                  (T nil)
                )
              )
            )
          )
        )
        (setq found T)
      )
      (setq out (append out (list cut)))
    )
  )
  (if (not found)
    (setq out (append out (list (list pt gap))))
  )
  (DT--set-plus-cuts center out)
  out
)

(defun DT--delete-ents (ents / ent)
  (foreach ent ents
    (DT--safe-delete-ent ent)
  )
)

(defun DT--visible-tray-segments (trays / out tray seg)
  (foreach tray trays
    (if (DT--visible-tray-p tray)
      (progn
        (setq seg (DT--tray-center-seg tray))
        (if (and seg (> (distance (car seg) (cadr seg)) 0.001))
          (setq out (append out (list seg)))
        )
      )
    )
  )
  out
)

(defun DT--shift-visible-segments-point
  (segs oldPoint newPoint tol / seg a b out)
  (foreach seg segs
    (if (and seg (= (length seg) 2))
      (progn
        (setq a (car seg)
              b (cadr seg))
        (if (<= (DT--distance-xy a oldPoint) tol)
          (setq a
            (list
              (car newPoint)
              (cadr newPoint)
              (if (caddr a) (caddr a) 0.0))))
        (if (<= (DT--distance-xy b oldPoint) tol)
          (setq b
            (list
              (car newPoint)
              (cadr newPoint)
              (if (caddr b) (caddr b) 0.0))))
        (if (> (DT--distance-xy a b) 0.001)
          (setq out (append out (list (list a b))))))))
  out
)

(defun DT--build-straight-pieces-for-segs (segs width cuts / out seg pieces)
  (foreach seg segs
    (setq pieces (DT--build-straight-pieces seg width cuts))
    (if pieces (setq out (append out pieces)))
  )
  out
)

(defun DT--replace-seg-point-near (point pairs / hit pair)
  (foreach pair pairs
    (if (and (null hit)
             (<= (DT--distance-xy point (car pair)) 0.01))
      (setq hit (cadr pair))
    )
  )
  (if hit hit point)
)

(defun DT--retarget-visible-segs-for-width (segs pts oldWidth newWidth / oldCorners newCorners pairs oldRec newRec oldQ1 oldQ2 newQ1 newQ2 out seg)
  (if (and segs pts
           (numberp oldWidth) (> oldWidth 0.0)
           (numberp newWidth) (> newWidth 0.0)
           (not (equal oldWidth newWidth 0.000001)))
    (progn
      (setq oldCorners (DT--corner-records pts oldWidth)
            newCorners (DT--corner-records pts newWidth))
      (foreach oldRec oldCorners
        (setq newRec (DT--corner-at newCorners (car oldRec)))
        (if newRec
          (progn
            (setq oldQ1 (DT--pt+ (nth 1 oldRec) (nth 2 oldRec) (- (nth 4 oldRec)))
                  oldQ2 (DT--pt+ (nth 1 oldRec) (nth 3 oldRec)    (nth 4 oldRec))
                  newQ1 (DT--pt+ (nth 1 newRec) (nth 2 newRec) (- (nth 4 newRec)))
                  newQ2 (DT--pt+ (nth 1 newRec) (nth 3 newRec)    (nth 4 newRec))
                  pairs (append pairs (list (list oldQ1 newQ1) (list oldQ2 newQ2))))
          )
        )
      )
      (foreach seg segs
        (if (and seg (= (length seg) 2))
          (setq out
            (append out
              (list
                (list
                  (DT--replace-seg-point-near (car seg) pairs)
                  (DT--replace-seg-point-near (cadr seg) pairs)))))
        )
      )
      out
    )
    segs
  )
)

(defun DT--piece-affected-by-cuts-p (piece cuts width / seg)
  (setq seg (DT--tray-center-seg piece))
  (and seg
       (> (distance (car seg) (cadr seg)) 0.001)
       (DT--segment-cut-ranges
         (car seg) (cadr seg) cuts width
         0.0 (distance (car seg) (cadr seg))))
)

(defun DT--rebuild-center-pieces (center width forcePts / oldPieces pts cuts newPieces useWidth sourceWidth oldActive oldElevation oldSide oldSideMm oldActive3d center3d useLayer visibleSegs endpointElevations elevationProfile meta sideMm localRebuild affectedPieces affectedSegs preservedPieces piece seg createdPieces deletePieces noChange *DT_BUILD_ROUTE_PTS* *DT_BUILD_START_ELEVATION* *DT_BUILD_END_ELEVATION* *DT_BUILD_START_TRIM* *DT_BUILD_END_TRIM* *DT_BUILD_START_LINE_ELEVATION* *DT_BUILD_END_LINE_ELEVATION*)
  (if (and center (entget center))
    (progn
      (setq oldPieces         (DT--linked-trays center)
            pts               (g365_get_pts center)
            endpointElevations (DT--center-end-elevations center)
            elevationProfile  (DT--center-elevation-profile center)
            *DT_BUILD_ROUTE_PTS* pts
            *DT_BUILD_START_ELEVATION* (car endpointElevations)
            *DT_BUILD_END_ELEVATION*   (cadr endpointElevations)
            *DT_BUILD_START_TRIM*      (car elevationProfile)
            *DT_BUILD_END_TRIM*        (cadr elevationProfile)
            *DT_BUILD_START_LINE_ELEVATION* (if (numberp (nth 2 elevationProfile))
                                               (nth 2 elevationProfile)
                                               (car endpointElevations))
            *DT_BUILD_END_LINE_ELEVATION*   (if (numberp (nth 3 elevationProfile))
                                               (nth 3 elevationProfile)
                                               (cadr endpointElevations)))
      (DT--cleanup-stale-plus-cuts center)
      (setq cuts (DT--plus-cuts center))
      (setq useWidth (DT--center-width center width))
      (setq meta         (DT--tray-meta center)
            sideMm       (if (and meta (numberp (caddr meta)) (> (caddr meta) 0.0))
                           (caddr meta)
                           (DT--active-side-height-mm))
            oldActive    *DT_ACTIVE_LAYER*
            oldElevation (DT--active-elevation)
            oldSide      (DT--active-side-height)
            oldSideMm    (DT--active-side-height-mm)
            oldActive3d  (DT--active-3d-enabled-p)
            center3d     (DT--entity-3d-enabled-p center)
            *DT_ACTIVE_ELEVATION* (DT--entity-elevation center)
            *DT_ACTIVE_SIDE_HEIGHT_MM* sideMm
            *DT_ACTIVE_SIDE_HEIGHT* (DT--plan-side-height sideMm)
            *DT_ACTIVE_3D* center3d)
      (setq useLayer (DT--center-layer center oldActive))
      (if useLayer (setq *DT_ACTIVE_LAYER* useLayer))
      ;; Eski centerline uzun kalmis olabilir. Rebuild yaparken mevcut gorunur
      ;; tava parcalarini baz al; silinmis bosluklari tekrar uretme.
      (setq visibleSegs (DT--visible-tray-segments oldPieces))
      (if (and visibleSegs
               (boundp '*DT_REBUILD_POINT_SHIFT*)
               *DT_REBUILD_POINT_SHIFT*
               (= (length *DT_REBUILD_POINT_SHIFT*) 3))
        (setq visibleSegs
          (DT--shift-visible-segments-point
            visibleSegs
            (car *DT_REBUILD_POINT_SHIFT*)
            (cadr *DT_REBUILD_POINT_SHIFT*)
            (caddr *DT_REBUILD_POINT_SHIFT*))))
      (setq sourceWidth
        (if (and (boundp '*DT_REBUILD_SOURCE_WIDTH*)
                 (numberp *DT_REBUILD_SOURCE_WIDTH*)
                 (> *DT_REBUILD_SOURCE_WIDTH* 0.0))
          *DT_REBUILD_SOURCE_WIDTH*
          useWidth))
      (if visibleSegs
        (setq visibleSegs
          (DT--retarget-visible-segs-for-width
            visibleSegs pts sourceWidth useWidth)))
      ;; Junction kesiminde uzun tavanin tamamini degil, kesimin denk geldigi
      ;; fiziksel parcayi yeniden kur. Resize ve nokta kaydirmalari tam rebuild'dir.
      (setq localRebuild
        (and
          (not forcePts)
          oldPieces
          cuts
          (equal sourceWidth useWidth 0.0001)
          (or
            (not (boundp '*DT_REBUILD_POINT_SHIFT*))
            (null *DT_REBUILD_POINT_SHIFT*))))
      (if localRebuild
        (foreach piece oldPieces
          (if (DT--piece-affected-by-cuts-p piece cuts useWidth)
            (progn
              (setq affectedPieces (cons piece affectedPieces)
                    seg (DT--tray-center-seg piece))
              (if seg (setq affectedSegs (cons seg affectedSegs))))
            (setq preservedPieces (cons piece preservedPieces)))))
      (setq affectedPieces (reverse affectedPieces)
            affectedSegs (reverse affectedSegs)
            preservedPieces (reverse preservedPieces))
      (cond
        ((and localRebuild affectedPieces)
          (setq createdPieces
            (DT--build-straight-pieces-for-segs
              affectedSegs useWidth cuts))
          (setq newPieces (append preservedPieces createdPieces)
                deletePieces affectedPieces))
        ((and localRebuild (null affectedPieces))
          (setq newPieces oldPieces
                noChange T))
        ((and (not forcePts) visibleSegs)
          (setq newPieces (DT--build-straight-pieces-for-segs visibleSegs useWidth cuts)
                createdPieces newPieces
                deletePieces oldPieces))
        ((and pts (> (length pts) 1))
          (setq newPieces (DT--build-straight-pieces pts useWidth cuts)
                createdPieces newPieces
                deletePieces oldPieces))
      )
      (if newPieces
        (progn
          (if (not noChange)
            (progn
              (DT--delete-ents deletePieces)
              (DT--xdata-link-tray center newPieces)))
          ;; A junction rebuild creates pieces before linking them to the
          ;; center. Copy the authoritative center metadata afterwards so
          ;; side height and elevation never fall back to inferred values.
          (if meta
            (foreach piece createdPieces
              (DT--set-tray-meta-one
                piece
                (car meta)
                (cadr meta)
                (caddr meta)
                (nth 3 meta))))
          (foreach piece createdPieces
            (DT--set-entity-3d-mode piece center3d))
        )
      )
      (setq *DT_ACTIVE_LAYER* oldActive
            *DT_ACTIVE_ELEVATION* oldElevation
            *DT_ACTIVE_SIDE_HEIGHT* oldSide
            *DT_ACTIVE_SIDE_HEIGHT_MM* oldSideMm
            *DT_ACTIVE_3D* oldActive3d)
    )
  )
  newPieces
)
(defun DT--center-in-list-p (center centers / hit c)
  (foreach c centers
    (if (eq center c) (setq hit T))
  )
  hit
)

(defun DT--point-dxf-items (pts / out p)
  (foreach p pts
    (setq out (append out (list (cons 10 (list (car p) (cadr p))))))
  )
  out
)

(defun DT--set-center-points (center pts / ed out item inserted)
  (if (and center (entget center) pts
           (= (cdr (assoc 0 (entget center))) "LWPOLYLINE"))
    (progn
      (setq ed (entget center '("*")))
      (foreach item ed
        (cond
          ((= (car item) 90)
            (setq out (append out (list (cons 90 (length pts))))))
          ((= (car item) 10)
            (if (not inserted)
              (progn
                (setq out (append out (DT--point-dxf-items pts)))
                (setq inserted T)
              )
            ))
          ((member (car item) '(40 41 42 91))
            nil)
          ((= (car item) -3)
            (if (not inserted)
              (progn
                (setq out (append out (DT--point-dxf-items pts)))
                (setq inserted T)
              )
            )
            (setq out (append out (list item))))
          (T
            (setq out (append out (list item))))
        )
      )
      (if (not inserted)
        (setq out (append out (DT--point-dxf-items pts)))
      )
      (entmod out)
      (entupd center)
    )
  )
  center
)

(defun DT--merge-center-contact-point (center adjustedPts pt / curPts changed)
  (if (and center (entget center) adjustedPts pt)
    (progn
      (setq curPts (g365_get_pts center))
      (if (and curPts (= (length curPts) (length adjustedPts)))
        (progn
          ;; Yalniz bu kaydin temas ettigi ucu deðiþtir; diðer ucu koru.
          (if (<= (distance (car adjustedPts) pt) 0.001)
            (progn
              (setq curPts (DT--replace-first-point curPts pt))
              (setq changed T)
            )
          )
          (if (<= (distance (g365_last adjustedPts) pt) 0.001)
            (progn
              (setq curPts (DT--replace-last-point curPts pt))
              (setq changed T)
            )
          )
          (if changed (DT--set-center-points center curPts))
        )
      )
    )
  )
  center
)

(defun DT--apply-tee-center-adjustments (newCenter teeRecords / rec pt oldCenter newAdjusted oldAdjusted)
  (foreach rec teeRecords
    (setq pt          (car rec)
          oldCenter   (cadr rec)
          newAdjusted (nth 2 rec)
          oldAdjusted (nth 3 rec))
    (if newAdjusted
      (DT--merge-center-contact-point newCenter newAdjusted pt)
    )
    (if (and oldCenter oldAdjusted)
      (DT--merge-center-contact-point oldCenter oldAdjusted pt)
    )
  )
)
(defun DT--dot-from-base (base u p)
  (g365_dot (- (car p) (car base)) (- (cadr p) (cadr base)) (car u) (cadr u))
)

(defun DT--line-distance (base u p / dx dy)
  (setq dx (- (car p) (car base))
        dy (- (cadr p) (cadr base)))
  (abs (- (* dx (cadr u)) (* dy (car u))))
)

(defun DT--pts-collinear-p (pts base u tol / ok p)
  (setq ok T)
  (foreach p pts
    (if (> (DT--line-distance base u p) tol)
      (setq ok nil)
    )
  )
  ok
)

(defun DT--straight-pts (pts / s)
  (setq s (DT--simplify-pts pts))
  (if (and (= (length s) 2) (> (distance (car s) (cadr s)) 0.001))
    s
  )
)

(defun DT--center-end-touch-p (p pts tol)
  (and pts
       (or
         (<= (distance p (car pts)) tol)
         (<= (distance p (g365_last pts)) tol)
       ))
)

(defun DT--pt-mid (a b)
  (list (/ (+ (car a) (car b)) 2.0) (/ (+ (cadr a) (cadr b)) 2.0) 0.0)
)

(defun DT--tray-center-seg (tray / pts p0 p1 p2 p3 l01 l12)
  ;; Egimli/dik tava kontrolu 3D POLYLINE olabilir. g365_get_pts bazi CAD
  ;; surumlerinde Z'yi dusurdugu icin cok kisa dik parcayi tava genisligiyle
  ;; karistiriyordu. Boyuna kenari gercek 3B mesafeyle belirle.
  (setq pts (DT--tray-corner-points-3d tray))
  (if (and pts (>= (length pts) 4))
    (progn
      (setq p0 (nth 0 pts)
            p1 (nth 1 pts)
            p2 (nth 2 pts)
            p3 (nth 3 pts)
            l01 (distance p0 p1)
            l12 (distance p1 p2))
      (if (>= l01 l12)
        (list (DT--pt-mid p0 p3) (DT--pt-mid p1 p2))
        (list (DT--pt-mid p0 p1) (DT--pt-mid p3 p2))
      )
    )
  )
)

(defun DT--tray-center-seg-on-line (tray base u / seg)
  (setq seg (DT--tray-center-seg tray))
  (if (and seg base u (DT--pts-collinear-p seg base u 20.0))
    seg
  )
)
(defun DT--nearest-seg-end (pt seg tol / a b da db)
  (if (and pt seg (= (length seg) 2))
    (progn
      (setq a (car seg)
            b (cadr seg)
            da (distance pt a)
            db (distance pt b))
      (cond
        ((and (<= da tol) (<= da db)) a)
        ((<= db tol) b)
        (T nil)
      )
    )
  )
)

(defun DT--deleted-fitting-end-gap-p (endPt oldStraight seg oldWidth tol / gapTol oldEnd segEnd gap)
  ;; Baglanti blocku elle silindiginde gorunen tava, eski centerline ucundan
  ;; biraz kisa kalabilir. Bu kisa ucu ayni dogrultuda devam icin baglanabilir say.
  (setq gapTol (+ (* 2.0 oldWidth) tol 2.0))
  (if (and endPt oldStraight seg)
    (progn
      (setq oldEnd (DT--nearest-seg-end endPt oldStraight gapTol))
      (if oldEnd
        (progn
          (setq segEnd (DT--nearest-seg-end oldEnd seg gapTol))
          (if segEnd
            (progn
              (setq gap (distance oldEnd segEnd))
              (and
                (<= gap gapTol)
                (> gap tol)
                (<= (distance endPt oldEnd) (+ gap tol))
                (<= (distance endPt segEnd) (+ gap tol))
              )
            )
          )
        )
      )
    )
  )
)

(defun DT--endpoint-away-dir (endPt base u)
  (if (<= (distance endPt base) 0.001)
    u
    (list (- (car u)) (- (cadr u)))
  )
)

(defun DT--seg-end-other (seg segEnd)
  (if (<= (distance segEnd (car seg)) (distance segEnd (cadr seg)))
    (cadr seg)
    (car seg)
  )
)

(defun DT--visible-seg-end-gap-contact-p (endPt base u seg oldWidth tol / gapTol segEnd other interior away gap)
  ;; T/+ gibi bir fitting silinince cut noktasi centerline ortasinda kalabilir.
  ;; Gorunen tava parcasinin ucundan disari dogru ayni dogrultuda ekleniyorsa birlestir.
  (setq gapTol (+ (* 2.0 oldWidth) tol 2.0))
  (if (and endPt base u seg)
    (progn
      (setq segEnd (DT--nearest-seg-end endPt seg gapTol))
      (if segEnd
        (progn
          (setq other    (DT--seg-end-other seg segEnd)
                interior (DT--seg-unit segEnd other)
                away     (DT--endpoint-away-dir endPt base u)
                gap      (distance endPt segEnd))
          (and
            (> gap tol)
            (<= gap gapTol)
            (< (g365_dot (car away) (cadr away) (car interior) (cadr interior)) -0.90)
          )
        )
      )
    )
  )
)

(defun DT--merge-end-contact-p (old endPt base u oldStraight seg oldWidth tol)
  (or
    (and
      (DT--center-end-touch-p endPt seg tol)
      (DT--center-visible-at-point-p old endPt oldWidth)
    )
    (DT--deleted-fitting-end-gap-p endPt oldStraight seg oldWidth tol)
    (DT--visible-seg-end-gap-contact-p endPt base u seg oldWidth tol)
  )
)

(defun DT--same-merge-candidate-p (a b)
  (and a b
       (eq (car a) (car b))
       (eq (nth 3 a) (nth 3 b)))
)

(defun DT--merge-candidate-used-p (old tray used / hit rec)
  (foreach rec used
    (if (and (eq old (car rec)) (eq tray (nth 3 rec)))
      (setq hit T)
    )
  )
  hit
)

(defun DT--delete-candidate-tray (cand / old tray)
  (setq old  (car cand)
        tray (nth 3 cand))
  (if (and tray (entget tray))
    (DT--delete-ents (list tray))
    (DT--delete-ents (DT--linked-trays old))
  )
  (if (not (DT--active-center-p old))
    (DT--safe-delete-ent old)
  )
)

(defun DT--remove-inactive-centers-from-list (centers / out c)
  (foreach c centers
    (if (and (DT--entity-alive-p c) (DT--active-center-p c))
      (setq out (append out (list c)))
    )
  )
  out
)
(defun DT--merge-bridge-candidate (endPt base u oldCenters width used / old oldPts oldStraight oldWidth tol hit tray seg)
  (foreach old oldCenters
    (if (and (null hit)
             (DT--entity-alive-p old)
             (DT--active-center-p old))
      (progn
        (setq oldPts      (g365_get_pts old)
              oldStraight (DT--straight-pts oldPts)
              oldWidth    (DT--center-width old width)
              tol         (+ (/ (max width oldWidth) 2.0) 1.0))
        (if (DT--same-width-p oldWidth width)
          (foreach tray (DT--linked-trays old)
            (if (and (null hit)
                     (DT--visible-tray-p tray)
                     (not (DT--merge-candidate-used-p old tray used)))
              (progn
                ;; Eski centerline kirikli olabilir; birlestirme kararini
                ;; komple centerline yerine gorunen duz tava parcasindan al.
                (setq seg (DT--tray-center-seg-on-line tray base u))
                (if (and seg
                         (DT--merge-end-contact-p old endPt base u oldStraight seg oldWidth tol))
                  (setq hit (list old seg oldWidth tray))
                )
              )
            )
          )
        )
      )
    )
  )
  hit
)
(defun DT--remove-centers-from-list (centers remove / out c)
  (foreach c centers
    (if (not (member c remove))
      (setq out (append out (list c)))
    )
  )
  out
)

(defun DT--merged-line-pts (allPts base u / minT maxT param p)
  (foreach p allPts
    (setq param (DT--dot-from-base base u p))
    (if (or (null minT) (< param minT)) (setq minT param))
    (if (or (null maxT) (> param maxT)) (setq maxT param))
  )
  (if (and minT maxT (> (- maxT minT) 0.001))
    (list (DT--pt+ base u minT) (DT--pt+ base u maxT))
  )
)
(defun DT--bridge-covers-cut-p (newStraight base u cut width / p gap a b s e c lo hi tol maxLen)
  (setq p (DT--cut-point cut))
  (if (and newStraight p)
    (progn
      (setq gap    (DT--cut-gap cut width)
            a      (DT--dot-from-base base u (car newStraight))
            b      (DT--dot-from-base base u (cadr newStraight))
            s      (min a b)
            e      (max a b)
            c      (DT--dot-from-base base u p)
            lo     (- c gap)
            hi     (+ c gap)
            tol    (+ (/ width 2.0) 2.0)
            maxLen (+ (* 2.0 gap) (* 4.0 width) 10.0))
      (and (<= (DT--line-distance base u p) tol)
           (<= s (+ lo tol))
           (>= e (- hi tol))
           (<= s (+ c tol))
           (>= e (- c tol))
           (<= (- e s) maxLen))
    )
  )
)

(defun DT--split-bridged-cuts (newStraight base u cuts width / kept removed cut)
  (foreach cut cuts
    (if (DT--bridge-covers-cut-p newStraight base u cut width)
      (setq removed (append removed (list cut)))
      (setq kept (append kept (list cut)))
    )
  )
  (list kept removed)
)

(defun DT--merge-internal-cut-bridge (newCenter newStraight oldCenters width base u / old oldPts oldStraight oldWidth tol cuts split kept removed mergedCuts cut)
  (foreach old oldCenters
    (if (and (null removed)
             (DT--entity-alive-p old)
             (DT--active-center-p old))
      (progn
        (setq oldPts      (g365_get_pts old)
              oldStraight (DT--straight-pts oldPts)
              oldWidth    (DT--center-width old width)
              tol         (+ (/ (max width oldWidth) 2.0) 1.0))
        (if (and oldStraight
                 (DT--same-width-p oldWidth width)
                 (DT--pts-collinear-p oldStraight base u tol)
                 (or
                   (DT--center-visible-at-point-p old (car newStraight) oldWidth)
                   (DT--center-visible-at-point-p old (cadr newStraight) oldWidth)))
          (progn
            (setq cuts (DT--plus-cuts old))
            (if cuts
              (progn
                (setq split   (DT--split-bridged-cuts newStraight base u cuts oldWidth)
                      kept    (car split)
                      removed (cadr split))
                (if removed
                  (progn
                    (setq mergedCuts (append (DT--plus-cuts newCenter) kept))
                    (DT--delete-ents (DT--linked-trays old))
                    (foreach cut removed
                      (DT--delete-existing-fittings-at (DT--cut-point cut) (DT--layer-fitting) (+ oldWidth 1.0))
                    )
                    (DT--safe-delete-ent old)
                    (DT--set-center-points newCenter oldStraight)
                    (DT--set-plus-cuts newCenter mergedCuts)
                    (setq oldCenters (DT--remove-centers-from-list oldCenters (list old)))
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (if removed
    (list oldStraight oldCenters 1)
  )
)
(defun DT--merge-one-sided-extension (newCenter newStraight oldCenters width base u c1 c2 / cand old oldStraight mergedPts oldLen mergedLen)
  (setq cand
    (cond
      ((and c1 (null c2)) c1)
      ((and c2 (null c1)) c2)
      (T nil)
    )
  )
  (if cand
    (progn
      (setq old         (car cand)
            oldStraight (cadr cand))
      (setq base (car oldStraight)
            u    (DT--seg-unit (car oldStraight) (cadr oldStraight)))
      (setq mergedPts
        (DT--merged-line-pts
          (append newStraight oldStraight)
          base
          u
        )
      )
      (if mergedPts
        (progn
          (setq oldLen    (distance (car oldStraight) (cadr oldStraight))
                mergedLen (distance (car mergedPts) (cadr mergedPts)))
          (if (> mergedLen (+ oldLen 0.001))
            (progn
              (DT--delete-candidate-tray cand)
              (DT--set-center-points newCenter mergedPts)
              (list mergedPts (DT--remove-inactive-centers-from-list oldCenters) 1)
            )
          )
        )
      )
    )
  )
)
(defun DT--line-end-near (pt line)
  (if (<= (distance pt (car line)) (distance pt (cadr line)))
    (car line)
    (cadr line)
  )
)

(defun DT--line-other-end (pt line)
  (if (<= (distance pt (car line)) (distance pt (cadr line)))
    (cadr line)
    (car line)
  )
)

(defun DT--drop-last-n (lst n / out i lim)
  (setq i 0
        lim (- (length lst) n))
  (while (< i lim)
    (setq out (append out (list (nth i lst))))
    (setq i (1+ i))
  )
  out
)

(defun DT--merge-bent-start-extension (newCenter pts oldCenters width / s a b base u cand oldSeg merged near other oldLen mergedLen dx dy rest newPts)
  (setq s (DT--simplify-pts pts))
  (if (and newCenter s (>= (length s) 3))
    (progn
      (setq a (car s)
            b (cadr s))
      (if (> (distance a b) 0.001)
        (progn
          (setq base a
                u    (DT--seg-unit a b)
                cand (DT--merge-bridge-candidate a base u oldCenters width nil))
          (if cand
            (progn
              (setq oldSeg (cadr cand)
                    merged (DT--merged-line-pts (append (list a b) oldSeg) (car oldSeg) (DT--seg-unit (car oldSeg) (cadr oldSeg))))
              (if merged
                (progn
                  (setq near      (DT--line-end-near b merged)
                        other     (DT--line-other-end b merged)
                        oldLen    (distance (car oldSeg) (cadr oldSeg))
                        mergedLen (distance (car merged) (cadr merged)))
                  (if (> mergedLen (+ oldLen 0.001))
                    (progn
                      (setq dx   (- (car near) (car b))
                            dy   (- (cadr near) (cadr b))
                            rest (DT--translate-pts (cddr s) dx dy)
                            newPts (append (list other near) rest))
                      (DT--delete-candidate-tray cand)
                      (DT--set-center-points newCenter newPts)
                      (list newPts (DT--remove-inactive-centers-from-list oldCenters) 1)
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

(defun DT--merge-bent-last-extension (newCenter pts oldCenters width / s n a b base u cand oldSeg merged near other oldLen mergedLen dx dy prefix newPts)
  (setq s (DT--simplify-pts pts))
  (if (and newCenter s (>= (length s) 3))
    (progn
      (setq n (length s)
            a (nth (- n 2) s)
            b (nth (- n 1) s))
      (if (> (distance a b) 0.001)
        (progn
          (setq base a
                u    (DT--seg-unit a b)
                cand (DT--merge-bridge-candidate b base u oldCenters width nil))
          (if cand
            (progn
              (setq oldSeg (cadr cand)
                    merged (DT--merged-line-pts (append (list a b) oldSeg) (car oldSeg) (DT--seg-unit (car oldSeg) (cadr oldSeg))))
              (if merged
                (progn
                  (setq near      (DT--line-end-near a merged)
                        other     (DT--line-other-end a merged)
                        oldLen    (distance (car oldSeg) (cadr oldSeg))
                        mergedLen (distance (car merged) (cadr merged)))
                  (if (> mergedLen (+ oldLen 0.001))
                    (progn
                      (setq dx     (- (car near) (car a))
                            dy     (- (cadr near) (cadr a))
                            prefix (DT--translate-pts (DT--drop-last-n s 2) dx dy)
                            newPts (append prefix (list near other)))
                      (DT--delete-candidate-tray cand)
                      (DT--set-center-points newCenter newPts)
                      (list newPts (DT--remove-inactive-centers-from-list oldCenters) 1)
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

(defun DT--merge-bent-end-extension (newCenter pts oldCenters width / res)
  (setq res (DT--merge-bent-start-extension newCenter pts oldCenters width))
  (if res
    res
    (DT--merge-bent-last-extension newCenter pts oldCenters width)
  )
)

(defun DT--merge-collinear-bridge (newCenter pts oldCenters width / newStraight base u c1 c2 old1 old2 mergedPts oneSideResult internalResult)
  (setq newStraight (DT--straight-pts pts))
  (if (and newCenter newStraight (= (length newStraight) 2))
    (progn
      (setq base (car newStraight)
            u    (DT--seg-unit (car newStraight) (cadr newStraight)))
      (setq c1 (DT--merge-bridge-candidate (car newStraight) base u oldCenters width nil))
      (setq c2 (DT--merge-bridge-candidate (cadr newStraight) base u oldCenters width (if c1 (list c1) nil)))
      (if (and c1 c2 (not (DT--same-merge-candidate-p c1 c2)))
        (progn
          (setq old1 (car c1)
                old2 (car c2))
          (setq base (caadr c1)
                u    (DT--seg-unit (caadr c1) (cadadr c1)))
          (setq mergedPts
            (DT--merged-line-pts
              (append newStraight (cadr c1) (cadr c2))
              base
              u
            )
          )
          (if mergedPts
            (progn
              (DT--delete-candidate-tray c1)
              (DT--delete-candidate-tray c2)
              (DT--set-center-points newCenter mergedPts)
              (list mergedPts (DT--remove-inactive-centers-from-list oldCenters) 2)
            )
          )
        )
        (progn
          (setq oneSideResult (DT--merge-one-sided-extension newCenter newStraight oldCenters width base u c1 c2))
          (if oneSideResult
            oneSideResult
            (progn
              (setq internalResult (DT--merge-internal-cut-bridge newCenter newStraight oldCenters width base u))
              (if internalResult internalResult)
            )
          )
        )
      )
    )
    (DT--merge-bent-end-extension newCenter pts oldCenters width)
  )
)
(defun DT--apply-junction-splits (newCenter fitResult width / plusRecords teeRecords flexRecords elbowRecords records rec pt oldCenter newGap oldGap centers center)
  (setq plusRecords  (nth 2 fitResult)
        teeRecords   (nth 3 fitResult)
        flexRecords  (nth 5 fitResult)
        elbowRecords (nth 7 fitResult)
        records      (append plusRecords teeRecords flexRecords elbowRecords))
  (if records
    (progn
      (DT--apply-tee-center-adjustments newCenter records)
      (setq centers (list newCenter))
      (foreach rec records
        (setq pt        (car rec)
              oldCenter (cadr rec)
              newGap    (nth 4 rec)
              oldGap    (nth 5 rec))
        (DT--add-plus-cut newCenter pt newGap)
        (if (and oldCenter (entget oldCenter) (DT--active-center-p oldCenter))
          (progn
            (DT--add-plus-cut oldCenter pt oldGap)
            (if (not (DT--center-in-list-p oldCenter centers))
              (setq centers (append centers (list oldCenter)))
            )
          )
        )
      )
      (foreach center centers
        (DT--rebuild-center-pieces center width (eq center newCenter))
      )
    )
  )
  (DT--linked-trays newCenter)
)
(defun DT--apply-plus-splits (newCenter fitResult width)
  (DT--apply-junction-splits newCenter fitResult width)
)

(defun DT--visible-tray-p (ent / ed)
  (and ent
       (DT--entity-alive-p ent)
       (setq ed (entget ent))
       (member (cdr (assoc 0 ed)) '("LWPOLYLINE" "POLYLINE"))
       (DT--tray-visible-layer-p (cdr (assoc 8 ed)))
       (DT--closed-p ent))
)
(defun DT--live-fitting-at-point-p
  (pt width / ent ed ip lay activeLayer fw tol d hit)
  (if (and pt (DT--layer-fitting))
    (progn
      (setq activeLayer (strcase (DT--layer-fitting)))
      (foreach ent (DT--fitting-inserts)
        (if (null hit)
          (progn
            (setq ed (entget ent)
                  ip  (if ed (cdr (assoc 10 ed)) nil)
                  lay (if ed (cdr (assoc 8 ed)) nil))
            (if (and ip
                     lay
                     (= (strcase lay) activeLayer)
                     (DT--same-active-elevation-p ent)
                     ;; Bu DT calismasinda az once uretilen 90 bloklari eski
                     ;; kavsak/fitting kaniti degildir; hayalet center kolunu canlandirmasin.
                     (not
                       (and (boundp '*DT_CURRENT_TURN_BLOCKS*)
                            (member ent *DT_CURRENT_TURN_BLOCKS*))))
              (progn
                (setq fw  (DT--fitting-insert-width ent width)
                      tol (+ (max 1.0 (/ fw 2.0)) 1.0)
                      d   (distance
                            (list (car pt) (cadr pt) 0.0)
                            (list (car ip) (cadr ip) 0.0)))
                (if (and
                      (<= d (+ (* fw 4.0) 1.0))
                      (or
                        (<= d tol)
                        (DT--point-in-fitting-box-p pt ent 0.5)))
                  (setq hit T))
              )
            )
          )
        )
      )
    )
  )
  hit
)

(defun DT--elevation-fitting-insert-p (ent / ed)
  (and ent
       (setq ed (entget ent '("DT_ELEVATION")))
       (= (cdr (assoc 0 ed)) "INSERT")
       (assoc -3 ed))
)

(defun DT--live-elevation-fitting-at-point-p
  (pt width / ent ed ip lay activeLayer fw tol d hit)
  ;; Gecis blocku eski veya yeni tavanin kotunda olabilir; XY kesimi iki tarafta da korur.
  (if (and pt (DT--layer-fitting))
    (progn
      (setq activeLayer (strcase (DT--layer-fitting)))
      (foreach ent (DT--fitting-inserts)
        (if (null hit)
          (progn
            (setq ed (entget ent)
                  ip  (if ed (cdr (assoc 10 ed)) nil)
                  lay (if ed (cdr (assoc 8 ed)) nil))
            (if (and ip
                     lay
                     (= (strcase lay) activeLayer)
                     (DT--elevation-fitting-insert-p ent))
              (progn
                (setq fw  (DT--fitting-insert-width ent width)
                      tol (+ (max 1.0 (/ fw 2.0)) 1.0)
                      d   (distance
                            (list (car pt) (cadr pt) 0.0)
                            (list (car ip) (cadr ip) 0.0)))
                (if (and
                      (<= d (+ (* fw 4.0) 1.0))
                      (or
                        (<= d tol)
                        (DT--point-in-fitting-box-p pt ent 0.5)))
                  (setq hit T))
              )
            )
          )
        )
      )
    )
  )
  hit
)

(defun DT--cleanup-stale-plus-cuts (center / cuts kept cut p w oldActive cutZ)
  (if (and center (entget center))
    (progn
      (setq cuts (DT--plus-cuts center)
            w    (DT--center-width center 10.0))
      (foreach cut cuts
        (setq p         (DT--cut-point cut)
              oldActive (DT--active-elevation)
              cutZ      (DT--center-elevation-at-point center p)
              *DT_ACTIVE_ELEVATION* cutZ)
        (if (or (DT--live-fitting-at-point-p p w)
                (DT--live-elevation-fitting-at-point-p p w))
          (setq kept (append kept (list cut)))
        )
        (setq *DT_ACTIVE_ELEVATION* oldActive)
      )
      (if (/= (length kept) (length cuts))
        (DT--set-plus-cuts center kept)
      )
    )
  )
  center
)
(defun DT--center-visible-at-point-p (center pt width / trays tray cp d w tol hit seg rec)
  ;; Eski centerline'in herhangi bir yerinde tava kalmasi yetmez.
  ;; Baglanti kararinda, tam baglanilacak noktada gorunur tava/fitting olmali.
  (if (and center pt (DT--entity-alive-p center))
    (progn
      (setq w (DT--center-width center width)
            tol (+ (/ w 2.0) 1.0)
            trays (DT--linked-trays center))
      (foreach tray trays
        (if (and (null hit) (DT--visible-tray-p tray))
          (progn
            (setq seg (DT--tray-center-seg tray)
                  rec (if seg (g365_closest_on_seg pt (car seg) (cadr seg)) nil)
                  cp  (if rec (car rec) nil))
            (if cp
              (progn
                (setq d (DT--distance-xy pt cp))
                (if (<= d tol) (setq hit T))
              )
            )
          )
        )
      )
      (if (and (null hit)
               (or (DT--live-fitting-at-point-p pt w)
                   (DT--live-elevation-fitting-at-point-p pt w)))
        (setq hit T)
      )
    )
  )
  hit
)
(defun DT--curve-total-length (ent / ep d)
  (setq ep (vl-catch-all-apply 'vlax-curve-getEndParam (list ent)))
  (if (vl-catch-all-error-p ep)
    0.0
    (progn
      (setq d (vl-catch-all-apply 'vlax-curve-getDistAtParam (list ent ep)))
      (if (or (vl-catch-all-error-p d) (not (numberp d))) 0.0 d)
    )
  )
)

(defun DT--legacy-center-tray (center / ss i tray total ratios ratio p cp d good found)
  (setq ss (ssget "_X" (list (cons 0 "LWPOLYLINE") (cons 8 (DT--visible-layer-filter)) (cons 70 1))))
  (setq total (DT--curve-total-length center))
  (setq ratios '(0.25 0.50 0.75))
  (if (and ss (> total 0.01))
    (progn
      (setq i 0)
      (while (and (< i (sslength ss)) (null found))
        (setq tray (ssname ss i) good 0)
        (foreach ratio ratios
          (setq p (vl-catch-all-apply 'vlax-curve-getPointAtDist (list center (* total ratio))))
          (if (not (vl-catch-all-error-p p))
            (progn
              (setq cp (vl-catch-all-apply 'vlax-curve-getClosestPointTo (list tray p)))
              (if (not (vl-catch-all-error-p cp))
                (progn
                  (setq d (distance p cp))
                  (if (and (>= d 3.5) (<= d 6.5)) (setq good (1+ good)))
                )
              )
            )
          )
        )
        (if (>= good 2) (setq found tray))
        (setq i (1+ i))
      )
    )
  )
  found
)

(defun DT--active-center-p (center / trays tray hit)
  (setq trays (DT--linked-trays center))
  (foreach tray trays
    (if (DT--visible-tray-p tray) (setq hit T))
  )
  ;; Silinmis tava parcalarini eski merkez hattan tekrar uretme.
  ;; Sadece XData ile canli tava polyline''ina bagli centerline aktif sayilir.
  (if hit T nil)
)

(defun DT--cleanup-stale-centers (/ ss i ent)
  (setq ss (ssget "_X" (list (cons 0 "LWPOLYLINE,POLYLINE") (cons 8 (DT--layer-center)))))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent (ssname ss i))
        (if (and (DT--entity-alive-p ent)
                 (not (DT--active-center-p ent)))
          (DT--safe-delete-ent ent)
          (DT--cleanup-stale-plus-cuts ent)
        )
        (setq i (1+ i))
      )
    )
  )
  nil
)
(defun DT--dir-at-point (pts pt / i best bestD rec d)
  (setq i 0 best nil bestD 1e99)
  (while (< i (1- (length pts)))
    (setq rec (g365_closest_on_seg pt (nth i pts) (nth (1+ i) pts)))
    (setq d (nth 2 rec))
    (if (< d bestD)
      (setq bestD d best (DT--seg-unit (nth i pts) (nth (1+ i) pts)))
    )
    (setq i (1+ i))
  )
  best
)

(defun DT--away-from-end-dir (pts pt tol / firstPt lastPt n)
  (setq n (length pts) firstPt (car pts) lastPt (g365_last pts))
  (cond
    ((and (> n 1) (<= (distance pt firstPt) tol))
      (DT--seg-unit firstPt (nth 1 pts)))
    ((and (> n 1) (<= (distance pt lastPt) tol))
      (DT--seg-unit lastPt (nth (- n 2) pts)))
    (T (DT--dir-at-point pts pt))
  )
)
(defun DT--replace-first-point (pts p)
  (if pts (cons p (cdr pts)) pts)
)

(defun DT--replace-last-point (pts p / out i)
  (setq i 0)
  (while (< i (length pts))
    (if (= i (1- (length pts)))
      (setq out (append out (list p)))
      (setq out (append out (list (nth i pts))))
    )
    (setq i (1+ i))
  )
  out
)

(defun DT--near-end-contact (endPt hostPts tol / rec)
  (setq rec (g365_closest_on_poly endPt hostPts))
  (if (and rec (> (nth 3 rec) 0.001) (<= (nth 3 rec) tol)) rec nil)
)

(defun DT--hit-near-center-p (hits center pt tol / hit rec)
  (foreach rec hits
    (if (and (eq (cadr rec) center)
             (<= (distance (car rec) pt) tol))
      (setq hit T)
    )
  )
  hit
)

(defun DT--nearest-poly-end (pt pts tol / firstPt lastPt dFirst dLast)
  (if (and pt pts (> (length pts) 1))
    (progn
      (setq firstPt (car pts)
            lastPt (g365_last pts)
            dFirst (distance pt firstPt)
            dLast (distance pt lastPt))
      (cond
        ((and (<= dFirst tol) (<= dFirst dLast)) firstPt)
        ((<= dLast tol) lastPt)
        (T nil)
      )
    )
  )
)

(defun DT--snap-poly-ends-to-host-ends (pts hostPts tol / out cp)
  (setq out pts)
  (if (and out hostPts)
    (progn
      ;; Uc kenarinin hangi noktasina tiklanirsa tiklansin merkez ucunu kullan.
      (setq cp (DT--nearest-poly-end (car out) hostPts tol))
      (if cp (setq out (DT--replace-first-point out cp)))
      (setq cp (DT--nearest-poly-end (g365_last out) hostPts tol))
      (if cp (setq out (DT--replace-last-point out cp)))
    )
  )
  out
)

(defun DT--snap-poly-ends-to-point (pts pt tol / out)
  (setq out pts)
  (if (and out pt)
    (progn
      ;; If the intersection is only within tray-width reach of an end,
      ;; treat it as an end touch instead of a through crossing.
      (if (<= (distance (car out) pt) tol)
        (setq out (DT--replace-first-point out pt))
      )
      (if (<= (distance (g365_last out) pt) tol)
        (setq out (DT--replace-last-point out pt))
      )
    )
  )
  out
)

(defun DT--pts-from-arms (pt arms dist / pts arm)
  (if arms
    (progn
      (setq pts (list (list (car pt) (cadr pt) 0.0)))
      (foreach arm arms
        (setq pts (append pts (list (DT--pt+ pt arm dist) (list (car pt) (cadr pt) 0.0))))
      )
      pts
    )
  )
)

(defun DT--visible-end-adjusted-pts (center pt width / trays tray seg segEnd other tol dir arms)
  ;; Baglanti/fitting silinmis olsa bile eski centerline arkada kalabilir.
  ;; Kavsak hesabinda centerline'i degil, o noktaya gelen CANLI tava uclarini kol say.
  (setq tol (+ (* 2.0 width) (/ width 2.0) 2.0))
  (foreach tray (DT--linked-trays center)
    (if (DT--visible-tray-p tray)
      (progn
        (setq seg (DT--tray-center-seg tray))
        (if (and seg (> (distance (car seg) (cadr seg)) 0.001))
          (progn
            (setq segEnd (DT--nearest-seg-end pt seg tol))
            (if segEnd
              (progn
                (setq other (DT--seg-end-other seg segEnd)
                      dir   (DT--seg-unit segEnd other))
                (if (<= (DT--line-distance segEnd dir pt) (+ (/ width 2.0) 1.0))
                  (setq arms (DT--add-ray-unique (DT--vec-from-to (list (car pt) (cadr pt) 0.0) other) arms))
                )
              )
            )
          )
        )
      )
    )
  )
  (DT--pts-from-arms pt arms width)
)

(defun DT--old-arm-matches-new-p (oldArm newArms mode / hit newArm)
  (foreach newArm newArms
    (cond
      ((and (= mode 'OPPOSITE) (DT--opposite-p oldArm newArm)) (setq hit T))
      ((and (= mode 'PERP) (DT--perpendicular-p oldArm newArm)) (setq hit T))
    )
  )
  hit
)

(defun DT--filter-deleted-fitting-old-arms (pt oldArms newArms width / opp perp arm keep)
  ;; Canli baglanti blocku yoksa, eski silinmis fitting'in butun kollarini
  ;; T hesabina sokma. Yeni cizimin baglandigi tek eski kolu kullan.
  (if (and pt
           oldArms
           newArms
           (> (length oldArms) 1)
           ;; Iki zit canli kol, parcalara bolunmus olsa da tek ve
           ;; kesintisiz ana tava eksenidir. Yeni dal bunu T yapmalidir.
           (not (DT--straight-axis oldArms))
           (not (DT--live-fitting-at-point-p pt width)))
    (progn
      (foreach arm oldArms
        (if (DT--old-arm-matches-new-p arm newArms 'OPPOSITE)
          (setq opp (DT--add-ray-unique arm opp))
        )
        (if (DT--old-arm-matches-new-p arm newArms 'PERP)
          (setq perp (DT--add-ray-unique arm perp))
        )
      )
      (setq keep
        (cond
          (opp (list (car opp)))
          (perp (list (car perp)))
          (T (list (car oldArms)))
        )
      )
      keep
    )
    oldArms
  )
)

(defun DT--collect-cross-hits (newPts oldEnts width / hits old oldPts oldWidth workNewPts i j a b c d ip tolOld tolNew rec cp adjustedNew adjustedOld pStart pEnd oStart oEnd u v endRec visibleOldPts)
  (foreach old oldEnts
    (if (DT--active-center-p old)
      (progn
        (setq oldPts (g365_get_pts old))
        (setq oldWidth (DT--center-width old width))
        (setq tolOld (+ (/ oldWidth 2.0) 0.5))
        (setq tolNew (+ (/ width 2.0) 0.5))
        (setq workNewPts (DT--snap-poly-ends-to-host-ends newPts oldPts tolOld))
        (if (and oldPts (> (length oldPts) 1))
          (progn
            ;; Tam merkez hat kesiÅŸmeleri.
            (setq i 0)
            (while (< i (1- (length workNewPts)))
              (setq a (nth i workNewPts) b (nth (1+ i) workNewPts) j 0)
              (while (< j (1- (length oldPts)))
                (setq c (nth j oldPts) d (nth (1+ j) oldPts))
                (setq ip (inters a b c d T))
                (if ip                   (progn                     (setq cp (list (car ip) (cadr ip) 0.0))                     (setq visibleOldPts (DT--visible-end-adjusted-pts old cp oldWidth))                     (if (and (or visibleOldPts (DT--center-visible-at-point-p old cp oldWidth))                              (not (DT--point-known-p ip (mapcar 'car hits) 0.0001)))                       (progn                         (setq adjustedNew (DT--snap-poly-ends-to-point workNewPts cp tolNew)                               adjustedOld (if visibleOldPts visibleOldPts (DT--snap-poly-ends-to-point oldPts cp tolOld)))                         (setq hits (append hits (list (list cp old adjustedOld adjustedNew))))                       )                     )                   )                 )
                (setq j (1+ j))
              )
              (setq i (1+ i))
            )

            ;; Yeni DT ucu eski tavanin gorunen kenarina degiyorsa merkeze projekte et.
            (setq pStart (car workNewPts) pEnd (g365_last workNewPts))
            (foreach endRec (list (list pStart 0) (list pEnd 1))
              (setq rec (DT--near-end-contact (car endRec) oldPts tolOld))
              (if (and rec (DT--center-visible-at-point-p old (car rec) oldWidth))
                (progn
                  (setq cp (car rec))
                  (setq adjustedNew
                    (if (= (cadr endRec) 0)
                      (DT--replace-first-point workNewPts cp)
                      (DT--replace-last-point workNewPts cp)
                    )
                  )
                  (setq u (DT--away-from-end-dir adjustedNew cp 0.001))
                  (setq v (DT--dir-at-point oldPts cp))
                  (if (not (DT--point-known-p cp (mapcar 'car hits) 0.0001))
                    (setq hits (append hits (list (list cp old (if (DT--visible-end-adjusted-pts old cp oldWidth) (DT--visible-end-adjusted-pts old cp oldWidth) oldPts) adjustedNew))))
                  )
                )
              )
            )

            ;; Eski DT ucu yeni tavanin gorunen kenarina degiyorsa ayni islemi ters yonde yap.
            (setq oStart (car oldPts) oEnd (g365_last oldPts))
            (foreach endRec (list (list oStart 0) (list oEnd 1))
              (setq rec (DT--near-end-contact (car endRec) workNewPts tolNew))
              (if (and rec (DT--center-visible-at-point-p old (car rec) oldWidth))
                (progn
                  (setq cp (car rec))
                  (setq adjustedOld
                    (if (= (cadr endRec) 0)
                      (DT--replace-first-point oldPts cp)
                      (DT--replace-last-point oldPts cp)
                    )
                  )
                  (setq u (DT--away-from-end-dir adjustedOld cp 0.001))
                  (setq v (DT--dir-at-point workNewPts cp))
                  ;; Ayni tava ucunun kenar/kose temasi daha once merkezden bulunduysa
                  ;; ikinci bir baglanti sayma ve eski merkez hattini koseye tasima.
                  (if (not (DT--hit-near-center-p hits old cp (max tolOld tolNew)))
                    (setq hits (append hits (list (list cp old (if (DT--visible-end-adjusted-pts old cp oldWidth) (DT--visible-end-adjusted-pts old cp oldWidth) adjustedOld) workNewPts))))
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  hits
)
(defun DT--collect-self-hits (pts / hits n i j a b c d ip)
  (setq n (length pts) i 0)
  (while (< i (1- n))
    (setq a (nth i pts) b (nth (1+ i) pts) j (+ i 2))
    (while (< j (1- n))
      (setq c (nth j pts) d (nth (1+ j) pts))
      (setq ip (inters a b c d T))
      (if (and ip (not (DT--point-known-p ip (mapcar 'car hits) 0.0001)))
        (setq hits (append hits (list (list (list (car ip) (cadr ip) 0.0) i j))))
      )
      (setq j (1+ j))
    )
    (setq i (1+ i))
  )
  hits
)

(defun DT--point-angle-around (base p)
  (atan (- (cadr p) (cadr base)) (- (car p) (car base)))
)

(defun DT--sort-points-around (pts base)
  (vl-sort pts
    (function
      (lambda (a b)
        (< (DT--point-angle-around base a) (DT--point-angle-around base b))
      )
    )
  )
)

(defun DT--unique-points (pts tol / out p)
  (foreach p pts
    (if (not (DT--point-known-p p out tol))
      (setq out (append out (list p)))
    )
  )
  out
)

(defun DT--combine-arms (a b / out u)
  (foreach u (append a b)
    (setq out (DT--add-ray-unique u out))
  )
  out
)

(defun DT--all-collinear-p (arms / base ok u)
  (setq ok T)
  (if arms
    (progn
      (setq base (car arms))
      (foreach u (cdr arms)
        (if (< (abs (g365_dot (car base) (cadr base) (car u) (cadr u))) 0.995)
          (setq ok nil)
        )
      )
    )
  )
  ok
)

(defun DT--flexible-arms-p (arms / n)
  (setq n (length arms))
  (and (>= n 2)
       (<= n 4)
       (not (DT--all-collinear-p arms))
       (not (and (= n 2) (DT--perpendicular-p (car arms) (cadr arms))))
  )
)

(defun DT--same-width-p (a b)
  (and (numberp a) (numberp b) (<= (abs (- a b)) 0.0001))
)

(defun DT--add-arm-spec (ray width specs / out rec found)
  (if (and ray (numberp width) (> width 0.0))
    (progn
      (foreach rec specs
        (if (DT--same-ray-p ray (car rec))
          (progn
            (setq out (append out (list (list (car rec) (max width (cadr rec))))))
            (setq found T)
          )
          (setq out (append out (list rec)))
        )
      )
      (if (not found)
        (setq out (append out (list (list ray width))))
      )
    )
    (setq out specs)
  )
  out
)

(defun DT--combine-arm-specs (newArms newWidth oldArms oldWidth / specs u)
  (foreach u newArms
    (setq specs (DT--add-arm-spec u newWidth specs))
  )
  (foreach u oldArms
    (setq specs (DT--add-arm-spec u oldWidth specs))
  )
  specs
)

(defun DT--arm-spec-rays (specs / out rec)
  (foreach rec specs
    (setq out (append out (list (car rec))))
  )
  out
)

(defun DT--flex-kind (specs / sig rec i j a b dotv)
  (setq sig "esnek"
        i 0)
  (while (< i (length specs))
    (setq j (1+ i))
    (while (< j (length specs))
      (setq a (car (nth i specs))
            b (car (nth j specs))
            dotv (fix (* 1000.0 (g365_dot (car a) (cadr a) (car b) (cadr b)))))
      (setq sig (strcat sig "_" (itoa dotv)))
      (setq j (1+ j))
    )
    (setq i (1+ i))
  )
  sig
)

(defun DT--center-info-at-point (center pt width tol ptsOverride / pts arms w visiblePts)
  (if (and center
           (entget center)
           (or ptsOverride (DT--center-visible-at-point-p center pt width)))
    (progn
      (setq w (DT--center-width center width))
      (setq pts
        (cond
          (ptsOverride ptsOverride)
          ((setq visiblePts (DT--visible-end-adjusted-pts center pt w)) visiblePts)
          (T (g365_get_pts center))
        )
      )
      (setq arms (if pts (DT--arms-at-point pts pt tol) nil))
      (if arms
        (list center pts w arms)
      )
    )
  )
)
(defun DT--junction-old-infos (pt oldEnts seedCenter seedPts width tol newArms / infos center info arms filtered visibleEnd deletedEndSeen singleOld)
  (foreach center oldEnts
    (setq info
      (DT--center-info-at-point
        center
        pt
        width
        tol
        (if (eq center seedCenter) seedPts nil)
      )
    )
    (if info
      (progn
        (setq arms (nth 3 info))
        (setq visibleEnd (DT--visible-end-adjusted-pts center pt (nth 2 info)))
        (setq filtered
          (if visibleEnd
            (DT--filter-deleted-fitting-old-arms pt arms newArms (nth 2 info))
            arms
          )
        )
        (if visibleEnd (setq deletedEndSeen T))
        (if (/= (length filtered) (length arms))
          (progn
            (setq info (list (car info) (DT--pts-from-arms pt filtered (nth 2 info)) (nth 2 info) filtered))
          )
        )
        (setq infos (append infos (list info)))
      )
    )
  )
  (setq singleOld T)
  (foreach info infos
    (if (/= (length (nth 3 info)) 1)
      (setq singleOld nil)
    )
  )
  (if (and deletedEndSeen
           singleOld
           (= (length newArms) 2)
           (or
             (DT--opposite-p (car newArms) (cadr newArms))
             (DT--perpendicular-p (car newArms) (cadr newArms))
           )
           (not (DT--live-fitting-at-point-p pt width)))
    nil
    infos
  )
)

(defun DT--infos-arms (infos / arms info u)
  (foreach info infos
    (foreach u (nth 3 info)
      (setq arms (DT--add-ray-unique u arms))
    )
  )
  arms
)

(defun DT--infos-arm-specs (newArms newWidth infos / specs info u)
  (foreach u newArms
    (setq specs (DT--add-arm-spec u newWidth specs))
  )
  (foreach info infos
    (foreach u (nth 3 info)
      (setq specs (DT--add-arm-spec u (nth 2 info) specs))
    )
  )
  specs
)

(defun DT--forced-through-tee-specs
  (pt adjustedNewPts oldCenter oldPts newWidth
    / newArms oldWidth visibleOldPts visibleOldArms
      rawOldPts rawOldArms physicalOldArms axis branch)
  ;; Fiziksel olarak kesintisiz iki zit ana kol ve bunlara dik tek yeni kol
  ;; varsa, eski fitting/cache durumundan bagimsiz olarak bu kavsak T'dir.
  (setq newArms (DT--arms-at-point adjustedNewPts pt 0.001)
        oldWidth (if oldCenter (DT--center-width oldCenter newWidth) newWidth)
        visibleOldPts
          (if oldCenter
            (DT--visible-end-adjusted-pts oldCenter pt oldWidth)))
  (setq visibleOldArms
          (if visibleOldPts
            (DT--arms-at-point visibleOldPts pt 0.001))
        rawOldPts
          (if oldCenter
            (g365_get_pts oldCenter)
            oldPts)
        rawOldArms
          (if rawOldPts
            (DT--arms-at-point rawOldPts pt 0.001))
        physicalOldArms
          (cond
            ((DT--straight-axis visibleOldArms) visibleOldArms)
            ((DT--straight-axis rawOldArms) rawOldArms)
            (visibleOldArms visibleOldArms)
            (T rawOldArms)))
  (setq axis (DT--straight-axis physicalOldArms)
        branch (if (= (length newArms) 1) (car newArms)))
  (if (and axis branch (DT--perpendicular-p axis branch))
    (DT--combine-arm-specs newArms newWidth physicalOldArms oldWidth))
)


(defun DT--endpoint-continuation-p (pt pts oldArms / tol dir arm hit)
  ;; Yeni cizim eski tavanin ucundan ayni dogrultuda devam ediyorsa
  ;; baslangic noktasini T baglantisi sayma.
  (setq tol 0.001)
  (if (and pt pts oldArms (> (length pts) 1))
    (progn
      (cond
        ((<= (distance pt (car pts)) tol)
          (setq dir (DT--seg-unit (car pts) (cadr pts))))
        ((<= (distance pt (g365_last pts)) tol)
          (setq dir (DT--seg-unit (g365_last pts) (nth (- (length pts) 2) pts))))
      )
      (if dir
        (foreach arm oldArms
          (if (> (abs (g365_dot (car dir) (cadr dir) (car arm) (cadr arm))) 0.995)
            (setq hit T)
          )
        )
      )
    )
  )
  hit
)
(defun DT--internal-90-corner-p (pt pts tol / i prev cur next hit)
  (if (and pt pts (> (length pts) 2))
    (progn
      (setq i 1)
      (while (and (< i (1- (length pts))) (not hit))
        (setq prev (nth (1- i) pts)
              cur  (nth i pts)
              next (nth (1+ i) pts))
        (if (and (<= (distance pt cur) tol)
                 (> (distance prev cur) 0.001)
                 (> (distance cur next) 0.001)
                 (DT--perpendicular-p (DT--seg-unit cur prev) (DT--seg-unit cur next)))
          (setq hit T)
        )
        (setq i (1+ i))
      )
    )
  )
  hit
)
(defun DT--internal-corner-continuation-p (pt pts oldArms / newArms oldArm u ok hit)
  ;; Yeni polyline'in kendi 90 kosesinde eski taraf sadece ayni dogrultuda
  ;; devam ediyorsa bunu kavsak sayma; normal 90 donus blogu kalsin.
  (setq newArms (DT--arms-at-point pts pt 0.001))
  (if (and pt
           pts
           oldArms
           (= (length newArms) 2)
           (DT--perpendicular-p (car newArms) (cadr newArms)))
    (progn
      (setq ok T)
      (foreach oldArm oldArms
        (setq hit nil)
        (foreach u newArms
          (if (> (abs (g365_dot (car oldArm) (cadr oldArm) (car u) (cadr u))) 0.995)
            (setq hit T)
          )
        )
        (if (not hit) (setq ok nil))
      )
    )
  )
  ok
)
(defun DT--specs-max-width (specs fallback / maxWidth rec)
  (setq maxWidth fallback)
  (foreach rec specs
    (if (and (numberp (cadr rec)) (> (cadr rec) maxWidth))
      (setq maxWidth (cadr rec))
    )
  )
  maxWidth
)

(defun DT--t-axis-branch (arms / axis branch u)
  (if (= (length arms) 3)
    (progn
      (foreach u arms
        (if (and (null axis) (DT--opposite-exists-p u arms))
          (setq axis u)
        )
      )
      (if axis
        (foreach u arms
          (if (and (null branch)
                   (not (DT--same-ray-p u axis))
                   (not (DT--opposite-p u axis)))
            (setq branch u)
          )
        )
      )
      (if (and axis branch (DT--perpendicular-p axis branch))
        (list axis branch)
      )
    )
  )
)

(defun DT--two-arm-elbow (arms)
  (if (and (= (length arms) 2) (DT--perpendicular-p (car arms) (cadr arms)))
    (list (car arms) (cadr arms))
  )
)

(defun DT--junction-records (pt infos adjustedNewPts fitWidth / records info)
  (if infos
    (foreach info infos
      (setq records
        (append records
          (list (list pt (car info) adjustedNewPts (cadr info) fitWidth fitWidth))
        )
      )
    )
    (setq records (list (list pt nil adjustedNewPts nil fitWidth nil)))
  )
  records
)

(defun DT--draw-updated-junction-fitting (pt arms specs fitWidth / axes tb elbow)
  (cond
    ((setq axes (DT--four-way-axes arms))
      (DT--delete-existing-fittings-at pt (DT--layer-fitting) (+ fitWidth 1.0))
      (DT--draw-plus-fitting pt (car axes) (cadr axes) fitWidth (DT--layer-fitting))
      'PLUS)
    ((setq tb (DT--t-axis-branch arms))
      (DT--delete-existing-fittings-at pt (DT--layer-fitting) (+ fitWidth 1.0))
      (DT--draw-t-fitting pt (car tb) (cadr tb) fitWidth (DT--layer-fitting))
      'TEE)
    ((setq elbow (DT--two-arm-elbow arms))
      (DT--delete-existing-fittings-at pt (DT--layer-fitting) (+ fitWidth 1.0))
      (DT--draw-end-elbow-fitting pt (car elbow) (cadr elbow) fitWidth (DT--layer-fitting))
      'ELBOW)
    ((DT--flexible-arms-p arms)
      (DT--delete-existing-fittings-at pt (DT--layer-fitting) (+ fitWidth 1.0))
      (DT--draw-flex-fitting pt specs (DT--layer-fitting))
      'FLEX)
    (T nil)
  )
)
(defun DT--draw-variable-fitting (kind pt specs lay / corners ports spec u width maxWidth h n q outline ref second ang yscale)
  (setq maxWidth 0.0)
  (foreach spec specs
    (setq u (car spec)
          width (cadr spec)
          maxWidth (max maxWidth width)
          h (/ width 2.0)
          n (DT--perp u)
          q (DT--pt+ pt u width))
    (setq ports (append ports (list q)))
    (setq corners
      (append corners
        (list
          (DT--pt+ q n h)
          (DT--pt+ q n (- h))
        )
      )
    )
  )
  (setq corners (DT--unique-points corners 0.0001))
  (setq outline (DT--sort-points-around corners pt))
  (setq ref (caar specs)
        second (if (> (length specs) 1) (car (nth 1 specs)) (DT--perp ref))
        ang (DT--vec-angle ref)
        yscale (DT--mirror-for ref second))
  (if (>= (length outline) 3)
    (DT--make-fitting-block kind maxWidth pt (list (list outline T nil ports)) ang yscale)
  )
)

(defun DT--draw-flex-fitting (pt specs lay)
  (DT--draw-variable-fitting (DT--flex-kind specs) pt specs lay)
)

(defun DT--mark-elevation-transition (ins fromZ toZ / app ed payload)
  (setq app "DT_ELEVATION")
  (if (not (tblsearch "APPID" app)) (regapp app))
  (if (and ins (entget ins))
    (progn
      (setq payload
        (list app
          (cons 1000 "ELEVATION")
          (cons 1040 (if (numberp fromZ) fromZ 0.0))
          (cons 1040 (if (numberp toZ) toZ 0.0))))
      (setq ed (entget ins '("*")))
      (setq ed (DT--xdata-set-app ed app payload))
      (entmod ed)
      (entupd ins)
    )
  )
  (DT--cache-fitting-insert ins)
  ins
)

(defun DT--elevation-fitting-kind (newArm oldArm newWidth oldWidth / dotv)
  (setq dotv
    (if (and newArm oldArm)
      (fix (* 1000.0 (g365_dot (car newArm) (cadr newArm) (car oldArm) (cadr oldArm))))
      0))
  (strcat "ELEVATION_"
          (DT--width-name newWidth) "_"
          (DT--width-name oldWidth) "_"
          (itoa dotv))
)

(defun DT--draw-elevation-fitting (rec newPts width / pt oldPts oldWidth oldZ pairedZ newArm oldArm specs kind maxWidth oldActiveElevation ins)
  (setq pt       (car rec)
        oldPts   (nth 2 rec)
        oldWidth (nth 3 rec)
        oldZ     (nth 4 rec)
        pairedZ  (nth 6 rec)
        newArm   (DT--away-from-end-dir newPts pt 0.001)
        oldArm   (DT--away-from-end-dir oldPts pt 0.001))
  (if (and pt newArm oldArm)
    (progn
      (setq specs (DT--add-arm-spec newArm width specs))
      (setq specs (DT--add-arm-spec oldArm oldWidth specs))
      ;; Ust uste fakat farkli kotlu tavada da iki kollu bir gecis govdesi gerekir.
      (if (< (length specs) 2)
        (setq specs
          (DT--add-arm-spec
            (list (- (car newArm)) (- (cadr newArm)))
            oldWidth
            specs))
      )
      (setq kind (DT--elevation-fitting-kind newArm oldArm width oldWidth)
            maxWidth (max width oldWidth)
            oldActiveElevation (DT--active-elevation)
            *DT_ACTIVE_ELEVATION* oldZ)
      (DT--delete-existing-fittings-at pt (DT--layer-fitting) (+ maxWidth 1.0))
      (setq ins (DT--draw-variable-fitting kind pt specs (DT--layer-fitting)))
      (setq *DT_ACTIVE_ELEVATION* oldActiveElevation)
      (if ins (DT--mark-elevation-transition ins oldZ pairedZ))
    )
  )
  ins
)

(defun DT--transition-center-specs (pt centers oldZ fallbackWidth / center pts centerZ centerWidth arms arm specs used oldActive)
  (foreach center centers
    (if (and center (entget center) (DT--active-center-p center))
      (progn
        (setq pts         (g365_get_pts center)
              centerZ     (DT--center-elevation-at-point center pt)
              centerWidth (DT--center-width center fallbackWidth)
              oldActive   (DT--active-elevation)
              *DT_ACTIVE_ELEVATION* oldZ)
        (if (and pts
                 (equal centerZ oldZ 0.000001)
                 (DT--center-visible-at-point-p center pt centerWidth))
          (progn
            (setq arms (DT--arms-at-point pts pt 0.001))
            (foreach arm arms
              (setq specs (DT--add-arm-spec arm centerWidth specs))
            )
            (if arms (setq used (DT--add-ent-unique center used)))
          )
        )
        (setq *DT_ACTIVE_ELEVATION* oldActive)
      )
    )
  )
  (list specs used)
)

(defun DT--draw-transition-normal-fitting (rec newPts width centers / pt oldZ newArm collected specs used fitWidth kind oldActive)
  (setq pt      (car rec)
        oldZ    (nth 4 rec)
        newArm  (DT--away-from-end-dir newPts pt 0.001)
        collected (DT--transition-center-specs pt centers oldZ width)
        specs   (car collected)
        used    (cadr collected))
  (if newArm (setq specs (DT--add-arm-spec newArm width specs)))
  (setq fitWidth (DT--specs-max-width specs width))
  (if (and newArm (> (length specs) 1))
    (progn
      (setq oldActive (DT--active-elevation)
            *DT_ACTIVE_ELEVATION* oldZ
            kind
              (DT--draw-updated-junction-fitting
                pt
                (DT--arm-spec-rays specs)
                specs
                fitWidth)
            *DT_ACTIVE_ELEVATION* oldActive)
    )
  )
  (list kind fitWidth used)
)

(defun DT--center-slope-along-dir (center pt dir span / sample p1 p2 z1 z2)
  (setq sample (max 0.01 (min 1.0 (/ (max span 0.1) 10.0)))
        p1     (DT--pt+ pt dir sample)
        p2     (DT--pt+ pt dir (- sample))
        z1     (DT--center-elevation-at-point center p1)
        z2     (DT--center-elevation-at-point center p2))
  (/ (- z1 z2) (* 2.0 sample))
)

(defun DT--tangent-rise (run slope)
  (if (and (numberp run) (numberp slope))
    (/ (* run slope) (+ (sqrt (+ 1.0 (* slope slope))) 1.0))
    0.0
  )
)

(defun DT--solve-tangent-slope (delta middleRun transitionRun / sign target lo hi mid value i)
  (if (< (abs delta) 1e-9)
    0.0
    (progn
      (setq sign   (if (< delta 0.0) -1.0 1.0)
            target (abs delta)
            lo     0.0
            hi     (max 1.0 (/ target (max middleRun 0.001))))
      (while (< (+ (* hi middleRun)
                   (DT--tangent-rise transitionRun hi))
                target)
        (setq hi (* hi 2.0))
      )
      (setq i 0)
      (while (< i 60)
        (setq mid   (/ (+ lo hi) 2.0)
              value (+ (* mid middleRun)
                       (DT--tangent-rise transitionRun mid)))
        (if (< value target) (setq lo mid) (setq hi mid))
        (setq i (1+ i))
      )
      (* sign (/ (+ lo hi) 2.0))
    )
  )
)

(defun DT--center-profile-middle-slope (center / pts elevations profile total usable startLineZ endLineZ)
  (setq pts        (g365_get_pts center)
        elevations (DT--center-end-elevations center)
        profile     (DT--center-elevation-profile center)
        total       (DT--route-total-length pts)
        usable      (- total (car profile) (cadr profile))
        startLineZ  (if (numberp (nth 2 profile)) (nth 2 profile) (car elevations))
        endLineZ    (if (numberp (nth 3 profile)) (nth 3 profile) (cadr elevations)))
  (if (> usable 0.000001)
    (/ (- endLineZ startLineZ) usable)
    0.0
  )
)

(defun DT--draw-inline-elevation-fitting
  (rec newCenter newPts width normalGap baseDistance spanOverride
    / pt oldWidth oldZ pairedZ newArm reverseArm maxWidth fitSpan
      useBase shiftDistance shiftPt oldPort newPort kind oldPortZ
      newPortZ insertZ slope oldActive ins)
  (setq pt       (car rec)
        oldWidth (nth 3 rec)
        oldZ     (nth 4 rec)
        pairedZ  (nth 6 rec)
        newArm   (DT--away-from-end-dir newPts pt 0.001)
        maxWidth (max width oldWidth))
  (if newArm
    (progn
      (setq reverseArm   (list (- (car newArm)) (- (cadr newArm)))
            fitSpan      (if (and (numberp spanOverride) (> spanOverride 0.001))
                           spanOverride
                           maxWidth)
            useBase      (if (and (numberp baseDistance) (>= baseDistance 0.0))
                           baseDistance
                           (if (and (numberp normalGap) (> normalGap 0.0))
                             normalGap
                             0.0))
            shiftDistance (+ useBase fitSpan)
            shiftPt      (DT--pt+ pt newArm shiftDistance)
            oldPort      (DT--pt+ shiftPt newArm (- fitSpan))
            newPort      (DT--pt+ shiftPt newArm fitSpan)
            kind         (DT--elevation-fitting-kind newArm reverseArm width oldWidth)
            oldPortZ     (DT--center-elevation-at-point newCenter oldPort)
            newPortZ     (DT--center-elevation-at-point newCenter newPort)
            insertZ      (/ (+ oldPortZ newPortZ) 2.0)
            slope        (DT--center-profile-middle-slope newCenter)
            slope        (if (= (nth 5 rec) 0) slope (- slope))
            oldActive    (DT--active-elevation)
            *DT_ACTIVE_ELEVATION* insertZ)
      (DT--delete-existing-fittings-at shiftPt (DT--layer-fitting) 0.01)
      (setq ins
        (DT--make-elevation-fitting-block-span
          kind width oldWidth shiftPt newArm slope fitSpan))
      (setq *DT_ACTIVE_ELEVATION* oldActive)
      (if ins (DT--mark-elevation-transition ins oldZ pairedZ))
    )
  )
  (list ins shiftPt fitSpan)
)

(defun DT--apply-elevation-transitions
  (newCenter contacts width allCenters
    / rec pt oldCenter oldWidth oldCenters blocks ins count newPieces
      normalResult normalKind normalGap effectiveGap span used center
      elevationResult shiftPt elevationGap newPts transitionRecords
      transitionRecord startBase endBase startSpan endSpan total
      elevations startZ endZ delta provisionalSlope arcP startRun
      endRun middleRun middleSlope startTrim endTrim startLineZ
      endLineZ initialStartBase initialEndBase routeAvailable verticalP
      verticalRun naturalStartRun naturalEndRun naturalRun blockRunBudget
      runWeight extraBase startBlockSpan endBlockSpan baseOverride
      spanOverride)
  (setq newPts (g365_get_pts newCenter))
  (foreach rec contacts
    (setq pt        (car rec)
          oldCenter (cadr rec)
          oldWidth  (nth 3 rec)
          normalResult (DT--draw-transition-normal-fitting rec newPts width allCenters)
          normalKind   (car normalResult)
          normalGap    (cadr normalResult)
          used         (caddr normalResult)
          effectiveGap (if normalKind normalGap 0.0)
          span          (max width oldWidth))
    (setq transitionRecords
      (append transitionRecords
        (list (list rec normalKind normalGap used effectiveGap span))))
    (if (= (nth 5 rec) 0)
      (setq startBase effectiveGap startSpan span)
      (setq endBase effectiveGap endSpan span))
    (if normalKind
      (progn
        (DT--add-plus-cut newCenter pt normalGap)
        (foreach center used
          (DT--add-plus-cut center pt normalGap)
          (if (not (DT--center-in-list-p center oldCenters))
            (setq oldCenters (append oldCenters (list center)))
          )
        )
      )
    )
  )
  (setq initialStartBase (if (numberp startBase) startBase 0.0)
        initialEndBase   (if (numberp endBase) endBase 0.0)
        startBase initialStartBase
        endBase   initialEndBase
        total     (DT--route-total-length newPts)
        elevations (DT--center-end-elevations newCenter)
        startZ    (car elevations)
        endZ      (cadr elevations)
        delta     (- endZ startZ)
        provisionalSlope (/ delta (max 0.001 (- total startBase endBase)))
        arcP      (DT--elevation-arc-required-p provisionalSlope)
        routeAvailable (- total startBase endBase)
        verticalP
          (and arcP
               (numberp startSpan)
               (numberp endSpan)
               (> routeAvailable 0.01)
               (> (abs delta) 0.01)))
  ;; Palet esigini gecen gecislerde iki esnek block arasindaki tava,
  ;; planda ihmal edilebilir bir mesafede gercek 3B dik inis yapar.
  ;; Kalan yatay mesafe iki uca esit dagitilarak mevcut tava ekseni korunur.
  (if verticalP
    (progn
      (setq verticalRun
        (max
          0.002
          (min
            (max 0.01 (* 0.01 (DEG:PLAN-UNIT-SCALE)))
            (* routeAvailable 0.001))))
      (if (>= verticalRun (* routeAvailable 0.25))
        (setq verticalP nil))))
  (if verticalP
    (progn
      (setq naturalStartRun (* 2.0 startSpan)
            naturalEndRun   (* 2.0 endSpan)
            naturalRun      (+ naturalStartRun naturalEndRun)
            blockRunBudget
              (min
                naturalRun
                (* (abs delta) 0.40)
                (- routeAvailable verticalRun)))
      (if (<= blockRunBudget 0.004)
        (setq verticalP nil))))
  (if verticalP
    (progn
      (setq runWeight (+ startSpan endSpan)
            startRun
              (* blockRunBudget
                 (/ startSpan (max runWeight 0.001)))
            endRun      (- blockRunBudget startRun)
            extraBase   (max 0.0
                          (- routeAvailable verticalRun startRun endRun))
            startBase   (+ initialStartBase (/ extraBase 2.0))
            endBase     (+ initialEndBase (/ extraBase 2.0))
            middleRun   verticalRun
            startBlockSpan (/ startRun 2.0)
            endBlockSpan   (/ endRun 2.0)))
    (setq startRun  (if (and arcP startSpan) (* 2.0 startSpan) 0.0)
          endRun    (if (and arcP endSpan) (* 2.0 endSpan) 0.0)
          middleRun (- total startBase endBase startRun endRun)))
  (if (and arcP (> middleRun 0.001))
    (setq middleSlope
      (DT--solve-tangent-slope delta middleRun (+ startRun endRun)))
    (progn
      (setq arcP nil
            startRun 0.0
            endRun 0.0
            middleRun (- total startBase endBase)
            middleSlope (/ delta (max 0.001 middleRun)))
    )
  )
  (setq startTrim  (+ startBase startRun)
        endTrim    (+ endBase endRun)
        startLineZ (+ startZ (DT--tangent-rise startRun middleSlope))
        endLineZ   (- endZ (DT--tangent-rise endRun middleSlope)))
  (DT--set-center-elevation-profile
    newCenter
    startTrim endTrim startLineZ endLineZ)
  (foreach transitionRecord transitionRecords
    (setq rec        (car transitionRecord)
          normalKind (cadr transitionRecord)
          normalGap  (nth 4 transitionRecord)
          baseOverride nil
          spanOverride nil)
    (if verticalP
      (if (= (nth 5 rec) 0)
        (setq baseOverride startBase
              spanOverride startBlockSpan)
        (setq baseOverride endBase
              spanOverride endBlockSpan)))
    (setq elevationResult
      (DT--draw-inline-elevation-fitting
        rec newCenter newPts width normalGap baseOverride spanOverride)
      ins          (car elevationResult)
      shiftPt      (cadr elevationResult)
      elevationGap (caddr elevationResult))
    (if ins
      (progn
        (setq count (1+ (if count count 0))
              blocks (append blocks (list ins)))
        (DT--add-plus-cut newCenter shiftPt elevationGap)
      )
    )
  )
  (foreach oldCenter oldCenters
    (DT--rebuild-center-pieces oldCenter (DT--center-width oldCenter width) nil)
  )
  (if contacts
    (setq newPieces (DT--rebuild-center-pieces newCenter width T))
  )
  (list (if count count 0) newPieces blocks)
)

(defun DT--draw-end-elbow-fitting (pt u v width lay / incoming rec)
  ;; AyrÄ± Ã§izilmiÅŸ iki dik tavada da normal DT kÃ¶ÅŸe bloÄŸunun aynÄ±sÄ±nÄ± kullan.
  (setq incoming (list (- (car u)) (- (cadr u))))
  (setq rec (list 0 pt incoming v width))
  (DT--make-turn-block rec width)
)

(defun DT--poly-area2 (pts / area i n a b)
  (setq area 0.0
        i 0
        n (length pts))
  (while (< i n)
    (setq a (nth i pts)
          b (nth (rem (1+ i) n) pts)
          area (+ area (- (* (car a) (cadr b)) (* (cadr a) (car b)))))
    (setq i (1+ i))
  )
  area
)

(defun DT--same-point-p (a b tol)
  (and a b (<= (distance a b) tol))
)

(defun DT--replace-last-item (lst val / out i n x)
  (setq i 0
        n (length lst))
  (foreach x lst
    (setq out
      (append out
        (list
          (if (= i (1- n)) val x)
        )
      )
    )
    (setq i (1+ i))
  )
  out
)

(defun DT--drop-last-item (lst)
  (reverse (cdr (reverse lst)))
)

(defun DT--shape-add-point (data pt bulge / pts buls)
  (setq pts  (car data)
        buls (cadr data))
  (if (and pts (DT--same-point-p (g365_last pts) pt 1e-8))
    (setq buls (DT--replace-last-item buls bulge))
    (progn
      (setq pts  (append pts (list pt)))
      (setq buls (append buls (list bulge)))
    )
  )
  (list pts buls)
)

(defun DT--fillet-internal-90-corners (pts radius / area orient data n i prev cur next uPrev uNext lenPrev lenNext cross dotv conc trim t1 t2 bulge outPts outBuls)
  (setq area (DT--poly-area2 pts)
        orient (if (< area 0.0) -1.0 1.0)
        data (list nil nil)
        n (length pts)
        i 0)
  (while (< i n)
    (setq prev (nth (if (= i 0) (1- n) (1- i)) pts)
          cur  (nth i pts)
          next (nth (rem (1+ i) n) pts)
          lenPrev (distance prev cur)
          lenNext (distance cur next))
    (if (and (> radius 0.0001) (> lenPrev 0.0001) (> lenNext 0.0001))
      (progn
        (setq uPrev (DT--seg-unit prev cur)
              uNext (DT--seg-unit cur next)
              cross (DT--cross2 uPrev uNext)
              dotv  (g365_dot (car uPrev) (cadr uPrev) (car uNext) (cadr uNext))
              conc  (and (< (* orient cross) -1e-6) (< (abs dotv) 0.001)))
        (if conc
          (progn
            (setq trim (min radius lenPrev lenNext)
                  t1 (DT--pt+ cur uPrev (- trim))
                  t2 (DT--pt+ cur uNext trim)
                  bulge (* 0.414213562373095 (if (< cross 0.0) -1.0 1.0)))
            (setq data (DT--shape-add-point data t1 bulge))
            (setq data (DT--shape-add-point data t2 0.0))
          )
          (setq data (DT--shape-add-point data cur 0.0))
        )
      )
      (setq data (DT--shape-add-point data cur 0.0))
    )
    (setq i (1+ i))
  )
  (setq outPts  (car data)
        outBuls (cadr data))
  (if (and (> (length outPts) 1) (DT--same-point-p (car outPts) (g365_last outPts) 1e-8))
    (progn
      (setq outPts  (DT--drop-last-item outPts))
      (setq outBuls (DT--drop-last-item outBuls))
    )
  )
  (list outPts outBuls)
)
(defun DT--draw-plus-fitting (pt u v width lay / hu hv lu lv p1 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11 p12 outline filleted)
  (setq hu (/ width 2.0)
        hv (/ width 2.0)
        lu width
        lv width)
  ;; Tek kapali + konturu: dort kolu merkezde birlestirir.
  (setq p1  (DT--pt+ (DT--pt+ pt u lu) v hv))
  (setq p2  (DT--pt+ (DT--pt+ pt u lu) v (- hv)))
  (setq p3  (DT--pt+ (DT--pt+ pt v (- hv)) u hu))
  (setq p4  (DT--pt+ (DT--pt+ pt v (- lv)) u hu))
  (setq p5  (DT--pt+ (DT--pt+ pt v (- lv)) u (- hu)))
  (setq p6  (DT--pt+ (DT--pt+ pt v (- hv)) u (- hu)))
  (setq p7  (DT--pt+ (DT--pt+ pt u (- lu)) v (- hv)))
  (setq p8  (DT--pt+ (DT--pt+ pt u (- lu)) v hv))
  (setq p9  (DT--pt+ (DT--pt+ pt v hv) u (- hu)))
  (setq p10 (DT--pt+ (DT--pt+ pt v lv) u (- hu)))
  (setq p11 (DT--pt+ (DT--pt+ pt v lv) u hu))
  (setq p12 (DT--pt+ (DT--pt+ pt v hv) u hu))
  (setq outline (list p1 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11 p12))
  (setq filleted (DT--fillet-internal-90-corners outline (/ width 2.0)))
  (DT--make-fitting-block
    (strcat "art" (chr 253)) width pt
    (list
      (list (car filleted) T (cadr filleted)
        (list
          (DT--pt+ pt u lu) (DT--pt+ pt u (- lu))
          (DT--pt+ pt v lv) (DT--pt+ pt v (- lv)))))
    (DT--vec-angle u) (DT--mirror-for u v))
)
(defun DT--draw-t-fitting (pt main branch width lay / h lm lb p1 p2 p3 p4 p5 p6 p7 p8 outline filleted)
  (setq h  (/ width 2.0)
        lm width
        lb width)
  ;; Tek kapali T konturu: ana hat iki yon, dal bir yon.
  (setq p1 (DT--pt+ (DT--pt+ pt main lm) branch h))
  (setq p2 (DT--pt+ (DT--pt+ pt main h) branch h))
  (setq p3 (DT--pt+ (DT--pt+ pt main h) branch lb))
  (setq p4 (DT--pt+ (DT--pt+ pt main (- h)) branch lb))
  (setq p5 (DT--pt+ (DT--pt+ pt main (- h)) branch h))
  (setq p6 (DT--pt+ (DT--pt+ pt main (- lm)) branch h))
  (setq p7 (DT--pt+ (DT--pt+ pt main (- lm)) branch (- h)))
  (setq p8 (DT--pt+ (DT--pt+ pt main lm) branch (- h)))
  (setq outline (list p1 p2 p3 p4 p5 p6 p7 p8))
  (setq filleted (DT--fillet-internal-90-corners outline (/ width 2.0)))
  (DT--make-fitting-block
    "T" width pt
    (list
      (list (car filleted) T (cadr filleted)
        (list
          (DT--pt+ pt main lm) (DT--pt+ pt main (- lm))
          (DT--pt+ pt branch lb))))
    (DT--vec-angle main) (DT--mirror-for main branch))
)
(defun DT--place-network-fittings (newPts oldEnts width / hits rec pt oldCenter oldPts fitWidth adjustedNewPts newArms oldInfos oldArms armSpecs forcedTSpecs allArms kind skipJunction records doneT doneP doneF doneE tCount pCount fCount eCount self rec2 axes tb selfArms plusRecords teeRecords flexRecords elbowRecords)
  (setq hits (DT--collect-cross-hits newPts oldEnts width)
        doneT nil doneP nil doneF nil doneE nil
        tCount 0 pCount 0 fCount 0 eCount 0
        plusRecords nil teeRecords nil flexRecords nil elbowRecords nil)
  (foreach rec hits
    (setq pt             (car rec)
          oldCenter      (cadr rec)
          oldPts         (caddr rec)
          adjustedNewPts (if (nth 3 rec) (nth 3 rec) newPts))
    (setq newArms  (DT--arms-at-point adjustedNewPts pt 0.001))
    (setq oldInfos (DT--junction-old-infos pt oldEnts oldCenter oldPts width 0.001 newArms))
    (setq oldArms  (DT--infos-arms oldInfos))
    (setq forcedTSpecs
      (DT--forced-through-tee-specs
        pt adjustedNewPts oldCenter oldPts width))
    (setq armSpecs
      (if forcedTSpecs
        forcedTSpecs
        (DT--infos-arm-specs newArms width oldInfos)))
    (setq allArms  (DT--arm-spec-rays armSpecs))
    (setq fitWidth (DT--specs-max-width armSpecs width))
    (setq skipJunction
      (and (not forcedTSpecs)
           oldArms
           (or
             (DT--endpoint-continuation-p pt adjustedNewPts oldArms)
             (DT--internal-corner-continuation-p pt adjustedNewPts oldArms)
             (DT--internal-90-corner-p pt adjustedNewPts 0.001))
           (not (DT--live-fitting-at-point-p pt fitWidth))))
    (setq kind
      (if skipJunction
        nil
        (if (and forcedTSpecs (setq tb (DT--t-axis-branch allArms)))
          (progn
            (DT--delete-existing-fittings-at
              pt (DT--layer-fitting) (+ fitWidth 1.0))
            (DT--draw-t-fitting
              pt (car tb) (cadr tb) fitWidth (DT--layer-fitting))
            'TEE)
          (DT--draw-updated-junction-fitting
            pt allArms armSpecs fitWidth))
      )
    )
    (cond
      ((= kind 'PLUS)
        (if (not (DT--point-known-p pt doneP 0.001))
          (progn
            (setq doneP (cons pt doneP) pCount (1+ pCount))
            (setq plusRecords (append plusRecords (DT--junction-records pt oldInfos adjustedNewPts fitWidth)))
          )
        ))
      ((= kind 'TEE)
        (if (not (DT--point-known-p pt doneT 0.001))
          (progn
            (setq doneT (cons pt doneT) tCount (1+ tCount))
            (setq teeRecords (append teeRecords (DT--junction-records pt oldInfos adjustedNewPts fitWidth)))
          )
        ))
      ((= kind 'ELBOW)
        (if (not (DT--point-known-p pt doneE 0.001))
          (progn
            (setq doneE (cons pt doneE) eCount (1+ eCount))
            (setq elbowRecords (append elbowRecords (DT--junction-records pt oldInfos adjustedNewPts fitWidth)))
          )
        ))
      ((= kind 'FLEX)
        (if (not (DT--point-known-p pt doneF 0.001))
          (progn
            (setq doneF (cons pt doneF) fCount (1+ fCount))
            (setq flexRecords (append flexRecords (DT--junction-records pt oldInfos adjustedNewPts fitWidth)))
          )
        ))
    )
  )
  (setq self (DT--collect-self-hits newPts))
  (foreach rec2 self
    (setq pt       (car rec2)
          selfArms (DT--arms-at-point newPts pt 0.001)
          axes     (DT--four-way-axes selfArms)
          tb       (DT--t-axis-branch selfArms))
    (cond
      (axes
        (if (not (DT--point-known-p pt doneP 0.001))
          (progn
            (DT--delete-existing-fittings-at pt (DT--layer-fitting) (+ width 1.0))
            (DT--draw-plus-fitting pt (car axes) (cadr axes) width (DT--layer-fitting))
            (setq doneP (cons pt doneP) pCount (1+ pCount))))
        (setq plusRecords
          (append plusRecords (list (list pt nil nil nil width nil)))))
      (tb
        (if (not (DT--point-known-p pt doneT 0.001))
          (progn
            (DT--delete-existing-fittings-at pt (DT--layer-fitting) (+ width 1.0))
            (DT--draw-t-fitting pt (car tb) (cadr tb) width (DT--layer-fitting))
            (setq doneT (cons pt doneT)
                  tCount (1+ tCount)
                  teeRecords
                    (append teeRecords
                      (list (list pt nil newPts nil width nil))))))))
  )
  (list tCount pCount plusRecords teeRecords fCount flexRecords eCount elbowRecords)
)
(defun DT--nominal-width (v / allowed hit item)
  (setq allowed '(10.0 20.0 30.0 40.0 50.0))
  (if (numberp v)
    (foreach item allowed
      (if (equal (float v) item 0.000001) (setq hit item))
    )
  )
  hit
)

(defun DT--parse-width (s / v)
  (if s
    (progn
      (setq v (distof s 2))
      (if (or (null v) (<= v 0.0))
        (setq v (atof (vl-string-translate "," "." s)))
      )
      (DT--nominal-width v)
    )
  )
)

(defun DT--plan-width (nominalWidth)
  (if (and (numberp nominalWidth) (> nominalWidth 0.0))
    (* nominalWidth (DEG:PLAN-UNIT-SCALE))
  )
)

(defun DT--plan-side-height (sideHeightMm / scale)
  (if (and (numberp sideHeightMm) (> sideHeightMm 0.0))
    (progn
      (setq scale (DEG:PLAN-UNIT-SCALE))
      (if (<= scale 0.0) (setq scale 1.0))
      (* sideHeightMm (/ scale 10.0)))
    0.0
  )
)

(defun DT--plan-material-thickness (/ scale)
  ;; One physical centimetre in the active PLAN unit convention.
  (setq scale (DEG:PLAN-UNIT-SCALE))
  (if (> scale 0.0) scale 1.0)
)

(defun DT--nominal-from-plan-width (planWidth / scale)
  (setq scale (DEG:PLAN-UNIT-SCALE))
  (if (<= scale 0.0) (setq scale 1.0))
  (/ (float planWidth) scale)
)

(defun DT--last-width (/ s v)
  (setq s (getenv "DEG_DT_LAST_WIDTH"))
  (setq v (DT--parse-width s))
  (if v v 10.0)
)

(defun DT--remember-width (width)
  (if (and (numberp width) (> width 0.0))
    (progn
      (setq *DT_LAST_WIDTH* width)
      (setenv "DEG_DT_LAST_WIDTH" (rtos width 2 12))
    )
  )
  width
)

(defun DT--last-elevation-angle (/ value)
  (setq value
    (atof
      (if (getenv "DEG_DT_ELEVATION_ANGLE")
        (getenv "DEG_DT_ELEVATION_ANGLE")
        "")))
  (if (and (> value 0.0) (<= value 90.0)) value 45.0)
)

(defun DT--remember-elevation-angle (value)
  (if (and (numberp value) (> value 0.0) (<= value 90.0))
    (setenv "DEG_DT_ELEVATION_ANGLE" (rtos value 2 6)))
  value
)

(defun DT--active-elevation-angle ()
  (if (and (boundp '*DT_ACTIVE_ELEVATION_ANGLE*)
           (numberp *DT_ACTIVE_ELEVATION_ANGLE*)
           (> *DT_ACTIVE_ELEVATION_ANGLE* 0.0)
           (<= *DT_ACTIVE_ELEVATION_ANGLE* 90.0))
    *DT_ACTIVE_ELEVATION_ANGLE*
    (DT--last-elevation-angle))
)

(defun DT--meta-app () "DT_TRAY_META")

(defun DT--3d-mode-app () "DT_TRAY_3D")

(defun DT--entity-3d-mode-value (ent / app ed xd rec item value)
  (setq app (DT--3d-mode-app))
  (if (and ent (entget ent) (tblsearch "APPID" app))
    (progn
      (setq ed  (entget ent (list app))
            xd  (assoc -3 ed)
            rec (if xd (cadr xd) nil))
      (if (and rec (= (car rec) app))
        (foreach item (cdr rec)
          (if (= (car item) 1070)
            (setq value (if (= (cdr item) 0) "0" "1")))))))
  value
)

(defun DT--entity-3d-enabled-p (ent / value center)
  (setq value (DT--entity-3d-mode-value ent))
  (if (null value)
    (progn
      (if (and ent (DT--visible-tray-p ent))
        (setq center (DT--center-for-tray ent)))
      (if center (setq value (DT--entity-3d-mode-value center)))))
  ;; Legacy DT geometry predates this flag and is therefore 3D.
  (if (= value "0") nil T)
)

(defun DT--set-entity-3d-mode (ent enabled / app ed payload)
  (setq app (DT--3d-mode-app))
  (if (not (tblsearch "APPID" app)) (regapp app))
  (if (and ent (setq ed (entget ent '("*"))))
    (progn
      (setq payload
        (list app (cons 1070 (if enabled 1 0))))
      (setq ed (DT--xdata-set-app ed app payload))
      (entmod ed)
      (entupd ent)
      ent))
)

(defun DT--set-tray-3d-mode (center pieces turnBlocks enabled / ent)
  (DT--set-entity-3d-mode center enabled)
  (foreach ent pieces
    (DT--set-entity-3d-mode ent enabled)
    (if (and ent (DT--visible-tray-p ent))
      (DT--light-migrate-tray ent)))
  (foreach ent turnBlocks (DT--set-entity-3d-mode ent enabled))
  center
)

(defun DT--tray-meta (ent / app ed xd rec item mode nominal sideHeight trayHeight)
  (setq app (DT--meta-app))
  (if (and ent (entget ent))
    (progn
      (setq ed (entget ent (list app))
            xd (assoc -3 ed)
            rec (if xd (cadr xd) nil))
      (if (and rec (= (car rec) app))
        (foreach item (cdr rec)
          (cond
            ((= (car item) 1000)
              (if mode
                (setq trayHeight (cdr item))
                (setq mode (cdr item))))
            ((= (car item) 1040)
              (if nominal
                (setq sideHeight (cdr item))
                (setq nominal (cdr item))))
          )
        )
      )
    )
  )
  (if (or mode nominal sideHeight trayHeight)
    (list mode nominal sideHeight (if trayHeight trayHeight ""))
  )
)

(defun DT--set-tray-meta-one (ent mode nominal sideHeight trayHeight / app ed payload)
  (setq app (DT--meta-app))
  (if (not (tblsearch "APPID" app)) (regapp app))
  (if (and ent (entget ent))
    (progn
      (setq payload
        (list
          app
          (cons 1000 (DT--normalize-mode mode))
          (cons 1040 (float nominal))
          (cons 1040 (float sideHeight))
          (cons 1000 (if trayHeight trayHeight ""))))
      (setq ed (entget ent '("*")))
      (setq ed (DT--xdata-set-app ed app payload))
      (entmod ed)
      (entupd ent)
    )
  )
  ent
)

(defun DT--set-entity-layer-only (ent lay / ed pair)
  (if (and ent lay (setq ed (entget ent)))
    (progn
      (setq pair (assoc 8 ed)
            ed   (if pair
                   (subst (cons 8 lay) pair ed)
                   (append ed (list (cons 8 lay)))))
      (entmod ed)
      (entupd ent)
      ent)
  )
)

(defun DT--set-tray-meta (center pieces turnBlocks mode nominal sideHeight trayHeight / ent)
  (DT--set-tray-meta-one center mode nominal sideHeight trayHeight)
  (foreach ent pieces
    (DT--set-tray-meta-one ent mode nominal sideHeight trayHeight)
  )
  (foreach ent turnBlocks
    (DT--set-tray-meta-one ent mode nominal sideHeight trayHeight)
  )
  center
)

(defun DT--tray-piece-override-p (tray / app ed)
  (setq app "DT_TRAY_PIECE_OVERRIDE")
  (and tray
       (tblsearch "APPID" app)
       (setq ed (entget tray (list app)))
       (assoc -3 ed))
)

(defun DT--set-tray-piece-override (tray / app ed payload)
  (setq app "DT_TRAY_PIECE_OVERRIDE")
  (if (not (tblsearch "APPID" app)) (regapp app))
  (if (and tray (setq ed (entget tray '("*"))))
    (progn
      (setq payload (list app (cons 1070 1))
            ed      (DT--xdata-set-app ed app payload))
      (entmod ed)
      (entupd tray)
      tray))
)

(defun DT--tray-meta-effective (tray / trayMeta center centerMeta)
  (setq trayMeta (DT--tray-meta tray)
        center   (DT--center-for-tray tray)
        centerMeta (if center (DT--tray-meta center)))
  ;; The center route is authoritative. A legacy lightweight migration may
  ;; have persisted the total elevation delta as the tray side height. A tray
  ;; edited alone from the palette keeps its own explicit metadata.
  (if (and trayMeta (DT--tray-piece-override-p tray))
    trayMeta
    (if centerMeta centerMeta trayMeta))
)

(defun DT--string-add-unique-ci (value values / u hit item)
  (setq value (vl-string-trim " \t\r\n" (if value value ""))
        u     (strcase value))
  (if (/= value "")
    (progn
      (foreach item values
        (if (= u (strcase item)) (setq hit T))
      )
      (if (not hit) (append values (list value)) values)
    )
    values
  )
)

(defun DT--plan-height-values (/ ss i ent meta height values)
  (setq ss (ssget "_X" (list (cons 0 "LWPOLYLINE,POLYLINE") (cons 8 (DT--layer-center)))))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent    (ssname ss i)
              meta   (DT--tray-meta ent)
              height (if meta (nth 3 meta) nil)
              values (DT--string-add-unique-ci height values)
              i      (1+ i))
      )
    )
  )
  (if values (acad_strlsort values) nil)
)

(defun DT--panel-widths () '(10.0 20.0 30.0 40.0 50.0))

(defun DT--panel-side-values (/ nominal value values)
  (foreach nominal (DT--panel-widths)
    (setq value  (DEG:NUM->STR (DTT--side-height-mm nominal))
          values (DT--string-add-unique-ci value values))
  )
  (if values (acad_strlsort values) '("40" "50"))
)

(defun DT--last-side-height (nominal / value)
  (setq value (atof (if (getenv "DEG_DT_LAST_SIDE_HEIGHT") (getenv "DEG_DT_LAST_SIDE_HEIGHT") "")))
  (if (> value 0.0) value (DTT--side-height-mm nominal))
)

(defun DT--remember-side-height (value)
  (if (and (numberp value) (> value 0.0))
    (setenv "DEG_DT_LAST_SIDE_HEIGHT" (rtos value 2 8))
  )
  value
)

(defun DT--last-tray-height ()
  (if (getenv "DEG_DT_LAST_TRAY_HEIGHT") (getenv "DEG_DT_LAST_TRAY_HEIGHT") "")
)

(defun DT--remember-tray-height (value)
  (setq value (vl-string-trim " \t\r\n" (if value value "")))
  (setenv "DEG_DT_LAST_TRAY_HEIGHT" value)
  value
)

(defun DT--last-ladder-bottom ()
  (if (getenv "DEG_DT_LAST_LADDER_BOTTOM")
    (getenv "DEG_DT_LAST_LADDER_BOTTOM")
    "0")
)

(defun DT--remember-ladder-bottom (value)
  (setq value (vl-string-trim " \t\r\n" (if value value "")))
  (setenv "DEG_DT_LAST_LADDER_BOTTOM" value)
  value
)

(defun DT--last-3d-enabled (/ value)
  (setq value (getenv "DEG_DT_LAST_3D"))
  (if (null value)
    T
    (/= value "0")
  )
)

(defun DT--remember-3d-enabled (enabled)
  (setenv "DEG_DT_LAST_3D" (if enabled "1" "0"))
  (if enabled T nil)
)

(defun DT--palette-process-id (/ value)
  (setq value (vl-catch-all-apply 'getvar (list "PROCESSID")))
  (if (and (not (vl-catch-all-error-p value)) (numberp value))
    (fix value)
