(defun DO_DCL_ORIG (/ dclFn dclId page rc)
  (vl-catch-all-apply 'vl-load-com '())
  (setq dclFn (DEGDO--write-dcl))
  (if (null dclFn)
    (princ "\nDO: DCL dosyasi olusturulamadi.")
    (progn
      (setq dclId (load_dialog dclFn))
      (if (or (null dclId) (< dclId 0))
        (princ "\nDO: Dialog yuklenemedi.")
        (progn
          (setq page "do_plan")
          (while page
            (setq *DEGDO_NEXT* nil)
            (if (not (new_dialog page dclId))
              (setq page nil)
              (progn
                (DEGDO--prepare-page page)
                (setq rc (start_dialog))
                (cond
                  ((= rc 2) (setq page *DEGDO_NEXT*))
                  ((= rc 3) (c:DO_DN_CLEAR_SIRA) (setq page "do_dn"))
                  (T        (setq page nil))
                )
              )
            )
          )
          (unload_dialog dclId)
        )
      )
    )
  )
  (princ)
)

(defun DEGDO--win-quote (value)
  (strcat "\"" (if value value "") "\"")
)

(defun DEGDO--win-vbs-string (value / index char out)
  (setq index 1
        out "")
  (repeat (strlen value)
    (setq char (substr value index 1)
          out  (strcat out (if (= char "\"") "\"\"" char))
          index (1+ index)))
  out
)

(defun DEGDO--win-run-hidden (executable arguments / launcher file commandLine result)
  ;; WScript dis surecte calisir: PowerShell konsolu gorunmez ve CAD icinde
  ;; WScript.Shell COM nesnesi acilmadigi icin GstarCAD erisim ihlali riski yoktur.
  (setq launcher
    (DEG:RUNTIME-FILE
      (strcat
        "deg_hidden_"
        (itoa (DEGDO--win-process-id))
        "_"
        (itoa (getvar "MILLISECS"))
        ".vbs"))
    commandLine (strcat (DEGDO--win-quote executable) " " arguments)
    file (open launcher "w"))
  (if file
    (progn
      (write-line "On Error Resume Next" file)
      (write-line "Dim shell, fso" file)
      (write-line "Set shell = CreateObject(\"WScript.Shell\")" file)
      (write-line
        (strcat "shell.Run \"" (DEGDO--win-vbs-string commandLine) "\", 0, False")
        file)
      (write-line "Set fso = CreateObject(\"Scripting.FileSystemObject\")" file)
      (write-line "fso.DeleteFile WScript.ScriptFullName, True" file)
      (close file)
      (setq result
        (vl-catch-all-apply
          'startapp
          (list "wscript.exe" (DEGDO--win-quote launcher))))
      (if (or (vl-catch-all-error-p result) (null result))
        (progn
          (vl-catch-all-apply 'vl-file-delete (list launcher))
          nil)
        T))
    nil)
)

(defun DEGDO--win-script-path (/ self dir found path)
  (setq self (DEG:SELF-FILE))
  (if self
    (progn
      (setq dir (vl-filename-directory self))
      (if dir
        (setq found (findfile (strcat dir "\\DG_WINDOWS_UI.ps1"))))))
  (if (not found)
    (setq found (findfile "DG_WINDOWS_UI.ps1")))
  (if (not found)
    (progn
      (setq path (strcat (getenv "USERPROFILE") "\\Documents\\metraj\\DEG\\DG_WINDOWS_UI.ps1"))
      (if (findfile path) (setq found path))))
  found
)

(defun DEGDO--win-process-id (/ value)
  (setq value (vl-catch-all-apply 'getvar (list "PROCESSID")))
  (if (and (not (vl-catch-all-error-p value)) (numberp value))
    (fix value)
    0
  )
)

(defun DEGDO--win-window-handle (/ value)
  ;; ActiveX cagirmadan CAD ana pencere kimligini al.
  (setq value (vl-catch-all-apply 'getvar (list "HWND")))
  (if (and value (not (vl-catch-all-error-p value)) (numberp value))
    (fix value)
    0
  )
)

(defun DEGDO--win-id-text (value)
  (cond
    ((= (type value) 'INT) (itoa value))
    ((= (type value) 'REAL) (rtos value 2 0))
    (T "0"))
)

(defun DEGDO--win-state-path (/ pid hwnd key)
  (setq pid (DEGDO--win-process-id)
        hwnd (if (> pid 0) 0 (DEGDO--win-window-handle))
        key (if (> pid 0) pid hwnd))
  (DEG:RUNTIME-FILE
    (strcat "deg_do_windows_" (DEGDO--win-id-text key) ".tsv"))
)

