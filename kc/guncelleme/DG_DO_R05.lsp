(defun DEGDO--text-style-names (/ rec name out)
  (setq rec (tblnext "STYLE" T)
        out nil)
  (while rec
    (setq name (cdr (assoc 2 rec)))
    (if (and name (/= (vl-string-trim " \t\r\n" name) ""))
      (setq out (cons name out))
    )
    (setq rec (tblnext "STYLE"))
  )
  (if (not (vl-some '(lambda (x) (= (strcase x) "STANDARD")) out))
    (setq out (cons "Standard" out))
  )
  (acad_strlsort out)
)

(defun DEGDO--string-index-ci (value items / target i found)
  (setq target (strcase (if value value ""))
        i 0)
  (while (and items (null found))
    (if (= target (strcase (car items)))
      (setq found i)
      (setq i (1+ i)
            items (cdr items))
    )
  )
  found
)

