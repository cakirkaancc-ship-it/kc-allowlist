(defun DEGQ:_set-chain-polylines-white (chain / polyE obj)
  (foreach polyE chain
    (if (and polyE (setq obj (vl-catch-all-apply 'vlax-ename->vla-object (list polyE))))
      (if (not (vl-catch-all-error-p obj))
        (if (vlax-property-available-p obj 'Color)
          nil
        )
      )
    )
  )
)
(defun DEGQ:_cctv-layer-name-p (layer / layU key)
  (if layer
    (progn
      (setq layU (strcase layer)
            key  (DEG:VAL 'D6))
      (or (DEG:LAYER-IN-CODES? layU '(D1 D2 D3 D4))
          (wcmatch layU (DEG:VAL 'D5))
          (and key
               (/= (vl-string-trim " \t\r\n" key) "")
               (vl-string-search (strcase key) layU))
      )
    )
  )
)

(defun DEGQ:_is-cctv-layer (e / o lyr)
  (if (and e (= (type e) 'ENAME))
    (progn
      (setq o (vl-catch-all-apply 'vlax-ename->vla-object (list e)))
      (if (vl-catch-all-error-p o)
        nil
        (progn
          (setq lyr (vla-get-Layer o))
          (DEGQ:_cctv-layer-name-p lyr)
        )
      )
    )
    nil
  )
)

(defun DEGQ:_filter-chain-cctv (lst / out e)
  (setq out nil)
  (foreach e lst
    (if (DEGQ:_is-cctv-layer e)
      (setq out (cons e out))
    )
  )
  (reverse out)
)

(defun DEGQ:_POLY-TOUCHES-ANY_SELECTED-BLOCK? (pl blkList)
  nil
)



(defun DEGQ:_contains-ci (s sub)
  (if (and s sub)
    (not (null (vl-string-search (strcase sub) (strcase s))))
    nil
  )
)

(defun DEGQ:_blk-effective-name-safe (b / nm)
  (setq nm nil)
  (if (and b (= (type b) 'VLA-OBJECT))
    (progn
      (setq nm (vl-catch-all-apply 'vla-get-EffectiveName (list b)))
      (if (vl-catch-all-error-p nm) (setq nm nil))
      (if (null nm)
        (progn
          (setq nm (vl-catch-all-apply 'vla-get-Name (list b)))
          (if (vl-catch-all-error-p nm) (setq nm nil))
        )
      )
    )
  )
  (if nm (strcase nm) "")
)


(defun DEGQ:_is-klemens-terminal (bo / nm)
  (setq nm (DEGQ:_blk-effective-name-safe bo))
  (or (DEGQ:_contains-ci nm (DEG:VAL 'L1))
      (DEGQ:_contains-ci nm (DEG:VAL 'L2)))
)

(defun DEGQ:_move-klemens-terminal (blkList / acad doc lays b bo nm layName layObj wasLocked)
  (setq acad (vlax-get-acad-object)
        doc  (vla-get-ActiveDocument acad)
        lays (vla-get-Layers doc)
  )

  (foreach b blkList
    (setq bo b)
    (if (and bo (= (type bo) 'ENAME))
      (setq bo (vlax-ename->vla-object bo))
    )
    (if (and (vlax-objectp bo)
             (= (strcase (vla-get-ObjectName bo)) "ACDBBLOCKREFERENCE"))
      (progn
        (setq nm (DEGQ:_blk-effective-name-safe bo))
        (if (or (DEGQ:_contains-ci nm (DEG:VAL 'L1))
                (DEGQ:_contains-ci nm (DEG:VAL 'L2)))
          (progn
            (setq layName (vla-get-Layer bo))
            (setq layObj nil
                  wasLocked nil
            )
            (if (and layName (/= layName ""))
              (progn
                (setq layObj (vl-catch-all-apply 'vla-item (list lays layName)))
                (if (not (vl-catch-all-error-p layObj))
                  (progn
                    (setq wasLocked (vla-get-Lock layObj))
                    (if (= wasLocked :vlax-true)
                      (vla-put-Lock layObj :vlax-false)
                    )
                  )
                  (setq layObj nil)
                )
              )
            )

            (vl-catch-all-apply 'vla-Move
              (list bo (vlax-3d-point '(0 0 0)) (vlax-3d-point '(0 5.25 0)))
            )

            (if (and layObj wasLocked (= wasLocked :vlax-true))
              (vla-put-Lock layObj :vlax-true)
            )
          )
        )
      )
    )
  )
  (princ)
)

