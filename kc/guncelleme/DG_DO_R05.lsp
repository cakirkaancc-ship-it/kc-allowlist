(defun KC:CheckDeviceLicense (code / script state resultPath logPath cmd runResult result file)
  (setq script (DEGDO--win-script-path)
        state
          (DEG:RUNTIME-FILE
            (strcat "kc_license_check_" (KC:ProcessToken) ".txt"))
        resultPath (strcat state ".result")
        logPath    (strcat state ".log"))
  (foreach file (list state resultPath logPath)
    (if (KC:FileExists file) (vl-file-delete file)))
  (if (and script code)
    (progn
      (setq cmd
        (strcat
          "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \""
          script
          "\" -Mode LicenseCheck -StatePath \""
          state
          "\" -DeviceCode \""
          code
          "\" -LicenseMarkerBaseUrl \""
          *KC_LICENSE_MARKER_BASE_URL*
          "\" -LicenseGrantPath \""
          (KC:LicenseGrantFile)
          "\" -LicenseOverridePath \""
          (KC:SessionOverrideFile)
          "\" -LicenseGrantHours 24"))
      (setq runResult (vl-catch-all-apply 'KC:RunHidden (list cmd T)))
      (if (and (not (vl-catch-all-error-p runResult))
               (KC:FileExists resultPath))
        (setq result (KC:Trim (KC:ReadFirstLine resultPath)))
        (setq result
          (if (vl-catch-all-error-p runResult)
            "FAILED|POWERSHELL_START"
            "FAILED|RESULT_MISSING")))
      (foreach file (list state resultPath)
        (if (KC:FileExists file) (vl-file-delete file)))
      (if (and (KC:FileExists logPath)
               result
               (wcmatch (strcase result) "OK|*"))
        (vl-file-delete logPath))
      result)
    "FAILED|UI_SCRIPT_NOT_FOUND")
)

