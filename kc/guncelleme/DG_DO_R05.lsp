;; ---------------------------------------------------------------------------
;; DT lightweight composites
;;
;; A legacy tray contains roughly 28 model-space entities and a ladder can
;; contain hundreds. AutoCAD GROUP selection expands every member into the
;; pickset. The lightweight representation keeps one editable controller plus
;; one visual block reference, so normal window selection, MOVE, COPY, ERASE
;; and DT commands stay proportional to logical object count.
;; ---------------------------------------------------------------------------

(defun DT--light-app-present-p (ent app / ed)
  (and ent
       app
       (setq ed (entget ent (list app)))
       (assoc -3 ed))
)

(defun DT--light-linked-entity (ent app / ed xd rec item linked)
  (if (and ent app (setq ed (entget ent (list app))))
    (progn
      (setq xd  (assoc -3 ed)
            rec (if xd (cadr xd) nil))
      (if (and rec (= (car rec) app))
        (foreach item (cdr rec)
          (if (and (= (car item) 1005) (null linked))
            (setq linked (handent (cdr item))))))
    )
  )
  (if (DT--entity-alive-p linked) linked)
)

(defun DT--light-set-link (ent app linked / ed payload handle)
  (if (not (tblsearch "APPID" app)) (regapp app))
  (if (and ent (entget ent))
    (progn
      (setq handle (if linked (DT--ent-handle linked))
            payload (if handle (list app (cons 1005 handle)) (list app))
            ed      (entget ent '("*"))
            ed      (DT--xdata-set-app ed app payload))
      (entmod ed)
      (entupd ent)))
  ent
)

(defun DT--light-clear-app (ent app / ed)
  (if (and ent (setq ed (entget ent '("*"))))
    (progn
      (entmod (DT--xdata-remove-app ed app))
      (entupd ent)))
  ent
)

(defun DT--light-tray-visual (tray)
  (DT--light-linked-entity tray "DT_TRAY_VISUAL")
)

(defun DT--light-tray-visual-p (ent)
  (DT--light-app-present-p ent "DT_TRAY_VISUAL_MEMBER")
)

(defun DT--light-tray-visual-owner (visual)
  (DT--light-linked-entity visual "DT_TRAY_VISUAL_MEMBER")
)

(defun DT--light-tray-frame
  (tray / pts p0 p1 p2 p3 start finish z0 z1 len width rotation dz half local)
  (setq pts (DT--tray-corner-points-3d tray))
  (if (= (length pts) 4)
    (progn
      (setq p0     (nth 0 pts)
            p1     (nth 1 pts)
            p2     (nth 2 pts)
            p3     (nth 3 pts)
            start  (list
                     (/ (+ (car p0) (car p3)) 2.0)
                     (/ (+ (cadr p0) (cadr p3)) 2.0)
                     (/ (+ (if (caddr p0) (caddr p0) 0.0)
                           (if (caddr p3) (caddr p3) 0.0)) 2.0))
            finish (list
                     (/ (+ (car p1) (car p2)) 2.0)
                     (/ (+ (cadr p1) (cadr p2)) 2.0)
                     (/ (+ (if (caddr p1) (caddr p1) 0.0)
                           (if (caddr p2) (caddr p2) 0.0)) 2.0))
            z0     (caddr start)
            z1     (caddr finish)
            len    (DT--distance-xy start finish)
            width  (distance p0 p3)
            rotation (angle start finish)
            dz     (- z1 z0)
            half   (/ width 2.0)
            local  (list
                     (list 0.0 half 0.0)
                     (list len half dz)
                     (list len (- half) dz)
                     (list 0.0 (- half) 0.0)))
      (if (and (> len 0.000001) (> width 0.000001))
        (list start rotation len width dz local)))
  )
)

(defun DT--light-tray-block-name (tray frame mode sidePlan / token)
  (setq token
    (strcat
      (DT--name-safe (DT--normalize-mode mode))
      "$LAY" (DT--name-safe
               (DT--base-layer-name (cdr (assoc 8 (entget tray)))))
      "$W"  (DT--width-name (nth 3 frame))
      "$L"  (DT--width-name (nth 2 frame))
      "$DZ" (DT--width-name (nth 4 frame))
      "$H"  (DT--width-name sidePlan)
      (if (DT--entity-3d-enabled-p tray) "$D3" "$D2")
      (DT--shell-style-token)))
  (strcat "DT$TAVAHAFIF$SH4$" token)
)

(defun DT--light-block-token-number (name startToken endToken / start finish token)
  (if name
    (progn
      (setq start (vl-string-search startToken name))
      (if start
        (setq finish
          (vl-string-search endToken name (+ start (strlen startToken)))))
      (if (and start finish (> finish (+ start (strlen startToken))))
        (progn
          (setq token
            (substr
              name
              (+ start (strlen startToken) 1)
              (- finish (+ start (strlen startToken)))))
          (atof (vl-string-translate "_m" ".-" token))))))
)

(defun DT--light-legacy-bad-side-meta-p
  (tray frame meta / visual name expectedPlan visualPlan)
  (setq visual (DT--light-tray-visual tray)
        name   (if (and visual (assoc 2 (entget visual)))
                 (strcase (cdr (assoc 2 (entget visual)))))
        expectedPlan
          (if (and meta (numberp (caddr meta)) (> (caddr meta) 0.0))
            (DT--plan-side-height (caddr meta))
            0.0)
        visualPlan (DT--light-block-token-number name "$H" "$T"))
  ;; SH2 could retain a visual built with the total elevation delta even after
  ;; its center/tray metadata was repaired. Compare the block's H token with
  ;; the authoritative metadata and rebuild only the mismatching legacy tray.
  (and frame
       name
       (wcmatch name "DT$TAVAHAFIF$SH2$*")
       (numberp visualPlan)
       (> expectedPlan 0.0)
       (not (equal visualPlan expectedPlan 0.000001)))
)

(defun DT--light-create-tray-block-def
  (name frame / local pts boundary hatch made
    *DT_BLOCK_FACE_UNASSOC* *DT_BLOCK_HATCH_ASSOC_MARKER*)
  (setq pts (nth 5 frame)
        ;; AutoCAD can access-violate while associating a hatch to a 3DFACE
        ;; inside an existing drawing's new block definition. The visual block
        ;; is rebuilt when its controller stretches, so all internal hatches
        ;; can be safely non-associative and still follow every tray edit.
        *DT_BLOCK_FACE_UNASSOC* T
        *DT_BLOCK_HATCH_ASSOC_MARKER* (<= (abs (nth 4 frame)) 0.000001))
  (if (and name pts (not (tblsearch "BLOCK" name)))
    (progn
      (entmake
        (list
          '(0 . "BLOCK")
          (cons 2 name)
          '(70 . 0)
          '(10 0.0 0.0 0.0)))
      (setq boundary (DT--make-poly3d (DT--layer-linework) pts T))
      (if boundary
        (progn
          (setq hatch
            (if *DT_BLOCK_FACE_UNASSOC*
              (DT--make-plane-hatch-unassoc (DT--layer-visible) pts)
              (DT--make-assoc-hatch-plane
                boundary
                (DT--layer-visible)
                pts
                (DT--mode-hatch-pattern *DT_ACTIVE_MODE*)
                (DT--mode-hatch-color *DT_ACTIVE_MODE*))))
          (if (vl-string-search "$D3$" (strcase name))
            (DT--make-tray-sidewalls
              boundary (nth 0 pts) (nth 1 pts) (nth 2 pts) (nth 3 pts)))
          (setq made T)))
      (entmake '((0 . "ENDBLK")))
      (if made
        (progn
          ;; These lightweight visual hatches are intentionally internal and
          ;; non-associative. Do not run the ActiveX association pass here;
          ;; it is unnecessary and can abort migration inside LOAD.
          (DT--set-block-linework-050 name)))
      made)
    (if (tblsearch "BLOCK" name) T nil))
)

(defun DT--light-create-tray-visual
  (tray / frame meta baseLayer mode nominal inferredHeight legacyBad sideMm sidePlan name insert
    *DT_ACTIVE_MODE* *DT_ACTIVE_LAYER* *DT_ACTIVE_ELEVATION*
    *DT_ACTIVE_SIDE_HEIGHT* *DT_ACTIVE_SIDE_HEIGHT_MM* *DT_ACTIVE_3D*)
  (setq frame     (DT--light-tray-frame tray)
        meta      (DT--tray-meta-effective tray)
        baseLayer (DT--base-layer-name (cdr (assoc 8 (entget tray))))
        mode      (DT--normalize-mode
                    (if (and meta (car meta))
                      (car meta)
                      (DT--mode-from-layer baseLayer)))
        nominal   (if (and meta (numberp (cadr meta)) (> (cadr meta) 0.0))
                    (cadr meta)
                    (/ (nth 3 frame)
                       (max 0.000000001 (DEG:PLAN-UNIT-SCALE))))
        inferredHeight (DT--linked-sidewall-height tray)
        legacyBad (DT--light-legacy-bad-side-meta-p tray frame meta)
        sideMm
          (cond
            ((and meta
                  (numberp (caddr meta))
                  (> (caddr meta) 0.0))
              (caddr meta))
            ((> inferredHeight 0.000001)
              (/ (* inferredHeight 10.0)
                 (max 0.000000001 (DEG:PLAN-UNIT-SCALE))))
            (T (DT--last-side-height nominal)))
        sidePlan  (DT--plan-side-height sideMm)
        *DT_ACTIVE_MODE* mode
        *DT_ACTIVE_LAYER* baseLayer
        *DT_ACTIVE_ELEVATION* (if frame (caddr (car frame)) 0.0)
        *DT_ACTIVE_SIDE_HEIGHT_MM* sideMm
        *DT_ACTIVE_SIDE_HEIGHT* sidePlan
        *DT_ACTIVE_3D* (DT--entity-3d-enabled-p tray))
  (if (and frame (> sidePlan 0.0))
    (progn
      ;; Loose/legacy trays may not have route metadata. Persist the values
      ;; before deleting their model-space sidewalls so later STRETCH rebuilds
      ;; do not have to infer height from geometry that no longer exists.
      (if (null meta)
        (DT--set-tray-meta-one
          tray
          mode
          nominal
          sideMm
          (DEG:NUM->STR (caddr (car frame)))))
      (DT--ensure-type-layers)
      (setq name (DT--light-tray-block-name tray frame mode sidePlan))
      (if (DT--light-create-tray-block-def name frame)
        (setq insert
          (entmakex
            (list
              '(0 . "INSERT")
              (cons 2 name)
              (cons 8 (DT--layer-visible))
              (cons 10 (car frame))
              '(41 . 1.0)
              '(42 . 1.0)
              '(43 . 1.0)
              (cons 50 (cadr frame))))))
      (if insert
        (progn
          (DT--light-set-link tray "DT_TRAY_VISUAL" insert)
          (DT--light-set-link insert "DT_TRAY_VISUAL_MEMBER" tray)))
      insert))
)

(defun DT--light-delete-legacy-tray-geometry (tray / entities ent handle)
  (setq entities
    (DT--unique-alive-entities
      (append (DT--linked-hatches tray) (DT--linked-sidewalls tray))))
  (foreach ent entities
    (if (and ent (entget ent))
      (progn
        (setq handle (DT--ent-handle ent))
        (vl-catch-all-apply 'entdel (list ent))
        (if handle (DT--remember-deleted-handle handle)))))
  (DT--light-clear-app tray "DT_TRAY_HATCH")
  (DT--light-clear-app tray "DT_TRAY_SIDEWALL")
  (length entities)
)

(defun DT--light-delete-tray-composite (tray / visual)
  (if (and tray (DT--entity-alive-p tray))
    (progn
      (setq visual (DT--light-tray-visual tray))
      (DT--delete-tray-group tray)
      (DT--light-clear-app tray "DT_TRAY_VISUAL")
      (if (and visual (DT--entity-alive-p visual))
        (progn
          (DT--light-clear-app visual "DT_TRAY_VISUAL_MEMBER")
          (DT--safe-delete-ent visual)))
      (DT--safe-delete-ent tray)
      T))
)

(defun DT--delete-ents (ents / ent owner)
  ;; Rebuild/merge operations must remove both halves of a lightweight tray.
  ;; Deleting only the controller leaves its visual INSERT behind and produces
  ;; the double-layer tray seen after a junction is created.
  (foreach ent ents
    (cond
      ((and (DT--visible-tray-p ent)
            (DT--light-tray-visual ent))
        (DT--light-delete-tray-composite ent))
      ((DT--light-tray-visual-p ent)
        (setq owner (DT--light-tray-visual-owner ent))
        (if (and owner (DT--entity-alive-p owner))
          (DT--light-delete-tray-composite owner)
          (DT--safe-delete-ent ent)))
      (T (DT--safe-delete-ent ent))))
)

(defun DT--light-clean-orphan-tray-visuals (/ ss i visual owner count)
  (if (tblsearch "APPID" "DT_TRAY_VISUAL_MEMBER")
    (setq ss
      (ssget "_X"
        '((0 . "INSERT") (-3 ("DT_TRAY_VISUAL_MEMBER"))))))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq visual (ssname ss i)
              owner  (DT--light-tray-visual-owner visual))
        (if (not
              (and owner
                   (DT--entity-alive-p owner)
                   (eq visual (DT--light-tray-visual owner))))
          (progn
            (DT--safe-delete-ent visual)
            (setq count (1+ (if count count 0)))))
        (setq i (1+ i)))))
  (if count count 0)
)

(defun DT--light-valid-tray-visual-p (tray visual / name expected3d)
  (if (and tray
           visual
           (DT--entity-alive-p visual)
           (eq tray (DT--light-tray-visual-owner visual)))
    (progn
      (setq name
        (strcase
          (if (assoc 2 (entget visual))
            (cdr (assoc 2 (entget visual)))
            ""))
            expected3d (if (DT--entity-3d-enabled-p tray) "$D3$" "$D2$"))
      (or
        (and
          (wcmatch name "DT$TAVAHAFIF$SH4$*")
          (vl-string-search expected3d name))
        (and
          (DT--entity-3d-enabled-p tray)
          (wcmatch name "DT$TAVAHAFIF$SH3$*"))
        (and
          (wcmatch name "DT$TAVAHAFIF$SH2$*")
          (DT--entity-3d-enabled-p tray)
          (not
            (DT--light-legacy-bad-side-meta-p
              tray
              (DT--light-tray-frame tray)
              (DT--tray-meta-effective tray)))))))
)

(defun DT--tray-group-entities (tray / visual)
  (setq visual (DT--light-tray-visual tray))
  (if (DT--light-valid-tray-visual-p tray visual)
    (DT--unique-alive-entities (list tray visual))
    (DT--unique-alive-entities
      (append (list tray)
              (DT--linked-hatches tray)
              (DT--linked-sidewalls tray))))
)

(defun DT--refresh-tray-group (tray / name entities)
  (if (and tray (DT--visible-tray-p tray))
    (progn
      (setq name (DT--tray-group-name tray))
      (DT--delete-tray-group tray)
      (setq entities (DT--tray-group-entities tray))
      (if (and name (> (length entities) 1))
        (DT--make-group-object name entities))))
)

(defun DT--light-migrate-tray (tray / visual newVisual)
  (if (and tray (DT--visible-tray-p tray))
    (progn
      (setq visual (DT--light-tray-visual tray))
      (if (DT--light-valid-tray-visual-p tray visual)
        (progn
          (DT--refresh-tray-group tray)
          tray)
        (progn
          (setq newVisual (DT--light-create-tray-visual tray))
          (if newVisual
            (progn
              (if (and visual
                       (DT--entity-alive-p visual)
                       (not (eq visual newVisual)))
                (progn
                  (DT--light-clear-app visual "DT_TRAY_VISUAL_MEMBER")
                  (DT--safe-delete-ent visual)))
              (DT--light-delete-legacy-tray-geometry tray)
              (DT--refresh-tray-group tray)
              tray)))))))

(defun DT--light-all-trays (/ app ss i ent out)
  (foreach app '("DT_TRAY_VISUAL" "DT_TRAY_HATCH")
    (if (tblsearch "APPID" app)
      (progn
        (setq ss
          (ssget "_X"
            (list
              (cons 0 "LWPOLYLINE,POLYLINE")
              (list -3 (list app)))))
        (if ss
          (progn
            (setq i 0)
            (while (< i (sslength ss))
              (setq ent (ssname ss i))
              (if (and (DT--visible-tray-p ent)
                       (not (DT--entity-in-list-p ent out)))
                (setq out (append out (list ent))))
              (setq i (1+ i))))))))
  out
)

(defun DT--light-migrate-all-trays (/ tray count)
  (foreach tray (DT--light-all-trays)
    (if (DT--light-migrate-tray tray)
      (setq count (1+ (if count count 0)))))
  (if count count 0)
)

(defun DT--repair-existing-tray-sidewalls ()
  (DT--light-migrate-all-trays)
)

(defun DT--repair-existing-tray-groups (/ tray count)
  (foreach tray (DT--light-all-trays)
    (if (DT--refresh-tray-group tray)
      (setq count (1+ (if count count 0)))))
  (if count count 0)
)

(defun DT--rebuild-tray-sidewall-geometry (tray / oldVisual newVisual)
  (if (and tray (DT--visible-tray-p tray))
    (progn
      (setq oldVisual (DT--light-tray-visual tray))
      (if oldVisual
        (progn
          (DT--light-clear-app oldVisual "DT_TRAY_VISUAL_MEMBER")
          (vl-catch-all-apply 'entdel (list oldVisual))))
      (DT--light-clear-app tray "DT_TRAY_VISUAL")
      (setq newVisual (DT--light-create-tray-visual tray))
      (if newVisual
        (progn
          (DT--refresh-tray-group tray)
          T))))
)

(defun DT--light-legacy-make-straight
  (a b width / u n h p1 p2 p3 p4 ent hatch pts zA zB oldElevation)
  (if (> (distance a b) 0.001)
    (progn
      (setq u  (DT--seg-unit a b)
            n  (DT--perp u)
            h  (/ width 2.0)
            zA (DT--build-elevation-at-point a)
            zB (DT--build-elevation-at-point b)
            p1 (DT--point-at-elevation (DT--pt+ a n h) zA)
            p2 (DT--point-at-elevation (DT--pt+ b n h) zB)
            p3 (DT--point-at-elevation (DT--pt+ b n (- h)) zB)
            p4 (DT--point-at-elevation (DT--pt+ a n (- h)) zA)
            pts (list p1 p2 p3 p4))
      (if (equal zA zB 0.000001)
        (progn
          (setq oldElevation        (DT--active-elevation)
                *DT_ACTIVE_ELEVATION* zA
                ent                 (DT--make-poly (DT--layer-linework) pts T))
          (if ent
            (setq hatch
              (DT--make-assoc-hatch
                ent
                (DT--layer-visible)
                pts
                (DT--mode-hatch-pattern *DT_ACTIVE_MODE*)
                (DT--mode-hatch-color *DT_ACTIVE_MODE*))))
          (setq *DT_ACTIVE_ELEVATION* oldElevation))
        (progn
          (setq ent (DT--make-poly3d (DT--layer-linework) pts T))
          (if ent
            (setq hatch
              (DT--make-assoc-hatch-plane
                ent
                (DT--layer-visible)
                pts
                (DT--mode-hatch-pattern *DT_ACTIVE_MODE*)
                (DT--mode-hatch-color *DT_ACTIVE_MODE*))))))
      (if (and ent hatch) (DT--xdata-link-hatch ent hatch))
      (if ent
        (progn
          (DT--make-tray-sidewalls ent p1 p2 p3 p4)
          (DT--refresh-tray-group ent)))
      ent))
)

(defun DT--light-preview-make-straight
  (a b width / u n h p1 p2 p3 p4 pts zA zB oldElevation ent)
  (if (> (distance a b) 0.001)
    (progn
      (setq u  (DT--seg-unit a b)
            n  (DT--perp u)
            h  (/ width 2.0)
            zA (DT--build-elevation-at-point a)
            zB (DT--build-elevation-at-point b)
            p1 (DT--point-at-elevation (DT--pt+ a n h) zA)
            p2 (DT--point-at-elevation (DT--pt+ b n h) zB)
            p3 (DT--point-at-elevation (DT--pt+ b n (- h)) zB)
            p4 (DT--point-at-elevation (DT--pt+ a n (- h)) zA)
            pts (list p1 p2 p3 p4))
      (if (equal zA zB 0.000001)
        (progn
          (setq oldElevation          (DT--active-elevation)
                *DT_ACTIVE_ELEVATION* zA
                ent                   (DT--make-poly (DT--layer-linework) pts T)
                *DT_ACTIVE_ELEVATION* oldElevation))
        (setq ent (DT--make-poly3d (DT--layer-linework) pts T)))
      ent))
)

(defun DT--make-straight-piece (a b width / tray)
  (if (and (boundp '*DT_LIVE_PREVIEW_LIGHTWEIGHT*)
           *DT_LIVE_PREVIEW_LIGHTWEIGHT*)
    (setq tray (DT--light-preview-make-straight a b width))
    (progn
      (setq tray (DT--light-legacy-make-straight a b width))
      (if tray
        (progn
          (DT--set-entity-3d-mode tray (DT--active-3d-enabled-p))
          (DT--light-migrate-tray tray)))))
  tray
)

(defun DT--light-insert-point (ent / ed)
  (setq ed (if ent (entget ent)))
  (if (and ed (= (cdr (assoc 0 ed)) "INSERT")) (cdr (assoc 10 ed)))
)

(defun DT--light-insert-angle (ent / ed)
  (setq ed (if ent (entget ent)))
  (if ed (if (assoc 50 ed) (cdr (assoc 50 ed)) 0.0))
)

(defun DT--light-owned-visual-p (visual / owner)
  (setq owner (DT--light-tray-visual-owner visual))
  (and owner (eq visual (DT--light-tray-visual owner)))
)

(defun DT--light-entity-reactor-groups (ent / ed item candidate out)
  (if (and ent (setq ed (entget ent '("*"))))
    (foreach item ed
      (if (= (car item) 330)
        (progn
          (setq candidate (cdr item))
          (if (and candidate
                   (entget candidate)
                   (= (cdr (assoc 0 (entget candidate))) "GROUP")
                   (not (DT--entity-in-list-p candidate out)))
            (setq out (append out (list candidate))))))))
  out
)

(defun DT--light-group-name-for-object (group / dictionary record item name hit)
  (setq dictionary (DT--existing-group-dictionary))
  (if (and dictionary group)
    (progn
      (setq record (entget dictionary)
            name   nil)
      (foreach item record
        (cond
          ((= (car item) 3) (setq name (cdr item)))
          ((and name (member (car item) '(350 360)))
            (if (eq (cdr item) group) (setq hit name))
            (setq name nil))))))
  hit
)

(defun DT--light-remove-extra-groups (entities keepName / entity group name seen)
  (foreach entity entities
    (foreach group (DT--light-entity-reactor-groups entity)
      (if (not (DT--entity-in-list-p group seen))
        (progn
          (setq seen (append seen (list group))
                name (DT--light-group-name-for-object group))
          (if (and name
                   (or (null keepName) (/= (strcase name) (strcase keepName))))
            (DT--delete-group-by-name name))))))
  T
)

(defun DT--light-group-members-object (group / ed item members)
  (if (and group (setq ed (entget group)))
    (foreach item ed
      (if (and (= (car item) 340) (DT--entity-alive-p (cdr item)))
        (setq members (append members (list (cdr item)))))))
  members
)

(defun DT--light-actual-ladder-group (ent / group members hit)
  (foreach group (DT--light-entity-reactor-groups ent)
    (if (null hit)
      (progn
        (setq members (DT--light-group-members-object group))
        (if (and (> (length members) 1)
                 (DT--entity-in-list-p ent members)
                 (DT--ladder-meta (car members)))
          (setq hit group)))))
  hit
)

(defun DT--ladder-members (ent / named group members)
  (setq named (DT--ladder-named-members ent))
  (cond
    (named named)
    ((setq group (DT--light-actual-ladder-group ent))
      (setq members (DT--light-group-members-object group))
      (if members members (list ent)))
    ((and ent (entget ent)) (list ent)))
)

(defun DT--ladder-attached-group-p (ent)
  (> (length (DT--ladder-members ent)) 1)
)

(defun DT--ladder-selection-key (ent / control group)
  (cond
    ((DT--light-ladder-control-p ent)
      (DT--ent-handle ent))
    ((DT--light-ladder-visual-p ent)
      (setq control (DT--light-ladder-controller ent))
      (if control (DT--ent-handle control) (DT--ent-handle ent)))
    ((setq group (DT--light-actual-ladder-group ent))
      (DT--ent-handle group))
    (T (DT--ent-handle ent)))
)

(defun DTT--ladder-key (ent)
  (DT--ladder-selection-key ent)
)

(defun DTM--ladder-key (ent meta / key)
  (setq key (DT--ladder-selection-key ent))
  (if key (strcat "LADDER|" (strcase key)))
)

(defun DT--delete-ladder-composite (ent / members entity handle)
  (setq members (DT--ladder-members ent))
  (DT--light-remove-extra-groups members nil)
  (foreach entity members
    (if (and entity (entget entity))
      (progn
        (setq handle (DT--ent-handle entity))
        (vl-catch-all-apply 'entdel (list entity))
        (if handle (DT--remember-deleted-handle handle)))))
  T
)

(defun DT--light-find-copy-visual
  (tray / frame staleVisual staleEd expectedName ss i candidate ed point rotation hit)
  (setq frame (DT--light-tray-frame tray))
  (if frame
    (progn
      ;; COPY keeps the old visual handle in controller XData. That old insert
      ;; still gives the exact reusable block definition, even on legacy trays
      ;; that do not carry DT_META yet.
      (setq staleVisual  (DT--light-tray-visual tray)
            staleEd      (if staleVisual (entget staleVisual))
            expectedName (if staleEd (cdr (assoc 2 staleEd))))
      (if (tblsearch "APPID" "DT_TRAY_VISUAL_MEMBER")
        (setq ss
          (ssget "_X"
            '((0 . "INSERT") (-3 ("DT_TRAY_VISUAL_MEMBER"))))))
      (if ss
        (progn
          (setq i 0)
          (while (and (< i (sslength ss)) (null hit))
            (setq candidate (ssname ss i)
                  ed        (entget candidate)
                  point     (cdr (assoc 10 ed))
                  rotation  (if (assoc 50 ed) (cdr (assoc 50 ed)) 0.0))
            (if (and expectedName
                     (= (strcase (cdr (assoc 2 ed))) (strcase expectedName))
                     (equal point (car frame) 0.001)
                     (equal rotation (cadr frame) 0.000001)
                     (not (DT--light-owned-visual-p candidate)))
              (setq hit candidate))
            (setq i (1+ i))))))
  )
  hit
)

(defun DT--light-repair-tray-copies (/ tray visual candidate count)
  (foreach tray (DT--light-all-trays)
    (setq visual (DT--light-tray-visual tray))
    (if (not (DT--light-valid-tray-visual-p tray visual))
      (progn
        (setq candidate (DT--light-find-copy-visual tray))
        (if candidate
          (progn
            (DT--light-set-link tray "DT_TRAY_VISUAL" candidate)
            (DT--light-set-link candidate "DT_TRAY_VISUAL_MEMBER" tray)
            (DT--light-remove-extra-groups
              (list tray candidate) (DT--tray-group-name tray))
            (DT--refresh-tray-group tray)
            (setq count (1+ (if count count 0))))
          (if (DT--light-migrate-tray tray)
            (setq count (1+ (if count count 0))))))))
  (if count count 0)
)

;; Ladder lightweight controller + visual INSERT.
(defun DT--light-ladder-control-p (ent)
  (DT--light-app-present-p ent "DT_LADDER_CONTROL")
)

(defun DT--light-ladder-visual-p (ent)
  (DT--light-app-present-p ent "DT_LADDER_VISUAL")
)

(defun DT--light-ladder-visual (control)
  (DT--light-linked-entity control "DT_LADDER_CONTROL")
)

(defun DT--light-ladder-controller (visual)
  (DT--light-linked-entity visual "DT_LADDER_VISUAL")
)

(defun DT--light-ladder-controller-points
  (base rotation nominal side topElevation bottomElevation /
    planWidth sidePlan half front local)
  (setq planWidth (DT--plan-width nominal)
        sidePlan  (DT--plan-side-height side)
        half      (/ planWidth 2.0)
        front     (- (/ sidePlan 2.0))
        local
          (list
            (list (- half) front 0.0)
            (list half front 0.0)
            (list half front (- bottomElevation topElevation))
            (list (- half) front (- bottomElevation topElevation))))
  (mapcar
    '(lambda (point)
       (DT--ladder-world-point
         (DT--point-at-elevation base topElevation) rotation point))
    local)
)

(defun DT--light-make-ladder-controller
  (base rotation mode nominal side topElevation bottomElevation / pts control)
  (setq pts
    (DT--light-ladder-controller-points
      base rotation nominal side topElevation bottomElevation))
  (if pts
    (setq control
      (DT--make-poly3d
        (DT--line-layer-name (cadr (DT--find-type mode))) pts T)))
  control
)

(defun DT--make-ladder-composite-at
  (base rotation mode nominal side topElevation bottomElevation /
    visual control groupId groupName)
  (setq visual
    (DT--make-ladder-block-at
      base rotation mode nominal side topElevation bottomElevation))
  (if visual
    (setq control
      (DT--light-make-ladder-controller
        base rotation mode nominal side topElevation bottomElevation)))
  (if (and visual control)
    (progn
      (setq groupId   (DT--ent-handle control)
            groupName (DT--ladder-group-name groupId))
      (DT--set-ladder-meta
        control mode nominal side topElevation bottomElevation groupId)
      (DT--set-ladder-meta
        visual mode nominal side topElevation bottomElevation groupId)
      (DT--light-set-link control "DT_LADDER_CONTROL" visual)
      (DT--light-set-link visual "DT_LADDER_VISUAL" control)
      (DT--make-group-object groupName (list control visual))
      (DT--ensure-composite-pickstyle)
      control)
    (progn
      (if visual (vl-catch-all-apply 'entdel (list visual)))
      (if control (vl-catch-all-apply 'entdel (list control)))
      nil))
)

(defun DT--light-legacy-ladder-top-cap-entity-p
  (ent / meta top ed typ elevation)
  (setq meta      (DT--ladder-meta ent)
        top       (if meta (nth 3 meta))
        ed        (if ent (entget ent))
        typ       (if ed (cdr (assoc 0 ed)))
        elevation (if ed (DT--ladder-entity-vertex-elevation ent)))
  (and
    meta
    (member typ '("LWPOLYLINE" "POLYLINE"))
    (numberp top)
    (numberp elevation)
    (equal elevation top 0.001))
)

(defun DT--light-legacy-ladder-top-cap
  (ent / meta top entity ed typ elevation difference best bestDifference)
  (setq meta (DT--ladder-meta ent)
        top  (if meta (nth 3 meta)))
  (foreach entity (DT--ladder-members ent)
    (setq ed  (if entity (entget entity))
          typ (if ed (cdr (assoc 0 ed))))
    (if (and (member typ '("LWPOLYLINE" "POLYLINE")) (numberp top))
      (progn
        (setq elevation  (DT--ladder-entity-vertex-elevation entity)
              difference (abs (- elevation top)))
        (if (or (null bestDifference) (< difference bestDifference))
          (setq best entity bestDifference difference)))))
  (if (and bestDifference (<= bestDifference 0.001)) best)
)

(defun DT--light-legacy-ladder-placement
  (ent / ed typ meta cap pts count point sumX sumY first second)
  (setq ed   (if ent (entget ent))
        typ  (if ed (cdr (assoc 0 ed)))
        meta (DT--ladder-meta ent))
  (cond
    ((= typ "INSERT")
      (list
        (cdr (assoc 10 ed))
        (if (assoc 50 ed) (cdr (assoc 50 ed)) 0.0)))
    (meta
      (setq cap (DT--light-legacy-ladder-top-cap ent)
            pts (if cap (g365_get_pts cap)))
      (if (and pts (>= (length pts) 2))
        (progn
          (foreach point pts
            (setq sumX (+ (if sumX sumX 0.0) (car point))
                  sumY (+ (if sumY sumY 0.0) (cadr point))))
          (setq count  (float (length pts))
                first  (car pts)
                second (cadr pts))
          (list
            (list (/ sumX count) (/ sumY count) (nth 3 meta))
            (angle first second))))))
)

(defun DT--ladder-top-cap-entity-p (ent)
  (if (DT--light-ladder-control-p ent)
    T
    (DT--light-legacy-ladder-top-cap-entity-p ent))
)

(defun DT--ladder-top-cap (ent / control)
  (cond
    ((DT--light-ladder-control-p ent) ent)
    ((DT--light-ladder-visual-p ent)
      (setq control (DT--light-ladder-controller ent))
      (if control control ent))
    (T (DT--light-legacy-ladder-top-cap ent)))
)

(defun DT--light-ladder-placement
  (control / pts p0 p1 frontMid meta sidePlan u normal base)
  (setq pts (DT--entity-points3d control))
  (if (and pts (>= (length pts) 2))
    (progn
      (setq p0   (nth 0 pts)
            p1   (nth 1 pts)
            frontMid
              (list
                (/ (+ (car p0) (car p1)) 2.0)
                (/ (+ (cadr p0) (cadr p1)) 2.0)
                (/ (+ (caddr p0) (caddr p1)) 2.0))
            meta     (DT--ladder-meta control)
            sidePlan (if meta (DT--plan-side-height (nth 2 meta)) 0.0)
            u        (DT--seg-unit p0 p1)
            normal   (if u (DT--perp u))
            base     (if normal
                       (DT--pt-shift-xy frontMid normal (/ sidePlan 2.0))
                       frontMid))
      (list base (angle p0 p1))))
)

(defun DT--ladder-placement-data (ent / control result)
  (cond
    ((DT--light-ladder-control-p ent)
      (DT--light-ladder-placement ent))
    ((DT--light-ladder-visual-p ent)
      (setq control (DT--light-ladder-controller ent))
      (if control (DT--light-ladder-placement control)))
    (T (DT--light-legacy-ladder-placement ent)))
)

(defun DT--light-ladder-signature (control)
  (if (DT--light-ladder-control-p control)
    (DT--entity-points3d control))
)

(defun DT--light-all-ladder-controls (/ ss i ent out)
  (if (tblsearch "APPID" "DT_LADDER_CONTROL")
    (setq ss
      (ssget "_X"
        '((0 . "LWPOLYLINE,POLYLINE") (-3 ("DT_LADDER_CONTROL"))))))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent (ssname ss i))
        (if (DT--entity-alive-p ent) (setq out (append out (list ent))))
        (setq i (1+ i)))))
  out
)

(defun DT--light-ladder-signature-map (/ control out)
  (foreach control (DT--light-all-ladder-controls)
    (setq out
      (cons
        (cons (DT--ent-handle control)
              (DT--light-ladder-signature control))
        out)))
  out
)

(defun DT--light-rebuild-ladder (control / pts meta p0 p1 p2 p3 base rotation
    scale nominal side top bottom oldVisual newVisual groupId groupName)
  (setq pts  (DT--entity-points3d control)
        meta (DT--ladder-meta control))
  (if (and (= (length pts) 4) meta)
    (progn
      (setq p0       (nth 0 pts)
            p1       (nth 1 pts)
            p2       (nth 2 pts)
            p3       (nth 3 pts)
            base     (list
                       (/ (+ (car p0) (car p1)) 2.0)
                       (/ (+ (cadr p0) (cadr p1)) 2.0)
                       (/ (+ (caddr p0) (caddr p1)) 2.0))
            rotation (angle p0 p1)
            scale    (max 0.000000001 (DEG:PLAN-UNIT-SCALE))
            nominal (/ (distance p0 p1) scale)
            side     (nth 2 meta)
            top      (/ (+ (caddr p0) (caddr p1)) 2.0)
            bottom   (/ (+ (caddr p2) (caddr p3)) 2.0)
            oldVisual (DT--light-ladder-visual control))
      (if (and oldVisual
               (entget oldVisual)
               (eq control (DT--light-ladder-controller oldVisual)))
        (vl-catch-all-apply 'entdel (list oldVisual)))
      (DT--light-clear-app control "DT_LADDER_CONTROL")
      (setq newVisual
        (DT--make-ladder-block-at
          base rotation (car meta) nominal side top bottom))
      (if newVisual
        (progn
          (setq groupId   (DT--ent-handle control)
                groupName (DT--ladder-group-name groupId))
          (DT--delete-group-by-name groupName)
          (DT--set-ladder-meta control (car meta) nominal side top bottom groupId)
          (DT--set-ladder-meta newVisual (car meta) nominal side top bottom groupId)
          (DT--light-set-link control "DT_LADDER_CONTROL" newVisual)
          (DT--light-set-link newVisual "DT_LADDER_VISUAL" control)
          (DT--make-group-object groupName (list control newVisual))
          T))))
)

(defun DT--light-update-label-links (oldMembers newControl / refs ref handle)
  (if (and oldMembers newControl)
    (progn
      (setq refs (DTT--references "e_tava_etiket"))
      (foreach ref refs
        (setq handle (DTT--reference-tray-handle ref))
        (if (and handle (member (strcase handle) oldMembers))
          (DTT--set-reference-tray ref newControl)))))
)

(defun DT--light-migrate-legacy-ladder
  (ent / meta members handles placement newControl)
  (setq meta    (DT--ladder-meta ent)
        members (DT--ladder-members ent))
  (if (and meta
           (not (DT--light-ladder-control-p ent))
           (not (DT--light-ladder-visual-p ent)))
    (progn
      (foreach ent members
        (setq handles (cons (strcase (DT--ent-handle ent)) handles)))
      (setq placement (DT--light-legacy-ladder-placement ent))
      (if placement
        (setq newControl
          (DT--make-ladder-composite-at
            (car placement) (cadr placement)
            (car meta) (nth 1 meta) (nth 2 meta) (nth 3 meta) (nth 4 meta))))
      (if newControl
        (progn
          (DT--light-update-label-links handles newControl)
          (DT--delete-ladder-composite ent)
          newControl))))
)

(defun DT--light-migrate-all-ladders (/ ss i ent meta key seen count)
  (if (tblsearch "APPID" (DT--ladder-meta-app))
    (setq ss
      (ssget "_X"
        (list (list -3 (list (DT--ladder-meta-app)))))))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent  (ssname ss i)
              meta (DT--ladder-meta ent)
              key  (if meta (DT--ladder-selection-key ent)))
        (if (and meta
                 (not (DT--light-ladder-control-p ent))
                 (not (DT--light-ladder-visual-p ent))
                 (not (member key seen)))
          (progn
            (setq seen (cons key seen))
            (if (DT--light-migrate-legacy-ladder ent)
              (setq count (1+ (if count count 0))))))
        (setq i (1+ i)))))
  (if count count 0)
)

(defun DT--light-owned-ladder-visual-p (visual / control)
  (setq control (DT--light-ladder-controller visual))
  (and control (eq visual (DT--light-ladder-visual control)))
)

(defun DT--light-find-copy-ladder-visual
  (control / placement base rotation staleVisual staleEd expectedName
    ss i candidate ed point candidateRotation hit)
  (setq placement    (DT--light-ladder-placement control)
        base         (if placement (car placement))
        rotation     (if placement (cadr placement))
        staleVisual  (DT--light-ladder-visual control)
        staleEd      (if staleVisual (entget staleVisual))
        expectedName (if staleEd (cdr (assoc 2 staleEd))))
  (if (and base expectedName (tblsearch "APPID" "DT_LADDER_VISUAL"))
    (setq ss
      (ssget "_X"
        '((0 . "INSERT") (-3 ("DT_LADDER_VISUAL"))))))
  (if ss
    (progn
      (setq i 0)
      (while (and (< i (sslength ss)) (null hit))
        (setq candidate         (ssname ss i)
              ed                (entget candidate)
              point             (cdr (assoc 10 ed))
              candidateRotation (if (assoc 50 ed) (cdr (assoc 50 ed)) 0.0))
        (if (and (= (strcase (cdr (assoc 2 ed))) (strcase expectedName))
                 (equal point base 0.001)
                 (equal candidateRotation rotation 0.000001)
                 (not (DT--light-owned-ladder-visual-p candidate)))
          (setq hit candidate))
        (setq i (1+ i)))))
  hit
)

(defun DT--light-repair-ladder-copies
  (/ control visual candidate meta groupId groupName)
  ;; A copied two-member group can keep stale XData. The normal command path
  ;; rebuilds any changed controller; unchanged copies are paired by the visual
  ;; INSERT that shares their top-center point.
  (foreach control (DT--light-all-ladder-controls)
    (setq visual (DT--light-ladder-visual control))
    (if (or (null visual)
            (not (eq control (DT--light-ladder-controller visual))))
      (progn
        (setq candidate (DT--light-find-copy-ladder-visual control)
              meta      (DT--ladder-meta control))
        (if (and candidate meta)
          (progn
            (setq groupId   (DT--ent-handle control)
                  groupName (DT--ladder-group-name groupId))
            (DT--set-ladder-meta
              control (car meta) (nth 1 meta) (nth 2 meta)
              (nth 3 meta) (nth 4 meta) groupId)
            (DT--set-ladder-meta
              candidate (car meta) (nth 1 meta) (nth 2 meta)
              (nth 3 meta) (nth 4 meta) groupId)
            (DT--light-set-link control "DT_LADDER_CONTROL" candidate)
            (DT--light-set-link candidate "DT_LADDER_VISUAL" control)
            (DT--light-remove-extra-groups
              (list control candidate) groupName)
            (DT--delete-group-by-name groupName)
            (DT--make-group-object groupName (list control candidate)))
          (DT--light-rebuild-ladder control)))
      (progn
        (setq groupId   (DT--ent-handle control)
              groupName (DT--ladder-group-name groupId))
        (DT--set-ladder-meta
          control
          (car (DT--ladder-meta control))
          (nth 1 (DT--ladder-meta control))
          (nth 2 (DT--ladder-meta control))
          (nth 3 (DT--ladder-meta control))
          (nth 4 (DT--ladder-meta control))
          groupId)
        (DT--set-ladder-meta
          visual
          (car (DT--ladder-meta control))
          (nth 1 (DT--ladder-meta control))
          (nth 2 (DT--ladder-meta control))
          (nth 3 (DT--ladder-meta control))
          (nth 4 (DT--ladder-meta control))
          groupId)
        (DT--delete-group-by-name groupName)
        (DT--make-group-object groupName (list control visual)))))
  T
)

(defun DT--tray-center-seg-from-corners
  (pts / p0 p1 p2 p3 l01 l12)
  (if (and pts (>= (length pts) 4))
    (progn
      (setq p0  (nth 0 pts)
            p1  (nth 1 pts)
            p2  (nth 2 pts)
            p3  (nth 3 pts)
            l01 (distance p0 p1)
            l12 (distance p1 p2))
      (if (>= l01 l12)
        (list (DT--pt-mid p0 p3) (DT--pt-mid p1 p2))
        (list (DT--pt-mid p0 p1) (DT--pt-mid p3 p2))))))

(defun DT--tray-signature-center-seg (signature)
  (if (and (listp signature) (> (length signature) 4))
    (DT--tray-center-seg-from-corners (cdr signature))))

(defun DT--tray-signature-map (/ tray handle signature out)
  ;; Lightweight trays retain their editable boundary as the controller.
  ;; Include that controller in command snapshots so STRETCH/MOVE is visible
  ;; to both the visual rebuild and the hidden network-center synchronizer.
  (foreach tray (DT--light-all-trays)
    (setq handle    (DT--ent-handle tray)
          signature (DT--tray-geometry-signature tray))
    (if (and handle signature)
      (setq out (cons (cons handle signature) out))))
  out
)

(defun DT--replace-route-point-near
  (pts oldPoint newPoint tol / point out changed)
  (foreach point pts
    (if (and (not changed)
             (<= (DT--distance-xy point oldPoint) tol))
      (progn
        (setq out
          (append out
            (list
              (list
                (car newPoint)
                (cadr newPoint)
                (if (caddr point) (caddr point) 0.0)))))
        (setq changed T))
      (setq out (append out (list point)))))
  (list out changed)
)

(defun DT--retarget-center-cuts
  (center oldPoint newPoint tol / cuts cut point gap out changed)
  (setq cuts (DT--plus-cuts center))
  (foreach cut cuts
    (setq point (DT--cut-point cut)
          gap   (if (and (listp cut) (listp (car cut))) (cadr cut) nil))
    (if (<= (DT--distance-xy point oldPoint) tol)
      (progn
        (setq out (append out (list (list newPoint gap))))
        (setq changed T))
      (setq out (append out (list cut)))))
  (if changed (DT--set-plus-cuts center out))
  changed
)

(defun DT--sync-center-from-stretched-tray
  (tray oldSignature / center oldSeg newSeg pts result changed tol)
  (setq center (DT--center-for-tray tray)
        oldSeg (DT--tray-signature-center-seg oldSignature)
        newSeg (DT--tray-center-seg tray)
        tol    0.01)
  (if (and center oldSeg newSeg
           (= (length oldSeg) 2)
           (= (length newSeg) 2))
    (progn
      (setq pts (g365_get_pts center))
      (setq result
        (DT--replace-route-point-near
          pts (car oldSeg) (car newSeg) tol)
        pts     (car result)
        changed (cadr result))
      (setq result
        (DT--replace-route-point-near
          pts (cadr oldSeg) (cadr newSeg) tol)
        pts     (car result)
        changed (or changed (cadr result)))
      (DT--retarget-center-cuts
        center (car oldSeg) (car newSeg) tol)
      (DT--retarget-center-cuts
        center (cadr oldSeg) (cadr newSeg) tol)
      (if changed
        (progn
          (DT--set-center-points center pts)
          center)))))

(defun DT--connection-warning-layer ()
  "e_tava_baglanti_kontrol"
)

(defun DT--connection-warning-block-name ()
  "e_tava_baglanti_kontrol_kure"
)

(defun DT--connection-warning-radius ()
  ;; The configured PLAN scale expresses one physical centimetre.
  (* 50.0 (DEG:PLAN-UNIT-SCALE))
)

(defun DT--ensure-connection-warning-layer (/ lay)
  (setq lay (DT--connection-warning-layer))
  (DT--ensure-layer lay 1 nil)
  lay
)

(defun DT--ensure-connection-warning-block
  (/ name lay oldLayer oldEcho result sphere marker)
  (setq name (DT--connection-warning-block-name)
        lay  (DT--ensure-connection-warning-layer))
  (if (tblsearch "BLOCK" name)
    name
    (progn
      (setq oldLayer (getvar "CLAYER")
            oldEcho  (getvar "CMDECHO"))
      (setvar "CLAYER" lay)
      (setvar "CMDECHO" 0)
      (setq result
        (vl-catch-all-apply
          '(lambda ()
             (vl-cmdf
               "_.SPHERE"
               "_non" '(0.0 0.0 0.0)
               1.0)
             (setq sphere (entlast))
             (vl-cmdf
               "_.-BLOCK"
               name
               "_non" '(0.0 0.0 0.0)
               sphere "")
             (setq marker (entlast))
             (if (and marker
                      (entget marker)
                      (= (cdr (assoc 0 (entget marker))) "INSERT")
                      (=
                        (strcase (cdr (assoc 2 (entget marker))))
                        (strcase name)))
               (DT--safe-delete-ent marker))
             (if (DT--entity-alive-p sphere)
               (DT--safe-delete-ent sphere))
             (tblsearch "BLOCK" name))
          '()))
      (setvar "CLAYER" oldLayer)
      (setvar "CMDECHO" oldEcho)
      (if (or (vl-catch-all-error-p result)
              (not (tblsearch "BLOCK" name)))
        nil
        name)))
)

(defun DT--connection-warning-handles (ent / ed xd rec item out)
  (if (and ent
           (setq ed (entget ent '("DT_CONNECTION_WARNING")))
           (setq xd (assoc -3 ed)))
    (progn
      (setq rec (cadr xd))
      (foreach item (cdr rec)
        (if (= (car item) 1005)
          (setq out (cons (strcase (cdr item)) out))))))
  out
)

(defun DT--connection-warning-elevations
  (point centerA centerB / fallback zA zB result)
  (setq fallback
    (if (and (caddr point) (numberp (caddr point)))
      (caddr point)
      0.0))
  (setq result
    (vl-catch-all-apply
      'DT--center-elevation-at-point
      (list centerA point)))
  (if (not (vl-catch-all-error-p result)) (setq zA result))
  (setq result
    (vl-catch-all-apply
      'DT--center-elevation-at-point
      (list centerB point)))
  (if (not (vl-catch-all-error-p result)) (setq zB result))
  (cond
    ((and (numberp zA) (numberp zB))
      (if (equal zA zB 0.001)
        (list (/ (+ zA zB) 2.0))
        (if (< zA zB) (list zA zB) (list zB zA))))
    ((numberp zA) (list zA))
    ((numberp zB) (list zB))
    (T (list fallback)))
)

(defun DT--connection-warning-same-elevation-p
  (point centerA centerB / zA zB result tolerance)
  (setq result
    (vl-catch-all-apply
      'DT--center-elevation-at-point
      (list centerA point)))
  (if (not (vl-catch-all-error-p result)) (setq zA result))
  (setq result
    (vl-catch-all-apply
      'DT--center-elevation-at-point
      (list centerB point)))
  (if (not (vl-catch-all-error-p result)) (setq zB result))
  ;; 0.01 cm fiziksel tolerans: mm, cm ve metre planlarinda ayni sonucu verir.
  (setq tolerance
    (max 0.000001 (* 0.01 (DEG:PLAN-UNIT-SCALE))))
  (and (numberp zA)
       (numberp zB)
       (equal zA zB tolerance))
)

(defun DT--make-connection-warning-insert
  (point radius centerA centerB / app ent ed payload handle)
  (setq app "DT_CONNECTION_WARNING")
  (if (not (tblsearch "APPID" app)) (regapp app))
  (if (and (numberp radius)
           (> radius 0.0)
           (DT--ensure-connection-warning-block))
    (setq ent
      (entmakex
        (list
          '(0 . "INSERT")
          (cons 2 (DT--connection-warning-block-name))
          (cons 8 (DT--connection-warning-layer))
          (cons 10
            (list
              (car point)
              (cadr point)
              (if (and (caddr point) (numberp (caddr point)))
                (caddr point)
                0.0)))
          (cons 41 radius)
          (cons 42 radius)
          (cons 43 radius)
          '(50 . 0.0)
          '(62 . 256)))))
  (if ent
    (progn
      (setq payload (list app))
      (foreach handle
        (list (DT--ent-handle centerA) (DT--ent-handle centerB))
        (if handle
          (setq payload
            (append payload (list (cons 1005 handle))))))
      (setq ed (entget ent '("*"))
            ed (DT--xdata-set-app ed app payload))
      (entmod ed)
      (entupd ent)))
  ent
)

(defun DT--mark-connection-warning
  (point radius centerA centerB / elevations elevation marker firstMarker)
  (if (DT--connection-warning-same-elevation-p
        point centerA centerB)
    (progn
      (setq elevations
        (DT--connection-warning-elevations point centerA centerB))
      (foreach elevation elevations
        (setq marker
          (DT--make-connection-warning-insert
            (list (car point) (cadr point) elevation)
            radius centerA centerB))
        (if (and marker (null firstMarker))
          (setq firstMarker marker)))))
  firstMarker
)

(defun DT--all-active-centers (/ center out)
  ;; DT oturumu basinda kurulan merkez cache'ini kullan; her yeni tavada
  ;; model space'in tamamini yeniden tarama.
  (foreach center (DT--center-cache-source)
    (if (and (DT--entity-alive-p center)
             (DT--active-center-p center))
      (setq out (cons center out))))
  (reverse out)
)

(defun DT--center-segments (center / pts i out)
  (setq pts (if center (g365_get_pts center) nil)
        i   0)
  (while (and pts (< i (1- (length pts))))
    (if (> (DT--distance-xy (nth i pts) (nth (1+ i) pts)) 0.001)
      (setq out
        (append out
          (list (list (nth i pts) (nth (1+ i) pts))))))
    (setq i (1+ i)))
  out
)

(defun DT--point-on-segment-contact
  (point segment tolerance / rec closest distanceValue)
  (setq rec
    (g365_closest_on_seg point (car segment) (cadr segment)))
  (if rec
    (progn
      (setq closest     (car rec)
            distanceValue (nth 2 rec))
      (if (<= distanceValue tolerance)
        (list
          (DT--pt-mid point closest)
          distanceValue)))))

(defun DT--segments-parallel-p (a b c d / u v)
  (setq u (DT--seg-unit a b)
        v (DT--seg-unit c d))
  (and u v
       (> (abs (g365_dot (car u) (cadr u) (car v) (cadr v)))
          0.999)))

(defun DT--center-pair-contact-points
  (centerA centerB / segsA segsB widthA widthB tolerance
    segA segB ip contact point out)
  (setq segsA     (DT--center-segments centerA)
        segsB     (DT--center-segments centerB)
        widthA    (DT--center-width centerA (DT--plan-width (DT--last-width)))
        widthB    (DT--center-width centerB (DT--plan-width (DT--last-width)))
        tolerance (+ (/ widthA 2.0) (/ widthB 2.0) 0.5))
  (foreach segA segsA
    (foreach segB segsB
      (setq ip (inters (car segA) (cadr segA)
                       (car segB) (cadr segB) T))
      (if ip
        (progn
          (setq point (list (car ip) (cadr ip) 0.0))
          (if (not (DT--point-known-p point out 0.01))
            (setq out (append out (list point)))))
        (foreach point
          (list (car segA) (cadr segA) (car segB) (cadr segB))
          (setq contact
            (cond
              ((or (equal point (car segA) 0.000001)
                   (equal point (cadr segA) 0.000001))
                (DT--point-on-segment-contact point segB tolerance))
              (T
                (DT--point-on-segment-contact point segA tolerance))))
          (if (and contact
                   (not (DT--point-known-p (car contact) out 0.01)))
            (setq out (append out (list (car contact)))))))))
  out
)

(defun DT--connection-warning-fitting-p
  (point fittings fallbackWidth / ent ed insertPoint width tolerance hit)
  (foreach ent fittings
    (if (and (not hit)
             (DT--entity-alive-p ent)
             (DT--fitting-insert-p ent))
      (progn
        (setq ed          (entget ent)
              insertPoint (cdr (assoc 10 ed))
              width       (DT--fitting-insert-width ent fallbackWidth)
              tolerance   (+ (max 1.0 (/ width 2.0)) 1.0))
        (if (and insertPoint
                 (or
                   (DT--point-in-fitting-box-p point ent 0.5)
                   (<=
                     (DT--distance-xy
                       point
                       (list (car insertPoint) (cadr insertPoint) 0.0))
                     tolerance)))
          (setq hit T)))))
  hit
)

(defun DT--connection-warning-fittings (/ ent out)
  (foreach ent (DT--fitting-inserts)
    (if (DT--entity-alive-p ent)
      (setq out (cons ent out))))
  (reverse out)
)

(defun DT--delete-connection-warnings-for-centers
  (centers / handles center ss i ent markerHandles remove handle)
  (foreach center centers
    (setq handle (DT--ent-handle center))
    (if handle (setq handles (cons (strcase handle) handles))))
  (if (tblsearch "APPID" "DT_CONNECTION_WARNING")
    (setq ss
      (ssget "_X"
        '((0 . "CIRCLE,INSERT") (-3 ("DT_CONNECTION_WARNING"))))))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent           (ssname ss i)
              markerHandles (DT--connection-warning-handles ent)
              remove        nil)
        (foreach handle markerHandles
          (if (member handle handles) (setq remove T)))
        (if remove (DT--safe-delete-ent ent))
        (setq i (1+ i)))))
  T
)

(defun DT--upgrade-connection-warning-markers
  (/ ss i marker ed type oldMarker point handles centerA centerB made)
  (if (tblsearch "APPID" "DT_CONNECTION_WARNING")
    (setq ss
      (ssget "_X"
        '((0 . "CIRCLE,INSERT") (-3 ("DT_CONNECTION_WARNING"))))))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq marker    (ssname ss i)
              ed        (entget marker)
              type      (cdr (assoc 0 ed))
              oldMarker
                (or
                  (= type "CIRCLE")
                  (and (= type "INSERT")
                       (/=
                         (strcase (if (cdr (assoc 2 ed)) (cdr (assoc 2 ed)) ""))
                         (strcase (DT--connection-warning-block-name)))))
              point     (cdr (assoc 10 ed))
              handles   (DT--connection-warning-handles marker)
              centerA (if (car handles) (handent (car handles)) nil)
              centerB (if (cadr handles) (handent (cadr handles)) nil))
        (cond
          ((and point centerA centerB
                (not
                  (DT--connection-warning-same-elevation-p
                    point centerA centerB)))
            (DT--safe-delete-ent marker))
          ((and oldMarker point centerA centerB)
            (if (DT--mark-connection-warning
                  point
                  (DT--connection-warning-radius)
                  centerA centerB)
              (progn
                (DT--safe-delete-ent marker)
                (setq made (1+ (if made made 0)))))))
        (setq i (1+ i)))))
  (if made made 0)
)

(defun DT--connection-warning-needed-p
  (centerA centerB point fittings / layerA layerB ptsA ptsB arms)
  (if (DT--connection-warning-same-elevation-p
        point centerA centerB)
    (progn
      (setq layerA (DT--center-layer centerA "")
            layerB (DT--center-layer centerB ""))
      (if (not (DT--same-tray-layer-p layerA layerB))
        (not
          (DT--connection-warning-fitting-p
            point
            fittings
            (max
              (DT--center-width centerA 1.0)
              (DT--center-width centerB 1.0))))
        (progn
          (setq ptsA (g365_get_pts centerA)
                ptsB (g365_get_pts centerB)
                arms
                  (DT--combine-arms
                    (DT--arms-at-point ptsA point 0.01)
                    (DT--arms-at-point ptsB point 0.01)))
          (if (null arms)
            (setq arms
              (DT--combine-arms
                (list (DT--dir-at-point ptsA point))
                (list (DT--dir-at-point ptsB point)))))
          (setq arms (vl-remove nil arms))
          (and arms
               (not (DT--all-collinear-p arms))
               (not
                 (DT--connection-warning-fitting-p
                   point
                   fittings
                   (max
                     (DT--center-width centerA 1.0)
                     (DT--center-width centerB 1.0)))))))))
)

(defun DT--refresh-connection-warnings-for-centers
  (targets / all fittings target other targetHandle otherHandle pairKey reverseKey
    processed contacts point width radius made nearby targetPts targetWidth)
  (setq targets
    (vl-remove-if-not
      '(lambda (center)
         (and center
              (DT--entity-alive-p center)
              (DT--active-center-p center)))
      targets))
  (if targets
    (progn
      (DT--delete-connection-warnings-for-centers targets)
      (setq all      (DT--all-active-centers)
            fittings (DT--connection-warning-fittings))
      (foreach target targets
        (setq targetHandle (DT--ent-handle target)
              targetPts    (g365_get_pts target)
              targetWidth
                (DT--center-width
                  target
                  (DT--plan-width (DT--last-width)))
              nearby
                (DT--filter-centers-near-route
                  all targetPts targetWidth))
        (foreach other nearby
          (if (and (not (eq target other))
                   (setq otherHandle (DT--ent-handle other)))
            (progn
              (setq pairKey    (strcat targetHandle "|" otherHandle)
                    reverseKey (strcat otherHandle "|" targetHandle))
              (if (and (not (member pairKey processed))
                       (not (member reverseKey processed)))
                (progn
                  (setq processed (cons pairKey processed)
                        contacts
                          (DT--center-pair-contact-points target other))
                  (foreach point contacts
                    (if (DT--connection-warning-needed-p
                          target other point fittings)
                      (progn
                        (setq width
                          (max
                            (DT--center-width target 1.0)
                            (DT--center-width other 1.0))
                          radius (DT--connection-warning-radius))
                        (if (DT--mark-connection-warning
                              point radius target other)
                          (setq made (1+ (if made made 0)))))))))))))))
  (if made made 0)
)

(vl-catch-all-apply 'DT--upgrade-connection-warning-markers '())

(defun DT--connection-warning-marker-p (ent / ed handles)
  (and ent
       (DT--entity-alive-p ent)
       (setq ed (entget ent '("DT_CONNECTION_WARNING")))
       (member (cdr (assoc 0 ed)) '("CIRCLE" "INSERT"))
       (setq handles (DT--connection-warning-handles ent))
       (>= (length handles) 2))
)

(defun DT--selected-connection-warning (ss / i ent marker)
  (if ss
    (progn
      (setq i 0)
      (while (and (< i (sslength ss)) (null marker))
        (setq ent (ssname ss i))
        (if (DT--connection-warning-marker-p ent)
          (setq marker ent))
        (setq i (1+ i)))))
  marker
)

(defun DT--warning-contact-candidates
  (centerA centerB / segsA segsB widthA widthB tolerance
    segA segB ip endpoint rec closest display candidates)
  (setq segsA     (DT--center-segments centerA)
        segsB     (DT--center-segments centerB)
        widthA    (DT--center-width centerA 1.0)
        widthB    (DT--center-width centerB 1.0)
        tolerance (+ (/ widthA 2.0) (/ widthB 2.0) 0.5))
  (foreach segA segsA
    (foreach segB segsB
      (setq ip
        (inters
          (car segA) (cadr segA)
          (car segB) (cadr segB)
          T))
      (if ip
        (progn
          (setq ip (list (car ip) (cadr ip) 0.0))
          (setq candidates
            (cons
              (list ip ip nil nil nil)
              candidates)))
        (progn
          (foreach endpoint (list (car segA) (cadr segA))
            (setq rec
              (g365_closest_on_seg
                endpoint (car segB) (cadr segB)))
            (if (and rec (<= (nth 2 rec) tolerance))
              (progn
                (setq closest (car rec)
                      closest
                        (list (car closest) (cadr closest) 0.0)
                      display (DT--pt-mid endpoint closest))
                (setq candidates
                  (cons
                    (list display closest centerA endpoint closest)
                    candidates)))))
          (foreach endpoint (list (car segB) (cadr segB))
            (setq rec
              (g365_closest_on_seg
                endpoint (car segA) (cadr segA)))
            (if (and rec (<= (nth 2 rec) tolerance))
              (progn
                (setq closest (car rec)
                      closest
                        (list (car closest) (cadr closest) 0.0)
                      display (DT--pt-mid endpoint closest))
                (setq candidates
                  (cons
                    (list display closest centerB endpoint closest)
                    candidates)))))))))
  candidates
)

(defun DT--warning-best-contact
  (markerPoint centerA centerB / candidate score bestScore best)
  (foreach candidate (DT--warning-contact-candidates centerA centerB)
    (setq score
      (DT--distance-xy markerPoint (car candidate)))
    (if (or (null bestScore) (< score bestScore))
      (setq bestScore score
            best candidate)))
  best
)

(defun DT--warning-adjust-center-points
  (center pts moveCenter oldPoint newPoint / result)
  (if (and (eq center moveCenter) oldPoint newPoint)
    (progn
      (setq result
        (DT--replace-route-point-near
          pts oldPoint newPoint 0.05))
      (if (cadr result)
        (list (car result) (list oldPoint newPoint 0.05))
        (list pts nil)))
    (list pts nil))
)

(defun DT--warning-primary-center
  (centerA centerB armsA armsB widthA widthB)
  (cond
    ((> (length armsA) (length armsB)) centerA)
    ((> (length armsB) (length armsA)) centerB)
    ((>= widthA widthB) centerA)
    (T centerB))
)

(defun DT--warning-fitting-fallback
  (point specs fitWidth / ray insert)
  (if (= (length specs) 1)
    (progn
      (setq ray (caar specs))
      (setq specs
        (DT--add-arm-spec
          (list (- (car ray)) (- (cadr ray)))
          fitWidth
          specs))))
  (if (>= (length specs) 2)
    (progn
      (DT--delete-existing-fittings-at
        point (DT--layer-fitting) (+ fitWidth 1.0))
      (setq insert
        (DT--draw-flex-fitting
          point specs (DT--layer-fitting)))
      (if insert 'FLEX)))
)

(defun DT--merge-connection-warning
  (marker
    / handles centerA centerB markerPoint contact point moveCenter oldPoint newPoint
      ptsA ptsB adjusted shiftA shiftB widthA widthB armsA armsB specs arm
      fitWidth primary primaryLayer primaryMeta sideMm kind fittingExists
      oldMode oldLayer oldElevation oldSide oldSideMm
      *DT_REBUILD_POINT_SHIFT*)
  (setq handles (DT--connection-warning-handles marker)
        centerA (if (car handles) (handent (car handles)) nil)
        centerB (if (cadr handles) (handent (cadr handles)) nil)
        markerPoint (if marker (cdr (assoc 10 (entget marker))) nil))
  (if (and markerPoint
           centerA centerB
           (not (eq centerA centerB))
           (DT--active-center-p centerA)
           (DT--active-center-p centerB)
           (DT--connection-warning-same-elevation-p
             markerPoint centerA centerB)
           (setq contact
             (DT--warning-best-contact markerPoint centerA centerB)))
    (progn
      (setq point      (cadr contact)
            moveCenter (nth 2 contact)
            oldPoint   (nth 3 contact)
            newPoint   (nth 4 contact)
            ptsA       (g365_get_pts centerA)
            ptsB       (g365_get_pts centerB)
            adjusted
              (DT--warning-adjust-center-points
                centerA ptsA moveCenter oldPoint newPoint)
            ptsA       (car adjusted)
            shiftA     (cadr adjusted)
            adjusted
              (DT--warning-adjust-center-points
                centerB ptsB moveCenter oldPoint newPoint)
            ptsB       (car adjusted)
            shiftB     (cadr adjusted)
            widthA     (DT--center-width centerA 1.0)
            widthB     (DT--center-width centerB 1.0)
            armsA      (DT--arms-at-point ptsA point 0.01)
            armsB      (DT--arms-at-point ptsB point 0.01))
      (foreach arm armsA
        (setq specs (DT--add-arm-spec arm widthA specs)))
      (foreach arm armsB
        (setq specs (DT--add-arm-spec arm widthB specs)))
      (setq fitWidth
              (DT--specs-max-width specs (max widthA widthB))
            primary
              (DT--warning-primary-center
                centerA centerB armsA armsB widthA widthB)
            primaryLayer
              (DT--center-layer
                primary (DT--mode-layer (DT--last-mode)))
            primaryMeta (DT--tray-meta primary)
            sideMm
              (if (and primaryMeta
                       (numberp (caddr primaryMeta))
                       (> (caddr primaryMeta) 0.0))
                (caddr primaryMeta)
                (DT--active-side-height-mm))
            oldMode      *DT_ACTIVE_MODE*
            oldLayer     *DT_ACTIVE_LAYER*
            oldElevation (DT--active-elevation)
            oldSide      (DT--active-side-height)
            oldSideMm    (DT--active-side-height-mm)
            *DT_ACTIVE_MODE*
              (if primaryMeta
                (DT--normalize-mode (car primaryMeta))
                (DT--mode-from-layer primaryLayer))
            *DT_ACTIVE_LAYER* primaryLayer
            *DT_ACTIVE_ELEVATION*
              (if (and (caddr markerPoint)
                       (numberp (caddr markerPoint)))
                (caddr markerPoint)
                (DT--entity-elevation primary))
            *DT_ACTIVE_SIDE_HEIGHT_MM* sideMm
            *DT_ACTIVE_SIDE_HEIGHT* (DT--plan-side-height sideMm))
      (DT--ensure-layer
        primaryLayer
        (DT--layer-color-for-name primaryLayer)
        nil)
      (setq kind
        (DT--draw-updated-junction-fitting
          point
          (DT--arm-spec-rays specs)
          specs
          fitWidth))
      (if (null kind)
        (setq kind
          (DT--warning-fitting-fallback point specs fitWidth)))
      (setq fittingExists
        (and kind (DT--live-fitting-at-point-p point fitWidth)))
      (if fittingExists
        (progn
          (if shiftA
            (progn
              (DT--retarget-center-cuts
                centerA (car shiftA) (cadr shiftA) (caddr shiftA))
              (DT--set-center-points centerA ptsA)))
          (if shiftB
            (progn
              (DT--retarget-center-cuts
                centerB (car shiftB) (cadr shiftB) (caddr shiftB))
              (DT--set-center-points centerB ptsB)))
          (DT--add-plus-cut centerA point fitWidth)
          (DT--add-plus-cut centerB point fitWidth)
          (setq *DT_REBUILD_POINT_SHIFT* shiftA)
          (DT--rebuild-center-pieces centerA widthA nil)
          (setq *DT_REBUILD_POINT_SHIFT* shiftB)
          (DT--rebuild-center-pieces centerB widthB nil)
          (setq *DT_REBUILD_POINT_SHIFT* nil)
          (DT--safe-delete-ent marker)
          (DT--refresh-connection-warnings-for-centers
            (list centerA centerB))))
      (setq *DT_ACTIVE_MODE* oldMode
            *DT_ACTIVE_LAYER* oldLayer
            *DT_ACTIVE_ELEVATION* oldElevation
            *DT_ACTIVE_SIDE_HEIGHT* oldSide
            *DT_ACTIVE_SIDE_HEIGHT_MM* oldSideMm)
      (if fittingExists
        (list kind centerA centerB point)))))

(defun C:DT_PALETTE_MERGE
  (/ rec path state requestId ss marker undoToken result status)
  (vl-load-com)
  (setq rec (DT--palette-open-state))
  (if rec
    (setq path      (car rec)
          state     (cadr rec)
          requestId (DT--palette-state-get "REQUEST_ID" state)))
  (setq ss     (DT--pickfirst-selection)
        marker (DT--selected-connection-warning ss))
  (cond
    ((null marker)
      (setq status
        "Birlestirmek icin once kirmizi cakisma kuresini secin."))
    (T
      (setq undoToken (DEG:UNDO-GROUP-BEGIN)
            result
              (vl-catch-all-apply
                'DT--merge-connection-warning
                (list marker)))
      (DEG:UNDO-GROUP-END undoToken)
      (cond
        ((vl-catch-all-error-p result)
          (setq status
            (strcat
              "Birlestirme hatasi: "
              (vl-catch-all-error-message result))))
        (result
          (setq status
            "Iki tava baglanti blogu ile birlestirildi."))
        (T
          (setq status
            "Kuredeki iki tava birlestirilemedi; tava merkezleri bulunamadi.")))))
  (sssetfirst nil nil)
  (if path
    (progn
      (setq state (DT--palette-state-read path)
            state (DT--palette-state-put "REQUEST" "" state)
            state
              (DT--palette-state-put
                "REQUEST_DONE" (if requestId requestId "") state)
            state (DT--palette-state-put "STATUS" status state))
      (DT--palette-state-write path state)))
  (princ (strcat "\nDT palet: " status))
  (DT--palette-publish-current-selection)
  (princ)
)

(defun DT--sidewall-sync-watched-command-p (cmd)
  (member cmd
    '("STRETCH" "GRIP_STRETCH"
      "MOVE" "GRIP_MOVE"
      "ROTATE" "GRIP_ROTATE"
      "SCALE" "GRIP_SCALE"
      "MIRROR" "ALIGN"
      "COPY" "GRIP_COPY"
      "PASTECLIP" "PASTEORIG" "PASTEBLOCK"))
)

(defun DT--composite-erase-map (/ tray trayHandle entities ent handle handles out)
  (foreach tray (DT--light-all-trays)
    (setq trayHandle (DT--ent-handle tray)
          entities   (cdr (DT--tray-group-entities tray))
          handles    nil)
    (foreach ent entities
      (setq handle (DT--ent-handle ent))
      (if handle (setq handles (cons handle handles))))
    (if (and trayHandle handles)
      (setq out (cons (cons trayHandle handles) out))))
  out
)

(defun DT--sidewall-sync-command-start (reactor info / cmd)
  (if (not *DT_SIDEWALL_SYNC_BUSY*)
    (progn
      (setq cmd (DT--sidewall-sync-command-name info))
      (DT--composite-stretch-selection-begin cmd)
      (cond
        ((= cmd "ERASE")
          (setq *DT_COMPOSITE_ERASE_BEFORE* (DT--composite-erase-map)))
        ((DT--sidewall-sync-watched-command-p cmd)
          (setq *DT_SIDEWALL_SYNC_COMMAND* cmd
                *DT_SIDEWALL_SYNC_BEFORE* (DT--tray-signature-map)
                *DT_LIGHT_LADDER_BEFORE* (DT--light-ladder-signature-map))))))
  (princ)
)

(defun DT--sidewall-sync-command-finish
  (reactor info / cmd before now rec old tray center changedCenters ladderNow control)
  (setq cmd (DT--sidewall-sync-command-name info))
  (if (= cmd "ERASE") (DT--composite-erase-finish))
  (if (DT--composite-undo-command-p cmd)
    (progn
      (setq *DT_DELETED_HANDLES* nil)
      (vl-catch-all-apply 'DT--light-repair-tray-copies '())
      (vl-catch-all-apply 'DT--light-repair-ladder-copies '())))
  (if (and (not *DT_SIDEWALL_SYNC_BUSY*)
           *DT_SIDEWALL_SYNC_COMMAND*
           (= cmd *DT_SIDEWALL_SYNC_COMMAND*))
    (progn
      (setq *DT_SIDEWALL_SYNC_BUSY* T
            before *DT_SIDEWALL_SYNC_BEFORE*
            now    (DT--tray-signature-map))
      (foreach rec now
        (setq old (assoc (car rec) before))
        (if (and old (not (equal (cdr old) (cdr rec) 0.000001)))
          (progn
            (setq tray (handent (car rec)))
            (if tray
              (progn
                (setq center
                  (DT--sync-center-from-stretched-tray tray (cdr old)))
                (if (and center
                         (not (DT--entity-in-list-p center changedCenters)))
                  (setq changedCenters
                    (append changedCenters (list center))))
                (vl-catch-all-apply
                  'DT--rebuild-tray-sidewall-geometry
                  (list tray)))))))
      (setq ladderNow (DT--light-ladder-signature-map))
      (foreach rec ladderNow
        (setq old (assoc (car rec) *DT_LIGHT_LADDER_BEFORE*))
        (if (and old (not (equal (cdr old) (cdr rec) 0.000001)))
          (progn
            (setq control (handent (car rec)))
            (if control
              (vl-catch-all-apply 'DT--light-rebuild-ladder (list control))))))
      (if (member cmd '("COPY" "GRIP_COPY" "PASTECLIP" "PASTEORIG" "PASTEBLOCK"))
        (progn
          (vl-catch-all-apply 'DT--light-repair-tray-copies '())
          (vl-catch-all-apply 'DT--light-repair-ladder-copies '())
          (vl-catch-all-apply 'DT--light-clean-orphan-tray-visuals '())))
      (if changedCenters
        (vl-catch-all-apply
          'DT--refresh-connection-warnings-for-centers
          (list changedCenters)))
      (setq *DT_SIDEWALL_SYNC_BEFORE* nil
            *DT_LIGHT_LADDER_BEFORE* nil
            *DT_SIDEWALL_SYNC_COMMAND* nil
            *DT_SIDEWALL_SYNC_BUSY* nil)))
  (DT--composite-stretch-selection-end)
  (princ)
)

(defun DT--sidewall-sync-command-cancel (reactor info)
  (DT--composite-stretch-selection-end)
  (setq *DT_SIDEWALL_SYNC_BEFORE* nil
        *DT_LIGHT_LADDER_BEFORE* nil
        *DT_SIDEWALL_SYNC_COMMAND* nil
        *DT_COMPOSITE_ERASE_BEFORE* nil
        *DT_SIDEWALL_SYNC_BUSY* nil)
  (princ)
)

(defun DTT--selection-handles
  (ss / i raw en h out ladderMeta ladderKey representative ladderSeen attached)
  (setq i 0 out nil)
  (if ss
    (while (< i (sslength ss))
      (setq raw         (ssname ss i)
            en
              (if (DT--light-ladder-visual-p raw)
                (DT--light-ladder-controller raw)
                raw)
            ladderMeta  (DT--ladder-meta en)
            attached
              (if ladderMeta
                (or
                  (DT--light-ladder-control-p en)
                  (DT--ladder-attached-group-p en))))
      (cond
        ((DT--light-tray-visual-p raw) nil)
        (ladderMeta
          (if (or attached (DT--ladder-top-cap-entity-p en))
            (progn
              (setq ladderKey (DTT--ladder-key en))
              (if (not (member ladderKey ladderSeen))
                (progn
                  (setq ladderSeen (cons ladderKey ladderSeen)
                        representative
                          (if attached (DT--ladder-top-cap en) en)
                        h (if representative
                            (cdr (assoc 5 (entget representative)))))
                  (if h (setq out (cons h out))))))))
        (T
          (setq h (cdr (assoc 5 (entget en))))
          (if h (setq out (cons h out)))))
      (setq i (1+ i))))
  (reverse out)
)

(defun DT--selected-center-map
  (/ ss i center tray handle out)
  ;; Build the center-to-tray index once per selection. The old palette path
  ;; scanned every center entity again for every selected tray.
  (setq ss
    (ssget "_X"
      (list
        (cons 0 "LWPOLYLINE,POLYLINE")
        (cons 8 (DT--layer-center)))))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq center (ssname ss i))
        (if (and (DT--entity-alive-p center) (DT--active-center-p center))
          (foreach tray (DT--linked-trays center)
            (setq handle (if tray (DT--ent-handle tray)))
            (if (and handle (null (assoc handle out)))
              (setq out (cons (cons handle center) out)))))
        (setq i (1+ i)))))
  out
)

(defun DT--light-repair-tray-meta-from-centers
  (/ centerMap centerRec tray centerMeta trayMeta centerSide traySide count)
  (setq centerMap (DT--selected-center-map))
  (foreach centerRec centerMap
    (setq tray       (handent (car centerRec))
          centerMeta (DT--tray-meta (cdr centerRec))
          trayMeta   (DT--tray-meta tray)
          centerSide (if (and centerMeta (numberp (caddr centerMeta)))
                       (caddr centerMeta))
          traySide   (if (and trayMeta (numberp (caddr trayMeta)))
                       (caddr trayMeta)))
    (if (and centerMeta
             (not (DT--tray-piece-override-p tray))
             (> centerSide 0.0)
             (or (null traySide) (not (equal centerSide traySide 0.000001))))
      (progn
        (DT--set-tray-meta-one
          tray
          (car centerMeta)
          (cadr centerMeta)
          centerSide
          (nth 3 centerMeta))
        (if (DT--rebuild-tray-sidewall-geometry tray)
          (setq count (1+ (if count count 0)))))))
  (if count count 0)
)

(defun DT--selected-info
  (ss /
    i raw ent ed typ handle centerMap centerRec filteredTrays
    centers fittings looseTrays ladders
    centerSeen fittingSeen traySeen ladderSeen
    ladderMeta ladderKey)
  (if (and ss (= (type ss) 'PICKSET))
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq raw (ssname ss i)
              ent
                (cond
                  ((DT--light-tray-visual-p raw)
                    (DT--light-tray-visual-owner raw))
                  ((DT--light-ladder-visual-p raw)
                    (DT--light-ladder-controller raw))
                  (T raw))
              ed         (if ent (entget ent '("DT_FITTING")) nil)
              typ        (if ed (cdr (assoc 0 ed)) nil)
              handle     (if ent (DT--ent-handle ent))
              ladderMeta (if ent (DT--ladder-meta ent)))
        (cond
          (ladderMeta
            (setq ladderKey
              (if (DT--light-ladder-control-p ent)
                handle
                (DT--ladder-selection-key ent)))
            (if (and ladderKey (not (member ladderKey ladderSeen)))
              (setq ladderSeen (cons ladderKey ladderSeen)
                    ladders    (cons ent ladders))))
          ((DT--center-layer-p ent)
            (if (and handle (not (member handle centerSeen)))
              (setq centerSeen (cons handle centerSeen)
                    centers    (cons ent centers))))
          ((DT--visible-tray-p ent)
            (if (and handle (not (member handle traySeen)))
              (setq traySeen   (cons handle traySeen)
                    looseTrays (cons ent looseTrays))))
          ((and (= typ "INSERT") (DT--fitting-insert-p ent))
            (if (and handle (not (member handle fittingSeen)))
              (setq fittingSeen (cons handle fittingSeen)
                    fittings   (cons ent fittings)))))
        (setq i (1+ i)))))
  ;; A window selection can contain both the hidden center route and its tray
  ;; pieces. In that case the explicit center selection owns the operation;
  ;; otherwise a picked tray remains an individual palette edit.
  (if (and centers looseTrays)
    (progn
      (setq centerMap (DT--selected-center-map))
      (foreach ent looseTrays
        (setq centerRec (assoc (DT--ent-handle ent) centerMap))
        (if (not
              (and centerRec
                   (member
                     (DT--ent-handle (cdr centerRec))
                     centerSeen)))
          (setq filteredTrays (cons ent filteredTrays))))
      (setq looseTrays (reverse filteredTrays))))
  (list
    (reverse centers)
    (reverse fittings)
    (reverse looseTrays)
    (reverse ladders))
)

(defun C:DTHAFIF (/ trayCount ladderCount)
  (vl-load-com)
  (princ "\nDTHAFIF: Cizimdeki eski DT tava ve merdivenleri hafif yapiya donusturuyor...")
  (setq *DT_SIDEWALL_SYNC_BUSY* T)
  (setq trayCount   (DT--light-migrate-all-trays)
        ladderCount (DT--light-migrate-all-ladders))
  (DT--light-repair-tray-copies)
  (DT--light-repair-ladder-copies)
  (DT--light-clean-orphan-tray-visuals)
  (DT--light-repair-tray-meta-from-centers)
  (setq *DT_SIDEWALL_SYNC_BUSY* nil)
  (DT--ensure-composite-pickstyle)
  (vl-catch-all-apply 'setvar (list "GRIPOBJLIMIT" 100))
  (princ
    (strcat
      "\nDTHAFIF tamam: "
      (itoa trayCount) " tava, "
      (itoa ladderCount) " merdiven donusturuldu."))
  (princ)
)

