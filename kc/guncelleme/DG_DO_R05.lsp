(defun deg-csv-join-fields (lst / out x)
  (setq out "")
  (foreach x lst
    (setq out
          (if (= out "")
            (if x x "")
            (strcat out ";" (if x x ""))))
  )
  out
)

(defun deg-csv-counted-item->pair (s / txt len i ch cnt name)
  (setq txt (vl-string-trim " \t\r\n" (if s s "")))
  (setq len (strlen txt)
        i   1
        cnt "")
  (while (and (<= i len)
              (setq ch (substr txt i 1))
              (>= (ascii ch) 48)
              (<= (ascii ch) 57))
    (setq cnt (strcat cnt ch)
          i   (1+ i))
  )
  (if (and (> (strlen cnt) 0)
           (<= i len)
           (or (= (substr txt i 1) "x")
               (= (substr txt i 1) "X")))
    (setq name (vl-string-trim " \t\r\n" (substr txt (1+ i))))
    (progn
      (setq cnt  "")
      (setq name txt)
    )
  )
  (list cnt name)
)

(defun deg-csv-counted-string->flat-list (s / items item out pair)
  (setq out '())
  (if (and s (/= (vl-string-trim " \t\r\n" s) ""))
    (progn
      (setq items (degk--split-commas s))
      (foreach item items
        (if (/= (vl-string-trim " \t\r\n" item) "")
          (progn
            (setq pair (deg-csv-counted-item->pair item))
            (setq out  (append out pair))
          )
        )
      )
    )
  )
  out
)

(defun deg-csv-counted-list->flat-list (lst / item out pair)
  (setq out '())
  (foreach item lst
    (if (/= (vl-string-trim " \t\r\n" (if item item "")) "")
      (progn
        (setq pair (deg-csv-counted-item->pair item))
        (setq out  (append out pair))
      )
    )
  )
  out
)

(defun deg-csv-counted-flat-list->fields (flat pairCount / out n)
  (setq out (if flat flat '()))
  (setq n   (fix (/ (length out) 2)))
  (while (< n pairCount)
    (setq out (append out (list "" ""))
          n   (1+ n))
  )
  (deg-csv-join-fields out)
)

(defun deg-csv-counted-string->fields (s / flat)
  (setq flat (deg-csv-counted-string->flat-list s))
  (deg-csv-counted-flat-list->fields flat (fix (/ (length flat) 2)))
)

(defun deg-csv-counted-list->fields (lst / flat)
  (setq flat (deg-csv-counted-list->flat-list lst))
  (deg-csv-counted-flat-list->fields flat (fix (/ (length flat) 2)))
)

(defun deg-csv-build-paired-headers (prefix pairCount / out i)
  (setq out '()
        i   1)
  (while (<= i pairCount)
    (setq out (append out (list (strcat prefix (itoa i) " Adet")
                                (strcat prefix (itoa i) " Adi")))
          i   (1+ i))
  )
  (deg-csv-join-fields out)
)


