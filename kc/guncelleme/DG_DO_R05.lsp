(defun degk--assoc-put (code val lst / a)
  (if (setq a (assoc code lst))
    (subst (cons code val) a lst)
    (append lst (list (cons code val)))
  )
)

(defun degk--xf-pt (pt ip sx sy sz rot / x y z x1 y1 z1 c s xr yr)
  (setq x (car pt) y (cadr pt) z (if (caddr pt) (caddr pt) 0.0))
  (setq x1 (* x sx))
  (setq y1 (* y sy))
  (setq z1 (* z sz))
  (setq c (cos rot) s (sin rot))
  (setq xr (- (* x1 c) (* y1 s)))
  (setq yr (+ (* x1 s) (* y1 c)))
  (list (+ (car ip) xr) (+ (cadr ip) yr) (+ (if (caddr ip) (caddr ip) 0.0) z1))
)

(defun degk--block-attdef-map (blkName / btr e d tag map)
  (setq map nil)
  (if (and blkName (/= blkName ""))
    (progn
      (setq btr (tblobjname "BLOCK" blkName))
      (if btr
        (progn
          (setq e (entnext btr))
          (while (and e (/= (cdr (assoc 0 (entget e))) "ENDBLK"))
            (setq d (entget e))
            (if (= (cdr (assoc 0 d)) "ATTDEF")
              (progn
                (setq tag (cdr (assoc 2 d)))
                (if tag (setq map (cons (cons (strcase tag) d) map)))
              )
            )
            (setq e (entnext e))
          )
        )
      )
    )
  )
  map
)

(defun degk--reset-insert-attrs (insE / insD insObj blkName effName ip rot sx sy sz amap a ad tag def p10 p11 new10 new11)
  (if (and insE (= (type insE) 'ENAME))
    (progn
      (setq insD (entget insE))
      (if (= (cdr (assoc 0 insD)) "INSERT")
        (progn
          (setq blkName (cdr (assoc 2 insD)))
          (setq ip  (cdr (assoc 10 insD)))
          (setq rot (cdr (assoc 50 insD))) (if (null rot) (setq rot 0.0))
          (setq sx  (cdr (assoc 41 insD))) (if (null sx) (setq sx 1.0))
          (setq sy  (cdr (assoc 42 insD))) (if (null sy) (setq sy sx))
          (setq sz  (cdr (assoc 43 insD))) (if (null sz) (setq sz 1.0))
          (setq amap (degk--block-attdef-map blkName))
          (if (null amap)
            (progn
              (setq insObj (vl-catch-all-apply 'vlax-ename->vla-object (list insE)))
              (if (not (vl-catch-all-error-p insObj))
                (progn
                  (setq effName (degk--blockname insObj))
                  (if (and effName (/= effName blkName))
                    (setq amap (degk--block-attdef-map effName))
                  )
                )
              )
            )
          )
          (setq a (entnext insE))
          (while (and a (/= (cdr (assoc 0 (entget a))) "SEQEND"))
            (setq ad (entget a))
            (if (= (cdr (assoc 0 ad)) "ATTRIB")
              (progn
                (setq ad (degk--assoc-put 50 0.0 ad))
                (setq tag (cdr (assoc 2 ad)))
                (if (and tag amap)
                  (progn
                    (setq def (cdr (assoc (strcase tag) amap)))
                    (if def
                      (progn
                        (setq p10 (cdr (assoc 10 def)))
                        (setq p11 (cdr (assoc 11 def)))
                        (if p10
                          (progn
                            (setq new10 (degk--xf-pt p10 ip sx sy sz rot))
                            (setq ad (degk--assoc-put 10 new10 ad))
                          )
                        )
                        (if (and p11 (assoc 11 ad))
                          (progn
                            (setq new11 (degk--xf-pt p11 ip sx sy sz rot))
                            (setq ad (degk--assoc-put 11 new11 ad))
                          )
                        )
                      )
                    )
                  )
                )
                (entmod ad)
                (entupd a)
              )
            )
            (setq a (entnext a))
          )
        )
      )
    )
  )
  nil
)
(defun degk--pad (n width / s)
  (setq s (itoa n))
  (while (< (strlen s) width)
    (setq s (strcat "0" s))
  )
  s
)

(defun degk--digit-string-p (s / i ch len ok)
  (setq s (vl-string-trim " \t\r\n" (if s s "")))
  (setq len (strlen s) i 1 ok (> len 0))
  (while (and ok (<= i len))
    (setq ch (substr s i 1))
    (if (or (< (ascii ch) 48) (> (ascii ch) 57))
      (setq ok nil)
    )
    (setq i (1+ i))
  )
  ok
)

(defun degk--tail-prefix-number (s / i ch num len)
  (setq s (vl-string-trim " \t\r\n" (if s s "")))
  (setq len (strlen s) num "" i len)
  (while (and (> i 0)
              (setq ch (substr s i 1))
              (>= (ascii ch) 48) (<= (ascii ch) 57))
    (setq num (strcat ch num))
    (setq i (1- i))
  )
  (list (substr s 1 i) num)
)

(defun degk--expand-sira-no (s / pos leftPart rightPart i ch numL numR prefixL startN endN width res n len parts info)
  (if (or (null s) (= s "")) (setq s ""))
  (setq s (vl-string-trim " \t\r\n" s))
  (setq pos (vl-string-search ",...," s))
  (if (null pos)
    (progn
      (setq parts (degk--split-commas s))
      (if (> (length parts) 1)
        (progn
          (setq info (degk--tail-prefix-number (car parts)))
          (setq prefixL (car info)
                numL    (cadr info)
                width   (strlen numL))
          (mapcar
            '(lambda (p / q)
               (setq q (vl-string-trim " \t\r\n" (if p p "")))
               (if (and (> width 0) (/= prefixL "") (degk--digit-string-p q))
                 (strcat prefixL (degk--pad (atoi q) (max width (strlen q))))
                 q
               )
             )
            parts
          )
        )
        (list s)
      )
    )
    (progn
      (setq leftPart  (substr s 1 pos))
      (setq rightPart (substr s (+ pos 6)))

      (setq len (strlen leftPart) numL "" i len)
      (while (and (> i 0)
                  (setq ch (substr leftPart i 1))
                  (>= (ascii ch) 48) (<= (ascii ch) 57))
        (setq numL (strcat ch numL))
        (setq i (1- i))
      )
      (setq prefixL (substr leftPart 1 i))

      (setq len (strlen rightPart) numR "" i 1)
      (while (and (<= i len)
                  (setq ch (substr rightPart i 1))
                  (>= (ascii ch) 48) (<= (ascii ch) 57))
        (setq numR (strcat numR ch))
        (setq i (1+ i))
      )

      (if (and (> (strlen numL) 0) (> (strlen numR) 0))
        (progn
          (setq startN (atoi numL)
                endN   (atoi numR)
                width  (max (strlen numL) (strlen numR)))
          (if (> startN endN)
            (list s)
            (progn
              (setq res '() n startN)
              (while (<= n endN)
                (setq res (cons (strcat prefixL (degk--pad n width)) res))
                (setq n (1+ n))
              )
              (reverse res)
            )
          )
        )
        (list s)
      )
    )
  )
)

(defun degk--pt-eq? (p q eps /)
  (while (and (listp p) (= (length p) 1) (listp (car p)))
    (setq p (car p))
  )
  (while (and (listp q) (= (length q) 1) (listp (car q)))
    (setq q (car q))
  )
  (and (listp p) (listp q)
       (numberp (car p)) (numberp (cadr p))
       (numberp (car q)) (numberp (cadr q))
       (<= (abs (- (car p) (car q))) eps)
       (<= (abs (- (cadr p) (cadr q))) eps))
)

(defun degk--under-pts (basePt dx dy len1 len2 / p0 p1 p2 p3 p4 yOff fixedLen)
  (setq yOff    (DEG:CFG-DK-SIGNED-NUM-OR 'DK_UNDER_Y_OFFSET 0.0)
        fixedLen (* 90.0 (DEG:PLAN-UNIT-SCALE)))
  (setq basePt (list (car basePt) (+ (cadr basePt) yOff) 0.0))
  (setq p0 (list (car basePt) (- (cadr basePt) fixedLen) 0.0))
  (setq p1 (list (car p0) (+ (cadr p0) len1) 0.0)) ;; uc: Y = baseY - 20 cm
  (setq p2 (list (+ (car p1) dx) (- (cadr p1) dy) 0.0))
  (setq p3 (list (car p2) (- (cadr p2) len2) 0.0))
  (setq p4 (list (+ (car p3) fixedLen) (cadr p3) 0.0))
  (list p0 p1 p2 p3 p4)
)

(defun degk--drop-under-rail-pts (pts drop / i p z out)
  ;; p1 ve p2 blok tarafindaki dirsek uclaridir; sabit kalir.
  ;; p0, p3 ve p4 iki blok arasindaki ust yatay hatti olusturur.
  (setq i 0
        out nil
        drop (if (and (numberp drop) (> drop 0.0)) drop 0.0))
  (foreach p pts
    (setq z (if (and (caddr p) (numberp (caddr p))) (caddr p) 0.0))
    (if (and (> drop 0.0) (member i '(0 3 4)))
      (setq p (list (car p) (- (cadr p) drop) z))
    )
    (setq out (cons p out)
          i (1+ i))
  )
  (reverse out)
)

