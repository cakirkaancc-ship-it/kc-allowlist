(defun DEG:CMD-ADD-UNIQUE (x lst)
  (if (and x (/= x "") (not (member x lst)))
    (cons x lst)
    lst
  )
)

(defun DEG:CMD-UNREGISTER (alias / a)
  (setq a (DEG:CMD-NORM alias))
  (if (DEG:CMD-VALID-P a)
    (set (read (strcat "C:" a)) nil)
  )
)

(defun DEG:CMD-REGISTER (alias fnsym / a)
  (setq a (DEG:CMD-NORM alias))
  (if (DEG:CMD-VALID-P a)
    (eval
      (list 'defun
            (read (strcat "C:" a))
            '()
            (list
              'if
              '(KC:InitLicense)
              (list
                'progn
                '(DEG:AUTO-PLAN-UNIT-FROM-INSUNITS)
                (list fnsym))
              '(KC:Blocked))
      )
    )
  )
)

(defun DEG:CMD-CLEAR-ALIASES (/ aliases p a)
  (setq aliases (DEG:CMD-DEFAULT-ALIASES))
  (if (and (boundp '*DEG_CMD_ACTIVE_ALIASES*) *DEG_CMD_ACTIVE_ALIASES*)
    (foreach a *DEG_CMD_ACTIVE_ALIASES*
      (setq aliases (DEG:CMD-ADD-UNIQUE (DEG:CMD-NORM a) aliases))
    )
  )
  (foreach p (DEG:CMD-PAIR-LIST)
    (setq aliases (DEG:CMD-ADD-UNIQUE (DEG:CMD-NORM (car p)) aliases))
  )
  (foreach a aliases
    (DEG:CMD-UNREGISTER a)
  )
)

(defun DEG:CMD-APPLY-ALIASES (/ pairs p active a)
  (setq pairs (DEG:CMD-PAIR-LIST))
  (DEG:CMD-CLEAR-ALIASES)
  (setq active nil)
  (foreach p pairs
    (setq a (DEG:CMD-NORM (car p)))
    (if (DEG:CMD-VALID-P a)
      (progn
        (DEG:CMD-REGISTER a (cdr p))
        (setq active (DEG:CMD-ADD-UNIQUE a active))
      )
    )
  )
  (if (not (member "DC" active))
    (DEG:CMD-REGISTER "DC" 'DC_ORIG)
  )
  (setq *DEG_CMD_ACTIVE_ALIASES* active)
  T
)

