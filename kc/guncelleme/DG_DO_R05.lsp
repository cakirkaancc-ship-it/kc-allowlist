(defun degk--pts-x-bounds (pts / p minX maxX)
  (foreach p pts
    (if (and (listp p) (numberp (car p)))
      (progn
        (if (or (null minX) (< (car p) minX)) (setq minX (car p)))
        (if (or (null maxX) (> (car p) maxX)) (setq maxX (car p)))
      )
    )
  )
  (if (and minX maxX) (list minX maxX) nil)
)

(defun degk--pts-at-x (pts targetX eps / p out)
  (setq eps (if (and (numberp eps) (> eps 0.0)) eps 1e-6))
  (if (numberp targetX)
    (foreach p pts
      (if (and (listp p)
               (numberp (car p))
               (numberp (cadr p))
               (<= (abs (- (car p) targetX)) eps))
        (setq out (cons p out)))))
  (reverse out)
)

(defun degk--pts-min-y (pts / p minY)
  (foreach p pts
    (if (and (listp p) (numberp (cadr p)))
      (if (or (null minY) (< (cadr p) minY))
        (setq minY (cadr p))
      )
    )
  )
  minY
)

(defun degk--move-lowest-rail-to-y (pts targetY / minY p z out)
  ;; Yalniz en alttaki yatay ray dugumlerini yeni seviyeye indirir;
  ;; blok temas/dirsek noktalari yerinde kalir.
  (setq minY (degk--pts-min-y pts))
  (if (and (numberp minY) (numberp targetY))
    (progn
      (foreach p pts
        (if (and (listp p)
                 (numberp (cadr p))
                 (<= (abs (- (cadr p) minY)) 1e-6))
          (progn
            (setq z (if (and (caddr p) (numberp (caddr p)))
                      (caddr p)
                      0.0))
            (setq p (list (car p) targetY z))
          )
        )
        (setq out (cons p out))
      )
      (reverse out)
    )
    pts
  )
)

(defun degk--close-under-pts (pts gap / rest body p minX leftExt leftX firstPt firstZ endPt endX endY z)
  (setq gap (if (numberp gap) (abs gap) 0.0)
        leftExt (degk--normal-group-left-extension))
  ;; Son p4 noktasi yalnizca saga dogru cikinti olusturur. Onu atip
  ;; son dikey ucundan asagi inerek alt hatti ayni polyline'a ekle.
  (setq rest pts
        body nil)
  (while (and rest (cdr rest))
    (setq body (cons (car rest) body)
          rest (cdr rest))
  )
  (setq body (reverse body))
  (foreach p body
    (if (and (listp p) (numberp (car p)) (numberp (cadr p)))
      (if (or (null minX) (< (car p) minX)) (setq minX (car p)))
    )
  )
  ;; Iki acik ucu fiziksel olarak 400 cm sola uzat. Ust hatta mevcut
  ;; ilk dugumu tasimak yerine yeni yatay dugum ekle; boylece capraz olusmaz.
  (setq leftX
    (if (and minX (> leftExt 1e-9))
      (- minX leftExt)
      minX))
  (if (and body leftX (> leftExt 1e-9))
    (progn
      (setq firstPt (car body)
            firstZ (if (and (caddr firstPt) (numberp (caddr firstPt)))
                     (caddr firstPt)
                     0.0)
            body (cons (list leftX (cadr firstPt) firstZ) body))
    )
  )
  (setq endPt (if body (last body) nil))
  (if (and endPt minX (> gap 1e-9))
    (progn
      (setq endX (car endPt)
            endY (cadr endPt)
            z (if (and (caddr endPt) (numberp (caddr endPt))) (caddr endPt) 0.0))
      (append
        body
        (list
          (list endX (- endY gap) z)
          (list leftX (- endY gap) z)))
    )
    body
  )
)

(defun degk--trim-at-last-block-contact (pts / rev)
  ;; Son blok icin p1 temas noktasindan sonra gelen p2-p3-p4; asagi donus,
  ;; geri donen hat ve sag cikintidir. Bunlari atarak polyline'i blokta bitir.
  (if (and pts (> (length pts) 3))
    (progn
      (setq rev (reverse pts))
      (reverse (cdddr rev))
    )
    pts
  )
)

(defun degk--extend-under-rails-left (pts leftX / firstPt lastPt z rev)
  ;; Etiket konumu degismeden, ust ve alt yatay hattin sol ucunu
  ;; ayni kattaki ilk loopun sol uc hizasina getir.
  (if (and pts (cdr pts) (numberp leftX))
    (progn
      (setq firstPt (car pts)
            lastPt  (last pts))
      (if (and (listp firstPt) (listp lastPt))
        (progn
          (setq z (if (and (caddr firstPt) (numberp (caddr firstPt)))
                    (caddr firstPt)
                    0.0)
                pts (cons (list leftX (cadr firstPt) z) (cdr pts))
                rev (reverse pts)
                z (if (and (caddr lastPt) (numberp (caddr lastPt)))
                    (caddr lastPt)
                    0.0)
                rev (cons (list leftX (cadr lastPt) z) (cdr rev))
                pts (reverse rev))
        )
      )
    )
  )
  pts
)

(defun degk--loop-left-fillet-data
  (pts radius direction / n firstPt secondPt prevPt lastPt rightX z0 z1 firstTip firstTan lastTan lastTip rest body outPts outBulges i bulgeValue)
  ;; Iki paralel loop rayinin sol acik uclarini ayni LWPOLYLINE icinde
  ;; gercek 90 derece yaylarla GR katina dogru cevirir. Ust yay soldaki,
  ;; alt yay sagdaki kombine dik hatta baglanir.
  (setq n         (length pts)
        radius    (if (numberp radius) (abs radius) 0.0)
        direction (if (and (numberp direction) (> direction 0.0)) 1.0 -1.0))
  (if (and (>= n 4) (> radius 1e-9))
    (progn
      (setq firstPt  (car pts)
            secondPt (cadr pts)
            prevPt   (nth (- n 2) pts)
            lastPt   (last pts))
      (if (and
            (listp firstPt) (listp secondPt) (listp prevPt) (listp lastPt)
            (numberp (car firstPt))  (numberp (cadr firstPt))
            (numberp (car secondPt)) (numberp (cadr secondPt))
            (numberp (car prevPt))   (numberp (cadr prevPt))
            (numberp (car lastPt))   (numberp (cadr lastPt))
            (<= (abs (- (cadr firstPt) (cadr secondPt))) 1e-6)
            (<= (abs (- (cadr prevPt) (cadr lastPt))) 1e-6)
            (<= (abs (- (car firstPt) (car lastPt))) 1e-6)
            (>= (- (car secondPt) (car firstPt)) 0.0)
            (>= (- (car prevPt) (car lastPt)) radius))
        (progn
          (setq rightX (car firstPt)
                z0 (if (and (caddr firstPt) (numberp (caddr firstPt)))
                     (caddr firstPt) 0.0)
                z1 (if (and (caddr lastPt) (numberp (caddr lastPt)))
                     (caddr lastPt) 0.0)
                rest (cdr pts)
                body nil)
          (if (> direction 0.0)
            ;; GF altinda: ust loop sag, alt loop sol kombine hatta baglanir.
            (setq firstTip
                    (list rightX
                          (+ (cadr firstPt) radius)
                          z0)
                  firstTan
                    (list (+ rightX radius) (cadr firstPt) z0)
                  lastTan
                    (list rightX (cadr lastPt) z1)
                  lastTip
                    (list (- rightX radius)
                          (+ (cadr lastPt) radius)
                          z1))
            ;; GF ve ustunde: ust loop sol, alt loop sag kombine hatta baglanir.
            (setq firstTip
                    (list (- rightX radius)
                          (- (cadr firstPt) radius)
                          z0)
                  firstTan
                    (list rightX (cadr firstPt) z0)
                  lastTan
                    (list (+ rightX radius) (cadr lastPt) z1)
                  lastTip
                    (list rightX
                          (- (cadr lastPt) radius)
                          z1)))
          ;; Ilk ve son eski acik dugumleri at; aradaki tum loop geometrisi kalir.
          (while (and rest (cdr rest))
            (setq body (cons (car rest) body)
                  rest (cdr rest)))
          (setq body    (reverse body)
                outPts  (append (list firstTip firstTan) body (list lastTan lastTip))
                n       (length outPts)
                i       0
                outBulges nil
                bulgeValue 0.414213562373095)
          (while (< i n)
            (setq outBulges
              (cons
                (cond
                  ;; Yaylar dik hatta dikey, loop rayina yatay teget olur.
                  ((= i 0) (* direction bulgeValue))
                  ((= i (- n 2)) (* (- direction) bulgeValue))
                  (T 0.0))
                outBulges)
              i (1+ i)))
          ;; Ucuncu sonuc kombine dik hatlarin gercek temas noktalaridir;
          ;; dorduncu sonuc sonraki looplar icin ortak sag ankraj X'idir.
          (list outPts (reverse outBulges) (list firstTip lastTip) rightX)
        )
        nil)
    )
    nil)
)

(defun degk--loop-left-square-data
  (pts radius direction / n firstPt secondPt prevPt lastPt rightX z0 z1 firstTip firstTan firstCorner lastTan lastTip lastCorner rest body outPts outBulges i)
  ;; Ilk/son loopta yuvarlak fillet yerine ayni temas noktalarini koruyan
  ;; filletsiz 90 derece dirsek kurar. Boylece loop multiline ucuna gelir,
  ;; birleþik dik hat ise uzamaz.
  (setq n         (length pts)
        radius    (if (numberp radius) (abs radius) 0.0)
        direction (if (and (numberp direction) (> direction 0.0)) 1.0 -1.0))
  (if (and (>= n 4) (> radius 1e-9))
    (progn
      (setq firstPt  (car pts)
            secondPt (cadr pts)
            prevPt   (nth (- n 2) pts)
            lastPt   (last pts))
      (if (and
            (listp firstPt) (listp secondPt) (listp prevPt) (listp lastPt)
            (numberp (car firstPt))  (numberp (cadr firstPt))
            (numberp (car secondPt)) (numberp (cadr secondPt))
            (numberp (car prevPt))   (numberp (cadr prevPt))
            (numberp (car lastPt))   (numberp (cadr lastPt))
            (<= (abs (- (cadr firstPt) (cadr secondPt))) 1e-6)
            (<= (abs (- (cadr prevPt) (cadr lastPt))) 1e-6)
            (<= (abs (- (car firstPt) (car lastPt))) 1e-6)
            (>= (- (car secondPt) (car firstPt)) 0.0)
            (>= (- (car prevPt) (car lastPt)) radius))
        (progn
          (setq rightX (car firstPt)
                z0 (if (and (caddr firstPt) (numberp (caddr firstPt)))
                     (caddr firstPt) 0.0)
                z1 (if (and (caddr lastPt) (numberp (caddr lastPt)))
                     (caddr lastPt) 0.0)
                rest (cdr pts)
                body nil)
          (if (> direction 0.0)
            (setq firstTip (list rightX (+ (cadr firstPt) radius) z0)
                  firstTan (list (+ rightX radius) (cadr firstPt) z0)
                  lastTan  (list rightX (cadr lastPt) z1)
                  lastTip  (list (- rightX radius) (+ (cadr lastPt) radius) z1))
            (setq firstTip (list (- rightX radius) (- (cadr firstPt) radius) z0)
                  firstTan (list rightX (cadr firstPt) z0)
                  lastTan  (list (+ rightX radius) (cadr lastPt) z1)
                  lastTip  (list rightX (- (cadr lastPt) radius) z1)))
          (setq firstCorner (list (car firstTip) (cadr firstTan) z0)
                lastCorner  (list (car lastTip) (cadr lastTan) z1))
          (while (and rest (cdr rest))
            (setq body (cons (car rest) body)
                  rest (cdr rest)))
          (setq body   (reverse body)
                outPts (append
                         (list firstTip firstCorner firstTan)
                         body
                         (list lastTan lastCorner lastTip))
                i 0
                outBulges nil)
          (while (< i (length outPts))
            (setq outBulges (cons 0.0 outBulges)
                  i (1+ i)))
          (list outPts (reverse outBulges) (list firstTip lastTip) rightX))
        nil))
    nil)
)

(defun degk--loop-record-mouth-y (rec / pts firstPt lastPt)
  ;; Loopun diger geometrisinden etkilenmeden kombine dik hatta bakan iki
  ;; agiz ucunun orta Y degerini verir.
  (setq pts (cadr rec))
  (if (and (listp pts)
           (>= (length pts) 2)
           (setq firstPt (car pts))
           (setq lastPt (last pts))
           (listp firstPt) (listp lastPt)
           (numberp (cadr firstPt))
           (numberp (cadr lastPt)))
    (/ (+ (cadr firstPt) (cadr lastPt)) 2.0)
    nil)
)

(defun degk--nearest-point-by-x (pt targets / target score bestScore best)
  (if (and (listp pt) (numberp (car pt)))
    (foreach target targets
      (if (and (listp target) (numberp (car target)) (numberp (cadr target)))
        (progn
          (setq score (abs (- (car pt) (car target))))
          (if (or (null bestScore) (< score bestScore))
            (setq bestScore score best target))))))
  best
)

(defun degk--square-existing-loop-record
  (rec targetPoints / oldEnt pts layer color n firstTip lastTip firstTarget lastTarget middle rev firstTan lastTan z0 z1 firstCorner lastCorner newPts newBulges i beforeEnt afterEnt makeRes)
  ;; Once filletli cizilmis bir loopun yalniz iki agiz yayini kare 90 dereceye
  ;; cevirir ve uclarini verilen kombine dik hat noktalarina uzatir.
  (setq oldEnt (car rec)
        pts    (cadr rec)
        layer  (nth 3 rec)
        color  (nth 4 rec)
        n      (if (listp pts) (length pts) 0))
  (if (and oldEnt (entget oldEnt) (>= n 4))
    (progn
      (setq firstTip (car pts)
            lastTip  (last pts)
            firstTarget (degk--nearest-point-by-x firstTip targetPoints)
            lastTarget  (degk--nearest-point-by-x lastTip targetPoints)
            middle   (cdr pts)
            rev      (reverse middle)
            middle   (reverse (cdr rev))
            firstTan (car middle)
            lastTan  (last middle))
      (if (and (listp firstTip) (listp lastTip)
               (listp firstTan) (listp lastTan)
               (numberp (car firstTip)) (numberp (cadr firstTip))
               (numberp (car lastTip))  (numberp (cadr lastTip))
               (numberp (cadr firstTan)) (numberp (cadr lastTan)))
        (progn
          (setq z0 (if (and (caddr firstTip) (numberp (caddr firstTip)))
                     (caddr firstTip) 0.0)
                z1 (if (and (caddr lastTip) (numberp (caddr lastTip)))
                     (caddr lastTip) 0.0)
                firstTip
                  (if firstTarget
                    (list (car firstTarget) (cadr firstTarget) z0)
                    firstTip)
                lastTip
                  (if lastTarget
                    (list (car lastTarget) (cadr lastTarget) z1)
                    lastTip)
                firstCorner (list (car firstTip) (cadr firstTan) z0)
                lastCorner  (list (car lastTip) (cadr lastTan) z1)
                newPts      (append
                              (list firstTip firstCorner)
                              middle
                              (list lastCorner lastTip))
                newBulges nil
                i 0)
          (while (< i (length newPts))
            (setq newBulges (cons 0.0 newBulges)
                  i (1+ i)))
          (setq beforeEnt (entlast)
                makeRes
                  (degk--entmake-lwpoly-bulges
                    newPts (reverse newBulges) layer color)
                afterEnt (entlast))
          (if (and makeRes afterEnt (not (eq beforeEnt afterEnt)))
            (progn
              (entdel oldEnt)
              afterEnt)
            nil))
        nil))
    nil)
)

(defun degk--loop-record-replace-entity
  (records oldEnt newEnt / rec out)
  (foreach rec records
    (setq out
      (cons
        (if (and oldEnt newEnt (eq (car rec) oldEnt))
          (cons newEnt (cdr rec))
          rec)
        out)))
  (reverse out)
)

(defun degk--redraw-loop-record-direction
  (rec radius direction / oldEnt rawPts layer color filletData newPts newBulges beforeEnt makeRes newEnt)
  ;; Kayitli ham loop geometrisinden yalniz sol agiz filletlerini yeniden kur.
  ;; Blocklar, terminal ucu, layer ve renk aynen korunur.
  (setq oldEnt (car rec)
        rawPts (nth 5 rec)
        layer  (nth 3 rec)
        color  (nth 4 rec)
        filletData
          (if rawPts
            (degk--loop-left-fillet-data rawPts radius direction)
            nil))
  (if filletData
    (progn
      (setq newPts     (car filletData)
            newBulges (cadr filletData)
            beforeEnt (entlast)
            makeRes
              (degk--entmake-lwpoly-bulges
                newPts newBulges layer color)
            newEnt (entlast))
      (if (and makeRes newEnt (not (eq beforeEnt newEnt)))
        (progn
          (if (and oldEnt (entget oldEnt)) (entdel oldEnt))
          (list newEnt newPts newBulges layer color rawPts direction))
        rec))
    rec)
)

(defun degk--redraw-loop-records-direction
  (records radius direction / rec out)
  (foreach rec records
    (setq out
      (cons
        (degk--redraw-loop-record-direction rec radius direction)
        out)))
  (reverse out)
)

(defun degk--loop-record-point-groups (records / rec pts groups)
  ;; Birlesik dik hat icin her loopun iki gercek fillet agzini dondurur.
  (foreach rec records
    (setq pts (cadr rec))
    (if (and (listp pts) (>= (length pts) 2))
      (setq groups (cons (list (car pts) (last pts)) groups))))
  (reverse groups)
)

(defun degk--delete-entity-list (entities / ent)
  (foreach ent entities
    (if (and ent (entget ent)) (entdel ent)))
  T
)

(defun degk--shift-lwpoly-x
  (ent delta mode / ed item vertexCount arcP bendCount vertexIndex pt moveP out result)
  ;; ALL tum dik hatti tasir. MOUTHS ise loop govdesini sabit tutup fillet/kare
  ;; dirsek ile uc noktalarini birlikte kaydirarak yatay kollari stretch eder.
  (setq ed (if (and ent (entget ent)) (entget ent) nil))
  (if (and ed
           (= (cdr (assoc 0 ed)) "LWPOLYLINE")
           (numberp delta))
    (progn
      (setq vertexCount 0
            arcP nil)
      (foreach item ed
        (if (= (car item) 10)
          (setq vertexCount (1+ vertexCount)))
        (if (and (= (car item) 42)
                 (numberp (cdr item))
                 (> (abs (cdr item)) 1e-9))
          (setq arcP T)))
      (setq bendCount (if arcP 2 3)
            vertexIndex 0
            out nil)
      (foreach item ed
        (if (= (car item) 10)
          (progn
            (setq pt (cdr item)
                  moveP
                    (or (= mode 'ALL)
                        (and (= mode 'MOUTHS)
                             (or (< vertexIndex bendCount)
                                 (>= vertexIndex (- vertexCount bendCount))))))
            (if (and moveP (listp pt) (numberp (car pt)))
              (setq item
                (cons 10
                  (cons (+ (car pt) delta) (cdr pt)))))
            (setq vertexIndex (1+ vertexIndex))))
        (setq out (cons item out)))
      (setq result (entmod (reverse out)))
      (if result
        (progn (entupd ent) T)
        nil))
    nil)
)

(defun degk--stretch-single-loop-to-panel
  (loopRecords riserLimits panelCenterX
   / rec ent leftPt rightPt currentCenter delta originalData)
  ;; Tek GF loopunun yalniz agiz/fillet bolgesini FAP merkezine stretch eder.
  ;; Sonuc: entity, eski DXF, delta, yeni sol/sag X ve iki agiz Y degeri.
  (setq rec (if (= (length loopRecords) 1) (car loopRecords) nil)
        ent (if (listp rec) (car rec) nil)
        leftPt
          (if (and (listp riserLimits) (>= (length riserLimits) 2))
            (nth 0 riserLimits)
            nil)
        rightPt
          (if (and (listp riserLimits) (>= (length riserLimits) 2))
            (nth 1 riserLimits)
            nil))
  (if (and ent (entget ent)
           (numberp panelCenterX)
           (listp leftPt) (listp rightPt)
           (numberp (car leftPt)) (numberp (cadr leftPt))
           (numberp (car rightPt)) (numberp (cadr rightPt)))
    (progn
      (setq currentCenter (/ (+ (car leftPt) (car rightPt)) 2.0)
            delta (- panelCenterX currentCenter)
            originalData (entget ent))
      (if (degk--shift-lwpoly-x ent delta 'MOUTHS)
        (list ent originalData delta
              (+ (car leftPt) delta)
              (+ (car rightPt) delta)
              (cadr leftPt)
              (cadr rightPt))
        nil))
    nil)
)

(defun degk--center-main-riser-in-shaft
  (loopRecords riserLimits riserEntities targetCenterX
   / leftX rightX currentCenter delta tasks rec ent task originals ok)
  ;; Katlar arasi cift kombine hatti saft merkezine al; ona baglanan looplarin
  ;; yalniz sol fillet/dirsek bolumlerini ayni miktarda stretch et.
  (if (and (numberp targetCenterX)
           (listp riserLimits)
           (>= (length riserLimits) 2)
           (numberp (car (nth 0 riserLimits)))
           (numberp (car (nth 1 riserLimits))))
    (progn
      (setq leftX (car (nth 0 riserLimits))
            rightX (car (nth 1 riserLimits))
            currentCenter (/ (+ leftX rightX) 2.0)
            delta (- targetCenterX currentCenter)
            tasks nil)
      (foreach rec loopRecords
        (if (and (listp rec)
                 (setq ent (car rec))
                 (entget ent))
          (setq tasks (cons (list ent 'MOUTHS) tasks))))
      (foreach ent riserEntities
        (if (and ent (entget ent))
          (setq tasks (cons (list ent 'ALL) tasks))))
      (if tasks
        (if (<= (abs delta) 1e-9)
          T
          (progn
            (setq originals nil
                  ok T)
            (foreach task tasks
              (if (not (assoc (car task) originals))
                (setq originals
                  (cons (cons (car task) (entget (car task))) originals))))
            (foreach task tasks
              (if (not (degk--shift-lwpoly-x
                         (car task) delta (cadr task)))
                (setq ok nil)))
            (if (not ok)
              (foreach task originals
                (if (entmod (cdr task)) (entupd (car task)))))
            ok))
        nil))
    nil)
)

(defun degk--first-entity-layer (entities / ent ed layer)
  (foreach ent entities
    (if (and (null layer)
             ent
             (setq ed (entget ent))
             (assoc 8 ed))
      (setq layer (cdr (assoc 8 ed)))))
  layer
)

(defun degk--rebuild-gf-down-riser
  (layer riserLimits loopRecords riserEntities / filletRadius newLoopRecords newLoopPointGroups newRiserLimits newRiserEntities)
  ;; GF-asagi ozel geometrisini tek adimda kur. Cagiran bu fonksiyonu
  ;; vl-catch-all ile calistirir; hata olursa eski riser limitleri kullanilir.
  (setq filletRadius
    (abs
      (- (car (nth 1 riserLimits))
         (car (nth 0 riserLimits)))))
  (if (<= filletRadius 1e-9)
    (setq filletRadius
      (abs (DEG:CFG-DK-NUM-OR 'DK_UNDER_X2 10.0))))
  (setq newLoopRecords
          (degk--redraw-loop-records-direction
            loopRecords filletRadius 1.0)
        newLoopPointGroups
          (degk--loop-record-point-groups newLoopRecords)
        *degk-last-combined-riser-limits* nil
        *degk-last-combined-riser-entities* nil)
  (if (and newLoopPointGroups
           (degk--draw-combined-riser
             layer newLoopPointGroups
             (if (<= (length newLoopPointGroups) 2) 'GF 'ALL)))
    (progn
      (setq newRiserLimits *degk-last-combined-riser-limits*
            newRiserEntities *degk-last-combined-riser-entities*)
      (if (and newRiserLimits
               (or newRiserEntities
                   (<= (length newLoopPointGroups) 2)))
        (progn
          (degk--delete-entity-list riserEntities)
          (if (> (length newLoopRecords) 1)
            (setq newLoopRecords
              (degk--square-outer-loop-records
                newLoopRecords newRiserLimits nil)))
          (list newRiserLimits newLoopRecords newRiserEntities))
        nil))
    nil)
)

(defun degk--square-outer-loop-records
  (records riserLimits squareTopP / rec y bottomRec bottomY topRec topY bottomTargets topTargets bottomEnt topEnt updatedRecords)
  ;; Isleme sirasina bakmaz. Kombine dik hattin disinda kalan geometrik en alt
  ;; loopu kare yapar. squareTopP dogruysa en ust loop da kare olur; aradaki
  ;; multiline'a bagli looplar filletli kalir.
  (setq updatedRecords records)
  (foreach rec records
    (setq y (degk--loop-record-mouth-y rec))
    (if (numberp y)
      (progn
        (if (or (null bottomY) (< y bottomY))
          (setq bottomY y bottomRec rec))
        (if (or (null topY) (> y topY))
          (setq topY y topRec rec)))))
  (if (and (listp riserLimits) (>= (length riserLimits) 4))
    (setq bottomTargets (list (nth 0 riserLimits) (nth 1 riserLimits))
          topTargets    (list (nth 2 riserLimits) (nth 3 riserLimits))))
  (if bottomRec
    (setq bottomEnt
      (degk--square-existing-loop-record bottomRec bottomTargets)))
  (if bottomEnt
    (setq updatedRecords
      (degk--loop-record-replace-entity
        updatedRecords (car bottomRec) bottomEnt)))
  (if (and squareTopP
           topRec
           (not (eq (car topRec) (car bottomRec))))
    (setq topEnt
      (degk--square-existing-loop-record topRec topTargets)))
  (if topEnt
    (setq updatedRecords
      (degk--loop-record-replace-entity
        updatedRecords (car topRec) topEnt)))
  updatedRecords
)

(defun degk--base-for-loop-open-anchor (anchorPt loopDrop / probe closed firstPt z)
  ;; DK'nin mevcut alt-hat geometrisini sifir noktasinda kurup acik ust ucun
  ;; konumunu olcer. Boylece flasor loopu, ofset ve kat dusurme ayarlari
  ;; degisse bile kaynak modulun temas noktasina tam olarak tasinir.
  (if (and anchorPt (numberp (car anchorPt)) (numberp (cadr anchorPt)))
    (progn
      (setq probe
        (degk--drop-under-rail-pts
          (degk--under-pts
            '(0.0 0.0 0.0)
            (DEG:CFG-DK-NUM-OR 'DK_UNDER_X1 10.0)
            (DEG:CFG-DK-NUM-OR 'DK_UNDER_X2 10.0)
            (DEG:CFG-DK-NUM-OR 'DK_UNDER_W 70.0)
            (DEG:CFG-DK-NUM-OR 'DK_UNDER_H 60.0))
          loopDrop)
        closed
          (degk--close-under-pts
            probe
            (DEG:CFG-DK-NUM-OR 'DK_UNDER_X2 10.0))
        firstPt (car closed)
        z (if (and (caddr anchorPt) (numberp (caddr anchorPt)))
            (caddr anchorPt)
            0.0))
      (if firstPt
        (list (- (car anchorPt) (car firstPt))
              (- (cadr anchorPt) (cadr firstPt))
              z)
        nil)
    )
    nil
  )
)

(defun degk--append-unique-point (pts pt eps / lastPt)
  (setq lastPt (if pts (car (last pts)) nil))
  (if (and lastPt (degk--pt-eq? lastPt pt eps))
    pts
    (append pts (list pt))
  )
)

(defun degk--prepend-flasher-module-link (pts anchorPt linkY / firstPt z rightOffset shiftedPt dropPt turnPt link)
  ;; Polyline modul base hizasinin 200 mm saginda baslar ve oradan looplarin
  ;; en alt hattinin altindaki ortak seviyeye dik iner. Base noktasindan
  ;; baslangica yatay bir parca cizilmez.
  (if (and pts
           anchorPt
           (numberp (car anchorPt))
           (numberp (cadr anchorPt))
           (numberp linkY))
    (progn
      (setq firstPt (car pts)
            z (if (and (caddr anchorPt) (numberp (caddr anchorPt)))
                (caddr anchorPt)
                0.0)
            ;; PLAN ayar tabani cm'dir: 20 cm = 200 mm.
            rightOffset (* 20.0 (DEG:PLAN-UNIT-SCALE))
            shiftedPt (list (+ (car anchorPt) rightOffset)
                            (cadr anchorPt)
                            z)
            dropPt (list (car shiftedPt) linkY z)
            turnPt
              (list
                (car firstPt)
                (cadr dropPt)
                (if (and (caddr firstPt) (numberp (caddr firstPt)))
                  (caddr firstPt)
                  z))
            link nil)
      (setq link (degk--append-unique-point link shiftedPt 1e-6))
      (setq link (degk--append-unique-point link dropPt 1e-6))
      (setq link (degk--append-unique-point link turnPt 1e-6))
      (setq link (degk--append-unique-point link firstPt 1e-6))
      (append link (cdr pts))
    )
    pts
  )
)

(defun degk--loop-name-from-sira (s / pos next)
  (setq s (degk--clean-text (if s s ""))
        pos nil
        next (vl-string-search "-" s))
  (while next
    (setq pos next
          next (vl-string-search "-" s (1+ next)))
  )
  (if (and pos (> pos 0))
    (vl-string-trim " \t\r\n" (substr s 1 pos))
    s)
)

(defun degk--select-last-panel-name (/ sel obj objName txt done)
  (setq txt ""
        done nil)
  (while (not done)
    (setq sel
      (entsel
        "\nDK: Son panel adi icin TEXT secin veya bos birakmak icin Enter: "))
    (if (null sel)
      (setq done T)
      (progn
        (setq obj (vl-catch-all-apply 'vlax-ename->vla-object (list (car sel))))
        (if (vl-catch-all-error-p obj)
          (princ "\nDK: Secilen nesne okunamadi; TEXT secin veya Enter'a basin.")
          (progn
            (setq objName (vl-catch-all-apply 'vla-get-ObjectName (list obj)))
            (if (and (not (vl-catch-all-error-p objName))
                     (member objName '("AcDbText" "AcDbMText")))
              (progn
                (setq txt (degk--clean-text (get-entity-text obj)))
                (if (/= txt "")
                  (setq done T)
                  (princ "\nDK: Secilen TEXT bos; baska TEXT secin veya Enter'a basin.")))
              (princ "\nDK: Secilen nesne TEXT degil; TEXT secin veya Enter'a basin."))
          )
        )
      )
    )
  )
  txt
)

(defun degk--loop-label-with-panel (loopName / panelName)
  (setq loopName
    (degk--clean-text (if loopName loopName "")))
  (setq panelName
    (if (and (boundp '*degk-last-panel-name*)
             (= (type *degk-last-panel-name*) 'STR))
      (vl-string-right-trim " -\t\r\n" *degk-last-panel-name*)
      ""))
  (cond
    ((= panelName "") loopName)
    ((= loopName "") panelName)
    (T (strcat panelName "-" loopName)))
)

(defun degk--split-hyphens (s / txt pos part out)
  (setq txt (degk--clean-text (if s s ""))
        out nil)
  (while (setq pos (vl-string-search "-" txt))
    (setq part (vl-string-trim " \t\r\n" (substr txt 1 pos))
          out  (cons part out)
          txt  (substr txt (+ pos 2)))
  )
  (reverse (cons (vl-string-trim " \t\r\n" txt) out))
)

(defun degk--token-first-number (s / i len ch code digits started done)
  (setq s       (degk--clean-text (if s s ""))
        i       1
        len     (strlen s)
        digits  ""
        started nil
        done    nil)
  (while (and (<= i len) (not done))
    (setq ch   (substr s i 1)
          code (ascii ch))
    (cond
      ((and (>= code 48) (<= code 57))
        (setq digits  (strcat digits ch)
              started T))
      (started
        (setq done T))
    )
    (setq i (1+ i))
  )
  (if (/= digits "") (atoi digits) nil)
)

(defun degk--roof-floor-p (floorNo)
  (and (numberp floorNo) (= floorNo 999999))
)

(defun degk--floor-token-number (s / token n firstCh lastCh)
  ;; Katlari tek bir sayisal eksende tut: 01=1, GF/ZK=0, BF/B01/1B=-1.
  ;; RF/CK daha sonra secimdeki en yuksek normal katin hemen ustune indirilir.
  (setq token (strcase (vl-string-trim " \t\r\n" (degk--clean-text (if s s "")))))
  (cond
    ((member token '("RF" "ÇK" "CK" "ROOF" "ROOF FLOOR" "ÇATI" "CATI" "ÇATI KATI" "CATI KATI")) 999999)
    ((member token '("GR" "GF" "ZK" "GROUND" "GROUND FLOOR" "ZEMIN" "ZEMÝN" "ZEMIN KAT" "ZEMÝN KAT")) 0)
    ((member token '("BF" "B.F." "BK" "B.K." "BASEMENT" "BASEMENT FLOOR" "BODRUM" "BODRUM KAT")) -1)
    ((or (wcmatch token "*BASEMENT*")
         (wcmatch token "*BODRUM*"))
      (setq n (degk--token-first-number token))
      (if (numberp n) (- (abs n)) -1))
    (T
      (setq n (degk--token-first-number token))
      (if (numberp n)
        (progn
          (setq firstCh (if (> (strlen token) 0) (substr token 1 1) "")
                lastCh  (if (> (strlen token) 0) (substr token (strlen token) 1) ""))
          (if (or (= firstCh "B") (= lastCh "B"))
            (- (abs n))
            n))
        nil)))
)

(defun degk--split-layout-path (s / txt pos part out)
  ;; Eski projelerde kat/loop bolumu '/' ile, yenilerde '-' ile ayrilabiliyor.
  (setq txt (degk--clean-text (if s s ""))
        out nil)
  (while (setq pos (vl-string-search "/" txt))
    (setq part (vl-string-trim " \t\r\n" (substr txt 1 pos))
          out  (cons part out)
          txt  (substr txt (+ pos 2))))
  (reverse (cons (vl-string-trim " \t\r\n" txt) out))
)

(defun degk--panel-path-layout (s / path parts token floorNo orderNo title)
  ;; FAP/panel-kati/panel-no/kat-loop[-cihaz] icin son bolum esastir.
  (setq path (degk--split-layout-path s))
  (if (>= (length path) 4)
    (progn
      (setq parts (degk--split-hyphens (last path))
            token (car parts)
            floorNo (degk--floor-token-number token)
            orderNo (if (cdr parts) (degk--token-first-number (cadr parts)) nil))
      (if (and (>= (length parts) 2) (numberp floorNo) (numberp orderNo))
        (progn
          (setq title (if (> (length parts) 2)
                        (degk--loop-name-from-sira s)
                        (degk--clean-text s)))
          (list floorNo orderNo title token))))))

(defun degk--layout-key-from-sira (s / title parts partCount floorNo orderNo pathParts pathCount panelLayout)
  ;; SIRA_NO sagdan okunur: son '-' oncesi loop, sondan ikinci '-' oncesi kattir.
  ;; En sondaki parca ust baslikta oldugu gibi yerlesim hesabina katilmaz.
  (setq title     (degk--loop-name-from-sira s)
        parts     (degk--split-hyphens s)
        partCount (length parts))
  (if (>= partCount 3)
    (setq floorNo (degk--floor-token-number (nth (- partCount 3) parts))
          orderNo (degk--token-first-number (nth (- partCount 2) parts))))
  ;; SM/GF/02-03 gibi yalniz cihaz sirasinda '-' kullanan eski bicim.
  (if (or (not (numberp floorNo)) (not (numberp orderNo)))
    (progn
      (setq pathParts (degk--split-layout-path title)
            pathCount (length pathParts))
      (if (>= pathCount 2)
        (setq floorNo (degk--floor-token-number (nth (- pathCount 2) pathParts))
              orderNo (degk--token-first-number (nth (1- pathCount) pathParts))))))
  (if (setq panelLayout (degk--panel-path-layout s))
    (setq floorNo (car panelLayout) orderNo (cadr panelLayout) title (caddr panelLayout)))
  (if (and (numberp floorNo) (numberp orderNo))
    (list floorNo orderNo title)
    nil)
)

(defun degk--floor-label-from-sira (s / clean title parts partCount token orderNo pathParts pathCount panelLayout)
  ;; Yerlesim hesabinda kullanilan kat parcasini yazildigi bicimiyle koru.
  ;; Ornekler: SM-GF-L03-01 -> GF, L02-L09-01 -> L02,
  ;; SM/GF/02-03 -> GF.
  (setq clean     (degk--clean-text (if s s ""))
        title     (degk--loop-name-from-sira clean)
        parts     (degk--split-hyphens clean)
        partCount (length parts))
  (if (>= partCount 3)
    (progn
      (setq token   (nth (- partCount 3) parts)
            orderNo (degk--token-first-number (nth (- partCount 2) parts)))
      (if (or (not (numberp (degk--floor-token-number token)))
              (not (numberp orderNo)))
        (setq token nil))))
  (if (null token)
    (progn
      (setq pathParts (degk--split-layout-path title)
            pathCount (length pathParts))
      (if (>= pathCount 2)
        (setq token   (nth (- pathCount 2) pathParts)
              orderNo (degk--token-first-number (nth (1- pathCount) pathParts))))
      (if (or (null token)
              (not (numberp (degk--floor-token-number token)))
              (not (numberp orderNo)))
        (setq token nil))))
  (if (setq panelLayout (degk--panel-path-layout s))
    (setq token (nth 3 panelLayout)))
  (degk--clean-text (if token token ""))
)

(defun degk--default-floor-label (floorNo)
  (cond
    ((not (numberp floorNo)) "")
    ((= floorNo 0) "GF")
    ((= floorNo -1) "BF")
    ((< floorNo -1) (strcat "B" (degk--pad (abs floorNo) 2)))
    (T (strcat "L" (degk--pad floorNo 2))))
)

(defun degk--english-ordinal (n / value mod100 mod10 suffix)
  (setq value  (abs (fix n))
        mod100 (rem value 100)
        mod10  (rem value 10)
        suffix
          (cond
            ((member mod100 '(11 12 13)) "TH")
            ((= mod10 1) "ST")
            ((= mod10 2) "ND")
            ((= mod10 3) "RD")
            (T "TH")))
  (strcat (itoa value) suffix)
)

(defun degk--expanded-floor-label
  (label floorNo / token n firstCh lastCh turkishBasementP turkishFloorP)
  ;; Kaynak kat kodunun dilini koruyarak dikey kat isimligini tam ada cevir.
  (setq token   (strcase (vl-string-trim " \t\r\n" (degk--clean-text (if label label ""))))
        n       (degk--token-first-number token)
        firstCh (if (> (strlen token) 0) (substr token 1 1) "")
        lastCh  (if (> (strlen token) 0) (substr token (strlen token) 1) "")
        turkishBasementP
          (or (wcmatch token "BK*,*BK,*BODRUM*")
              (and (= firstCh "B") (= lastCh "K")))
        turkishFloorP
          (or (= firstCh "K")
              (= lastCh "K")
              (wcmatch token "* KAT*")))
  (cond
    ((member token '("ÇK" "CK" "ÇATI" "CATI" "ÇATI KATI" "CATI KATI"))
      "ÇATI KATI")
    ((member token '("RF" "ROOF" "ROOF FLOOR"))
      "ROOF FLOOR")
    ((member token '("ZK" "ZEMIN" "ZEMÝN" "ZEMIN KAT" "ZEMÝN KAT"))
      "ZEMÝN KAT")
    ((member token '("GF" "GR" "GROUND" "GROUND FLOOR"))
      "GROUND FLOOR")
    ((member token '("BK" "B.K." "BODRUM" "BODRUM KAT"))
      "BODRUM KAT")
    ((member token '("BF" "B.F." "BASEMENT" "BASEMENT FLOOR"))
      "BASEMENT FLOOR")
    ((and turkishBasementP (numberp n))
      (strcat (itoa (abs n)) ". BODRUM KAT"))
    ((and (or (= firstCh "B") (= lastCh "B")
              (wcmatch token "*BASEMENT*"))
          (numberp n))
      (strcat (degk--english-ordinal n) " BASEMENT FLOOR"))
    ((and turkishFloorP (numberp n))
      (strcat (itoa (abs n)) ". KAT"))
    ((numberp n)
      (strcat (degk--english-ordinal n) " FLOOR"))
    ((and (numberp floorNo) (= floorNo 999999)) "ROOF FLOOR")
    ((and (numberp floorNo) (= floorNo 0)) "GROUND FLOOR")
    ((and (numberp floorNo) (< floorNo 0))
      (strcat (degk--english-ordinal (abs floorNo)) " BASEMENT FLOOR"))
    ((and (numberp floorNo) (> floorNo 0))
      (strcat (degk--english-ordinal floorNo) " FLOOR"))
    (T token))
)

(defun degk--polyline-first-sira (plEnt blockObjs tol excludeObj / touched blkObj totalLen useFromStart ordered ins dist key pair sira siraList result)
  ;; DK:BASE ile ayni hat yonu ve blok sirasi kullanilarak ust baslik bulunur.
  (foreach blkObj blockObjs
    (if (and (degk--poly-touch-insertion? plEnt blkObj tol)
             (or (null excludeObj)
                 (not (degk--same-block-p blkObj excludeObj))))
      (setq touched (cons blkObj touched)))
  )
  (if touched
    (progn
      (setq totalLen (vlax-curve-getDistAtParam plEnt (vlax-curve-getEndParam plEnt))
            useFromStart (degk--use-from-lower-sira-side plEnt touched totalLen)
            ordered nil)
      (foreach blkObj touched
        (setq ins  (deg-get-inspt blkObj)
              dist (degk--dist-along plEnt ins)
              key  (if useFromStart dist (- totalLen dist))
              ordered (cons (cons key blkObj) ordered)))
      (setq ordered (vl-sort ordered '(lambda (a b) (< (car a) (car b)))))
      (while (and ordered (null result))
        (setq pair     (car ordered)
              blkObj  (cdr pair)
              sira    (degk--get-att blkObj "SIRA_NO")
              siraList (degk--expand-sira-no sira))
        (if (null siraList) (setq siraList (list sira)))
        (while (and siraList (null result))
          (setq sira (degk--clean-text (car siraList))
                siraList (cdr siraList))
          (if (/= sira "") (setq result sira)))
        (setq ordered (cdr ordered)))
    )
  )
  result
)

(defun degk--polyline-first-layout-sira (plEnt blockObjs tol excludeObj / touched blkObj totalLen useFromStart ordered ins dist key pair siraList candidate result)
  ;; Ilk dolu SIRA_NO kat/loop biciminde olmayabilir. Flasor terminali
  ;; gorulemediginde hatta degen bloklar arasindan yerlesim bilgisi tasiyan
  ;; ilk gecerli SIRA_NO'yu ayni hat yonu sirasi ile bul.
  (foreach blkObj blockObjs
    (if (and (degk--poly-touch-insertion? plEnt blkObj tol)
             (or (null excludeObj)
                 (not (degk--same-block-p blkObj excludeObj))))
      (setq touched (cons blkObj touched)))
  )
  (if touched
    (progn
      (setq totalLen (vlax-curve-getDistAtParam plEnt (vlax-curve-getEndParam plEnt))
            useFromStart (degk--use-from-lower-sira-side plEnt touched totalLen)
            ordered nil)
      (foreach blkObj touched
        (setq ins  (deg-get-inspt blkObj)
              dist (degk--dist-along plEnt ins)
              key  (if useFromStart dist (- totalLen dist))
              ordered (cons (cons key blkObj) ordered)))
      (setq ordered (vl-sort ordered '(lambda (a b) (< (car a) (car b)))))
      (while (and ordered (null result))
        (setq pair     (car ordered)
              blkObj   (cdr pair)
              siraList (degk--expand-sira-no (degk--get-att blkObj "SIRA_NO")))
        (if (null siraList)
          (setq siraList (list (degk--get-att blkObj "SIRA_NO"))))
        (while (and siraList (null result))
          (setq candidate (degk--clean-text (car siraList))
                siraList  (cdr siraList))
          (if (and (/= candidate "")
                   (degk--layout-key-from-sira candidate))
            (setq result candidate)))
        (setq ordered (cdr ordered)))
    )
  )
  result
)

(defun degk--block-loop-sequence (blkObj / siraList sira parts n best)
  ;; Ayni loopun parcalari birlestiginde blok sirasi SIRA_NO'nun son
  ;; bolumunden gelir. Coklu SIRA_NO icin en kucuk eleman kullanilir.
  (setq siraList (degk--expand-sira-no (degk--get-att blkObj "SIRA_NO")))
  (if (null siraList)
    (setq siraList (list (degk--get-att blkObj "SIRA_NO"))))
  (foreach sira siraList
    (setq parts (degk--split-hyphens (degk--clean-text sira))
          n     (if parts (degk--token-first-number (last parts)) nil))
    (if (and (numberp n) (or (null best) (< n best)))
      (setq best n))
  )
  best
)

(defun degk--block-loop-order-key
  (blkObj loopEnts / ins seq memberIndex plEnt cp gap localDist bestGap bestIndex bestDist)
  (setq ins         (deg-get-inspt blkObj)
        seq         (degk--block-loop-sequence blkObj)
        memberIndex 0
        bestIndex   0
        bestDist    0.0)
  (foreach plEnt loopEnts
    (if (and plEnt (degk--curve-ok? plEnt))
      (progn
        (setq cp        (deg-safe-closest-point plEnt ins)
              gap       (if cp (distance ins cp) 1.0e99)
              localDist (if cp (degk--dist-along plEnt ins) 0.0))
        (if (not (numberp localDist)) (setq localDist 0.0))
        (if (or (null bestGap) (< gap bestGap))
          (setq bestGap   gap
                bestIndex memberIndex
                bestDist  localDist))
      )
    )
    (setq memberIndex (1+ memberIndex))
  )
  ;; SIRA_NO once gelir; geometrik konum yalniz esit/eksik sirada baglayicidir.
  (if (numberp seq)
    (+ (* (float seq) 1.0e12) (* (float bestIndex) 1.0e8) bestDist)
    (+ 9.0e15 (* (float bestIndex) 1.0e8) bestDist))
)

(defun degk--layout-record-less-p (a b / va vb fa fb oa ob ia ib)
  (setq va (car a) vb (car b)
        fa (nth 1 a) fb (nth 1 b)
        oa (nth 2 a) ob (nth 2 b)
        ia (nth 3 a) ib (nth 3 b))
  (cond
    ((and va (not vb)) T)
    ((and (not va) vb) nil)
    ((and va vb (/= fa fb)) (< fa fb))
    ((and va vb (/= oa ob)) (< oa ob))
    (T (< ia ib)))
)

(defun degk--sira-text-sequence (s / parts)
  (setq parts (degk--split-hyphens (degk--clean-text (if s s ""))))
  (if parts
    (degk--token-first-number (last parts))
    nil)
)

(defun degk--layout-record-title (rec / title sira)
  ;; Kat-loop-cihaz veya loop-cihaz bicimlerinin ikisinde de son '-'
  ;; sonrasini cihaz sirasi, oncesini ortak loop kimligi kabul et.
  (setq title (if rec (degk--clean-text (nth 8 rec)) "")
        sira  (if rec (degk--clean-text (nth 9 rec)) ""))
  (cond
    ((/= title "") (strcase title))
    ((/= sira "") (strcase (degk--loop-name-from-sira sira)))
    ((and rec (/= (degk--clean-text (nth 5 rec)) ""))
      (strcase (degk--loop-name-from-sira (nth 5 rec))))
    (T ""))
)

(defun degk--layout-record-members (rec / members ent)
  (setq members (nth 7 rec)
        ent     (nth 4 rec))
  (if members members (if ent (list ent) nil))
)

(defun degk--same-layout-loop-p (a b / titleA titleB specialA specialB terminalA terminalB)
  ;; Kat, loop sirasi ve loop basligi ayniysa polyline parcalari tek looptur.
  ;; Tek ayracli SIRA_NO'larda ortak baslik tek basina loop kimligidir.
  ;; Flasor/strobe hatlari normal looplarla ayni kayda kesinlikle girmez.
  (setq titleA    (degk--layout-record-title a)
        titleB    (degk--layout-record-title b)
        specialA  (if (degk--layout-record-flasher-p a) T nil)
        specialB  (if (degk--layout-record-flasher-p b) T nil)
        terminalA (nth 6 a)
        terminalB (nth 6 b))
  (and (/= titleA "")
       (= titleA titleB)
       ;; Terminale dogrudan degen ve devaminda terminale degmeyen parcalar
       ;; ayni SIRA_NO loop kimligindeyse tek loop olarak kalmalidir.
       (eq specialA specialB)
       ;; Ayni baslikli iki flasor parcasi farkli fiziksel kontrol modullerine
       ;; bagliysa iki ayri looptur. Terminale degmeyen devam parcasi ise kendi
       ;; terminal kaydiyla birlesmeye devam edebilir.
       (or (not specialA)
           (null terminalA)
           (null terminalB)
           (degk--same-block-p terminalA terminalB)))
)

(defun degk--layout-anchor-better-p (candidate current / termC termO validC validO seqC seqO)
  ;; Yerini bilen terminal parcasi once gelir. Terminal yoksa gecerli kat-loop
  ;; kaydi, o da yoksa en kucuk cihaz sirali parca ankraj olur.
  (setq termC  (if (nth 6 candidate) T nil)
        termO  (if (nth 6 current) T nil)
        validC (if (car candidate) T nil)
        validO (if (car current) T nil)
        seqC   (degk--sira-text-sequence (nth 9 candidate))
        seqO   (degk--sira-text-sequence (nth 9 current)))
  (cond
    ((and termC (not termO)) T)
    ((and termO (not termC)) nil)
    ((and validC (not validO)) T)
    ((and validO (not validC)) nil)
    ((and (numberp seqC) (numberp seqO) (/= seqC seqO)) (< seqC seqO))
    ((and (numberp seqC) (not (numberp seqO))) T)
    ((and (numberp seqO) (not (numberp seqC))) nil)
    (T (< (nth 3 candidate) (nth 3 current))))
)

(defun degk--combine-layout-records (a b / members ent terminalObj anchor title sourceSira)
  (setq members (degk--layout-record-members a))
  (foreach ent (degk--layout-record-members b)
    (if (not (member ent members))
      (setq members (append members (list ent)))
    )
  )
  (setq terminalObj (if (nth 6 a) (nth 6 a) (nth 6 b))
        anchor      (if (degk--layout-anchor-better-p b a) b a)
        title       (degk--layout-record-title anchor)
        sourceSira  (nth 9 anchor))
  (list (car anchor) (nth 1 anchor) (nth 2 anchor) (nth 3 anchor)
        (nth 4 anchor) (nth 5 anchor) terminalObj members title sourceSira)
)

(defun degk--merge-layout-records (records / merged rec rebuilt existing mergedP)
  ;; Secim sirasini koruyarak ayni loopun devam polyline'larini tek kayda indir.
  (setq merged nil)
  (foreach rec records
    (if (/= (degk--layout-record-title rec) "")
      (progn
        (setq rebuilt nil
              mergedP nil)
        (foreach existing merged
          (if (and (not mergedP)
                   (degk--same-layout-loop-p rec existing))
            (progn
              (setq rebuilt
                (cons (degk--combine-layout-records existing rec) rebuilt))
              (setq mergedP T))
            (setq rebuilt (cons existing rebuilt)))
        )
        (setq merged (reverse rebuilt))
        (if (not mergedP)
          (setq merged (append merged (list rec))))
      )
      (setq merged (append merged (list rec))))
  )
  merged
)

(defun degk--layout-record-gap-to-block (rec blkObj / ins best ent cp gap)
  (setq ins (deg-get-inspt blkObj)
        best 1.0e99)
  (if ins
    (foreach ent (degk--layout-record-members rec)
      (if (and ent (degk--curve-ok? ent))
        (progn
          (setq cp (deg-safe-closest-point ent ins))
          (if cp
            (progn
              (setq gap (distance ins cp))
              (if (< gap best) (setq best gap))))))))
  best
)

(defun degk--terminal-normal-layout (blkObj records tol / rec gap bestGap bestLayout)
  ;; Modulun kolon semasindaki kati kendi SIRA_NO'sundan farkli olabilir veya
  ;; SIRA_NO bos olabilir. Gercek kolon satirini, modulu kopyalayan normal
  ;; loop kaydindan bul. Birden cok temas varsa en yakin normal loopu kullan.
  (setq bestGap 1.0e99)
  (foreach rec records
    (if (and (car rec)
             (numberp (nth 1 rec))
             (not (degk--layout-record-flasher-p rec))
             (degk--block-touches-loop-p
               (degk--layout-record-members rec) blkObj tol))
      (progn
        (setq gap (degk--layout-record-gap-to-block rec blkObj))
        (if (< gap bestGap)
          (setq bestGap gap
                bestLayout (list (nth 1 rec) (nth 2 rec)))))))
  bestLayout
)

(defun degk--layout-record-with-terminal (rec terminalObj preferredLayout / info terminalSira layout outputSira)
  ;; Loop kimligini ve birlestirilmis polyline listesini koru; yalniz kolon
  ;; yerlesimini eslesen kontrol modulunun kat/loop kaydindan al.
  (setq info (degk--block-first-layout-info terminalObj)
        terminalSira (if info (car info) "")
        layout (if preferredLayout preferredLayout (if info (cadr info) nil))
        outputSira
          (if (and (null preferredLayout) (/= terminalSira ""))
            terminalSira
            (nth 5 rec)))
  (if layout
    (list T (car layout) (cadr layout) (nth 3 rec) (nth 4 rec)
          outputSira terminalObj (degk--layout-record-members rec)
          (nth 8 rec) (nth 9 rec))
    (list (car rec) (nth 1 rec) (nth 2 rec) (nth 3 rec) (nth 4 rec)
          (nth 5 rec) terminalObj (degk--layout-record-members rec)
          (nth 8 rec) (nth 9 rec)))
)

(defun degk--assign-unmatched-flasher-terminals
  (records allInserts polylines tol / used rec terminalObj handle wantedFloor blkObj info layout normalLayout copyable gap best bestGap bestHandle bestLayout out loopHandle)
  ;; Gercek temasla bulunan moduller once rezerve edilir. Fiziksel baglantisi
  ;; gorunmeyen loop, yalniz kendi katinda kolon semasina kopyalanacak ve henuz
  ;; kullanilmamis bir kontrol modulune bir kez atanir.
  (foreach rec records
    (if (and (degk--layout-record-flasher-p rec)
             (setq terminalObj (nth 6 rec)))
      (progn
        (setq handle (strcase (degkk--object-handle terminalObj)))
        (if (and (/= handle "") (not (member handle used)))
          (setq used (cons handle used))))))
  (foreach rec records
    (setq best nil bestGap 1.0e99 bestHandle "" bestLayout nil)
    (if (and (degk--layout-record-flasher-p rec)
             (null (nth 6 rec))
             (car rec)
             (numberp (setq wantedFloor (nth 1 rec))))
      (progn
        (foreach blkObj allInserts
          (if (and (degk--flasher-terminal-module-p blkObj)
                   (setq handle (strcase (degkk--object-handle blkObj)))
                   (/= handle "")
                   (not (member handle used)))
            (progn
              ;; Once kolon semasinda modulu olusturan normal loopun katini
              ;; kullan. Bu kayit yoksa eski SIRA_NO kat kontrolune geri don.
              (setq normalLayout
                      (degk--terminal-normal-layout blkObj records tol)
                    info
                      (if normalLayout
                        nil
                        (degk--block-first-layout-info blkObj))
                    layout
                      (if normalLayout normalLayout (if info (cadr info) nil))
                    copyable
                      (or normalLayout
                          (degk--block-touches-selected-normal-p
                            blkObj polylines tol)))
              (if (and copyable
                       layout
                       (= wantedFloor (car layout)))
                (progn
                  (setq gap (degk--layout-record-gap-to-block rec blkObj))
                  (if (< gap bestGap)
                    (setq best blkObj
                          bestGap gap
                          bestHandle handle
                          bestLayout layout)))))))
        (if best
          (progn
            (setq rec (degk--layout-record-with-terminal rec best bestLayout)
                  used (cons bestHandle used)
                  loopHandle (if (nth 4 rec) (cdr (assoc 5 (entget (nth 4 rec)))) ""))
            (princ
              (strcat "\nDK: Baglantisi gorunmeyen loop ayni kattaki bos module baglandi: loop="
                      (if loopHandle loopHandle "")
                      " modul=" bestHandle
                      " kat=" (itoa wantedFloor)))))))
    (setq out (cons rec out)))
  (reverse out)
)

(defun degk--terminal-copy-handle (copyRec / copyObj)
  (setq copyObj (if copyRec (car copyRec) nil))
  (if (and copyObj (= (type copyObj) 'VLA-OBJECT))
    (strcase (degkk--object-handle copyObj))
    "")
)

(defun degk--reserved-terminal-copy-handles (records / used rec sourceObj copyRec copyHandle)
  ;; Kolon kopyalari olustuktan sonra fiziksel baglantili tum modulleri once
  ;; rezerve et. Islenme sirasi, baglantisiz bir loopun dolu modulu calmasina
  ;; neden olmasin.
  (foreach rec records
    (if (and (degk--layout-record-flasher-p rec)
             (setq sourceObj (nth 6 rec))
             (setq copyRec
               (degk--area-module-copy-get sourceObj (nth 1 rec)))
             (/= (setq copyHandle (degk--terminal-copy-handle copyRec)) "")
             (not (member copyHandle used)))
      (setq used (cons copyHandle used))))
  used
)

(defun degk--unused-terminal-copy-for-layout
  (rec wantedFloor wantedRow used / items item sourceObj copyRec copyObj copyHandle itemRow itemFloor rowMatch floorMatch rank gap bestRank bestGap best)
  ;; Dogrudan kolon semasinda olusan gercek terminal INSERT'lerine bak. Kaynak
  ;; plandaki handle veya temas kaydi bos olsa bile ayni kattaki bos kopya bulunur.
  (setq items
          (if (boundp '*degk-column-terminal-copies*)
            *degk-column-terminal-copies*
            nil)
        bestGap 1.0e99)
  (foreach item items
    (setq copyObj (car item)
          copyRec (list (car item) (nth 1 item) (nth 2 item) (nth 3 item))
          sourceObj (nth 4 item)
          copyHandle (degk--terminal-copy-handle copyRec)
          itemRow (nth 2 item)
          itemFloor (nth 3 item)
          rowMatch
            (and (numberp wantedRow)
                 (numberp itemRow)
                 (= wantedRow itemRow))
          floorMatch
            (and (numberp wantedFloor)
                 (numberp itemFloor)
                 (= wantedFloor itemFloor))
          rank
            (cond
              (rowMatch 0)
              ;; Satir kaydi eski/eksik olsa bile ayni kattaki gercek kolon
              ;; kopyasini reddetme; bulunan kopyanin kendi satiri sonradan
              ;; loop yerlesimine birinci oncelikle uygulanir.
              (floorMatch 1)
              (T nil)))
    (if (and (numberp rank)
             copyObj
             (= (type copyObj) 'VLA-OBJECT)
             (/= copyHandle "")
             (not (member copyHandle used)))
      (progn
        (setq gap
          (if (and sourceObj
                   (= (type sourceObj) 'VLA-OBJECT)
                   (not (vl-catch-all-error-p sourceObj)))
            (degk--layout-record-gap-to-block rec sourceObj)
            0.0))
        (if (or (null bestRank)
                (< rank bestRank)
                (and (= rank bestRank) (< gap bestGap)))
          (setq bestRank rank
                bestGap gap
                best (list sourceObj copyRec copyHandle))))))
  best
)

(defun degk--normal-area-layout-records (polylines / tol allInserts sourceBlocks ss i ent blkObj blkLayer records mergedRecords sira sourceSira sourceTitle layout layoutSira layer terminalObj terminalSira terminalInfo terminalMode loopHandle terminalHandle)
  (setq tol        (DEG:CFG-TOL-NUM-OR 'DN_BLOCK_TOL 1.0)
        allInserts nil
        ss         (ssget "_X" '((0 . "INSERT"))))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent    (ssname ss i)
              blkObj (if ent (vl-catch-all-apply 'vlax-ename->vla-object (list ent)) nil)
              blkLayer (if (and blkObj (not (vl-catch-all-error-p blkObj)))
                         (vl-catch-all-apply 'vla-get-Layer (list blkObj))
                         nil))
        (if (and blkObj
                 (not (vl-catch-all-error-p blkObj))
                 blkLayer
                 (not (vl-catch-all-error-p blkLayer))
                 (/= (strcase blkLayer) "0")
                 (not (DEG:IGNORE-BLOCK-OBJ? blkObj)))
          (setq allInserts (cons blkObj allInserts)))
        (setq i (1+ i)))
    )
  )
  (setq records nil i 0)
  (while (< i (sslength polylines))
    (setq ent    (ssname polylines i)
          layer  (if ent (cdr (assoc 8 (entget ent))) nil)
          terminalObj nil
          terminalSira ""
          terminalMode "YOK")
    ;; Flasor/strobe loopu kendi SIRA_NO katina degil, temas ettigi kontrol
    ;; modulunun katina gider. Ozel looplar sonradan islendigi icin bu katta
    ;; mevcut looplarin en sagina, son siraya yerlesir.
    (if (and layer (degk--flasher-loop-layer-p layer))
      (progn
        (setq terminalObj
          (degk--flasher-terminal-on-polyline ent allInserts tol))
        (if terminalObj (setq terminalMode "UC_TEMASI"))
      )
    )
    ;; Flasor loopunun kimligi kontrol modulunun SIRA_NO'sundan uretilmez.
    ;; Tum terminal modulleri kaynak cihaz listesinden cikartilir.
    (setq sourceBlocks
      (if (and layer (degk--flasher-loop-layer-p layer))
        (vl-remove-if 'degk--flasher-terminal-module-p allInserts)
        allInserts))
    ;; Mantiksal loop kimligi terminal modulunden degil loop cihazlarindan gelir.
    (setq sourceTitle (degk--source-loop-title (list ent))
          sourceSira
            (cond
              (sourceTitle (strcat sourceTitle "-01"))
              ((= *degk-number-mode* 'UNNUMBERED) "")
              (T (degk--polyline-first-sira ent sourceBlocks tol nil))))
    ;; Terminal baglantisi planda gorunmuyorsa ilk dolu fakat gecersiz degerde
    ;; kalma; ayni flasor hattindaki gecerli kat-loop SIRA_NO'sunu yedek al.
    (if (and (/= *degk-number-mode* 'UNNUMBERED) layer
             (degk--flasher-loop-layer-p layer)
             (null terminalObj)
             (null (degk--layout-key-from-sira sourceSira)))
      (progn
        (setq layoutSira
          (degk--polyline-first-layout-sira ent sourceBlocks tol nil))
        (if layoutSira (setq sourceSira layoutSira)))
    )
    ;; Fiziksel temas bulunmayan parcalara bu asamada otomatik modul atama.
    ;; Once ayni SIRA_NO loop kimligindeki polyline parcalari birlestirilir;
    ;; terminale gercekten degen parcanin kaynak modulu tum loopa aktarilir.
    (if (and layer (degk--flasher-loop-layer-p layer))
      (progn
        (setq loopHandle     (if ent (cdr (assoc 5 (entget ent))) "")
              terminalHandle (if terminalObj
                               (degkk--object-handle terminalObj)
                               "YOK"))
        (princ
          (strcat "\nDK terminal esleme: loop="
                  (if loopHandle loopHandle "")
                  " -> modul=" terminalHandle
                  " [" terminalMode "]"))))
    ;; Fiziksel olarak bu hatta bagli tek tag, kat ve loop kimliginin kaynagidir.
    (if sourceTitle (setq sourceSira (strcat sourceTitle "-01")))
    (setq sourceTitle
            (if (/= (degk--clean-text sourceSira) "")
              (degk--loop-name-from-sira sourceSira)
              "")
          sira sourceSira)
    ;; Terminalin SIRA_NO'su yalniz kat/loop yerlesim ankrajini belirler.
    (if terminalObj
      (progn
        (setq terminalInfo (degk--block-first-layout-info terminalObj)
              terminalSira
                (if terminalInfo
                  (car terminalInfo)
                  (degk--clean-text (degk--get-att terminalObj "SIRA_NO"))))))
    (if (/= terminalSira "")
      (setq sira terminalSira))
    (setq layout (if sira (degk--layout-key-from-sira sira) nil))
    (if layout
      (setq records
        (cons (list T (car layout) (cadr layout) i ent sira terminalObj
                    (list ent) sourceTitle sourceSira)
              records))
      (setq records
        (cons (list nil 0 0 i ent sira terminalObj
                    (list ent) sourceTitle sourceSira)
              records)))
    (setq i (1+ i))
  )
  ;; Baglantisiz flasor looplarini bu asamada kaynak plandaki tahmini module
  ;; atama. Gercek kolon kopyalari normal looplar cizildikten sonra secilir.
  (setq mergedRecords (degk--merge-layout-records (reverse records)))
  (vl-sort mergedRecords 'degk--layout-record-less-p)
)

(defun degk--ensure-loop-layer (layer / rec ent ed c62)
  (if (not (tblsearch "LAYER" layer))
    (entmake
      (list
        '(0 . "LAYER")
        '(100 . "AcDbSymbolTableRecord")
        '(100 . "AcDbLayerTableRecord")
        (cons 2 layer)
        '(70 . 0)
        '(62 . 7)
        '(6 . "Continuous")))
  )
  (setq ent (tblobjname "LAYER" layer))
  (if ent
    (progn
      (setq ed (entget ent)
            ed (degk--assoc-put 70 0 ed)
            c62 (cdr (assoc 62 ed)))
      (if (and (numberp c62) (< c62 0))
        (setq ed (degk--assoc-put 62 (abs c62) ed)))
      (entmod ed)
      (entupd ent))
  )
  layer
)

(defun degk--add-loop-text (pt txt layer height / data)
  (setq txt (degk--clean-text (if txt txt "")))
  (if (and pt (/= txt "") (> height 0.0))
    (progn
      (degk--ensure-loop-layer layer)
      (setq data
        (list
          '(0 . "TEXT")
          '(100 . "AcDbEntity")
          (cons 8 layer)
          '(100 . "AcDbText")
          (cons 10 pt)
          (cons 40 height)
          (cons 1 txt)
          '(50 . 0.0)
          '(41 . 1.0)
          '(7 . "STANDARD")
          '(71 . 0)
          '(72 . 0)
          '(100 . "AcDbText")
          '(73 . 0)))
      (entmakex data)
    )
  )
)

(defun degk--add-loop-intersection-mark (pt markLen layer / halfDiag z p0 p1)
  (if (and pt (numberp markLen) (> markLen 0.0))
    (progn
      ;; Merkezden iki yana esit uzayan, toplam markLen boyunda 45 derece isaret.
      (setq halfDiag (/ markLen 2.82842712474619)
            z        (if (and (caddr pt) (numberp (caddr pt))) (caddr pt) 0.0)
            p0       (list (- (car pt) halfDiag) (- (cadr pt) halfDiag) z)
            p1       (list (+ (car pt) halfDiag) (+ (cadr pt) halfDiag) z))
      (degk--entmake-lwpoly (list p0 p1) layer nil)
    )
  )
)

(defun degk--cable-loop-key (txt / key ch)
  (setq key (strcase (degk--clean-text txt)))
  (while (vl-string-search "LOOP" key) (setq key (vl-string-subst "L" "LOOP" key)))
  (foreach ch '(" " "-" "_")
    (while (vl-string-search ch key) (setq key (vl-string-subst "" ch key))))
  key)

(defun degk--perf-call (label fn args / started result elapsed rec)
  (if (not *degk-perf-active*)
    (apply fn args)
    (progn
      (setq started (getvar "MILLISECS")
            *degk-perf-stack* (cons label *degk-perf-stack*))
      (setq result (apply fn args)
            elapsed (- (getvar "MILLISECS") started))
      (if (< elapsed 0) (setq elapsed (+ elapsed 4294967296.0)))
      (setq rec (assoc label *degk-perf-data*)
            *degk-perf-stack* (cdr *degk-perf-stack*))
      (if rec
        (setq *degk-perf-data* (subst
          (list label (1+ (cadr rec)) (+ (caddr rec) elapsed)
                (max (nth 3 rec) elapsed)) rec *degk-perf-data*))
        (setq *degk-perf-data* (append *degk-perf-data*
          (list (list label 1 elapsed elapsed)))))
      result)))

(defun degk--perf-report (/ text rec)
  (setq *degk-perf-active* nil
        text "\n--- DK SURE RAPORU v2 ---\nAsamalar ic ice olabilir; sureleri toplamayiniz. Secim beklemeleri haric.")
  (foreach rec *degk-perf-data*
    (setq text (strcat text "\n" (car rec) ": "
      (rtos (/ (caddr rec) 1000.0) 2 3) " sn | adet=" (itoa (cadr rec))
      " | en uzun=" (rtos (/ (nth 3 rec) 1000.0) 2 3) " sn")))
  (setq text (strcat text "\nSecilen nesne=" (itoa *degk-perf-selected*)
    " | indeks text=" (itoa *degk-perf-texts*)
    " | indeks cizgi=" (itoa *degk-perf-leaders*)
    " | kesin temas testi=" (itoa *degk-perf-touches*)
    "\nAlan modu=" (cond ((= *degk-number-mode* 'NUMBERED) "NUMARALI")
                           ((= *degk-number-mode* 'UNNUMBERED) "NUMARASIZ") (T "SECILMEDI"))
    " | etiket-cizgi adayi=" (itoa (length *degk-title-index*))
    " | onbellekte loop=" (itoa (length *degk-title-cache*))))
  (foreach rec *degk-perf-stack*
    (setq text (strcat text "\nTamamlanamayan asama: " rec)))
  (setq *degk-perf-last-report* (strcat text "\n--- RAPOR SONU ---"))
  (princ))

(defun c:DKSURE ()
  (if *degk-perf-data* (degk--perf-report))
  (princ (if *degk-perf-last-report* *degk-perf-last-report*
    "\nHenuz DK sure raporu yok. Once DK calistirin."))
  (princ))

(defun degk--cable-source-index (areaSS / result)
  (setq *degk-ups-cable-texts* nil)
  (setq result (degk--perf-call "Kablo kaynak indeksi" 'degk--cable-source-index-body (list areaSS)))
  (if *degk-perf-active*
    (setq *degk-perf-texts* (length (car result))
          *degk-perf-leaders* (length (cadr result))))
  result)

(defun degk--tag-entity-points (ent ed / pts item elevation)
  ;; LINE parameters measure length, not vertex count. Preserve exact endpoints.
  (if (= (cdr (assoc 0 ed)) "LINE")
    (list (cdr (assoc 10 ed)) (cdr (assoc 11 ed)))
    (progn
      (setq elevation (cond ((cdr (assoc 38 ed))) (T 0.0)))
      (foreach item ed
        (if (= (car item) 10)
          (setq pts (cons (trans (list (cadr item) (caddr item) elevation) ent 0) pts))))
      (reverse pts))))

(defun degk--cable-source-index-body (areaSS / space ss i ent ed kind txt bb h texts leaders pts item)
  (setq space (if (and areaSS (> (sslength areaSS) 0))
                (cdr (assoc 410 (entget (ssname areaSS 0)))) "Model")
        ss (ssget "_X" (list '(0 . "TEXT,MTEXT,LINE,LWPOLYLINE") (cons 410 space))) i 0)
  (if ss
    (repeat (sslength ss)
      (setq ent (ssname ss i) i (1+ i) ed (entget ent) kind (cdr (assoc 0 ed)))
      (if (member kind '("TEXT" "MTEXT"))
        (progn
          (setq txt "")
          (foreach item ed (if (member (car item) '(1 3)) (setq txt (strcat txt (cdr item)))))
          (setq txt (degk--clean-text txt) h (cdr (assoc 40 ed))
                bb (vl-catch-all-apply 'degk--ent-bbox (list (vlax-ename->vla-object ent))))
          (if (vl-catch-all-error-p bb) (setq bb nil))
          (if (and bb h (> h 0.0) (/= txt ""))
            (setq texts (cons (list txt bb h (degk--cable-loop-key txt) (cdr (assoc 8 ed))) texts))))
        (if (or (= kind "LINE") (= 0 (logand 1 (cdr (assoc 70 ed)))))
          (progn
            ;; Tag ve loop temasini ayni WCS duzleminde karsilastir.
            (setq pts (degk--tag-entity-points ent ed))
            (if (>= (length pts) 2) (setq leaders (cons (list ent pts) leaders))))))))
  (list texts leaders))

(defun degk--numbered-device-p (ent / obj value)
  (setq obj (vl-catch-all-apply 'vlax-ename->vla-object (list ent)))
  (if (and (not (vl-catch-all-error-p obj)) (not (DEG:IGNORE-BLOCK-OBJ? obj)))
    (progn
      (setq value (vl-catch-all-apply 'degk--get-att (list obj "SIRA_NO")))
      (and (not (vl-catch-all-error-p value)) (/= (degk--clean-text value) "")))))

(defun degk--area-number-mode (areaSS / i ent ed numbered)
  (setq i 0)
  (while (and areaSS (< i (sslength areaSS)) (not numbered))
    (setq ent (ssname areaSS i) i (1+ i) ed (entget ent))
    (if (and (= (cdr (assoc 0 ed)) "INSERT") (/= (cdr (assoc 8 ed)) "0"))
      (setq numbered (degk--numbered-device-p ent))))
  (if numbered 'NUMBERED 'UNNUMBERED))

(defun degk--loop-bounds (ent / rec obj bb)
  (if (setq rec (assoc ent *degk-loop-bounds-cache*))
    (cdr rec)
    (progn
      (setq obj (vl-catch-all-apply 'vlax-ename->vla-object (list ent)))
      (if (not (vl-catch-all-error-p obj))
        (setq bb (vl-catch-all-apply 'degk--ent-bbox (list obj))))
      (if (vl-catch-all-error-p bb) (setq bb nil))
      (setq *degk-loop-bounds-cache* (cons (cons ent bb) *degk-loop-bounds-cache*))
      bb)))

(defun degk--point-near-loop-bounds-p (pt bb tol)
  (or (null bb)
      (and (>= (car pt) (- (caar bb) tol))
           (<= (car pt) (+ (caadr bb) tol))
           (>= (cadr pt) (- (cadar bb) tol))
           (<= (cadr pt) (+ (cadadr bb) tol)))))

(defun degk--cable-end-touches (pts loops tol / hit pt loopEnt near bb)
  (foreach loopEnt loops
    (if (not hit)
      (progn
        (setq bb (degk--loop-bounds loopEnt))
        (foreach pt (list (car pts) (last pts))
          (if (and (not hit) (degk--point-near-loop-bounds-p pt bb tol))
            (progn
              (if *degk-perf-active* (setq *degk-perf-touches* (1+ *degk-perf-touches*)))
              (setq near (vl-catch-all-apply 'vlax-curve-getClosestPointTo (list loopEnt pt)))
              (if (and (not (vl-catch-all-error-p near)) near (<= (distance pt near) tol))
                (setq hit T))))))))
  hit)

(defun degk--prepare-title-index (/ head leader rest a b bb h tol matches title layout segments segment lowY highY serial)
  (setq tol (DEG:CFG-TOL-NUM-OR 'DN_BLOCK_TOL 1.0)
        *degk-title-index* nil serial 0)
  ;; Polyline parcalarini her baslik icin tekrar dolasma.
  (foreach leader (cadr *degk-cable-index*)
    (setq rest (cadr leader))
    (while (cdr rest)
      (setq a (car rest) b (cadr rest) rest (cdr rest))
      (if (and (<= (abs (- (cadr a) (cadr b))) tol)
               (> (abs (- (car a) (car b))) 1e-9))
        (setq segments
          (cons (list (cadr a) (min (car a) (car b))
                      (max (car a) (car b)) leader (setq serial (1+ serial))) segments)))))
  (setq segments (vl-sort segments
    '(lambda (a b) (if (= (car a) (car b)) (< (nth 4 a) (nth 4 b)) (< (car a) (car b))))))
  (foreach head (car *degk-cable-index*)
    (setq bb (cadr head) h (caddr head) matches nil)
    (setq title (strcase (degk--clean-text (car head))))
    (while (vl-string-search "LOOP-" title)
      (setq title (vl-string-subst "L" "LOOP-" title)))
    (while (vl-string-search "LOOP" title)
      (setq title (vl-string-subst "L" "LOOP" title)))
    (setq layout (degk--layout-key-from-sira (strcat title "-01")))
    (if layout
      (progn
        (setq lowY (- (cadar bb) (* 2.0 h))
              highY (+ (cadar bb) (* 0.3 h)) rest segments)
        (while (and rest (< (caar rest) lowY)) (setq rest (cdr rest)))
        (while (and rest (<= (caar rest) highY))
          (setq segment (car rest) rest (cdr rest) leader (nth 3 segment))
          (if (and (> (- (nth 2 segment) (cadr segment)) h)
                   (>= (caar bb) (- (cadr segment) h))
                   (<= (caadr bb) (+ (nth 2 segment) h))
                   (not (member (car leader) matches)))
            (setq matches (cons (car leader) matches)
                  *degk-title-index*
                    (cons (list title (car leader) (cadr leader) head segment) *degk-title-index*)))))))
  (setq *degk-title-index-ready* T)
  *degk-title-index*)

(defun degk--source-loop-title (loops)
  (degk--perf-call "Kat-loop tag eslestirme"
    'degk--source-loop-title-body (list loops)))

(defun degk--source-loop-title-body (loops / ent rec entries entry found tol pending remaining)
  (if (not *degk-title-index-ready*)
    (degk--perf-call "Kat-loop etiketlerini bir kez hazirlama" 'degk--prepare-title-index nil))
  (setq tol (DEG:CFG-TOL-NUM-OR 'DN_BLOCK_TOL 1.0))
  (setq remaining loops)
  (while (and remaining (not found))
    (setq ent (car remaining) remaining (cdr remaining))
    (if (setq rec (assoc ent *degk-title-cache*))
      (setq entries (cdr rec))
      (progn
        (setq entries nil pending *degk-title-index*)
        (while (and pending (not entries))
          (setq entry (car pending) pending (cdr pending))
          (if (and (not (member (cadr entry) loops))
                   (degk--cable-end-touches (caddr entry) (list ent) tol))
            (setq entries (cons entry entries))))
        (setq *degk-title-cache* (cons (cons ent entries) *degk-title-cache*))))
    (while (and entries (not found))
      (setq entry (car entries) entries (cdr entries))
      (if (not (member (cadr entry) loops))
        (setq found (car entry)))))
  found)

(defun degk--source-cable-text (loops name / cable ent key)
  (setq cable (degk--perf-call "Kablo kesiti eslestirme" 'degk--source-cable-text-body (list loops name)))
  (if cable
    (foreach ent loops
      (if (degk--flasher-loop-layer-p (cdr (assoc 8 (entget ent))))
        (progn
          (setq key (strcase (vl-string-right-trim ". " cable)))
          (while (vl-string-search " " key)
            (setq key (vl-string-subst "" " " key)))
          (if (not (assoc key *degk-ups-cable-texts*))
            (setq *degk-ups-cable-texts* (cons (cons key cable) *degk-ups-cable-texts*)))))))
  cable)

(defun degk--source-cable-text-body (loops name / remaining entries entry selected head segment bb h texts cable cb y left right)
  (setq remaining loops)
  (while (and remaining (not selected))
    (setq entries (cdr (assoc (car remaining) *degk-title-cache*)) remaining (cdr remaining))
    (while (and entries (not selected))
      (setq entry (car entries) entries (cdr entries))
      (if (and (nth 3 entry) (nth 4 entry) (not (member (cadr entry) loops)))
        (setq selected entry))))
  (if selected
    (progn
      ;; Read the cable below the already accepted tag; do not match tags again.
      (setq head (nth 3 selected) segment (nth 4 selected)
            bb (cadr head) h (caddr head) y (car segment)
            left (cadr segment) right (nth 2 segment) texts (car *degk-cable-index*))
      (while (and texts (not cable))
        (setq cb (cadar texts))
        (if (and (wcmatch (strcase (caar texts)) "*#*X*#*")
                 (<= (cadadr cb) (+ y (* 0.3 h)))
                 (>= (cadar cb) (- y (* 3.0 h)))
                 (<= (abs (- (caar cb) (caar bb))) (* 2.0 h))
                 (>= (caar cb) (- left h)) (<= (caadr cb) (+ right h)))
          (setq cable (caar texts)))
        (setq texts (cdr texts)))
      cable)
    (degk--source-cable-text-unmatched-body loops name)))

(defun degk--source-cable-text-unmatched-body (loops name / key head leader pts rest a b lineY leftX rightX bb h cable cb candidates found tol)
  (setq key (degk--cable-loop-key name)
        tol (DEG:CFG-TOL-NUM-OR 'DN_BLOCK_TOL 1.0))
  (if (/= key "")
    (foreach head (car *degk-cable-index*)
      (if (= key (nth 3 head))
        (foreach leader (cadr *degk-cable-index*)
          (setq pts (cadr leader) bb (cadr head) h (caddr head))
          (if (not (member (car leader) loops))
            (progn
              (setq rest pts)
              (while (cdr rest)
                (setq a (car rest) b (cadr rest) rest (cdr rest)
                      lineY (cadr a) leftX (min (car a) (car b)) rightX (max (car a) (car b)))
                (if (and (<= (abs (- lineY (cadr b))) tol)
                         (> (- rightX leftX) h)
                         (>= (car (car bb)) (- leftX h)) (<= (car (cadr bb)) (+ rightX h))
                         (>= (- (cadr (car bb)) lineY) (* -0.3 h))
                         (<= (- (cadr (car bb)) lineY) (* 2.0 h))
                         (degk--cable-end-touches pts loops tol))
                  (foreach cable (car *degk-cable-index*)
                    (setq cb (cadr cable))
                    (if (and (wcmatch (strcase (car cable)) "*#*X*#*")
                             (<= (cadr (cadr cb)) (+ lineY (* 0.3 h)))
                             (>= (cadr (car cb)) (- lineY (* 3.0 h)))
                             (<= (abs (- (car (car cb)) (car (car bb)))) (* 2.0 h))
                             (>= (car (car cb)) (- leftX h))
                             (<= (car (cadr cb)) (+ rightX h)))
                      (if (not (member (car cable) found)) (setq found (cons (car cable) found)))))))))))))
  (if (= (length found) 1) (car found) nil))

(defun degk--add-loop-label (pts loopName singleMark cableText / layer rise run textHeight textXOffset textYMargin shift markerLen upperY lowerY anchor z p1 p2 topPt bottomPt)
  (if (and pts (setq anchor (last pts)))
    (progn
      (setq loopName   (degk--loop-label-with-panel loopName)
            layer      "e_loop_adý"
            rise       (DEG:CFG-DK-NUM-OR 'DK_LOOP_LINE_RISE 50.0)
            run        (DEG:CFG-DK-NUM-OR 'DK_LOOP_LINE_RUN 300.0)
            textHeight (DEG:CFG-DK-NUM-OR 'DK_LOOP_TEXT_HEIGHT 13.0)
            textXOffset (DEG:CFG-DK-NUM-OR 'DK_LOOP_TEXT_X_OFFSET 15.0)
            textYMargin (DEG:CFG-DK-NUM-OR 'DK_LOOP_TEXT_Y_MARGIN 5.0)
            markerLen  (DEG:CFG-DK-NUM-OR 'DK_LOOP_MARK_LENGTH 10.0)
            shift      (DEG:CFG-DK-NUM-OR 'DK_LOOP_LINE_SHIFT_X 30.0)
            upperY     (cadr (car pts))
            lowerY     (cadr anchor)
            z          (if (and (caddr anchor) (numberp (caddr anchor)))
                         (caddr anchor)
                         0.0)
            anchor     (list (+ (car anchor) shift) (cadr anchor) z)
            p1         (list (car anchor) (+ (cadr anchor) rise) z)
            p2         (list (+ (car p1) run) (cadr p1) z)
            topPt      (list (+ (car p1) textXOffset) (+ (cadr p1) textYMargin) z)
            bottomPt   (list (+ (car p1) textXOffset)
                             (- (cadr p1) textHeight textYMargin)
                             z))
      (degk--ensure-loop-layer layer)
      (degk--entmake-lwpoly (list anchor p1 p2) layer nil)
      (if (not singleMark)
        (degk--add-loop-intersection-mark
          (list (car anchor) upperY z)
          markerLen
          layer)
      )
      (degk--add-loop-intersection-mark
        (list (car anchor) lowerY z)
        markerLen
        layer)
      (degk--add-loop-text topPt loopName layer textHeight)
      (degk--add-loop-text
        bottomPt
        cableText
        layer
        textHeight)
    )
  )
)

(defun degk--under-top-pt (basePt / pts)
  (setq pts
    (degk--under-pts basePt
      (DEG:CFG-DK-NUM-OR 'DK_UNDER_X1 10.0)
      (DEG:CFG-DK-NUM-OR 'DK_UNDER_X2 10.0)
      (DEG:CFG-DK-NUM-OR 'DK_UNDER_W 70.0)
      (DEG:CFG-DK-NUM-OR 'DK_UNDER_H 60.0)
    )
  )
  (if (and pts (cadr pts)) (cadr pts) basePt)
)

(defun degk--rgb-string->420 (s / parts r g b)
  (if (and (= (type s) 'STR) (vl-string-search "," s))
    (progn
      (setq parts (degk--split-commas s))
      (if (= (length parts) 3)
        (progn
          (setq r (fix (atof (nth 0 parts))))
          (setq g (fix (atof (nth 1 parts))))
          (setq b (fix (atof (nth 2 parts))))
          (if (and (<= 0 r) (<= r 255) (<= 0 g) (<= g 255) (<= 0 b) (<= b 255))
            (+ (* r 65536) (* g 256) b)
          )
        )
      )
    )
  )
)

(defun degk--color-dxfs-from-layer (lay / rec c420 c62 aci)
  (setq rec (if (and lay (= (type lay) 'STR) (/= lay "")) (tblsearch "LAYER" lay)))
  (cond
    ((and rec (setq c420 (assoc 420 rec)))
      (setq c62 (assoc 62 rec))
      (setq aci (if c62 (abs (cdr c62)) 256))
      (list (cons 62 aci) c420)
    )
    ((and rec (setq c62 (assoc 62 rec)))
      (list (cons 62 (abs (cdr c62))))
    )
    (T '((62 . 256)))
  )
)

(defun degk--color-dxfs-from-entity (ent lay / ed c420 c62 aci)
  (setq ed (if ent (entget ent)))
  (cond
    ((and ed (setq c420 (assoc 420 ed)))
      (setq c62 (assoc 62 ed))
      (setq aci (if c62 (cdr c62) 256))
      (list (cons 62 aci) c420)
    )
    ((and ed (setq c62 (assoc 62 ed)))
      (setq aci (cdr c62))
      (if (or (null aci) (= aci 256) (= aci 0))
        (degk--color-dxfs-from-layer lay)
        (list (cons 62 aci))
      )
    )
    (T (degk--color-dxfs-from-layer lay))
  )
)

(defun degk--normalize-color-dxfs (color / rgb)
  (cond
    ((and color (listp color) (listp (car color))) color)
    ((setq rgb (degk--rgb-string->420 color)) (list '(62 . 256) (cons 420 rgb)))
    ((numberp color) (list (cons 62 (fix color))))
    (T '((62 . 256)))
  )
)

(defun degk--entmake-lwpoly (pts layer color / data colorData)
  (setq colorData (degk--normalize-color-dxfs color))
  (setq data
    (append
      (list
        '(0 . "LWPOLYLINE")
        '(100 . "AcDbEntity")
        (cons 8 layer)
      )
      colorData
      (list
        '(100 . "AcDbPolyline")
        (cons 90 (length pts))
        (cons 70 0)
      )
      (mapcar (function (lambda (p) (cons 10 (list (car p) (cadr p))))) pts)
    )
  )
  (entmake data)
)

(defun degk--entmake-lwpoly-bulges (pts bulges layer color / data colorData i p b)
  (setq colorData (degk--normalize-color-dxfs color)
        data
          (append
            (list
              '(0 . "LWPOLYLINE")
              '(100 . "AcDbEntity")
              (cons 8 layer))
            colorData
            (list
              '(100 . "AcDbPolyline")
              (cons 90 (length pts))
              (cons 70 0)))
        i 0)
  (foreach p pts
    (setq b (if (and bulges (numberp (nth i bulges))) (nth i bulges) 0.0)
          data
            (append data
              (list
                (cons 10 (list (car p) (cadr p)))
                (cons 42 b)))
          i (1+ i)))
  (entmake data)
)

(defun degk--ensure-layer (layName / doc lays lay)
  (setq doc  (vla-get-ActiveDocument (vlax-get-acad-object)))
  (setq lays (vla-get-Layers doc))
  (setq lay (vl-catch-all-apply 'vla-Item (list lays layName)))
  (if (vl-catch-all-error-p lay)
    (vla-Add lays layName)
  )
  layName
)



(defun degk--safe-layer-object (layName / doc lays lay)
  (if (and layName (= (type layName) 'STR) (/= layName ""))
    (progn
      (setq doc  (vla-get-ActiveDocument (vlax-get-acad-object)))
      (setq lays (vla-get-Layers doc))
      (setq lay (vl-catch-all-apply 'vla-Item (list lays layName)))
      (if (vl-catch-all-error-p lay)
        (setq lay (vl-catch-all-apply 'vla-Add (list lays layName)))
      )
      (if (vl-catch-all-error-p lay) nil lay)
    )
  )
)

(defun degk--ensure-layer-editable (layName / lay)
  (setq lay (degk--safe-layer-object layName))
  (if lay
    (progn
      (vl-catch-all-apply 'vla-put-LayerOn (list lay :vlax-true))
      (vl-catch-all-apply 'vla-put-Freeze  (list lay :vlax-false))
      (vl-catch-all-apply 'vla-put-Lock    (list lay :vlax-false))
    )
  )
  layName
)

(defun degk--safe-put-layer (obj layName / res)
  (if (and obj layName (/= layName ""))
    (progn
      (degk--ensure-layer-editable layName)
      (setq res (vl-catch-all-apply 'vla-put-Layer (list obj layName)))
      (not (vl-catch-all-error-p res))
    )
  )
)

(defun degk--att-list (blkObj / raw hv)
  (setq raw nil)
  (if (and blkObj (= (type blkObj) 'VLA-OBJECT)
           (vlax-method-applicable-p blkObj 'GetAttributes))
    (progn
      (setq hv (vl-catch-all-apply 'vla-get-HasAttributes (list blkObj)))
      (if (and (not (vl-catch-all-error-p hv)) (= hv :vlax-true))
        (setq raw (vl-catch-all-apply 'vlax-invoke (list blkObj 'GetAttributes)))
      )
    )
  )
  (cond
    ((vl-catch-all-error-p raw) nil)
    ((= (type raw) 'VARIANT)  (degk--sa->list (vlax-variant-value raw)))
    ((= (type raw) 'SAFEARRAY) (vlax-safearray->list raw))
    ((listp raw) raw)
    (T nil)
  )
)

(defun degk--make-object-and-atts-editable (obj / lay atts a)
  (if (and obj (= (type obj) 'VLA-OBJECT))
    (progn
      (setq lay (vl-catch-all-apply 'vla-get-Layer (list obj)))
      (if (not (vl-catch-all-error-p lay))
        (degk--ensure-layer-editable lay)
      )
      (setq atts (degk--att-list obj))
      (foreach a atts
        (setq lay (vl-catch-all-apply 'vla-get-Layer (list a)))
        (if (not (vl-catch-all-error-p lay))
          (degk--ensure-layer-editable lay)
        )
      )
    )
  )
  obj
)

(defun degk--clean-text (s /)
  (if (null s) (setq s ""))
  (if (/= (type s) 'STR) (setq s (vl-princ-to-string s)))
  (while (vl-string-search "\\P" s) (setq s (vl-string-subst " " "\\P" s)))
  (while (vl-string-search "\\p" s) (setq s (vl-string-subst " " "\\p" s)))
  (while (vl-string-search (chr 13) s) (setq s (vl-string-subst " " (chr 13) s)))
  (while (vl-string-search (chr 10) s) (setq s (vl-string-subst " " (chr 10) s)))
  (while (vl-string-search (chr 9) s)  (setq s (vl-string-subst " " (chr 9) s)))
  (while (vl-string-search "  " s) (setq s (vl-string-subst " " "  " s)))
  (vl-string-trim " " s)
)

(defun degk--first-n (lst n / out i)
  (setq out nil i 0)
  (while (and lst (< i n))
    (setq out (cons (car lst) out))
    (setq lst (cdr lst))
    (setq i (1+ i))
  )
  (reverse out)
)

(defun degk--limit-sira-list (lst / maxN)
  (setq maxN (fix (DEG:CFG-NUM-OR 'DK_MAX_SIRA_EXPAND 1000.0)))
  (if (< maxN 1) (setq maxN 1000))
  (if (and lst (> (length lst) maxN))
    (progn
      (princ (strcat "\nDK: SIRA_NO seri acilimi " (itoa (length lst)) " adet. Ilk " (itoa maxN) " kopya alinacak."))
      (degk--first-n lst maxN)
    )
    lst
  )
)

(defun degk--make-scale-positive (blk / prop value)
  (if (and blk (= (type blk) 'VLA-OBJECT))
    (foreach prop '(XScaleFactor YScaleFactor ZScaleFactor)
      (if (vlax-property-available-p blk prop T)
        (progn
          (setq value (vl-catch-all-apply 'vlax-get-property (list blk prop)))
          (if (and (not (vl-catch-all-error-p value)) (numberp value))
            (vl-catch-all-apply 'vlax-put-property (list blk prop (abs value)))
          )
        )
      )
    )
  )
  blk
)

(defun degk--scale-room-block (blk factor / prop value)
  ;; AutoCAD SCALE factoru gibi mevcut mutlak X/Y/Z olceklerini carp.
  (if (and blk (= (type blk) 'VLA-OBJECT)
           (numberp factor) (> factor 0.0))
    (foreach prop '(XScaleFactor YScaleFactor ZScaleFactor)
      (if (vlax-property-available-p blk prop T)
        (progn
          (setq value (vl-catch-all-apply 'vlax-get-property (list blk prop)))
          (if (and (not (vl-catch-all-error-p value)) (numberp value))
            (vl-catch-all-apply
              'vlax-put-property
              (list blk prop (* factor (abs value)))))))))
  blk
)

(defun degk--copy-room-block-safe (sourceEnt targetPt / sourceObj copyObj fromPt res)
  ;; Elektrik odasi kopyasinda kaynak layer ve attribute degerleri korunur.
  (setq copyObj nil)
  (if (and sourceEnt targetPt)
    (progn
      (setq sourceObj
        (vl-catch-all-apply 'vlax-ename->vla-object (list sourceEnt)))
      (if (not (vl-catch-all-error-p sourceObj))
        (progn
          (setq res
            (vl-catch-all-apply
              (function
                (lambda ()
                  (degk--make-object-and-atts-editable sourceObj)
                  (setq copyObj (vla-Copy sourceObj))
                  (degk--scale-room-block copyObj 2.0)
                  (degk--make-object-and-atts-editable copyObj)
                  (setq fromPt (deg-get-inspt copyObj))
                  (if fromPt
                    (vla-Move
                      copyObj
                      (vlax-3d-point fromPt)
                      (vlax-3d-point targetPt))
                    (error "Elektrik odasi block insertion noktasi okunamadi."))
                  (if (vlax-property-available-p copyObj 'Rotation T)
                    (vla-put-Rotation copyObj 0.0))
                  copyObj))
              '()))
          (if (vl-catch-all-error-p res)
            (progn
              (if copyObj
                (vl-catch-all-apply 'vla-Delete (list copyObj)))
              (setq copyObj nil)))))))
  copyObj
)

(defun degk--copy-dk-block-safe (blkObj baseW siraOne / res msg copyObj copyE fromPt textBase dY safeSira nm)
  (setq *DEG_DK_LAST_COPY_OBJ* nil)
  (setq safeSira (degk--clean-text siraOne))
  (setq res
    (vl-catch-all-apply
      (function
        (lambda ()
          (degk--make-object-and-atts-editable blkObj)
          (setq copyObj (vla-Copy blkObj))
          (degk--make-scale-positive copyObj)
          (degk--safe-put-layer copyObj (DEG:VAL 'O2))
          (degk--make-object-and-atts-editable copyObj)
          (setq fromPt (deg-get-inspt copyObj))
          (if fromPt
            (vla-Move copyObj (vlax-3d-point fromPt) (vlax-3d-point baseW))
          )
          (if (vlax-property-available-p copyObj 'Rotation)
            (vl-catch-all-apply 'vla-put-Rotation (list copyObj 0.0))
          )
          (setq copyE (vlax-vla-object->ename copyObj))
          (degk--reset-insert-attrs copyE)
          (degk--make-object-and-atts-editable copyObj)
          (if (/= safeSira "")
            (degk--set-att copyObj "SIRA_NO" safeSira)
          )
          (degk--set-att copyObj "ADET" "")
          (setq dY (degk--calc-dy-to-touch-underline copyObj baseW))
          (if (/= dY 0.0)
            (vla-Move copyObj (vlax-3d-point '(0 0 0)) (vlax-3d-point (list 0.0 dY 0.0)))
          )
          (if (not (degkk--active-p))
            (progn
              (setq textBase (degk--under-top-pt baseW))
              (degk--add-text textBase safeSira (DEG:VAL 'O1))
            )
          )
          (degk--set-att copyObj "SIRA_NO" "")
          (setq *DEG_DK_LAST_COPY_OBJ* copyObj)
          T
        )
      )
      '()
    )
  )
  (if (vl-catch-all-error-p res)
    (progn
      (if (and copyObj (= (type copyObj) 'VLA-OBJECT))
        (vl-catch-all-apply 'vla-Delete (list copyObj))
      )
      (setq *DEG_DK_LAST_COPY_OBJ* nil)
      (setq msg (vl-catch-all-error-message res))
      (setq nm (degk--blockname blkObj))
      (if (null nm) (setq nm "<BLOCK>"))
      (princ (strcat "\nDK: " nm " atlandi. Sebep: " msg))
      nil
    )
    T
  )
)

(defun degk--ensure-textstyle (styName fontFile / rec en ed)
  (if (and styName fontFile)
    (progn
      (setq rec (tblsearch "STYLE" styName))
      (if (not rec)
        (entmake
          (list
            (cons 0 "STYLE")
            (cons 2 styName)
            (cons 70 0)
            (cons 40 0.0)
            (cons 41 1.0)
            (cons 50 0.0)
            (cons 71 0)
            (cons 42 0.0)
            (cons 3 fontFile)
            (cons 4 "")
          )
        )
        ;; style varsa ama font farkliysa guncelle
        (progn
          (setq en (tblobjname "STYLE" styName))
          (if en
            (progn
              (setq ed (entget en))
              (if (and ed (assoc 3 ed) (/= (cdr (assoc 3 ed)) fontFile))
                (progn
                  (setq ed (subst (cons 3 fontFile) (assoc 3 ed) ed))
                  (entmod ed)
                  (entupd en)
                )
              )
            )
          )
        )
      )
    )
  )
  styName
)


(defun degk--layer-visible-p (doc layName / lays lay)
  (setq lays (vla-get-Layers doc))
  (setq lay  (vl-catch-all-apply 'vla-Item (list lays layName)))
  (if (vl-catch-all-error-p lay)
    T
    (and (= :vlax-false (vla-get-Freeze lay))
         (= :vlax-true  (vla-get-LayerOn lay)))
  )
)

(defun degk--bbox-include-obj-p (obj / n)
  (setq n (vla-get-ObjectName obj))
  (not (member n '("AcDbText" "AcDbMText" "AcDbAttribute" "AcDbAttributeDefinition")))
)

(defun degk--min (a b) (if (< a b) a b))
(defun degk--max (a b) (if (> a b) a b))

(defun degk--bbox-union (bb1 bb2 / a1 b1 a2 b2)
  (if (null bb1) bb2
    (if (null bb2) bb1
      (progn
        (setq a1 (car bb1) b1 (cadr bb1))
        (setq a2 (car bb2) b2 (cadr bb2))
        (list
          (list (degk--min (car a1) (car a2))
                (degk--min (cadr a1) (cadr a2))
                (degk--min (caddr a1) (caddr a2)))
          (list (degk--max (car b1) (car b2))
                (degk--max (cadr b1) (cadr b2))
                (degk--max (caddr b1) (caddr b2)))
        )
      )
    )
  )
)

(defun degk--sa->list (x)
  (cond
    ((= (type x) 'VARIANT)  (degk--sa->list (vlax-variant-value x)))
    ((= (type x) 'SAFEARRAY) (vlax-safearray->list x))
    ((listp x) x)
    (t nil)
  )
)

(defun degk--ent-bbox (vlaEnt / vmin vmax minL maxL)
  (setq vmin nil vmax nil)
  (if (not (vl-catch-all-error-p (vl-catch-all-apply 'vla-GetBoundingBox (list vlaEnt 'vmin 'vmax))))
    (progn
      (setq minL (degk--sa->list vmin))
      (setq maxL (degk--sa->list vmax))
      (if (and minL maxL)
        (list
          (list (car minL) (cadr minL) (if (caddr minL) (caddr minL) 0.0))
          (list (car maxL) (cadr maxL) (if (caddr maxL) (caddr maxL) 0.0))
        )
        nil
      )
    )
    nil
  )
)


(defun degk--bbox-from-pts (pts / bb p z)
  (setq bb nil)
  (foreach p pts
    (if p
      (progn
        (setq z (if (caddr p) (caddr p) 0.0))
        (setq bb
          (degk--bbox-union
            bb
            (list (list (car p) (cadr p) z)
                  (list (car p) (cadr p) z))
          )
        )
      )
    )
  )
  bb
)

(defun degk--bbox-transform (bb ip sx sy sz rot / a b)
  (if (and bb ip)
    (progn
      (setq a (car bb))
      (setq b (cadr bb))
      (degk--bbox-from-pts
        (list
          (degk--xf-pt (list (car a) (cadr a) (caddr a)) ip sx sy sz rot)
          (degk--xf-pt (list (car b) (cadr a) (caddr a)) ip sx sy sz rot)
          (degk--xf-pt (list (car b) (cadr b) (caddr b)) ip sx sy sz rot)
          (degk--xf-pt (list (car a) (cadr b) (caddr b)) ip sx sy sz rot)
        )
      )
    )
  )
)

(defun degk--get-bbox-visible-by-blockdef (blkRef / doc insE insD blkName ip rot sx sy sz btr e d obj bb bbO bbW)
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)))
  (setq insE
    (cond
      ((= (type blkRef) 'ENAME) blkRef)
      ((= (type blkRef) 'VLA-OBJECT)
        (vl-catch-all-apply 'vlax-vla-object->ename (list blkRef))
      )
    )
  )
  (if (vl-catch-all-error-p insE) (setq insE nil))
  (if (and insE (setq insD (entget insE)) (= (cdr (assoc 0 insD)) "INSERT"))
    (progn
      (setq blkName (cdr (assoc 2 insD)))
      (setq ip  (cdr (assoc 10 insD)))
      (setq rot (cdr (assoc 50 insD))) (if (null rot) (setq rot 0.0))
      (setq sx  (cdr (assoc 41 insD))) (if (null sx) (setq sx 1.0))
      (setq sy  (cdr (assoc 42 insD))) (if (null sy) (setq sy sx))
      (setq sz  (cdr (assoc 43 insD))) (if (null sz) (setq sz 1.0))
      (setq btr (tblobjname "BLOCK" blkName))
      (if (null btr)
        (progn
          (setq obj (vl-catch-all-apply 'vlax-ename->vla-object (list insE)))
          (if (not (vl-catch-all-error-p obj))
            (progn
              (setq blkName (degk--blockname obj))
              (if blkName (setq btr (tblobjname "BLOCK" blkName)))
            )
          )
        )
      )
      (if btr
        (progn
          (setq bb nil)
          (setq e (entnext btr))
          (while (and e (/= (cdr (assoc 0 (entget e))) "ENDBLK"))
            (setq d (entget e))
            (setq obj (vl-catch-all-apply 'vlax-ename->vla-object (list e)))
            (if (and (not (vl-catch-all-error-p obj))
                     (degk--layer-visible-p doc (cdr (assoc 8 d)))
                     (degk--bbox-include-obj-p obj))
              (progn
                (setq bbO (degk--ent-bbox obj))
                (setq bbW (degk--bbox-transform bbO ip sx sy sz rot))
                (if bbW (setq bb (degk--bbox-union bb bbW)))
              )
            )
            (setq e (entnext e))
          )
          bb
        )
      )
    )
  )
)

(defun degk--get-bbox-visible-by-explode (blkRef / doc arr lst bb o bbO)
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)))
  (setq arr (vl-catch-all-apply 'vla-Explode (list blkRef)))
  (if (vl-catch-all-error-p arr)
    nil
    (progn
      (setq lst (vlax-safearray->list (vlax-variant-value arr)))
      (setq bb nil)
      (foreach o lst
        (if (and (degk--layer-visible-p doc (vla-get-Layer o))
                 (degk--bbox-include-obj-p o))
          (progn
            (setq bbO (degk--ent-bbox o))
            (if bbO (setq bb (degk--bbox-union bb bbO)))
          )
        )
      )
      (foreach o lst (vl-catch-all-apply 'vla-Delete (list o)))
      bb
    )
  )
)

(defun degk--monitor-plan-primitive-p (obj / n)
  ;; Kolon semasi baglantisinda yalniz plan sembolunu olusturan gercek
  ;; cizgisel geometriler sinira katilir. POINT, TEXT, ATTRIB, HATCH ve
  ;; yardimci/proxy nesneler hedef kenarini degistiremez.
  (setq n (vl-catch-all-apply 'vla-get-ObjectName (list obj)))
  (and
    (not (vl-catch-all-error-p n))
    (member n
      '("AcDbLine"
        "AcDbPolyline"
        "AcDb2dPolyline"
        "AcDb3dPolyline"
        "AcDbArc"
        "AcDbCircle"
        "AcDbEllipse"
        "AcDbSpline"
        "AcDbRegion"
        "AcDbSolid"
        "AcDbTrace"
        "AcDbFace")))
)

(defun degk--monitor-plan-bbox-from-object
  (obj doc depth / n lay bb mn mx dx dy arr lst child childBB)
  (setq n (vl-catch-all-apply 'vla-get-ObjectName (list obj)))
  (if (vl-catch-all-error-p n) (setq n ""))
  (cond
    ((degk--monitor-plan-primitive-p obj)
      (setq lay (vl-catch-all-apply 'vla-get-Layer (list obj)))
      (if (and (not (vl-catch-all-error-p lay))
               (degk--layer-visible-p doc lay))
        (progn
          (setq bb (degk--ent-bbox obj))
          ;; Sifir boyutlu yardimci LINE/POINT benzeri kayitlari da ele.
          (if bb
            (progn
              (setq mn (car bb)
                    mx (cadr bb)
                    dx (abs (- (car mx) (car mn)))
                    dy (abs (- (cadr mx) (cadr mn))))
              (if (> (+ dx dy) 1.0e-8) bb nil))
            nil))
        nil))
    ((and (= n "AcDbBlockReference") (< depth 6))
      ;; Ic ice sembollerde de yazilari degil, alt blocklarin plan
      ;; geometrisini hesaba kat.
      (setq arr (vl-catch-all-apply 'vla-Explode (list obj)))
      (if (vl-catch-all-error-p arr)
        nil
        (progn
          (setq lst (degk--sa->list arr)
                bb nil)
          (foreach child lst
            (setq childBB
              (degk--monitor-plan-bbox-from-object
                child doc (1+ depth)))
            (if childBB (setq bb (degk--bbox-union bb childBB))))
          (foreach child lst
            (vl-catch-all-apply 'vla-Delete (list child)))
          bb)))
    (t nil))
)

(defun degk--get-monitor-plan-bbox-by-explode
  (blkRef / doc arr lst bb obj objBB)
  ;; Gercek yapistirilmis block kopyasini acarak WCS plan sinirini bulur.
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object))
        arr (vl-catch-all-apply 'vla-Explode (list blkRef)))
  (if (vl-catch-all-error-p arr)
    nil
    (progn
      (setq lst (degk--sa->list arr)
            bb nil)
      (foreach obj lst
        (setq objBB (degk--monitor-plan-bbox-from-object obj doc 0))
        (if objBB (setq bb (degk--bbox-union bb objBB))))
      (foreach obj lst
        (vl-catch-all-apply 'vla-Delete (list obj)))
      bb))
)

(defun degk--get-monitor-plan-bbox-by-blockdef
  (blkRef / doc insE insD blkName ip rot sx sy sz btr ent data obj bb bbO bbW mn mx dx dy)
  ;; EXPLODE korumali/dinamik blockta kullanilamazsa ayni kati filtreyi
  ;; block tanimina uygula. Genel INSERT bbox'ina geri donulmez; cunku base
  ;; noktasindaki POINT/yardimci nesne hedef kenarini yanlis gosterebilir.
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object))
        insE
          (cond
            ((= (type blkRef) 'ENAME) blkRef)
            ((= (type blkRef) 'VLA-OBJECT)
              (setq obj
                (vl-catch-all-apply
                  'vlax-vla-object->ename (list blkRef)))
              (if (vl-catch-all-error-p obj) nil obj))
            (t nil))
        insD (if insE (entget insE) nil))
  (if (and insD (= (cdr (assoc 0 insD)) "INSERT"))
    (progn
      (setq blkName (cdr (assoc 2 insD))
            ip      (cdr (assoc 10 insD))
            rot     (cdr (assoc 50 insD))
            sx      (cdr (assoc 41 insD))
            sy      (cdr (assoc 42 insD))
            sz      (cdr (assoc 43 insD)))
      (if (null rot) (setq rot 0.0))
      (if (null sx)  (setq sx 1.0))
      (if (null sy)  (setq sy sx))
      (if (null sz)  (setq sz 1.0))
      (setq btr (if blkName (tblobjname "BLOCK" blkName) nil))
      (if btr
        (progn
          (setq bb nil
                ent (entnext btr))
          (while (and ent
                      (/= (cdr (assoc 0 (entget ent))) "ENDBLK"))
            (setq data (entget ent)
                  obj
                    (vl-catch-all-apply
                      'vlax-ename->vla-object (list ent)))
            (if (and (not (vl-catch-all-error-p obj))
                     (degk--layer-visible-p doc (cdr (assoc 8 data)))
                     (degk--monitor-plan-primitive-p obj))
              (progn
                (setq bbO (degk--ent-bbox obj))
                (if bbO
                  (progn
                    (setq mn (car bbO)
                          mx (cadr bbO)
                          dx (abs (- (car mx) (car mn)))
                          dy (abs (- (cadr mx) (cadr mn))))
                    (if (> (+ dx dy) 1.0e-8)
                      (progn
                        (setq bbW
                          (degk--bbox-transform
                            bbO ip sx sy sz rot))
                        (if bbW
                          (setq bb (degk--bbox-union bb bbW))))))))
            )
            (setq ent (entnext ent)))
          bb)
        nil))
    nil)
)

(defun degk--calc-dy-to-touch-underline (blkObj baseW / bb minp minY targetY)
  (setq bb (degk--get-bbox-visible-by-blockdef blkObj))
  (if (null bb)
    (setq bb (degk--ent-bbox blkObj))
  )
  (if (null bb)
    0.0
    (progn
      (setq minp (car bb))
      (setq minY (cadr minp))
      (setq targetY
        (- (cadr baseW) (* 20.0 (DEG:PLAN-UNIT-SCALE))))
      (- targetY minY)
    )
  )
)


(defun degk--add-text (insPt txt lay / doc ms p tx z res)
  (vl-load-com)
  (setq txt (degk--clean-text txt))
  (if (and insPt txt (/= txt ""))
    (progn
      (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)))
      (setq ms  (vla-get-ModelSpace doc))

      (degk--ensure-textstyle "STANDARD" "arial.ttf")
      (if lay (degk--ensure-layer-editable lay))

      (setq z (if (caddr insPt) (caddr insPt) 0.0))
      (setq p (list (car insPt) (+ (cadr insPt) (DEG:CFG-DK-NUM-OR 'DK_TEXT_OFFSET_Y 90.0)) z))

      (setq res (vl-catch-all-apply 'vla-AddText (list ms txt (vlax-3d-point p) (DEG:CFG-DK-NUM-OR 'DK_TEXT_HEIGHT 25.0))))
      (if (vl-catch-all-error-p res)
        (progn
          (princ (strcat "\nDK: SIRA_NO texti yazilamadi. Sebep: " (vl-catch-all-error-message res)))
          nil
        )
        (progn
          (setq tx res)
          (if lay (vl-catch-all-apply 'vla-put-Layer (list tx lay)))
          (if (vlax-property-available-p tx 'StyleName)
            (vl-catch-all-apply 'vla-put-StyleName (list tx "STANDARD"))
          )
          (if (vlax-property-available-p tx 'Rotation)
            (vl-catch-all-apply 'vla-put-Rotation (list tx (/ pi 2.0)))
          )
          (if (vlax-property-available-p tx 'Alignment)
            (progn
              (vl-catch-all-apply 'vla-put-Alignment (list tx acAlignmentMiddleLeft))
              (vl-catch-all-apply 'vla-put-TextAlignmentPoint (list tx (vlax-3d-point p)))
            )
          )
          tx
        )
      )
    )
  )
)

(defun degk--normal-area-layer-p (layer / dkAreaHit dkAreaPattern)
  (setq dkAreaHit nil)
  (foreach dkAreaPattern (DEG:CFG-LIST 'DK_NORMAL_AREA_LAYERS)
    (if (and dkAreaPattern (/= dkAreaPattern "") (deg-wcmatch layer dkAreaPattern))
      (setq dkAreaHit T)
    )
  )
  dkAreaHit
)

(defun degk--fire-line-layer-p (layer)
  (and layer
       (or (deg-wcmatch layer "*FIRE*LINE*")
           (deg-wcmatch layer "*YANGIN*HAT*")))
)

(defun degk--curve-length-safe (ent / endParam curveLen)
  (setq endParam
    (vl-catch-all-apply 'vlax-curve-getEndParam (list ent)))
  (if (vl-catch-all-error-p endParam)
    nil
    (progn
      (setq curveLen
        (vl-catch-all-apply
          'vlax-curve-getDistAtParam
          (list ent endParam)))
      (if (or (vl-catch-all-error-p curveLen)
              (not (numberp curveLen)))
        nil
        curveLen)
    )
  )
)

(defun degk--normal-area-fire-length-ok-p (ent layer / curveLen minLen)
  (if (not (degk--fire-line-layer-p layer))
    T
    (progn
      ;; Ayar tabani cm'dir: 10000 mm = 1000 cm.
      (setq curveLen (degk--curve-length-safe ent)
            minLen   (* 1000.0 (DEG:PLAN-UNIT-SCALE)))
      (and (numberp curveLen) (> curveLen minLen))
    )
  )
)

(defun degk--normal-area-loop-entity-p (ent / ed entType layer)
  (setq ed      (if ent (entget ent) nil)
        entType (if ed (cdr (assoc 0 ed)) nil)
        layer   (if ed (cdr (assoc 8 ed)) nil))
  (and layer
       (or (= entType "LWPOLYLINE") (= entType "POLYLINE"))
       (degk--normal-area-layer-p layer)
       (degk--normal-area-fire-length-ok-p ent layer))
)

(defun degk--monitor-link-blocks (plEnt tol / plObj bb mn mx pad p1 p2 ss i ent blkObj out)
  ;; Butun plandaki INSERT'leri VLA nesnesine cevirmek buyuk cizimlerde ilk
  ;; DK calismasinda ActiveX bellegini zorlayabiliyor. Yalniz bu yardimci
  ;; polyline'in gorunur cevresindeki blocklari tara.
  (setq plObj
    (cond
      ((= (type plEnt) 'VLA-OBJECT) plEnt)
      ((= (type plEnt) 'ENAME)
        (setq plObj
          (vl-catch-all-apply 'vlax-ename->vla-object (list plEnt)))
        (if (vl-catch-all-error-p plObj) nil plObj))
      (T nil)))
  (if (not (numberp tol)) (setq tol 0.0))
  (setq bb (if plObj (degk--ent-bbox plObj) nil)
        pad (max (abs tol) (* 5.0 (DEG:PLAN-UNIT-SCALE))))
  (if bb
    (progn
      (setq mn (car bb)
            mx (cadr bb)
            p1 (list (- (car mn) pad) (- (cadr mn) pad))
            p2 (list (+ (car mx) pad) (+ (cadr mx) pad))
            ss (ssget "_C" p1 p2 '((0 . "INSERT")))))
  )
  (setq i 0)
  (if ss
    (while (< i (sslength ss))
      (setq ent    (ssname ss i)
            blkObj (if ent
                     (vl-catch-all-apply
                       'vlax-ename->vla-object (list ent))
                     nil))
      (if (and blkObj
               (not (vl-catch-all-error-p blkObj))
               (not (DEG:IGNORE-BLOCK-OBJ? blkObj)))
        (setq out (cons blkObj out)))
      (setq i (1+ i)))
  )
  (reverse out)
)

(defun degk--monitor-source-on-aux-polyline
  (plEnt blockObjs tol / blkObj score best bestScore)
  ;; Ayni yardimci hatta yakin birden fazla monitor varsa gercek hat ucuna
  ;; en iyi temas eden monitor kaynak kabul edilir.
  (foreach blkObj blockObjs
    (if (degk--monitor-module-p blkObj)
      (progn
        (setq score
          (degk--flasher-terminal-endpoint-score plEnt blkObj tol))
        (if (and (numberp score)
                 (or (null bestScore) (< score bestScore)))
          (setq best blkObj
                bestScore score)))))
  best
)

(defun degk--monitor-endpoint-block-score
  (plEnt blkObj targetPt / exactTol bb plObj res lst p gap ins score best exploded obj cp)
  ;; Bbox yalniz hizli on elemedir. Kabul icin polyline'in hedef ucu blok
  ;; geometrisiyle gercekten kesismeli veya patlatilmis egriye oturmalidir.
  (setq exactTol
          (max 0.000001 (* 0.01 (DEG:PLAN-UNIT-SCALE)))
        bb (degk--get-bbox-visible-by-blockdef blkObj))
  (if (null bb) (setq bb (degk--ent-bbox blkObj)))
  (if (and targetPt
           bb
           (degk--point-in-bbox-tol-p targetPt bb exactTol))
    (progn
      (setq plObj
        (cond
          ((= (type plEnt) 'VLA-OBJECT) plEnt)
          ((= (type plEnt) 'ENAME)
            (setq res
              (vl-catch-all-apply
                'vlax-ename->vla-object (list plEnt)))
            (if (vl-catch-all-error-p res) nil res))
          (T nil)))
      ;; Once blok referansi ile gercek IntersectWith noktalarinin tamamini
      ;; tara; hattin ortasindaki kesisimler hedef uca uzak oldugu icin elenir.
      (if plObj
        (progn
          (setq res
            (vl-catch-all-apply
              'vlax-invoke
              (list plObj 'IntersectWith blkObj 0)))
          (if (not (vl-catch-all-error-p res))
            (progn
              (setq lst (vl-catch-all-apply 'DEG:PT->LIST (list res)))
              (if (vl-catch-all-error-p lst) (setq lst nil))
              (while (and (listp lst) (>= (length lst) 2))
                (setq p
                  (list
                    (nth 0 lst)
                    (nth 1 lst)
                    (if (and (>= (length lst) 3)
                             (numberp (nth 2 lst)))
                      (nth 2 lst)
                      (if (caddr targetPt) (caddr targetPt) 0.0)))
                  gap (distance targetPt p))
                (if (<= gap exactTol)
                  (setq best gap))
                (setq lst
                  (if (>= (length lst) 3) (cdddr lst) nil)))))))
      ;; GstarCAD blok referansi IntersectWith desteklemiyorsa, yalniz bbox
      ;; adayini gecici patlatip ucun gercek egriye oturdugunu dogrula.
      (if (null best)
        (progn
          (setq exploded (degw-explode->list blkObj))
          (foreach obj exploded
            (if (degw-entity-eligible-for-bbox-p obj)
              (progn
                (setq cp
                  (vl-catch-all-apply
                    'vlax-curve-getClosestPointTo
                    (list obj targetPt)))
                (if (not (vl-catch-all-error-p cp))
                  (progn
                    (setq gap (distance targetPt cp))
                    (if (and (<= gap exactTol)
                             (or (null best) (< gap best)))
                      (setq best gap)))))))
          (degw-delete-objects exploded)))
      (if (numberp best)
        (progn
          (setq ins (deg-get-inspt blkObj)
                score
                  (+ best
                     (if ins
                       (* 1.0e-6 (distance targetPt ins))
                       0.0)))
          score)
        nil))
    nil)
)

(defun degk--monitor-target-on-aux-polyline
  (plEnt monitorObj blockObjs tol / sourcePt sourceDist totalLen sp ep targetPt blkObj score best bestScore)
  ;; Hattin ortasinda kesistigi blocklar hedef degildir. Monitor temasinin
  ;; karsisindaki gercek polyline ucuna degmis tek block hedef kabul edilir.
  (setq sourcePt
    (degk--flasher-terminal-contact-point plEnt monitorObj tol))
  (if sourcePt
    (progn
      (setq sourceDist (degk--dist-along plEnt sourcePt)
            totalLen
              (vl-catch-all-apply
                'vlax-curve-getDistAtParam
                (list plEnt (vlax-curve-getEndParam plEnt)))
            sp (vl-catch-all-apply 'vlax-curve-getStartPoint (list plEnt))
            ep (vl-catch-all-apply 'vlax-curve-getEndPoint (list plEnt)))
      (if (vl-catch-all-error-p totalLen) (setq totalLen nil))
      (if (vl-catch-all-error-p sp) (setq sp nil))
      (if (vl-catch-all-error-p ep) (setq ep nil))
      ;; Monitor hangi uca daha yakinsa hedef bunun karsisindaki uctur.
      (if (and (numberp sourceDist) (numberp totalLen) sp ep)
        (setq targetPt
          (if (<= sourceDist (* 0.5 totalLen)) ep sp)))
      (if targetPt
        (foreach blkObj blockObjs
          (if (and (not (degk--same-block-p monitorObj blkObj))
                   (setq score
                     (degk--monitor-endpoint-block-score
                       plEnt blkObj targetPt)))
            (if (or (null bestScore) (< score bestScore))
              (setq best blkObj
                    bestScore score)))))))
  best
)

(defun degk--monitor-link-records
  (rawPickset / tol blockObjs i ent ed entType sourceObj targetObj sourceHandle used out)
  ;; Yalniz alan seciminde bulunan fakat normal DK/DKK loop filtresine
  ;; girmeyen polyline'lar monitor yardimci hatti olabilir.
  (setq tol (DEG:CFG-TOL-NUM-OR 'DN_BLOCK_TOL 1.0)
        i   0)
  (if (and rawPickset (= (type rawPickset) 'PICKSET))
    (while (< i (sslength rawPickset))
      (setq ent     (ssname rawPickset i)
            ed      (if ent (entget ent) nil)
            entType (if ed (cdr (assoc 0 ed)) nil))
      (if (and ent
               (or (= entType "LWPOLYLINE") (= entType "POLYLINE"))
               (degk--curve-ok? ent)
               (not (degk--normal-area-loop-entity-p ent)))
        (progn
          (setq blockObjs (degk--monitor-link-blocks ent tol))
          (setq sourceObj
            (degk--monitor-source-on-aux-polyline
              ent blockObjs tol))
          (if sourceObj
            (progn
              (setq targetObj
                      (degk--monitor-target-on-aux-polyline
                        ent sourceObj blockObjs tol)
                    sourceHandle
                      (strcase (degkk--object-handle sourceObj)))
              (if (and targetObj
                       (/= sourceHandle "")
                       (not (member sourceHandle used)))
                (setq out  (cons (list sourceObj targetObj ent) out)
                      used (cons sourceHandle used)))))))
      (setq i (1+ i)))
  )
  (reverse out)
)

(defun degk--base-from-under-top-anchor (anchorPt / yOff len1 fixedLen z)
  ;; degk--under-top-pt hesabinin tersi: kolon grubunun gercek baseW noktasi.
  (if anchorPt
    (progn
      (setq yOff    (DEG:CFG-DK-SIGNED-NUM-OR 'DK_UNDER_Y_OFFSET 0.0)
            len1   (DEG:CFG-DK-NUM-OR 'DK_UNDER_W 70.0)
            fixedLen (* 90.0 (DEG:PLAN-UNIT-SCALE))
            z    (if (and (caddr anchorPt) (numberp (caddr anchorPt)))
                   (caddr anchorPt)
                   0.0))
      (list (car anchorPt)
            (+ (cadr anchorPt) fixedLen (- yOff) (- len1))
            z))
    nil)
)

(defun degk--monitor-linked-source-handles (links / out rec sourceObj handle)
  ;; Yardimci hatti olan monitorleri DK:BASE icindeki sembol dizilimine aktar.
  ;; Bu handle listesi, monitorun saginda ek cihaz icin tek bir normal aralik
  ;; daha ayrilmasini saglar.
  (foreach rec links
    (setq sourceObj (car rec)
          handle
            (if sourceObj
              (strcase (degkk--object-handle sourceObj))
              ""))
    (if (and (/= handle "") (not (member handle out)))
      (setq out (cons handle out))))
  out
)

(defun degk--copy-monitor-linked-block-safe
  (blkObj targetIns siraOne / res msg copyObj copyE fromPt safeSira dY textBase textBaseRoot nm)
  ;; Monitorun yanindaki cihaz kendi geometrisine gore Y kaydirilmaz; INSERT
  ;; noktasi monitor kopyasiyla ayni yatay hizada kalir.
  (setq *DEG_DK_LAST_COPY_OBJ* nil
        safeSira (degk--clean-text siraOne))
  (setq res
    (vl-catch-all-apply
      (function
        (lambda ()
          (degk--make-object-and-atts-editable blkObj)
          (setq copyObj (vla-Copy blkObj))
          (degk--make-scale-positive copyObj)
          (degk--safe-put-layer copyObj (DEG:VAL 'O2))
          (degk--make-object-and-atts-editable copyObj)
          (setq fromPt (deg-get-inspt copyObj))
          (if fromPt
            (vla-Move
              copyObj
              (vlax-3d-point fromPt)
              (vlax-3d-point targetIns)))
          (if (vlax-property-available-p copyObj 'Rotation)
            (vl-catch-all-apply 'vla-put-Rotation (list copyObj 0.0)))
          (setq copyE (vlax-vla-object->ename copyObj))
          (degk--reset-insert-attrs copyE)
          (degk--make-object-and-atts-editable copyObj)
          (if (/= safeSira "")
            (degk--set-att copyObj "SIRA_NO" safeSira))
          (degk--set-att copyObj "ADET" "")
          ;; Standart DK metninin mevcut konum mantigini koru; sadece block
          ;; insertion noktasi monitorun Y hizasindan ayrilmasin.
          (if (not (degkk--active-p))
            (progn
              (setq dY (degk--calc-dy-to-touch-underline copyObj targetIns)
                    textBaseRoot
                      (list
                        (car targetIns)
                        (- (cadr targetIns) dY)
                        (if (caddr targetIns) (caddr targetIns) 0.0))
                    textBase (degk--under-top-pt textBaseRoot))
              (degk--add-text textBase safeSira (DEG:VAL 'O1))))
          (degk--set-att copyObj "SIRA_NO" "")
          (setq *DEG_DK_LAST_COPY_OBJ* copyObj)
          T))
      '()))
  (if (vl-catch-all-error-p res)
    (progn
      (if (and copyObj (= (type copyObj) 'VLA-OBJECT))
        (vl-catch-all-apply 'vla-Delete (list copyObj)))
      (setq *DEG_DK_LAST_COPY_OBJ* nil
            msg (vl-catch-all-error-message res)
            nm (degk--blockname blkObj))
      (if (null nm) (setq nm "<BLOCK>"))
      (princ (strcat "\nDK: " nm " atlandi. Sebep: " msg))
      nil)
    T)
)

(defun degk--monitor-column-link-bbox-pts
  (monitorCopy targetCopy / monitorIns targetIns monitorBB targetBB monitorMin monitorMax targetMin targetMax yLow yHigh yCommon y1 y2 x1 x2 midX z)
  ;; Kolon semasinda cizgi blocklarin icinden degil, birbirine bakan gorunur
  ;; kenarlarindan baslayip bitsin. Dikey alanlar cakisirsa tek yatay hiza kullan.
  (setq monitorIns (if monitorCopy (deg-get-inspt monitorCopy) nil)
        targetIns  (if targetCopy (deg-get-inspt targetCopy) nil)
        ;; Gercek kopyayi gecici acarak yalniz plan sembol geometrisini kullan.
        ;; TEXT/MTEXT/ATTRIB sinirlari baglanti kenarini degistirmesin.
        monitorBB  (if monitorCopy
                     (degk--get-monitor-plan-bbox-by-explode monitorCopy)
                     nil)
        targetBB   (if targetCopy
                     (degk--get-monitor-plan-bbox-by-explode targetCopy)
                     nil))
  (if (and monitorCopy (null monitorBB))
    (setq monitorBB
      (degk--get-monitor-plan-bbox-by-blockdef monitorCopy)))
  (if (and targetCopy (null targetBB))
    (setq targetBB
      (degk--get-monitor-plan-bbox-by-blockdef targetCopy)))
  (if (and monitorIns targetIns monitorBB targetBB)
    (progn
      (setq monitorMin (car monitorBB)
            monitorMax (cadr monitorBB)
            targetMin  (car targetBB)
            targetMax  (cadr targetBB)
            yLow       (max (cadr monitorMin) (cadr targetMin))
            yHigh      (min (cadr monitorMax) (cadr targetMax))
            z          (if (caddr monitorIns) (caddr monitorIns) 0.0))
      (setq x1 (car monitorMax)
            x2 (car targetMin))
      (if (<= yLow yHigh)
        (progn
          ;; Base/INSERT Y'sini kullanma. Iki plan sembolunun ortak gorunen
          ;; yuksekliginin ortasindan tek yatay baglanti kur.
          (setq yCommon (/ (+ yLow yHigh) 2.0)
                y1 yCommon
                y2 yCommon)
          (list
            (list x1 y1 z)
            (list x2 y2 z)))
        (progn
          (setq y1 (max (cadr monitorMin)
                        (min (cadr monitorIns) (cadr monitorMax)))
                y2 (max (cadr targetMin)
                        (min (cadr targetIns) (cadr targetMax)))
                midX (/ (+ x1 x2) 2.0))
          ;; Ortak Y araligi olmayan eski blocklarda da kirilma uretme;
          ;; iki gorunen kenari tek dogru parcasi ile bagla.
          (list
            (list x1 y1 z)
            (list x2 y2 z)))))
    nil)
)

(defun degk--monitor-aux-contact-points
  (plEnt monitorObj tol / sourcePt sourceDist totalLen sp ep targetPt)
  ;; Monitoru bulmak icin kullanilan gercek plan hattinin iki temas ucunu
  ;; dondurur: (monitor-temasi hedef-block-temasi).
  (setq sourcePt
    (degk--flasher-terminal-contact-point plEnt monitorObj tol))
  (if sourcePt
    (progn
      (setq sourceDist (degk--dist-along plEnt sourcePt)
            totalLen
              (vl-catch-all-apply
                'vlax-curve-getDistAtParam
                (list plEnt (vlax-curve-getEndParam plEnt)))
            sp (vl-catch-all-apply 'vlax-curve-getStartPoint (list plEnt))
            ep (vl-catch-all-apply 'vlax-curve-getEndPoint (list plEnt)))
      (if (vl-catch-all-error-p totalLen) (setq totalLen nil))
      (if (vl-catch-all-error-p sp) (setq sp nil))
      (if (vl-catch-all-error-p ep) (setq ep nil))
      (if (and (numberp sourceDist) (numberp totalLen) sp ep)
        (setq targetPt
          (if (<= sourceDist (* 0.5 totalLen)) ep sp)))
      (if targetPt (list sourcePt targetPt) nil))
    nil)
)

(defun degk--monitor-map-contact-to-copy
  (sourceBlk copyBlk sourcePt / sourceE copyE sourceD copyD sourceIns copyIns sourceRot copyRot sourceSX sourceSY copySX copySY dx dy localX localY scaledX scaledY c s z)
  ;; Plandaki gercek block temasini block-local koordinata cevirip kolon
  ;; semasindaki kopyaya tasir. Block icindeki bbox/base yardimcilari kullanilmaz.
  (setq sourceE
    (cond
      ((= (type sourceBlk) 'ENAME) sourceBlk)
      ((= (type sourceBlk) 'VLA-OBJECT)
        (setq sourceE
          (vl-catch-all-apply
            'vlax-vla-object->ename (list sourceBlk)))
        (if (vl-catch-all-error-p sourceE) nil sourceE))
      (t nil))
    copyE
      (cond
        ((= (type copyBlk) 'ENAME) copyBlk)
        ((= (type copyBlk) 'VLA-OBJECT)
          (setq copyE
            (vl-catch-all-apply
              'vlax-vla-object->ename (list copyBlk)))
          (if (vl-catch-all-error-p copyE) nil copyE))
        (t nil))
    sourceD (if sourceE (entget sourceE) nil)
    copyD   (if copyE (entget copyE) nil))
  (if (and sourcePt sourceD copyD
           (= (cdr (assoc 0 sourceD)) "INSERT")
           (= (cdr (assoc 0 copyD)) "INSERT"))
    (progn
      (setq sourceIns (cdr (assoc 10 sourceD))
            copyIns   (cdr (assoc 10 copyD))
            sourceRot (cdr (assoc 50 sourceD))
            copyRot   (cdr (assoc 50 copyD))
            sourceSX  (cdr (assoc 41 sourceD))
            sourceSY  (cdr (assoc 42 sourceD))
            copySX    (cdr (assoc 41 copyD))
            copySY    (cdr (assoc 42 copyD)))
      (if (null sourceRot) (setq sourceRot 0.0))
      (if (null copyRot)   (setq copyRot 0.0))
      (if (or (null sourceSX) (< (abs sourceSX) 1.0e-12))
        (setq sourceSX 1.0))
      (if (or (null sourceSY) (< (abs sourceSY) 1.0e-12))
        (setq sourceSY sourceSX))
      (if (or (null copySX) (< (abs copySX) 1.0e-12))
        (setq copySX 1.0))
      (if (or (null copySY) (< (abs copySY) 1.0e-12))
        (setq copySY copySX))
      (setq dx (- (car sourcePt) (car sourceIns))
            dy (- (cadr sourcePt) (cadr sourceIns))
            c  (cos sourceRot)
            s  (sin sourceRot)
            localX (/ (+ (* c dx) (* s dy)) sourceSX)
            localY (/ (+ (* (- s) dx) (* c dy)) sourceSY)
            scaledX (* localX copySX)
            scaledY (* localY copySY)
            c (cos copyRot)
            s (sin copyRot)
            z (if (caddr copyIns) (caddr copyIns) 0.0))
      (list
        (+ (car copyIns) (- (* c scaledX) (* s scaledY)))
        (+ (cadr copyIns) (+ (* s scaledX) (* c scaledY)))
        z))
    nil)
)

(defun degk--monitor-contact-route-pts (p1 p2 / tol y midX z)
  (if (and p1 p2)
    (progn
      (setq tol (max 1.0e-8 (* 0.01 (DEG:PLAN-UNIT-SCALE)))
            z   (if (caddr p1) (caddr p1) 0.0))
      (if (<= (abs (- (cadr p1) (cadr p2))) tol)
        (progn
          (setq y (/ (+ (cadr p1) (cadr p2)) 2.0))
          (list (list (car p1) y z) (list (car p2) y z)))
        (progn
          (setq midX (/ (+ (car p1) (car p2)) 2.0))
          (list
            p1
            (list midX (cadr p1) z)
            (list midX (cadr p2) z)
            p2))))
    nil)
)

(defun degk--monitor-intersection-points (res / flat out)
  (setq flat (vl-catch-all-apply 'DEG:PT->LIST (list res)))
  (if (vl-catch-all-error-p flat) (setq flat nil))
  (while (and (listp flat) (>= (length flat) 3))
    (setq out
      (cons
        (list (nth 0 flat) (nth 1 flat) (nth 2 flat))
        out)
      flat (cdddr flat)))
  (reverse out)
)

(defun degk--monitor-ray-object-hits (rayObj obj / res)
  (setq res
    (vl-catch-all-apply
      'vlax-invoke
      (list rayObj 'IntersectWith obj 0)))
  (if (vl-catch-all-error-p res)
    nil
    (degk--monitor-intersection-points res))
)

(defun degk--monitor-ray-block-hits
  (rayObj blkObj / exploded obj objName hits directHits)
  ;; Once gercek kopyayi acip yalniz gorunur plan cizgileriyle kesistir.
  ;; Boylece block base POINT'i veya gorunmez dinamik geometri aday olamaz.
  (setq exploded (degw-explode->list blkObj)
        hits nil)
  (foreach obj exploded
    (setq objName
      (vl-catch-all-apply 'vla-get-ObjectName (list obj)))
    (if (and (not (vl-catch-all-error-p objName))
             (degw-entity-eligible-for-bbox-p obj)
             (or (degk--monitor-plan-primitive-p obj)
                 (= objName "AcDbBlockReference")))
      (setq hits
        (append hits (degk--monitor-ray-object-hits rayObj obj)))))
  (degw-delete-objects exploded)
  ;; Korumali block patlatilamiyorsa son yedek gercek IntersectWith'tir;
  ;; bbox veya INSERT/base noktasi bu akista hic kullanilmaz.
  (if (null hits)
    (setq hits (degk--monitor-ray-object-hits rayObj blkObj)))
  hits
)

(defun degk--monitor-leftmost-point (pts / best p)
  (foreach p pts
    (if (or (null best) (< (car p) (car best)))
      (setq best p)))
  best
)

(defun degk--monitor-rightmost-point (pts / best p)
  (foreach p pts
    (if (or (null best) (> (car p) (car best)))
      (setq best p)))
  best
)

(defun degk--monitor-column-link-ray-pts
  (monitorCopy targetCopy / doc ms monitorIns targetIns y z span pad xMin xMax rayObj monitorHits targetHits p1 p2)
  (setq monitorIns (if monitorCopy (deg-get-inspt monitorCopy) nil)
        targetIns  (if targetCopy (deg-get-inspt targetCopy) nil))
  (if (and monitorIns targetIns)
    (progn
      ;; Kopyalar ayni yatay hizada yerlestirilir. Isin bu hizanin fiziksel
      ;; 150 mm ustunden gecerek iki blockun gorunen kenarlarini keser.
      (setq y    (+ (/ (+ (cadr monitorIns) (cadr targetIns)) 2.0)
                     (* 15.0 (DEG:PLAN-UNIT-SCALE)))
            z    (if (caddr monitorIns) (caddr monitorIns) 0.0)
            span (abs (- (car targetIns) (car monitorIns)))
            pad  (max span (* 100.0 (DEG:PLAN-UNIT-SCALE)) 1.0)
            xMin (- (min (car monitorIns) (car targetIns)) pad)
            xMax (+ (max (car monitorIns) (car targetIns)) pad)
            doc  (vla-get-ActiveDocument (vlax-get-acad-object))
            ms   (vla-get-ModelSpace doc)
            rayObj
              (vl-catch-all-apply
                'vla-AddLine
                (list ms
                      (vlax-3d-point (list xMin y z))
                      (vlax-3d-point (list xMax y z)))))
      (if (vl-catch-all-error-p rayObj)
        nil
        (progn
          (setq monitorHits
                  (degk--monitor-ray-block-hits
                    rayObj monitorCopy)
                targetHits
                  (degk--monitor-ray-block-hits
                    rayObj targetCopy))
          (vl-catch-all-apply 'vla-Delete (list rayObj))
          (if (< (car monitorIns) (car targetIns))
            (setq p1 (degk--monitor-rightmost-point monitorHits)
                  p2 (degk--monitor-leftmost-point targetHits))
            (setq p1 (degk--monitor-leftmost-point monitorHits)
                  p2 (degk--monitor-rightmost-point targetHits)))
          (if (and p1 p2)
            ;; Son polyline kesinlikle tek yatay parca ve iki vertexlidir.
            (list (list (car p1) y z)
                  (list (car p2) y z))
            nil))))
    nil)
)

(defun degk--monitor-column-link-pts
  (monitorObj monitorCopy targetObj targetCopy sourceEnt / tol contacts p1 p2)
  ;; Kolon semasinda yon sabittir: monitorun metinsiz plan sinirinin sag
  ;; kenarindan hedef blockun metinsiz plan sinirinin sol kenarina. Kaynak
  ;; plan temas yonu ve iki blockun base noktasi bu cizgiyi etkileyemez.
  (setq p1
    (degk--monitor-column-link-ray-pts monitorCopy targetCopy))
  (if p1
    p1
    (progn
      (princ
        "\nDK: Monitor baglantisi icin gercek block kenari bulunamadi; base noktasina baglanmadi.")
      nil))
)

(defun degk--draw-monitor-column-link
  (monitorObj monitorCopy targetObj targetCopy sourceEnt / ed layer color pts)
  ;; Plan yardimci hattinin layer ve ACI/true-color bilgisini kolon semasindaki
  ;; yeni iki-noktali polyline'a aynen tasir.
  (setq ed    (if sourceEnt (entget sourceEnt) nil)
        layer (if ed (cdr (assoc 8 ed)) nil)
        color (if layer
                (degk--color-dxfs-from-entity sourceEnt layer)
                nil)
        pts
          (degk--monitor-column-link-pts
            monitorObj monitorCopy targetObj targetCopy sourceEnt))
  (if (and layer (/= layer "") pts (>= (length pts) 2))
    (degk--entmake-lwpoly pts layer color)
    nil)
)

(defun degk--place-monitor-linked-blocks
  (links / offset rec monitorObj targetObj sourceEnt copyRec copyObj targetCopy monitorIns targetIns key placed sira count)
  ;; 1000 mm = 100 cm fiziksel mesafe; PLAN mm/cm/m secimine gore cevrilir.
  (setq offset (* 100.0 (DEG:PLAN-UNIT-SCALE))
        count 0)
  (foreach rec links
    (setq monitorObj (car rec)
          targetObj  (cadr rec)
          sourceEnt  (nth 2 rec)
          copyRec    (degk--area-module-copy-get monitorObj nil)
          copyObj    (if copyRec (car copyRec) nil)
          monitorIns (if copyObj (deg-get-inspt copyObj) nil)
          key
            (strcat
              (if copyObj (strcase (degkk--object-handle copyObj)) "")
              "|"
              (if targetObj (strcase (degkk--object-handle targetObj)) "")))
    (if (and copyObj
             (= (type copyObj) 'VLA-OBJECT)
             monitorIns
             (/= key "|")
             (not (member key placed)))
      (progn
        (setq targetIns
                (list (+ (car monitorIns) offset)
                      (cadr monitorIns)
                      (if (caddr monitorIns) (caddr monitorIns) 0.0))
              sira (degk--clean-text (degk--get-att targetObj "SIRA_NO")))
        (if (degk--copy-monitor-linked-block-safe
              targetObj targetIns sira)
          (progn
            (setq targetCopy *DEG_DK_LAST_COPY_OBJ*)
            (degk--draw-monitor-column-link
              monitorObj copyObj targetObj targetCopy sourceEnt)
            (setq count  (1+ count)
                  placed (cons key placed))
            (degk--attsync-add targetObj))))))
  (if (> count 0) (degk--attsync-run))
  count
)

(defun degk--normal-area-polylines (dkAreaPickset / dkAreaResult dkAreaIndex dkAreaEnt dkAreaData dkAreaLayer dkAreaType dkAreaMatch)
  (setq dkAreaResult (ssadd))
  (if (and dkAreaPickset (= (type dkAreaPickset) 'PICKSET))
    (progn
      (setq dkAreaIndex 0)
      (while (< dkAreaIndex (sslength dkAreaPickset))
        (setq dkAreaEnt (ssname dkAreaPickset dkAreaIndex)
              dkAreaData (if dkAreaEnt (entget dkAreaEnt) nil)
              dkAreaLayer (if dkAreaData (cdr (assoc 8 dkAreaData)) nil)
              dkAreaType (if dkAreaData (cdr (assoc 0 dkAreaData)) nil)
              dkAreaMatch nil)
        (if (and dkAreaLayer
                 (or (= dkAreaType "LWPOLYLINE") (= dkAreaType "POLYLINE")))
          (setq dkAreaMatch (degk--normal-area-layer-p dkAreaLayer))
        )
        (if (and dkAreaMatch
                 (degk--normal-area-fire-length-ok-p
                   dkAreaEnt dkAreaLayer))
          (ssadd dkAreaEnt dkAreaResult)
        )
        (setq dkAreaIndex (1+ dkAreaIndex))
      )
    )
  )
  dkAreaResult
)

(defun degk--column-frame-new-entities (afterEnt / doc space owner ent data out)
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object))
        space
          (if (= (getvar "CVPORT") 1)
            (vla-get-PaperSpace doc)
            (vla-get-ModelSpace doc))
        owner (vlax-vla-object->ename space)
        ent (if afterEnt (entnext afterEnt) (entnext))
        out nil)
  (while ent
    (setq data (entget ent))
    (if (and data (eq owner (cdr (assoc 330 data))))
      (setq out (cons ent out)))
    (setq ent (entnext ent)))
  (reverse out)
)

(defun degk--column-frame-visible-curve-y-range (ent / endParam i p q dx tol lo hi)
  (if (and ent (degk--curve-ok? ent))
    (progn
      (setq endParam
        (vl-catch-all-apply 'vlax-curve-getEndParam (list ent)))
      (if (not (vl-catch-all-error-p endParam))
        (progn
          (setq i 0)
          (while (< i endParam)
            (setq p (vl-catch-all-apply 'vlax-curve-getPointAtParam (list ent i))
                  q (vl-catch-all-apply 'vlax-curve-getPointAtParam (list ent (1+ i))))
            (if (and (not (vl-catch-all-error-p p))
                     (not (vl-catch-all-error-p q))
                     p q)
              (progn
                (setq dx (- (car q) (car p))
                      tol (max 1e-6 (* 1e-6 (distance p q))))
                ;; Dikey kuyruklar cerceveyi buyutmesin; gorunen yatay/egik
                ;; parcalarin iki ucunu de gercek icerik sinirina dahil et.
                (if (> (abs dx) tol)
                  (progn
                    (if (or (null lo) (< (cadr p) lo)) (setq lo (cadr p)))
                    (if (or (null lo) (< (cadr q) lo)) (setq lo (cadr q)))
                    (if (or (null hi) (> (cadr p) hi)) (setq hi (cadr p)))
                    (if (or (null hi) (> (cadr q) hi)) (setq hi (cadr q)))))))
            (setq i (1+ i)))))))
  (if (and (numberp lo) (numberp hi)) (list lo hi) nil)
)

(defun degk--block-ocs-bbox (bb ent / lo hi x y z pts)
  ;; INSERT'in DXF 10 noktasi OCS'dedir; egik normalde WCS'ye donustur.
  (if bb
    (progn
      (setq lo (car bb) hi (cadr bb))
      (foreach x (list (car lo) (car hi))
        (foreach y (list (cadr lo) (cadr hi))
          (foreach z (list (caddr lo) (caddr hi))
            (setq pts (cons (trans (list x y z) ent 0) pts)))))
      (degk--bbox-from-pts pts))))

(defun degk--column-frame-block-local-bbox
  (blkName doc depth seen / key btr ent data typ obj one childBB childName ip rot sx sy sz bb)
  (setq key (if blkName (strcase blkName) ""))
  (if (and (/= key "")
           (< depth 8)
           (not (member key seen))
           (setq btr (tblobjname "BLOCK" blkName)))
    (progn
      (setq bb nil
            ent (entnext btr)
            seen (cons key seen))
      (while (and ent (/= (cdr (assoc 0 (entget ent))) "ENDBLK"))
        (setq data (entget ent)
              typ (cdr (assoc 0 data)))
        (cond
          ((= typ "INSERT")
            (setq childName (cdr (assoc 2 data))
                  childBB
                    (degk--column-frame-block-local-bbox
                      childName doc (1+ depth) seen))
            (if childBB
              (progn
                (setq ip (cdr (assoc 10 data))
                      rot (cdr (assoc 50 data))
                      sx (cdr (assoc 41 data))
                      sy (cdr (assoc 42 data))
                      sz (cdr (assoc 43 data)))
                (if (null ip) (setq ip '(0.0 0.0 0.0)))
                (if (null rot) (setq rot 0.0))
                (if (null sx) (setq sx 1.0))
                (if (null sy) (setq sy sx))
                (if (null sz) (setq sz 1.0))
                (setq one (degk--block-ocs-bbox
                            (degk--bbox-transform childBB ip sx sy sz rot) ent))
                (if one (setq bb (degk--bbox-union bb one))))))
          (T
            (setq obj (vl-catch-all-apply 'vlax-ename->vla-object (list ent)))
            (if (and (not (vl-catch-all-error-p obj))
                     (degk--layer-visible-p doc (cdr (assoc 8 data)))
                     (degk--monitor-plan-primitive-p obj))
              (progn
                (setq one (degk--ent-bbox obj))
                (if one (setq bb (degk--bbox-union bb one)))))))
        (setq ent (entnext ent)))
      bb)
    nil)
)

(defun degk--column-frame-block-visible-bbox (ent / data obj blkName ip rot sx sy sz localBB)
  (setq data (if ent (entget ent) nil))
  (if (and data (= (cdr (assoc 0 data)) "INSERT"))
    (progn
      (setq obj (vlax-get-acad-object)
            blkName (cdr (assoc 2 data))
            ip (cdr (assoc 10 data))
            rot (cdr (assoc 50 data))
            sx (cdr (assoc 41 data))
            sy (cdr (assoc 42 data))
            sz (cdr (assoc 43 data)))
      (if (null ip) (setq ip '(0.0 0.0 0.0)))
      (if (null rot) (setq rot 0.0))
      (if (null sx) (setq sx 1.0))
      (if (null sy) (setq sy sx))
      (if (null sz) (setq sz 1.0))
      (setq localBB
        (degk--column-frame-block-local-bbox
          blkName
          (vla-get-ActiveDocument obj)
          0
          nil))
      (if localBB
        (degk--block-ocs-bbox
          (degk--bbox-transform localBB ip sx sy sz rot) ent)
        nil))
    nil)
)

(defun degk--column-frame-bbox (entities / bb ent obj objName one frameOne yr contentMinY contentMaxY mn mx)
  (setq bb nil
        contentMinY nil
        contentMaxY nil)
  (foreach ent entities
    (if (and ent (entget ent))
      (progn
        (setq obj (vlax-ename->vla-object ent)
              objName (vla-get-ObjectName obj)
              one (degk--ent-bbox obj))
        (setq frameOne
          (if (= objName "AcDbBlockReference")
            (degk--column-frame-block-visible-bbox ent)
            one))
        (if frameOne (setq bb (degk--bbox-union bb frameOne)))
        (cond
          ((= objName "AcDbBlockReference")
            (if frameOne
              (progn
                (if (or (null contentMinY) (< (cadr (car frameOne)) contentMinY))
                  (setq contentMinY (cadr (car frameOne))))
                (if (or (null contentMaxY) (> (cadr (cadr frameOne)) contentMaxY))
                  (setq contentMaxY (cadr (cadr frameOne)))))))
          ((member objName '("AcDbText" "AcDbMText"))
            (if one
              (progn
                (if (or (null contentMinY) (< (cadr (car one)) contentMinY))
                  (setq contentMinY (cadr (car one))))
                (if (or (null contentMaxY) (> (cadr (cadr one)) contentMaxY))
                  (setq contentMaxY (cadr (cadr one)))))))
          ((setq yr (degk--column-frame-visible-curve-y-range ent))
            (if (or (null contentMinY) (< (car yr) contentMinY))
              (setq contentMinY (car yr)))
            (if (or (null contentMaxY) (> (cadr yr) contentMaxY))
              (setq contentMaxY (cadr yr))))))))
  (if bb
    (progn
      (setq mn (car bb)
            mx (cadr bb))
      (if (null contentMinY) (setq contentMinY (cadr mn)))
      (if (null contentMaxY) (setq contentMaxY (cadr mx)))
      (list
        (list (car mn) contentMinY (if (caddr mn) (caddr mn) 0.0))
        (list (car mx) contentMaxY (if (caddr mx) (caddr mx) 0.0))))
    nil)
)

(defun degk--column-frame-polyline (pts layer closed / data)
  (setq data
    (append
      (list
        '(0 . "LWPOLYLINE")
        '(100 . "AcDbEntity")
        (cons 8 layer)
        '(62 . 256)
        '(100 . "AcDbPolyline")
        (cons 90 (length pts))
        (cons 70 (if closed 1 0)))
      (mapcar
        (function (lambda (p) (cons 10 (list (car p) (cadr p)))))
        pts)))
  (entmakex data)
)

(defun degk--riser-limits-above-horizontal-p
  (riserLimits upperY lowerY / leftBottom rightBottom leftTop rightTop leftMinY leftMaxY rightMinY rightMaxY riserMidY horizontalMidY)
  (if (and (listp riserLimits)
           (>= (length riserLimits) 4)
           (listp (nth 0 riserLimits))
           (listp (nth 1 riserLimits))
           (listp (nth 2 riserLimits))
           (listp (nth 3 riserLimits)))
    (progn
      (setq leftBottom (nth 0 riserLimits)
            rightBottom (nth 1 riserLimits)
            leftTop (nth 2 riserLimits)
            rightTop (nth 3 riserLimits)
            leftMinY (min (cadr leftBottom) (cadr leftTop))
            leftMaxY (max (cadr leftBottom) (cadr leftTop))
            rightMinY (min (cadr rightBottom) (cadr rightTop))
            rightMaxY (max (cadr rightBottom) (cadr rightTop))
            horizontalMidY (/ (+ upperY lowerY) 2.0)
            riserMidY
              (/ (+ leftMinY leftMaxY rightMinY rightMaxY) 4.0))
      (cond
        ((and (> leftMinY upperY) (> rightMinY upperY)) T)
        ((and (< leftMaxY lowerY) (< rightMaxY lowerY)) nil)
        (T (> riserMidY horizontalMidY))))
    nil)
)

(defun degk--panel-riser-fillet-y
  (turnY minY maxY preferAbove radius / lo hi r candidate)
  ;; Yatay kol dik riserin disindaysa en yakin uca, icindeyse tercih edilen
  ;; yone dogru bir fillet yaricapi kadar ilerideki noktaya baglan.
  (setq lo (min minY maxY)
        hi (max minY maxY)
        r  (abs radius))
  (cond
    ((< turnY lo) lo)
    ((> turnY hi) hi)
    (preferAbove
      (setq candidate (min hi (+ turnY r)))
      (if (> candidate (+ turnY 1e-9))
        candidate
        (max lo (- turnY r))))
    (T
      (setq candidate (max lo (- turnY r)))
      (if (< candidate (- turnY 1e-9))
        candidate
        (min hi (+ turnY r)))))
)

(defun degk--make-panel-filleted-run
  (startX startY turnY targetX targetY z radius layer targetFilletP
   / xDir yDir targetYDir verticalLen targetVerticalLen horizontalLen
     firstRadius secondRadius tangentY firstArcX secondTanX secondArcY
     pts bulges beforeEnt result ent)
  ;; Panel donusunu, istenirse GF riser tarafindaki donusu da ayni
  ;; LWPOLYLINE icinde gercek 90 derece yay olarak kurar.
  (setq xDir (if (>= targetX startX) 1.0 -1.0)
        yDir (if (>= turnY startY) 1.0 -1.0)
        targetYDir (if (>= targetY turnY) 1.0 -1.0)
        verticalLen (abs (- turnY startY))
        targetVerticalLen (abs (- targetY turnY))
        horizontalLen (abs (- targetX startX))
        firstRadius
          (min (abs radius) verticalLen (/ horizontalLen 2.0))
        secondRadius
          (if targetFilletP
            (min (abs radius)
                 targetVerticalLen
                 (max 0.0 (- horizontalLen firstRadius)))
            0.0))
  (cond
    ((and (> firstRadius 1e-9) (> secondRadius 1e-9))
      (setq tangentY  (- turnY (* yDir firstRadius))
            firstArcX (+ startX (* xDir firstRadius))
            secondTanX (- targetX (* xDir secondRadius))
            secondArcY (+ turnY (* targetYDir secondRadius))
            pts
              (list
                (list startX startY z)
                (list startX tangentY z)
                (list firstArcX turnY z)
                (list secondTanX turnY z)
                (list targetX secondArcY z))
            bulges
              (list
                0.0
                (* -1.0 xDir yDir 0.414213562373095)
                0.0
                (* xDir targetYDir 0.414213562373095)
                0.0))
      (if (> (abs (- targetY secondArcY)) 1e-9)
        (setq pts (append pts (list (list targetX targetY z)))
              bulges (append bulges (list 0.0)))))
    ((> firstRadius 1e-9)
      (setq tangentY  (- turnY (* yDir firstRadius))
            firstArcX (+ startX (* xDir firstRadius))
            pts
              (list
                (list startX startY z)
                (list startX tangentY z)
                (list firstArcX turnY z)
                (list targetX turnY z))
            bulges
              (list
                0.0
                (* -1.0 xDir yDir 0.414213562373095)
                0.0 0.0))
      (if (> targetVerticalLen 1e-9)
        (setq pts (append pts (list (list targetX targetY z)))
              bulges (append bulges (list 0.0)))))
    ((> secondRadius 1e-9)
      (setq secondTanX (- targetX (* xDir secondRadius))
            secondArcY (+ turnY (* targetYDir secondRadius))
            pts
              (list
                (list startX startY z)
                (list startX turnY z)
                (list secondTanX turnY z)
                (list targetX secondArcY z))
            bulges
              (list
                0.0 0.0
                (* xDir targetYDir 0.414213562373095)
                0.0))
      (if (> (abs (- targetY secondArcY)) 1e-9)
        (setq pts (append pts (list (list targetX targetY z)))
              bulges (append bulges (list 0.0)))))
    (T
      (setq pts
              (list
                (list startX startY z)
                (list startX turnY z)
                (list targetX turnY z))
            bulges (list 0.0 0.0 0.0))
      (if (> targetVerticalLen 1e-9)
        (setq pts (append pts (list (list targetX targetY z)))
              bulges (append bulges (list 0.0))))))
  (setq beforeEnt (entlast)
        result (degk--entmake-lwpoly-bulges pts bulges layer nil)
        ent (entlast))
  (if (and result ent (not (eq beforeEnt ent))) ent nil)
)

(defun degk--vertical-riser-entity-info (ent / ed pts p x minY maxY z verticalP)
  (setq ed (if (and ent (entget ent)) (entget ent) nil)
        pts
          (if (and ed (= (cdr (assoc 0 ed)) "LWPOLYLINE"))
            (mapcar 'cdr
              (vl-remove-if-not
                (function (lambda (item) (= (car item) 10)))
                ed))
            nil))
  (if pts
    (progn
      (setq x (car (car pts))
            z 0.0
            verticalP T)
      (foreach p pts
        (if (> (abs (- (car p) x)) 1e-6) (setq verticalP nil))
        (if (or (null minY) (< (cadr p) minY)) (setq minY (cadr p)))
        (if (or (null maxY) (> (cadr p) maxY)) (setq maxY (cadr p))))
      (if verticalP (list x minY maxY z ent) nil))
    nil)
)

(defun degk--shaft-riser-infos (entities / ent info infos)
  (foreach ent entities
    (if (setq info (degk--vertical-riser-entity-info ent))
      (setq infos (cons info infos))))
  (vl-sort infos
    (function (lambda (a b) (< (car a) (car b)))))
)

(defun degk--panel-shaft-targets (shaftInfos lowerY / firstInfo secondInfo)
  ;; Her iki saft hatti da panel kollarinin ustunde basliyorsa alt kat yoktur.
  ;; Bu tek yonlu durumda paralel hatlari safta ters sirayla eslestir.
  (setq firstInfo  (car shaftInfos)
        secondInfo (cadr shaftInfos))
  (if (and firstInfo secondInfo
           (numberp lowerY)
           (numberp (cadr firstInfo))
           (numberp (cadr secondInfo))
           (>= (cadr firstInfo) (- lowerY 1e-9))
           (>= (cadr secondInfo) (- lowerY 1e-9)))
    (list secondInfo firstInfo)
    (list firstInfo secondInfo))
)

(defun degk--make-panel-shaft-branch
  (panelX panelTopY turnY shaftInfo z radius layer
   / shaftX shaftMinY shaftMaxY shaftEnt xDir endY horizontalLen verticalLen firstRadius secondRadius firstTanY firstArcX splitX upperTanY lowerTanY pts bulges beforeEnt result firstEnt secondEnt made originalData twoWayP)
  ;; Saft baglanti seviyesinin hem altinda hem ustunde devam ediyorsa yatay
  ;; kolu iki gercek fillet ile iki yone ayir. Alt kol yoksa safta kare don.
  (if (and (listp shaftInfo)
           (>= (length shaftInfo) 3)
           (numberp (car shaftInfo))
           (numberp (cadr shaftInfo))
           (numberp (nth 2 shaftInfo)))
    (progn
      (setq shaftX (car shaftInfo)
            shaftMinY (cadr shaftInfo)
            shaftMaxY (nth 2 shaftInfo)
            shaftEnt (if (> (length shaftInfo) 4) (nth 4 shaftInfo) nil)
            xDir (if (>= shaftX panelX) 1.0 -1.0)
            verticalLen (abs (- turnY panelTopY))
            horizontalLen (abs (- shaftX panelX))
            firstRadius
              (min (abs radius)
                   verticalLen
                   (/ horizontalLen 2.0))
            secondRadius
              (min
                (abs radius)
                (max 0.0 (- turnY shaftMinY))
                (max 0.0 (- shaftMaxY turnY))
                (max 0.0 (- horizontalLen firstRadius)))
            twoWayP
              (and (> firstRadius 1e-9)
                   (> secondRadius 1e-9)
                   (< shaftMinY (- turnY 1e-9))
                   (> shaftMaxY (+ turnY 1e-9))))
      (cond
        ((< turnY shaftMinY)
          (setq endY shaftMinY))
        ((> turnY shaftMaxY)
          (setq endY shaftMaxY))
        (T
          (setq endY turnY)))
      (if (> firstRadius 1e-9)
        (progn
          (setq firstTanY (- turnY firstRadius)
                firstArcX (+ panelX (* xDir firstRadius)))
          (if twoWayP
            (setq pts
                    (list
                      (list panelX firstTanY z)
                      (list firstArcX turnY z)
                      (list (- shaftX (* xDir secondRadius)) turnY z)
                      (list shaftX (+ turnY secondRadius) z)
                      (list shaftX shaftMaxY z))
                  bulges
                    (list
                      (* -1.0 xDir 0.414213562373095)
                      0.0
                      (* xDir 0.414213562373095)
                      0.0 0.0)
                  beforeEnt (entlast)
                  result (degk--entmake-lwpoly-bulges pts bulges layer nil)
                  firstEnt (entlast))
            (setq pts
                    (list
                      (list panelX firstTanY z)
                      (list firstArcX turnY z)
                      (list shaftX turnY z))
                  bulges
                    (list
                      (* -1.0 xDir 0.414213562373095)
                      0.0 0.0)
                  beforeEnt (entlast)
                  result (degk--entmake-lwpoly-bulges pts bulges layer nil)
                  firstEnt (entlast)))
          (if (and result firstEnt (not (eq beforeEnt firstEnt)))
            (setq made (list firstEnt))
            (setq made nil))
          (if (and made twoWayP)
            (progn
              (setq splitX (- shaftX (* xDir secondRadius))
                    upperTanY (+ turnY secondRadius)
                    lowerTanY (- turnY secondRadius)
                    beforeEnt (entlast)
                    result
                      (degk--entmake-lwpoly-bulges
                        (list
                          (list splitX turnY z)
                          (list shaftX lowerTanY z)
                          (list shaftX shaftMinY z))
                        (list
                          (* -1.0 xDir 0.414213562373095)
                          0.0 0.0)
                        layer nil)
                    secondEnt (entlast))
              (if (and result secondEnt (not (eq beforeEnt secondEnt)))
                (setq made (append made (list secondEnt)))
                (progn
                  (foreach firstEnt made
                    (vl-catch-all-apply 'entdel (list firstEnt)))
                  (setq made nil)))
              (if made
                (if (and shaftEnt (entget shaftEnt))
                  (progn
                    (setq originalData (entget shaftEnt))
                    (entdel shaftEnt)
                    (if (entget shaftEnt)
                      (progn
                        (foreach firstEnt made
                          (vl-catch-all-apply 'entdel (list firstEnt)))
                        (setq made nil))))))))
          ;; Tek yone devam eden safta baglanti ucunu filletsiz 90 derece tamamla.
          (if (and made (not twoWayP) (> (abs (- endY turnY)) 1e-9))
            (progn
              (setq pts
                (append pts (list (list shaftX endY z))))
              (vl-catch-all-apply 'entdel (list firstEnt))
              (setq beforeEnt (entlast)
                    result (degk--entmake-lwpoly-bulges
                             pts
                             (append bulges (list 0.0))
                             layer nil)
                    firstEnt (entlast)
                    made
                      (if (and result firstEnt (not (eq beforeEnt firstEnt)))
                        (list firstEnt)
                        nil))))
          (if made
            (list made shaftEnt originalData)
            nil))
        nil))
    nil)
)

(defun degk--first-loop-upper-mouth-y
  (loopRecords / rec y firstY firstRec pts firstPt lastPt)
  ;; GF-L01 kolon yerlesiminde geometrik olarak en alttaki ilk looptur.
  ;; YAP +2000 hizasi icin bu loopun ust agiz Y degerini dondur.
  (foreach rec loopRecords
    (setq y (degk--loop-record-mouth-y rec))
    (if (and (numberp y) (or (null firstY) (< y firstY)))
      (setq firstY y
            firstRec rec)))
  (setq pts (if (listp firstRec) (cadr firstRec) nil)
        firstPt (if (and (listp pts) (>= (length pts) 2)) (car pts) nil)
        lastPt (if (and (listp pts) (>= (length pts) 2)) (last pts) nil))
  (if (and (listp firstPt) (listp lastPt)
           (numberp (cadr firstPt)) (numberp (cadr lastPt)))
    (max (cadr firstPt) (cadr lastPt))
    nil)
)

(defun degk--room-first-loop-shift-y (panelTopY loopRecords / loopUpperY)
  (setq loopUpperY (degk--first-loop-upper-mouth-y loopRecords))
  (if (and (numberp panelTopY) (numberp loopUpperY))
    (- (+ panelTopY (* 200.0 (DEG:PLAN-UNIT-SCALE))) loopUpperY)
    nil)
)

(defun degk--entity-reference-y (ent / ed item pt total count)
  ;; Kolon semasinda uretilen INSERT/TEXT/LWPOLYLINE nesnesinin satir Y'si.
  (setq ed (if (and ent (entget ent)) (entget ent) nil)
        total 0.0
        count 0)
  (foreach item ed
    (if (and (= (car item) 10)
             (setq pt (cdr item))
             (listp pt)
             (numberp (cadr pt)))
      (setq total (+ total (cadr pt))
            count (1+ count))))
  (if (> count 0) (/ total count) nil)
)

(defun degk--gf-row-entities
  (entities loopRecords floorSpacing / rec y minY maxY pad ent entY out)
  ;; Tum GF loop satirlarini ve ayni satirlardaki block/yazilari al; komsu
  ;; katlara tasma olmamasi icin yarim kat araligindan kucuk pay kullan.
  (foreach rec loopRecords
    (setq y (degk--loop-record-mouth-y rec))
    (if (numberp y)
      (progn
        (if (or (null minY) (< y minY)) (setq minY y))
        (if (or (null maxY) (> y maxY)) (setq maxY y)))))
  (setq pad
    (if (and (numberp floorSpacing) (> floorSpacing 1e-9))
      (* 0.45 floorSpacing)
      (* 350.0 (DEG:PLAN-UNIT-SCALE))))
  (if (and minY maxY)
    (foreach ent entities
      (setq entY (degk--entity-reference-y ent))
      (if (and (numberp entY)
               (>= entY (- minY pad))
               (<= entY (+ maxY pad))
               (not (member ent out)))
        (setq out (cons ent out)))))
  (reverse out)
)

(defun degk--move-entities-y (entities dy / ent ed layer obj res moved ok)
  (if (and entities (numberp dy) (> (abs dy) 1e-9))
    (progn
      (setq ok T)
      (foreach ent entities
        (if ok
          (progn
            (setq ed (if (and ent (entget ent)) (entget ent) nil)
                  layer (if ed (cdr (assoc 8 ed)) nil))
            (if layer (degk--ensure-layer-editable layer))
            (setq obj
              (if ed
                (vl-catch-all-apply 'vlax-ename->vla-object (list ent))
                nil))
            (if (or (null obj) (vl-catch-all-error-p obj))
              (setq ok nil)
              (progn
                (degk--make-object-and-atts-editable obj)
                (setq res
                  (vl-catch-all-apply
                    'vla-Move
                    (list obj
                          (vlax-3d-point '(0.0 0.0 0.0))
                          (vlax-3d-point (list 0.0 dy 0.0)))))
                (if (vl-catch-all-error-p res)
                  (setq ok nil)
                  (setq moved (cons obj moved))))))))
      (if ok
        T
        (progn
          (foreach obj moved
            (vl-catch-all-apply
              'vla-Move
              (list obj
                    (vlax-3d-point '(0.0 0.0 0.0))
                    (vlax-3d-point (list 0.0 (- dy) 0.0)))))
          nil)))
    nil)
)

(defun degk--shift-point-list-y (pts dy / pt out)
  (foreach pt pts
    (setq out
      (cons
        (if (and (listp pt) (numberp (cadr pt)))
          (list (car pt) (+ (cadr pt) dy)
                (if (and (caddr pt) (numberp (caddr pt))) (caddr pt) 0.0))
          pt)
        out)))
  (reverse out)
)

(defun degk--shift-loop-records-y-data (records dy / rec out)
  (foreach rec records
    (setq out
      (cons
        (list
          (nth 0 rec)
          (degk--shift-point-list-y (nth 1 rec) dy)
          (nth 2 rec)
          (nth 3 rec)
          (nth 4 rec)
          (if (listp (nth 5 rec))
            (degk--shift-point-list-y (nth 5 rec) dy)
            (nth 5 rec))
          (nth 6 rec))
        out)))
  (reverse out)
)

(defun degk--align-gf-combined-to-panel
  (panelObj records limits risers entities floorSpacing excluded
   / panelEnt bb rec raw lowY firstRaw y targetY dy moveEntities ent)
  ;; Dikte ilk loopun ust yatay rayi YAP +2000 mm'de olmalidir.
  ;; Tum GF satirlari ve GF kombinesi ayni delta ile tasinir.
  (setq panelEnt (vlax-vla-object->ename panelObj)
        bb (degk--column-frame-block-visible-bbox panelEnt))
  (if (null bb) (setq bb (degk--ent-bbox panelObj)))
  (foreach rec records
    (setq raw (nth 5 rec)
          y (degk--loop-record-mouth-y rec))
    (if (and raw (numberp y) (or (null lowY) (< y lowY)))
      (setq lowY y firstRaw raw)))
  (if (and bb firstRaw)
    (progn
      (setq targetY (+ (cadr (cadr bb)) (* 200.0 (DEG:PLAN-UNIT-SCALE)))
            dy (- targetY (max (cadr (car firstRaw)) (cadr (last firstRaw)))))
      (if (> (abs dy) 1e-9)
        (progn
          (setq moveEntities (degk--gf-row-entities entities records floorSpacing))
          (foreach ent excluded (setq moveEntities (vl-remove ent moveEntities)))
          (foreach ent (append (mapcar 'car records) risers)
            (if (and ent (entget ent) (not (member ent moveEntities)))
              (setq moveEntities (cons ent moveEntities))))
          (if (degk--move-entities-y moveEntities dy)
            (setq records (degk--shift-loop-records-y-data records dy)
                  limits (degk--shift-point-list-y limits dy)))))))
  (list records limits)
)

(defun degk--align-gf-loops-to-panel
  (panelObj loopRecords entities floorSpacing
   / panelEnt bb panelTopY dy moveEntities)
  ;; YAP sabit kalir. Tum GF satirlari ayni miktarda yukari tasinir;
  ;; loop, block ve yazilarin mevcut satir araliklari korunur.
  (if (and panelObj (= (type panelObj) 'VLA-OBJECT) loopRecords)
    (progn
      (setq panelEnt
        (vl-catch-all-apply 'vlax-vla-object->ename (list panelObj)))
      (if (vl-catch-all-error-p panelEnt) (setq panelEnt nil))
      (setq bb
        (if panelEnt
          (degk--column-frame-block-visible-bbox panelEnt)
          nil))
      (if (null bb) (setq bb (degk--ent-bbox panelObj)))
      (setq panelTopY (if bb (cadr (cadr bb)) nil)
            dy
              (if (numberp panelTopY)
                (degk--room-first-loop-shift-y panelTopY loopRecords)
                nil))
      (if (and (numberp dy) (> dy 1e-9))
        (progn
          (setq moveEntities
            (degk--gf-row-entities entities loopRecords floorSpacing))
          (if (degk--move-entities-y moveEntities dy)
            (degk--shift-loop-records-y-data loopRecords dy)
            loopRecords))
        loopRecords))
    loopRecords)
)

(defun degk--stage-square-direct-loop-record
  (rec radius
   / oldEnt rawPts layer color direction squareData newPts newBulges
     beforeEnt makeRes newEnt)
  ;; Multiline olmayan planda eski loopu silmeden filletsiz bir kopya hazirla.
  ;; Tum YAP baglantilari basarili olursa cagiran eski entity'yi siler.
  (setq oldEnt (if (listp rec) (car rec) nil)
        rawPts (if (listp rec) (nth 5 rec) nil)
        layer (if (listp rec) (nth 3 rec) nil)
        color (if (listp rec) (nth 4 rec) nil)
        direction
          (if (and (listp rec) (numberp (nth 6 rec)))
            (nth 6 rec)
            -1.0)
        squareData
          (if rawPts
            (degk--loop-left-square-data rawPts radius direction)
            nil))
  (if (and oldEnt (entget oldEnt) squareData)
    (progn
      (setq newPts (car squareData)
            newBulges (cadr squareData)
            beforeEnt (entlast)
            makeRes
              (degk--entmake-lwpoly-bulges
                newPts newBulges layer color)
            newEnt (entlast))
      (if (and makeRes newEnt (not (eq beforeEnt newEnt)))
        (list
          (list newEnt newPts newBulges layer color rawPts direction)
          oldEnt)
        nil))
    nil)
)

(defun degk--loop-record-top-y (rec / pt topY)
  (foreach pt (if (listp rec) (cadr rec) nil)
    (if (and (listp pt) (numberp (cadr pt))
             (or (null topY) (> (cadr pt) topY)))
      (setq topY (cadr pt))))
  topY
)

(defun degk--direct-route-add-point (pts pt / lastPt)
  (setq lastPt (if pts (last pts) nil))
  (if (and lastPt (degk--pt-eq? lastPt pt 1e-6))
    pts
    (append pts (list pt)))
)

(defun degk--direct-loop-turn-ys
  (firstY lastY previousTopY gap / topTurnY firstTurnY lastTurnY)
  ;; Iki yatay baglanti arasi bir ofsettir. Alt baglanti da altindaki
  ;; loopun ustunden bir ofset yukarida kalir.
  (if (and (numberp firstY) (numberp lastY)
           (numberp previousTopY) (numberp gap) (> gap 1e-9))
    (progn
      (setq topTurnY (+ previousTopY (* 2.0 gap)))
      (if (>= firstY lastY)
        (setq firstTurnY topTurnY
              lastTurnY (- topTurnY gap))
        (setq firstTurnY (- topTurnY gap)
              lastTurnY topTurnY))
      ;; Donus seviyesini mevcut loop agzinin otesine tasima.
      (list (min firstTurnY firstY)
            (min lastTurnY lastY)))
    nil)
)

(defun degk--direct-loop-route-points
  (panelX panelTopY mouthPt turnY / mouthX mouthY z bendY pts)
  ;; YAP'tan loop agzina yalniz dik/yatay parcalarla gider. turnY verilirse
  ;; ust loop once altindaki loopun ustune iner, sonra sola doner.
  (if (and (numberp panelX) (numberp panelTopY)
           (listp mouthPt)
           (numberp (car mouthPt)) (numberp (cadr mouthPt)))
    (progn
      (setq mouthX (car mouthPt)
            mouthY (cadr mouthPt)
            z (if (and (caddr mouthPt) (numberp (caddr mouthPt)))
                (caddr mouthPt)
                0.0)
            bendY
              (if (and (numberp turnY)
                       (>= turnY (- (min panelTopY mouthY) 1e-6))
                       (<= turnY (+ (max panelTopY mouthY) 1e-6)))
                turnY
                (/ (+ panelTopY mouthY) 2.0))
            pts nil)
      (setq pts
        (degk--direct-route-add-point
          pts (list panelX panelTopY z)))
      (setq pts
        (degk--direct-route-add-point
          pts (list panelX bendY z)))
      (setq pts
        (degk--direct-route-add-point
          pts (list mouthX bendY z)))
      (setq pts
        (degk--direct-route-add-point pts mouthPt))
      pts)
    nil)
)

(defun degk--draw-room-panel-direct-loops
  (panelObj loopRecords
   / panelBBoxP panelEnt bb mn mx centerX topY z gap pairPitch records count index
     rec ent pts firstPt lastPt currentCenter targetCenter delta layer color
     panelFirstX panelLastX firstX firstY lastX lastY previousTopY currentTopY
     turnYs firstTurnY lastTurnY firstRoute secondRoute
     stage stagedRecords stagedOldEnts stagedNewEnts beforeEnt firstRes firstEnt
     secondRes secondEnt made ok)
  ;; Kombine multiline yoksa her GF loopunun iki agzini diger looplardan
  ;; bagimsiz olarak YAP'in ust kenarina kadar kendi layer/rengiyle uzat.
  ;; Loop agizlari filletsizdir. Ust looplar once alt loopun ustune iner,
  ;; sonra sola donup YAP'taki kendilerine ait iki noktaya baglanir.
  (setq panelBBoxP
    (and (listp panelObj)
         (eq (car panelObj) 'BOUNDS)
         (listp (cadr panelObj))
         (= (length (cadr panelObj)) 2)))
  (if (and panelObj
           (or (= (type panelObj) 'VLA-OBJECT) panelBBoxP)
           (listp loopRecords))
    (progn
      (if panelBBoxP
        (setq bb (cadr panelObj))
        (progn
          (setq panelEnt
            (vl-catch-all-apply 'vlax-vla-object->ename (list panelObj)))
          (if (vl-catch-all-error-p panelEnt) (setq panelEnt nil))
          (setq bb
            (if panelEnt
              (degk--column-frame-block-visible-bbox panelEnt)
              nil))
          (if (null bb) (setq bb (degk--ent-bbox panelObj)))))
      (foreach rec loopRecords
        (setq ent (if (listp rec) (car rec) nil)
              pts (if (listp rec) (cadr rec) nil))
        (if (and ent (entget ent)
                 (listp pts) (>= (length pts) 2)
                 (= (type (nth 3 rec)) 'STR)
                 (/= (nth 3 rec) ""))
          (setq records (cons rec records))))
      (setq records
        (vl-sort records
          (function
            (lambda (a b)
              (< (degk--loop-record-mouth-y a)
                 (degk--loop-record-mouth-y b))))))
      (if (and bb records)
        (progn
          (setq mn (car bb)
                mx (cadr bb)
                centerX (/ (+ (car mn) (car mx)) 2.0)
                topY (cadr mx)
                z (if (and (caddr mx) (numberp (caddr mx)))
                    (caddr mx)
                    0.0)
                gap (abs (DEG:CFG-DK-NUM-OR 'DK_UNDER_X2 10.0)))
          (if (<= gap 1e-9)
            (setq gap (* 10.0 (DEG:PLAN-UNIT-SCALE))))
          (if (<= gap 1e-9) (setq gap 1.0))
          ;; Ciftin kendi genisligi bir ofset; komsu ciftle boslugu da bir ofset.
          (setq pairPitch (* 2.0 gap)
                count (length records)
                index 0
                made nil
                stagedRecords nil
                stagedOldEnts nil
                stagedNewEnts nil
                ok T)
          ;; Filletli looplari once gecici filletsiz entity'ler olarak kur.
          ;; Eski entity'ler ancak butun YAP baglantilari tamamlaninca silinir.
          (foreach rec records
            (if ok
              (progn
                (setq stage
                  (degk--stage-square-direct-loop-record rec gap))
                (if stage
                  (progn
                    (setq stagedRecords
                            (cons (car stage) stagedRecords)
                          stagedOldEnts
                            (cons (cadr stage) stagedOldEnts)
                          stagedNewEnts
                            (cons (car (car stage)) stagedNewEnts)))
                  (setq ok nil)))))
          (if ok
            (setq records (reverse stagedRecords)))
          (foreach rec records
            (if ok
              (progn
                (setq ent (car rec)
                      pts (cadr rec)
                      firstPt (car pts)
                      lastPt (last pts)
                      layer (nth 3 rec)
                      color (nth 4 rec)
                      currentCenter (/ (+ (car firstPt) (car lastPt)) 2.0)
                      targetCenter
                        ;; Alt loop sagda, ust looplar sirayla solda kalir;
                        ;; YAP cikislarinda yatay kollar dik kollari kesmez.
                        (+ centerX
                           (* (- (/ (- count 1) 2.0)
                                 (* 1.0 index))
                              pairPitch))
                      panelFirstX
                        (+ targetCenter (- (car firstPt) currentCenter))
                      panelLastX
                        (+ targetCenter (- (car lastPt) currentCenter))
                      ;; En alttaki loop YAP ustune kadar stretch edilir.
                      ;; Ust looplar yerinde kalir ve kare guzergahla sola gelir.
                      delta
                        (if (= index 0)
                          (- targetCenter currentCenter)
                          0.0))
                (if (or (<= (abs delta) 1e-9)
                        (degk--shift-lwpoly-x ent delta 'MOUTHS))
                  (progn
                    (setq firstX (+ (car firstPt) delta)
                          firstY (cadr firstPt)
                          lastX (+ (car lastPt) delta)
                          lastY (cadr lastPt)
                          ;; Ilk ciftin yatay rayini esas al; loop govdesindeki
                          ;; cihaz cikintilari baglanti seviyesini yukseltemez.
                          currentTopY
                            (max (cadr (car (nth 5 rec)))
                                 (cadr (last (nth 5 rec))))
                          turnYs
                            (if (and (> index 0) (numberp previousTopY))
                              (degk--direct-loop-turn-ys
                                firstY lastY previousTopY gap)
                              nil)
                          firstTurnY
                            (if turnYs
                              (car turnYs)
                              nil)
                          lastTurnY
                            (if turnYs
                              (cadr turnYs)
                              nil)
                          firstRoute
                            (degk--direct-loop-route-points
                              panelFirstX topY
                              (list firstX firstY z)
                              firstTurnY)
                          secondRoute
                            (degk--direct-loop-route-points
                              panelLastX topY
                              (list lastX lastY z)
                              lastTurnY))
                    (degk--ensure-layer-editable layer)
                    (setq beforeEnt (entlast)
                          firstRes
                            (degk--entmake-lwpoly
                              firstRoute
                              layer color)
                          firstEnt (entlast))
                    (if (and firstRes firstEnt
                             (not (eq beforeEnt firstEnt)))
                      (setq made (cons firstEnt made))
                      (setq ok nil))
                    (if ok
                      (progn
                        (setq beforeEnt (entlast)
                              secondRes
                                (degk--entmake-lwpoly
                                  secondRoute
                                  layer color)
                              secondEnt (entlast))
                        (if (and secondRes secondEnt
                                 (not (eq beforeEnt secondEnt)))
                          (setq made (cons secondEnt made))
                          (setq ok nil)))))
                  (setq ok nil))
                (if (numberp currentTopY)
                  (setq previousTopY
                    (if turnYs
                      (max (car turnYs) (cadr turnYs))
                      currentTopY)))
                (setq index (1+ index)))))
          (if ok
            (progn
              (degk--delete-entity-list stagedOldEnts)
              T)
            (progn
              (degk--delete-entity-list made)
              (degk--delete-entity-list stagedNewEnts)
              nil)))
        nil))
    nil)
)

(defun degk--panel-run-rail-contact (target railY runs / run ed item pt best score bestScore)
  ;; Yatay rayla ayni seviyedeki gercek polyline teget noktasini bul.
  ;; Dikey kolonun X'i, filletin alt seviyesinde temas noktasi degildir.
  (foreach run runs
    (if (equal (car run) (car target) 1e-6)
      (foreach item (entget (cadr run))
        (if (and (= (car item) 10)
                 (setq pt (cdr item))
                 (equal (cadr pt) railY 1e-6))
          (progn
            (setq score (abs (- (car pt) (car target))))
            (if (or (null bestScore) (< score bestScore))
              (setq best pt bestScore score)))))))
  best)

(defun degk--straighten-first-gf-loop
  (records limits runs / rec firstRec y minY raw pts firstTarget lastTarget
   newPts rev before result newEnt)
  ;; Ilk loopun govdesini koru; donusleri kaldirip yatay raylari
  ;; mevcut eslesmelerindeki panel hatlarinin gercek tegetlerinde bitir.
  (foreach rec records
    (setq y (degk--loop-record-mouth-y rec))
    (if (and (numberp y) (or (null minY) (< y minY)))
      (setq minY y firstRec rec)))
  (if (and firstRec (entget (car firstRec))
           (setq raw (nth 5 firstRec))
           (>= (length raw) 4) limits)
    (progn
      (setq pts (cadr firstRec)
            firstTarget (degk--nearest-point-by-x (car pts) limits)
            lastTarget (degk--nearest-point-by-x (last pts) limits))
      (if runs
        (setq firstTarget
                (degk--panel-run-rail-contact firstTarget (cadr (car raw)) runs)
              lastTarget
                (degk--panel-run-rail-contact lastTarget (cadr (last raw)) runs)))
      (if (and firstTarget lastTarget)
        (progn
          (setq newPts
            (cons (cons (car firstTarget) (cdr (car raw))) (cdr raw))
                rev (reverse newPts)
                newPts
            (reverse
              (cons (cons (car lastTarget) (cdr (car rev))) (cdr rev)))
                before (entlast)
                result (degk--entmake-lwpoly
                         newPts (nth 3 firstRec) (nth 4 firstRec))
                newEnt (entlast))
          (if (and result newEnt (not (eq before newEnt)))
            (progn (entdel (car firstRec)) T)
            nil))))
    nil))

(defun degk--extend-second-gf-loop (records targets risers radius
  / rec upperRec y upperY pts raw firstTarget lastTarget before result newEnt
    body newPts bulges i n x1 x2 y1 y2 z1 z2)
  ;; Ust koseler kare; alt koseler panel hattina yatay teget filletlidir.
  (foreach rec records
    (setq y (degk--loop-record-mouth-y rec))
    (if (and (numberp y) (or (null upperY) (> y upperY)))
      (setq upperY y upperRec rec)))
  (if (and (= (length records) 2) upperRec (entget (car upperRec))
           (setq raw (nth 5 upperRec)) (>= (length raw) 4))
    (progn
      (setq pts (cadr upperRec)
            firstTarget (degk--nearest-point-by-x (car pts) targets)
            lastTarget (degk--nearest-point-by-x (last pts) targets))
      (if (and firstTarget lastTarget
               (> (- (cadr (car raw)) (cadr firstTarget)) radius)
               (> (- (cadr (last raw)) (cadr lastTarget)) radius))
        (progn
          (setq x1 (car firstTarget) y1 (cadr firstTarget)
                x2 (car lastTarget) y2 (cadr lastTarget)
                z1 (if (caddr firstTarget) (caddr firstTarget) 0.0)
                z2 (if (caddr lastTarget) (caddr lastTarget) 0.0)
                body (reverse (cdr (reverse (cdr raw))))
                newPts
                  (append
                    (list (list (- x1 radius) y1 z1)
                          (list x1 (+ y1 radius) z1)
                          (list x1 (cadr (car raw)) z1))
                    body
                    (list (list x2 (cadr (last raw)) z2)
                          (list x2 (+ y2 radius) z2)
                          (list (- x2 radius) y2 z2)))
                i 0 n (length newPts) bulges nil)
          (repeat n
            (setq bulges
              (cons (cond ((= i 0) 0.414213562373095)
                          ((= i (- n 2)) -0.414213562373095)
                          (T 0.0)) bulges)
                  i (1+ i)))
          (setq before (entlast)
                result (degk--entmake-lwpoly-bulges
                         newPts (reverse bulges) (nth 3 upperRec) (nth 4 upperRec))
                newEnt (entlast))
          (if (and result newEnt (not (eq before newEnt)))
            (progn
              (entdel (car upperRec))
              (degk--delete-entity-list risers)
              T)
            nil))))))

(defun degk--draw-room-panel-risers
(panelObj layer riserLimits loopRecords riserEntities shaftRiserEntities straightFirstP / panelEnt bb mn mx centerX topY z gap rise x1 x2 upperY lowerY haveTarget oneLoopTargetP twoLoopTargetP singleLoopStretchRes singleLoopEnt singleLoopOriginalData singleLoopShiftedP singleLoopLeftY singleLoopRightY leftBottom rightBottom leftTop rightTop leftX rightX leftMinY leftMaxY rightMinY rightMaxY riserAboveP rebuildRes firstTargetX firstTargetMinY firstTargetMaxY firstTargetJoinY secondTargetX secondTargetMinY secondTargetMaxY secondTargetJoinY shaftInfos shaftTargets shaftRequiredP shaftBranchOne shaftBranchTwo shaftBranchChanges branchChange originalRiser firstEnt secondEnt horizontalOne horizontalTwo extensionOne extensionTwo made ok)
  ;; Yangin panelinden cikan cift hatti saga dondurup GF kombine kolonuna baglar.
  (if (and panelObj (= (type panelObj) 'VLA-OBJECT)
           layer (= (type layer) 'STR) (/= layer ""))
    (progn
      (setq panelEnt
        (vl-catch-all-apply 'vlax-vla-object->ename (list panelObj)))
      (if (vl-catch-all-error-p panelEnt) (setq panelEnt nil))
      (setq bb
        (if panelEnt
          (degk--column-frame-block-visible-bbox panelEnt)
          nil))
      (if (null bb) (setq bb (degk--ent-bbox panelObj)))
      (if bb
        (progn
          (setq mn (car bb)
                mx (cadr bb)
                centerX (/ (+ (car mn) (car mx)) 2.0)
                topY (cadr mx)
                z (if (and (caddr mx) (numberp (caddr mx))) (caddr mx) 0.0)
                gap (* 10.0 (DEG:PLAN-UNIT-SCALE))
                rise (* 200.0 (DEG:PLAN-UNIT-SCALE))
                x1 (- centerX (/ gap 2.0))
                x2 (+ centerX (/ gap 2.0))
                haveTarget
                  (and (listp riserLimits)
                       (>= (length riserLimits) 4)
                       (listp (nth 0 riserLimits))
                       (listp (nth 1 riserLimits))
                       (listp (nth 2 riserLimits))
                       (listp (nth 3 riserLimits)))
                oneLoopTargetP
                  (and haveTarget
                       (listp loopRecords)
                       (= (length loopRecords) 1))
                twoLoopTargetP
                  (and haveTarget
                       (listp loopRecords)
                       (= (length loopRecords) 2))
                shaftInfos (degk--shaft-riser-infos shaftRiserEntities)
                shaftRequiredP (>= (length shaftInfos) 2)
                upperY (+ topY rise)
                ;; Saga donen cift hatta ic kol 100 mm daha kisa biter.
                lowerY (if (or haveTarget shaftRequiredP) (- upperY gap) upperY)
                shaftTargets
                  (if shaftRequiredP
                    (degk--panel-shaft-targets shaftInfos lowerY)
                    shaftInfos)
                made nil
                shaftBranchChanges nil)
          (if haveTarget
            (progn
              (setq riserAboveP
                (degk--riser-limits-above-horizontal-p
                  riserLimits upperY lowerY))
              ;; GF kombinesi yatay baglantidan asagi gidiyorsa tum looplari
              ;; yukari bakan filletlerle yeniden kur. Yeni dik cift tum agizlari
              ;; kapsar; yalniz geometrik en alt loop kare dirsek olarak kalir.
              (if (and (not riserAboveP) loopRecords)
                (progn
                  (setq rebuildRes
                    (vl-catch-all-apply
                      'degk--rebuild-gf-down-riser
                      (list layer riserLimits loopRecords riserEntities)))
                  (cond
                    ((vl-catch-all-error-p rebuildRes)
                      (princ
                        (strcat
                          "\nDK: GF-asagi fillet son islemi atlandi; panel baglantisi mevcut uclara cizilecek: "
                          (vl-catch-all-error-message rebuildRes))))
                    ((and (= (type rebuildRes) 'LIST)
                          (>= (length rebuildRes) 3))
                      (setq riserLimits (car rebuildRes)
                            loopRecords (cadr rebuildRes)
                            riserEntities (caddr rebuildRes))))))
              (setq leftBottom (nth 0 riserLimits)
                    rightBottom (nth 1 riserLimits)
                    leftTop (nth 2 riserLimits)
                    rightTop (nth 3 riserLimits)
                    leftX (car leftBottom)
                    rightX (car rightBottom)
                    leftMinY (min (cadr leftBottom) (cadr leftTop))
                    leftMaxY (max (cadr leftBottom) (cadr leftTop))
                    rightMinY (min (cadr rightBottom) (cadr rightTop))
                    rightMaxY (max (cadr rightBottom) (cadr rightTop)))
              ;; GF dik hatlari yataylarin ustundeyse onceki; altindaysa saga
              ;; donuste paralel sirayi koruyan ters X eslemesini kullan.
              (if riserAboveP
                (setq firstTargetX leftX
                      firstTargetMinY leftMinY
                      firstTargetMaxY leftMaxY
                      secondTargetX rightX
                      secondTargetMinY rightMinY
                      secondTargetMaxY rightMaxY)
                (setq firstTargetX rightX
                      firstTargetMinY rightMinY
                      firstTargetMaxY rightMaxY
                      secondTargetX leftX
                      secondTargetMinY leftMinY
                      secondTargetMaxY leftMaxY))
              (setq firstTargetJoinY
                      (degk--panel-riser-fillet-y
                        upperY firstTargetMinY firstTargetMaxY
                        riserAboveP gap)
                    secondTargetJoinY
                      (degk--panel-riser-fillet-y
                        lowerY secondTargetMinY secondTargetMaxY
                        riserAboveP gap))))
          (if (and straightFirstP twoLoopTargetP)
            (setq firstTargetJoinY upperY
                  secondTargetJoinY lowerY))
          ;; Tek GF loopunda kombine hatti loopa kadar tasima. Loopun yalniz
          ;; iki agiz/fillet bolgesini FAP merkezine stretch et ve magenta
          ;; panel hatlarini bu iki agizda dik olarak bitir.
          (if oneLoopTargetP
            (progn
              (setq singleLoopStretchRes
                (degk--stretch-single-loop-to-panel
                  loopRecords riserLimits centerX))
              (if singleLoopStretchRes
                (setq singleLoopEnt (nth 0 singleLoopStretchRes)
                      singleLoopOriginalData (nth 1 singleLoopStretchRes)
                      singleLoopShiftedP T
                      x1 (nth 3 singleLoopStretchRes)
                      x2 (nth 4 singleLoopStretchRes)
                      singleLoopLeftY (nth 5 singleLoopStretchRes)
                      singleLoopRightY (nth 6 singleLoopStretchRes))
                (setq oneLoopTargetP nil))))
          (degk--ensure-layer-editable layer)
          (setq firstEnt
              (cond
                (oneLoopTargetP
                  (degk--column-frame-polyline
                    (list (list x1 topY z)
                          (list x1 singleLoopLeftY z))
                    layer nil))
                (haveTarget
                  (degk--make-panel-filleted-run
                    x1 topY upperY
                    (if (and straightFirstP twoLoopTargetP) (- firstTargetX gap) firstTargetX)
                    firstTargetJoinY z gap layer
                    (not twoLoopTargetP)))
                (T
                  (degk--column-frame-polyline
                    (list (list x1 topY z)
                          (list x1
                                (if shaftRequiredP (- upperY gap) upperY)
                                z))
                    layer nil)))
                made (if firstEnt (cons firstEnt made) made)
                secondEnt
              (cond
                (oneLoopTargetP
                  (degk--column-frame-polyline
                    (list (list x2 topY z)
                          (list x2 singleLoopRightY z))
                    layer nil))
                (haveTarget
                  (degk--make-panel-filleted-run
                    x2 topY lowerY
                    (if (and straightFirstP twoLoopTargetP) (- secondTargetX gap) secondTargetX)
                    secondTargetJoinY z gap layer
                    (not twoLoopTargetP)))
                (T
                  (degk--column-frame-polyline
                    (list (list x2 topY z)
                          (list x2
                                (if shaftRequiredP (- lowerY gap) lowerY)
                                z))
                    layer nil)))
                made (if secondEnt (cons secondEnt made) made))
          (if haveTarget
            (progn
              ;; GF hedefli iki panel kolu tek parca baglanti olarak kuruldu.
              (setq horizontalOne firstEnt
                    horizontalTwo secondEnt
                    extensionOne T
                    extensionTwo T)))
          (if shaftRequiredP
            (progn
              (setq shaftBranchOne
                      (degk--make-panel-shaft-branch
                        x1 topY upperY (car shaftTargets) z gap layer)
                    made
                      (if shaftBranchOne
                        (append (car shaftBranchOne) made)
                        made)
                    shaftBranchChanges
                      (if shaftBranchOne
                        (cons shaftBranchOne shaftBranchChanges)
                        shaftBranchChanges)
                    shaftBranchTwo
                      (degk--make-panel-shaft-branch
                        x2 topY lowerY (cadr shaftTargets) z gap layer)
                    made
                      (if shaftBranchTwo
                        (append (car shaftBranchTwo) made)
                        made)
                    shaftBranchChanges
                      (if shaftBranchTwo
                        (cons shaftBranchTwo shaftBranchChanges)
                        shaftBranchChanges))))
          (setq ok
            (and firstEnt secondEnt
                 (or (not haveTarget)
                      (and horizontalOne horizontalTwo
                           extensionOne extensionTwo))
                 (or (not shaftRequiredP)
                     (and shaftBranchOne shaftBranchTwo))))
          (if ok
            (progn
              (if (and straightFirstP twoLoopTargetP)
                (degk--extend-second-gf-loop loopRecords
                  (list (list firstTargetX upperY z)
                        (list secondTargetX lowerY z))
                  riserEntities gap))
              (if (and straightFirstP haveTarget (not oneLoopTargetP))
                (degk--straighten-first-gf-loop loopRecords riserLimits
                  (list (list firstTargetX firstEnt)
                        (list secondTargetX secondEnt))))
              T)
            (progn
              (foreach panelEnt made
                (vl-catch-all-apply 'entdel (list panelEnt)))
              ;; Iki baglantidan biri kurulamazsa silinen asil saft dikmelerini
              ;; de geri getir; yarim bir iki-yonlu baglanti birakma.
              (foreach branchChange shaftBranchChanges
                (setq originalRiser (cadr branchChange))
                (if (and originalRiser
                         (caddr branchChange)
                         (null (entget originalRiser)))
                  (vl-catch-all-apply 'entdel (list originalRiser))))
              ;; Tek-loop stretch yapildiysa yarim kalan panel baglantisinda
              ;; loopun ilk geometrisini geri yukle.
              (if (and singleLoopShiftedP singleLoopEnt
                       singleLoopOriginalData (entget singleLoopEnt))
                (if (entmod singleLoopOriginalData)
                  (entupd singleLoopEnt)))
              nil)))
        nil))
    nil)
)

(defun degk--column-centered-text (pt txt layer height rotation / data)
  (if (and pt txt (/= txt "") (numberp height) (> height 0.0))
    (progn
      (setq data
        (list
          '(0 . "TEXT")
          '(100 . "AcDbEntity")
          (cons 8 layer)
          '(100 . "AcDbText")
          (cons 10 pt)
          (cons 40 height)
          (cons 1 txt)
          (cons 50 (if (numberp rotation) rotation 0.0))
          '(41 . 1.0)
          '(7 . "STANDARD")
          '(71 . 0)
          '(72 . 1)
          (cons 11 pt)
          '(100 . "AcDbText")
          '(73 . 2)))
      (entmakex data))
    nil)
)

(defun degk--column-room-text (pt txt layer height)
  ;; Oda basligini verilen noktanin yatay/dikey merkezine yerlestirir.
  (degk--column-centered-text pt txt layer height 0.0)
)

(defun degk--ups-panel-label-text (txt / i key result)
  (setq i 1 result "")
  (while (<= i (strlen txt))
    (setq key (strcase (substr txt i 3)))
    (cond
      ((= key "FAP") (setq result (strcat result "UPS") i (+ i 3)))
      ((= key "YAP") (setq result (strcat result "KGK") i (+ i 3)))
      (T (setq result (strcat result (substr txt i 1)) i (1+ i)))))
  result)

(defun degk--room-device-label (ent text powerP upsLayer labelLayer englishP / bb mn mx x y z center height run tx ed energyY energyText energyRun energyHeight)
  (setq bb (degk--column-frame-block-visible-bbox ent))
  (if (null bb) (setq bb (degk--ent-bbox ent)))
  (if bb
    (progn
      (setq mn (car bb) mx (cadr bb) x (car mn) y (cadr mx)
            z (if (caddr mx) (caddr mx) 0.0)
            center (/ (+ (car mn) (car mx)) 2.0)
            height (* 30.0 (DEG:PLAN-UNIT-SCALE)))
      (if (null upsLayer) (setq upsLayer "E_UPS_LINYE"))
      (if (not (tblsearch "LAYER" upsLayer))
        (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord")
          '(100 . "AcDbLayerTableRecord") (cons 2 upsLayer) '(70 . 0) '(62 . 7) '(6 . "Continuous"))))
      (degk--ensure-layer-editable upsLayer)
      (degk--entmake-lwpoly
        (list (list center (cadr mn) z)
              (list center (- (cadr mn) (* 150.0 (DEG:PLAN-UNIT-SCALE))) z)) upsLayer 256)
      (setq energyY (- (cadr mn) (* 75.0 (DEG:PLAN-UNIT-SCALE)))
            energyHeight (* 25.0 (DEG:PLAN-UNIT-SCALE))
            energyText (if englishP "FOR ENERGY SUPPLY" "GÜÇ BESLEMESÝ")
            energyRun (max (* 200.0 (DEG:PLAN-UNIT-SCALE))
                          (* energyHeight (+ 2.0 (* 0.8 (strlen energyText))))))
      (degk--entmake-lwpoly
        (list (list center energyY z) (list (+ center energyRun) energyY z)) labelLayer 256)
      (degk--add-loop-intersection-mark
        (list center energyY z)
        (DEG:CFG-DK-NUM-OR 'DK_LOOP_MARK_LENGTH 10.0)
        labelLayer)
      (degk--column-centered-text
        (list (+ center (/ energyRun 2.0)) (+ energyY energyHeight) z)
        energyText labelLayer energyHeight 0.0)
      (setq text (if (= (type text) 'STR) text ""))
      (if powerP (setq text (degk--ups-panel-label-text text)))
      (setq run (max (* 200.0 (DEG:PLAN-UNIT-SCALE)) (* height (+ 2.0 (* 0.8 (strlen text))))))
      (degk--entmake-lwpoly (list (list x y z) (list (- x run) y z)) labelLayer 256)
      (if (/= text "")
        (progn
          (setq tx (degk--column-centered-text
            (list (- x (/ run 2.0)) (+ y height) z) text labelLayer height 0.0))
          (if tx
            (progn
              (setq ed (entget tx))
              (setq ed (vl-remove-if '(lambda (p) (member (car p) '(62 420 430))) ed))
              (setq ed (apply 'append (mapcar '(lambda (p)
                (if (= (car p) 8) (list p '(62 . 256)) (list p))) ed)))
              (entmod ed) (entupd tx))))))))

(defun degk--prepare-column-layer (layer / ent ed)
  (degk--ensure-layer-editable layer)
  (if (setq ent (tblobjname "LAYER" layer))
    (progn
      (setq ed (vl-remove-if '(lambda (p) (member (car p) '(420 430))) (entget ent)))
      (setq ed (subst '(62 . 7) (assoc 62 ed) ed))
      (setq ed (if (assoc 370 ed)
                 (subst '(370 . -3) (assoc 370 ed) ed)
                 (append ed '((370 . -3)))))
      (entmod ed)))
  layer)

(defun degk--right-floor-line (pts layer / ent ed)
  (if (not (tblsearch "LTYPE" "HIDDEN"))
    (entmake
      '((0 . "LTYPE") (100 . "AcDbSymbolTableRecord")
        (100 . "AcDbLinetypeTableRecord") (2 . "HIDDEN") (70 . 0)
        (3 . "Hidden __ __ __") (72 . 65) (73 . 2) (40 . 9.525)
        (49 . 6.35) (74 . 0) (49 . -3.175) (74 . 0))))
  (if (setq ent (degk--column-frame-polyline pts layer nil))
    (progn
      (setq ed (entget ent))
      (setq ed (vl-remove-if '(lambda (p) (member (car p) '(6 48 62 420 430))) ed))
      (setq ed (apply 'append
        (mapcar '(lambda (p)
          (if (= (car p) 8)
            (list p '(6 . "HIDDEN") '(62 . 252) (cons 48 (* 10.0 (DEG:PLAN-UNIT-SCALE))))
            (list p))) ed)))
      (entmod ed)
      (entupd ent)))
  ent)

(defun degk--floor-line-outside-shaft (xMin xMax y z layer shaftP / leftX rightX)
  (setq leftX (+ xMin (* 150.0 (DEG:PLAN-UNIT-SCALE)))
        rightX (+ xMin (* 450.0 (DEG:PLAN-UNIT-SCALE))))
  (if (and shaftP (< rightX xMax))
    (progn
      (degk--column-frame-polyline (list (list xMin y z) (list leftX y z)) layer nil)
      (degk--right-floor-line (list (list rightX y z) (list xMax y z)) layer))
    (degk--column-frame-polyline (list (list xMin y z) (list xMax y z)) layer nil)))

(defun degk--panel-loop-label (panelEnt count roomHeight layer / bb mn mx x y z height label run)
  (if (and panelEnt (numberp count) (> count 0))
    (progn
      (setq bb (degk--column-frame-block-visible-bbox panelEnt))
      (if (null bb) (setq bb (degk--ent-bbox panelEnt)))
      (if bb
        (progn
          (setq mn (car bb) mx (cadr bb)
                x (car mx) y (/ (+ (cadr mn) (cadr mx)) 2.0)
                z (if (caddr mx) (caddr mx) 0.0)
                height (/ roomHeight 2.0) label (strcat (itoa count) " LOOP")
                run (max (* 200.0 (DEG:PLAN-UNIT-SCALE)) (* height (+ 2.0 (* 0.8 (strlen label))))))
          (degk--entmake-lwpoly (list (list x y z) (list (+ x run) y z)) layer 256)
          (degk--column-centered-text
            (list (+ x (/ run 2.0)) (+ y height) z) label layer height 0.0))))))

(defun degk--column-floor-label-groups (anchors / groups rec key label y current)
  ;; Ayni kata ait birden fazla loop satirini tek kat etiketi ve ortalama
  ;; yerlesim Y degeri altinda birlestir.
  (foreach rec anchors
    (if (and (listp rec)
             (>= (length rec) 3)
             (numberp (car rec))
             (numberp (nth 2 rec)))
      (progn
        (setq key     (car rec)
              label   (degk--clean-text (if (cadr rec) (cadr rec) ""))
              y       (nth 2 rec)
              current (assoc key groups))
        (if current
          (setq groups
            (subst
              (list key
                    (if (/= (cadr current) "") (cadr current) label)
                    (+ (nth 2 current) y)
                    (1+ (nth 3 current)))
              current
              groups))
          (setq groups (cons (list key label y 1) groups))))))
  (mapcar
    (function
      (lambda (group)
        (list
          (car group)
          (degk--expanded-floor-label
            (if (/= (cadr group) "")
              (cadr group)
              (degk--default-floor-label (car group)))
            (car group))
          (/ (nth 2 group) (nth 3 group)))))
    groups)
)

(defun degk--column-grid-y-values (values / sorted out value)
  (setq sorted
    (vl-sort (vl-remove-if-not 'numberp values)
      (function (lambda (a b) (< a b)))))
  (foreach value sorted
    (if (or (null out)
            (> (abs (- value (last out))) 1e-6))
      (setq out (append out (list value)))))
  out
)

(defun degk--column-grid-cell-at-y (gridYs anchorY / ys lower upper bounds)
  (setq ys (degk--column-grid-y-values gridYs))
  (while (and (cdr ys) (null bounds))
    (setq lower (car ys)
          upper (cadr ys))
    (if (and (>= anchorY (- lower 1e-6))
             (<= anchorY (+ upper 1e-6)))
      (setq bounds (list lower upper)))
    (setq ys (cdr ys)))
  bounds
)

(defun degk--column-floor-groups-english-p (groups / group txt haveLabel turkishP)
  ;; Genisletilmis kat adlarinda Turkce bir kat ifadesi yoksa saft basligini
  ;; kolon semasinin Ingilizce diliyle eslestir.
  (foreach group groups
    (setq txt (strcase (degk--clean-text (if (cadr group) (cadr group) ""))))
    (if (/= txt "") (setq haveLabel T))
    (if (or (wcmatch txt "*ZEMÝN*,*ZEMIN*,*BODRUM*,*ÇATI*,*CATI*")
            (wcmatch txt "* KAT,*KAT"))
      (setq turkishP T)))
  (and haveLabel (not turkishP))
)

(defun degk--draw-column-floor-index
  (xMin xMax yMin yMax gridYs floorAnchors layer z textHeight
   / inset dividerX textX groups group bounds cellKey usedCells ent made
     shaftInset shaftX shaftHeaderDepth shaftHeaderY shaftText)
  ;; Sol cerceve kenarindan 1500 mm iceri kat isimligini, 4500 mm iceri de
  ;; saft kolonunu ciz.
  (setq inset    (* 150.0 (DEG:PLAN-UNIT-SCALE))
        dividerX (+ xMin inset)
        shaftInset (* 450.0 (DEG:PLAN-UNIT-SCALE))
        shaftX (+ xMin shaftInset)
        shaftHeaderDepth (* 100.0 (DEG:PLAN-UNIT-SCALE))
        shaftHeaderY (- yMax shaftHeaderDepth))
  (if (and (> inset 1e-9) (< dividerX xMax))
    (progn
      (setq ent
        (degk--column-frame-polyline
          (list (list dividerX yMin z) (list dividerX yMax z))
          layer nil))
      (if ent (setq made (cons ent made)))
      (setq textX (/ (+ xMin dividerX) 2.0)
            groups (degk--column-floor-label-groups floorAnchors))
      (if (and (> (length groups) 1)
               (> shaftInset inset)
               (< shaftX xMax))
        (progn
          (setq ent
            (degk--column-frame-polyline
              (list (list shaftX yMin z) (list shaftX yMax z))
              layer nil))
          (if ent (setq made (cons ent made)))
          ;; Ust kenardan 1000 mm asagida ayri bir saft baslik bolmesi olustur.
          (if (> shaftHeaderY yMin)
            (progn
              (setq ent
                (degk--column-frame-polyline
                  (list (list dividerX shaftHeaderY z)
                        (list shaftX shaftHeaderY z))
                  layer nil))
              (if ent (setq made (cons ent made)))
              (setq shaftText
                      (if (degk--column-floor-groups-english-p groups)
                        "SHAFT"
                        "ÞAFT")
                    ent
                      (degk--column-centered-text
                        (list (/ (+ dividerX shaftX) 2.0)
                              (/ (+ shaftHeaderY yMax) 2.0)
                              z)
                        shaftText layer textHeight 0.0))
              (if ent (setq made (cons ent made)))))))
      (foreach group groups
        (setq bounds
          (degk--column-grid-cell-at-y gridYs (nth 2 group)))
        (if bounds
          (progn
            (setq cellKey
              (strcat (rtos (car bounds) 2 6) "|" (rtos (cadr bounds) 2 6)))
            (if (not (member cellKey usedCells))
              (progn
                (setq ent
                  (degk--column-centered-text
                    (list textX (/ (+ (car bounds) (cadr bounds)) 2.0) z)
                    (cadr group)
                    layer
                    textHeight
                    (/ pi 2.0)))
                (if ent (setq made (cons ent made)))
                (setq usedCells (cons cellKey usedCells))))))))
  )
  (reverse made)
)

(defun degk--vertical-floor-boundary-steps
  (rowFloors / sorted rec currentFloor previousFloor havePrevious step boundaries)
  ;; Dik moddaki her benzersiz loop satirini gercek katiyla siralar. Yalniz kat
  ;; degisiminden once tamamlanan satir sayilarini cerceve siniri olarak dondurur.
  (setq sorted
    (vl-sort rowFloors
      (function (lambda (a b) (< (car a) (car b)))))
        step 0
        boundaries nil)
  (foreach rec sorted
    (setq currentFloor (cdr rec))
    (if (and havePrevious (not (equal currentFloor previousFloor)))
      (setq boundaries (cons step boundaries)))
    (setq previousFloor currentFloor
          havePrevious T
          step (1+ step)))
  (reverse boundaries)
)

(defun degk--gf-loop-count (records / rec floorNo count haveGf)
  (setq count 0
        haveGf nil)
  (foreach rec records
    (setq floorNo (nth 1 rec))
    (if (and (numberp floorNo) (= floorNo 0))
      (progn
        (setq haveGf T)
        ;; Flasor/ozel looplar dik yerlesimde baglandiklari normal loop
        ;; satirini kullanir; GF yuksekliginde ikinci kez sayilmazlar.
        (if (not (degk--layout-record-flasher-p rec))
          (setq count (1+ count))))))
  (if (and haveGf (= count 0)) 1 count)
)

(defun degk--column-source-inserts (/ ss i ent obj layer out)
  ;; DK:BASE ile ayni kaynak INSERT filtresini olcum oncesinde uygula.
  (setq ss (ssget "_X" '((0 . "INSERT")))
        i 0
        out nil)
  (if ss
    (while (< i (sslength ss))
      (setq ent (ssname ss i)
            obj (if ent
                  (vl-catch-all-apply 'vlax-ename->vla-object (list ent))
                  nil)
            layer
              (if (and obj (not (vl-catch-all-error-p obj)))
                (vl-catch-all-apply 'vla-get-Layer (list obj))
                nil))
      (if (and obj
               (not (vl-catch-all-error-p obj))
               layer
               (not (vl-catch-all-error-p layer))
               (/= (strcase layer) "0")
               (not (DEG:IGNORE-BLOCK-OBJ? obj)))
        (setq out (cons obj out)))
      (setq i (1+ i))))
  out
)

(defun degk--layout-record-ordered-blocks
  (rec blockObjs tol / loopEnts plEnt touched blkObj totalLen useFromStart ordered ins dist key)
  ;; Cizim yapmadan once DK:BASE'in temas ve cihaz siralamasini aynen kur.
  (setq loopEnts (degk--layout-record-members rec)
        plEnt    (nth 4 rec)
        touched nil
        ordered nil)
  (foreach blkObj blockObjs
    (if (degk--block-touches-loop-p loopEnts blkObj tol)
      (setq touched (cons blkObj touched))))
  (if (and touched plEnt (degk--curve-ok? plEnt))
    (progn
      (setq totalLen
              (vlax-curve-getDistAtParam
                plEnt (vlax-curve-getEndParam plEnt))
            useFromStart
              (degk--use-from-lower-sira-side plEnt touched totalLen))
      (foreach blkObj touched
        (setq ins  (deg-get-inspt blkObj)
              dist (degk--dist-along plEnt ins)
              key
                (if (> (length loopEnts) 1)
                  (degk--block-loop-order-key blkObj loopEnts)
                  (if useFromStart dist (- totalLen dist)))
              ordered (cons (cons key blkObj) ordered)))
      (setq ordered
        (vl-sort ordered (function (lambda (a b) (< (car a) (car b))))))))
  ordered
)

(defun degk--layout-record-planned-width
  (rec blockObjs monitorHandles / ordered pair blkObj siraList siraOne dkkP seenTokens seenGroups token groupKey copyP idx positions pos lastPos spacing dx fixedLen maxOffset leftExt handle)
  ;; Loop polyline'inin DK:BASE sonunda olusacak gercek yatay genisligini,
  ;; cihaz kopya yuvalarindan cizim yapmadan hesapla.
  (setq ordered
          (degk--layout-record-ordered-blocks
            rec blockObjs (DEG:CFG-TOL-NUM-OR 'DN_BLOCK_TOL 1.0))
        dkkP (degkk--active-p)
        seenTokens nil
        seenGroups nil
        idx 0
        positions nil)
  (foreach pair ordered
    (setq blkObj   (cdr pair)
          siraList (degk--expand-sira-no (degk--get-att blkObj "SIRA_NO")))
    (if (or (null siraList) (= (length siraList) 0))
      (setq siraList (list (degk--get-att blkObj "SIRA_NO"))))
    (setq siraList (degk--limit-sira-list siraList))
    (foreach siraOne siraList
      (setq siraOne (degk--clean-text siraOne)
            copyP T)
      (if dkkP
        (progn
          (setq token (degkk--normal-token blkObj siraOne)
                groupKey (degkk--normal-group-key blkObj))
          (cond
            ((member token seenTokens)
              (setq copyP nil))
            ((member groupKey seenGroups)
              (setq seenTokens (cons token seenTokens)
                    copyP nil))
            (T
              (setq seenTokens (cons token seenTokens)
                    seenGroups (cons groupKey seenGroups))))))
      (if copyP
        (progn
          (setq positions (append positions (list idx))
                idx (1+ idx)
                handle (strcase (degkk--object-handle blkObj)))
          (if (and (/= handle "") (member handle monitorHandles))
            (setq idx (1+ idx)))))))
  (if positions
    (progn
      (setq spacing  (DEG:CFG-DK-NUM-OR 'DK_COPY_SPACING 100.0)
            dx       (DEG:CFG-DK-NUM-OR 'DK_UNDER_X1 10.0)
            fixedLen (* 90.0 (DEG:PLAN-UNIT-SCALE))
            leftExt  (degk--normal-group-left-extension)
            lastPos  (last positions)
            maxOffset (+ (* lastPos spacing) dx))
      ;; Son blockun sag cikintisi cizilmez; onceki blocklarin p4 noktasi kalir.
      (foreach pos positions
        (if (/= pos lastPos)
          (setq maxOffset
            (max maxOffset (+ (* pos spacing) dx fixedLen)))))
      (+ leftExt maxOffset))
    nil)
)

(defun degk--layout-floor-number (floorNo roofFloor /)
  (if (and roofFloor (degk--roof-floor-p floorNo)) roofFloor floorNo)
)

(defun degk--vertical-pack-floors
  (records blockObjs monitorHandles groupGap roofFloor / rec floorNo width item grouped floorRec widths measurement measurements combined longestOther other eps result)
  ;; Bir katin looplari yan yana geldiginde, baska bir kattaki en uzun tek
  ;; loopu asmiyorsa o kati tek dik-kolon satirinda paketle.
  (setq grouped nil
        measurements nil
        eps 1e-6)
  (foreach rec records
    (if (and (car rec) (not (degk--layout-record-flasher-p rec)))
      (progn
        (setq floorNo
                (degk--layout-floor-number (nth 1 rec) roofFloor)
              width
                (degk--layout-record-planned-width
                  rec blockObjs monitorHandles))
        (if (and (numberp floorNo) (numberp width) (> width eps))
          (progn
            (setq measurements (cons (cons floorNo width) measurements))
            (if (setq floorRec (assoc floorNo grouped))
              (setq grouped
                (subst
                  (cons floorNo (append (cdr floorRec) (list width)))
                  floorRec grouped))
              (setq grouped (cons (list floorNo width) grouped))))))))
  (foreach item grouped
    (setq floorNo (car item)
          widths  (cdr item))
    (if (> (length widths) 1)
      (progn
        (setq combined (* (max 0 (1- (length widths))) groupGap))
        (foreach width widths (setq combined (+ combined width)))
        (setq longestOther nil)
        (foreach measurement measurements
          (if (/= (car measurement) floorNo)
            (setq other (cdr measurement)
                  longestOther
                    (if longestOther (max longestOther other) other))))
        (if (and longestOther (<= combined (+ longestOther eps)))
          (setq result (cons floorNo result))))))
  result
)

(defun degk--vertical-floor-row-count (rowFloors wantedFloor / rec count)
  (setq count 0)
  (foreach rec rowFloors
    (if (equal (cdr rec) wantedFloor)
      (setq count (1+ count))))
  count
)

(defun degk--gf-floor-height-rows (verticalP gfLoopCount)
  (if (and (numberp gfLoopCount) (> gfLoopCount 0))
    (if verticalP
      (+ gfLoopCount 1.0)
      1.5)
    0.0)
)

(defun degk--gf-floor-extra-rows (verticalP gfLoopCount gfLayoutLoopCount)
  ;; Yerlesim kullanilan satirlari zaten sayar. Oda icin yalniz bir ek satir
  ;; birak; ayni satira paketlenen looplar tekrar yukseklik eklemesin.
  (if (and (numberp gfLoopCount) (> gfLoopCount 0))
    (if verticalP
      1.0
      0.5)
    0.0)
)

(defun degk--gf-layout-y
  (baseY floorRow floorNo floorSpacing gfExtraRows / y)
  (setq y (+ baseY (* floorRow floorSpacing)))
  (if (and (numberp floorNo)
           (> floorNo 0)
           (numberp gfExtraRows)
           (> gfExtraRows 1e-9))
    (+ y (* gfExtraRows floorSpacing))
    y)
)

(defun degk--column-frame-gf-grid-y
  (gridY gfAnchorY gfExtraRows floorSpacing)
  (if (and (numberp gridY)
           (numberp gfAnchorY)
           (numberp gfExtraRows)
           (> gfExtraRows 1e-9)
           (numberp floorSpacing)
           (> gridY gfAnchorY))
    (+ gridY (* gfExtraRows floorSpacing))
    gridY)
)

(defun degk--gf-room-dimensions (floorSpacing / referenceHeight)
  (setq referenceHeight (* floorSpacing 1.5))
  (list
    referenceHeight
    (/ referenceHeight 20.0)
    (* referenceHeight (/ 9.0 10.0)))
)

(defun degk--column-frame-room-x-bounds
  (xMin xMax roomAnchor roomWidth margin / roomLeft roomRight)
  (if (and (numberp xMin)
           (numberp xMax)
           (listp roomAnchor)
           (numberp (car roomAnchor))
           (numberp roomWidth)
           (numberp margin))
    (progn
      (setq roomLeft (car roomAnchor)
            roomRight (+ roomLeft roomWidth))
      (list
        (min xMin (- roomLeft margin))
        (max xMax (+ roomRight margin))
        roomLeft
        roomRight))
    (list xMin xMax nil nil))
)

(defun degk--draw-column-frame (entities basePt processResult / roomGfAligned bb mn mx margin upShift floorSpacing layer xMin xMax yMin yMax z y drawY topFloorY verticalRowFloors verticalLayoutP boundarySteps lineStep drawLineP frameGridYs floorLabelAnchors floorLabelGroups mainLoopRecords mainRiserLimits mainRiserEntities shaftCenterX gfRoomAnchorW roomSourceBlocks roomRiserLayer roomGfRiserLimits roomGfLoopRecords roomGfRiserEntities gfFloorExtraRows gfLoopCount gfFloorHeightRows gfRequiredTopY layoutRowYs highestRowY gfAnchorY gfBottomY gfRoomDimensions roomOffset roomWidth roomHeight roomHeader roomTextHeight roomBlockSpacing roomBlockDrop roomXBounds roomLeftX roomRightX roomBottomY roomTopY roomHeaderY roomTextPt roomCenterX roomCenterY powerTargetW panelTargetW powerCopy panelCopy)
  (setq bb (degk--column-frame-bbox entities))
  (if bb
    (progn
      ;; Ayar tabani cm'dir: her kenarda 500 cm = 5000 mm dis pay.
      (setq mn (car bb)
            mx (cadr bb)
            margin (* 500.0 (DEG:PLAN-UNIT-SCALE))
            ;; Cerceve ve kat ayiricilarinin tamami 3000 mm yukariya tasinir.
            upShift (* 300.0 (DEG:PLAN-UNIT-SCALE))
            floorSpacing (DEG:CFG-DK-NUM-OR 'DK_NORMAL_FLOOR_SPACING 700.0)
            verticalRowFloors
              (if (and (= (type processResult) 'LIST)
                       (> (length processResult) 3)
                       (listp (nth 3 processResult)))
                (nth 3 processResult)
                nil)
            verticalLayoutP (if verticalRowFloors T nil)
            boundarySteps
              (if verticalRowFloors
                (degk--vertical-floor-boundary-steps verticalRowFloors)
                nil)
            gfRoomAnchorW
              (if (and (= (type processResult) 'LIST)
                       (> (length processResult) 4)
                       (listp (nth 4 processResult))
                       (numberp (car (nth 4 processResult)))
                       (numberp (cadr (nth 4 processResult))))
                (nth 4 processResult)
                nil)
            roomSourceBlocks
              (if (and (= (type processResult) 'LIST)
                       (> (length processResult) 5)
                       (= (length (nth 5 processResult)) 2))
                (nth 5 processResult)
                nil)
            roomRiserLayer
              (if (and (= (type processResult) 'LIST)
                       (> (length processResult) 6)
                       (= (type (nth 6 processResult)) 'STR)
                       (/= (nth 6 processResult) ""))
                (nth 6 processResult)
                nil)
            roomGfRiserLimits
              (if (and (= (type processResult) 'LIST)
                       (> (length processResult) 7)
                       (listp (nth 7 processResult))
                       (>= (length (nth 7 processResult)) 4))
                (nth 7 processResult)
                nil)
            roomGfLoopRecords
              (if (and (= (type processResult) 'LIST)
                       (> (length processResult) 8)
                       (listp (nth 8 processResult)))
                (nth 8 processResult)
                nil)
            roomGfRiserEntities
              (if (and (= (type processResult) 'LIST)
                       (> (length processResult) 9)
                       (listp (nth 9 processResult)))
                (nth 9 processResult)
                nil)
            gfFloorExtraRows
              (if (and (= (type processResult) 'LIST)
                       (> (length processResult) 10)
                       (numberp (nth 10 processResult)))
                (nth 10 processResult)
                0.0)
            gfLoopCount
              (if (and (= (type processResult) 'LIST)
                       (> (length processResult) 11)
                       (numberp (nth 11 processResult)))
                (nth 11 processResult)
                0)
            layoutRowYs
              (if (and (= (type processResult) 'LIST)
                       (> (length processResult) 12)
                       (listp (nth 12 processResult)))
                (vl-remove-if-not 'numberp (nth 12 processResult))
                nil)
            floorLabelAnchors
              (if (and (= (type processResult) 'LIST)
                       (> (length processResult) 13)
                       (listp (nth 13 processResult)))
                (nth 13 processResult)
                nil)
            mainLoopRecords
              (if (and (= (type processResult) 'LIST)
                       (> (length processResult) 14)
                       (listp (nth 14 processResult)))
                (nth 14 processResult)
                nil)
            mainRiserLimits
              (if (and (= (type processResult) 'LIST)
                       (> (length processResult) 15)
                       (listp (nth 15 processResult))
                       (>= (length (nth 15 processResult)) 2))
                (nth 15 processResult)
                nil)
            mainRiserEntities
              (if (and (= (type processResult) 'LIST)
                       (> (length processResult) 16)
                       (listp (nth 16 processResult)))
                (nth 16 processResult)
                nil)
            highestRowY (if layoutRowYs (apply 'max layoutRowYs) nil)
            gfFloorHeightRows
              (degk--gf-floor-height-rows verticalLayoutP gfLoopCount)
            layer "e_kolon_þemasý"
            xMin (- (car mn) margin)
            xMax (+ (car mx) margin)
            yMin (+ (- (cadr mn) margin) upShift)
            yMax (+ (+ (cadr mx) margin) upShift)
            z (if (caddr mn) (caddr mn) 0.0)
            gfAnchorY (if gfRoomAnchorW (cadr gfRoomAnchorW) nil)
            gfBottomY yMin
            ;; Oda, loop adedinden bagimsiz sabit 1,5 katlik GF referansinin
            ;; eski 1/20 alt pay ve 9/10 yukseklik oranlarini korur.
            gfRoomDimensions (degk--gf-room-dimensions floorSpacing)
            roomOffset (cadr gfRoomDimensions)
            roomWidth (* 1500.0 (DEG:PLAN-UNIT-SCALE))
            roomHeight (nth 2 gfRoomDimensions)
            roomHeader (* 100.0 (DEG:PLAN-UNIT-SCALE))
            roomTextHeight (* 50.0 (DEG:PLAN-UNIT-SCALE))
            roomBlockSpacing (* 600.0 (DEG:PLAN-UNIT-SCALE))
            roomBlockDrop (* 200.0 (DEG:PLAN-UNIT-SCALE)))
      ;; Elektrik odasi cerceveden sonra cizilse de dis cercevenin X sinirlari
      ;; odayi her iki yandan ayni 5000 mm payla kapsar. Bu, secimde kombine
      ;; multiline bulunmadiginda da oda ile kolon semasini tek cercevede tutar.
      (setq roomXBounds
              (degk--column-frame-room-x-bounds
                xMin xMax gfRoomAnchorW roomWidth margin)
            xMin (car roomXBounds)
            xMax (cadr roomXBounds)
            roomLeftX (nth 2 roomXBounds)
            roomRightX (nth 3 roomXBounds))
      ;; 1500-4500 mm arasindaki saft kolonunun orta ekseni 3000 mm'dir.
      ;; Birden fazla katta, ana kombine dik hat ve loop agizlari bu eksene
      ;; stretch edilir; GF'nin elektrik odasina ait ozel kombinesi degismez.
      (setq floorLabelGroups
              (degk--column-floor-label-groups floorLabelAnchors)
            shaftCenterX (+ xMin (* 300.0 (DEG:PLAN-UNIT-SCALE)))
      )
      (if (and (> (length floorLabelGroups) 1)
               mainLoopRecords mainRiserLimits mainRiserEntities)
        (degk--center-main-riser-in-shaft
          mainLoopRecords mainRiserLimits mainRiserEntities shaftCenterX))
      (if (or (null roomRiserLayer)
              (/= (type roomRiserLayer) 'STR)
              (= roomRiserLayer ""))
        (setq roomRiserLayer
          (degk--first-entity-layer roomGfRiserEntities)))
      ;; Yalniz GF secilmis olsa bile sembol bbox'i cerceveyi kisaltamaz.
      ;; GF'nin alt izgara cizgisinden itibaren dikte loop adedi kadar, yatayda
      ;; ise sabit 1,5 katlik yukseklik dis cercevenin asgari ust siniridir.
      (if (and (numberp gfAnchorY)
               (> floorSpacing 1e-9)
               (> gfFloorHeightRows 1e-9))
        (progn
          (setq y (+ yMin floorSpacing))
          (while (<= y gfAnchorY)
            (setq gfBottomY y
                  y (+ y floorSpacing)))
          (setq gfRequiredTopY
            (+ gfBottomY (* gfFloorHeightRows floorSpacing)))
          (if (> gfRequiredTopY yMax)
            (setq yMax gfRequiredTopY))))
      ;; Gercek yerlesim satirlari varsa bbox'taki uzun dik baglantilar ve yazi
      ;; yukseklikleri ust cerceveyi buyutemez. En yuksek loop satirindan sonraki
      ;; ilk kat izgara cizgisi dogrudan cercevenin ust kenari olur.
      (if (> floorSpacing 1e-9)
        (if (numberp highestRowY)
          (progn
            (setq y (+ yMin floorSpacing)
                  drawY
                    (degk--column-frame-gf-grid-y
                      y gfAnchorY gfFloorExtraRows floorSpacing))
            (while (<= drawY highestRowY)
              (setq y (+ y floorSpacing)
                    drawY
                      (degk--column-frame-gf-grid-y
                        y gfAnchorY gfFloorExtraRows floorSpacing)))
            (setq yMax
              (if (and gfRequiredTopY (> gfRequiredTopY drawY))
                gfRequiredTopY
                drawY)))
          ;; Eski/eksik processResult icin bbox tabanli davranisi koru.
          (progn
            (setq y (+ yMin floorSpacing)
                  drawY
                    (degk--column-frame-gf-grid-y
                      y gfAnchorY gfFloorExtraRows floorSpacing)
                  topFloorY nil)
            (while (< drawY yMax)
              (setq topFloorY drawY
                    y (+ y floorSpacing)
                    drawY
                      (degk--column-frame-gf-grid-y
                        y gfAnchorY gfFloorExtraRows floorSpacing)))
            (if topFloorY
              (setq yMax
                (if (and gfRequiredTopY (> gfRequiredTopY topFloorY))
                  gfRequiredTopY
                  topFloorY))))))
      (degk--prepare-column-layer layer)
      (degk--column-frame-polyline
        (list
          (list xMin yMin z)
          (list xMax yMin z)
          (list xMax yMax z)
          (list xMin yMax z))
        layer T)
      ;; Alt kenardan baslayip Kat Mesafesi kadar araliklarla yukari bol.
      (setq frameGridYs (list yMin))
      (if (> floorSpacing 1e-9)
        (progn
          (setq y (+ yMin floorSpacing)
                drawY
                  (degk--column-frame-gf-grid-y
                    y gfAnchorY gfFloorExtraRows floorSpacing)
                lineStep 1)
          (while (< drawY yMax)
            ;; Yatay mod eski davranisini korur. Dik modda ayni kat icindeki
            ;; loop satirlari atlanir; yalniz kat degisim sinirlari cizilir.
            (setq drawLineP
              (or (null verticalRowFloors)
                  (member lineStep boundarySteps)))
            (if drawLineP
              (progn
                (degk--floor-line-outside-shaft
                  xMin xMax drawY z layer (> (length floorLabelGroups) 1))
                (setq frameGridYs (cons drawY frameGridYs))
                ;; GF loop satirinin altinda kalan en yakin gercek kat
                ;; ayiricisini elektrik odasi icin referans al.
                (if (and gfAnchorY
                         (<= drawY gfAnchorY)
                         (> drawY gfBottomY))
                  (setq gfBottomY drawY))))
            (setq y (+ y floorSpacing)
                  drawY
                    (degk--column-frame-gf-grid-y
                    y gfAnchorY gfFloorExtraRows floorSpacing)
                  lineStep (1+ lineStep)))))
      (setq frameGridYs (cons yMax frameGridYs))
      (degk--draw-column-floor-index
        xMin xMax yMin yMax frameGridYs floorLabelAnchors
        layer z roomTextHeight)
      (if gfRoomAnchorW
        (progn
          (setq roomBottomY (+ gfBottomY roomOffset)
                roomTopY (+ roomBottomY roomHeight)
                roomHeaderY (- roomTopY roomHeader)
                roomTextPt
                  (list (/ (+ roomLeftX roomRightX) 2.0)
                        (/ (+ roomTopY roomHeaderY) 2.0)
                        z))
          (degk--column-frame-polyline
            (list
              (list roomLeftX roomBottomY z)
              (list roomRightX roomBottomY z)
              (list roomRightX roomTopY z)
              (list roomLeftX roomTopY z))
            layer T)
          (degk--column-frame-polyline
            (list
              (list roomLeftX roomHeaderY z)
              (list roomRightX roomHeaderY z))
            layer nil)
          (degk--column-room-text
            roomTextPt "ELEKTRÝK ODASI" layer roomTextHeight)
          (if roomSourceBlocks
            (progn
              (setq roomCenterX (/ (+ roomLeftX roomRightX) 2.0)
                    roomCenterY
                      (- (/ (+ roomBottomY roomTopY) 2.0) roomBlockDrop)
                    powerTargetW
                      (list (- roomCenterX (/ roomBlockSpacing 2.0))
                            roomCenterY z)
                    panelTargetW
                      (list (+ roomCenterX (/ roomBlockSpacing 2.0))
                            roomCenterY z)
                    powerCopy
                      (degk--copy-room-block-safe
                        (car roomSourceBlocks) powerTargetW)
                    panelCopy
                      (degk--copy-room-block-safe
                        (cadr roomSourceBlocks) panelTargetW))
              ;; Ikisinden biri kopyalanamazsa odada yarim bir sembol cifti birakma.
              (if (and powerCopy panelCopy)
                (progn
                  (degk--panel-loop-label (vlax-vla-object->ename panelCopy) *degk-panel-loop-count* roomTextHeight layer)
                  (degk--room-device-label (vlax-vla-object->ename panelCopy)
                    *degk-last-panel-name* nil (degk--selected-ups-layer areaSS nil) layer
                    (degk--column-floor-groups-english-p floorLabelGroups))
                  (degk--room-device-label (vlax-vla-object->ename powerCopy)
                    *degk-last-panel-name* T (degk--selected-ups-layer areaSS nil) layer
                    (degk--column-floor-groups-english-p floorLabelGroups))
                (setq *degk-ups-source*
                  (list powerCopy
                        (degk--ups-riser-left-x mainRiserEntities shaftCenterX)
                        (car (degk--pts-x-bounds roomGfRiserLimits))
                        verticalLayoutP))))
              (if (and powerCopy panelCopy)
                (if roomRiserLayer
                  (progn
                    (if (and verticalLayoutP roomGfLoopRecords)
                      (progn
                        (setq roomGfAligned
                          (degk--align-gf-combined-to-panel
                            panelCopy roomGfLoopRecords roomGfRiserLimits
                            roomGfRiserEntities entities floorSpacing mainRiserEntities)
                              roomGfLoopRecords (car roomGfAligned)
                              roomGfRiserLimits (cadr roomGfAligned))))
                    (degk--draw-room-panel-risers
                    panelCopy roomRiserLayer roomGfRiserLimits
                    roomGfLoopRecords roomGfRiserEntities
                    (if (> (length floorLabelGroups) 1)
                      mainRiserEntities
                      nil)
                    verticalLayoutP))
                  ;; Kaynakta kombine multiline yoksa looplari birbirine
                  ;; baglamadan her bir cift ucu ayri ayri YAP'a getir.
                  (if roomGfLoopRecords
                    (progn
                      (setq roomGfLoopRecords
                        (degk--align-gf-loops-to-panel
                          panelCopy roomGfLoopRecords entities floorSpacing))
                      (degk--draw-room-panel-direct-loops
                        panelCopy roomGfLoopRecords))))
                (progn
                  (if powerCopy
                    (vl-catch-all-apply 'vla-Delete (list powerCopy)))
                  (if panelCopy
                    (vl-catch-all-apply 'vla-Delete (list panelCopy)))
                  (princ
                    "\nDK: Elektrik odasi panel/guc kaynagi kopyasi tamamlanamadi.")))))))
      T)
    nil)
)

(defun degk--maybe-draw-column-frame (afterEnt basePt processResult / total entities answer)
  (setq total
    (if (and (= (type processResult) 'LIST)
             (> (length processResult) 1)
             (numberp (cadr processResult)))
      (cadr processResult)
      0))
  (if (> total 0)
    (progn
      (setq entities (degk--column-frame-new-entities afterEnt))
      (initget "Evet Hayir")
      (setq answer
        (getkword
          "\nKolon semasi kat cercevesi cizilsin mi? [Evet/Hayir] <Hayir>: "))
      (if (= answer "Evet")
        (if (degk--perf-call "Cerceve-oda-saft" 'degk--draw-column-frame (list entities basePt processResult))
          (princ "\nDK: Kolon semasi cercevesi ve kat ayiricilari cizildi.")
          (princ "\nDK: Kolon semasi sinirlari hesaplanamadi.")))))
  processResult
)

(defun degk--selected-combined-riser-layer
  (pickset / i ent ed entType layer layers pattern actual selectedLayer)
  ;; Secili alandaki gercek layer adini korur; ayar listesindeki ilk
  ;; eslesen pattern kombine kolon layeri olarak oncelik kazanir.
  (setq i 0
        layers nil)
  (if (and pickset (= (type pickset) 'PICKSET))
    (while (< i (sslength pickset))
      (setq ent     (ssname pickset i)
            ed      (if ent (entget ent) nil)
            entType (if ed (cdr (assoc 0 ed)) nil)
            layer   (if ed (cdr (assoc 8 ed)) nil))
      (if (and layer
               (or (= entType "LWPOLYLINE") (= entType "POLYLINE")))
        (if (not (member (norm-layer layer) (mapcar 'norm-layer layers)))
          (setq layers (append layers (list layer)))))
      (setq i (1+ i))))
  (foreach pattern (DEG:CFG-LIST 'DK_COMBINED_RISER_LAYERS)
    (foreach actual layers
      (if (and (null selectedLayer)
               pattern (/= pattern "")
               (deg-wcmatch actual pattern))
        (setq selectedLayer actual))))
  selectedLayer
)

(defun degk--nearest-mouth-y-pair
  (pointGroups referenceY / group sorted leftPt rightPt meanY score bestScore best)
  ;; X konumu farkli olsa da referans seviyeye en yakin loopun sol/sag agiz
  ;; Y degerlerini verir. Tek bodrum loopunu GF seviyesine uzatmakta kullanilir.
  (foreach group pointGroups
    (if (and (listp group) (>= (length group) 2))
      (progn
        (setq sorted
          (vl-sort group
            (function (lambda (a b) (< (car a) (car b))))))
        (setq leftPt (car sorted)
              rightPt (last sorted))
        (if (and (listp leftPt) (listp rightPt)
                 (numberp (cadr leftPt)) (numberp (cadr rightPt)))
          (progn
            (setq meanY (/ (+ (cadr leftPt) (cadr rightPt)) 2.0)
                  score (abs (- meanY referenceY)))
            (if (or (null bestScore) (< score bestScore))
              (setq bestScore score
                    best (list (cadr leftPt) (cadr rightPt)))))))))
  best
)

(defun degk--draw-combined-riser
  (layer loopPointGroups outerFallbackP / group p allPoints minX z gap leftX rightX
    pointIndex rec leftRecords rightRecords leftRec rightRec score meanY
    candidateIndex candidates candidate pairTolerance usedLeft usedRight
    pairRecords pairIndex pairCount bottomPair topPair singlePair targetPair
    leftMinY leftMaxY rightMinY rightMaxY limitsOnlyP beforeEnt drawEnt beforeSecond secondEnt drawRes secondRes)
  ;; Yalniz aralarindaki Y farki ofset kadar olan sol-sag temaslar gercek
  ;; fillet agzidir. Loopun uzaktaki ust/alt geometrik noktalarini dikkate alma.
  (setq *degk-last-combined-riser-limits* nil
        *degk-last-combined-riser-entities* nil)
  (foreach group loopPointGroups
    (if (listp group)
      (foreach p group
        (if (and (listp p) (numberp (car p)) (numberp (cadr p)))
          (progn
            (setq allPoints (cons p allPoints))
            (if (or (null minX) (< (car p) minX))
              (setq minX (car p)))
            (if (and (null z) (caddr p) (numberp (caddr p)))
              (setq z (caddr p))))))))
  (if (null z) (setq z 0.0))
  (setq gap        (abs (DEG:CFG-DK-NUM-OR 'DK_UNDER_X2 10.0))
        leftX      minX
        rightX     (if minX (+ minX gap) nil)
        pointIndex 0
        leftRecords nil
        rightRecords nil
        candidates nil
        candidateIndex 0
        pairTolerance (max 1e-6 (* gap 0.10))
        usedLeft nil
        usedRight nil
        pairRecords nil
        pairIndex 0)
  (foreach p allPoints
    (setq rec (list (cadr p) pointIndex)
          pointIndex (1+ pointIndex))
    (if (<= (abs (- (car p) leftX)) (abs (- (car p) rightX)))
      (setq leftRecords (cons rec leftRecords))
      (setq rightRecords (cons rec rightRecords))))
  ;; Once tum olasi temaslari puanla. En yakin ofset eslesmelerini global
  ;; sirada tuketmek, uzaktaki bir noktanin gercek fillet ucunu kapmasini onler.
  (foreach leftRec leftRecords
    (foreach rightRec rightRecords
      (setq score (abs (- (abs (- (car leftRec) (car rightRec))) gap)))
      (if (<= score pairTolerance)
        (progn
          (setq meanY (/ (+ (car leftRec) (car rightRec)) 2.0)
                candidates
                  (cons
                    (list score meanY
                          (car leftRec) (car rightRec)
                          (cadr leftRec) (cadr rightRec)
                          candidateIndex)
                    candidates)
                candidateIndex (1+ candidateIndex))))))
  (setq candidates
    (vl-sort candidates
      (function
        (lambda (a b)
          (cond
            ((< (car a) (car b)) T)
            ((> (car a) (car b)) nil)
            ((< (cadr a) (cadr b)) T)
            ((> (cadr a) (cadr b)) nil)
            (T (< (nth 6 a) (nth 6 b))))))))
  (foreach candidate candidates
    (if (and (not (member (nth 4 candidate) usedLeft))
             (not (member (nth 5 candidate) usedRight)))
      (setq usedLeft (cons (nth 4 candidate) usedLeft)
            usedRight (cons (nth 5 candidate) usedRight)
            pairRecords
              (cons
                (list (cadr candidate)
                      (nth 2 candidate)
                      (nth 3 candidate)
                      pairIndex)
                pairRecords)
            pairIndex (1+ pairIndex))))
  ;; Eslesen agizlari alttan uste sirala. Birlesik dik hat ikinci loop
  ;; agzindan sondan bir onceki loop agzina kadar gider.
  (setq pairRecords
    (vl-sort pairRecords
      (function
        (lambda (a b)
          (if (= (car a) (car b))
            (< (nth 3 a) (nth 3 b))
            (< (car a) (car b))))))
        pairCount (length pairRecords))
  (cond
    ;; Yalniz tek bodrum loopu varsa saft dikmelerini GF loop seviyesine kadar
    ;; uzat. X'ler ana loopun agizlarindan, hedef Y'ler GF agizlarindan gelir.
    ((and (= pairCount 1)
          (listp outerFallbackP)
          (eq (car outerFallbackP) 'ONE_SIDE)
          (setq singlePair (car pairRecords))
          (setq targetPair
            (degk--nearest-mouth-y-pair
              (cadr outerFallbackP) (car singlePair))))
      (setq leftMinY  (min (cadr singlePair) (car targetPair))
            leftMaxY  (max (cadr singlePair) (car targetPair))
            rightMinY (min (caddr singlePair) (cadr targetPair))
            rightMaxY (max (caddr singlePair) (cadr targetPair))))
    ;; Tek GF loopunda ayri bir dik multiline gerekmez. Iki panel kolu
    ;; loopun kendi fillet agizlarina dogrudan baglanabilsin diye bu agizlari
    ;; sifir uzunluklu hedef limitleri olarak sakla.
    ((and (eq outerFallbackP 'GF)
          (= pairCount 1)
          (setq singlePair (car pairRecords)))
      (setq leftMinY   (cadr singlePair)
            leftMaxY   (cadr singlePair)
            rightMinY  (caddr singlePair)
            rightMaxY  (caddr singlePair)
            limitsOnlyP T))
    ;; GF'de iki loop varsa her magenta kol panelden gorulen ilk (ust) loopun
    ;; kendi fillet agzinda biter. Diger loop kendi layer rengindeki kare
    ;; uzantiyla bu iki agiz noktasina baglanir.
    ((and (eq outerFallbackP 'GF)
          (= pairCount 2)
          (setq singlePair (last pairRecords)))
      (setq leftMinY   (cadr singlePair)
            leftMaxY   (cadr singlePair)
            rightMinY  (caddr singlePair)
            rightMaxY  (caddr singlePair)
            limitsOnlyP T))
    ;; GF'de uc loop varsa ikinci ve sondan bir onceki ayni orta looptur.
    ;; Iki dik hatti orta loopun iki agiz seviyesi arasinda kisa bir cekirdek
    ;; olarak kur; dis looplar kendi renkleriyle bu cekirdege uzasin.
    ((and (eq outerFallbackP 'GF)
          (= pairCount 3)
          (setq singlePair (nth 1 pairRecords)))
      (setq leftMinY  (min (cadr singlePair) (caddr singlePair))
            leftMaxY  (max (cadr singlePair) (caddr singlePair))
            rightMinY leftMinY
            rightMaxY leftMaxY))
    ;; GF kombinesi panel yatayindan asagi gidiyorsa tum fillet agizlarini
    ;; kapsa; yalniz en alttaki loop daha sonra kare dirsege cevrilir.
    ((and (eq outerFallbackP 'ALL) (>= pairCount 2))
      (setq bottomPair (car pairRecords)
            topPair    (last pairRecords)
            leftMinY  (cadr bottomPair)
            rightMinY (caddr bottomPair)
            leftMaxY  (cadr topPair)
            rightMaxY (caddr topPair)))
    ((>= pairCount 4)
      (setq bottomPair (nth 1 pairRecords)
            topPair    (nth (- pairCount 2) pairRecords)
            leftMinY  (cadr bottomPair)
            rightMinY (caddr bottomPair)
            leftMaxY  (cadr topPair)
            rightMaxY (caddr topPair)))
    ;; GF ayri bir kolon oldugu icin az looplu durumda ilk-son agizlari kullan.
    ((and outerFallbackP (>= pairCount 2))
      (setq bottomPair (car pairRecords)
            topPair    (last pairRecords)
            leftMinY  (cadr bottomPair)
            rightMinY (caddr bottomPair)
            leftMaxY  (cadr topPair)
            rightMaxY (caddr topPair))))
  (if (and layer leftX rightX
           leftMinY leftMaxY rightMinY rightMaxY
           (or limitsOnlyP
               (and (> (- leftMaxY leftMinY) 1e-6)
                    (> (- rightMaxY rightMinY) 1e-6))))
    (progn
      (setq *degk-last-combined-riser-limits*
        (list
          (list leftX leftMinY z)
          (list rightX rightMinY z)
          (list leftX leftMaxY z)
          (list rightX rightMaxY z)))
      (if limitsOnlyP
        T
        (progn
          (degk--ensure-layer-editable layer)
          (setq beforeEnt (entlast)
                drawRes
                  (degk--entmake-lwpoly
                    (list (list leftX leftMaxY z) (list leftX leftMinY z))
                    layer
                    nil)
                drawEnt (entlast)
                beforeSecond drawEnt
                secondRes
                  (if (> gap 1e-9)
                    (degk--entmake-lwpoly
                      (list (list rightX rightMaxY z) (list rightX rightMinY z))
                      layer
                      nil)
                    nil)
                secondEnt (entlast))
          (if (and drawRes secondRes
                   drawEnt secondEnt
                   (not (eq beforeEnt drawEnt))
                   (not (eq beforeSecond secondEnt)))
            (progn
              (setq *degk-last-combined-riser-entities*
                (list drawEnt secondEnt))
              T)
            nil))))
    nil)
)

(defun degk--normal-area-process (dkAreaPickset basePt layoutMode / polylines monitorLinks monitorExtraCount combinedRiserLayer roomSourceBlocks loopLeftPoints gfLoopLeftPoints lastLoopLeftPoints loopDrawRecords gfLoopDrawRecords riserLimits riserEntities gfRiserLimits gfRiserEntities lastLoopDrawRecord groupGap railGap floorSpacing gfShift gfLoopCount gfLayoutLoopCount gfFrameLoopCount gfFloorExtraRows gfRoomAnchorW gfRoomCandidateW layoutRowYs floorLabelAnchors floorLabel floorAnchor haveBelowFloor haveAboveFloor oneSidedRiserP riserFallbackMode baseU targetU targetW groupIndex totalCopies ent memberEnts startPt runRes runSucceededP records rec valid floorNo floorRow floorKey columnNo floorCounts floorRec floorRailSlots railSlotRec railSlotNo floorCountsBefore floorRailSlotsBefore floorRightEdges floorRightRec floorLeftEdges floorLeftRec maxFloor roofFloor roofPresentP fallbackRow verticalP verticalRow verticalCounts verticalCountsBefore verticalRowBefore verticalFloorRows verticalPackFloors verticalPackedFloorRows verticalPackedFloorRowsBefore verticalPackedP verticalPackedRowP packedFloorRowRec sourceInserts flasherSorted specialP terminalSourceObj terminalCopyRec terminalCopyObj terminalBaseW terminalBaseU terminalLayoutRow terminalLayoutFloor terminalUsedCopies terminalUsedCopiesBefore terminalFallback terminalCopyHandle wantedTerminalRow rowRatio edgeKey usedRows *degk-current-layout-row* *degk-current-layout-floor* *degk-dispatch-terminal-source* *degk-dispatch-terminal-copy-rec* *degk-monitor-linked-source-handles* *degk-last-loop-left-points* *degk-last-loop-draw-record* *degk-last-combined-riser-limits* *degk-last-combined-riser-entities*)
  (setq *degk-source-insert-snapshot* (ssget "_X" '((0 . "INSERT"))))
  (setq polylines (degk--normal-area-polylines dkAreaPickset)
        monitorLinks (degk--monitor-link-records dkAreaPickset)
        combinedRiserLayer
          (degk--selected-combined-riser-layer dkAreaPickset)
        roomSourceBlocks (degk--room-source-blocks dkAreaPickset)
        loopLeftPoints nil
        gfLoopLeftPoints nil
        loopDrawRecords nil
        gfLoopDrawRecords nil
        riserLimits nil
        riserEntities nil
        gfRiserEntities nil
        layoutRowYs nil
        floorLabelAnchors nil
        *degk-monitor-linked-source-handles*
          (degk--monitor-linked-source-handles monitorLinks)
        groupGap (abs (DEG:CFG-DK-SIGNED-NUM-OR 'DK_NORMAL_GROUP_SPACING 0.0))
         ;; Yatay paralel raylar DK_UNDER_X2 kadar aralikla dizilir.
         railGap (DEG:CFG-DK-NUM-OR 'DK_UNDER_X2 10.0)
         ;; Kat satirlari arasindaki mesafe DO > DK sayfasindan ayarlanir.
         floorSpacing (DEG:CFG-DK-NUM-OR 'DK_NORMAL_FLOOR_SPACING 700.0)
         ;; GF/ZK/GR loop grubu fiziksel olarak toplam 22000 mm saga kayar.
         gfShift (* 2200.0 (DEG:PLAN-UNIT-SCALE))
         gfRoomAnchorW nil
         baseU (trans basePt 0 1)
        verticalP (eq layoutMode 'DIK)
        verticalRow 0
        verticalCounts nil
        verticalFloorRows nil
        verticalPackedFloorRows nil
        groupIndex 0
        totalCopies 0
        floorCounts nil
        floorRailSlots nil
        floorRightEdges nil
        floorLeftEdges nil
        maxFloor 0
        fallbackRow 0
        terminalUsedCopies nil
        records
          (degk--records-flasher-last
            (degk--perf-call "Kat-loop yerlesim kayitlari" 'degk--normal-area-layout-records (list polylines))))
  (setq gfLoopCount (degk--gf-loop-count records)
        gfFloorExtraRows
          (degk--gf-floor-extra-rows
            verticalP gfLoopCount gfLoopCount))
  (foreach rec records
    (if (car rec)
      (if (degk--roof-floor-p (nth 1 rec))
        (setq roofPresentP T)
        (if (> (nth 1 rec) maxFloor)
          (setq maxFloor (nth 1 rec)))))
  )
  ;; RF/CK sabit ve cok uzak bir kat numarasi kullanmaz. Secimdeki en yuksek
  ;; normal katin tam bir ust satiri olur; gecersiz katlar da catinin ustunden
  ;; devam ederek ayni satira binmez.
  (if roofPresentP
    (setq roofFloor (1+ maxFloor)
          maxFloor roofFloor))
  (setq sourceInserts
          (if verticalP (degk--column-source-inserts) nil)
        verticalPackFloors
          (if verticalP
            (degk--vertical-pack-floors
              records sourceInserts *degk-monitor-linked-source-handles*
              groupGap roofFloor)
            nil)
        gfLayoutLoopCount
          (if (and verticalP
                   (> gfLoopCount 0)
                   (member 0 verticalPackFloors))
            1
            gfLoopCount)
        gfFloorExtraRows
          (degk--gf-floor-extra-rows
            verticalP gfLoopCount gfLayoutLoopCount))
  (setq flasherSorted nil)
  (while records
    ;; Normal looplar tamamlandiginda terminal kopya konumlari artik bellidir.
    ;; Kalan ozel looplari her katta sagdan sola bir kez yeniden sirala.
    (if (and (not flasherSorted)
             (degk--layout-record-flasher-p (car records)))
      (setq records
              (degk--flasher-records-connected-first
                (degk--sort-flasher-records-right-first records))
            flasherSorted T)
    )
    (setq rec     (car records)
          records (cdr records))
    (setq valid   (car rec)
          floorNo (nth 1 rec)
          ent     (nth 4 rec)
          memberEnts (degk--layout-record-members rec)
          specialP (degk--layout-record-flasher-p rec)
          terminalSourceObj (nth 6 rec)
          terminalCopyRec nil
          terminalCopyObj nil
          terminalBaseW nil
          terminalBaseU nil
          terminalLayoutRow nil
          terminalLayoutFloor nil
          railSlotRec nil
          railSlotNo 0
          floorCountsBefore floorCounts
          floorRailSlotsBefore floorRailSlots
          verticalCountsBefore verticalCounts
          verticalRowBefore verticalRow
          verticalPackedFloorRowsBefore verticalPackedFloorRows
          terminalUsedCopiesBefore terminalUsedCopies)
    (if (and valid roofFloor (degk--roof-floor-p floorNo))
      (setq floorNo roofFloor))
    ;; Kaynak planda temas kaydi olsa bile kolon semasinda o kaynagin kopyasi
    ;; yoksa bu gercek bir kolon baglantisi degildir. Kaydi serbest birak ve
    ;; ayni kattaki bos kopya aramasina devam et.
    (if (and specialP terminalSourceObj)
      (progn
        (setq terminalCopyRec
          (degk--area-module-copy-get
            terminalSourceObj
            (if valid floorNo nil)))
        (setq terminalCopyHandle
          (if terminalCopyRec
            (degk--terminal-copy-handle terminalCopyRec)
            ""))
        (if (and (/= terminalCopyHandle "")
                 (member terminalCopyHandle terminalUsedCopies))
          (progn
            ;; Ayni kopyaya ikinci bir loop baglama; bu loop icin baska bos
            ;; terminal ara.
            (setq terminalCopyRec nil
                  terminalSourceObj nil
                  terminalCopyHandle "")))
        (if (null terminalCopyRec)
          (progn
            (princ
              "\nDK: Terminal temasi var fakat kolon kopyasi yok; ayni katta bos modul aranacak.")
            (setq terminalSourceObj nil))
          (setq terminalUsedCopies
            (cons terminalCopyHandle terminalUsedCopies)))))
    ;; Fiziksel baglantisi olmayan flasor loopu icin tahmini kaynak secmek
    ;; yerine, kolon semasinda ayni kat/satirda bos duran gercek kopyayi kullan.
    (if (and specialP (null terminalCopyRec) valid)
      (progn
        (setq wantedTerminalRow (if verticalP nil (- floorNo 1))
              terminalFallback
                (degk--unused-terminal-copy-for-layout
                  rec floorNo wantedTerminalRow terminalUsedCopies))
        (if terminalFallback
          (progn
            (setq terminalSourceObj (car terminalFallback)
                  terminalCopyRec (cadr terminalFallback)
                  terminalCopyHandle (caddr terminalFallback)
                  terminalUsedCopies
                    (cons terminalCopyHandle terminalUsedCopies))
            (princ
              (strcat
                "\nDK: Baglantisiz flasor loop kolon semasindaki bos module baglandi: modul="
                terminalCopyHandle
                " kat=" (itoa floorNo))))
          (princ
            (strcat
              "\nDK: Ayni katta kullanilmamis kolon terminal kopyasi bulunamadi: kat="
              (itoa floorNo))))))
    ;; Bagli loopun kati kolon kopyasinda saklanan gercek kat bilgisinden gelir.
    ;; Yerlesim satiri dik modda kat degildir; yalniz eski yatay kayitlarda
    ;; gercek kat eksikse geriye donuk yedek olarak kullanilir.
    (if (and specialP
             (or terminalCopyRec
                 (and terminalSourceObj
                      (setq terminalCopyRec
                        (degk--area-module-copy-get
                          terminalSourceObj
                          (if valid floorNo nil))))))
      (progn
        (setq terminalLayoutRow   (nth 2 terminalCopyRec)
              terminalLayoutFloor (nth 3 terminalCopyRec))
        (cond
          ((numberp terminalLayoutFloor)
            (setq floorNo terminalLayoutFloor
                  valid T))
          ((and (not verticalP) (numberp terminalLayoutRow))
            (setq floorNo (1+ terminalLayoutRow)
                  valid T)))))
    ;; DKK her polyline'i bagimsiz bir sembol listesi olarak ozetler.
    ;; Ayni sembol baska bir hatta da varsa o hat icin yeniden gosterilir.
    (if (degkk--active-p)
      (setq *DEG_DKK_GROUPS* nil
            *DEG_DKK_SEEN_OCCURRENCES* nil
            *DEG_DK_LAST_COPY_OBJ* nil)
    )
    (if verticalP
      (progn
       (cond
        ((and specialP
              (or terminalCopyRec
                  (and terminalSourceObj
                       (setq terminalCopyRec
                         (degk--area-module-copy-get terminalSourceObj floorNo))))
              (setq terminalCopyObj (car terminalCopyRec))
              (setq terminalBaseW (deg-get-inspt terminalCopyObj)))
          ;; Dik moddaki ozel loop, yeni bir satir acmak yerine baglandigi
          ;; terminal kopyasinin kaydedilmis satirina ve o satirin sonuna gider.
          ;; INSERT noktasindan satir tahmini, blok geometrisine gore bir alt/ust
          ;; satira yuvarlanabildigi icin yalniz eski kayitlarda yedek olarak kalir.
          (setq terminalBaseU (trans terminalBaseW 0 1)
                terminalLayoutRow (nth 2 terminalCopyRec)
                rowRatio
                  (if (> (abs floorSpacing) 1e-9)
                    (/ (- (cadr terminalBaseU) (cadr baseU)) floorSpacing)
                    0.0)
                floorRow
                  (if (numberp terminalLayoutRow)
                    terminalLayoutRow
                    (fix (+ rowRatio (if (>= rowRatio 0.0) 0.5 -0.5))))
                floorRec (assoc floorRow verticalCounts)
                columnNo (if floorRec (cdr floorRec) 0))
          (if floorRec
            (setq verticalCounts
              (subst (cons floorRow (1+ columnNo)) floorRec verticalCounts))
            (setq verticalCounts
              (cons (cons floorRow 1) verticalCounts))))
        ((and specialP valid)
          ;; Terminal/kopya eslesmesi yoksa SIRA_NO'dan bulunan kat satiri
          ;; kullanilir; plandaki gorunmeyen baglanti kati degistirmez.
          (setq packedFloorRowRec
                  (assoc floorNo verticalPackedFloorRows)
                floorRow
                  (if packedFloorRowRec
                    (cdr packedFloorRowRec)
                    (- floorNo 1))
                floorRec (assoc floorRow verticalCounts)
                columnNo (if floorRec (cdr floorRec) 0))
          (if floorRec
            (setq verticalCounts
              (subst (cons floorRow (1+ columnNo)) floorRec verticalCounts))
            (setq verticalCounts
              (cons (cons floorRow 1) verticalCounts)))
          (if (>= floorRow verticalRow)
            (setq verticalRow (1+ floorRow))))
        (T
          ;; Sigan coklu loop kati tek satir kullanir; digerleri ayri satir kalir.
          (setq verticalPackedP
            (and valid (member floorNo verticalPackFloors)))
          (if (and verticalPackedP
                   (setq packedFloorRowRec
                     (assoc floorNo verticalPackedFloorRows)))
            (setq floorRow (cdr packedFloorRowRec))
            (progn
              (setq floorRow verticalRow
                    verticalRow (1+ verticalRow))
              (if verticalPackedP
                (setq verticalPackedFloorRows
                  (cons (cons floorNo floorRow) verticalPackedFloorRows)))))
          (setq
                floorRec (assoc floorRow verticalCounts)
                columnNo (if floorRec (cdr floorRec) 0))
          (if floorRec
            (setq verticalCounts
              (subst (cons floorRow (1+ columnNo)) floorRec verticalCounts))
            (setq verticalCounts
              (cons (cons floorRow 1) verticalCounts)))))
      ;; Paketlenmis dik kat, yatay moddaki iki-ray slotlarini kullanir.
      (setq packedFloorRowRec
              (if valid (assoc floorNo verticalPackedFloorRows) nil)
            verticalPackedRowP
              (and packedFloorRowRec
                   (= floorRow (cdr packedFloorRowRec))))
      (if verticalPackedRowP
        (progn
          (setq railSlotRec (assoc floorRow floorRailSlots)
                railSlotNo (if railSlotRec (cdr railSlotRec) 0))
          (if railSlotRec
            (setq floorRailSlots
              (subst
                (cons floorRow (+ railSlotNo (if specialP 1 2)))
                railSlotRec floorRailSlots))
            (setq floorRailSlots
              (cons (cons floorRow (if specialP 1 2)) floorRailSlots))))))
      (progn
        (if valid
          (setq floorRow (- floorNo 1))
          (progn
            ;; SIRA_NO'suz normal loop yeni bir satir acmaya devam eder. Daha
            ;; sonra bu satirdaki module baglanan ozel loop ayni satir anahtari
            ;; uzerinden mevcut grubun sagina yerlesebilir.
            (setq floorRow (+ maxFloor fallbackRow)
                  fallbackRow (1+ fallbackRow))))
        ;; Yatay duzende sayaclar kat metninden degil gercek satirdan tutulur.
        ;; Boylece SIRA_NO olmasa da ayni satirdaki looplar birbirini gorur.
        (setq floorRec (assoc floorRow floorCounts)
              columnNo (if floorRec (cdr floorRec) 0)
              railSlotRec (assoc floorRow floorRailSlots)
              railSlotNo (if railSlotRec (cdr railSlotRec) 0))
        (if floorRec
          (setq floorCounts
            (subst (cons floorRow (1+ columnNo)) floorRec floorCounts))
          (setq floorCounts (cons (cons floorRow 1) floorCounts)))
        (if railSlotRec
          (setq floorRailSlots
            (subst
              (cons floorRow (+ railSlotNo (if specialP 1 2)))
              railSlotRec
              floorRailSlots))
          (setq floorRailSlots
            (cons (cons floorRow (if specialP 1 2)) floorRailSlots)))
      )
    )
    (setq edgeKey floorRow)
    ;; Elektrik odasi, GF looplari kaydirilmadan onceki baslangic X'ini
    ;; kullanir. Yalniz basariyla cizilen ilk GF loopunda kalici olur.
    (setq gfRoomCandidateW
      (if (and (numberp floorNo) (= floorNo 0))
        (trans
          (list (car baseU)
                (+ (cadr baseU) (* floorRow floorSpacing))
                (if (caddr baseU) (caddr baseU) 0.0))
          1 0)
        nil))
    (setq targetU
           (list (+ (car baseU)
                    (if (and (numberp floorNo) (= floorNo 0))
                      gfShift
                      0.0))
                 (degk--gf-layout-y
                   (cadr baseU) floorRow floorNo
                   floorSpacing gfFloorExtraRows)
                 (if (caddr baseU) (caddr baseU) 0.0))
           targetW (trans targetU 1 0)
           startPt (vl-catch-all-apply 'vlax-curve-getStartPoint (list ent)))
    ;; Ayni kattaki sonraki grup, onceki grubun gercek sag ucundan ayarlanan
    ;; loop araligi kadar sonra baslar. DK alt hatti baslangictan 400 cm sola uzadigi
    ;; icin hedef noktasina bu fiziksel uzanti da eklenir.
    (if (and floorRec
             (setq floorRightRec (assoc edgeKey floorRightEdges)))
      (setq targetW
        (list (+ (cdr floorRightRec)
                 groupGap
                 (degk--normal-group-left-extension))
              (cadr targetW)
              (if (caddr targetW) (caddr targetW) 0.0)))
    )
    (if (vl-catch-all-error-p startPt)
      (setq startPt (cdr (assoc 10 (entget ent))))
    )
     (setq floorLeftRec
       (if (and floorRec (or (not verticalP) verticalPackedRowP))
         (assoc floorRow floorLeftEdges)
         nil))
     (setq *degk-dispatch-sel* (list ent startPt)
           *degk-dispatch-loop-ents* memberEnts
           *degk-dispatch-base* targetW
           *degk-dispatch-loop-drop*
             (if verticalP
               (if verticalPackedRowP
                 ;; Ayni kat satirindaki her normal loop iki ray yeri kaplar.
                 (if specialP
                   (* (max 0 (1- railSlotNo)) railGap)
                   (* railSlotNo railGap))
                 ;; Alt alta kalan dik looplarin mevcut davranisi korunur.
                 (* columnNo railGap))
               (if specialP
                 ;; Ozel loop daha sonra bir ray araligi asagi tasinir; bu nedenle
                 ;; baslangic dusumunu bir slot eksik kur ve gercek rayi siraya oturt.
                 (* (max 0 (1- railSlotNo)) railGap)
                 (* railSlotNo railGap)))
            *degk-dispatch-rail-left-x* (if floorLeftRec (cdr floorLeftRec) nil)
             *degk-current-layout-row* floorRow
             *degk-current-layout-floor* floorNo
             ;; Layout kaydinda belirlenen fiziksel terminali DK:BASE'e aynen
            ;; aktar. DK:BASE ayni hatti tekrar tarayip komsu modulu secmesin.
            *degk-dispatch-terminal-source* terminalSourceObj
            ;; Bos terminal kolon semasindan secildiyse kaynak nesne aramadan
            ;; gercek kopya/anchor kaydini dogrudan DK:BASE'e aktar.
             *degk-dispatch-terminal-copy-rec* terminalCopyRec
             *degk-last-group-min-x* nil
            *degk-last-group-max-x* nil
            *degk-last-loop-left-points* nil
            *degk-last-loop-draw-record* nil
            *degk-last-copy-count* 0)
     (setq runRes (vl-catch-all-apply 'DK:BASE '()))
     (setq *degk-dispatch-sel* nil
           *degk-dispatch-loop-ents* nil
           *degk-dispatch-base* nil
           *degk-dispatch-loop-drop* nil
            *degk-dispatch-rail-left-x* nil
             *degk-current-layout-row* nil
             *degk-current-layout-floor* nil
             *degk-dispatch-terminal-source* nil
            *degk-dispatch-terminal-copy-rec* nil)
    (setq runSucceededP
      (and (not (vl-catch-all-error-p runRes))
           (numberp *degk-last-copy-count*)
           (> *degk-last-copy-count* 0)))
    (if (vl-catch-all-error-p runRes)
      (princ
        (strcat "\nDK: Bir polyline islenemedi, diger hatlara devam ediliyor: "
                (vl-catch-all-error-message runRes)))
    )
     (if runSucceededP
       (progn
         (if (not specialP)
           (setq *degk-panel-loop-count*
             (1+ (if (numberp *degk-panel-loop-count*) *degk-panel-loop-count* 0))))
         (if (and targetW (numberp (cadr targetW)))
            (progn
              (setq layoutRowYs (cons (cadr targetW) layoutRowYs))
              ;; Ozel looplar ayni kat etiketini ikinci kez uretmesin. Gercek
              ;; kat adi normal loopun SIRA_NO bilgisinden ve cizimdeki haliyle gelir.
              (if (and (not specialP) (numberp floorNo))
                (progn
                  (setq floorLabel
                    (degk--floor-label-from-sira (nth 9 rec)))
                  (setq floorLabelAnchors
                    (cons
                      (list floorNo floorLabel (cadr targetW))
                      floorLabelAnchors))))))
         (setq lastLoopLeftPoints *degk-last-loop-left-points*
               lastLoopDrawRecord *degk-last-loop-draw-record*)
         (if lastLoopLeftPoints
           (if (and (numberp floorNo) (= floorNo 0))
             (setq gfLoopLeftPoints
               (cons lastLoopLeftPoints gfLoopLeftPoints))
             (setq loopLeftPoints
               (cons lastLoopLeftPoints loopLeftPoints))))
         (if lastLoopDrawRecord
           (if (and (numberp floorNo) (= floorNo 0))
             (setq gfLoopDrawRecords
               (cons lastLoopDrawRecord gfLoopDrawRecords))
             (setq loopDrawRecords
               (cons lastLoopDrawRecord loopDrawRecords))))
         (if (and (null gfRoomAnchorW) gfRoomCandidateW)
           (setq gfRoomAnchorW gfRoomCandidateW))
         (if (and verticalP (null (assoc floorRow verticalFloorRows)))
           (progn
             (setq floorKey
               (if (and valid (numberp floorNo))
                 floorNo
                 (strcat "ROW_" (itoa floorRow))))
             (setq verticalFloorRows
               (cons (cons floorRow floorKey) verticalFloorRows))))
         (setq totalCopies (+ totalCopies *degk-last-copy-count*)
              groupIndex (1+ groupIndex))
         (if (numberp *degk-last-group-max-x*)
          (if (setq floorRightRec (assoc edgeKey floorRightEdges))
            (setq floorRightEdges
              (subst (cons edgeKey *degk-last-group-max-x*)
                     floorRightRec
                     floorRightEdges))
            (setq floorRightEdges
              (cons (cons edgeKey *degk-last-group-max-x*) floorRightEdges))
          )
        )
         (if (and (or (not verticalP) verticalPackedRowP)
                 (numberp *degk-last-group-min-x*)
                 (null (assoc floorRow floorLeftEdges)))
          (setq floorLeftEdges
            (cons (cons floorRow *degk-last-group-min-x*) floorLeftEdges))
        )
      )
      (progn
        ;; Blok kopyalamayan veya hata veren polyline bir sonraki gorunen loop
        ;; icin bos yatay ray/satir seviyesi ayirmasin.
        (setq floorCounts floorCountsBefore
              floorRailSlots floorRailSlotsBefore
              verticalCounts verticalCountsBefore
              verticalRow verticalRowBefore
              verticalPackedFloorRows verticalPackedFloorRowsBefore
              terminalUsedCopies terminalUsedCopiesBefore)
      )
    )
  )
  (setq *degk-last-combined-riser-limits* nil
        *degk-last-combined-riser-entities* nil)
  (setq haveBelowFloor nil
        haveAboveFloor nil)
  (foreach floorAnchor floorLabelAnchors
    (if (and (listp floorAnchor) (numberp (car floorAnchor)))
      (cond
        ((< (car floorAnchor) 0) (setq haveBelowFloor T))
        ((> (car floorAnchor) 0) (setq haveAboveFloor T)))))
  ;; Yalniz bir yonde kat varsa 2-3 loopta da saft dikmeleri olussun.
  ;; Alt ve ust kat birlikteyse ikinci/sondan-bir-onceki kurali korunur.
  (setq oneSidedRiserP
    (or (and haveBelowFloor (not haveAboveFloor))
        (and haveAboveFloor (not haveBelowFloor))))
  (setq riserFallbackMode
    (cond
      ((and haveBelowFloor
            (not haveAboveFloor)
            (= (length loopLeftPoints) 1)
            gfLoopLeftPoints)
        (list 'ONE_SIDE gfLoopLeftPoints))
      (oneSidedRiserP T)
      (T nil)))
  (if (and combinedRiserLayer loopLeftPoints)
    (if (degk--draw-combined-riser
          combinedRiserLayer loopLeftPoints
          riserFallbackMode)
      (princ
        (strcat
          "\nDK: Kolon semasi sol kombine hatti cizildi: "
          combinedRiserLayer))))
  (if (and combinedRiserLayer
           loopDrawRecords
           *degk-last-combined-riser-limits*)
    (setq loopDrawRecords
      (degk--square-outer-loop-records
        loopDrawRecords
        *degk-last-combined-riser-limits*
        T)))
  (setq riserLimits *degk-last-combined-riser-limits*
        riserEntities *degk-last-combined-riser-entities*)
  (setq *degk-last-combined-riser-limits* nil
        *degk-last-combined-riser-entities* nil)
  (if (and combinedRiserLayer gfLoopLeftPoints)
    (if (degk--draw-combined-riser
          combinedRiserLayer gfLoopLeftPoints 'GF)
      (princ
        (strcat
          "\nDK: GF kolon semasi kombine hatti cizildi: "
          combinedRiserLayer))))
  (setq gfRiserEntities *degk-last-combined-riser-entities*)
  (if (and combinedRiserLayer
           gfLoopDrawRecords
           (> (length gfLoopDrawRecords) 1)
           *degk-last-combined-riser-limits*)
    (setq gfLoopDrawRecords
      (degk--square-outer-loop-records
        gfLoopDrawRecords
        *degk-last-combined-riser-limits*
        (/= (length gfLoopDrawRecords) 2))))
  (setq gfRiserLimits *degk-last-combined-riser-limits*)
  ;; Normal looplar tamamlandiktan sonra monitorun kolon kopyasi bellidir.
  ;; Yardimci hatta temas eden karsi blocku monitorun 1000 mm sagina ekle.
  (setq monitorExtraCount
    (degk--place-monitor-linked-blocks monitorLinks))
  (if (not (numberp monitorExtraCount))
    (setq monitorExtraCount 0))
  (if (> monitorExtraCount 0)
    (progn
      (setq totalCopies (+ totalCopies monitorExtraCount))
      (princ
        (strcat "\nDK: Monitor yardimci hattindan eklenen block: "
                (itoa monitorExtraCount)))))
  (princ
    (strcat "\nDK: Alan islemi tamamlandi. Hat grubu: "
            (itoa groupIndex)
            ", toplam kopya: " (itoa totalCopies)))
  (setq usedRows
    (mapcar 'car (if verticalP verticalCounts floorCounts)))
  (setq usedRows
    (vl-sort usedRows (function (lambda (a b) (< a b)))))
  (setq gfFrameLoopCount
    (if verticalP
      (length
        (vl-remove-if-not
          '(lambda (row) (and (numberp (cdr row)) (= (cdr row) 0)))
          verticalFloorRows))
      (if gfRoomAnchorW 1 0)))
  (list groupIndex totalCopies usedRows
        (if verticalP verticalFloorRows nil)
        gfRoomAnchorW
        roomSourceBlocks
        combinedRiserLayer
        gfRiserLimits
        gfLoopDrawRecords
        gfRiserEntities
        gfFloorExtraRows
        gfFrameLoopCount
        layoutRowYs
        floorLabelAnchors
        loopDrawRecords
        riserLimits
        riserEntities)
)

(defun degk--siren-line-span (pts / pt leftX rightX lowY)
  (foreach pt pts
    (if (and (listp pt) (numberp (car pt)) (numberp (cadr pt)))
      (progn
        (if (or (null leftX) (< (car pt) leftX)) (setq leftX (car pt)))
        (if (or (null rightX) (> (car pt) rightX)) (setq rightX (car pt)))
        (if (or (null lowY) (< (cadr pt) lowY)) (setq lowY (cadr pt))))))
  (if lowY (list leftX rightX lowY) nil))

(defun degk--register-siren-underline (modules terminalRec ent pts layer
  / module anchor terminalEnt floorId)
  (progn
      (setq floorId
        (cond
          ((and (boundp '*degk-current-layout-row*) (numberp *degk-current-layout-row*))
            (list 'ROW *degk-current-layout-row*))
          ((and (boundp '*degk-current-layout-floor*) (numberp *degk-current-layout-floor*))
            (list 'FLOOR *degk-current-layout-floor*))))
      (if (and floorId ent)
        (setq *degk-siren-floor-rails*
          (cons (list floorId ent) *degk-siren-floor-rails*)))
      (if modules
        (progn
          (setq module (car modules) anchor (cdr (assoc 10 (entget module))))
          (if anchor
            (setq *degk-siren-underlines*
              (cons (list modules anchor pts layer floorId
                          (if (boundp '*degk-current-layout-floor*) *degk-current-layout-floor* nil))
                    *degk-siren-underlines*)))))
      (if (and terminalRec (car terminalRec))
        (progn
          (setq terminalEnt (vlax-vla-object->ename (car terminalRec)))
          (setq *degk-siren-branches*
            (cons (list terminalEnt ent pts) *degk-siren-branches*))))))

(defun degk--selected-ups-layer (areaSS combinedP / i name primary secondary)
  (setq i 0)
  (if areaSS
    (repeat (sslength areaSS)
      (setq name (cdr (assoc 8 (entget (ssname areaSS i)))) i (1+ i))
      (cond
        ((and name (= (strcase name) (if combinedP "E_UPS_MULTI_LINE" "E_UPS_LINE"))) (setq primary name))
        ((and name (= (strcase name) (if combinedP "E_UPS_LINYE_KOMBINE" "E_UPS_LINYE"))) (setq secondary name)))))
  (if primary primary secondary))

(defun degk--ups-riser-left-x (entities fallback / ent info leftX)
  (foreach ent entities
    (if (setq info (degk--vertical-riser-entity-info ent))
      (setq leftX (if leftX (min leftX (car info)) (car info)))))
  (if leftX leftX fallback))

(defun degk--extend-ups-target (target newX / ent ed vertices endpoint replacement)
  (setq ent (nth 3 target) ed (if ent (entget ent) nil))
  (if (and ed (= (cdr (assoc 0 ed)) "LWPOLYLINE"))
    (progn
      (setq vertices (vl-remove-if-not '(lambda (item) (= (car item) 10)) ed))
      (cond
        ((equal (cdr (car vertices)) (list (cadr target) (caddr target)) 1e-6)
          (setq endpoint (car vertices)))
        ((equal (cdr (last vertices)) (list (cadr target) (caddr target)) 1e-6)
          (setq endpoint (last vertices))))
      (if endpoint
        (progn
          (setq replacement (cons 10 (list newX (caddr target))))
          (if (entmod (subst replacement endpoint ed))
            (progn (entupd ent) T)))))))

(defun degk--fillet-ups-target (target busX radius direction endY / ent ed pts bulges item index firstP lastP tip tangent newPts newBulges data arc)
  (setq ent (nth 3 target) ed (if ent (entget ent) nil) index -1)
  (if (and ed (= (cdr (assoc 0 ed)) "LWPOLYLINE"))
    (progn
      (foreach item ed
        (cond
          ((= (car item) 10)
            (setq pts (append pts (list (cdr item)))
                  bulges (append bulges (list 0.0)) index (1+ index)))
          ((and (= (car item) 42) (>= index 0))
            (setq bulges (append (reverse (cdr (reverse bulges))) (list (cdr item)))))))
      (setq firstP (equal (car pts) (list (cadr target) (caddr target)) 1e-6)
            lastP (equal (last pts) (list (cadr target) (caddr target)) 1e-6)
            tip (list busX (if (numberp endY) endY (+ (caddr target) (* direction radius))))
            arc (if (> radius 1e-9) (* direction 0.414213562373095) 0.0)
            tangent (list (+ busX radius) (caddr target)))
      (cond
        (firstP
          (setq newPts (append (list tip tangent) (cdr pts))
                newBulges (cons arc bulges)))
        (lastP
          (setq newPts (append (reverse (cdr (reverse pts))) (list tangent tip))
                newBulges (append (reverse (cdr (reverse bulges)))
                  (list (- arc) 0.0)))))
      (if newPts
        (progn
          (if (and endY (listp endY) (= (length endY) 3)
                   (numberp (car endY)) (numberp (cadr endY)) (numberp (caddr endY)))
            (progn
              (setq tip (list busX (car endY)) tangent (list (cadr endY) (caddr endY)))
              (if firstP
                (setq newPts (append (list tangent tip) (cdr newPts))
                      newBulges (cons 0.414213562373095 newBulges))
                (setq newPts (append (reverse (cdr (reverse newPts))) (list tip tangent))
                      newBulges (append (reverse (cdr (reverse newBulges)))
                        (list -0.414213562373095 0.0))))))
          (setq data (vl-remove-if '(lambda (p) (member (car p) '(10 40 41 42 91 -3))) ed)
                data (subst (cons 90 (length newPts)) (assoc 90 data) data)
                index 0)
          (foreach item newPts
            (setq data (append data (list (cons 10 item) (cons 42 (nth index newBulges))))
                  index (1+ index)))
          (setq data (append data (vl-remove-if-not '(lambda (p) (= (car p) -3)) ed)))
          (if (entmod data) (progn (entupd ent) T)))))))

(defun degk--ups-cable-caption (cable count / pos)
  (if (and cable (setq pos (vl-string-search "X" (strcase cable))))
    (strcat (itoa count) "(3" (vl-string-right-trim ". " (substr cable (1+ pos))) ")")
    nil))

(defun degk--add-ups-cable-label (top endY / texts cable layer height run offset margin pt rec module modules)
  (setq texts (mapcar 'cdr *degk-ups-cable-texts*))
  ;; Ayni kolon kopyasi birden fazla kayitta yer alsa da bir kez sayilir.
  (foreach rec *degk-siren-underlines*
    (foreach module (car rec)
      (if (and (entget module) (not (member module modules)))
        (setq modules (cons module modules)))))
  (if (> (abs (- endY (cadr top))) 1e-9)
    (progn
      (setq cable (if (= (length texts) 1)
                    (degk--ups-cable-caption (car texts) (length modules)) nil)
            layer "e_loop_adý"
            height (DEG:CFG-DK-NUM-OR 'DK_LOOP_TEXT_HEIGHT 13.0)
            run (DEG:CFG-DK-NUM-OR 'DK_LOOP_LINE_RUN 300.0)
            offset (DEG:CFG-DK-NUM-OR 'DK_LOOP_TEXT_X_OFFSET 15.0)
            margin (DEG:CFG-DK-NUM-OR 'DK_LOOP_TEXT_Y_MARGIN 5.0)
            pt (list (car top) (/ (+ (cadr top) endY) 2.0) (caddr top)))
      (degk--ensure-loop-layer layer)
      (degk--entmake-lwpoly
        (list pt (list (+ (car pt) run) (cadr pt) (caddr pt))) layer nil)
      (degk--add-loop-intersection-mark
        pt (DEG:CFG-DK-NUM-OR 'DK_LOOP_MARK_LENGTH 10.0) layer)
      (degk--add-loop-text
        (list (+ (car pt) offset) (+ (cadr pt) margin) (caddr pt))
        cable layer height)))
  (cond
    ((> (length texts) 1)
      (princ "\nDK: Power supply etiketi: flasor layerinda birden fazla farkli kablo kesiti var."))
    ((null texts)
      (princ "\nDK: Power supply etiketi: flasor layerinda kablo kesiti yazisi bulunamadi."))))

(defun degk--draw-ups-feeds (top targets shaftX gfFireX layer gap verticalP / x y z turnY gf other target sides side busX minY maxY radius twoWay junctionRadius feedEndX direction branchRadius targetY targetX gfUpP extendedP levels topY previousY trimP targetLayer tails cutY contactY riserMaxY)
  (setq x (car top) y (cadr top) z (caddr top)
        turnY (+ y (* 180.0 (DEG:PLAN-UNIT-SCALE))))
  (foreach target targets
    (if (= (car target) 0)
      (setq gf (cons target gf))
      (setq other (cons target other))))
  (setq twoWay (and gf other))
  ;; Dik GF'nin ilk (en alt) UPS satiri, iki yatay kolun ortak seviyesidir.
  (if (and verticalP gf)
    (setq turnY (apply 'min (mapcar 'caddr gf))))
  (if other (setq sides (cons (list -1.0 (- shaftX gap) other) sides)))
  (if gf
    (setq sides
      (cons (list 1.0
        (if (numberp gfFireX)
          (- gfFireX gap)
          (max (+ x gap) (- (apply 'min (mapcar 'cadr gf)) gap))) gf) sides)))
  (if sides
    (progn
      (degk--ensure-layer-editable layer)
      (setq radius (if twoWay (max 0.0 (min gap (- turnY y)
        (apply 'min (mapcar '(lambda (s) (abs (- (cadr s) x))) sides)))) 0.0))
      (degk--entmake-lwpoly
        (list top (list x (- turnY radius) z)) layer 256)
      (degk--add-ups-cable-label top (- turnY radius))
      (foreach side sides
        (setq busX (cadr side) minY turnY maxY turnY)
        (foreach target (caddr side)
          (setq minY (min minY (caddr target)) maxY (max maxY (caddr target))))
        (setq gfUpP (and verticalP (> (car side) 0.0)
                           (equal minY turnY 1e-9) (> maxY turnY))
              junctionRadius
          (max 0.0 (min gap (if gfUpP gap (- turnY minY)) (- maxY turnY)
            (max 0.0 (- (abs (- busX x)) radius))))
              feedEndX (- busX (* (car side) junctionRadius)))
        (setq levels (vl-sort (mapcar 'caddr (caddr side)) '> )
              topY (car levels) previousY (cadr levels)
              trimP (and previousY (> topY turnY) (>= previousY turnY))
              tails nil cutY nil riserMaxY maxY)
        (foreach target (caddr side)
          (if (equal (caddr target) topY 1e-9)
            (progn
              (setq targetLayer (cdr (assoc 8 (entget (nth 3 target)))))
              (if (or (null targetLayer)
                      (member (strcase targetLayer) '("E_UPS_MULTI_LINE" "E_UPS_LINYE_KOMBINE")))
                (setq trimP nil)))))
        (if (> radius 1e-9)
          (degk--entmake-lwpoly-bulges
            (list (list x (- turnY radius) z)
                  (list (+ x (* (car side) radius)) turnY z)
                  (list feedEndX turnY z))
            (list (* -0.414213562373095 (car side)) 0.0 0.0) layer 256)
          (degk--entmake-lwpoly
            (list (list x turnY z) (list feedEndX turnY z)) layer 256))
        ;; Iki yone devam eden kolonun girisinde ust ve alt yay ayri olusur.
        (if (and (> junctionRadius 1e-9) (not gfUpP))
          (foreach direction (if gfUpP '(1.0) '(-1.0 1.0))
            (degk--entmake-lwpoly-bulges
              (list (list feedEndX turnY z)
                    (list busX (+ turnY (* direction junctionRadius)) z))
              (list (* (car side) direction 0.414213562373095) 0.0) layer 256)))
        (foreach target (caddr side)
          (setq targetX (cadr target) targetY (caddr target)
                direction (if (> targetY turnY) -1.0 1.0)
                branchRadius
                  (if (or (equal targetY minY 1e-9) (equal targetY maxY 1e-9)
                          (equal targetY turnY 1e-9))
                    0.0
                    (max 0.0 (min gap (- targetX busX) (abs (- targetY turnY))))))
          (if (and trimP (equal targetY topY 1e-9))
            (setq tails (cons target tails) extendedP T)
            (progn
          (setq extendedP
            (if (> branchRadius 1e-9)
              (degk--fillet-ups-target target busX branchRadius direction nil)
              (degk--extend-ups-target target
                (if (equal targetY turnY 1e-9) feedEndX busX))))
          (if (and trimP extendedP (equal targetY previousY 1e-9))
            (progn
              (setq contactY (if (equal targetY turnY 1e-9)
                               (+ turnY junctionRadius)
                               (+ targetY (* direction branchRadius))))
              (setq cutY (if cutY (max cutY contactY) contactY))))))
          (if (not extendedP)
            (princ "\nDK: UPS yatay uc birlesimi uygulanamadi.")))
        (if tails
          (progn
            (setq extendedP T)
            (foreach target tails
              (if (not (if (numberp cutY)
                         (degk--fillet-ups-target target busX 0.0 -1.0
                           (if (and gfUpP (> junctionRadius 1e-9)
                                    (equal cutY (+ turnY junctionRadius) 1e-9))
                             (list cutY feedEndX turnY) cutY))
                         (degk--extend-ups-target target busX)))
                (setq extendedP nil)))
            (if (and extendedP (numberp cutY)) (setq riserMaxY cutY))))
        (if (> junctionRadius 1e-9)
          (progn
            (if (> (- turnY junctionRadius minY) 1e-9)
              (degk--entmake-lwpoly
                (list (list busX minY z) (list busX (- turnY junctionRadius) z)) layer 256))
            (if (> (- riserMaxY turnY junctionRadius) 1e-9)
              (if gfUpP
                (degk--entmake-lwpoly-bulges
                  (list (list feedEndX turnY z)
                        (list busX (+ turnY junctionRadius) z) (list busX riserMaxY z))
                  '(0.414213562373095 0.0 0.0) layer 256)
                (degk--entmake-lwpoly
                  (list (list busX (+ turnY junctionRadius) z) (list busX riserMaxY z)) layer 256))))
          (if (> (- riserMaxY minY) 1e-9)
            (degk--entmake-lwpoly
              (list (list busX minY z) (list busX riserMaxY z)) layer 256)))))))

(defun degk--draw-room-ups-feeds (targets layer gap / obj ent bb mn mx)
  (if (and targets layer (boundp '*degk-ups-source*) *degk-ups-source*)
    (progn
      (setq obj (car *degk-ups-source*)
            ent (vlax-vla-object->ename obj)
            bb (degk--column-frame-block-visible-bbox ent))
      (if (null bb) (setq bb (degk--ent-bbox obj)))
      (if bb
        (progn
          (setq mn (car bb) mx (cadr bb))
          (degk--draw-ups-feeds
            (list (/ (+ (car mn) (car mx)) 2.0) (cadr mx) (if (caddr mx) (caddr mx) 0.0))
            targets (cadr *degk-ups-source*) (nth 2 *degk-ups-source*) layer gap
            (nth 3 *degk-ups-source*)))))))

(defun degk--draw-siren-underlines (areaSS / rec modules anchor current dy pts span branch
  branchPts item ed branchSpan xMin xMax lowY gap layer z module base dropX drops lastDrop joinX floorRail floorLevels floorSpan floorId floorLevel dropRadius upsLayer upsCombinedLayer feedTargets feedTarget feedEnt)
  ;; Son GF hizalamalarindan sonra ciz: satirlarin tasinmasi hesaba katilir.
  (setq gap (abs (DEG:CFG-DK-NUM-OR 'DK_UNDER_X2 10.0))
        upsLayer (degk--selected-ups-layer areaSS nil)
        upsCombinedLayer (degk--selected-ups-layer areaSS T))
  (if (<= gap 1e-9) (setq gap (* 10.0 (DEG:PLAN-UNIT-SCALE))))
  ;; Yatayda kat, dikte paketlenmis satir: SM olmayan looplar da hesaba katilir.
  (foreach floorRail *degk-siren-floor-rails*
    (setq pts nil)
    (foreach item (entget (cadr floorRail))
      (if (= (car item) 10) (setq pts (cons (cdr item) pts))))
    (if (setq floorSpan (degk--siren-line-span pts))
      (progn
        (setq floorId (car floorRail) floorLevel (assoc floorId floorLevels))
        (if floorLevel
          (setq floorLevels (subst (cons floorId (min (cdr floorLevel) (caddr floorSpan))) floorLevel floorLevels))
          (setq floorLevels (cons (cons floorId (caddr floorSpan)) floorLevels))))))
  (foreach rec *degk-siren-underlines*
    (setq modules (car rec) anchor (cadr rec)
          current (cdr (assoc 10 (entget (car modules)))))
    (if current
      (progn
        (setq dy (- (cadr current) (cadr anchor))
              pts (degk--shift-point-list-y (nth 2 rec) dy)
              span (degk--siren-line-span pts)
              xMin (car span) xMax (cadr span) lowY (caddr span)
              layer (if upsLayer upsLayer (nth 3 rec)) z (if (caddr current) (caddr current) 0.0))
        (foreach branch *degk-siren-branches*
          (if (member (car branch) modules)
            (progn
              (setq ed (entget (cadr branch)) branchPts nil)
              (if ed
                (foreach item ed
                  (if (= (car item) 10) (setq branchPts (cons (cdr item) branchPts))))
                (setq branchPts (degk--shift-point-list-y (nth 2 branch) dy)))
              (setq branchSpan (degk--siren-line-span branchPts))
              (if branchSpan
                (setq xMin (min xMin (car branchSpan))
                      xMax (max xMax (cadr branchSpan))
                      lowY (min lowY (caddr branchSpan)))))))
        (if (setq floorLevel (assoc (nth 4 rec) floorLevels))
          (setq lowY (cdr floorLevel)))
        (setq drops nil xMax nil)
        (foreach module modules
          (setq base (cdr (assoc 10 (entget module))))
          (if base
            (progn
              (setq dropX (- (car base) gap)
                    xMin (min xMin dropX)
                    xMax (if xMax (max xMax dropX) dropX))
              (if (not (member (list dropX (cadr base)) drops))
                (setq drops (cons (list dropX (cadr base)) drops))))))
        (if (and span xMax (> xMax xMin))
          (progn
            (degk--ensure-layer-editable layer)
            (setq drops (vl-sort drops '(lambda (a b) (> (car a) (car b))))
                  lastDrop (car drops)
                  joinX xMin)
            (if (cdr drops)
              (progn
                (setq base (cadr drops)
                      dropRadius (max 0.0 (min gap (- (cadr base) lowY) (- (car base) xMin)))
                      joinX (- (car base) dropRadius))))
            ;; Son dik ve yatay donusu tek polyline olarak birlestir.
            (degk--entmake-lwpoly
              (list (list (car lastDrop) (cadr lastDrop) z)
                    (list (car lastDrop) lowY z)
                    (list joinX lowY z))
              layer 256)
            (setq feedEnt (entlast))
            (if (> joinX xMin)
              (progn
                (degk--ensure-layer-editable (if upsCombinedLayer upsCombinedLayer layer))
                (degk--entmake-lwpoly
                  (list (list xMin lowY z) (list joinX lowY z))
                  (if upsCombinedLayer upsCombinedLayer layer) 256)
                (setq feedEnt (entlast))))
            (if (numberp (nth 5 rec))
              (setq feedTargets
                (cons (list (nth 5 rec) xMin lowY feedEnt) feedTargets)))
            (foreach base (cdr drops)
              (setq dropRadius
                (max 0.0 (min gap (- (cadr base) lowY) (- (car base) xMin))))
              (if (> dropRadius 1e-9)
                (degk--entmake-lwpoly-bulges
                  (list (list (car base) (cadr base) z)
                        (list (car base) (+ lowY dropRadius) z)
                        (list (- (car base) dropRadius) lowY z))
                  '(0.0 -0.414213562373095 0.0) layer 256)
                (degk--entmake-lwpoly
                  (list (list (car base) (cadr base) z)
                        (list (car base) lowY z))
                  layer 256))))))))
  (degk--draw-room-ups-feeds feedTargets (if upsCombinedLayer upsCombinedLayer upsLayer) gap))

(defun DK:BASE
  (/ tol sel ent plEnt loopEnts plStart plEnd pickPt useFromStart
     ss i e blkObj touched ordered totalLen ins pair dist key
     basePt baseU tmp
     sira siraList idx copyObj fromPt
     curTargetU baseW dY
     siraOne
     plLayer plColor
     allPts thisPts lastPt eps groupBounds loopLeftPoints loopRawPts loopFilletData loopBulges loopEndDirection loopDrawBefore loopDrawEnt loopDrawRes
      txtLayer blkInsBefore dkkState loopText loopDrop railLeftX labelPts
      terminalModule terminalCandidates terminalRec terminalAnchor terminalClearance terminalLinkY moduleRec copyLayoutInfo copyFloor sirenCopies)

  (vl-load-com)
  (setq *degk-last-copy-count* 0
        *degk-last-group-min-x* nil
        *degk-last-group-max-x* nil
        *degk-last-loop-left-points* nil
        *degk-last-loop-draw-record* nil)
   (setq tol (DEG:CFG-TOL-NUM-OR 'DN_BLOCK_TOL 1.0))
   (setq eps 1e-6)
   (setq loopDrop
     (if (and (boundp '*degk-dispatch-loop-drop*)
              (numberp *degk-dispatch-loop-drop*)
              (> *degk-dispatch-loop-drop* 0.0))
       *degk-dispatch-loop-drop*
       0.0))
   (setq railLeftX
     (if (and (boundp '*degk-dispatch-rail-left-x*)
              (numberp *degk-dispatch-rail-left-x*))
       *degk-dispatch-rail-left-x*
       nil))
  (setq txtLayer (DEG:VAL 'O1))
  (degk--ensure-layer-editable txtLayer)
  (degk--ensure-layer-editable (DEG:VAL 'O2))

  (setq *degk-attsync-names* nil)

  (if (and (boundp '*degk-dispatch-sel*) *degk-dispatch-sel*)
    (progn (setq sel *degk-dispatch-sel*) (setq *degk-dispatch-sel* nil))
    (setq sel (entsel "\nDK: Polyline seç: ")))
  (if (null sel)
    (progn (princ "\n\nDEGK iptal.") (princ))
    (progn
      (setq ent (car sel))
      (setq pickPt (cadr sel))
      (setq plEnt ent)
      (setq loopEnts
        (if (and (boundp '*degk-dispatch-loop-ents*)
                 *degk-dispatch-loop-ents*)
          *degk-dispatch-loop-ents*
          (list plEnt)))

      (if (not (degk--curve-ok? plEnt))
        (progn (princ "\n\nSeçilen nesne curve deðil (Polyline/LWPolyline seçmelisin).") (princ))
        (progn
          (setq plLayer (cdr (assoc 8 (entget plEnt))))
          (setq plColor (degk--color-dxfs-from-entity plEnt plLayer))
          (if (and plLayer (/= (strcase plLayer) "0"))
            (degk--ensure-layer-editable plLayer)
          )

          (setq plStart (vlax-curve-getStartPoint plEnt))
          (setq plEnd   (vlax-curve-getEndPoint   plEnt))

          (setq totalLen (vlax-curve-getDistAtParam plEnt (vlax-curve-getEndParam plEnt)))
(if (and (boundp '*degk-dispatch-base*) *degk-dispatch-base*)
  (progn
    (setq basePt *degk-dispatch-base*
          *degk-dispatch-base* nil)
  )
  (progn
    (setq tmp (vl-catch-all-apply 'getpoint
                                  (list "\nDK: Kopyalarin yerlesecegi baslangic noktasini sec: ")))
    (setq basePt (if (vl-catch-all-error-p tmp) nil tmp))
  )
)
(if (null basePt)
            (progn (princ "\n\nDEGK iptal.") (princ))
            (progn
              (setq baseU (trans basePt 0 1))

              (setq ss
                (if (and (boundp '*degk-dispatch-loop-ents*) *degk-dispatch-loop-ents*
                         (boundp '*degk-source-insert-snapshot*) *degk-source-insert-snapshot*)
                  *degk-source-insert-snapshot*
                  (ssget "_X" '((0 . "INSERT")))))
              (setq touched '()
                    terminalCandidates '())
              (if ss
                (progn
                  (setq i 0)
                  (while (< i (sslength ss))
                    (setq e (ssname ss i))
                    (setq blkObj (vlax-ename->vla-object e))
                    (if (degk--source-block-eligible-p blkObj)
                      (progn
                        (if (degk--block-touches-loop-p loopEnts blkObj tol)
                          (progn
                            (setq touched (cons blkObj touched))
                            (degk--attsync-add blkObj)))
                        (if (and (degk--flasher-loop-layer-p plLayer)
                                 (degk--flasher-terminal-module-p blkObj)
                                 (degk--flasher-terminal-touches-loop-p
                                   loopEnts blkObj tol))
                          (setq terminalCandidates
                            (cons blkObj terminalCandidates)))
                      )
                    )
                    (setq i (1+ i))
                  )
                )
              )

              ;; Flasor/strobe hattinin temas ettigi kontrol modulunu, daha once
              ;; ana loopta yapistirilan kopyasiyla eslestir. Eslesme varsa modul
              ;; bu loopta tekrar kopyalanmaz. Loop sagdaki son loop hizasinda
              ;; kalir; modulden loopa ayri bir dik/ortogonal baglanti eklenir.
              (if (degk--flasher-loop-layer-p plLayer)
                (progn
                  (setq terminalModule
                    (cond
                      ((and (boundp '*degk-dispatch-terminal-source*)
                            *degk-dispatch-terminal-source*
                            (= (type *degk-dispatch-terminal-source*) 'VLA-OBJECT))
                        *degk-dispatch-terminal-source*)
                      (terminalCandidates
                        (degk--flasher-terminal-from-touched
                          plEnt terminalCandidates tol))
                      (T nil))
                    terminalRec
                      (cond
                        ((and (boundp '*degk-dispatch-terminal-copy-rec*)
                              *degk-dispatch-terminal-copy-rec*)
                          *degk-dispatch-terminal-copy-rec*)
                        (terminalModule
                          (degk--area-module-copy-get
                            terminalModule
                            (if (and (boundp '*degk-current-layout-floor*)
                                     (numberp *degk-current-layout-floor*))
                              *degk-current-layout-floor*
                              nil)))
                        (T nil))
                    terminalAnchor
                      (if (and terminalRec (cadr terminalRec))
                        (cadr terminalRec)
                        nil))
                  (if terminalModule
                    (if terminalAnchor
                      (princ
                        (strcat
                          "\nDK: Flasor kontrol modulu ve kolon kopyasi eslesti: "
                          (if (degk--blockname terminalModule)
                            (degk--blockname terminalModule)
                            "<MODULE>")))
                      (princ
                        (strcat
                          "\nDK: Flasor kontrol modulu bulundu; kolon kopyasi bulunamadi: "
                          (if (degk--blockname terminalModule)
                            (degk--blockname terminalModule)
                            "<MODULE>"))))
                  )
                  (if terminalAnchor
                    (progn
                      (setq
                        ;; 100 mm = 10 cm. PLAN birimine gore olceklenir.
                        terminalClearance
                          (* 10.0 (DEG:PLAN-UNIT-SCALE))
                        railLeftX nil)
                    )
                  )
                )
              )

              ;; Kontrol modulleri flasor hattinin terminal hedefidir; loop
              ;; cihazlari degildir. Alan temasi veya base temasi nasil
              ;; bulunursa bulunsun hicbiri kopya cihaz listesinde kalmaz.
              (if (degk--flasher-loop-layer-p plLayer)
                (setq touched
                  (vl-remove-if 'degk--flasher-terminal-module-p touched)))

              (if (null touched)
                (progn (princ "\n\nDK: ayarlanan temas toleransi icinde polyline’a degen blok yok.") (princ))
                (progn
      (setq totalLen (vlax-curve-getDistAtParam plEnt (vlax-curve-getEndParam plEnt)))
      (setq useFromStart (degk--use-from-lower-sira-side plEnt touched totalLen))
      (setq ordered '())
      (foreach blkObj touched
        (setq ins  (deg-get-inspt blkObj))
        (setq dist (degk--dist-along plEnt ins))
        (setq key
          (if (> (length loopEnts) 1)
            (degk--block-loop-order-key blkObj loopEnts)
            (if useFromStart dist (- totalLen dist))))
        (setq ordered (cons (cons key blkObj) ordered))
      )
      (setq ordered (vl-sort ordered '(lambda (a b) (< (car a) (car b)))))
      (if (and (degk--flasher-loop-layer-p plLayer)
               (null terminalAnchor))
        (setq ordered (degk--flasher-module-last ordered))
      )

      (setq idx 0)
      (setq allPts '())
      (setq lastPt nil)
      (setq loopText nil)

      (foreach pair ordered
        (setq blkObj (cdr pair))
        (setq sira (degk--get-att blkObj "SIRA_NO"))
        (setq siraList (degk--expand-sira-no sira))
        (if (or (null siraList) (= (length siraList) 0))
          (setq siraList (list sira))
        )
        (setq siraList (degk--limit-sira-list siraList))

        (foreach siraOne siraList
          (setq siraOne (degk--clean-text siraOne))
          (setq copyLayoutInfo (degk--layout-key-from-sira siraOne)
                copyFloor
                  (if copyLayoutInfo
                    (car copyLayoutInfo)
                    (if (and (boundp '*degk-current-layout-floor*)
                             (numberp *degk-current-layout-floor*))
                      *degk-current-layout-floor*
                      nil)))
          (if (and (or (null loopText) (= loopText "")) (/= siraOne ""))
            (setq loopText (degk--loop-name-from-sira siraOne))
          )
          (setq dkkState
            (if (degkk--active-p)
              (degkk--normal-occurrence-state blkObj siraOne)
              'NEW))

          ;; DKK ayni modul sembolunu tek kopyada topladiginda, bu kaynak
          ;; modulun handle'ini da temsilci kopyanin temas noktasina bagla.
          (if (and (eq dkkState 'DUPLICATE)
                   (not (degk--flasher-loop-layer-p plLayer))
                   (degk--column-anchor-module-p blkObj)
                   (setq moduleRec
                     (degk--area-module-symbol-get
                       blkObj
                       (if (and (boundp '*degk-current-layout-floor*)
                                (numberp *degk-current-layout-floor*))
                         *degk-current-layout-floor*
                         copyFloor))))
            (degk--area-module-copy-put
              blkObj
              (car moduleRec)
              (cadr moduleRec)
              (nth 2 moduleRec)
              (nth 3 moduleRec))
          )

          (if (and (eq dkkState 'NEW)
                   (not (DEG:IGNORE-BLOCK-OBJ? blkObj)))
            (progn
              (setq curTargetU (list (+ (car baseU) (* idx (DEG:CFG-DK-NUM-OR 'DK_COPY_SPACING 100.0))) (cadr baseU) 0.0))
              (setq baseW (trans curTargetU 1 0))
              (if (degk--copy-dk-block-safe blkObj baseW siraOne)
                (progn
                  (if (and (not (degk--flasher-loop-layer-p plLayer))
                           (or (degk--flasher-terminal-module-p blkObj)
                               (degk--flasher-terminal-module-p *DEG_DK_LAST_COPY_OBJ*)))
                    (setq sirenCopies
                      (cons (vlax-vla-object->ename *DEG_DK_LAST_COPY_OBJ*) sirenCopies)))
                  (if (degkk--active-p)
                    (degkk--register-normal-copy blkObj *DEG_DK_LAST_COPY_OBJ*)
                  )
                  (if (and
                        (not (degk--flasher-loop-layer-p plLayer))
                        ;; Dinamik/anonim kaynak adi bazi cizimlerde terminal
                        ;; filtresinden kacabiliyor. Kopyanin gercek adi terminal
                        ;; ise yine kolon terminal haritasina mutlaka kaydet.
                        (or (degk--column-anchor-module-p blkObj)
                            (and *DEG_DK_LAST_COPY_OBJ*
                                 (= (type *DEG_DK_LAST_COPY_OBJ*) 'VLA-OBJECT)
                                 (degk--column-anchor-module-p
                                   *DEG_DK_LAST_COPY_OBJ*))))
                    (degk--area-module-copy-put
                      blkObj
                      *DEG_DK_LAST_COPY_OBJ*
                      (degk--under-top-pt baseW)
                      (if (and (boundp '*degk-current-layout-row*)
                               (numberp *degk-current-layout-row*))
                        *degk-current-layout-row*
                        nil)
                      ;; Modulun kolon semasindaki gercek kati, kendi eksik
                      ;; veya hatali SIRA_NO'su degil islenen normal loopun katidir.
                      (if (and (boundp '*degk-current-layout-floor*)
                               (numberp *degk-current-layout-floor*))
                        *degk-current-layout-floor*
                        copyFloor))
                  )
                  (setq thisPts
                    (degk--drop-under-rail-pts
                      (degk--under-pts
                        baseW
                        (DEG:CFG-DK-NUM-OR 'DK_UNDER_X1 10.0)
                        (DEG:CFG-DK-NUM-OR 'DK_UNDER_X2 10.0)
                        (DEG:CFG-DK-NUM-OR 'DK_UNDER_W 70.0)
                        (DEG:CFG-DK-NUM-OR 'DK_UNDER_H 60.0))
                      loopDrop))

                  (if (null allPts)
                    (setq allPts thisPts)
                    (progn
                      (if (degk--pt-eq? lastPt (car thisPts) eps)
                        (setq allPts (append allPts (cdr thisPts)))
                        (setq allPts (append allPts thisPts))
                      )
                    )
                  )
                  (setq lastPt (car (last thisPts)))
                  (setq idx (1+ idx))
                  ;; Bu monitorun sagina yardimci hattan bulunan ek cihaz
                  ;; sonradan yerlestirilecek. Sonraki normal blocku bir yuva
                  ;; daha saga al: monitor -> ek cihaz 1000 mm, monitor ->
                  ;; sonraki normal block 2000 mm; devam edenler yine 1000 mm.
                  (if (and
                        (boundp '*degk-monitor-linked-source-handles*)
                        *degk-monitor-linked-source-handles*
                        (degk--monitor-module-p blkObj)
                        (member
                          (strcase (degkk--object-handle blkObj))
                          *degk-monitor-linked-source-handles*))
                    (setq idx (1+ idx)))
                )
              )
            )
          )
        )
      )

      (setq loopText (or (degk--source-loop-title loopEnts) loopText))
      (if (and allPts (> (length allPts) 1) (deg-layerE-str-p plLayer) (/= (strcase plLayer) "0"))
        (progn
          (if (degk--flasher-loop-layer-p plLayer)
            (progn
              ;; Baslik eski kapali geometrinin baslangicinda kalir; cizilecek
              ;; ozel loop ise son blok temasinda acik olarak biter.
              (setq labelPts
                (degk--close-under-pts
                  allPts
                  (DEG:CFG-DK-NUM-OR 'DK_UNDER_X2 10.0)))
              (degk--add-loop-label labelPts loopText T (degk--source-cable-text loopEnts loopText))
              (setq allPts (degk--trim-at-last-block-contact allPts))
            )
            (progn
              (setq allPts
                (degk--close-under-pts
                  allPts
                  (DEG:CFG-DK-NUM-OR 'DK_UNDER_X2 10.0)))
              ;; Etiket kendi loopunun mevcut baslangicinda kalir.
              (degk--add-loop-label allPts loopText nil (degk--source-cable-text loopEnts loopText))
              (if railLeftX
                (setq allPts (degk--extend-under-rails-left allPts railLeftX))
              )
            )
          )
          (if terminalAnchor
            (progn
              (setq terminalLinkY (degk--pts-min-y allPts))
              (if (numberp terminalLinkY)
                (progn
                  (setq terminalLinkY (- terminalLinkY terminalClearance)
                        allPts
                          (degk--move-lowest-rail-to-y
                            allPts
                            terminalLinkY)
                        allPts
                          (degk--prepend-flasher-module-link
                            allPts
                            terminalAnchor
                            terminalLinkY))
                )
              )
            )
          )
          ;; GF altindaki bodrum katlarinda fillet uclari yukari; GF ve
          ;; ustundeki katlarda asagi bakar. Yay yaricapi Sag Ofset degeridir.
          (setq loopRawPts allPts
                loopEndDirection
            (if (and (boundp '*degk-current-layout-floor*)
                     (numberp *degk-current-layout-floor*)
                     (< *degk-current-layout-floor* 0.0))
              1.0
              -1.0)
            loopFilletData
              (degk--loop-left-fillet-data
                allPts
                (DEG:CFG-DK-NUM-OR 'DK_UNDER_X2 10.0)
                loopEndDirection))
          (if loopFilletData
            (setq allPts     (car loopFilletData)
                  loopBulges (cadr loopFilletData)))
          (setq groupBounds (degk--pts-x-bounds allPts))
          (if groupBounds
            (setq *degk-last-group-min-x*
                    (if (and loopFilletData
                             (numberp (nth 3 loopFilletData)))
                      (nth 3 loopFilletData)
                      (car groupBounds))
                  *degk-last-group-max-x* (cadr groupBounds)
                  loopLeftPoints
                    (if (and loopFilletData (nth 2 loopFilletData))
                      (nth 2 loopFilletData)
                      (degk--pts-at-x allPts (car groupBounds) 1e-6))
                  *degk-last-loop-left-points* loopLeftPoints)
          )
          (setq loopDrawBefore (entlast)
                loopDrawRes
                  (if loopBulges
                    (degk--entmake-lwpoly-bulges allPts loopBulges plLayer plColor)
                    (degk--entmake-lwpoly allPts plLayer plColor))
                loopDrawEnt (entlast))
          (if (and loopDrawRes loopDrawEnt (not (eq loopDrawBefore loopDrawEnt)))
            (degk--register-siren-underline
              sirenCopies terminalRec loopDrawEnt loopRawPts plLayer))
          (if (and loopFilletData
                   loopDrawRes
                   loopDrawEnt
                   (not (eq loopDrawBefore loopDrawEnt)))
            (setq *degk-last-loop-draw-record*
              (list loopDrawEnt allPts loopBulges plLayer plColor
                    loopRawPts loopEndDirection)))
        )
      )

      (degk--attsync-run)
      (setq *degk-last-copy-count* idx)
      (princ (strcat "\nDK: Yerleþtirilen toplam kopya: " (itoa idx)))
    )
  )
  (princ)
)



)
