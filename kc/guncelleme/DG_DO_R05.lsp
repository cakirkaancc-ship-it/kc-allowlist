(defun DEGP--dp-data-line-layers (/ out selected)
  (setq out
    (DEGP--merge-layer-lists
      (DEG:VALS '(C1 C2))
      (DEG:CFG-LIST 'DP_DATA_LINE_LAYERS)))
  (setq selected
    (if (and (boundp '*DEGP_DP_DATA_SELECTED_LAYER*)
             *DEGP_DP_DATA_SELECTED_LAYER*)
      *DEGP_DP_DATA_SELECTED_LAYER*
      ""))
  (if (and (/= selected "")
           (not (DEGP--data-comb-like-layer-p selected)))
    (setq out (DEGP--layer-list-add-unique out selected))
  )
  out
)

(defun DEGP--dp-data-comb-layers (/ out selected)
  (setq out
    (DEGP--merge-layer-lists
      (DEG:VALS '(C3 C4))
      (DEG:CFG-LIST 'DP_DATA_COMB_LAYERS)))
  (setq selected
    (if (and (boundp '*DEGP_DP_DATA_SELECTED_LAYER*)
             *DEGP_DP_DATA_SELECTED_LAYER*)
      *DEGP_DP_DATA_SELECTED_LAYER*
      ""))
  (if (and (/= selected "")
           (DEGP--data-comb-like-layer-p selected))
    (setq out (DEGP--layer-list-add-unique out selected))
  )
  out
)

