        (if (and (vlax-property-available-p blkObj 'DynamicBlockTableRecord)
                 (= :vlax-true (vla-get-IsDynamicBlock blkObj)))
          (progn
            (setq dyn (vla-get-DynamicBlockTableRecord blkObj))
