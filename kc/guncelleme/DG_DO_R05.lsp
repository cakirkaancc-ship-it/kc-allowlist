(defun DEG:LEGACY-SETTINGS-FILE ()
  (strcat (getenv "TEMP") "\\DEG_DO_SETTINGS.lsp")
)

(defun DEG:PROGRAM-DATA-ROOT (/ base)
  (setq base (getenv "ProgramData"))
  (if (or (null base) (= (vl-string-trim " \t\r\n" base) ""))
    (setq base "C:\\ProgramData"))
  base
)

(defun DEG:USER-DATA-ROOT (/ base)
  (setq base (getenv "LOCALAPPDATA"))
  (if (or (null base) (= (vl-string-trim " \t\r\n" base) ""))
    (setq base (getenv "APPDATA")))
  (if (or (null base) (= (vl-string-trim " \t\r\n" base) ""))
    (setq base (getenv "TEMP")))
  base
)

(defun DEG:TRY-DATA-DIR (dir / made probe file)
  (if dir
    (progn
      (if (vl-file-directory-p dir)
        (setq made T)
        (setq made
          (not (vl-catch-all-error-p
                 (vl-catch-all-apply 'vl-mkdir (list dir))))))
      (if (and made (vl-file-directory-p dir))
        (progn
          (setq probe (strcat dir "\\write_test_" (itoa (getvar "MILLISECS")) ".tmp")
                file (open probe "w"))
          (if file
            (progn
              (write-line "DEG" file)
              (close file)
              (vl-catch-all-apply 'vl-file-delete (list probe))
              dir))))))
)

(defun DEG:DATA-DIR (/ dir)
  (if (not *DEG_DATA_DIR_CHECKED*)
    (progn
      (setq *DEG_DATA_DIR_CHECKED* T
            *DEG_DATA_DIR* nil)
      ;; DO ayarlari bilgisayardaki diger Windows kullanicilariyla karismasin.
      (setq dir (DEG:USER-DATA-ROOT))
      (if dir (setq *DEG_DATA_DIR* (DEG:TRY-DATA-DIR (strcat dir "\\DEG"))))
      ;; Kullanici profili yazilamazsa eski ortak konum yedek olarak kalir.
      (if (not *DEG_DATA_DIR*)
        (setq *DEG_DATA_DIR*
          (DEG:TRY-DATA-DIR (strcat (DEG:PROGRAM-DATA-ROOT) "\\DEG"))))))
  *DEG_DATA_DIR*
)

(defun DEG:RUNTIME-FILE (name / dir base)
  (setq dir (DEG:DATA-DIR))
  (if dir
    (strcat dir "\\" name)
    (progn
      (setq base
        (cond
          ((getenv "TEMP"))
          ((getenv "LOCALAPPDATA"))
          ((getenv "APPDATA"))
          (T "C:\\Windows\\Temp")))
      (strcat base "\\" name)))
)

(defun DEG:OLD-SETTINGS-FILES (/ bases out base oldFile directFile)
  (setq out
    (list (strcat (DEG:PROGRAM-DATA-ROOT) "\\DEG\\DEG_DO_SETTINGS.lsp")))
  (setq bases (list (getenv "LOCALAPPDATA") (getenv "APPDATA") (getenv "TEMP")))
  (foreach base bases
    (if (and base (/= base ""))
      (progn
        (setq oldFile (strcat base "\\DEG\\DEG_DO_SETTINGS.lsp")
              directFile (strcat base "\\DEG_DO_SETTINGS.lsp"))
        (if (not (member oldFile out)) (setq out (append out (list oldFile))))
        (if (not (member directFile out)) (setq out (append out (list directFile)))))))
  out
)

(defun DEG:SETTINGS-FILE ()
  (if (not *DEG_SETTINGS_FILE*)
    (setq *DEG_SETTINGS_FILE* (DEG:RUNTIME-FILE "DEG_DO_SETTINGS.lsp")))
  *DEG_SETTINGS_FILE*
)

(defun DEG:SAFE-ALIST (al / out p)
  (setq out nil)
  (if (listp al)
    (foreach p al
      (if (vl-consp p)
        (setq out (cons (cons (car p) (cdr p)) out))
      )
    )
  )
  (reverse out)
)

(defun DEG:SANITIZE-SETTINGS ()
  (setq *DEG_CODE_OVERRIDES* (DEG:SAFE-ALIST *DEG_CODE_OVERRIDES*))
  (setq *DEG_CFG_OVERRIDES*  (DEG:SAFE-ALIST *DEG_CFG_OVERRIDES*))
  T
)

(defun DEG:ALIST-PUT (al k v / a)
  (if (setq a (assoc k al))
    (subst (cons k v) a al)
    (cons (cons k v) al)
  )
)

(defun DEG:ALIST-DEL (al k / out p)
  (setq out nil)
  (foreach p al
    (if (/= (car p) k)
      (setq out (cons p out))
    )
  )
  (reverse out)
)

(defun DEG:EXPAND-ENV-PATH (text / out first second name value guard)
  (setq out text
        guard 0)
  (while (and out
              (< guard 10)
              (setq first (vl-string-search "%" out))
              (setq second (vl-string-search "%" out (1+ first))))
    (setq name  (substr out (+ first 2) (- second first 1))
          value (getenv name))
    (if (and value (/= value ""))
      (setq out
        (strcat
          (if (> first 0) (substr out 1 first) "")
          value
          (substr out (+ second 2))))
      (setq guard 10))
    (setq guard (1+ guard)))
  out
)

(defun DEG:DESKTOP-PATH (/ reg user one candidates path)
  (setq reg
    (vl-catch-all-apply
      'vl-registry-read
      (list
        "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\User Shell Folders"
        "Desktop")))
  (if (vl-catch-all-error-p reg) (setq reg nil))
  (if (and reg (= (type reg) 'STR))
    (setq reg (DEG:EXPAND-ENV-PATH reg)))
  (setq user (getenv "USERPROFILE")
        one  (getenv "OneDrive")
        candidates
          (list
            reg
            (if one (strcat one "\\Desktop"))
            (if one (strcat one "\\Masaüstü"))
            (if user (strcat user "\\Desktop"))
            (if user (strcat user "\\Masaüstü"))))
  (while (and candidates (not path))
    (if (and (car candidates)
             (/= (vl-string-trim " \t\r\n" (car candidates)) "")
             (vl-file-directory-p (car candidates)))
      (setq path (car candidates)))
    (setq candidates (cdr candidates)))
  (cond
    (path path)
    (reg reg)
    (user (strcat user "\\Desktop"))
    (T "C:\\Users\\Public\\Desktop"))
)

(defun DEG:CFG-DEFAULT (key / a)
  (cond
    ((= key 'DO_KAYIT_PATH) (DEG:DESKTOP-PATH))
    ((setq a (assoc key *DEG_CFG_DEFAULTS*)) (cdr a))
    (T ""))
)

(defun DEG:VAL (code / o a)
  (cond
    ((setq o (assoc code *DEG_CODE_OVERRIDES*)) (cdr o))
    ((setq a (assoc code *DEG_CODEMAP*)) (caddr a))
  )
)

(defun DEG:SET (code val)
  (if (or (null val) (= (vl-string-trim " \t\r\n" val) ""))
    (setq *DEG_CODE_OVERRIDES* (DEG:ALIST-DEL *DEG_CODE_OVERRIDES* code))
    (setq *DEG_CODE_OVERRIDES* (DEG:ALIST-PUT *DEG_CODE_OVERRIDES* code val))
  )
  (DEG:VAL code)
)

(defun DEG:CFG-GET (key / a value)
  (cond
    ((setq a (assoc key *DEG_CFG_OVERRIDES*))
      (setq value (cdr a))
      (if (and (= key 'DO_KAYIT_PATH)
               (= (vl-string-trim " \t\r\n" value) ""))
        (DEG:CFG-DEFAULT key)
        value))
    (T (DEG:CFG-DEFAULT key))
  )
)

(defun DEG:CFG-SET (key val)
  (if (or (null val) (= (vl-string-trim " \t\r\n" val) ""))
    (setq *DEG_CFG_OVERRIDES* (DEG:ALIST-DEL *DEG_CFG_OVERRIDES* key))
    (setq *DEG_CFG_OVERRIDES* (DEG:ALIST-PUT *DEG_CFG_OVERRIDES* key val))
  )
)

(defun DEG:CFG-GETNUM (key / s)
  (setq s (DEG:CFG-GET key))
  (if (or (null s) (= (vl-string-trim " " s) ""))
    0.0
    (atof s)
  )
)

(defun DEG:CFG-BOOL (key / s)
  (setq s (strcase (vl-string-trim " \t\r\n" (DEG:CFG-GET key))))
  (not (member s '("" "0" "NIL" "FALSE" "HAYIR" "NO")))
)

(defun DEG:CFG-NUM-OR (key def / v)
  (setq v (DEG:CFG-GETNUM key))
  (if (> v 0.0) v def)
)


(defun DEG:PLAN-UNIT-SCALE (/ u)
  (setq u (strcase (vl-string-trim " \t\r\n" (DEG:CFG-GET 'PLAN_UNIT))))
  (cond
    ((= u "CM") 1.0)
    ;; Ayar tabani santimetredir: 1 cm = 10 mm = 0.01 m.
    ((or (= u "METRE") (= u "M")) 0.01)
    (T 10.0)
  )
)

(defun DEG:INSUNITS-PLAN-UNIT (/ units)
  (setq units (getvar "INSUNITS"))
  (cond
    ((= units 4) "mm")
    ((= units 5) "cm")
    ((= units 6) "metre")
    ;; Birimsiz veya desteklenmeyen birimde yanlis tahmin yapma.
    (T nil))
)

(defun DEG:AUTO-UNIT-FLOOR (value / integer)
  (setq integer (fix value))
  (if (> integer value) (1- integer) integer)
)

(defun DEG:AUTO-UNIT-INSUNITS-DECADE (units)
  (cond
    ((= units 4) -3)  ;; millimetre
    ((= units 5) -2)  ;; santimetre
    ((= units 6) 0)   ;; metre
    (T nil))
)

(defun DEG:AUTO-UNIT-SCALE-CLASS (units scale / sourceDecade scaleDecade planDecade)
  ;; INSERT olceginin onluk dilimini, INSUNITS'in metre karsiligiyla
  ;; birlestirir. Ornek (INSUNITS=mm): 2,5 -> mm; 0,378 -> cm.
  (setq sourceDecade (DEG:AUTO-UNIT-INSUNITS-DECADE units))
  (if (and (numberp sourceDecade)
           (numberp scale)
           (> scale 1e-12))
    (progn
      (setq scaleDecade
              (DEG:AUTO-UNIT-FLOOR
                (+ (/ (log scale) (log 10.0)) 1e-9))
            planDecade (- sourceDecade scaleDecade))
      (cond
        ((= planDecade -3) "mm")
        ((= planDecade -2) "cm")
        ((= planDecade 0) "metre")
        (T nil)))
    nil)
)

(defun DEG:AUTO-UNIT-XREF-BLOCK-P (blockName / record flags)
  (setq record (if blockName (tblsearch "BLOCK" blockName) nil)
        flags  (if record (cdr (assoc 70 record)) 0))
  (and (numberp flags) (/= 0 (logand flags 12)))
)

(defun DEG:AUTO-UNIT-VOTE-WINNER (votes / counts unit rec best bestCount tied)
  (setq counts '(("mm" . 0) ("cm" . 0) ("metre" . 0)))
  (foreach unit votes
    (if (setq rec (assoc unit counts))
      (setq counts
        (subst (cons unit (1+ (cdr rec))) rec counts))))
  (setq best nil
        bestCount 0
        tied nil)
  (foreach rec counts
    (cond
      ((> (cdr rec) bestCount)
        (setq best (car rec)
              bestCount (cdr rec)
              tied nil))
      ((and (> (cdr rec) 0) (= (cdr rec) bestCount))
        (setq tied T))))
  (if (and best (> bestCount 0) (not tied)) best nil)
)

(defun DEG:AUTO-PLAN-UNIT-FROM-BLOCK-SCALES
  (units / ss index ent data layout rawName rawKey nameRec effectiveName obj result
           sx sy scale unit sampleRec typeSamples typeRec typeUnit typeVotes nameCache)
  ;; Her benzersiz etkin block adi yalniz bir oy verir. Ayni turden en fazla
  ;; dokuz INSERT ornegi, tek aykiri kopyanin sonucu bozmasini engeller.
  (if (DEG:AUTO-UNIT-INSUNITS-DECADE units)
    (progn
      (setq ss (ssget "_X" '((0 . "INSERT")))
            index 0
            typeSamples nil
            nameCache nil)
      (if ss
        (while (< index (sslength ss))
          (setq ent     (ssname ss index)
                data    (if ent (entget ent) nil)
                layout  (if data (cdr (assoc 410 data)) nil)
                rawName (if data (cdr (assoc 2 data)) nil)
                rawKey  (if rawName (strcase rawName) nil))
          (if (and rawName
                   (or (null layout) (= (strcase layout) "MODEL"))
                   (not (DEG:AUTO-UNIT-XREF-BLOCK-P rawName)))
            (progn
              (setq nameRec (assoc rawKey nameCache))
              (if nameRec
                (setq effectiveName (cdr nameRec))
                (progn
                  (setq obj
                    (vl-catch-all-apply
                      'vlax-ename->vla-object (list ent)))
                  (setq result
                    (if (vl-catch-all-error-p obj)
                      nil
                      (vl-catch-all-apply 'deg-block-name (list obj))))
                  (setq effectiveName
                    (if (or (null result) (vl-catch-all-error-p result))
                      rawKey
                      (strcase result)))
                  (setq nameCache
                    (cons (cons rawKey effectiveName) nameCache))))
              (setq sampleRec (assoc effectiveName typeSamples))
              (if (or (null sampleRec) (< (length (cdr sampleRec)) 9))
                (progn
                  (setq sx (cdr (assoc 41 data))
                        sy (cdr (assoc 42 data)))
                  (if (not (numberp sx)) (setq sx 1.0))
                  (if (not (numberp sy)) (setq sy sx))
                  (setq sx (abs sx)
                        sy (abs sy)
                        scale (if (and (> sx 1e-12) (> sy 1e-12))
                                (sqrt (* sx sy))
                                nil)
                        unit (DEG:AUTO-UNIT-SCALE-CLASS units scale))
                  (if unit
                    (if sampleRec
                      (setq typeSamples
                        (subst
                          (cons effectiveName (cons unit (cdr sampleRec)))
                          sampleRec
                          typeSamples))
                      (setq typeSamples
                        (cons (list effectiveName unit) typeSamples)))))))
          )
          (setq index (1+ index))))
      (foreach typeRec typeSamples
        (setq typeUnit (DEG:AUTO-UNIT-VOTE-WINNER (cdr typeRec)))
        (if typeUnit (setq typeVotes (cons typeUnit typeVotes))))
      (DEG:AUTO-UNIT-VOTE-WINNER typeVotes))
    nil)
)

