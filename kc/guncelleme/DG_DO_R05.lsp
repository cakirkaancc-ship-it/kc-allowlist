          'vla-InsertBlock
          (list blk (vlax-3d-point '(0.0 0.0 0.0)) shellName 1.0 1.0 1.0 0.0)))
      (if (and obj (not (vl-catch-all-error-p obj)))
        (progn
          (vl-catch-all-apply 'vla-put-Layer (list obj (DT--layer-fitting)))
          obj)
      )
    )
