        (if (and h (not (DEGV:_handle-in-list h hChain)))
          (progn
            (setq hChain (cons h hChain))
            (setq chain  (cons e chain))
          )
        )
      )
    )
  )
  (list hChain chain)
)

(defun DEGV:_ss-union (a b / out i)
