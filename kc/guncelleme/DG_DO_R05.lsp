)

(defun DEG:FILE-SYSTIME-SAFE (fn / result)
  (setq result (vl-catch-all-apply 'vl-file-systime (list fn)))
  (if (vl-catch-all-error-p result) nil result)
)

(defun DEG:SYSTIME-NEWER-P (a b / newer done)
  (while (and a b (not done))
    (cond
      ((> (car a) (car b)) (setq newer T done T))
      ((< (car a) (car b)) (setq newer nil done T))
      (T (setq a (cdr a) b (cdr b)))))
  newer
)

(defun DEG:NEWEST-SETTINGS-FILE (files / best bestTime fn tm)
  (foreach fn files
    (if (and fn (findfile fn))
      (progn
        (setq tm (DEG:FILE-SYSTIME-SAFE fn))
        (if (or (not best)
                (and tm (or (not bestTime) (DEG:SYSTIME-NEWER-P tm bestTime))))
          (setq best fn bestTime tm)))))
  best
)

(defun DEG:LOAD-SETTINGS (/ s fn loaded result candidates candidate envApplied)
  (setq fn (DEG:SETTINGS-FILE)
        candidates (cons fn (DEG:OLD-SETTINGS-FILES))
        candidate (DEG:NEWEST-SETTINGS-FILE candidates))
  ;; Eski ortak ProgramData kaydi ile kullanici profilindeki kayittan en yenisini al.
  (if candidate
    (progn
      (setq result (vl-catch-all-apply 'load (list candidate nil)))
      (if (not (vl-catch-all-error-p result)) (setq loaded T))))
  (if (boundp '*DEG_PERSIST_CODE_OVERRIDES*)
    (setq *DEG_CODE_OVERRIDES* *DEG_PERSIST_CODE_OVERRIDES*))
  (if (boundp '*DEG_PERSIST_CFG_OVERRIDES*)
    (setq *DEG_CFG_OVERRIDES* *DEG_PERSIST_CFG_OVERRIDES*))
  ;; setenv kaydi Windows/CAD kullanicisina ozeldir ve son basarili Kaydet'i tasir.
  ;; Ortak ya da eski bir dosyanin yeni sekmede bu degerleri ezmesine izin verme.
  (if (and (setq s (getenv "DEG_DO_CODE_OVERRIDES")) (/= s ""))
    (progn
      (setq *DEG_CODE_OVERRIDES* (DEG:SAFE-READ-SETTING s "DEG_DO_CODE_OVERRIDES")
            envApplied T)))
  (if (and (setq s (getenv "DEG_DO_CFG_OVERRIDES")) (/= s ""))
    (progn
      (setq *DEG_CFG_OVERRIDES* (DEG:SAFE-READ-SETTING s "DEG_DO_CFG_OVERRIDES")
            envApplied T)))
  (DEG:SANITIZE-SETTINGS)
  ;; Ilk acilista en yeni/eski kaydi yeni kullanici konumuna tasiyip iyilestir.
  (if (or envApplied
          (and loaded candidate fn (/= (strcase candidate) (strcase fn))))
    (DEG:WRITE-PERSISTED-SETTINGS))
)

(DEG:LOAD-SETTINGS)
(DEG:SANITIZE-SETTINGS)

;; DN Block eski 7 cm varsayilanini yeni 1 cm varsayilanina bir kez tasi.
;; Daha sonra kullanicinin elle girdigi 7 cm degeri aynen korunur.
(if (/= (DEG:CFG-GET 'MIG_DN_BLOCK_TOL_CM1) "1")
  (progn
    (if (and (assoc 'DN_BLOCK_TOL *DEG_CFG_OVERRIDES*)
             (equal
               (atof (cdr (assoc 'DN_BLOCK_TOL *DEG_CFG_OVERRIDES*)))
               7.0
               0.000001))
      (setq *DEG_CFG_OVERRIDES*
        (DEG:ALIST-DEL *DEG_CFG_OVERRIDES* 'DN_BLOCK_TOL))
    )
    (DEG:CFG-SET 'MIG_DN_BLOCK_TOL_CM1 "1")
  )
)

;; DK Yazi Y Ofset eski 70 cm varsayilanini yeni 90 cm varsayilanina tasi.
;; Farkli bir kullanici degeri kayitliysa aynen korunur.
(if (and (assoc 'DK_TEXT_OFFSET_Y *DEG_CFG_OVERRIDES*)
         (equal
           (atof (cdr (assoc 'DK_TEXT_OFFSET_Y *DEG_CFG_OVERRIDES*)))
           70.0
           0.000001))
  (setq *DEG_CFG_OVERRIDES*
    (DEG:ALIST-DEL *DEG_CFG_OVERRIDES* 'DK_TEXT_OFFSET_Y))
)

;; Ayni kat loop araliginin eski 500 cm varsayilanini yeni 0 cm
;; varsayilanina tasi. Farkli kullanici degerleri aynen korunur.
(if (and (assoc 'DK_NORMAL_GROUP_SPACING *DEG_CFG_OVERRIDES*)
         (equal
           (atof (cdr (assoc 'DK_NORMAL_GROUP_SPACING *DEG_CFG_OVERRIDES*)))
           500.0
           0.000001))
  (setq *DEG_CFG_OVERRIDES*
    (DEG:ALIST-DEL *DEG_CFG_OVERRIDES* 'DK_NORMAL_GROUP_SPACING))
)

;; Onceki varsayilan olculer kayitliysa yeni 70x40/8 varsayilanina gecir.
;; Bunlar disindaki kullanici degerlerine dokunulmaz.
(if (and (assoc 'DTT_RECT_WIDTH *DEG_CFG_OVERRIDES*)
         (assoc 'DTT_RECT_HEIGHT *DEG_CFG_OVERRIDES*)
         (or
           (and
             (equal (atof (cdr (assoc 'DTT_RECT_WIDTH *DEG_CFG_OVERRIDES*))) 40.0 0.000001)
             (equal (atof (cdr (assoc 'DTT_RECT_HEIGHT *DEG_CFG_OVERRIDES*))) 20.0 0.000001))
           (and
             (equal (atof (cdr (assoc 'DTT_RECT_WIDTH *DEG_CFG_OVERRIDES*))) 50.0 0.000001)
             (equal (atof (cdr (assoc 'DTT_RECT_HEIGHT *DEG_CFG_OVERRIDES*))) 30.0 0.000001))))
  (progn
    (setq *DEG_CFG_OVERRIDES* (DEG:ALIST-DEL *DEG_CFG_OVERRIDES* 'DTT_RECT_WIDTH))
    (setq *DEG_CFG_OVERRIDES* (DEG:ALIST-DEL *DEG_CFG_OVERRIDES* 'DTT_RECT_HEIGHT))
    (if (and (assoc 'DTT_ATT_TEXT_HEIGHT *DEG_CFG_OVERRIDES*)
             (equal (atof (cdr (assoc 'DTT_ATT_TEXT_HEIGHT *DEG_CFG_OVERRIDES*))) 4.0 0.000001))
      (setq *DEG_CFG_OVERRIDES* (DEG:ALIST-DEL *DEG_CFG_OVERRIDES* 'DTT_ATT_TEXT_HEIGHT))
    )
  )
)

;; ----------------------------
;; N2 (E_OK) bloklarýný tamamen yok saymak için yardýmcýlar (R312 ile ayný)
;; Not: "E_OK" kelimesi kullanýlmaz; N2 pattern'i esas alýnýr.
;; ----------------------------
(defun DEG:PT->LIST (pt)
  (cond
    ((= (type pt) 'LIST) pt)
    ((= (type pt) 'VARIANT) (DEG:PT->LIST (vlax-variant-value pt)))
    ((= (type pt) 'SAFEARRAY) (vlax-safearray->list pt))
    (T pt)
  )
)

(defun DEG:BLOCK-NAMES (blkObj / names n eff)
  (setq names '())
  (setq n (vl-catch-all-apply 'vla-get-Name (list blkObj)))
  (if (not (vl-catch-all-error-p n))
    (setq names (cons n names))
  )
  (setq eff (vl-catch-all-apply 'vla-get-EffectiveName (list blkObj)))
  (if (not (vl-catch-all-error-p eff))
    (setq names (cons eff names))
  )
  ;; deg-block-name varsa onu da ekle (bazý yerlerde EffectiveName dönüyor)
  (setq eff (vl-catch-all-apply 'deg-block-name (list blkObj)))
  (if (not (vl-catch-all-error-p eff))
    (setq names (cons eff names))
  )
  ;; deg-block-name-raw varsa onu da ekle
  (setq eff (vl-catch-all-apply 'deg-block-name-raw (list blkObj)))
  (if (not (vl-catch-all-error-p eff))
    (setq names (cons eff names))
  )
  (vl-remove nil names)
)

(defun DEG:RELAX-PATTERN (pat / p)
  ;; N2 pattern'inden daha gevþek bir eþleme üüretir (örn: "*E_OK_*" -> "*E_OK*")
  (setq p pat)
  (if (and p (= (type p) 'STR))
    (progn
      (while (vl-string-search "_*" p) (setq p (vl-string-subst "*" "_*" p)))
      (while (vl-string-search "*_" p) (setq p (vl-string-subst "*" "*_" p)))
    )
  )
  p
)

(defun DEG:IGNORE-BLOCK-OBJ? (blkObj / pat pat2 names nm hit nmU)
  ;; N2 (E_OK) bloklarý tamamen yok sayýlýr (N2 pattern'i esas alýnýr)
  (setq pat (DEG:VAL 'N2))
  (setq pat2 (DEG:RELAX-PATTERN pat))
  (setq names (DEG:BLOCK-NAMES blkObj))
  (setq hit nil)
  (foreach nm names
    (setq nmU (strcase nm))
    (if (or (wcmatch nmU pat)
            (and pat2 (wcmatch nmU pat2)))
      (setq hit T)
    )
  )
  hit
)

(defun DEG:SS-REMOVE-IGNORED-BLOCKS (ss / i e obj ss2)
  ;; Seçim setindeki N2 (E_OK) bloklarýný tamamen çýkarýr.
  (setq ss2 (ssadd))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq e (ssname ss i))
        (if e
          (progn
            (setq obj (vlax-ename->vla-object e))
            (if (not (DEG:IGNORE-BLOCK-OBJ? obj))
              (ssadd e ss2)
            )
          )
        )
        (setq i (1+ i))
      )
    )
  )
  ss2
)

(defun DEG:SS-FILTER-BY-TYPE (ss typePat / i e ed ss2)
  (setq ss2 (ssadd))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq e (ssname ss i)
              ed (if e (entget e)))
        (if (and ed (wcmatch (cdr (assoc 0 ed)) typePat))
          (ssadd e ss2)
        )
        (setq i (1+ i))
      )
    )
  )
  ss2
)

(defun DEG:SS-CONTAINS-ENAME? (ss ent / i found)
  (setq found nil)
  (if (and ss ent)
    (progn
      (setq i 0)
      (while (and (< i (sslength ss)) (not found))
        (if (= (ssname ss i) ent)
          (setq found T)
        )
        (setq i (1+ i))
      )
    )
  )
  found
)

(defun DEG:SS-LEN (ss / n)
  (if ss
    (progn
      (setq n (vl-catch-all-apply 'sslength (list ss)))
      (if (or (vl-catch-all-error-p n) (null n)) 0 n)
    )
    0
  )
)

(defun DEG:IGNORE-OBJ? (obj / on)
  ;; VLA objesi bir BlockReference ise ve N2'ye uyuyorsa yok say
  (setq on (vl-catch-all-apply 'vla-get-ObjectName (list obj)))
  (if (vl-catch-all-error-p on)
    nil
    (if (= on "AcDbBlockReference")
      (DEG:IGNORE-BLOCK-OBJ? obj)
      nil
    )
  )
)

(defun DEG:TYPE (code / a)
