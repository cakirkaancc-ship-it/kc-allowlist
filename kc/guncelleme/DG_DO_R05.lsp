    (progn
      (setq ed  (entget ins (list app))
            xd  (assoc -3 ed)
            rec (if xd (cadr xd) nil))
      (if (and rec (= (car rec) app))
        (foreach item (cdr rec)
          (cond
            ((= (car item) 1000) (setq source (cdr item)))
            ((= (car item) 1070) (setq enabled (/= (cdr item) 0))))))))
  (if source (list source enabled))
