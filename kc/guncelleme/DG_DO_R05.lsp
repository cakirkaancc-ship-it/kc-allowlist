(defun g405_attach_score (aS aE prevPt bpt nextPt dist / pen)
  (setq pen 0.0)
  (if (and prevPt (not (g405_on_seg prevPt bpt aS)))
    (setq pen (+ pen (* 50.0 dist)))
  )
  (if (and nextPt (not (g405_on_seg bpt nextPt aE)))
    (setq pen (+ pen (* 50.0 dist)))
  )
  (+ pen (distance aS bpt) (distance aE bpt))
)

(defun g406_pt_ok (p)
  (and (listp p)
       (numberp (car p))
       (numberp (cadr p)))
)

(defun g406_to3 (p)
  (if (g406_pt_ok p)
    (list (car p) (cadr p)
          (if (and (caddr p) (numberp (caddr p))) (caddr p) 0.0))
    nil
  )
)

(defun g406_mid (p q / p3 q3)
  (setq p3 (g406_to3 p))
  (setq q3 (g406_to3 q))
  (if (and p3 q3)
    (list (/ (+ (car p3) (car q3)) 2.0)
          (/ (+ (cadr p3) (cadr q3)) 2.0)
          0.0)
    nil
  )
)

(defun g406_get_v (pts i / isClosed)
  (setq isClosed (g376_is_closed pts))
  (if isClosed (g376_nth_wrap pts i) (g376_nth_safe pts i))
)

(defun g406_best_corner_idx (boundaryPts idx step seed / cand bestI bestD i p s3 d)
  (setq s3 (g406_to3 seed))
  (if (null s3)
    idx
    (progn
      (setq cand (list idx
                       (- idx step) (+ idx step)
                       (- idx (* 2 step)) (+ idx (* 2 step))))
      (setq bestI idx)
      (setq bestD 1e99)
      (foreach i cand
        (setq p (g406_get_v boundaryPts i))
        (if (g406_pt_ok p)
          (progn
            (setq d (distance s3 (g406_to3 p)))
            (if (< d bestD) (setq bestD d bestI i))
          )
        )
      )
      bestI
    )
  )
)

(defun g407_ptdist (p q / p3 q3)
