(defun KC:UpdateResultDetail (result / pos)
  (setq pos (if result (vl-string-search "|" result) nil))
  (if (and pos (< (1+ pos) (strlen result)))
    (KC:Trim (substr result (+ pos 2)))
    "")
)

(defun c:DUPDATE (/ result detail upper)
  (princ "\n[KC] Guncellemeler kontrol ediliyor-...")
  (setq result (KC:CheckForUpdates T)
        upper  (if result (strcase result) ""))
  (cond
    ((and result (wcmatch upper "UPDATED|PENDING|*"))
      (DEG:WIN-MESSAGE-TITLED
        "DEG Güncelleme"
        "Dosyalar indirildi.\nKurulum AutoCAD kapatýldýðýnda otomatik tamamlanacak."))
    ((and result (wcmatch upper "UPDATED|*"))
      (DEG:WIN-MESSAGE-TITLED
        "DEG Güncelleme"
        "Güncelleme tamamlandý.\nCAD programýný yeniden baþlatýn."))
    ((and result (wcmatch upper "CURRENT|*"))
      (princ "\n[KC] DEG dosyalari zaten guncel."))
    ((and result (wcmatch upper "FAILED|*"))
      (setq detail (KC:UpdateResultDetail result))
      (princ
        (strcat
          "\n[KC] Guncelleme tamamlanamadi"
          (if (/= detail "") (strcat ": " detail) "."))))
    (T
      (princ "\n[KC] Guncelleme denetimi baslatilamadi."))
  )
  (princ)
)

