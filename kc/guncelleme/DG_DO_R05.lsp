(defun degk--area-select-with-layout (/ layoutMode input areaSS)
  ;; Yon secimi alan seciminden ayridir ve zorunludur. Secilen yonden sonra
  ;; her iki mod da standart AutoCAD secim kumesini kullanir.
  (initget 1 "Dik Yatay")
  (setq input (getkword "\nDK: Kolon semasi yonunu sec [Dik/Yatay]: "))
  (if input
    (progn
      (setq layoutMode (if (= input "Dik") 'DIK 'YATAY))
      (princ "\nDK: Alani normal secimle secin; Space/Enter ile bitirin:")
      (setq areaSS (ssget '((0 . "LWPOLYLINE,POLYLINE,INSERT"))))))
  (if areaSS (list areaSS layoutMode) nil)
)

(defun DK_ORIG (/ *degk-source-cache-active* *degk-terminal-type-cache* *degk-source-eligible-cache* *degk-number-mode* *degk-title-index* *degk-title-index-ready* *degk-title-cache* *degk-loop-bounds-cache* *degk-number-warning* *degk-cable-index* *degk-panel-loop-count* *degk-siren-underlines* *degk-siren-branches* *degk-siren-floor-rails* *degk-ups-source* sel ent pickPt plObj layU ucsTmp res msg oldTS areaSS normalPolys basePt selectionRes layoutMode frameStart processResult *DS-LAYER-STATES* *degk-last-panel-name* *degk-area-module-copy-map* *degk-area-module-symbol-map* *degk-column-terminal-copies* *degk-flasher-contact-bbox-cache* *degk-dispatch-terminal-copy-rec*)
  (setq *degk-source-cache-active* T)
  (vl-load-com)

  (setq *degk-perf-active* T *degk-perf-data* nil *degk-perf-stack* nil
        *degk-perf-selected* 0 *degk-perf-texts* 0 *degk-perf-leaders* 0 *degk-perf-touches* 0)
  ;; DK, kopyalama sirasinda kaynak/nested obje layerlarini gecici olarak
  ;; acip thaw/unlock eder. Komut nasil biterse bitsin mevcut layer durumlari korunur.
  (setq *DS-LAYER-STATES* nil)
  (DS--snapshot-all-layer-states)

  ;; DK yazýlarý için TEXTSTYLE -> STANDARD
  (setq oldTS (getvar "TEXTSTYLE"))
  (degk--ensure-textstyle "STANDARD" "arial.ttf")
  (setvar "TEXTSTYLE" "STANDARD")


  ;; DK en baþýnda UCS -> World (WCS), iþlem bitince eski UCS'ye don.
  (setq ucsTmp "DEG_DK_UCS_TMP")
  (vl-catch-all-apply 'vl-cmdf (list "_.UCS" "_D" ucsTmp))
  (vl-cmdf "_.UCS" "_S" ucsTmp)
  (vl-cmdf "_.UCS" "_W")

  (setq res
    (vl-catch-all-apply
      (function
        (lambda ()
          (deg-reset-session)
          (deg-clear-deg-done-xdata)
          (setq *degk-last-panel-name* (degk--select-last-panel-name)
                selectionRes (degk--area-select-with-layout)
                areaSS      (if selectionRes (car selectionRes) nil)
                layoutMode  (if selectionRes (cadr selectionRes) 'YATAY))
          (if (not areaSS)
            (progn (princ "\n\nDEGK iptal.") nil)
            (progn
              (setq *degk-perf-selected* (sslength areaSS))
              (setq *degk-number-mode*
                (degk--perf-call "Alan numara modu" 'degk--area-number-mode (list areaSS)))
              (setq normalPolys (degk--perf-call "Secili normal hat taramasi" 'degk--normal-area-polylines (list areaSS))
                    *degk-cable-index* (degk--cable-source-index areaSS))
              (if (and (= (sslength areaSS) 1)
                       (= (sslength normalPolys) 0)
                       (member (cdr (assoc 0 (entget (ssname areaSS 0))))
                               '("LWPOLYLINE" "POLYLINE")))
                (progn
                  (setq ent (degk--as-ename (ssname areaSS 0)))
                  (if ent
                    (progn
                      (setq pickPt (vl-catch-all-apply 'vlax-curve-getStartPoint (list ent)))
                      (if (vl-catch-all-error-p pickPt)
                        (setq pickPt (cdr (assoc 10 (entget ent)))))
                      (setq plObj (vlax-ename->vla-object ent)
                            layU (strcase (vla-get-Layer plObj))
                            *degk-dispatch-sel* (list ent pickPt))
                      (cond
                        ((DEGK--data-layer-name-p layU) (DEGV:RUN))
                        ((DEGQ:_cctv-layer-name-p layU) (DEGQ:RUN))
                        (T
                          (setq *degk-dispatch-sel* nil)
                          (princ
                            (strcat "\nDK: Secilen polyline normal alan layer listesinde degil: "
                                    (vla-get-Layer plObj))))
                      )
                    )
                  )
                )
                (progn
                  (if (= (sslength normalPolys) 0)
                    (princ "\nDK: Alanda ayar listesindeki normal hat polylinesi bulunamadi.")
                    (progn
                      (setq basePt (getpoint "\nDK: Ilk hat grubunun yapistirma noktasini sec: "))
                      (if basePt
                        (progn
                          (setq frameStart (entlast)
                                processResult
                                  (degk--perf-call "Ana loop cizimi (yerlesim ve kablo dahil)" 'degk--normal-area-process
                                    (list areaSS basePt layoutMode)))
                          (degk--maybe-draw-column-frame
                            frameStart basePt processResult)
                          (degk--perf-call "Siren-UPS cizimi" 'degk--draw-siren-underlines (list areaSS)))
                        (princ "\nDEGK iptal."))
                    )
                  )
                )
              )
            )
          )
          nil
        )
      )
      '()
    )
  )

  (setq *degk-dispatch-sel* nil
        *degk-dispatch-base* nil)

  ;; UCS restore (iptal dahil)
  (vl-catch-all-apply 'vl-cmdf (list "_.UCS" "_R" ucsTmp))
  (vl-catch-all-apply 'vl-cmdf (list "_.UCS" "_D" ucsTmp))


  ;; TEXTSTYLE restore (iptal dahil)
  (if oldTS (setvar "TEXTSTYLE" oldTS))
  (DS--restore-layer-states)
  (degk--perf-report)
  (if (vl-catch-all-error-p res)
    (progn
      (setq msg (vl-catch-all-error-message res))
      (if (and msg (/= msg "Function cancelled"))
        (princ (strcat "\n; error: " msg))
      )
    )
  )
  (princ)
)


