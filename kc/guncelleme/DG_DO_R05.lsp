(defun DT--projected-face-shape-from-ent
  (ent / ed code pair pt pts clean first last area)
  (setq ed (if ent (entget ent)))
  (if (= (cdr (assoc 0 ed)) "3DFACE")
    (progn
      (foreach code '(10 11 12 13)
        (setq pair (assoc code ed))
        (if pair
          (progn
            (setq pt (list (car (cdr pair)) (cadr (cdr pair)) 0.0))
            (if (or (null pts)
                    (not (equal pt (g365_last pts) 0.0000001)))
              (setq pts (append pts (list pt)))))))
      (if (and (> (length pts) 2)
               (equal (car pts) (g365_last pts) 0.0000001))
        (setq pts (DT--hatch-drop-last pts)))
      (if (> (length pts) 2)
        (progn
          (setq first (car pts)
                clean (list first))
          (foreach pt (cdr pts)
            (if (not
                  (vl-some
                    '(lambda (known) (equal pt known 0.0000001))
                    clean))
              (setq clean (append clean (list pt)))))
          (setq area (abs (DT--polygon-area2 clean)))
          (if (and (> (length clean) 2) (> area 0.000001))
            (list clean T nil)))))
  )
)

(defun DT--face-plan-points-from-ent (ent / ed code pair p out)
  (setq ed (if ent (entget ent)))
  (if (= (cdr (assoc 0 ed)) "3DFACE")
    (foreach code '(10 11 12 13)
      (setq pair (assoc code ed))
      (if pair
        (progn
          (setq p (list (car (cdr pair)) (cadr (cdr pair)) 0.0))
          (if (not
                (vl-some
                  '(lambda (known) (equal p known 0.0000001))
                  out))
            (setq out (append out (list p))))))))
  out
)

(defun DT--plan-point-less-p (a b)
  (or
    (< (car a) (car b))
    (and (equal (car a) (car b) 0.0000001)
         (< (cadr a) (cadr b))))
)

(defun DT--unique-plan-points (pts / out p)
  (foreach p pts
    (if (not
          (vl-some
            '(lambda (known) (equal p known 0.0000001))
            out))
      (setq out (append out (list p)))))
  out
)

(defun DT--plan-turn-cross (a b c)
  (-
    (* (- (car b) (car a)) (- (cadr c) (cadr a)))
    (* (- (cadr b) (cadr a)) (- (car c) (car a))))
)

(defun DT--convex-hull-plan (pts / sorted lower upper p n)
  (setq sorted
    (vl-sort
      (DT--unique-plan-points pts)
      'DT--plan-point-less-p))
  (if (> (length sorted) 2)
    (progn
      (foreach p sorted
        (while
          (and
            (> (length lower) 1)
            (<=
              (DT--plan-turn-cross
                (nth (- (length lower) 2) lower)
                (g365_last lower)
                p)
              0.0000001))
          (setq lower (DT--hatch-drop-last lower)))
        (setq lower (append lower (list p))))
      (foreach p (reverse sorted)
        (while
          (and
            (> (length upper) 1)
            (<=
              (DT--plan-turn-cross
                (nth (- (length upper) 2) upper)
                (g365_last upper)
                p)
              0.0000001))
          (setq upper (DT--hatch-drop-last upper)))
        (setq upper (append upper (list p))))
      (setq lower (DT--hatch-drop-last lower)
            upper (DT--hatch-drop-last upper))
      (append lower upper))
  )
)

(defun DT--ensure-fitting-2d-block
  (source / target rec ent ed typ shape polyShapes facePts hull made)
  (setq target (DT--fitting-2d-block-name source))
  (if (tblsearch "BLOCK" target)
    target
    (if (and source (tblsearch "BLOCK" source))
      (progn
        (entmake
          (list
            '(0 . "BLOCK")
            (cons 2 target)
            '(70 . 0)
            '(10 0.0 0.0 0.0)))
        (setq rec (tblobjname "BLOCK" source)
              ent (if rec (entnext rec)))
        (while (and ent (/= (cdr (assoc 0 (entget ent))) "ENDBLK"))
          (setq ed  (entget ent)
                typ (cdr (assoc 0 ed)))
          (cond
            ((= typ "LWPOLYLINE")
              (setq shape (DT--closed-poly-shape-from-ent ent))
              (if shape
                (setq polyShapes (append polyShapes (list shape)))))
            ((= typ "3DFACE")
              (setq facePts
                (append facePts (DT--face-plan-points-from-ent ent)))))
          (setq ent (entnext ent)))
        (if polyShapes
          (foreach shape polyShapes
            (DT--block-poly-entmake
              (car shape) (cadr shape) (caddr shape))
            (DT--block-local-2d-hatch-entmake
              (car shape) (caddr shape))
            (setq made T))
          (progn
            ;; Yalniz 3DFACE kullanan elevation fittingleri cok sayida yuz
            ;; izdushumu yerine tek, sade bir ust-gorunus konturu alir.
            (setq hull (DT--convex-hull-plan facePts))
            (if (> (length hull) 2)
              (progn
                (DT--block-poly-entmake hull T nil)
                (DT--block-local-2d-hatch-entmake hull nil)
                (setq made T)))))
        (entmake '((0 . "ENDBLK")))
        (if made
          (progn
            (DT--set-block-linework-050 target)
            target)
          (setq target nil)))
      )
    )
  target
)

(defun DT--set-insert-block-name (ins name / ed pair)
  (if (and ins name (tblsearch "BLOCK" name) (setq ed (entget ins '("*"))))
    (progn
      (setq pair (assoc 2 ed))
      (if pair
        (setq ed (subst (cons 2 name) pair ed))
        (setq ed (append ed (list (cons 2 name)))))
      (if (entmod ed)
        (progn (entupd ins) ins))))
)

(defun DT--apply-fitting-3d-mode (ins enabled / ed current data source target)
  (if (and ins
           (setq ed (entget ins '("*")))
           (= (cdr (assoc 0 ed)) "INSERT"))
    (progn
      (setq current (cdr (assoc 2 ed))
            data    (DT--fitting-display-data ins)
            source  (if data (car data) nil))
      (if (null source)
        (setq source current))
      (if enabled
        (if (tblsearch "BLOCK" source)
          (DT--set-insert-block-name ins source))
        (progn
          (setq target (DT--ensure-fitting-2d-block source))
          (if target (DT--set-insert-block-name ins target))))
      (DT--set-fitting-display-data ins source enabled)))
  ins
)

(defun DT--fitting-3d-enabled-p (ins / data)
  (setq data (DT--fitting-display-data ins))
  (if data
    (if (cadr data) T nil)
    T)
)

(defun DT--fitting-name-p (name / u)
  (setq u (if name (strcase name) ""))
  (and
    (> (strlen u) 2)
    (= (substr u 1 2) "E_")
    (or
      (vl-string-search "_T_" u)
      (vl-string-search "_ART" u)
      (vl-string-search "_ESNEK" u)
      (vl-string-search "_ELEVATION_" u)
      (vl-string-search "_D" u)
    )
  )
)

(defun DT--fitting-insert-p (ent / ed name)
  (if (and ent (setq ed (entget ent '("DT_FITTING"))) (= (cdr (assoc 0 ed)) "INSERT"))
    (or
      (assoc -3 ed)
      (progn
        (setq name (cdr (assoc 2 ed)))
        (DT--fitting-name-p name)
      )
    )
  )
)

(defun DT--collect-fitting-inserts (/ ss i ent ed lay out)
  (setq ss
    (ssget "_X"
      (list (cons 0 "INSERT"))))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent (ssname ss i)
              ed  (entget ent)
              lay (if ed (cdr (assoc 8 ed)) nil))
        (if (and (DT--entity-alive-p ent)
                 lay
                 (DT--tray-visible-layer-p lay)
                 (DT--fitting-insert-p ent))
          (setq out (cons ent out)))
        (setq i (1+ i)))))
  (reverse out)
)

(defun DT--fitting-inserts ()
  (if (and (boundp '*DT_FITTING_CACHE_ACTIVE*)
           *DT_FITTING_CACHE_ACTIVE*)
    *DT_FITTING_CACHE*
    (DT--collect-fitting-inserts))
)

(defun DT--cache-fitting-insert (ent)
  (if (and ent
           (DT--entity-alive-p ent)
           (boundp '*DT_FITTING_CACHE_ACTIVE*)
           *DT_FITTING_CACHE_ACTIVE*
           (not (member ent *DT_FITTING_CACHE*)))
    (setq *DT_FITTING_CACHE* (cons ent *DT_FITTING_CACHE*)))
  ent
)

(defun DT--replace-last-bulge (lst val / out i n x)
  (setq i 0
        n (length lst))
  (foreach x lst
    (setq out
      (append out
        (list
          (if (= i (1- n)) val x)
        )
      )
    )
    (setq i (1+ i))
  )
  out
)

(defun DT--closed-poly-shape-from-ent (ent / ed item flags pts bulges)
  (setq ed (entget ent))
  (setq flags (if (assoc 70 ed) (cdr (assoc 70 ed)) 0))
  (if (and (= (cdr (assoc 0 ed)) "LWPOLYLINE")
           (= (logand flags 1) 1))
    (progn
      (foreach item ed
        (cond
          ((= (car item) 10)
            (setq pts (append pts (list (list (car (cdr item)) (cadr (cdr item)) 0.0))))
            (setq bulges (append bulges (list 0.0)))
          )
          ((= (car item) 42)
            (if bulges
              (setq bulges (DT--replace-last-bulge bulges (cdr item)))
            )
          )
        )
      )
      (if (> (length pts) 1)
        (list pts T bulges)
      )
    )
  )
)
(defun DT--collapse-open-block-polyline (ent / ed item flags first out changed)
  (setq ed (entget ent)
        flags (if (assoc 70 ed) (cdr (assoc 70 ed)) 0))
  (foreach item ed
    (if (and (= (car item) 10) (null first))
      (setq first (cdr item))
    )
  )
  (if first
    (progn
      (foreach item ed
        (cond
          ((= (car item) 10)
            (setq out (append out (list (cons 10 first)))))
          ((= (car item) 70)
            (setq out (append out (list (cons 70 (logior flags 1))))))
          ((= (car item) 42)
            (setq out (append out (list (cons 42 0.0)))))
          (T
            (setq out (append out (list item))))
        )
      )
      (if (not (assoc 70 ed))
        (setq out (append out (list (cons 70 1))))
      )
      (if (entmod out)
        (progn
          (entupd ent)
          (setq changed T)
        )
      )
    )
  )
  changed
)
(defun DT--cleanup-fitting-block-inner-lines (/ rec name blk ent ed next flags cleaned)
  (setq rec (tblnext "BLOCK" T)
        cleaned 0)
  (while rec
    (setq name (cdr (assoc 2 rec)))
    (if (and name (DT--fitting-name-p name) (setq blk (tblobjname "BLOCK" name)))
      (progn
        (setq ent (entnext blk))
        (while (and ent (/= (cdr (assoc 0 (entget ent))) "ENDBLK"))
          (setq next (entnext ent)
                ed   (entget ent))
          (setq flags (if (assoc 70 ed) (cdr (assoc 70 ed)) 0))
          (if (and (= (cdr (assoc 0 ed)) "LWPOLYLINE")
                   (= (logand flags 1) 0))
            (if (DT--collapse-open-block-polyline ent)
              (setq cleaned (1+ cleaned))
            )
          )
          (setq ent next)
        )
      )
    )
    (setq rec (tblnext "BLOCK"))
  )
  cleaned
)
(defun DT--fitting-insert-width (ent fallback / ed xd rec x val)
  (setq val fallback)
  (if (and ent (entget ent))
    (progn
      (setq ed (entget ent '("DT_FITTING"))
            xd (assoc -3 ed))
      (if xd
        (progn
          (setq rec (cadr xd))
          (foreach x (cdr rec)
            (if (= (car x) 1040) (setq val (cdr x)))
          )
        )
      )
    )
  )
  (if (and (numberp val) (> val 0.0)) val fallback)
)

(defun DT--variant-list (v / vv out)
  (setq vv (vl-catch-all-apply 'vlax-variant-value (list v)))
  (if (vl-catch-all-error-p vv)
    (setq vv v)
  )
  (setq out (vl-catch-all-apply 'vlax-safearray->list (list vv)))
  (if (vl-catch-all-error-p out) nil out)
)

(defun DT--point-in-box-p (pt mn mx tol)
  (and pt mn mx
       (<= (- (car mn) tol) (car pt) (+ (car mx) tol))
       (<= (- (cadr mn) tol) (cadr pt) (+ (cadr mx) tol)))
)

(defun DT--point-in-fitting-box-p (pt ent tol / obj mn mx ok)
  (if (and pt ent (entget ent))
    (progn
      (setq obj (vl-catch-all-apply 'vlax-ename->vla-object (list ent)))
      (if (or (vl-catch-all-error-p obj) (null obj))
        nil
        (progn
          (setq ok (vl-catch-all-apply 'vla-getboundingbox (list obj 'mn 'mx)))
          (if (vl-catch-all-error-p ok)
            nil
            (DT--point-in-box-p pt (DT--variant-list mn) (DT--variant-list mx) tol)
          )
        )
      )
    )
  )
)

(defun DT--nearest-fitting-center-for-point
  (pt width / ent ed ip lay activeLayer fw tol d best bestD)
  (if (and pt (DT--layer-fitting))
    (progn
      (setq activeLayer (strcase (DT--layer-fitting)))
      (foreach ent (DT--fitting-inserts)
        (setq ed (entget ent)
              ip  (if ed (cdr (assoc 10 ed)) nil)
              lay (if ed (cdr (assoc 8 ed)) nil))
        (if (and ip
                 lay
                 (= (strcase lay) activeLayer)
                 (or (DT--same-active-elevation-p ent)
                     (DT--elevation-fitting-insert-p ent)))
          (progn
            (setq fw  (DT--fitting-insert-width ent width)
                  tol (max 1.0 (/ fw 20.0))
                  d   (distance
                        (list (car pt) (cadr pt) 0.0)
                        (list (car ip) (cadr ip) 0.0)))
            (if (and
                  (<= d (+ (* fw 4.0) tol))
                  (or
                    (<= d (+ (* fw 1.25) tol))
                    (DT--point-in-fitting-box-p pt ent tol)
                  )
                  (or (null bestD) (< d bestD))
                )
              (setq bestD d
                    best  (list (car ip) (cadr ip) 0.0))
            )
          )
        )
      )
    )
  )
  best
)

(defun DT--translate-pts (pts dx dy / out p)
  (foreach p pts
    (setq out
      (append out
        (list
          (list (+ (car p) dx) (+ (cadr p) dy) 0.0)
        )
      )
    )
  )
  out
)

(defun DT--snap-poly-ends-to-fitting-blocks (pts width / out p dx dy)
  (setq out pts)
  (if (and out (> (length out) 1))
    (progn
      (setq p (DT--nearest-fitting-center-for-point (car out) width))
      (if p
        (progn
          (setq dx (- (car p) (caar out))
                dy (- (cadr p) (cadar out)))
          (setq out (DT--translate-pts out dx dy))
        )
        (progn
          (setq p (DT--nearest-fitting-center-for-point (g365_last out) width))
          (if p
            (progn
              (setq dx (- (car p) (car (g365_last out)))
                    dy (- (cadr p) (cadr (g365_last out))))
              (setq out (DT--translate-pts out dx dy))
            )
          )
        )
      )
    )
  )
  out
)
(defun DT--delete-existing-fittings-at (pt lay tol / ent ed ip)
  (if (and pt lay (/= lay ""))
    (progn
      (foreach ent (DT--fitting-inserts)
        (setq ed (entget ent)
              ip (if ed (cdr (assoc 10 ed)) nil))
        (if (and ip
                 (= (strcase (cdr (assoc 8 ed))) (strcase lay))
                 (DT--same-active-elevation-p ent)
                 (<= (distance (list (car ip) (cadr ip) 0.0) pt) tol))
          (entdel ent)
        )
      )
    )
  )
)
(defun DT--shapes-need-bulge-p (shapes / hit shape b)
  (foreach shape shapes
    (foreach b (caddr shape)
      (if (and b (> (abs b) 1e-10)) (setq hit T))
    )
  )
  hit
)

(defun DT--block-has-nonzero-bulge-p (name / rec ent ed item hit)
  (setq rec (tblobjname "BLOCK" name))
  (if rec
    (progn
      (setq ent (entnext rec))
      (while (and ent (/= (cdr (assoc 0 (entget ent))) "ENDBLK"))
        (setq ed (entget ent))
        (foreach item ed
          (if (and (= (car item) 42) (> (abs (cdr item)) 1e-10))
            (setq hit T)
          )
        )
        (setq ent (entnext ent))
      )
    )
  )
  hit
)

(defun DT--block-has-hatch-p (name / rec ent hit)
  (setq rec (tblobjname "BLOCK" name))
  (if rec
    (progn
      (setq ent (entnext rec))
      (while (and ent (/= (cdr (assoc 0 (entget ent))) "ENDBLK"))
        (if (= (cdr (assoc 0 (entget ent))) "HATCH")
          (setq hit T)
        )
        (setq ent (entnext ent))
      )
    )
  )
  hit
)

(defun DT--fallback-fitting-block-name (name shapes / needs i candidate)
  (setq needs (DT--shapes-need-bulge-p shapes)
        i 1
        candidate (strcat name "_F"))
  (while
    (and
      (tblsearch "BLOCK" candidate)
      (or
        (not (DT--block-has-hatch-p candidate))
        (and needs (not (DT--block-has-nonzero-bulge-p candidate)))
      )
    )
    (setq i (1+ i)
          candidate (strcat name "_F" (itoa i)))
  )
  candidate
)

(defun DT--stable-fitting-kind-p (kind / value)
  ;; Flexible fittings may have the same angle and maximum width but
  ;; different arm widths. Fixed elbows, T and + fittings are reusable.
  (setq value (strcase (if kind kind "")))
  (not (wcmatch value "ESNEK*"))
)

(defun DT--fitting-definition-cache-key (name)
  (strcase
    (strcat
      (if name name "")
      "|"
      (if (and (> (DT--active-side-height) 0.0)
               (> (DT--plan-material-thickness) 0.0))
        (DT--shell-style-token)
        "NOSHELL")))
)

(defun DT--document-cache-key ()
  (strcase
    (strcat
      (if (getvar "DWGPREFIX") (getvar "DWGPREFIX") "")
      (if (getvar "DWGNAME") (getvar "DWGNAME") "")))
)

(defun DT--ensure-fitting-definition-session-cache (/ key)
  ;; Block definitions already live in the drawing. Keep their verified names
  ;; in session memory so every new DT command does not inspect them again.
  (setq key (DT--document-cache-key))
  (if (or
        (not (boundp '*DT_FITTING_DEFINITION_CACHE_DOCUMENT*))
        (/= *DT_FITTING_DEFINITION_CACHE_DOCUMENT* key))
    (setq *DT_FITTING_DEFINITION_CACHE_DOCUMENT* key
          *DT_FITTING_DEFINITION_CACHE* nil)
    (if (not (boundp '*DT_FITTING_DEFINITION_CACHE*))
      (setq *DT_FITTING_DEFINITION_CACHE* nil)))
  *DT_FITTING_DEFINITION_CACHE*
)

(defun DT--fitting-definition-cache-get (name / rec)
  (if (and name
           (boundp '*DT_FITTING_CACHE_ACTIVE*)
           *DT_FITTING_CACHE_ACTIVE*)
    (progn
      (setq rec
        (assoc
          (DT--fitting-definition-cache-key name)
          *DT_FITTING_DEFINITION_CACHE*))
      (if (and rec
               (tblsearch "BLOCK" (cadr rec))
               (or (null (caddr rec))
                   (tblsearch "BLOCK" (caddr rec))))
        rec)))
)

(defun DT--fitting-definition-cache-put
  (requestedName actualName shellName / key)
  (if (and requestedName
           actualName
           (tblsearch "BLOCK" actualName)
           (boundp '*DT_FITTING_CACHE_ACTIVE*)
           *DT_FITTING_CACHE_ACTIVE*)
    (progn
      (setq key (DT--fitting-definition-cache-key requestedName))
      (if (null (assoc key *DT_FITTING_DEFINITION_CACHE*))
        (setq *DT_FITTING_DEFINITION_CACHE*
          (cons
            (list key actualName shellName)
            *DT_FITTING_DEFINITION_CACHE*)))))
  actualName
)

(defun DT--create-fitting-block-def-vla (name shapes base ang yscale shellName / doc blks blk)
  (vl-load-com)
  (if (and name shapes)
    (progn
      (setq doc  (vla-get-ActiveDocument (vlax-get-acad-object))
            blks (vla-get-Blocks doc)
            blk  (vla-Add blks (vlax-3d-point (list 0.0 0.0 0.0)) name))
      (DT--populate-fitting-block-vla blk shapes base ang yscale shellName)
    )
  )
)

(defun DT--create-fitting-block-def (name shapes base ang yscale shellName / shape local bulges boundary)
  (if (and name shapes)
    (progn
      (entmake
        (list
          (cons 0 "BLOCK")
          (cons 2 name)
          (cons 70 0)
          (cons 10 (list 0.0 0.0 0.0))
        )
      )
      (foreach shape shapes
        (setq local
          (DT--local-pts-xform
            (car shape)
            base
            ang
            yscale
          )
        )
        (setq bulges (DT--local-bulges-xform (caddr shape) yscale))
        (DT--block-poly-entmake local (cadr shape) bulges)
        (setq boundary (entlast))
        (if (cadr shape)
          (DT--block-hatch-entmake local bulges boundary)
        )
      )
      (if shellName (DT--block-shell-insert-entmake shellName))
      (entmake '((0 . "ENDBLK")))
      (DT--block-associate-hatches name)
      T
    )
  )
)
(defun DT--make-fitting-block
  (kind width base shapes ang yscale
    / name requestedName shellName needs ok ins cached cacheRec)
  (setq name          (DT--fitting-block-name kind width)
        requestedName name)
  (if (and name base shapes)
    (progn
      (setq cacheRec
        (if (DT--stable-fitting-kind-p kind)
          (DT--fitting-definition-cache-get requestedName)))
      (if cacheRec
        (setq name      (cadr cacheRec)
              shellName (caddr cacheRec)
              ok        T
              cached    T)
        (progn
          (setq shellName
                  (DT--ensure-fitting-shell-block
                    name shapes base ang yscale)
                needs (DT--shapes-need-bulge-p shapes))
          (if (and shellName
                   (tblsearch "BLOCK" name)
                   (not (DT--block-references-block-p name shellName)))
            (setq name (strcat name "_O2")))
          (cond
            ((and
               (tblsearch "BLOCK" name)
               (DT--stable-fitting-kind-p kind)
               (DT--block-has-hatch-p name)
               (or (not needs) (DT--block-has-nonzero-bulge-p name))
               (or (not shellName)
                   (DT--block-references-block-p name shellName)))
              (setq ok T cached T))
            ((not (tblsearch "BLOCK" name))
              (DT--create-fitting-block-def
                name shapes base ang yscale shellName))
            (T
              (setq ok
                (vl-catch-all-apply
                  'DT--redefine-fitting-block
                  (list name shapes base ang yscale shellName)))
              (if
                (not
                  (and
                    (not (vl-catch-all-error-p ok))
                    ok
                    (DT--block-has-hatch-p name)
                    (or
                      (not needs)
                      (DT--block-has-nonzero-bulge-p name))))
                (progn
                  (setq name
                    (DT--fallback-fitting-block-name name shapes))
                  (if (not (tblsearch "BLOCK" name))
                    (DT--create-fitting-block-def
                      name shapes base ang yscale shellName)
                    (progn
                      (setq ok
                        (vl-catch-all-apply
                          'DT--redefine-fitting-block
                          (list
                            name shapes base ang yscale shellName)))
                      (if (or
                            (vl-catch-all-error-p ok)
                            (not ok))
                        nil)))
                ))
            ))
          (if (not cached)
            (progn
              (if shellName
                (DT--set-block-linework-050 shellName))
              (DT--block-associate-hatches name)
              (DT--set-block-linework-050 name)))
          (if (DT--stable-fitting-kind-p kind)
            (DT--fitting-definition-cache-put
              requestedName name shellName))
        )
      )
      (setq ins
        (entmakex
          (list
            (cons 0 "INSERT")
            (cons 2 name)
            (cons 8 (DT--layer-fitting))
             (cons 10 (DT--point-at-elevation base (DT--active-elevation)))
            (cons 41 1.0)
            (cons 42 yscale)
            (cons 43 1.0)
            (cons 50 ang)
          )
        )
      )
      (DT--mark-fitting-insert ins kind width)
      (DT--apply-fitting-3d-mode ins (DT--active-3d-enabled-p))
      ins
    )
  )
)

(defun DT--raise-pts (pts height / out p)
  (foreach p pts
    (setq out
      (append out
        (list
          (list
            (car p)
            (cadr p)
            (+ (if (caddr p) (caddr p) 0.0) height)))))
  )
  out
)

(defun DT--block-raised-outline3d (pts / height topPts p topP)
  (setq height (DT--active-side-height))
  (if (and pts (> height 0.0))
    (progn
      (setq topPts (DT--raise-pts pts height))
      (DT--make-poly3d (DT--layer-linework) topPts T)
      (while pts
        (setq p    (car pts)
              topP (car topPts))
        (DT--block-line-entmake p topP)
        (setq pts    (cdr pts)
              topPts (cdr topPts))
      )
    )
  )
)

(defun DT--elevation-arc-required-p (slope / limit)
  ;; Paletten girilen esik gecilince esnek govde ve dik ara tava kullanilir.
  (setq limit
    (* pi
       (/ (DT--active-elevation-angle) 180.0)))
  (> (abs (atan slope)) (+ limit 1e-9))
)

(defun DT--elevation-linear-profile-points (newWidth oldWidth span slope / oldHalf newHalf)
  (setq oldHalf (/ oldWidth 2.0)
        newHalf (/ newWidth 2.0))
  (list
    (list
      (list (- span) oldHalf (* (- span) slope))
      (list span newHalf (* span slope)))
    (list
      (list (- span) (- oldHalf) (* (- span) slope))
      (list span (- newHalf) (* span slope))))
)

(defun DT--elevation-profile-points (newWidth oldWidth span slope divisions / count i ratio run absSlope direction theta sinTheta radius rise startZ centerZ startAngle angle x half z upper lower)
  ;; Tek yonlu dairesel dusuy kurp: eski yatay tavaya ve yeni egimli
  ;; orta tavaya tegettir. Orta tavanin ucu, bu profilin +span ucuna
  ;; tasindigi icin egri geri donmez ve block altinda duz parca kalmaz.
  (setq count    (max 4 (fix divisions))
        run      (* 2.0 span)
        absSlope (abs slope)
        i        0)
  (if (< absSlope 1e-8)
    (DT--elevation-linear-profile-points newWidth oldWidth span slope)
    (progn
      (setq direction  (if (< slope 0.0) -1.0 1.0)
            theta      (atan absSlope)
            sinTheta   (sin theta)
            radius     (/ run sinTheta)
            rise       (* direction radius (- 1.0 (cos theta)))
            startZ     (/ (- rise) 2.0)
            centerZ    (+ startZ (* direction radius))
            startAngle (* (- direction) (/ pi 2.0)))
      (while (<= i count)
        (setq ratio (/ (float i) count)
              angle (+ startAngle (* direction theta ratio))
              x     (+ (- span) (* radius (cos angle)))
              z     (+ centerZ (* radius (sin angle)))
              half  (+ (/ oldWidth 2.0)
                       (* (- (/ newWidth 2.0) (/ oldWidth 2.0)) ratio))
              upper (append upper (list (list x half z)))
              lower (append lower (list (list x (- half) z)))
              i     (1+ i)))
      (list upper lower))
  )
)

(defun DT--profile-shift-y (pts amount / out p)
  (foreach p pts
    (setq out
      (append out
        (list (list (car p) (+ (cadr p) amount) (if (caddr p) (caddr p) 0.0))))))
  out
)

(defun DT--profile-offset-normal-xz (pts amount / count i p before after dx dz tangentLen nx nz out)
  ;; Elevation profilini her noktadaki yerel tegete dik tasir. Boylece
  ;; egri diklesse bile yanak yuksekligi ve malzeme kalinligi sabit kalir.
  (setq count (length pts)
        i 0)
  (while (< i count)
    (setq p (nth i pts)
          before (if (> i 0) (nth (1- i) pts) p)
          after  (if (< i (1- count)) (nth (1+ i) pts) p))
    (cond
      ((and (= i 0) (>= count 3))
        (setq dx (+ (* -3.0 (car p))
                    (*  4.0 (car (nth 1 pts)))
                    (- (car (nth 2 pts))))
              dz (+ (* -3.0 (if (caddr p) (caddr p) 0.0))
                    (*  4.0 (if (caddr (nth 1 pts)) (caddr (nth 1 pts)) 0.0))
                    (- (if (caddr (nth 2 pts)) (caddr (nth 2 pts)) 0.0)))))
      ((and (= i (1- count)) (>= count 3))
        (setq dx (+ (*  3.0 (car p))
                    (* -4.0 (car (nth (- count 2) pts)))
                    (car (nth (- count 3) pts)))
              dz (+ (*  3.0 (if (caddr p) (caddr p) 0.0))
                    (* -4.0 (if (caddr (nth (- count 2) pts))
                              (caddr (nth (- count 2) pts)) 0.0))
                    (if (caddr (nth (- count 3) pts))
                      (caddr (nth (- count 3) pts)) 0.0))))
      (T
        (setq dx (- (car after) (car before))
              dz (- (if (caddr after) (caddr after) 0.0)
                    (if (caddr before) (caddr before) 0.0)))))
    (setq tangentLen (sqrt (+ (* dx dx) (* dz dz))))
    (if (< tangentLen 1e-9)
      (setq nx 0.0 nz 1.0)
      (setq nx (/ (- dz) tangentLen)
            nz (/ dx tangentLen)))
    (if (< nz 0.0)
      (setq nx (- nx) nz (- nz)))
    (setq out
      (append
        out
        (list
          (list
            (+ (car p) (* amount nx))
            (cadr p)
            (+ (if (caddr p) (caddr p) 0.0) (* amount nz)))))
      i (1+ i)))
  out
)

(defun DT--block-elevation-curved-geometry (newWidth oldWidth span slope arcP / profile upper lower sideHeight thickness innerUpper innerLower floorUpper floorLower topUpper topLower innerTopUpper innerTopLower i n *DT_BLOCK_FACE_UNASSOC*)
  (setq *DT_BLOCK_FACE_UNASSOC* arcP
        profile    (if arcP
                     (DT--elevation-profile-points newWidth oldWidth span slope 8)
                     (DT--elevation-linear-profile-points newWidth oldWidth span slope))
        upper      (car profile)
        lower      (cadr profile)
        sideHeight (DT--active-side-height)
        thickness
          (min
            (DT--plan-material-thickness)
            (* sideHeight 0.45)
            (* newWidth 0.45)
            (* oldWidth 0.45)))
  (if (and upper lower)
    (progn
      (if (and (> sideHeight 0.0) (> thickness 0.0))
        (setq innerUpper   (DT--profile-shift-y upper (- thickness))
              innerLower   (DT--profile-shift-y lower thickness)
              floorUpper   (DT--profile-offset-normal-xz innerUpper thickness)
              floorLower   (DT--profile-offset-normal-xz innerLower thickness)
              topUpper     (DT--profile-offset-normal-xz upper sideHeight)
              topLower     (DT--profile-offset-normal-xz lower sideHeight)
              innerTopUpper (DT--profile-offset-normal-xz innerUpper sideHeight)
              innerTopLower (DT--profile-offset-normal-xz innerLower sideHeight)))
      (setq i 0
            n (length upper))
      (while (< i (1- n))
        ;; 10: enine parca sinirlarini gizler; iki baglanti ucu acik kalir.
        (DT--block-face-hatched-flags
          (list (nth i upper) (nth (1+ i) upper)
                (nth (1+ i) lower) (nth i lower)) 10)
        (if floorUpper
          (progn
            (DT--block-face-hatched-flags
              (list (nth i floorUpper) (nth (1+ i) floorUpper)
                    (nth (1+ i) floorLower) (nth i floorLower)) 10)
            (DT--block-face-hatched-flags
              (list (nth i upper) (nth (1+ i) upper)
                    (nth (1+ i) topUpper) (nth i topUpper)) 10)
            (DT--block-face-hatched-flags
              (list (nth i floorUpper) (nth (1+ i) floorUpper)
                    (nth (1+ i) innerTopUpper) (nth i innerTopUpper)) 10)
            (DT--block-face-hatched-flags
              (list (nth i topUpper) (nth (1+ i) topUpper)
                    (nth (1+ i) innerTopUpper) (nth i innerTopUpper)) 10)
            (DT--block-face-hatched-flags
              (list (nth i lower) (nth (1+ i) lower)
                    (nth (1+ i) topLower) (nth i topLower)) 10)
            (DT--block-face-hatched-flags
              (list (nth i floorLower) (nth (1+ i) floorLower)
                    (nth (1+ i) innerTopLower) (nth i innerTopLower)) 10)
            (DT--block-face-hatched-flags
              (list (nth i topLower) (nth (1+ i) topLower)
                    (nth (1+ i) innerTopLower) (nth i innerTopLower)) 10)))
        (setq i (1+ i)))
      T)
  )
)

(defun DT--create-elevation-fitting-block-def (name newWidth oldWidth span slope arcP)
  (if (and name
           (numberp newWidth)
           (numberp oldWidth)
           (numberp span)
           (> span 0.0)
           (numberp slope))
    (progn
      (entmake
        (list
          '(0 . "BLOCK")
          (cons 2 name)
          '(70 . 0)
          '(10 0.0 0.0 0.0)))
      (DT--block-elevation-curved-geometry newWidth oldWidth span slope arcP)
      (entmake '((0 . "ENDBLK")))
      (if (not arcP) (DT--block-associate-hatches name))
      T
    )
  )
)

(defun DT--make-elevation-fitting-block-span
  (kind newWidth oldWidth base dir slope spanOverride / span arcP slopeKind name ins)
  (setq span      (if (and (numberp spanOverride) (> spanOverride 0.001))
                    spanOverride
                    (max newWidth oldWidth))
        arcP      (DT--elevation-arc-required-p slope)
        slopeKind (strcat kind
                    (if arcP "_3D_ARC8_OPEN_TAN_C5N_S_H2" "_3D_LINEAR_OPEN_N_S")
                    (DT--width-name slope) (DT--shell-style-token))
        name       (DT--fitting-block-name slopeKind span))
  (if (and name base dir (> span 0.0))
    (progn
      (if (not (tblsearch "BLOCK" name))
        (DT--create-elevation-fitting-block-def name newWidth oldWidth span slope arcP))
      (if (not arcP) (DT--block-associate-hatches name))
      (DT--set-block-linework-050 name)
      (setq ins
        (entmakex
          (list
            '(0 . "INSERT")
            (cons 2 name)
            (cons 8 (DT--layer-fitting))
            (cons 10 (DT--point-at-elevation base (DT--active-elevation)))
            '(41 . 1.0)
            '(42 . 1.0)
            '(43 . 1.0)
            (cons 50 (DT--vec-angle dir)))))
      (DT--mark-fitting-insert ins kind span)
      (DT--apply-fitting-3d-mode ins (DT--active-3d-enabled-p))
      ins
    )
  )
)

(defun DT--make-elevation-fitting-block
  (kind newWidth oldWidth base dir slope)
  (DT--make-elevation-fitting-block-span
    kind newWidth oldWidth base dir slope nil)
)
(defun DT--simplify-pts (pts / out i a b c u1 u2 dotv)
  (if (< (length pts) 3)
    pts
    (progn
      (setq out (list (car pts)) i 1)
      (while (< i (1- (length pts)))
        (setq a (g365_last out)
              b (nth i pts)
              c (nth (1+ i) pts)
              u1 (DT--seg-unit a b)
              u2 (DT--seg-unit b c)
              dotv (g365_dot (car u1) (cadr u1) (car u2) (cadr u2)))
        (if (< dotv 0.9999)
          (setq out (append out (list b)))
        )
        (setq i (1+ i))
      )
      (append out (list (g365_last pts)))
    )
  )
)

(defun DT--corner-records (pts width / out i a b c u1 u2 dotv d)
  (setq i 1)
  (while (< i (1- (length pts)))
    (setq a (nth (1- i) pts)
          b (nth i pts)
          c (nth (1+ i) pts)
          u1 (DT--seg-unit a b)
          u2 (DT--seg-unit b c)
          dotv (g365_dot (car u1) (cadr u1) (car u2) (cadr u2)))
    (if (and (< dotv 0.999) (> dotv -0.999))
      (progn
        (setq d (min width (* 0.35 (distance a b)) (* 0.35 (distance b c))))
        (if (> d 0.01)
          (setq out (append out (list (list i b u1 u2 d))))
        )
      )
    )
    (setq i (1+ i))
  )
  out
)

(defun DT--corner-at (corners idx / found rec)
  (foreach rec corners
    (if (= (car rec) idx) (setq found rec))
  )
  found
)

(defun DT--face-data-flags (lay p1 p2 p3 p4 flags)
  (if (and p1 p2 p3 p4)
    (list
      '(0 . "3DFACE")
      '(100 . "AcDbEntity")
      (cons 8 lay)
      '(370 . 30)
      '(100 . "AcDbFace")
      (cons 10 p1)
      (cons 11 p2)
      (cons 12 p3)
      (cons 13 p4)
      (cons 70 (if (numberp flags) (fix flags) 0)))
  )
)

(defun DT--face-data (lay p1 p2 p3 p4)
  (DT--face-data-flags lay p1 p2 p3 p4 0)
)

(defun DT--make-3d-face (lay p1 p2 p3 p4 / data)
  (setq data (DT--face-data lay p1 p2 p3 p4))
  (if data (entmakex data))
)

(defun DT--make-plane-hatch (boundary lay pts / data hatch)
  (setq data
    (DT--hatch-data-plane-assoc
      lay
      pts
      (DT--mode-hatch-pattern *DT_ACTIVE_MODE*)
      (DT--mode-hatch-color *DT_ACTIVE_MODE*)
      boundary))
  (if data
    (progn
      ;; 3DFACE sinirli hatchler blok tanimi icinde ENTMAKEX ile sessizce
      ;; reddedilebiliyor. ENTMAKE mevcut BLOCK baglaminda hatchi korur.
      (if (entmake data) (setq hatch (entlast)))
      (if hatch (DT--hatch-set-source hatch boundary))))
)

(defun DT--quad-planar-p (pts / p0 p1 p2 p3 normal span deviation)
  (if (= (length pts) 4)
    (progn
      (setq p0     (nth 0 pts)
            p1     (nth 1 pts)
            p2     (nth 2 pts)
            p3     (nth 3 pts)
            normal (DT--unit3
                     (DT--cross3
                       (DT--vec3-sub p1 p0)
                       (DT--vec3-sub p3 p0)))
            span   (max (distance p0 p1)
                        (distance p1 p2)
                        (distance p2 p3)
                        (distance p3 p0)
                        1.0))
      (if normal
        (progn
          (setq deviation
            (abs
              (+ (* (car normal)   (- (car p2)   (car p0)))
                 (* (cadr normal)  (- (cadr p2)  (cadr p0)))
                 (* (caddr normal) (- (caddr p2) (caddr p0))))))
          (<= deviation (* span 1e-7)))
        nil))
    T)
)

(defun DT--mid3 (a b)
  (list
    (/ (+ (car a) (car b)) 2.0)
    (/ (+ (cadr a) (cadr b)) 2.0)
    (/ (+ (if (caddr a) (caddr a) 0.0)
          (if (caddr b) (caddr b) 0.0)) 2.0))
)

(defun DT--block-face-hatched-make (pts flags associativeP / data boundary p3 p4)
  (if (and pts (= (length pts) 4))
    (progn
      (setq p3 (nth 2 pts)
            p4 (nth 3 pts))
      (entmake
        (DT--face-data-flags
          (DT--layer-linework)
          (nth 0 pts) (nth 1 pts) p3 p4
          flags))
      (setq boundary (entlast)
            data
              (if associativeP
                (DT--hatch-data-plane-assoc
                  (DT--layer-fitting)
                  pts
                  (DT--mode-hatch-pattern *DT_ACTIVE_MODE*)
                  (DT--mode-hatch-color *DT_ACTIVE_MODE*)
                  boundary)
                (DT--hatch-data-plane
                  (DT--layer-fitting)
                  pts
                  (DT--mode-hatch-pattern *DT_ACTIVE_MODE*)
                  (DT--mode-hatch-color *DT_ACTIVE_MODE*))))
      (if data (entmake data)))
  )
)

(defun DT--make-plane-hatch-unassoc (lay pts / data hatch)
  (setq data
    (DT--hatch-data-plane
      lay
      pts
      (DT--mode-hatch-pattern *DT_ACTIVE_MODE*)
      (DT--mode-hatch-color *DT_ACTIVE_MODE*)))
  (if (and data
           (boundp '*DT_BLOCK_HATCH_ASSOC_MARKER*)
           *DT_BLOCK_HATCH_ASSOC_MARKER*
           (assoc 71 data))
    (setq data (subst '(71 . 1) (assoc 71 data) data)))
  ;; Keep the associative marker expected by tray tooling on horizontal visual
  ;; blocks without adding the 3DFACE source handle that crashes AutoCAD.
  ;; Controller STRETCH rebuilds inclined visuals, so their hatch still follows.
  (if (and data (entmake data)) (setq hatch (entlast)))
  hatch
)

(defun DT--block-face-hatched-flags (pts flags)
  (cond
    ;; Kavisli elevation yuzlerindeki dort kose ayni duzlemde olmayabilir.
    ;; AutoCAD bu dortgenlere HATCH olusturmaz; iki duzlemsel ucgene bol.
    ((and pts (= (length pts) 4) (not (DT--quad-planar-p pts)))
      (DT--block-face-hatched-make
        (list
          (nth 0 pts) (nth 1 pts) (nth 2 pts)
          (DT--mid3 (nth 2 pts) (nth 0 pts)))
        flags nil)
      (DT--block-face-hatched-make
        (list
          (nth 0 pts) (nth 2 pts) (nth 3 pts)
          (DT--mid3 (nth 3 pts) (nth 0 pts)))
        flags nil))
    ((and pts (= (length pts) 4))
      (DT--block-face-hatched-make
        pts flags
        (not
          (and (boundp '*DT_BLOCK_FACE_UNASSOC*)
               *DT_BLOCK_FACE_UNASSOC*))))
  )
)

(defun DT--block-face-hatched (pts)
  (DT--block-face-hatched-flags pts 0)
)

(defun DT--polygon-area2 (pts / out i a b n)
  (setq out 0.0
        i   0
        n   (length pts))
  (while (< i n)
    (setq a (nth i pts)
          b (nth (rem (1+ i) n) pts)
          out (+ out (- (* (car a) (cadr b)) (* (car b) (cadr a))))
          i (1+ i)))
  out
)

(defun DT--inset-closed-pts (pts amount / side n i prev cur next u1 u2 n1 n2 a1 b1 a2 b2 ip avg out)
  (if (and pts (>= (length pts) 3) (numberp amount) (> amount 0.0))
    (progn
      (setq side (if (> (DT--polygon-area2 pts) 0.0) 1.0 -1.0)
            n    (length pts)
            i    0)
      (while (< i n)
        (setq prev (nth (rem (+ i n -1) n) pts)
              cur  (nth i pts)
              next (nth (rem (1+ i) n) pts)
              u1   (DT--seg-unit prev cur)
              u2   (DT--seg-unit cur next)
              n1   (DT--perp u1)
              n2   (DT--perp u2)
              a1   (DT--pt+ prev n1 (* side amount))
              b1   (DT--pt+ cur  n1 (* side amount))
              a2   (DT--pt+ cur  n2 (* side amount))
              b2   (DT--pt+ next n2 (* side amount))
              ip   (g365_line_inter a1 b1 a2 b2))
        (if (or (null ip) (> (distance cur ip) (* amount 8.0)))
          (progn
            (setq avg (g365_unit
                        (+ (* side (car n1)) (* side (car n2)))
                        (+ (* side (cadr n1)) (* side (cadr n2)))))
            (setq ip (if avg (DT--pt+ cur avg amount) b1)))
        )
        (setq out (append out (list ip))
              i   (1+ i))
      )
      out
    )
  )
)

(defun DT--plane-z-at (pt planePts / normal p0 nz)
  (setq normal (DT--plane-normal planePts)
        p0     (car planePts)
        nz     (if normal (caddr normal) 0.0))
  (if (and normal p0 (> (abs nz) 1e-9))
    (- (if (caddr p0) (caddr p0) 0.0)
       (/ (+ (* (car normal) (- (car pt) (car p0)))
             (* (cadr normal) (- (cadr pt) (cadr p0))))
          nz))
    (if (and p0 (caddr p0)) (caddr p0) 0.0)
  )
)

(defun DT--pts-on-plane (xyPts planePts / out p)
  (foreach p xyPts
    (setq out
      (append out
        (list (list (car p) (cadr p) (DT--plane-z-at p planePts))))))
  out
)

(defun DT--pt-shift-xy (p u d)
  (list
    (+ (car p) (* (car u) d))
    (+ (cadr p) (* (cadr u) d))
    (if (caddr p) (caddr p) 0.0))
)

(defun DT--pt-shift-3d (p u d)
  (list
    (+ (car p) (* (car u) d))
    (+ (cadr p) (* (cadr u) d))
    (+ (if (caddr p) (caddr p) 0.0) (* (caddr u) d)))
)

(defun DT--set-list-item (lst idx value / out i item)
  (setq i 0)
  (foreach item lst
    (setq out (append out (list (if (= i idx) value item)))
          i (1+ i))
  )
  out
)

(defun DT--floor-points-at-open-ports (innerPts outerPts openEdges / out n edge next)
  ;; Hacim tabani kapali kenarlarda iceride kalir, acik portta tava ucuna kadar uzar.
  (setq out innerPts
        n   (min (length innerPts) (length outerPts)))
  (foreach edge openEdges
    (if (and (numberp edge) (>= edge 0) (< edge n))
      (progn
        (setq next (rem (1+ edge) n)
              out  (DT--set-list-item out edge (nth edge outerPts))
              out  (DT--set-list-item out next (nth next outerPts)))
      )
    )
  )
  out
)

(defun DT--side-inner-points-at-open-ports (innerPts outerPts openEdges / out n edge next a b rec)
  ;; Ic yanak uclari port duzlemine gelir; port kesiti acik kalmaya devam eder.
  (setq out innerPts
        n   (min (length innerPts) (length outerPts)))
  (foreach edge openEdges
    (if (and (numberp edge) (>= edge 0) (< edge n))
      (progn
        (setq next (rem (1+ edge) n)
              a    (nth edge outerPts)
              b    (nth next outerPts)
              rec  (g365_closest_on_seg (nth edge out) a b))
        (if rec (setq out (DT--set-list-item out edge (car rec))))
        (setq rec (g365_closest_on_seg (nth next out) a b))
        (if rec (setq out (DT--set-list-item out next (car rec))))
      )
    )
  )
  out
)

(defun DT--block-shell-geometry-open (outerPts skipEdges / sideHeight thickness xy insetXY rawInnerPts innerPts floorPts floorTop innerFloorTop outerTop innerTop floorBoundary floorHatch i n a b ia ib)
  (setq sideHeight (DT--active-side-height)
        thickness  (min (DT--plan-material-thickness) (* sideHeight 0.45)))
  (if (and outerPts (>= (length outerPts) 3) (> sideHeight 0.0) (> thickness 0.0))
    (progn
      (setq xy      (mapcar '(lambda (p) (list (car p) (cadr p) 0.0)) outerPts)
            insetXY (DT--inset-closed-pts xy thickness)
            rawInnerPts (if insetXY (DT--pts-on-plane insetXY outerPts) nil)
            innerPts (if rawInnerPts
                       (DT--side-inner-points-at-open-ports
                         rawInnerPts outerPts skipEdges)
                       nil)
            floorPts (if innerPts
                       (DT--floor-points-at-open-ports innerPts outerPts skipEdges)
                       nil)
            floorTop (if floorPts (DT--raise-pts floorPts thickness) nil)
            innerFloorTop (if innerPts (DT--raise-pts innerPts thickness) nil)
            outerTop (DT--raise-pts outerPts sideHeight)
            innerTop (if innerPts (DT--raise-pts innerPts sideHeight) nil))
      (if (and floorTop (>= (length floorTop) 3))
        (progn
          (setq floorBoundary (DT--make-poly3d (DT--layer-linework) floorTop T)
                floorHatch
                  (DT--hatch-data-plane-assoc
                    (DT--layer-fitting)
                    floorTop
                    (DT--mode-hatch-pattern *DT_ACTIVE_MODE*)
                    (DT--mode-hatch-color *DT_ACTIVE_MODE*)
                    floorBoundary))
          (if floorHatch (entmake floorHatch))
        )
      )
      (if (and innerPts innerTop (= (length outerPts) (length innerPts)))
        (progn
          (setq i 0 n (length outerPts))
          (while (< i n)
            (setq a  (nth i outerPts)
                  b  (nth (rem (1+ i) n) outerPts)
                  ia (nth i innerPts)
                  ib (nth (rem (1+ i) n) innerPts))
            (if (not (member i skipEdges))
              (progn
                (DT--block-face-hatched
                  (list a b (nth (rem (1+ i) n) outerTop) (nth i outerTop)))
                (DT--block-face-hatched
                  (list (nth i innerFloorTop)
                        (nth (rem (1+ i) n) innerFloorTop)
                        (nth (rem (1+ i) n) innerTop)
                        (nth i innerTop)))
                (DT--block-face-hatched
                  (list (nth i outerTop)
                        (nth (rem (1+ i) n) outerTop)
                        (nth (rem (1+ i) n) innerTop)
                        (nth i innerTop)))))
            (setq i (1+ i))
          )
        )
      )
      T
    )
  )
)

(defun DT--block-shell-geometry (outerPts)
  (DT--block-shell-geometry-open outerPts nil)
)

(defun DT--shell-style-token (/ pattern color scale thickness)
  (setq pattern   (car (DT--hatch-pattern-info (DT--mode-hatch-pattern *DT_ACTIVE_MODE*)))
        color     (DT--mode-hatch-color *DT_ACTIVE_MODE*)
        scale     (DT--hatch-scale)
        thickness (DT--plan-material-thickness))
  (strcat
    "$T" (DT--width-name thickness)
    "$P" (DT--name-safe pattern)
    "$C" (itoa color)
    "$S" (DT--width-name scale))
)

(defun DT--fitting-shell-block-name (fittingName)
  (strcat "DT$SHELL$" (DT--name-safe fittingName) (DT--shell-style-token) "$OPEN4")
)

(defun DT--create-fitting-shell-block (shellName shapes base ang yscale / shape local bulges flat ports localPorts openEdges made)
  (if (and shellName shapes)
    (progn
      (entmake
        (list
          '(0 . "BLOCK")
          (cons 2 shellName)
          '(70 . 0)
          '(10 0.0 0.0 0.0)))
      (foreach shape shapes
        (if (cadr shape)
          (progn
            (setq local
              (DT--local-pts-xform (car shape) base ang yscale)
                  bulges (DT--local-bulges-xform (caddr shape) yscale)
                  flat   (if bulges (DT--flatten-bulged-pts local bulges) local)
                  ports  (nth 3 shape)
                  localPorts (if ports (DT--local-pts-xform ports base ang yscale) nil)
                  openEdges (if localPorts
                              (DT--fitting-port-open-edges flat localPorts)
                              (DT--fitting-flat-open-edges local bulges flat)))
            (if (DT--block-shell-geometry-open flat openEdges) (setq made T))
          )
        )
      )
      (entmake '((0 . "ENDBLK")))
      (DT--block-associate-hatches shellName)
      made
    )
  )
)

(defun DT--ensure-fitting-shell-block (fittingName shapes base ang yscale / shellName created)
  (if (and (> (DT--active-side-height) 0.0)
           (> (DT--plan-material-thickness) 0.0))
    (progn
      (setq shellName (DT--fitting-shell-block-name fittingName))
      (if (not (tblsearch "BLOCK" shellName))
        (if (DT--create-fitting-shell-block shellName shapes base ang yscale)
          (setq created T)
          (setq shellName nil)))
      (if (and shellName created)
        (progn
          (DT--block-associate-hatches shellName)
          (DT--set-block-linework-050 shellName)))
      shellName
    )
  )
)

(defun DT--make-model-face-hatched (lay pts / data face hatch)
  (if (and pts (= (length pts) 4))
    (progn
      ;; Yuz ve hatch ayni BLOCK/model baglaminda ardisik olusmali.
      ;; ENTMAKEX ile uretilen 3DFACE blokta gorunse de associative hatch
      ;; kaynak siniri olarak kabul edilmeyebiliyor.
      (setq data
        (DT--face-data
          (DT--line-layer-name lay)
          (nth 0 pts) (nth 1 pts) (nth 2 pts) (nth 3 pts)))
      (if (and data (entmake data)) (setq face (entlast)))
      (setq hatch
        (if (and (boundp '*DT_BLOCK_FACE_UNASSOC*)
                 *DT_BLOCK_FACE_UNASSOC*)
          (DT--make-plane-hatch-unassoc lay pts)
          (DT--make-plane-hatch face lay pts)))
      (list face hatch)
    )
  )
)

(defun DT--make-tray-sidewalls (tray p1 p2 p3 p4 / height thickness width inwardL inwardR floorNormal inner1 inner2 inner3 inner4 fp1 fp2 fp3 fp4 op1 op2 op3 op4 il1 il2 il3 il4 it1 it2 it3 it4 faces rec face hatch walls hatches)
  (setq height    (DT--active-side-height)
        width     (distance p1 p4)
        thickness (min (DT--plan-material-thickness) (* height 0.45) (* width 0.45)))
  (if (and tray (> height 0.0) (> thickness 0.0))
    (progn
      (setq inwardL (DT--seg-unit p1 p4)
            inwardR (DT--seg-unit p4 p1)
            floorNormal (DT--plane-normal (list p1 p4 p2))
            floorNormal (if floorNormal floorNormal '(0.0 0.0 1.0))
            inner1 (DT--pt-shift-xy p1 inwardL thickness)
            inner2 (DT--pt-shift-xy p2 inwardL thickness)
            inner3 (DT--pt-shift-xy p3 inwardR thickness)
            inner4 (DT--pt-shift-xy p4 inwardR thickness)
            fp1 (DT--pt-shift-3d p1 floorNormal thickness)
            fp2 (DT--pt-shift-3d p2 floorNormal thickness)
            fp3 (DT--pt-shift-3d p3 floorNormal thickness)
            fp4 (DT--pt-shift-3d p4 floorNormal thickness)
            op1 (DT--pt-shift-3d p1 floorNormal height)
            op2 (DT--pt-shift-3d p2 floorNormal height)
            op3 (DT--pt-shift-3d p3 floorNormal height)
            op4 (DT--pt-shift-3d p4 floorNormal height)
            il1 (DT--pt-shift-3d inner1 floorNormal thickness)
            il2 (DT--pt-shift-3d inner2 floorNormal thickness)
            il3 (DT--pt-shift-3d inner3 floorNormal thickness)
            il4 (DT--pt-shift-3d inner4 floorNormal thickness)
            it1 (DT--pt-shift-3d inner1 floorNormal height)
            it2 (DT--pt-shift-3d inner2 floorNormal height)
            it3 (DT--pt-shift-3d inner3 floorNormal height)
            it4 (DT--pt-shift-3d inner4 floorNormal height)
            faces
              (list
                (list fp1 fp2 fp3 fp4)
                (list p1 p4 fp4 fp1)
                (list p2 p3 fp3 fp2)
                (list p1 p2 op2 op1)
                (list p4 p3 op3 op4)
                (list il1 il2 it2 it1)
                (list il4 il3 it3 it4)
                (list op1 op2 it2 it1)
                (list op4 op3 it3 it4)
                ;; Tava ucundaki iki yanak kesitini de kapat.
                (list p1 op1 it1 il1)
                (list p4 op4 it4 il4)
                (list p2 op2 it2 il2)
                (list p3 op3 it3 il3)))
      (foreach rec faces
        (setq rec   (DT--make-model-face-hatched (DT--layer-visible) rec)
              face  (car rec)
              hatch (cadr rec))
        (if face  (setq walls   (append walls (list face))))
        (if hatch (setq hatches (append hatches (list hatch)))))
      (if walls (DT--xdata-link-sidewalls tray walls))
      (foreach hatch hatches (DT--xdata-link-hatch tray hatch))
      walls
    )
  )
)

(defun DT--make-straight-piece (a b width / u n h p1 p2 p3 p4 ent hatch pts zA zB oldElevation)
  (if (> (distance a b) 0.001)
    (progn
      (setq u (DT--seg-unit a b)
            n (DT--perp u)
            h (/ width 2.0)
            zA (DT--build-elevation-at-point a)
            zB (DT--build-elevation-at-point b)
            p1 (DT--point-at-elevation (DT--pt+ a n h) zA)
            p2 (DT--point-at-elevation (DT--pt+ b n h) zB)
            p3 (DT--point-at-elevation (DT--pt+ b n (- h)) zB)
            p4 (DT--point-at-elevation (DT--pt+ a n (- h)) zA)
            pts (list p1 p2 p3 p4))
      (if (and (boundp '*DT_LIVE_PREVIEW_LIGHTWEIGHT*)
               *DT_LIVE_PREVIEW_LIGHTWEIGHT*)
        ;; Canli cizimde yalniz kontur yeterlidir. Hatch, yanak ve grup her
        ;; tiklamada silinip yeniden uretilirse AutoCAD undo/veritabani sisiyordu.
        (setq ent
          (if (equal zA zB 0.000001)
            (progn
              (setq oldElevation (DT--active-elevation)
                    *DT_ACTIVE_ELEVATION* zA
                    ent (DT--make-poly (DT--layer-linework) pts T)
                    *DT_ACTIVE_ELEVATION* oldElevation)
              ent)
            (DT--make-poly3d (DT--layer-linework) pts T)))
        (if (equal zA zB 0.000001)
          (progn
            (setq oldElevation (DT--active-elevation)
                  *DT_ACTIVE_ELEVATION* zA
                  ent (DT--make-poly (DT--layer-linework) pts T))
            (if ent
              (setq hatch
                (DT--make-assoc-hatch
                  ent
                  (DT--layer-visible)
                  pts
                  (DT--mode-hatch-pattern *DT_ACTIVE_MODE*)
                  (DT--mode-hatch-color *DT_ACTIVE_MODE*)))
            )
            (setq *DT_ACTIVE_ELEVATION* oldElevation)
          )
          (progn
            (setq ent (DT--make-poly3d (DT--layer-linework) pts T))
            (if ent
              (setq hatch
                (DT--make-assoc-hatch-plane
                  ent
                  (DT--layer-visible)
                  pts
                  (DT--mode-hatch-pattern *DT_ACTIVE_MODE*)
                  (DT--mode-hatch-color *DT_ACTIVE_MODE*)))
            )
          )
        )
      )
      (if (and ent hatch)
        (DT--xdata-link-hatch ent hatch)
      )
      (if (and ent
               (not
                 (and (boundp '*DT_LIVE_PREVIEW_LIGHTWEIGHT*)
                      *DT_LIVE_PREVIEW_LIGHTWEIGHT*)))
        (progn
          (DT--make-tray-sidewalls ent p1 p2 p3 p4)
          (DT--refresh-tray-group ent)))
      ent
    )
  )
)
(defun DT--turn-kind (u1 u2 / radians degrees rounded baseName)
  (setq radians (atan (abs (DT--cross2 u1 u2)) (g365_dot (car u1) (cadr u1) (car u2) (cadr u2))))
  (setq degrees (* 180.0 (/ radians pi)))
  (setq rounded (fix (+ degrees 0.5)))
  (setq baseName (strcat "d" (chr 246) "n" (chr 252) (chr 254)))
  (if (<= (abs (- degrees 90.0)) 0.1) baseName
    (strcat baseName "_A" (itoa rounded))
  )
)

(defun DT--90-turn-p (u1 u2)
  (<= (abs (g365_dot (car u1) (cadr u1) (car u2) (cadr u2))) 0.001)
)

(defun DT--rounded-turn-shape (b u1 u2 radius width / h s n1 n2 q1 q2 p1 p2 p3 p4 k)
  (setq h  (/ width 2.0)
        s  (if (< (DT--cross2 u1 u2) 0.0) -1.0 1.0)
        n1 (DT--perp u1)
        n2 (DT--perp u2)
        q1 (DT--pt+ b u1 (- radius))
        q2 (DT--pt+ b u2 radius)
        p1 (DT--pt+ q1 n1 (* s h))
        p2 (DT--pt+ q2 n2 (* s h))
        p3 (DT--pt+ q2 n2 (* (- s) h))
        p4 (DT--pt+ q1 n1 (* (- s) h))
        k  0.414213562373095)
  (list
    (list p1 p2 p3 p4)
    (list (* s k) 0.0 (* (- s) k) 0.0)
    (list q1 q2)
  )
)

(defun DT--make-turn-block (rec width / b u1 u2 d q1 q2 left right path rounded ang yscale result oldElevation)
  (setq b  (nth 1 rec)
        u1 (nth 2 rec)
        u2 (nth 3 rec)
        d  (nth 4 rec)
        q1 (DT--pt+ b u1 (- d))
        q2 (DT--pt+ b u2 d)
        ang (DT--vec-angle u1)
        yscale (DT--mirror-for u1 u2)
        oldElevation (DT--active-elevation)
        *DT_ACTIVE_ELEVATION* (DT--build-elevation-at-point b))
  (if (DT--90-turn-p u1 u2)
    (progn
      (setq rounded (DT--rounded-turn-shape b u1 u2 d width))
      (setq result
        (DT--make-fitting-block
          (DT--turn-kind u1 u2)
          width
          b
          (list (list (car rounded) T (cadr rounded) (caddr rounded)))
          ang
          yscale))
    )
    (progn
      (setq left  (g365_offset_open_pts (list q1 b q2) (/ width 2.0) 1))
      (setq right (g365_offset_open_pts (list q1 b q2) (/ width 2.0) -1))
      (if (and left right)
        (progn
          (setq path (append left (reverse right)))
          (setq result
            (DT--make-fitting-block
              (DT--turn-kind u1 u2) width b
              (list (list path T nil (list q1 q2))) ang yscale))
        )
      )
    )
  )
  (setq *DT_ACTIVE_ELEVATION* oldElevation)
  result
)

(defun DT--range-sort (ranges)
  (vl-sort ranges '(lambda (a b) (< (car a) (car b))))
)

(defun DT--merge-ranges (ranges / out rec lastRec)
  (foreach rec (DT--range-sort ranges)
    (if (null out)
      (setq out (list rec))
      (progn
        (setq lastRec (g365_last out))
        (if (<= (car rec) (+ (cadr lastRec) 0.0001))
          (setq out
            (append
              (reverse (cdr (reverse out)))
              (list (list (car lastRec) (max (cadr lastRec) (cadr rec))))
            )
          )
          (setq out (append out (list rec)))
        )
      )
    )
  )
  out
)

(defun DT--segment-cut-ranges (a b cutPts gap startD endD / ranges cp rec d lo hi cut pt useGap)
  (foreach cut cutPts
    (setq pt (DT--cut-point cut))
    (setq useGap (DT--cut-gap cut gap))
    (setq rec (g365_closest_on_seg pt a b))
    (if (and rec (<= (nth 2 rec) 0.001))
      (progn
        (setq cp (car rec))
        (setq d (distance a cp))
        (setq lo (max startD (- d useGap)))
        (setq hi (min endD (+ d useGap)))
        (if (> hi (+ lo 0.001))
          (setq ranges (append ranges (list (list lo hi))))
        )
      )
    )
  )
  (DT--merge-ranges ranges)
)

(defun DT--make-segment-pieces (a b width startD endD cutPts gap / u ranges cursor rec p1 p2 ent out)
  (setq u (DT--seg-unit a b))
  (setq ranges (DT--segment-cut-ranges a b cutPts gap startD endD))
  (setq cursor startD)
  (foreach rec ranges
    (if (> (car rec) (+ cursor 0.001))
      (progn
        (setq p1 (DT--pt+ a u cursor)
              p2 (DT--pt+ a u (car rec))
              ent (DT--make-straight-piece p1 p2 width))
        (if ent (setq out (append out (list ent))))
      )
    )
    (setq cursor (max cursor (cadr rec)))
  )
  (if (> endD (+ cursor 0.001))
    (progn
      (setq p1 (DT--pt+ a u cursor)
            p2 (DT--pt+ a u endD)
            ent (DT--make-straight-piece p1 p2 width))
      (if ent (setq out (append out (list ent))))
    )
  )
  out
)

(defun DT--build-straight-pieces (rawPts width cutPts / pts corners pieces i a b cStart cEnd startD endD segPieces)
  (setq pts (DT--simplify-pts rawPts))
  (setq corners (DT--corner-records pts width))
  (setq i 0)
  (while (< i (1- (length pts)))
    (setq a (nth i pts)
          b (nth (1+ i) pts)
          cStart (DT--corner-at corners i)
          cEnd   (DT--corner-at corners (1+ i))
          startD (if cStart (nth 4 cStart) 0.0)
          endD   (- (distance a b) (if cEnd (nth 4 cEnd) 0.0)))
    (if (> endD (+ startD 0.001))
      (progn
        (setq segPieces (DT--make-segment-pieces a b width startD endD cutPts width))
        (if segPieces (setq pieces (append pieces segPieces)))
      )
    )
    (setq i (1+ i))
  )
  pieces
)
(defun DT--build-piecewise-tray (rawPts width / pts corners pieces blocks blk rec)
  (setq pts (DT--simplify-pts rawPts))
  (setq corners (DT--corner-records pts width))
  (setq pieces (DT--build-straight-pieces pts width nil))
  (foreach rec corners
    (setq blk (DT--make-turn-block rec width))
    (if blk (setq blocks (append blocks (list blk))))
  )
  (list pieces blocks (length blocks) pts)
)
(defun DT--same-tray-layer-p (a b)
  (and a b (= (strcase a) (strcase b)))
)

(defun DT--collect-center-entities-raw (/ ss i ent out)
  (setq ss (ssget "_X" (list (cons 0 "LWPOLYLINE,POLYLINE") (cons 8 (DT--layer-center)))))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent (ssname ss i))
        (if (and (DT--entity-alive-p ent)
                 (DT--active-center-p ent))
          (setq out (cons ent out))
        )
        (setq i (1+ i))
      )
    )
  )
  (reverse out)
)

(defun DT--center-cache-source (/ out ent)
  (if (and (boundp '*DT_CENTER_CACHE_ACTIVE*)
           *DT_CENTER_CACHE_ACTIVE*)
    (progn
      (foreach ent *DT_CENTER_CACHE*
        (if (and (DT--entity-alive-p ent)
                 (DT--active-center-p ent))
          (setq out (cons ent out))))
      (setq *DT_CENTER_CACHE* (reverse out)))
    (setq *DT_CENTER_CACHE* (DT--collect-center-entities-raw)))
  *DT_CENTER_CACHE*
)

(defun DT--cache-center-entity (ent)
  (if (and ent
           (DT--entity-alive-p ent)
           (boundp '*DT_CENTER_CACHE_ACTIVE*)
           *DT_CENTER_CACHE_ACTIVE*
           (not (member ent *DT_CENTER_CACHE*)))
    (setq *DT_CENTER_CACHE* (cons ent *DT_CENTER_CACHE*)))
  ent
)

(defun DT--center-entities (skip targetLayer / ent entLayer out)
  (foreach ent (DT--center-cache-source)
    (if (and (not (eq ent skip))
             (DT--same-active-elevation-p ent))
      (progn
        (setq entLayer (DT--center-layer ent nil))
        (if (DT--same-tray-layer-p entLayer targetLayer)
          (setq out (cons ent out))))))
  (reverse out)
)

(defun DT--all-layer-center-entities (skip targetLayer / ent entLayer out)
  ;; Kot gecisi icin ayni tava layer'indaki canli merkezleri kot ayirmadan getirir.
  (foreach ent (DT--center-cache-source)
    (if (not (eq ent skip))
      (progn
        (setq entLayer (DT--center-layer ent nil))
        (if (DT--same-tray-layer-p entLayer targetLayer)
          (setq out (cons ent out))))))
  (reverse out)
)

(defun DT--center-route-bounds (pts / p minX minY maxX maxY)
  (foreach p pts
    (if (null minX)
      (setq minX (car p) maxX (car p)
            minY (cadr p) maxY (cadr p))
      (setq minX (min minX (car p))
            maxX (max maxX (car p))
            minY (min minY (cadr p))
            maxY (max maxY (cadr p)))))
  (if minX (list minX minY maxX maxY))
)

(defun DT--center-near-route-p (center routeBounds newWidth / pts bounds oldWidth margin)
  (if (and center routeBounds)
    (progn
      (setq pts (g365_get_pts center)
            bounds (DT--center-route-bounds pts)
            oldWidth (DT--center-width center newWidth)
            margin (+ (/ newWidth 2.0) (/ oldWidth 2.0) 2.0))
      (and bounds
           (<= (- (car bounds) margin) (nth 2 routeBounds))
           (>= (+ (nth 2 bounds) margin) (car routeBounds))
           (<= (- (cadr bounds) margin) (nth 3 routeBounds))
           (>= (+ (nth 3 bounds) margin) (cadr routeBounds)))))
)

(defun DT--filter-centers-near-route (centers pts width / bounds center out)
  (setq bounds (DT--center-route-bounds pts))
  (foreach center centers
    (if (DT--center-near-route-p center bounds width)
      (setq out (cons center out))))
  (reverse out)
)

(defun DT--center-cache-reset ()
  (setq *DT_CENTER_CACHE*
    (DT--collect-center-entities-raw))
  *DT_CENTER_CACHE*
)

(defun DT--center-cache-count ()
  (length (DT--center-cache-source))
)

(defun DT--center-cache-active-p ()
  (and (boundp '*DT_CENTER_CACHE_ACTIVE*)
       *DT_CENTER_CACHE_ACTIVE*)
)

(defun DT--center-cache-disable ()
  (setq *DT_CENTER_CACHE_ACTIVE* nil
        *DT_CENTER_CACHE* nil)
  nil
)

(defun DT--center-cache-enable ()
  (setq *DT_CENTER_CACHE_ACTIVE* T)
  (DT--center-cache-reset)
)

(defun DT--center-cache-remove (ent)
  (if (and ent (boundp '*DT_CENTER_CACHE*))
    (setq *DT_CENTER_CACHE* (vl-remove ent *DT_CENTER_CACHE*)))
  ent
)

(defun DT--center-cache-refresh ()
  (if (DT--center-cache-active-p)
    (DT--center-cache-reset)
  )
  *DT_CENTER_CACHE*
)

(defun DT--nearest-center-end-contact (pt centers width / center pts oldWidth oldElevation activeZ sameActive bestSame tol p d best bestD i rec oldActive)
  ;; Tavanin gorunen ucundaki merkez/kose tiklamalarini ayni merkez ucuna toplar.
  (setq activeZ (DT--active-elevation))
  (foreach center centers
    (setq pts (g365_get_pts center))
    (if (and pts (> (length pts) 1))
      (progn
        (setq oldWidth (DT--center-width center width)
              tol      (+ (/ width 2.0) (/ oldWidth 2.0) 1.0))
        (setq i 0)
        (while (< i (1- (length pts)))
          (setq rec (g365_closest_on_seg pt (nth i pts) (nth (1+ i) pts))
                p   (if rec (car rec) nil)
                d   (if p (DT--distance-xy pt p) nil))
          (if (and p (<= d tol))
            (progn
              (setq oldElevation (DT--center-elevation-at-point center p)
                    sameActive   (equal oldElevation activeZ 0.000001)
                    oldActive    (DT--active-elevation)
                    *DT_ACTIVE_ELEVATION* oldElevation)
              (if (and
                    (DT--center-visible-at-point-p center p oldWidth)
                    (or
                      (null bestD)
                      (< d (- bestD 0.000001))
                      (and
                        (equal d bestD 0.000001)
                        sameActive
                        (not bestSame))))
                (setq bestD d
                      bestSame sameActive
                      best (list (list (car p) (cadr p) 0.0)
                                 center pts oldWidth oldElevation))
              )
              (setq *DT_ACTIVE_ELEVATION* oldActive)
            )
          )
          (setq i (1+ i))
        )
      )
    )
  )
  best
)

(defun DT--elevation-end-contacts (pts centers width / out firstRec lastRec pairDiff activeZ contacts transitionCenters firstZ lastZ)
  ;; Kayit: (temas oldCenter oldPts oldWidth oldZ yeniUcIndex digerZ)
  (setq out pts
        activeZ (DT--active-elevation))
  (if (and out (> (length out) 1))
    (progn
      (setq firstRec (DT--nearest-center-end-contact (car out) centers width)
            lastRec  (DT--nearest-center-end-contact (g365_last out) centers width)
            firstZ   (if firstRec (nth 4 firstRec) activeZ)
            lastZ    (if lastRec (nth 4 lastRec) activeZ)
            pairDiff (not (equal firstZ lastZ 0.000001)))
      (if (and firstRec pairDiff)
        (progn
          (setq out (DT--replace-first-point out (car firstRec)))
          (setq contacts
            (append contacts
              (list
                (append firstRec
                  (list 0 (if pairDiff lastZ activeZ))))))
          (setq transitionCenters
            (DT--add-ent-unique (cadr firstRec) transitionCenters))
        )
      )
      (if (and lastRec pairDiff)
        (progn
          (setq out (DT--replace-last-point out (car lastRec)))
          (setq contacts
            (append contacts
              (list
                (append lastRec
                  (list 1 (if pairDiff firstZ activeZ))))))
          (setq transitionCenters
            (DT--add-ent-unique (cadr lastRec) transitionCenters))
        )
      )
    )
  )
  (if (null firstZ) (setq firstZ activeZ))
  (if (null lastZ) (setq lastZ activeZ))
  (list out contacts transitionCenters (list firstZ lastZ))
)

(defun DT--elevation-scan-needs-fresh-retry-p (scan / contacts elevations)
  ;; Tek farkli-kot temasi, diger uc merkez cache'inde eksik kalinca olusur.
  (setq contacts   (cadr scan)
        elevations (nth 3 scan))
  (and (= (length contacts) 1)
       elevations
       (not (equal (car elevations) (cadr elevations) 0.000001)))
)

(defun DT--elevation-scan-for-center (newCenter pts width targetLayer / allCenters scan)
  (setq allCenters
          (DT--filter-centers-near-route
            (DT--all-layer-center-entities newCenter targetLayer)
            pts width)
        scan (DT--elevation-end-contacts pts allCenters width))
  (if (DT--elevation-scan-needs-fresh-retry-p scan)
    (progn
      (DT--center-cache-refresh)
      (setq allCenters
              (DT--filter-centers-near-route
                (DT--all-layer-center-entities newCenter targetLayer)
                pts width)
            scan (DT--elevation-end-contacts pts allCenters width))))
  (list scan allCenters)
)

(defun DT--point-known-p (pt pts tol / hit p)
  (foreach p pts
    (if (<= (distance pt p) tol) (setq hit T))
  )
  hit
)

(defun DT--vec-from-to (a b / dx dy)
  (setq dx (- (car b) (car a))
        dy (- (cadr b) (cadr a)))
  (g365_unit dx dy)
)

(defun DT--same-ray-p (u v)
  (and u v (> (g365_dot (car u) (cadr u) (car v) (cadr v)) 0.995))
)

(defun DT--add-ray-unique (ray rays / hit r)
  (if (and ray (> (distance '(0.0 0.0 0.0) (list (car ray) (cadr ray) 0.0)) 0.5))
    (progn
      (foreach r rays
        (if (DT--same-ray-p ray r) (setq hit T))
      )
      (if (not hit) (setq rays (append rays (list ray))))
    )
  )
  rays
)

(defun DT--point-on-seg-p (pt a b tol / rec)
  (setq rec (g365_closest_on_seg pt a b))
  (and rec (<= (nth 2 rec) tol))
)

(defun DT--arms-at-point (pts pt tol / arms i a b)
  (setq arms nil i 0)
  (while (< i (1- (length pts)))
    (setq a (nth i pts) b (nth (1+ i) pts))
    (if (DT--point-on-seg-p pt a b tol)
      (progn
        (if (> (distance pt a) tol)
          (setq arms (DT--add-ray-unique (DT--vec-from-to pt a) arms))
        )
        (if (> (distance pt b) tol)
          (setq arms (DT--add-ray-unique (DT--vec-from-to pt b) arms))
        )
      )
    )
    (setq i (1+ i))
  )
  arms
)

(defun DT--opposite-p (u v)
  (and u v (< (g365_dot (car u) (cadr u) (car v) (cadr v)) -0.995))
)

(defun DT--straight-axis (arms / a b)
  (if (= (length arms) 2)
    (progn
      (setq a (car arms) b (cadr arms))
      (if (DT--opposite-p a b) a nil)
    )
    nil
  )
)

(defun DT--perpendicular-p (u v)
  (and u v (<= (abs (g365_dot (car u) (cadr u) (car v) (cadr v))) 0.05))
)

(defun DT--opposite-exists-p (u arms / hit v)
  (foreach v arms
    (if (DT--opposite-p u v) (setq hit T))
  )
  hit
)

(defun DT--four-way-axes (arms / u v axes)
  (if (= (length arms) 4)
    (progn
      (setq u (car arms))
      (if (DT--opposite-exists-p u arms)
        (progn
          (foreach v (cdr arms)
            (if (and (not (DT--opposite-p u v))
                     (DT--perpendicular-p u v)
                     (DT--opposite-exists-p v arms)
                     (null axes))
              (setq axes (list u v))
            )
          )
        )
      )
    )
  )
  axes
)

(defun DT--xdata-set-app (ed app payload / out records item rec)
  (foreach item ed
    (if (= (car item) -3)
      (foreach rec (cdr item)
        (if (/= (car rec) app)
          (setq records (append records (list rec)))
        )
      )
      (setq out (append out (list item)))
    )
  )
  (if payload (setq records (append records (list payload))))
  (if records (setq out (append out (list (cons -3 records)))))
  out
)

(defun DT--xdata-remove-app (ed app)
  (DT--xdata-set-app ed app nil)
)

(defun DT--remove-center-display-copies (/ app ss i ent)
  ;; Onceki surumun hatch ustu gorunen merkez kopyalarini tamamen temizle.
  (setq app "DT_CENTER_DISPLAY")
  (if (tblsearch "APPID" app)
    (setq ss
      (ssget "_X"
        (list
          (cons 0 "LWPOLYLINE,POLYLINE")
          (list -3 (list app))
        )
      )
    )
  )
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq ent (ssname ss i))
        (if (entget ent) (entdel ent))
        (setq i (1+ i))
      )
      (sslength ss)
    )
    0
  )
)
(defun DT--xdata-link-tray (center trays / app ed lst payload tray h)
  (setq app "DT_TRAY_LINK")
  (if (not (tblsearch "APPID" app)) (regapp app))
  (setq lst
    (cond
      ((= (type trays) 'ENAME) (list trays))
      ((listp trays) trays)
      (T nil)
    )
  )
  (if (and center (entget center) lst)
    (progn
      (setq payload (list app))
      (foreach tray lst
        (if (and tray (entget tray))
          (progn
            (setq h (cdr (assoc 5 (entget tray))))
            (if h (setq payload (append payload (list (cons 1005 h)))))
          )
        )
      )
      (setq ed (entget center '("*")))
      (setq ed (DT--xdata-set-app ed app payload))
      (entmod ed)
      (entupd center)
    )
  )
  center
)

(defun DT--set-center-width (center width / app ed payload)
  (setq app "DT_TRAY_WIDTH")
  (if (not (tblsearch "APPID" app)) (regapp app))
  (if (and center (entget center) (numberp width) (> width 0.0))
    (progn
      (setq payload (list app (cons 1000 (rtos width 2 12))))
      (setq ed (entget center '("*")))
      (setq ed (DT--xdata-set-app ed app payload))
      (entmod ed)
      (entupd center)
    )
  )
  center
)

(defun DT--center-width (center fallback / app ed xd rec x val)
  (setq app "DT_TRAY_WIDTH")
  (setq val fallback)
  (if (and center (entget center))
    (progn
      (setq ed (entget center (list app)))
      (setq xd (assoc -3 ed))
      (if xd
        (progn
          (setq rec (cadr xd))
          (foreach x (cdr rec)
            (if (= (car x) 1000) (setq val (atof (cdr x))))
          )
        )
      )
    )
  )
  (if (and (numberp val) (> val 0.0)) val fallback)
)
(defun DT--set-center-layer (center lay / app ed payload)
  (setq app "DT_TRAY_LAYER")
  (if (not (tblsearch "APPID" app)) (regapp app))
  (if (and center (entget center) lay (/= lay ""))
    (progn
      (setq payload (list app (cons 1000 lay)))
      (setq ed (entget center '("*")))
      (setq ed (DT--xdata-set-app ed app payload))
      (entmod ed)
      (entupd center)
    )
  )
  center
)

(defun DT--center-layer (center fallback / app ed xd rec x lay trays tray)
  (setq app "DT_TRAY_LAYER" lay nil)
  (if (and center (entget center))
    (progn
      (setq ed (entget center (list app)))
      (setq xd (assoc -3 ed))
      (if xd
        (progn
          (setq rec (cadr xd))
          (foreach x (cdr rec)
            (if (= (car x) 1000) (setq lay (cdr x)))
          )
        )
      )
      (if (not (DT--tray-visible-layer-p lay))
        (progn
          (setq lay nil)
          (setq trays (DT--linked-trays center))
          (foreach tray trays
            (if (and (null lay) (entget tray)
                     (DT--tray-visible-layer-p (cdr (assoc 8 (entget tray)))))
              (setq lay (cdr (assoc 8 (entget tray))))
            )
          )
        )
      )
    )
  )
  (if (DT--tray-visible-layer-p lay) (DT--base-layer-name lay) fallback)
)

(setq *DT_DELETED_HANDLES* nil
      *DT_SUPPRESS_DELETE_HISTORY* nil)

(defun DT--ent-handle (ent / ed)
  (if (and ent (setq ed (entget ent)))
    (cdr (assoc 5 ed))
  )
)

(defun DT--entity-current-p (ent / ed h)
  ;; ENTGET silinmis entity icin nil verir; HANDENT'in eski handle'i geri
  ;; dondurmesi bu sabit-zamanli kontrolu etkilemez. Her sorguda tum layer'i
  ;; SSGET ile taramak buyuk planlarda DT'yi katlanarak yavaslatiyordu.
  (and ent
       (setq ed (entget ent))
       (setq h (cdr (assoc 5 ed)))
       (not (DT--deleted-handle-p h)))
)
(defun DT--deleted-handle-p (h)
  (and h (member h *DT_DELETED_HANDLES*))
)

(defun DT--remember-deleted-handle (h)
  (if (and h
           (not
             (and (boundp '*DT_SUPPRESS_DELETE_HISTORY*)
                  *DT_SUPPRESS_DELETE_HISTORY*))
           (not (DT--deleted-handle-p h)))
    (setq *DT_DELETED_HANDLES* (cons h *DT_DELETED_HANDLES*))
  )
  h
)

(defun DT--vla-object-for-ent (ent / obj ed h acad doc)
  (if (and ent (entget ent))
    (progn
      (setq obj (vl-catch-all-apply 'vlax-ename->vla-object (list ent)))
      (if (or (vl-catch-all-error-p obj) (null obj))
        (progn
          (setq ed (entget ent)
                h  (cdr (assoc 5 ed)))
          (if h
            (progn
              (setq acad (vl-catch-all-apply 'vlax-get-acad-object nil))
              (if (not (vl-catch-all-error-p acad))
                (progn
                  (setq doc (vl-catch-all-apply 'vla-get-ActiveDocument (list acad)))
                  (if (not (vl-catch-all-error-p doc))
                    (setq obj (vl-catch-all-apply 'vla-HandleToObject (list doc h)))
                  )
                )
              )
            )
          )
        )
      )
      (if (or (vl-catch-all-error-p obj) (null obj)) nil obj)
    )
  )
)

(defun DT--entity-erased-p (ent / obj r)
  (cond
    ((null ent) T)
    ((null (entget ent)) T)
    ((DT--deleted-handle-p (DT--ent-handle ent)) T)
    (T
      (setq obj (DT--vla-object-for-ent ent))
      (if (null obj)
        nil
        (progn
          (setq r (vl-catch-all-apply 'vlax-erased-p (list obj)))
          (cond
            ((vl-catch-all-error-p r) nil)
            ((eq r T) T)
            ((and (numberp r) (/= r 0)) T)
            (T nil)
          )
        )
      )
    )
  )
)

(defun DT--entity-alive-p (ent)
  (DT--entity-current-p ent)
)
(defun DT--xdata-link-hatch (tray hatch / app ed h payload oldHatch oldHandle found)
  (setq app "DT_TRAY_HATCH")
  (if (not (tblsearch "APPID" app)) (regapp app))
  (if (and tray hatch (entget tray) (entget hatch))
    (progn
      (setq h (cdr (assoc 5 (entget hatch))))
      (if h
        (progn
          (setq payload (list app))
          (foreach oldHatch (DT--linked-hatches tray)
            (setq oldHandle (cdr (assoc 5 (entget oldHatch))))
            (if oldHandle
              (progn
                (if (= (strcase oldHandle) (strcase h)) (setq found T))
                (setq payload (append payload (list (cons 1005 oldHandle))))
              )
            )
          )
          (if (not found)
            (setq payload (append payload (list (cons 1005 h)))))
          (setq ed (entget tray '("*")))
          (setq ed (DT--xdata-set-app ed app payload))
          (entmod ed)
          (entupd tray)
        )
      )
    )
  )
  tray
)

(defun DT--linked-hatches (ent / app ed xd rec h hatch out x)
  (setq app "DT_TRAY_HATCH")
  (if (and ent (entget ent))
    (progn
      (setq ed (entget ent (list app)))
      (setq xd (assoc -3 ed))
      (if xd
        (progn
          (setq rec (cadr xd))
          (foreach x (cdr rec)
            (if (= (car x) 1005)
              (progn
                (setq h (cdr x))
                (setq hatch (handent h))
                (if (DT--entity-alive-p hatch)
                  (setq out (append out (list hatch)))
                )
              )
            )
          )
        )
      )
    )
  )
  out
)

(defun DT--xdata-link-sidewalls (tray walls / app ed payload wall h)
  (setq app "DT_TRAY_SIDEWALL")
  (if (not (tblsearch "APPID" app)) (regapp app))
  (if (and tray (entget tray) walls)
    (progn
      (setq payload (list app))
      (foreach wall walls
        (if (and wall (entget wall))
          (progn
            (setq h (cdr (assoc 5 (entget wall))))
            (if h (setq payload (append payload (list (cons 1005 h)))))
          )
        )
      )
      (setq ed (entget tray '("*")))
      (setq ed (DT--xdata-set-app ed app payload))
      (entmod ed)
      (entupd tray)
    )
  )
  tray
)

(defun DT--linked-sidewalls (tray / app ed xd rec item wall out)
  (setq app "DT_TRAY_SIDEWALL")
  (if (and tray (entget tray))
    (progn
      (setq ed  (entget tray (list app))
            xd  (assoc -3 ed)
            rec (if xd (cadr xd) nil))
      (if (and rec (= (car rec) app))
        (foreach item (cdr rec)
          (if (= (car item) 1005)
            (progn
              (setq wall (handent (cdr item)))
              (if (DT--entity-alive-p wall)
                (setq out (append out (list wall))))
            )
          )
        )
      )
    )
  )
  out
)

(defun DT--ensure-composite-pickstyle (/ value)
  (setq value (getvar "PICKSTYLE"))
  ;; Bit 1 secilebilir gruplari, bit 2 associative hatch secimini etkinlestirir.
  (if (= 0 (logand value 1))
    (setq value (+ value 1)))
  (if (= 0 (logand value 2))
    (setq value (+ value 2)))
  (setvar "PICKSTYLE" value)
  ;; Grup secimi kalsin, grubun etrafindaki dikdortgen sinir kutusu gorunmesin.
  (vl-catch-all-apply 'setvar (list "GROUPDISPLAYMODE" 0))
  (getvar "PICKSTYLE")
)

(defun DT--existing-group-dictionary (/ record)
  (setq record (dictsearch (namedobjdict) "ACAD_GROUP"))
  (if record (cdr (assoc -1 record)))
)

(defun DT--group-dictionary (/ dictionary)
  (setq dictionary (DT--existing-group-dictionary))
  (if (null dictionary)
    (progn
      (setq dictionary
        (entmakex
          '((0 . "DICTIONARY")
            (100 . "AcDbDictionary")
            (280 . 0)
            (281 . 1))))
      (if dictionary
        (dictadd (namedobjdict) "ACAD_GROUP" dictionary))))
  dictionary
)

(defun DT--tray-group-name (tray / handle)
  (setq handle (if tray (DT--ent-handle tray)))
  (if handle (strcat "DT$TAVA$" (strcase handle)))
)

(defun DT--dictionary-record-entity (record / item)
  (cond
    ((setq item (assoc -1 record)) (cdr item))
    ((setq item (assoc 350 record)) (cdr item))
    ((setq item (assoc 360 record)) (cdr item)))
)

(defun DT--group-by-name (name / dictionary record)
  (setq dictionary (DT--existing-group-dictionary))
  (if (and dictionary name
           (setq record (dictsearch dictionary name)))
    (DT--dictionary-record-entity record))
)

(defun DT--delete-group-by-name (name / dictionary group removed object)
  (setq dictionary (DT--existing-group-dictionary)
        group      (if name (DT--group-by-name name)))
  (if (and dictionary name group)
    (progn
      (setq removed (dictremove dictionary name))
      (setq object (if (and removed (not (eq removed T))) removed group))
      (if (and object (not (eq object T)) (entget object))
        (vl-catch-all-apply 'entdel (list object)))
      T))
)

(defun DT--delete-tray-group (tray / name)
  (setq name (DT--tray-group-name tray))
  (if name (DT--delete-group-by-name name))
)

(defun DT--unique-alive-entities (entities / ent handle seen out)
  (foreach ent entities
    (if (and ent (DT--entity-alive-p ent)
             (setq handle (DT--ent-handle ent))
             (not (member handle seen)))
      (setq seen (cons handle seen)
            out  (append out (list ent)))))
  out
)

(defun DT--tray-group-entities (tray)
  (DT--unique-alive-entities
    (append (list tray)
            (DT--linked-hatches tray)
            (DT--linked-sidewalls tray)))
)

(defun DT--make-group-object (name entities / dictionary data group)
  (setq dictionary (DT--group-dictionary))
  (if (and dictionary name entities)
    (progn
      (setq data
        '((0 . "GROUP")
          (100 . "AcDbGroup")
          (300 . "DT tava secim kabugu")
          (70 . 0)
          (71 . 1)))
      (foreach entity entities
        (setq data (append data (list (cons 340 entity)))))
      (setq group (entmakex data))
      (if (and group (null (dictadd dictionary name group)))
        (progn
          (vl-catch-all-apply 'entdel (list group))
          (setq group nil)))
      group))
)

(defun DT--refresh-tray-group (tray / name entities group)
  (if (and tray (DT--visible-tray-p tray))
    (progn
      (setq name (DT--tray-group-name tray))
      (DT--delete-tray-group tray)
      (setq entities (DT--tray-group-entities tray))
      (if (and name (> (length entities) 1))
        (setq group (DT--make-group-object name entities)))
      group))
)

(defun DT--repair-existing-tray-groups (/ ss i tray count)
  (setq ss (ssget "_X" '((-3 ("DT_TRAY_HATCH"))))
        i 0
        count 0)
  (if ss
    (while (< i (sslength ss))
      (setq tray (ssname ss i))
      (if (and tray (DT--visible-tray-p tray)
               (DT--refresh-tray-group tray))
        (setq count (1+ count)))
      (setq i (1+ i))))
  count
)

(defun DT--remove-generated-tray-groups (/ dictionary record item name entries entry removed object)
  (setq dictionary (DT--existing-group-dictionary))
  (if dictionary
    (progn
      ;; Dictionary DXF kaydindaki 3/350 ciftleri grup adi ve nesnesidir.
      (setq record (entget dictionary)
            name nil)
      (foreach item record
        (cond
          ((= (car item) 3)
            (setq name (cdr item)))
          ((and name (member (car item) '(350 360)))
            (if (wcmatch (strcase name) "DT$TAVA$*")
              (setq entries (cons (cons name (cdr item)) entries)))
            (setq name nil))))
      (foreach entry entries
        (setq removed (dictremove dictionary (car entry)))
        (setq object (if (and removed (not (eq removed T))) removed (cdr entry)))
        (if (and object (not (eq object T)) (entget object))
          (vl-catch-all-apply 'entdel (list object))))
      (length entries))
    0)
)

(defun DT--tray-corner-points-3d (tray / ed typ z item ent vd p out)
  (if (and tray (setq ed (entget tray)))
    (progn
      (setq typ (cdr (assoc 0 ed)))
      (cond
        ((= typ "LWPOLYLINE")
          (setq z (if (assoc 38 ed) (cdr (assoc 38 ed)) 0.0))
          (foreach item ed
            (if (= (car item) 10)
              (setq p (cdr item)
                    out (append out (list (list (car p) (cadr p) z)))))))
        ((= typ "POLYLINE")
          (setq ent (entnext tray))
          (while (and ent (/= (cdr (assoc 0 (entget ent))) "SEQEND"))
            (setq vd (entget ent))
            (if (= (cdr (assoc 0 vd)) "VERTEX")
              (progn
                (setq p (cdr (assoc 10 vd)))
                (if p
                  (setq out
                    (append out
                      (list (list (car p) (cadr p) (if (caddr p) (caddr p) 0.0))))))))
            (setq ent (entnext ent))))))
  )
  out
)

(defun DT--tray-geometry-signature (tray / ed typ pts)
  (if (and tray (setq ed (entget tray)))
    (progn
      (setq typ (cdr (assoc 0 ed))
            pts (DT--tray-corner-points-3d tray))
      (if pts (cons typ pts)))
  )
)

(defun DT--tray-signature-map (/ ss i tray h sig out)
  (setq ss (ssget "_X" '((-3 ("DT_TRAY_HATCH"))))
        i 0)
  (if ss
    (while (< i (sslength ss))
      (setq tray (ssname ss i)
            h    (if tray (DT--ent-handle tray))
            sig  (if (and tray (DT--visible-tray-p tray))
                   (DT--tray-geometry-signature tray)))
      (if (and h sig) (setq out (cons (cons h sig) out)))
      (setq i (1+ i))))
  out
)

(defun DT--face-normal-edge-height (face normal / ed pts p0 p1 p2 p3 pairs pair vec unit align len best)
  (if (and face normal (setq ed (entget face)))
    (progn
      (setq p0 (cdr (assoc 10 ed))
            p1 (cdr (assoc 11 ed))
            p2 (cdr (assoc 12 ed))
            p3 (cdr (assoc 13 ed))
            pts (list p0 p1 p2 p3))
      (if (vl-every 'listp pts)
        (progn
          (setq pairs
            (list
              (list p0 p1)
              (list p1 p2)
              (list p2 p3)
              (list p3 p0)))
          (foreach pair pairs
            (setq vec  (DT--vec3-sub (cadr pair) (car pair))
                  unit (DT--unit3 vec))
            (if unit
              (progn
                (setq align (abs (DT--dot3 unit normal))
                      len   (distance (car pair) (cadr pair)))
                (if (and (> align 0.999)
                         (> len 0.000001)
                         (or (null best) (> len best)))
                  (setq best len)))))))))
  (if best best 0.0)
)

(defun DT--faces-normal-edge-height (faces normal / face value best)
  (foreach face faces
    (setq value (DT--face-normal-edge-height face normal))
    (if (and (> value 0.0) (or (null best) (> value best)))
      (setq best value)))
  (if best best 0.0)
)

(defun DT--block-normal-edge-height (name normal / blockEnt ent ed faces)
  (if (and name normal (setq blockEnt (tblobjname "BLOCK" name)))
    (progn
      (setq ent (entnext blockEnt))
      (while (and ent
                  (setq ed (entget ent))
                  (/= (cdr (assoc 0 ed)) "ENDBLK"))
        (if (= (cdr (assoc 0 ed)) "3DFACE")
          (setq faces (cons ent faces)))
        (setq ent (entnext ent)))))
  (DT--faces-normal-edge-height faces normal)
)

(defun DT--linked-sidewall-height
  (tray / corners normal walls height)
  ;; Global min/max Z includes the complete elevation change on a sloped tray.
  ;; Measure only edges parallel to the tray plane normal; those are the real
  ;; sidewall-height edges, independent of route slope and world orientation.
  (setq corners (DT--tray-corner-points-3d tray))
  (if (= (length corners) 4)
    (setq normal
      (DT--plane-normal
        (list (nth 0 corners) (nth 3 corners) (nth 1 corners)))))
  (if normal
    (progn
      (setq walls  (DT--linked-sidewalls tray)
            height (DT--faces-normal-edge-height walls normal))))
  (if height height 0.0)
)

(defun DT--hatch-source-is-p (hatch source / ed item after97 found)
  (if (and hatch source (setq ed (entget hatch)))
    (foreach item ed
      (cond
        ((= (car item) 97) (setq after97 (> (cdr item) 0)))
        ((and after97 (= (car item) 330))
          (if (eq (cdr item) source) (setq found T))
          (setq after97 nil)))))
  found
)

(defun DT--delete-linked-sidewall-geometry (tray / hatches walls keepTop hatch wall h)
  (setq hatches (DT--linked-hatches tray)
        walls   (DT--linked-sidewalls tray))
  (foreach hatch hatches
    (if (DT--hatch-source-is-p hatch tray) (setq keepTop hatch)))
  (if (and (null keepTop) hatches) (setq keepTop (car hatches)))
  (foreach hatch hatches
    (if (and hatch (not (eq hatch keepTop)) (entget hatch))
      (progn
        (setq h (DT--ent-handle hatch))
        (vl-catch-all-apply 'entdel (list hatch))
        (if h (DT--remember-deleted-handle h)))))
  (foreach wall walls
    (if (and wall (entget wall))
      (progn
        (setq h (DT--ent-handle wall))
        (vl-catch-all-apply 'entdel (list wall))
        (if h (DT--remember-deleted-handle h)))))
  keepTop
)

(defun DT--rebuild-tray-sidewall-geometry
  (tray / pts meta lay mode sideMm sidePlan inferredHeight
          *DT_ACTIVE_MODE* *DT_ACTIVE_LAYER* *DT_ACTIVE_ELEVATION*
          *DT_ACTIVE_SIDE_HEIGHT* *DT_ACTIVE_SIDE_HEIGHT_MM*)
  (if (and tray (DT--visible-tray-p tray))
    (progn
      (setq pts (DT--tray-corner-points-3d tray))
      (if (= (length pts) 4)
        (progn
          (setq meta           (DT--tray-meta-effective tray)
                lay            (DT--base-layer-name (cdr (assoc 8 (entget tray))))
                mode           (DT--normalize-mode
                                 (if (and meta (car meta))
                                   (car meta)
                                   (DT--mode-from-layer lay)))
                inferredHeight (DT--linked-sidewall-height tray)
                sideMm         (if (and meta (numberp (caddr meta)) (> (caddr meta) 0.0))
                                 (caddr meta)
                                 (/ (* inferredHeight 10.0)
                                    (max 0.000000001 (DEG:PLAN-UNIT-SCALE))))
                sidePlan       (if (> sideMm 0.0) (DT--plan-side-height sideMm) inferredHeight)
                *DT_ACTIVE_MODE* mode
                *DT_ACTIVE_LAYER* lay
                *DT_ACTIVE_ELEVATION* (if (caddr (car pts)) (caddr (car pts)) 0.0)
                *DT_ACTIVE_SIDE_HEIGHT_MM* sideMm
                *DT_ACTIVE_SIDE_HEIGHT* sidePlan)
          (DT--delete-tray-group tray)
          (DT--delete-linked-sidewall-geometry tray)
          (if (> sidePlan 0.0)
            (DT--make-tray-sidewalls
              tray (nth 0 pts) (nth 1 pts) (nth 2 pts) (nth 3 pts)))
          (DT--repair-tray-hatch-associations tray)
          (DT--refresh-tray-group tray)
          T)))
  )
)

(defun DT--tray-sidewall-local-normal-p (tray walls / pts expected wall ed base top actual)
  (setq pts (DT--tray-corner-points-3d tray))
  (if (and (= (length pts) 4) (>= (length walls) 4))
    (progn
      (setq expected (DT--plane-normal (list (nth 0 pts) (nth 3 pts) (nth 1 pts)))
            wall     (nth 3 walls)
            ed       (if wall (entget wall))
            base     (if ed (cdr (assoc 10 ed)))
            top      (if ed (cdr (assoc 13 ed)))
            actual   (if (and base top)
                       (DT--unit3 (DT--vec3-sub top base))))
      (and expected actual (> (DT--dot3 expected actual) 0.9999)))
  )
)

(defun DT--repair-existing-tray-sidewalls (/ ss i tray meta walls hatches sideMm count)
  (setq ss (ssget "_X" '((-3 ("DT_TRAY_HATCH"))))
        i 0
        count 0)
  (if ss
    (while (< i (sslength ss))
      (setq tray (ssname ss i))
      (if (and tray (DT--visible-tray-p tray))
        (progn
          (setq meta    (DT--tray-meta-effective tray)
                walls   (DT--linked-sidewalls tray)
                hatches (DT--linked-hatches tray)
                sideMm  (if (and meta (numberp (caddr meta))) (caddr meta) 0.0))
          (if (and (or (> sideMm 0.0) walls)
                   (or (/= (length walls) 13)
                       (/= (length hatches) 14)
                       (not (DT--tray-sidewall-local-normal-p tray walls))))
            (if (DT--rebuild-tray-sidewall-geometry tray)
              (setq count (1+ count))))))
      (setq i (1+ i))))
  count
)

(defun DT--repair-existing-model-hatch-colors (/ ss i hatch ed lay base count)
  (setq ss (ssget "_X" '((0 . "HATCH")))
        i 0
        count 0)
  (if ss
    (while (< i (sslength ss))
      (setq hatch (ssname ss i)
            ed    (if hatch (entget hatch))
            lay   (if ed (cdr (assoc 8 ed)))
            base  (if lay (DT--base-layer-name lay)))
      (if (and hatch base (DT--tray-visible-layer-p base))
        (progn
          (DT--set-layer-bylayer hatch base)
          (setq count (1+ count))))
      (setq i (1+ i))))
  count
)

(defun DT--repair-existing-tray-line-layers (/ ss i tray base line wall hatch count)
  (DT--ensure-type-layers)
  (DT--ensure-layer "e_tava" 7 nil)
  (DT--ensure-layer "e_tava_çizgi" 7 nil)
  (setq ss (ssget "_X" '((-3 ("DT_TRAY_HATCH"))))
        i 0
        count 0)
  (if ss
    (while (< i (sslength ss))
      (setq tray (ssname ss i))
      (if (and tray (DT--visible-tray-p tray))
