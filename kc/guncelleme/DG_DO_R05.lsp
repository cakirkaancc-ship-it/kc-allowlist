(defun DEGN-DEGA--dist2 (a b)
  (+ (expt (- (car a) (car b)) 2.0)
     (expt (- (cadr a) (cadr b)) 2.0))
)

(defun DEGN-DEGA--eq-tol (p q tol)
  (<= (DEGN-DEGA--dist2 p q) (* tol tol))
)

