(defun DEGV:_move-klemens-terminal (blkList / acad doc lays b bo layName layObj wasLocked shiftY)
  (setq acad (vlax-get-acad-object)
        doc  (vla-get-ActiveDocument acad)
        lays (vla-get-Layers doc)
        shiftY (DEGV:_data-shift-y)
  )

  (foreach b blkList
    (setq bo b)
    (if (and bo (= (type bo) 'ENAME))
      (setq bo (vlax-ename->vla-object bo))
    )
    (if (and (vlax-objectp bo)
             (= (strcase (vla-get-ObjectName bo)) "ACDBBLOCKREFERENCE"))
      (progn
        (if (and (> (abs shiftY) 1e-9)
                 (DEGV:_is-klemens-terminal bo))
          (progn
            (setq layName (vla-get-Layer bo))
            (setq layObj nil
                  wasLocked nil
            )
            (if (and layName (/= layName ""))
              (progn
                (setq layObj (vl-catch-all-apply 'vla-item (list lays layName)))
                (if (not (vl-catch-all-error-p layObj))
                  (progn
                    (setq wasLocked (vla-get-Lock layObj))
                    (if (= wasLocked :vlax-true)
                      (vla-put-Lock layObj :vlax-false)
                    )
                  )
                  (setq layObj nil)
                )
              )
            )

            (vl-catch-all-apply 'vla-Move
              (list bo
                    (vlax-3d-point '(0 0 0))
                    (vlax-3d-point (list 0.0 shiftY 0.0)))
            )

            (if (and layObj wasLocked (= wasLocked :vlax-true))
              (vla-put-Lock layObj :vlax-true)
            )
          )
        )
      )
    )
  )
  (princ)
)

